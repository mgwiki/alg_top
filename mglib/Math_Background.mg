(** Infrastructure: each nonnegative term of a finite real sum is bounded by the total sum. **)
(** Proven Charlie **)
Lemma finite_real_sum_term_le_of_all_nonneg : forall f:set->set, forall n k:set, nat_p n ->
  k :e n ->
  (forall j:set, j :e n -> f j :e R) ->
