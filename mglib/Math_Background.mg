    rewrite (If_i_0
      (1 = 0)
      (z 0)
      (if 1 = 1 then z 1 else 0)
      neq_1_0).
    exact (If_i_1
      (1 = 1)
      (z 1)
      0
      (eq_refl 1)).
  }
  claim Hequator2 :
    apply_fun (apply_fun S1_equator_in_S2 z) 2 = 0.
  {
