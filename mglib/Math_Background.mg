  ~(a :e image_of f unit_interval) ->
  ~(b :e image_of f unit_interval) ->
  component_of
    (setprod R R :\: image_of f unit_interval)
    (subspace_topology (setprod R R) R2_topology
      (setprod R R :\: image_of f unit_interval))
    a =
  component_of
    (setprod R R :\: image_of f unit_interval)
    (subspace_topology (setprod R R) R2_topology
      (setprod R R :\: image_of f unit_interval))
    b ->
  winding_number f a = winding_number f b.
admit.
