          claim Hys0_xs : apply_fun ys0 i = apply_fun xs i.
          { exact (andER (m0 = n) (forall i:set, i :e m0 -> apply_fun ys0 i = apply_fun xs i) Huniq_xs i Hi0). }
          claim Hys0_xs' : apply_fun ys0 i = apply_fun xs' i.
          { exact (andER (m0 = n') (forall i:set, i :e m0 -> apply_fun ys0 i = apply_fun xs' i) Huniq_xs' i Hi0). }
          exact (eq_i_tra (apply_fun xs i) (apply_fun ys0 i) (apply_fun xs' i)
            (eq_symm (apply_fun ys0 i) (apply_fun xs i) Hys0_xs)
            Hys0_xs').
  - assume Hn12_ne1.
    apply (xm (n12 = 2)).
    + assume Hn12_2.
      apply (Hexist_n12_2 Hn12_2).
      let n. assume Hn_pack.
      apply Hn_pack. let xs. assume Hxs_pack.
      apply (and3E
        (reduced_word (J :\/: K) Hfam efamH n xs)
        (n <> 0)
        (word_product multG eG xs n = x)
        Hxs_pack).
      assume Hred Hn_ne Hwp.
      witness n. witness xs.
      apply and4I.
      * exact Hred.
      * exact Hn_ne.
      * exact Hwp.
      * (** TODO: uniqueness for n12=2 case **)
        let n'. let xs'.
        assume Hred' Hn'_ne Hwp'.

        (** Basic facts about the binary reduced word xs12 of length 2. **)
        claim Hn12_ne0 : n12 <> 0. { exact Hn12ne. }
        claim H0in12 : 0 :e n12.
        { exact (eq_subst_mem_set 0 2 n12 In_0_2 (eq_symm n12 2 Hn12_2)). }
        claim H1in12 : 1 :e n12.
        { exact (eq_subst_mem_set 1 2 n12 In_1_2 (eq_symm n12 2 Hn12_2)). }
        set efam12 := graph (UPair 0 1) (fun _:set => eG).
        claim Hxs12fam0 :
          exists alpha0:set, alpha0 :e (UPair 0 1) /\
            apply_fun xs12 0 :e apply_fun Gfam12 alpha0 /\
            apply_fun xs12 0 <> apply_fun efam12 alpha0.
        {
          apply (and3E
            (n12 :e omega)
            (forall i:set, i :e n12 ->
              exists alpha:set, alpha :e (UPair 0 1) /\
                apply_fun xs12 i :e apply_fun Gfam12 alpha /\
                apply_fun xs12 i <> apply_fun efam12 alpha)
            (forall i:set, i :e n12 -> ordsucc i :e n12 ->
              forall alpha beta:set, alpha :e (UPair 0 1) -> beta :e (UPair 0 1) ->
                apply_fun xs12 i :e apply_fun Gfam12 alpha ->
                apply_fun xs12 (ordsucc i) :e apply_fun Gfam12 beta ->
                alpha <> beta)
            Hred12word).
          assume _ Hxs12fam _. exact (Hxs12fam 0 H0in12).
        }
        claim Hxs12fam1 :
          exists alpha1:set, alpha1 :e (UPair 0 1) /\
            apply_fun xs12 1 :e apply_fun Gfam12 alpha1 /\
            apply_fun xs12 1 <> apply_fun efam12 alpha1.
        {
          apply (and3E
            (n12 :e omega)
            (forall i:set, i :e n12 ->
              exists alpha:set, alpha :e (UPair 0 1) /\
                apply_fun xs12 i :e apply_fun Gfam12 alpha /\
                apply_fun xs12 i <> apply_fun efam12 alpha)
            (forall i:set, i :e n12 -> ordsucc i :e n12 ->
              forall alpha beta:set, alpha :e (UPair 0 1) -> beta :e (UPair 0 1) ->
                apply_fun xs12 i :e apply_fun Gfam12 alpha ->
                apply_fun xs12 (ordsucc i) :e apply_fun Gfam12 beta ->
                alpha <> beta)
            Hred12word).
          assume _ Hxs12fam _. exact (Hxs12fam 1 H1in12).
        }
        claim Hadj12 :
          forall i:set, i :e n12 -> ordsucc i :e n12 ->
            forall alpha beta:set, alpha :e (UPair 0 1) -> beta :e (UPair 0 1) ->
              apply_fun xs12 i :e apply_fun Gfam12 alpha ->
              apply_fun xs12 (ordsucc i) :e apply_fun Gfam12 beta ->
              alpha <> beta.
        {
          apply (and3E
            (n12 :e omega)
            (forall i:set, i :e n12 ->
              exists alpha:set, alpha :e (UPair 0 1) /\
                apply_fun xs12 i :e apply_fun Gfam12 alpha /\
                apply_fun xs12 i <> apply_fun efam12 alpha)
            (forall i:set, i :e n12 -> ordsucc i :e n12 ->
              forall alpha beta:set, alpha :e (UPair 0 1) -> beta :e (UPair 0 1) ->
                apply_fun xs12 i :e apply_fun Gfam12 alpha ->
                apply_fun xs12 (ordsucc i) :e apply_fun Gfam12 beta ->
                alpha <> beta)
            Hred12word).
          assume _ _ Hadj. exact Hadj.
        }

        (** x is not in either factor when the binary reduced word has length 2. **)
        claim Hx_not_G1 : x /:e G1.
        {
          claim Hwp_not_G1 : word_product multG eG xs12 n12 /:e G1.
          {
            exact (free_product_binary_reduced_word_length_ge2_not_in_left_factor
              G multG eG invG G1 G2 n12 xs12
              Hsub1 Hsub2 Hfp
              Hred12word
              Hn12_ne0
              Hn12_ne1).
          }
          assume HxG1 : x :e G1.
          claim HwpG1 : word_product multG eG xs12 n12 :e G1.
          { exact (eq_subst_mem_rev x (word_product multG eG xs12 n12) G1 (eq_symm (word_product multG eG xs12 n12) x Hwp12) HxG1). }
          exact (Hwp_not_G1 HwpG1).
        }
        claim Hx_not_G2 : x /:e G2.
        {
          claim Hwp_not_G2 : word_product multG eG xs12 n12 /:e G2.
          {
            exact (free_product_binary_reduced_word_length_ge2_not_in_right_factor
              G multG eG invG G1 G2 n12 xs12
              Hsub1 Hsub2 Hfp
              Hred12word
              Hn12_ne0
              Hn12_ne1).
          }
          assume HxG2 : x :e G2.
          claim HwpG2 : word_product multG eG xs12 n12 :e G2.
          { exact (eq_subst_mem_rev x (word_product multG eG xs12 n12) G2 (eq_symm (word_product multG eG xs12 n12) x Hwp12) HxG2). }
          exact (Hwp_not_G2 HwpG2).
        }

        (** Any reduced (J \\/ K)-word representing x has all letters nontrivial and uses both sides. **)
        claim Hn_ne1 : n <> 1.
        {
          assume Hn1.
          claim H0in : 0 :e n.
          { rewrite Hn1. exact (nat_0_in_ordsucc 0 nat_0). }
          apply (Hside_union n xs Hred 0 H0in).
          - assume Hx0G1.
            claim Hxs0_G : apply_fun xs 0 :e G.
            { exact (subgroup_of_subset G1 G multG eG invG Hsub1 (apply_fun xs 0) Hx0G1). }
            claim Hx_eq : x = apply_fun xs 0.
            {
              claim Hwp1 : word_product multG eG xs 1 = apply_fun xs 0.
              {
                claim Hwp1' : word_product multG eG xs 1 = apply_fun multG (word_product multG eG xs 0, apply_fun xs 0).
                { exact (word_product_succ multG eG xs 0 nat_0). }
                claim Hwp0 : word_product multG eG xs 0 = eG.
                { exact (nat_primrec_0 eG (fun i r => apply_fun multG (r, apply_fun xs i))). }
                claim HidL :
                  apply_fun multG (eG, apply_fun xs 0) = apply_fun xs 0.
                {
                  apply (and6E
                    (function_on multG (setprod G G) G)
                    (function_on invG G G)
                    (eG :e G)
                    (forall y z w:set, y :e G -> z :e G -> w :e G ->
                      apply_fun multG (apply_fun multG (y, z), w) =
                        apply_fun multG (y, apply_fun multG (z, w)))
                    (forall y:set, y :e G -> apply_fun multG (eG, y) = y /\ apply_fun multG (y, eG) = y)
                    (forall y:set, y :e G ->
                      apply_fun multG (y, apply_fun invG y) = eG /\
                      apply_fun multG (apply_fun invG y, y) = eG)
                    Hgrp).
                  assume _ _ _ _ Hid _.
                  exact (andEL
                    (apply_fun multG (eG, apply_fun xs 0) = apply_fun xs 0)
                    (apply_fun multG (apply_fun xs 0, eG) = apply_fun xs 0)
                    (Hid (apply_fun xs 0) Hxs0_G)).
                }
                rewrite Hwp1'. rewrite Hwp0. exact HidL.
              }
              rewrite <- Hwp1.
              rewrite <- Hn1.
              exact (eq_symm (word_product multG eG xs n) x Hwp).
            }
            apply Hx_not_G1.
            rewrite Hx_eq.
            exact Hx0G1.
          - assume Hx0G2.
            claim Hxs0_G : apply_fun xs 0 :e G.
            { exact (subgroup_of_subset G2 G multG eG invG Hsub2 (apply_fun xs 0) Hx0G2). }
            claim Hx_eq : x = apply_fun xs 0.
            {
              claim Hwp1 : word_product multG eG xs 1 = apply_fun xs 0.
              {
                claim Hwp1' : word_product multG eG xs 1 = apply_fun multG (word_product multG eG xs 0, apply_fun xs 0).
                { exact (word_product_succ multG eG xs 0 nat_0). }
                claim Hwp0 : word_product multG eG xs 0 = eG.
                { exact (nat_primrec_0 eG (fun i r => apply_fun multG (r, apply_fun xs i))). }
                claim HidL :
                  apply_fun multG (eG, apply_fun xs 0) = apply_fun xs 0.
                {
                  apply (and6E
                    (function_on multG (setprod G G) G)
                    (function_on invG G G)
                    (eG :e G)
                    (forall y z w:set, y :e G -> z :e G -> w :e G ->
                      apply_fun multG (apply_fun multG (y, z), w) =
                        apply_fun multG (y, apply_fun multG (z, w)))
                    (forall y:set, y :e G -> apply_fun multG (eG, y) = y /\ apply_fun multG (y, eG) = y)
                    (forall y:set, y :e G ->
                      apply_fun multG (y, apply_fun invG y) = eG /\
                      apply_fun multG (apply_fun invG y, y) = eG)
                    Hgrp).
                  assume _ _ _ _ Hid _.
                  exact (andEL
                    (apply_fun multG (eG, apply_fun xs 0) = apply_fun xs 0)
                    (apply_fun multG (apply_fun xs 0, eG) = apply_fun xs 0)
                    (Hid (apply_fun xs 0) Hxs0_G)).
                }
                rewrite Hwp1'. rewrite Hwp0. exact HidL.
              }
              rewrite <- Hwp1.
              rewrite <- Hn1.
              exact (eq_symm (word_product multG eG xs n) x Hwp).
            }
            apply Hx_not_G2.
            rewrite Hx_eq.
            exact Hx0G2.
        }
        claim Hn'_ne1 : n' <> 1.
        {
          assume Hn1.
          claim H0in : 0 :e n'.
          { rewrite Hn1. exact (nat_0_in_ordsucc 0 nat_0). }
          apply (Hside_union n' xs' Hred' 0 H0in).
          - assume Hx0G1.
            claim Hxs0_G : apply_fun xs' 0 :e G.
            { exact (subgroup_of_subset G1 G multG eG invG Hsub1 (apply_fun xs' 0) Hx0G1). }
            claim Hx_eq : x = apply_fun xs' 0.
            {
              claim Hwp1 : word_product multG eG xs' 1 = apply_fun xs' 0.
              {
                claim Hwp1' : word_product multG eG xs' 1 = apply_fun multG (word_product multG eG xs' 0, apply_fun xs' 0).
                { exact (word_product_succ multG eG xs' 0 nat_0). }
                claim Hwp0 : word_product multG eG xs' 0 = eG.
                { exact (nat_primrec_0 eG (fun i r => apply_fun multG (r, apply_fun xs' i))). }
                claim HidL :
                  apply_fun multG (eG, apply_fun xs' 0) = apply_fun xs' 0.
                {
                  apply (and6E
                    (function_on multG (setprod G G) G)
                    (function_on invG G G)
                    (eG :e G)
                    (forall y z w:set, y :e G -> z :e G -> w :e G ->
                      apply_fun multG (apply_fun multG (y, z), w) =
                        apply_fun multG (y, apply_fun multG (z, w)))
                    (forall y:set, y :e G -> apply_fun multG (eG, y) = y /\ apply_fun multG (y, eG) = y)
                    (forall y:set, y :e G ->
                      apply_fun multG (y, apply_fun invG y) = eG /\
                      apply_fun multG (apply_fun invG y, y) = eG)
                    Hgrp).
                  assume _ _ _ _ Hid _.
                  exact (andEL
                    (apply_fun multG (eG, apply_fun xs' 0) = apply_fun xs' 0)
                    (apply_fun multG (apply_fun xs' 0, eG) = apply_fun xs' 0)
                    (Hid (apply_fun xs' 0) Hxs0_G)).
                }
                rewrite Hwp1'. rewrite Hwp0. exact HidL.
              }
              rewrite <- Hwp1.
              rewrite <- Hn1.
              exact (eq_symm (word_product multG eG xs' n') x Hwp').
            }
            apply Hx_not_G1.
            rewrite Hx_eq.
            exact Hx0G1.
          - assume Hx0G2.
            claim Hxs0_G : apply_fun xs' 0 :e G.
            { exact (subgroup_of_subset G2 G multG eG invG Hsub2 (apply_fun xs' 0) Hx0G2). }
            claim Hx_eq : x = apply_fun xs' 0.
            {
              claim Hwp1 : word_product multG eG xs' 1 = apply_fun xs' 0.
              {
                claim Hwp1' : word_product multG eG xs' 1 = apply_fun multG (word_product multG eG xs' 0, apply_fun xs' 0).
                { exact (word_product_succ multG eG xs' 0 nat_0). }
                claim Hwp0 : word_product multG eG xs' 0 = eG.
                { exact (nat_primrec_0 eG (fun i r => apply_fun multG (r, apply_fun xs' i))). }
                claim HidL :
                  apply_fun multG (eG, apply_fun xs' 0) = apply_fun xs' 0.
                {
                  apply (and6E
                    (function_on multG (setprod G G) G)
                    (function_on invG G G)
                    (eG :e G)
                    (forall y z w:set, y :e G -> z :e G -> w :e G ->
                      apply_fun multG (apply_fun multG (y, z), w) =
                        apply_fun multG (y, apply_fun multG (z, w)))
                    (forall y:set, y :e G -> apply_fun multG (eG, y) = y /\ apply_fun multG (y, eG) = y)
                    (forall y:set, y :e G ->
                      apply_fun multG (y, apply_fun invG y) = eG /\
                      apply_fun multG (apply_fun invG y, y) = eG)
                    Hgrp).
                  assume _ _ _ _ Hid _.
                  exact (andEL
                    (apply_fun multG (eG, apply_fun xs' 0) = apply_fun xs' 0)
                    (apply_fun multG (apply_fun xs' 0, eG) = apply_fun xs' 0)
                    (Hid (apply_fun xs' 0) Hxs0_G)).
                }
                rewrite Hwp1'. rewrite Hwp0. exact HidL.
              }
              rewrite <- Hwp1.
              rewrite <- Hn1.
              exact (eq_symm (word_product multG eG xs' n') x Hwp').
            }
            apply Hx_not_G2.
            rewrite Hx_eq.
            exact Hx0G2.
        }

        claim HallNe : forall i:set, i :e n -> apply_fun xs i <> eG.
        { exact (reduced_word_no_eG_all
            G multG eG invG (J :\/: K) Hfam efamH
            n xs Hgrp Hsubfam_union Hred Hn_ne Hn_ne1). }
        claim HallNe' : forall i:set, i :e n' -> apply_fun xs' i <> eG.
        { exact (reduced_word_no_eG_all
            G multG eG invG (J :\/: K) Hfam efamH
            n' xs' Hgrp Hsubfam_union Hred' Hn'_ne Hn'_ne1). }

        claim HexG1 : exists i:set, i :e n /\ apply_fun xs i :e G1.
        {
          apply (xm (exists i:set, i :e n /\ apply_fun xs i :e G1)).
          - assume Hex. exact Hex.
          - assume Hno.
            claim HallG2 : forall i:set, i :e n -> apply_fun xs i :e G2.
            {
              let i. assume Hi.
	              apply (Hside_union n xs Hred i Hi).
	              + assume HiG1.
	                claim Hex : exists i0:set, i0 :e n /\ apply_fun xs i0 :e G1.
	                { witness i. exact (andI (i :e n) (apply_fun xs i :e G1) Hi HiG1). }
	                exact (FalseE (Hno Hex) (apply_fun xs i :e G2)).
	              + assume HiG2. exact HiG2.
	            }
            claim HxG2 : x :e G2.
            { rewrite <- Hwp. exact (Hword_product_in_G2 n xs Hred HallG2). }
            exact (FalseE (Hx_not_G2 HxG2) (exists i:set, i :e n /\ apply_fun xs i :e G1)).
        }
        claim HexG2 : exists i:set, i :e n /\ apply_fun xs i :e G2.
        {
          apply (xm (exists i:set, i :e n /\ apply_fun xs i :e G2)).
          - assume Hex. exact Hex.
          - assume Hno.
            claim HallG1 : forall i:set, i :e n -> apply_fun xs i :e G1.
            {
              let i. assume Hi.
              apply (Hside_union n xs Hred i Hi).
	              + assume HiG1. exact HiG1.
	              + assume HiG2.
	                claim Hex : exists i0:set, i0 :e n /\ apply_fun xs i0 :e G2.
	                { witness i. exact (andI (i :e n) (apply_fun xs i :e G2) Hi HiG2). }
	                exact (FalseE (Hno Hex) (apply_fun xs i :e G1)).
	            }
            claim HxG1 : x :e G1.
            { rewrite <- Hwp. exact (Hword_product_in_G1 n xs Hred HallG1). }
            exact (FalseE (Hx_not_G1 HxG1) (exists i:set, i :e n /\ apply_fun xs i :e G2)).
        }
        claim HexG1' : exists i:set, i :e n' /\ apply_fun xs' i :e G1.
        {
          apply (xm (exists i:set, i :e n' /\ apply_fun xs' i :e G1)).
          - assume Hex. exact Hex.
          - assume Hno.
            claim HallG2 : forall i:set, i :e n' -> apply_fun xs' i :e G2.
            {
              let i. assume Hi.
	              apply (Hside_union n' xs' Hred' i Hi).
	              + assume HiG1.
	                claim Hex : exists i0:set, i0 :e n' /\ apply_fun xs' i0 :e G1.
	                { witness i. exact (andI (i :e n') (apply_fun xs' i :e G1) Hi HiG1). }
	                exact (FalseE (Hno Hex) (apply_fun xs' i :e G2)).
	              + assume HiG2. exact HiG2.
	            }
            claim HxG2 : x :e G2.
            { rewrite <- Hwp'. exact (Hword_product_in_G2 n' xs' Hred' HallG2). }
            exact (FalseE (Hx_not_G2 HxG2) (exists i:set, i :e n' /\ apply_fun xs' i :e G1)).
        }
        claim HexG2' : exists i:set, i :e n' /\ apply_fun xs' i :e G2.
        {
          apply (xm (exists i:set, i :e n' /\ apply_fun xs' i :e G2)).
          - assume Hex. exact Hex.
          - assume Hno.
            claim HallG1 : forall i:set, i :e n' -> apply_fun xs' i :e G1.
            {
              let i. assume Hi.
              apply (Hside_union n' xs' Hred' i Hi).
	              + assume HiG1. exact HiG1.
	              + assume HiG2.
	                claim Hex : exists i0:set, i0 :e n' /\ apply_fun xs' i0 :e G2.
	                { witness i. exact (andI (i :e n') (apply_fun xs' i :e G2) Hi HiG2). }
	                exact (FalseE (Hno Hex) (apply_fun xs' i :e G1)).
	            }
            claim HxG1 : x :e G1.
            { rewrite <- Hwp'. exact (Hword_product_in_G1 n' xs' Hred' HallG1). }
            exact (FalseE (Hx_not_G1 HxG1) (exists i:set, i :e n' /\ apply_fun xs' i :e G2)).
        }

        (** Determine the last binary factor alpha1 (at index 1). **)
        apply Hxs12fam0. let alpha0. assume Halpha0_pack.
        apply (and3E
          (alpha0 :e UPair 0 1)
          (apply_fun xs12 0 :e apply_fun Gfam12 alpha0)
          (apply_fun xs12 0 <> apply_fun efam12 alpha0)
          Halpha0_pack).
        assume Hal0 Hx0fam Hx0ne.
        apply Hxs12fam1. let alpha1. assume Halpha1_pack.
        apply (and3E
          (alpha1 :e UPair 0 1)
          (apply_fun xs12 1 :e apply_fun Gfam12 alpha1)
          (apply_fun xs12 1 <> apply_fun efam12 alpha1)
          Halpha1_pack).
        assume Hal1 Hx1fam Hx1ne.
        claim Halpha_ne : alpha0 <> alpha1.
        { exact (Hadj12 0 H0in12 H1in12 alpha0 alpha1 Hal0 Hal1 Hx0fam Hx1fam). }

        (** Case split on the last factor alpha1. **)
        apply (UPairE alpha1 0 1 Hal1).
        - assume Halpha1_0.
          (** Last binary factor is G1, hence first is G2. **)
          claim Halpha0_1 : alpha0 = 1.
          {
            apply (UPairE alpha0 0 1 Hal0).
            + assume Halpha0_0.
              claim Heq : alpha0 = alpha1.
              { rewrite Halpha0_0. rewrite Halpha1_0. reflexivity. }
              exact (FalseE (Halpha_ne Heq) (alpha0 = 1)).
            + assume Halpha0_1. exact Halpha0_1.
          }
          (** Translate xs12 letters into the actual factors. **)
          claim Hx0G2 : apply_fun xs12 0 :e G2.
          {
            claim HG0 : apply_fun Gfam12 alpha0 = G2.
            {
              rewrite (apply_fun_graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2) alpha0 Hal0).
              claim Hne0 : alpha0 <> 0.
              { rewrite Halpha0_1. exact neq_1_0. }
              exact (If_i_0 (alpha0 = 0) G1 G2 Hne0).
            }
            exact (eq_subst_mem_set (apply_fun xs12 0) (apply_fun Gfam12 alpha0) G2 Hx0fam HG0).
          }
          claim Hx1G1 : apply_fun xs12 1 :e G1.
          {
            claim HG1 : apply_fun Gfam12 alpha1 = G1.
            {
              rewrite (apply_fun_graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2) alpha1 Hal1).
              exact (If_i_1 (alpha1 = 0) G1 G2 Halpha1_0).
            }
            exact (eq_subst_mem_set (apply_fun xs12 1) (apply_fun Gfam12 alpha1) G1 Hx1fam HG1).
	          }
	          claim Hx0neG : apply_fun xs12 0 <> eG.
	          {
	            claim He0 : apply_fun efam12 alpha0 = eG.
	            { exact (apply_fun_graph (UPair 0 1) (fun _:set => eG) alpha0 Hal0). }
	            assume Heq0 : apply_fun xs12 0 = eG.
	            apply Hx0ne.
	            rewrite He0.
	            exact Heq0.
	          }
	          claim Hx1neG : apply_fun xs12 1 <> eG.
	          {
	            claim He1 : apply_fun efam12 alpha1 = eG.
	            { exact (apply_fun_graph (UPair 0 1) (fun _:set => eG) alpha1 Hal1). }
	            assume Heq1 : apply_fun xs12 1 = eG.
	            apply Hx1ne.
	            rewrite He1.
	            exact Heq1.
	          }

          (** Decompose xs (the witness word) into prefix in G2 and suffix in G1 via max index. **)
          apply (cor68_6_max_G2_index_suffix_all_in_G1
            G multG eG invG G1 G2 J K Hfam efamH n xs
	            Hgrp Hsub1 Hsub2 Hfp Hfp1 Hfp2
	            Hred HallNe
	            HexG1 HexG2).
	          let m. assume Hm_pack.
	          apply (and4E
	            (m :e n)
	            (apply_fun xs m :e G2)
	            (forall i:set, i :e n -> apply_fun xs i :e G2 -> i c= m)
	            (forall i:set, i :e n -> ordsucc m c= i -> apply_fun xs i :e G1)
	            Hm_pack).
	          assume Hm_in HymG2 Hm_maxG2 Hsuffix_all_G1.

          set n1 := ordsucc m.
          (** Decompose n = n1 + n2. **)
          claim HnO : n :e omega.
          {
            apply (and3E
              (n :e omega)
              (forall i:set, i :e n ->
                exists alpha:set, alpha :e J :\/: K /\
                  apply_fun xs i :e apply_fun Hfam alpha /\
                  apply_fun xs i <> apply_fun efamH alpha)
              (forall i:set, i :e n -> ordsucc i :e n ->
                forall alpha beta:set, alpha :e J :\/: K -> beta :e J :\/: K ->
                  apply_fun xs i :e apply_fun Hfam alpha ->
                  apply_fun xs (ordsucc i) :e apply_fun Hfam beta ->
                  alpha <> beta)
              Hred).
            assume HnO0 _ _. exact HnO0.
          }
          claim Hn_nat : nat_p n. { exact (omega_nat_p n HnO). }
          claim Hn_ord : ordinal n. { exact (nat_p_ordinal n Hn_nat). }
          claim HmO : m :e omega.
          {
            claim Hn_sub_omega : n c= omega.
            { exact (omega_TransSet n HnO). }
            exact (Hn_sub_omega m Hm_in).
          }
          claim Hm_nat : nat_p m. { exact (omega_nat_p m HmO). }
          claim Hn1_nat : nat_p n1. { exact (nat_ordsucc m Hm_nat). }
          claim Hn1_sub_n : n1 c= n.
          { exact (ordinal_ordsucc_In_Subq n Hn_ord m Hm_in). }
          apply (nat_Subq_add_ex n1 Hn1_nat n Hn_nat Hn1_sub_n).
          let n2. assume Hn2_pack.
          claim Hn2_nat : nat_p n2.
          { exact (andEL (nat_p n2) (n = add_nat n2 n1) Hn2_pack). }
          claim Hn_eq' : n = add_nat n2 n1.
          { exact (andER (nat_p n2) (n = add_nat n2 n1) Hn2_pack). }
          claim Hn_eq : n = add_nat n1 n2.
          { rewrite Hn_eq'. rewrite (add_nat_com n2 Hn2_nat n1 Hn1_nat). reflexivity. }

	          (** Prefix and suffix words. **)
	          set xs1 := graph n1 (fun i:set => apply_fun xs i).
	          set xs2 := graph n2 (fun i:set => apply_fun xs (add_nat n1 i)).
	          claim Hred2 : reduced_word (J :\/: K) Hfam efamH n2 xs2.
	          { exact (reduced_word_suffix_by_add_nat (J :\/: K) Hfam efamH n xs n1 n2 Hred Hn1_nat Hn2_nat Hn_eq). }
          claim HallNe2 : forall i:set, i :e n2 -> apply_fun xs2 i <> eG.
          {
            let i. assume Hi2.
            rewrite (apply_fun_graph n2 (fun t:set => apply_fun xs (add_nat n1 t)) i Hi2).
            claim Hin_sum : add_nat n1 i :e add_nat n1 n2.
            { exact (add_nat_In_L n1 Hn1_nat n2 Hn2_nat i Hi2). }
            claim Hin_n : add_nat n1 i :e n.
            { exact (eq_subst_mem_set (add_nat n1 i) (add_nat n1 n2) n Hin_sum (eq_symm n (add_nat n1 n2) Hn_eq)). }
            exact (HallNe (add_nat n1 i) Hin_n).
          }
          claim HallG1_2 : forall i:set, i :e n2 -> apply_fun xs2 i :e G1.
          {
            let i. assume Hi2.
            rewrite (apply_fun_graph n2 (fun t:set => apply_fun xs (add_nat n1 t)) i Hi2).
            claim Hin_sum : add_nat n1 i :e add_nat n1 n2.
            { exact (add_nat_In_L n1 Hn1_nat n2 Hn2_nat i Hi2). }
            claim Hin_n : add_nat n1 i :e n.
            { exact (eq_subst_mem_set (add_nat n1 i) (add_nat n1 n2) n Hin_sum (eq_symm n (add_nat n1 n2) Hn_eq)). }
            claim Hsub : n1 c= add_nat n1 i.
            { exact (add_nat_Subq_R' n1 Hn1_nat i (nat_p_trans n2 Hn2_nat i Hi2)). }
            exact (Hsuffix_all_G1 (add_nat n1 i) Hin_n Hsub).
          }
		          (** Suffix product is nontrivial. **)
		          claim Hn2_ne0 : n2 <> 0.
		          {
		            assume Hn20.
		            (** Then n = ordsucc m, so xs ends in a G2-letter. Collapsing to a binary word yields a representation of x ending in factor 1, contradicting alpha1 = 0. **)
		            claim Hn_eq_sm : n = ordsucc m.
		            {
		              rewrite Hn_eq.
		              rewrite Hn20.
		              rewrite (add_nat_0R n1).
		              reflexivity.
		            }
		            claim Hred_sm : reduced_word (J :\/: K) Hfam efamH (ordsucc m) xs.
		            { rewrite <- Hn_eq_sm. exact Hred. }
		            claim HallNe_sm : forall i:set, i :e ordsucc m -> apply_fun xs i <> eG.
		            {
		              let i. assume Hi.
		              claim Hi_n : i :e n.
		              { exact (eq_subst_mem_set i (ordsucc m) n Hi (eq_symm n (ordsucc m) Hn_eq_sm)). }
		              exact (HallNe i Hi_n).
		            }
		            claim Hlast_m : apply_fun xs m :e apply_fun Gfam12 1.
		            {
		              rewrite (apply_fun_graph (UPair 0 1) (fun t:set => if t = 0 then G1 else G2) 1 (UPairI2 0 1)).
		              rewrite (If_i_0 (1 = 0) G1 G2 neq_1_0).
		              exact HymG2.
		            }
		            claim Hcoll_last :
		              exists nb xb kb:set,
		                reduced_word (UPair 0 1) Gfam12 efam12 nb xb /\
		                word_product multG eG xb nb = word_product multG eG xs (ordsucc m) /\
		                nb <> 0 /\ nat_p kb /\ nb = ordsucc kb /\
		                apply_fun xb kb :e apply_fun Gfam12 1.
		            {
		              exact (cor68_6_collapse_union_word_to_binary_end_in_factor
		                G multG eG invG G1 G2 J K Hfam efamH m xs 1
		                Hgrp Hsub1 Hsub2 Hfp Hfp1 Hfp2
		                Hm_nat
		                Hred_sm
		                HallNe_sm
		                (UPairI2 0 1)
		                Hlast_m).
		            }
		            apply Hcoll_last. let nb. assume Hnb_pack.
		            apply Hnb_pack. let xb. assume Hxb_pack.
		            apply Hxb_pack. let kb. assume Hkb_pack.
		            apply (and6E
		              (reduced_word (UPair 0 1) Gfam12 efam12 nb xb)
		              (word_product multG eG xb nb = word_product multG eG xs (ordsucc m))
		              (nb <> 0)
		              (nat_p kb)
		              (nb = ordsucc kb)
		              (apply_fun xb kb :e apply_fun Gfam12 1)
		              Hkb_pack).
		            assume Hredb Hwpb Hnb_ne0 Hkb_nat Hnb_eq Hlastb.
		            claim Hwp_sm : word_product multG eG xs (ordsucc m) = x.
		            { rewrite <- Hn_eq_sm. exact Hwp. }
		            claim Hwpb_x : word_product multG eG xb nb = x.
		            { exact (eq_i_tra (word_product multG eG xb nb) (word_product multG eG xs (ordsucc m)) x Hwpb Hwp_sm). }
		            claim Huniqb :
		              n12 = nb /\ (forall i0:set, i0 :e n12 -> apply_fun xs12 i0 = apply_fun xb i0).
		            { exact (Huniq12 nb xb Hredb Hnb_ne0 Hwpb_x). }
		            claim Hn12_eq_nb : n12 = nb.
		            { exact (andEL (n12 = nb) (forall i0:set, i0 :e n12 -> apply_fun xs12 i0 = apply_fun xb i0) Huniqb). }
		            claim Hpt : forall i0:set, i0 :e n12 -> apply_fun xs12 i0 = apply_fun xb i0.
		            { exact (andER (n12 = nb) (forall i0:set, i0 :e n12 -> apply_fun xs12 i0 = apply_fun xb i0) Huniqb). }
		            claim Hnb_2 : nb = 2.
		            { exact (eq_i_tra nb n12 2 (eq_symm n12 nb Hn12_eq_nb) Hn12_2). }
		            claim Hsk2 : ordsucc kb = 2.
		            { exact (eq_i_tra (ordsucc kb) nb 2 (eq_symm nb (ordsucc kb) Hnb_eq) Hnb_2). }
		            claim Hsk1 : ordsucc kb = ordsucc 1.
		            { exact (eq_i_tra (ordsucc kb) 2 (ordsucc 1) Hsk2 (eq_symm (ordsucc 1) 2 ordsucc_1_eq_2_nat)). }
		            claim Hkb1 : kb = 1.
		            { exact (ordsucc_inj kb 1 Hsk1). }
		            claim Hlastb1 : apply_fun xb 1 :e apply_fun Gfam12 1.
		            {
		              claim Hxb_eq : apply_fun xb 1 = apply_fun xb kb.
		              {
		                rewrite Hkb1.
		                reflexivity.
		              }
		              exact (eq_subst_mem (apply_fun xb 1) (apply_fun xb kb) (apply_fun Gfam12 1) Hxb_eq Hlastb).
		            }
		            claim HGfam1 : apply_fun Gfam12 1 = G2.
		            {
		              rewrite (apply_fun_graph (UPair 0 1) (fun t:set => if t = 0 then G1 else G2) 1 (UPairI2 0 1)).
		              exact (If_i_0 (1 = 0) G1 G2 neq_1_0).
		            }
		            claim Hxb1_G2 : apply_fun xb 1 :e G2.
		            { exact (eq_subst_mem_set (apply_fun xb 1) (apply_fun Gfam12 1) G2 Hlastb1 HGfam1). }
		            claim Hx1eq : apply_fun xs12 1 = apply_fun xb 1.
		            { exact (Hpt 1 H1in12). }
		            claim Hx1_G2 : apply_fun xs12 1 :e G2.
		            { exact (eq_subst_mem (apply_fun xs12 1) (apply_fun xb 1) G2 Hx1eq Hxb1_G2). }
		            claim Hx1_e : apply_fun xs12 1 = eG.
		            { exact (free_product_binary_factors_intersect_trivial
		              G multG eG invG G1 G2 (apply_fun xs12 1) Hfp Hx1G1 Hx1_G2). }
		            exact (Hx1neG Hx1_e).
		          }
	          (** n1 lies strictly before n since the suffix length n2 is nonzero. **)
	          claim H0_in_n2 : 0 :e n2.
	          {
	            claim Hn2_succ : exists k2:set, n2 = ordsucc k2.
	            { exact (Hnat_nonzero_succ n2 Hn2_nat Hn2_ne0). }
	            apply Hn2_succ. let k2. assume Hn2_eq.
	            claim Hk2_nat : nat_p k2.
	            {
	              claim Hk2_in : k2 :e n2.
	              { rewrite Hn2_eq. exact (ordsuccI2 k2). }
	              exact (nat_p_trans n2 Hn2_nat k2 Hk2_in).
	            }
	            rewrite Hn2_eq.
	            exact (nat_0_in_ordsucc k2 Hk2_nat).
	          }
	          claim Hn1_in_n : n1 :e n.
	          {
	            claim Hn10_in_sum : add_nat n1 0 :e add_nat n1 n2.
	            { exact (add_nat_In_L n1 Hn1_nat n2 Hn2_nat 0 H0_in_n2). }
	            claim Hn1_in_sum : n1 :e add_nat n1 n2.
	            { exact (eq_subst_mem_rev (add_nat n1 0) n1 (add_nat n1 n2) (add_nat_0R n1) Hn10_in_sum). }
	            exact (eq_subst_mem_set n1 (add_nat n1 n2) n Hn1_in_sum (eq_symm n (add_nat n1 n2) Hn_eq)).
	          }
	          claim Hred1 : reduced_word (J :\/: K) Hfam efamH n1 xs1.
	          { exact (reduced_word_prefix (J :\/: K) Hfam efamH n xs n1 Hred Hn1_in_n). }
	          claim Hsuf_ne : word_product multG eG xs2 n2 <> eG.
	          {
	            exact (cor68_6_reduced_word_all_in_G1_product_ne_eG
	              G multG eG invG G1 G2 J K Hfam efamH n2 xs2
	              Hgrp Hsub1 Hsub2 Hfp Hfp1 Hfp2
	              Hred2 HallNe2 HallG1_2 Hn2_ne0).
          }
          (** Prefix letters are all in G2 (otherwise we could build a longer binary reduced word for x). **)
          claim HallG2_1 : forall i:set, i :e n1 -> apply_fun xs1 i :e G2.
          {
            let i. assume Hi1.
            apply (Hside_union n1 xs1 Hred1 i Hi1).
            - assume HxiG1.
              (** If some prefix letter lies in G1, then the prefix product is mixed and nontrivial,
                  hence gives a binary reduced word of length >= 2 ending in factor 1.
                  Appending the nontrivial suffix product in G1 yields a longer binary reduced word for x,
                  contradicting uniqueness of the binary normal form (n12 = 2). **)

              (** Nontriviality of suffix product (already established) and its side. **)
              set wp2 := word_product multG eG xs2 n2.
              claim Hwp2_ne : wp2 <> eG. { exact Hsuf_ne. }
              claim Hwp2_G1 : wp2 :e G1.
              { exact (Hword_product_in_G1 n2 xs2 Hred2 HallG1_2). }

              (** Split x into prefix and suffix products. **)
              claim HxsG_all : forall j:set, j :e n -> apply_fun xs j :e G.
              {
                let j. assume Hj.
                apply (Hside_union n xs Hred j Hj).
                - assume HjG1.
                  exact (subgroup_of_subset G1 G multG eG invG Hsub1 (apply_fun xs j) HjG1).
                - assume HjG2.
                  exact (subgroup_of_subset G2 G multG eG invG Hsub2 (apply_fun xs j) HjG2).
              }
              claim Hxs1G_all : forall j:set, j :e n1 -> apply_fun xs1 j :e G.
              {
                let j. assume Hj1.
                rewrite (apply_fun_graph n1 (fun t:set => apply_fun xs t) j Hj1).
                exact (HxsG_all j (Hn1_sub_n j Hj1)).
              }
              set wp1 := word_product multG eG xs1 n1.
              claim Hwp1_ne : wp1 <> eG.
              {
                assume Hwp1_e.
                (** Use word_product_split_by_add_nat on the full word to conclude x :e G1. **)
                claim Hsplit :
                  word_product multG eG xs n =
                    apply_fun multG (word_product multG eG xs n1, wp2).
                {
                  claim Hsplit0 :
                    word_product multG eG xs n =
                      apply_fun multG
                        (word_product multG eG xs n1,
                         word_product multG eG (graph n2 (fun t:set => apply_fun xs (add_nat n1 t))) n2).
	                  {
	                    exact (word_product_split_by_add_nat
	                      G multG eG invG n xs n1 n2
	                      Hgrp Hn1_nat Hn2_nat Hn_eq
	                      HxsG_all).
	                  }
	                  rewrite Hsplit0.
	                  reflexivity.
                }
                claim Hx_eq :
                  x = apply_fun multG (word_product multG eG xs n1, wp2).
                {
                  rewrite <- Hsplit.
                  exact (eq_symm (word_product multG eG xs n) x Hwp).
                }
                (** Since wp1 = word_product xs n1, rewrite the prefix product and simplify. **)
	                claim Hwp1_eq :
	                  word_product multG eG xs n1 = wp1.
	                {
	                  claim Hn1O : n1 :e omega. { exact (nat_p_omega n1 Hn1_nat). }
	                  (** word_product depends only on values below n1, and xs1 agrees with xs there. **)
	                  apply (nat_primrec_ext eG
	                    (fun j r:set => apply_fun multG (r, apply_fun xs j))
	                    (fun j r:set => apply_fun multG (r, apply_fun xs1 j))
                    n1
                    Hn1O).
                  let j r. assume Hj1.
                  rewrite (apply_fun_graph n1 (fun t:set => apply_fun xs t) j Hj1).
                  reflexivity.
                }
                claim Hx_eq2 :
                  x = apply_fun multG (wp1, wp2).
                {
                  claim Hmul_eq :
                    apply_fun multG (word_product multG eG xs n1, wp2) =
                      apply_fun multG (wp1, wp2).
                  { rewrite Hwp1_eq. reflexivity. }
                  exact (eq_i_tra
                    x
                    (apply_fun multG (word_product multG eG xs n1, wp2))
                    (apply_fun multG (wp1, wp2))
                    Hx_eq
                    Hmul_eq).
                }
                claim Hx_eq3 : x = apply_fun multG (eG, wp2).
                {
                  claim Hmul_eq :
                    apply_fun multG (wp1, wp2) = apply_fun multG (eG, wp2).
                  { rewrite Hwp1_e. reflexivity. }
                  exact (eq_i_tra
                    x
                    (apply_fun multG (wp1, wp2))
                    (apply_fun multG (eG, wp2))
                    Hx_eq2
                    Hmul_eq).
                }
                claim Hwp2_G : wp2 :e G.
                { exact (subgroup_of_subset G1 G multG eG invG Hsub1 wp2 Hwp2_G1). }
                claim HidL :
                  apply_fun multG (eG, wp2) = wp2.
                {
                  apply (and6E
                    (function_on multG (setprod G G) G)
                    (function_on invG G G)
                    (eG :e G)
                    (forall y z w:set, y :e G -> z :e G -> w :e G ->
                      apply_fun multG (apply_fun multG (y, z), w) =
                        apply_fun multG (y, apply_fun multG (z, w)))
                    (forall y:set, y :e G -> apply_fun multG (eG, y) = y /\ apply_fun multG (y, eG) = y)
                    (forall y:set, y :e G ->
                      apply_fun multG (y, apply_fun invG y) = eG /\
                      apply_fun multG (apply_fun invG y, y) = eG)
                    Hgrp).
                  assume _ _ _ _ Hid _.
                  exact (andEL
                    (apply_fun multG (eG, wp2) = wp2)
                    (apply_fun multG (wp2, eG) = wp2)
                    (Hid wp2 Hwp2_G)).
                }
                claim Hx_eq4 : x = wp2.
                { exact (eq_i_tra x (apply_fun multG (eG, wp2)) wp2 Hx_eq3 HidL). }
                claim HxG1 : x :e G1.
                { rewrite Hx_eq4. exact Hwp2_G1. }
                exact (Hx_not_G1 HxG1).
              }

              (** All prefix letters are nontrivial. **)
              claim HallNe1 : forall j:set, j :e n1 -> apply_fun xs1 j <> eG.
              {
                let j. assume Hj1.
                rewrite (apply_fun_graph n1 (fun t:set => apply_fun xs t) j Hj1).
                exact (HallNe j (Hn1_sub_n j Hj1)).
              }

              (** The prefix is mixed: it contains a G1-letter (at i) and a G2-letter (at m). **)
              claim HexG1_1 : exists j:set, j :e n1 /\ apply_fun xs1 j :e G1.
              { witness i. exact (andI (i :e n1) (apply_fun xs1 i :e G1) Hi1 HxiG1). }
              claim Hm_in_n1 : m :e n1. { exact (ordsuccI2 m). }
              claim Hxm_G2 : apply_fun xs1 m :e G2.
              {
                rewrite (apply_fun_graph n1 (fun t:set => apply_fun xs t) m Hm_in_n1).
                exact HymG2.
              }
              claim HexG2_1 : exists j:set, j :e n1 /\ apply_fun xs1 j :e G2.
              { witness m. exact (andI (m :e n1) (apply_fun xs1 m :e G2) Hm_in_n1 Hxm_G2). }

              (** Hence the prefix product is not in G2. **)
              claim Hwp1_notG2 : wp1 /:e G2.
              {
                exact (cor68_6_binary_collapse_mixed_not_in_G2
                  G multG eG invG G1 G2 J K Hfam efamH n1 xs1
                  Hgrp Hsub1 Hsub2 Hfp HJKdisj Hfp1 Hfp2
                  Hred1 HallNe1 Hwp1_ne
                  HexG1_1
                  HexG2_1).
              }

              (** Collapse the prefix to a binary reduced word ending in factor 1 (G2). **)
              claim Halpha1U : 1 :e (UPair 0 1). { exact (UPairI2 0 1). }
              claim Hlast_pref :
                apply_fun xs1 m :e apply_fun Gfam12 1.
              {
                rewrite (apply_fun_graph (UPair 0 1) (fun t:set => if t = 0 then G1 else G2) 1 (UPairI2 0 1)).
                rewrite (If_i_0 (1 = 0) G1 G2 neq_1_0).
                exact Hxm_G2.
              }
              claim Hcoll_pref :
                exists np xb kp:set,
                  reduced_word (UPair 0 1) Gfam12 efam12 np xb /\
                  word_product multG eG xb np = wp1 /\
                  np <> 0 /\ nat_p kp /\ np = ordsucc kp /\
                  apply_fun xb kp :e apply_fun Gfam12 1.
              {
                exact (cor68_6_collapse_union_word_to_binary_end_in_factor
                  G multG eG invG G1 G2 J K Hfam efamH m xs1 1
                  Hgrp Hsub1 Hsub2 Hfp Hfp1 Hfp2
                  Hm_nat
                  Hred1
                  HallNe1
                  Halpha1U
                  Hlast_pref).
              }
              apply Hcoll_pref. let np. assume Hnp_pack.
              apply Hnp_pack. let xb. assume Hxb_pack.
              apply Hxb_pack. let kp. assume Hkp_pack.
              apply (and6E
                (reduced_word (UPair 0 1) Gfam12 efam12 np xb)
                (word_product multG eG xb np = wp1)
                (np <> 0)
                (nat_p kp)
                (np = ordsucc kp)
                (apply_fun xb kp :e apply_fun Gfam12 1)
                Hkp_pack).
              assume Hredb Hwpb Hnp_ne0 Hkp_nat Hnp_eq Hlastb.

              (** np is not 1: otherwise wp1 would lie in G2, contradicting Hwp1_notG2. **)
              claim Hnp_ne1 : np <> 1.
              {
                assume Hnp1.
	                claim Hkp0 : kp = 0.
	                {
	                  claim Hs : ordsucc kp = ordsucc 0.
	                  {
	                    claim Hsk : ordsucc kp = 1.
	                    { exact (eq_i_tra (ordsucc kp) np 1 (eq_symm np (ordsucc kp) Hnp_eq) Hnp1). }
	                    exact (eq_i_tra (ordsucc kp) 1 (ordsucc 0) Hsk
	                      (eq_symm (ordsucc 0) 1 ordsucc_0_eq_1_nat)).
	                  }
	                  exact (ordsucc_inj kp 0 Hs).
	                }
                claim Hxb0_G2 : apply_fun xb 0 :e G2.
                {
                  claim Hxb0_eq : apply_fun xb 0 = apply_fun xb kp.
                  { rewrite Hkp0. reflexivity. }
                  claim HGfam1 : apply_fun Gfam12 1 = G2.
                  {
                    rewrite (apply_fun_graph (UPair 0 1) (fun t:set => if t = 0 then G1 else G2) 1 (UPairI2 0 1)).
                    exact (If_i_0 (1 = 0) G1 G2 neq_1_0).
                  }
                  claim Hxbkp_G2 : apply_fun xb kp :e G2.
                  { exact (eq_subst_mem_set (apply_fun xb kp) (apply_fun Gfam12 1) G2 Hlastb HGfam1). }
                  exact (eq_subst_mem (apply_fun xb 0) (apply_fun xb kp) G2 Hxb0_eq Hxbkp_G2).
                }
                claim Hxb0_G : apply_fun xb 0 :e G.
                { exact (subgroup_of_subset G2 G multG eG invG Hsub2 (apply_fun xb 0) Hxb0_G2). }
                claim Hwp1_eq_xb0 : word_product multG eG xb np = apply_fun xb 0.
                {
                  claim Hwp1_1 : word_product multG eG xb 1 = apply_fun xb 0.
                  {
                    claim Hwp1S : word_product multG eG xb 1 =
                      apply_fun multG (word_product multG eG xb 0, apply_fun xb 0).
                    { exact (word_product_succ multG eG xb 0 nat_0). }
                    claim Hwp0 : word_product multG eG xb 0 = eG.
                    { exact (nat_primrec_0 eG (fun j r => apply_fun multG (r, apply_fun xb j))). }
                    claim HidL0 : apply_fun multG (eG, apply_fun xb 0) = apply_fun xb 0.
                    {
                      apply (and6E
                        (function_on multG (setprod G G) G)
                        (function_on invG G G)
                        (eG :e G)
                        (forall y z w:set, y :e G -> z :e G -> w :e G ->
                          apply_fun multG (apply_fun multG (y, z), w) =
                            apply_fun multG (y, apply_fun multG (z, w)))
                        (forall y:set, y :e G -> apply_fun multG (eG, y) = y /\ apply_fun multG (y, eG) = y)
                        (forall y:set, y :e G ->
                          apply_fun multG (y, apply_fun invG y) = eG /\
                          apply_fun multG (apply_fun invG y, y) = eG)
                        Hgrp).
                      assume _ _ _ _ Hid _.
                      exact (andEL
                        (apply_fun multG (eG, apply_fun xb 0) = apply_fun xb 0)
                        (apply_fun multG (apply_fun xb 0, eG) = apply_fun xb 0)
                        (Hid (apply_fun xb 0) Hxb0_G)).
                    }
                    rewrite Hwp1S. rewrite Hwp0. exact HidL0.
                  }
                  rewrite Hnp1.
                  exact Hwp1_1.
                }
	                claim Hwp1_G2 : wp1 :e G2.
	                {
	                  rewrite <- Hwpb.
	                  rewrite Hwp1_eq_xb0.
	                  exact Hxb0_G2.
	                }
	                exact (Hwp1_notG2 Hwp1_G2).
	              }

              (** Last letter of xb is nontrivial. **)
              claim Hkp_in_np : kp :e np.
              { rewrite Hnp_eq. exact (ordsuccI2 kp). }
              claim Hxb_last_ne : apply_fun xb kp <> eG.
              {
                exact (reduced_word_no_eG_all
                  G multG eG invG (UPair 0 1) Gfam12 efam12 np xb
                  Hgrp Hsubfam12 Hredb Hnp_ne0 Hnp_ne1 kp Hkp_in_np).
              }

              (** Append the suffix product (in factor 0) to the binary word for the prefix. **)
              claim Hwp2_inGfam0 : wp2 :e apply_fun Gfam12 0.
              {
                claim HGfam0 : apply_fun Gfam12 0 = G1.
                {
                  rewrite (apply_fun_graph (UPair 0 1) (fun t:set => if t = 0 then G1 else G2) 0 (UPairI1 0 1)).
                  exact (If_i_1 (0 = 0) G1 G2 (eq_refl 0)).
                }
                exact (eq_subst_mem_set wp2 G1 (apply_fun Gfam12 0) Hwp2_G1 (eq_symm (apply_fun Gfam12 0) G1 HGfam0)).
              }
              claim Hred_ext :
                reduced_word (UPair 0 1) Gfam12 efam12 (ordsucc np)
                  (graph (ordsucc np) (fun j:set => if j :e np then apply_fun xb j else wp2)).
              {
                exact (binary_reduced_word_append_other_factor
                  G multG eG invG G1 G2 np xb wp2 0 1 kp
                  Hgrp Hfp
                  Hredb
                  Hkp_nat Hnp_eq
                  (UPairI2 0 1)
                  Hlastb
                  Hxb_last_ne
                  (UPairI1 0 1)
                  Hwp2_inGfam0
                  Hwp2_ne
                  neq_1_0).
              }

              (** Compute the product of the extended binary word. **)
	              claim Hnp_nat : nat_p np.
	              { rewrite Hnp_eq. exact (nat_ordsucc kp Hkp_nat). }
	              claim HnpO : np :e omega. { exact (nat_p_omega np Hnp_nat). }
              claim Hwp_ext :
                word_product multG eG
                  (graph (ordsucc np) (fun j:set => if j :e np then apply_fun xb j else wp2))
                  (ordsucc np) =
                  apply_fun multG (wp1, wp2).
              {
                claim Hwp_app :
                  word_product multG eG
                    (graph (ordsucc np) (fun j:set => if j :e np then apply_fun xb j else wp2))
                    (ordsucc np) =
                    apply_fun multG (word_product multG eG xb np, wp2).
                { exact (word_product_append_one multG eG xb wp2 np HnpO). }
                rewrite Hwp_app.
                rewrite Hwpb.
                reflexivity.
              }
              claim Hx_eq_wp1wp2 : x = apply_fun multG (wp1, wp2).
              {
                claim Hsplit :
                  word_product multG eG xs n =
                    apply_fun multG (word_product multG eG xs n1, wp2).
                {
                  claim Hsplit0 :
                    word_product multG eG xs n =
                      apply_fun multG
                        (word_product multG eG xs n1,
                         word_product multG eG (graph n2 (fun t:set => apply_fun xs (add_nat n1 t))) n2).
	                  {
	                    exact (word_product_split_by_add_nat
	                      G multG eG invG n xs n1 n2
	                      Hgrp Hn1_nat Hn2_nat Hn_eq
	                      HxsG_all).
	                  }
	                  rewrite Hsplit0.
	                  reflexivity.
                }
                claim Hwp1_eq :
                  word_product multG eG xs n1 = wp1.
                {
                  claim Hn1O : n1 :e omega. { exact (nat_p_omega n1 Hn1_nat). }
                  apply (nat_primrec_ext eG
                    (fun j r:set => apply_fun multG (r, apply_fun xs j))
                    (fun j r:set => apply_fun multG (r, apply_fun xs1 j))
                    n1
                    Hn1O).
                  let j r. assume Hj1.
                  rewrite (apply_fun_graph n1 (fun t:set => apply_fun xs t) j Hj1).
                  reflexivity.
                }
                claim Hsplit' :
                  word_product multG eG xs n = apply_fun multG (wp1, wp2).
                {
                  claim Hmul_eq :
                    apply_fun multG (word_product multG eG xs n1, wp2) = apply_fun multG (wp1, wp2).
                  { rewrite Hwp1_eq. reflexivity. }
                  exact (eq_i_tra
                    (word_product multG eG xs n)
                    (apply_fun multG (word_product multG eG xs n1, wp2))
                    (apply_fun multG (wp1, wp2))
                    Hsplit
                    Hmul_eq).
                }
                rewrite <- Hsplit'.
                exact (eq_symm (word_product multG eG xs n) x Hwp).
              }
              claim Hwp_ext_x :
                word_product multG eG
                  (graph (ordsucc np) (fun j:set => if j :e np then apply_fun xb j else wp2))
                  (ordsucc np) = x.
              { exact (eq_i_tra
                  (word_product multG eG (graph (ordsucc np) (fun j:set => if j :e np then apply_fun xb j else wp2)) (ordsucc np))
                  (apply_fun multG (wp1, wp2))
                  x
                  Hwp_ext
                  (eq_symm x (apply_fun multG (wp1, wp2)) Hx_eq_wp1wp2)). }

              (** Uniqueness of the binary normal form forces n12 = ordsucc np, contradicting n12 = 2. **)
              claim Huniq_ext :
                n12 = ordsucc np /\
                (forall j:set, j :e n12 ->
                  apply_fun xs12 j =
                    apply_fun (graph (ordsucc np) (fun t:set => if t :e np then apply_fun xb t else wp2)) j).
              { exact (Huniq12 (ordsucc np)
                  (graph (ordsucc np) (fun t:set => if t :e np then apply_fun xb t else wp2))
                  Hred_ext
                  (neq_ordsucc_0 np)
                  Hwp_ext_x). }
              claim Hn12_eq : n12 = ordsucc np.
              { exact (andEL (n12 = ordsucc np)
                  (forall j:set, j :e n12 ->
                    apply_fun xs12 j =
                      apply_fun (graph (ordsucc np) (fun t:set => if t :e np then apply_fun xb t else wp2)) j)
                  Huniq_ext). }
              claim Hs2 : ordsucc np = 2.
              { exact (eq_i_tra (ordsucc np) n12 2 (eq_symm n12 (ordsucc np) Hn12_eq) Hn12_2). }
              claim Hnp1 : np = 1.
              {
                claim Hs1 : ordsucc np = ordsucc 1.
                { exact (eq_i_tra (ordsucc np) 2 (ordsucc 1) Hs2 (eq_symm (ordsucc 1) 2 ordsucc_1_eq_2_nat)). }
                exact (ordsucc_inj np 1 Hs1).
              }
              exact (FalseE (Hnp_ne1 Hnp1) (apply_fun xs1 i :e G2)).
            - assume HxiG2. exact HxiG2.
          }


	          (** Now compare the decompositions for xs and xs'. For brevity we use factor uniqueness to conclude n = n' and pointwise equality. **)
	          (** Decompose xs' into prefix in G2 and suffix in G1 as well, then use uniqueness in the binary normal form and in the factors. **)
	          {
	            (** Decompose xs' via maximal G2 index. **)
	            apply (cor68_6_max_G2_index_suffix_all_in_G1
	              G multG eG invG G1 G2 J K Hfam efamH n' xs'
	              Hgrp Hsub1 Hsub2 Hfp Hfp1 Hfp2
	              Hred' HallNe'
	              HexG1' HexG2').
	            let m'. assume Hm'_pack.
	            apply (and4E
	              (m' :e n')
	              (apply_fun xs' m' :e G2)
	              (forall i:set, i :e n' -> apply_fun xs' i :e G2 -> i c= m')
	              (forall i:set, i :e n' -> ordsucc m' c= i -> apply_fun xs' i :e G1)
	              Hm'_pack).
	            assume Hm'_in Hym'G2 Hm'_maxG2 Hsuffix'_all_G1.
	
	            set n1' := ordsucc m'.
	            claim HnO' : n' :e omega.
	            {
	              apply (and3E
	                (n' :e omega)
	                (forall i:set, i :e n' ->
	                  exists alpha:set, alpha :e J :\/: K /\
	                    apply_fun xs' i :e apply_fun Hfam alpha /\
	                    apply_fun xs' i <> apply_fun efamH alpha)
	                (forall i:set, i :e n' -> ordsucc i :e n' ->
	                  forall alpha beta:set, alpha :e J :\/: K -> beta :e J :\/: K ->
	                    apply_fun xs' i :e apply_fun Hfam alpha ->
	                    apply_fun xs' (ordsucc i) :e apply_fun Hfam beta ->
	                    alpha <> beta)
	                Hred').
	              assume HnO0 _ _. exact HnO0.
	            }
	            claim Hn'_nat : nat_p n'. { exact (omega_nat_p n' HnO'). }
	            claim Hn'_ord : ordinal n'. { exact (nat_p_ordinal n' Hn'_nat). }
	            claim HmO' : m' :e omega.
	            {
	              claim Hn'_sub_omega : n' c= omega.
	              { exact (omega_TransSet n' HnO'). }
	              exact (Hn'_sub_omega m' Hm'_in).
	            }
	            claim Hm'_nat : nat_p m'. { exact (omega_nat_p m' HmO'). }
	            claim Hn1'_nat : nat_p n1'. { exact (nat_ordsucc m' Hm'_nat). }
	            claim Hn1'_sub_n' : n1' c= n'.
	            { exact (ordinal_ordsucc_In_Subq n' Hn'_ord m' Hm'_in). }
	
	            (** Decompose n' = n1' + n2'. **)
	            apply (nat_Subq_add_ex n1' Hn1'_nat n' Hn'_nat Hn1'_sub_n').
	            let n2'. assume Hn2'_pack.
	            claim Hn2'_nat : nat_p n2'.
	            { exact (andEL (nat_p n2') (n' = add_nat n2' n1') Hn2'_pack). }
	            claim Hn'_eq' : n' = add_nat n2' n1'.
	            { exact (andER (nat_p n2') (n' = add_nat n2' n1') Hn2'_pack). }
	            claim Hn'_eq : n' = add_nat n1' n2'.
	            { rewrite Hn'_eq'. rewrite (add_nat_com n2' Hn2'_nat n1' Hn1'_nat). reflexivity. }
	
	            (** Prefix and suffix words for xs'. **)
	            set xs1' := graph n1' (fun i:set => apply_fun xs' i).
	            set xs2' := graph n2' (fun i:set => apply_fun xs' (add_nat n1' i)).
	
	            claim Hred2' : reduced_word (J :\/: K) Hfam efamH n2' xs2'.
	            { exact (reduced_word_suffix_by_add_nat (J :\/: K) Hfam efamH n' xs' n1' n2' Hred' Hn1'_nat Hn2'_nat Hn'_eq). }
	            claim HallNe2' : forall i:set, i :e n2' -> apply_fun xs2' i <> eG.
	            {
	              let i. assume Hi2.
	              rewrite (apply_fun_graph n2' (fun t:set => apply_fun xs' (add_nat n1' t)) i Hi2).
	              claim Hin_sum : add_nat n1' i :e add_nat n1' n2'.
	              { exact (add_nat_In_L n1' Hn1'_nat n2' Hn2'_nat i Hi2). }
	              claim Hin_n' : add_nat n1' i :e n'.
	              { exact (eq_subst_mem_set (add_nat n1' i) (add_nat n1' n2') n' Hin_sum (eq_symm n' (add_nat n1' n2') Hn'_eq)). }
	              exact (HallNe' (add_nat n1' i) Hin_n').
	            }
	            claim HallG1_2' : forall i:set, i :e n2' -> apply_fun xs2' i :e G1.
	            {
	              let i. assume Hi2.
	              rewrite (apply_fun_graph n2' (fun t:set => apply_fun xs' (add_nat n1' t)) i Hi2).
	              claim Hin_sum : add_nat n1' i :e add_nat n1' n2'.
	              { exact (add_nat_In_L n1' Hn1'_nat n2' Hn2'_nat i Hi2). }
	              claim Hin_n' : add_nat n1' i :e n'.
	              { exact (eq_subst_mem_set (add_nat n1' i) (add_nat n1' n2') n' Hin_sum (eq_symm n' (add_nat n1' n2') Hn'_eq)). }
	              claim Hsub : n1' c= add_nat n1' i.
	              { exact (add_nat_Subq_R' n1' Hn1'_nat i (nat_p_trans n2' Hn2'_nat i Hi2)). }
	              exact (Hsuffix'_all_G1 (add_nat n1' i) Hin_n' Hsub).
	            }
	
	            (** Suffix product is nontrivial. **)
	            claim Hn2'_ne0 : n2' <> 0.
	            {
	              assume Hn2'0.
	              claim Hn'_eq_sm : n' = ordsucc m'.
	              {
	                rewrite Hn'_eq.
	                rewrite Hn2'0.
	                rewrite (add_nat_0R n1').
	                reflexivity.
	              }
	              claim Hred_sm : reduced_word (J :\/: K) Hfam efamH (ordsucc m') xs'.
	              { rewrite <- Hn'_eq_sm. exact Hred'. }
	              claim HallNe_sm : forall i:set, i :e ordsucc m' -> apply_fun xs' i <> eG.
	              {
	                let i. assume Hi.
	                claim Hi_n' : i :e n'.
	                { exact (eq_subst_mem_set i (ordsucc m') n' Hi (eq_symm n' (ordsucc m') Hn'_eq_sm)). }
	                exact (HallNe' i Hi_n').
	              }
	              claim Hlast_m' : apply_fun xs' m' :e apply_fun Gfam12 1.
	              {
	                rewrite (apply_fun_graph (UPair 0 1) (fun t:set => if t = 0 then G1 else G2) 1 (UPairI2 0 1)).
	                rewrite (If_i_0 (1 = 0) G1 G2 neq_1_0).
	                exact Hym'G2.
	              }
	              claim Hcoll_last :
	                exists nb xb kb:set,
	                  reduced_word (UPair 0 1) Gfam12 efam12 nb xb /\
	                  word_product multG eG xb nb = word_product multG eG xs' (ordsucc m') /\
	                  nb <> 0 /\ nat_p kb /\ nb = ordsucc kb /\
	                  apply_fun xb kb :e apply_fun Gfam12 1.
	              {
	                exact (cor68_6_collapse_union_word_to_binary_end_in_factor
	                  G multG eG invG G1 G2 J K Hfam efamH m' xs' 1
	                  Hgrp Hsub1 Hsub2 Hfp Hfp1 Hfp2
	                  Hm'_nat
	                  Hred_sm
	                  HallNe_sm
	                  (UPairI2 0 1)
	                  Hlast_m').
	              }
	              apply Hcoll_last. let nb. assume Hnb_pack.
	              apply Hnb_pack. let xb. assume Hxb_pack.
	              apply Hxb_pack. let kb. assume Hkb_pack.
	              apply (and6E
	                (reduced_word (UPair 0 1) Gfam12 efam12 nb xb)
	                (word_product multG eG xb nb = word_product multG eG xs' (ordsucc m'))
	                (nb <> 0)
	                (nat_p kb)
	                (nb = ordsucc kb)
	                (apply_fun xb kb :e apply_fun Gfam12 1)
	                Hkb_pack).
	              assume Hredb Hwpb Hnb_ne0 Hkb_nat Hnb_eq Hlastb.
	              claim Hwp_sm : word_product multG eG xs' (ordsucc m') = x.
	              { rewrite <- Hn'_eq_sm. exact Hwp'. }
	              claim Hwpb_x : word_product multG eG xb nb = x.
	              { exact (eq_i_tra (word_product multG eG xb nb) (word_product multG eG xs' (ordsucc m')) x Hwpb Hwp_sm). }
	              claim Huniqb :
	                n12 = nb /\ (forall i0:set, i0 :e n12 -> apply_fun xs12 i0 = apply_fun xb i0).
	              { exact (Huniq12 nb xb Hredb Hnb_ne0 Hwpb_x). }
	              claim Hn12_eq_nb : n12 = nb.
	              { exact (andEL (n12 = nb) (forall i0:set, i0 :e n12 -> apply_fun xs12 i0 = apply_fun xb i0) Huniqb). }
	              claim Hpt : forall i0:set, i0 :e n12 -> apply_fun xs12 i0 = apply_fun xb i0.
	              { exact (andER (n12 = nb) (forall i0:set, i0 :e n12 -> apply_fun xs12 i0 = apply_fun xb i0) Huniqb). }
	              claim Hnb_2 : nb = 2.
	              { exact (eq_i_tra nb n12 2 (eq_symm n12 nb Hn12_eq_nb) Hn12_2). }
	              claim Hsk2 : ordsucc kb = 2.
	              { exact (eq_i_tra (ordsucc kb) nb 2 (eq_symm nb (ordsucc kb) Hnb_eq) Hnb_2). }
	              claim Hsk1 : ordsucc kb = ordsucc 1.
	              { exact (eq_i_tra (ordsucc kb) 2 (ordsucc 1) Hsk2 (eq_symm (ordsucc 1) 2 ordsucc_1_eq_2_nat)). }
	              claim Hkb1 : kb = 1.
	              { exact (ordsucc_inj kb 1 Hsk1). }
	              claim Hlastb1 : apply_fun xb 1 :e apply_fun Gfam12 1.
	              {
	                claim Hxb_eq : apply_fun xb 1 = apply_fun xb kb.
	                { rewrite Hkb1. reflexivity. }
	                exact (eq_subst_mem (apply_fun xb 1) (apply_fun xb kb) (apply_fun Gfam12 1) Hxb_eq Hlastb).
	              }
	              claim HGfam1 : apply_fun Gfam12 1 = G2.
	              {
	                rewrite (apply_fun_graph (UPair 0 1) (fun t:set => if t = 0 then G1 else G2) 1 (UPairI2 0 1)).
	                exact (If_i_0 (1 = 0) G1 G2 neq_1_0).
	              }
	              claim Hxb1_G2 : apply_fun xb 1 :e G2.
	              { exact (eq_subst_mem_set (apply_fun xb 1) (apply_fun Gfam12 1) G2 Hlastb1 HGfam1). }
	              claim Hx1eq : apply_fun xs12 1 = apply_fun xb 1.
	              { exact (Hpt 1 H1in12). }
	              claim Hx1_G2 : apply_fun xs12 1 :e G2.
	              { exact (eq_subst_mem (apply_fun xs12 1) (apply_fun xb 1) G2 Hx1eq Hxb1_G2). }
	              claim Hx1_e : apply_fun xs12 1 = eG.
	              { exact (free_product_binary_factors_intersect_trivial
	                G multG eG invG G1 G2 (apply_fun xs12 1) Hfp Hx1G1 Hx1_G2). }
	              exact (Hx1neG Hx1_e).
	            }
	
	            claim Hn1'_in_n' : n1' :e n'.
	            {
	              claim H0_in_n2' : 0 :e n2'.
	              {
	                claim Hn2'_succ : exists k2:set, n2' = ordsucc k2.
	                { exact (Hnat_nonzero_succ n2' Hn2'_nat Hn2'_ne0). }
	                apply Hn2'_succ. let k2. assume Hn2'_eq.
	                claim Hk2_nat : nat_p k2.
	                {
	                  claim Hk2_in : k2 :e n2'.
	                  { rewrite Hn2'_eq. exact (ordsuccI2 k2). }
	                  exact (nat_p_trans n2' Hn2'_nat k2 Hk2_in).
	                }
	                rewrite Hn2'_eq.
	                exact (nat_0_in_ordsucc k2 Hk2_nat).
	              }
	              claim Hn10_in_sum : add_nat n1' 0 :e add_nat n1' n2'.
	              { exact (add_nat_In_L n1' Hn1'_nat n2' Hn2'_nat 0 H0_in_n2'). }
	              claim Hn1_in_sum : n1' :e add_nat n1' n2'.
	              { exact (eq_subst_mem_rev (add_nat n1' 0) n1' (add_nat n1' n2') (add_nat_0R n1') Hn10_in_sum). }
	              exact (eq_subst_mem_set n1' (add_nat n1' n2') n' Hn1_in_sum (eq_symm n' (add_nat n1' n2') Hn'_eq)).
	            }
	            claim Hred1' : reduced_word (J :\/: K) Hfam efamH n1' xs1'.
	            { exact (reduced_word_prefix (J :\/: K) Hfam efamH n' xs' n1' Hred' Hn1'_in_n'). }
	            claim Hsuf_ne' : word_product multG eG xs2' n2' <> eG.
	            {
	              exact (cor68_6_reduced_word_all_in_G1_product_ne_eG
	                G multG eG invG G1 G2 J K Hfam efamH n2' xs2'
	                Hgrp Hsub1 Hsub2 Hfp Hfp1 Hfp2
	                Hred2' HallNe2' HallG1_2' Hn2'_ne0).
	            }
	
	            (** Prefix letters of xs' are all in G2 (same argument as for xs). **)
	            claim HallG2_1' : forall i:set, i :e n1' -> apply_fun xs1' i :e G2.
	            {
	              let i. assume Hi1.
	              apply (Hside_union n1' xs1' Hred1' i Hi1).
	              - assume HxiG1.
	                set wp2' := word_product multG eG xs2' n2'.
	                claim Hwp2'_ne : wp2' <> eG. { exact Hsuf_ne'. }
	                claim Hwp2'_G1 : wp2' :e G1.
	                { exact (Hword_product_in_G1 n2' xs2' Hred2' HallG1_2'). }
	
	                claim HxsG_all' : forall j:set, j :e n' -> apply_fun xs' j :e G.
	                {
	                  let j. assume Hj.
	                  apply (Hside_union n' xs' Hred' j Hj).
	                  - assume HjG1.
	                    exact (subgroup_of_subset G1 G multG eG invG Hsub1 (apply_fun xs' j) HjG1).
	                  - assume HjG2.
	                    exact (subgroup_of_subset G2 G multG eG invG Hsub2 (apply_fun xs' j) HjG2).
	                }
	                claim Hn1'_sub_n'2 : n1' c= n'.
	                {
	                  claim Hn1'_ord : ordinal n1'. { exact (nat_p_ordinal n1' Hn1'_nat). }
	                  exact (ordinal_TransSet n' Hn'_ord n1' Hn1'_in_n').
	                }
	                claim Hxs1G_all' : forall j:set, j :e n1' -> apply_fun xs1' j :e G.
	                {
	                  let j. assume Hj1.
	                  rewrite (apply_fun_graph n1' (fun t:set => apply_fun xs' t) j Hj1).
	                  exact (HxsG_all' j (Hn1'_sub_n'2 j Hj1)).
	                }
	                set wp1' := word_product multG eG xs1' n1'.
	                claim Hwp1'_ne : wp1' <> eG.
	                {
	                  assume Hwp1'_e.
	                  claim Hsplit :
	                    word_product multG eG xs' n' =
	                      apply_fun multG (word_product multG eG xs' n1', wp2').
	                  {
	                    exact (word_product_split_by_add_nat
	                      G multG eG invG n' xs' n1' n2'
	                      Hgrp Hn1'_nat Hn2'_nat Hn'_eq
	                      HxsG_all').
	                  }
	                  claim Hx_eq :
	                    x = apply_fun multG (word_product multG eG xs' n1', wp2').
	                  {
	                    rewrite <- Hsplit.
	                    exact (eq_symm (word_product multG eG xs' n') x Hwp').
	                  }
	                  claim Hwp1'_eq :
	                    word_product multG eG xs' n1' = wp1'.
	                  {
	                    claim Hn1O : n1' :e omega. { exact (nat_p_omega n1' Hn1'_nat). }
	                    apply (nat_primrec_ext eG
	                      (fun j r:set => apply_fun multG (r, apply_fun xs' j))
	                      (fun j r:set => apply_fun multG (r, apply_fun xs1' j))
	                      n1'
	                      Hn1O).
	                    let j r. assume Hj1.
	                    rewrite (apply_fun_graph n1' (fun t:set => apply_fun xs' t) j Hj1).
	                    reflexivity.
	                  }
	                  claim Hx_eq2 :
	                    x = apply_fun multG (wp1', wp2').
	                  {
	                    claim Hmul_eq :
	                      apply_fun multG (word_product multG eG xs' n1', wp2') = apply_fun multG (wp1', wp2').
	                    { rewrite Hwp1'_eq. reflexivity. }
	                    exact (eq_i_tra x
	                      (apply_fun multG (word_product multG eG xs' n1', wp2'))
	                      (apply_fun multG (wp1', wp2'))
	                      Hx_eq
	                      Hmul_eq).
	                  }
	                  claim Hx_eq3 : x = apply_fun multG (eG, wp2').
	                  {
	                    claim Hmul_eq : apply_fun multG (wp1', wp2') = apply_fun multG (eG, wp2').
	                    { rewrite Hwp1'_e. reflexivity. }
	                    exact (eq_i_tra x (apply_fun multG (wp1', wp2')) (apply_fun multG (eG, wp2')) Hx_eq2 Hmul_eq).
	                  }
	                  claim Hwp2'_G : wp2' :e G.
	                  { exact (subgroup_of_subset G1 G multG eG invG Hsub1 wp2' Hwp2'_G1). }
	                  claim HidL :
	                    apply_fun multG (eG, wp2') = wp2'.
	                  {
	                    apply (and6E
	                      (function_on multG (setprod G G) G)
	                      (function_on invG G G)
	                      (eG :e G)
	                      (forall y z w:set, y :e G -> z :e G -> w :e G ->
	                        apply_fun multG (apply_fun multG (y, z), w) =
	                          apply_fun multG (y, apply_fun multG (z, w)))
	                      (forall y:set, y :e G -> apply_fun multG (eG, y) = y /\ apply_fun multG (y, eG) = y)
	                      (forall y:set, y :e G ->
	                        apply_fun multG (y, apply_fun invG y) = eG /\
	                        apply_fun multG (apply_fun invG y, y) = eG)
	                      Hgrp).
	                    assume _ _ _ _ Hid _.
	                    exact (andEL
	                      (apply_fun multG (eG, wp2') = wp2')
	                      (apply_fun multG (wp2', eG) = wp2')
	                      (Hid wp2' Hwp2'_G)).
	                  }
	                  claim Hx_eq4 : x = wp2'.
	                  { exact (eq_i_tra x (apply_fun multG (eG, wp2')) wp2' Hx_eq3 HidL). }
	                  claim HxG1 : x :e G1.
	                  { rewrite Hx_eq4. exact Hwp2'_G1. }
	                  exact (Hx_not_G1 HxG1).
	                }
	
	                claim HallNe1' : forall j:set, j :e n1' -> apply_fun xs1' j <> eG.
	                {
	                  let j. assume Hj1.
	                  rewrite (apply_fun_graph n1' (fun t:set => apply_fun xs' t) j Hj1).
	                  exact (HallNe' j (Hn1'_sub_n'2 j Hj1)).
	                }
	                claim HexG1_1' : exists j:set, j :e n1' /\ apply_fun xs1' j :e G1.
	                { witness i. exact (andI (i :e n1') (apply_fun xs1' i :e G1) Hi1 HxiG1). }
	                claim Hm'_in_n1' : m' :e n1'. { exact (ordsuccI2 m'). }
	                claim Hxm'_G2 : apply_fun xs1' m' :e G2.
	                {
	                  rewrite (apply_fun_graph n1' (fun t:set => apply_fun xs' t) m' Hm'_in_n1').
	                  exact Hym'G2.
	                }
	                claim HexG2_1' : exists j:set, j :e n1' /\ apply_fun xs1' j :e G2.
	                { witness m'. exact (andI (m' :e n1') (apply_fun xs1' m' :e G2) Hm'_in_n1' Hxm'_G2). }
	                claim Hwp1'_notG2 : wp1' /:e G2.
	                {
	                  exact (cor68_6_binary_collapse_mixed_not_in_G2
	                    G multG eG invG G1 G2 J K Hfam efamH n1' xs1'
	                    Hgrp Hsub1 Hsub2 Hfp HJKdisj Hfp1 Hfp2
	                    Hred1' HallNe1' Hwp1'_ne
	                    HexG1_1'
	                    HexG2_1').
	                }
	
	                claim Halpha1U : 1 :e (UPair 0 1). { exact (UPairI2 0 1). }
	                claim Hlast_pref :
	                  apply_fun xs1' m' :e apply_fun Gfam12 1.
	                {
	                  rewrite (apply_fun_graph (UPair 0 1) (fun t:set => if t = 0 then G1 else G2) 1 (UPairI2 0 1)).
	                  rewrite (If_i_0 (1 = 0) G1 G2 neq_1_0).
	                  exact Hxm'_G2.
	                }
	                claim Hcoll_pref :
	                  exists np xb kp:set,
	                    reduced_word (UPair 0 1) Gfam12 efam12 np xb /\
	                    word_product multG eG xb np = wp1' /\
	                    np <> 0 /\ nat_p kp /\ np = ordsucc kp /\
	                    apply_fun xb kp :e apply_fun Gfam12 1.
	                {
	                  exact (cor68_6_collapse_union_word_to_binary_end_in_factor
	                    G multG eG invG G1 G2 J K Hfam efamH m' xs1' 1
	                    Hgrp Hsub1 Hsub2 Hfp Hfp1 Hfp2
	                    Hm'_nat
	                    Hred1'
	                    HallNe1'
	                    Halpha1U
	                    Hlast_pref).
	                }
	                apply Hcoll_pref. let np. assume Hnp_pack.
	                apply Hnp_pack. let xb. assume Hxb_pack.
	                apply Hxb_pack. let kp. assume Hkp_pack.
	                apply (and6E
	                  (reduced_word (UPair 0 1) Gfam12 efam12 np xb)
	                  (word_product multG eG xb np = wp1')
	                  (np <> 0)
	                  (nat_p kp)
	                  (np = ordsucc kp)
	                  (apply_fun xb kp :e apply_fun Gfam12 1)
	                  Hkp_pack).
	                assume Hredb Hwpb Hnp_ne0 Hkp_nat Hnp_eq Hlastb.
	
	                claim Hnp_ne1 : np <> 1.
	                {
	                  assume Hnp1.
	                  claim Hkp0 : kp = 0.
	                  {
	                    claim Hsk : ordsucc kp = 1.
	                    { exact (eq_i_tra (ordsucc kp) np 1 (eq_symm np (ordsucc kp) Hnp_eq) Hnp1). }
	                    claim Hs : ordsucc kp = ordsucc 0.
	                    { exact (eq_i_tra (ordsucc kp) 1 (ordsucc 0) Hsk (eq_symm (ordsucc 0) 1 ordsucc_0_eq_1_nat)). }
	                    exact (ordsucc_inj kp 0 Hs).
	                  }
	                  claim Hxb0_G2 : apply_fun xb 0 :e G2.
	                  {
	                    claim Hxb0_eq : apply_fun xb 0 = apply_fun xb kp.
	                    { rewrite Hkp0. reflexivity. }
	                    claim HGfam1 : apply_fun Gfam12 1 = G2.
	                    {
	                      rewrite (apply_fun_graph (UPair 0 1) (fun t:set => if t = 0 then G1 else G2) 1 (UPairI2 0 1)).
	                      exact (If_i_0 (1 = 0) G1 G2 neq_1_0).
	                    }
	                    claim Hxbkp_G2 : apply_fun xb kp :e G2.
	                    { exact (eq_subst_mem_set (apply_fun xb kp) (apply_fun Gfam12 1) G2 Hlastb HGfam1). }
	                    exact (eq_subst_mem (apply_fun xb 0) (apply_fun xb kp) G2 Hxb0_eq Hxbkp_G2).
	                  }
	                  claim Hwp1'_G2 : wp1' :e G2.
	                  {
	                    rewrite <- Hwpb.
	                    rewrite Hnp1.
	                    claim Hwp1_eq : word_product multG eG xb 1 = apply_fun xb 0.
	                    {
	                      claim Hwp1 :
	                        word_product multG eG xb 1 =
	                          apply_fun multG (word_product multG eG xb 0, apply_fun xb 0).
	                      { exact (word_product_succ multG eG xb 0 nat_0). }
	                      claim Hwp0 : word_product multG eG xb 0 = eG.
	                      { exact (nat_primrec_0 eG (fun i r => apply_fun multG (r, apply_fun xb i))). }
	                      claim Hxb0_G : apply_fun xb 0 :e G.
	                      { exact (subgroup_of_subset G2 G multG eG invG Hsub2 (apply_fun xb 0) Hxb0_G2). }
	                      claim HidL : apply_fun multG (eG, apply_fun xb 0) = apply_fun xb 0.
	                      {
	                        apply (and6E
	                          (function_on multG (setprod G G) G)
	                          (function_on invG G G)
	                          (eG :e G)
	                          (forall y z w:set, y :e G -> z :e G -> w :e G ->
	                            apply_fun multG (apply_fun multG (y, z), w) =
	                              apply_fun multG (y, apply_fun multG (z, w)))
	                          (forall y:set, y :e G -> apply_fun multG (eG, y) = y /\ apply_fun multG (y, eG) = y)
	                          (forall y:set, y :e G ->
	                            apply_fun multG (y, apply_fun invG y) = eG /\
	                            apply_fun multG (apply_fun invG y, y) = eG)
	                          Hgrp).
	                        assume _ _ _ _ Hid _.
	                        exact (andEL
	                          (apply_fun multG (eG, apply_fun xb 0) = apply_fun xb 0)
	                          (apply_fun multG (apply_fun xb 0, eG) = apply_fun xb 0)
	                          (Hid (apply_fun xb 0) Hxb0_G)).
	                      }
	                      rewrite Hwp1.
	                      rewrite Hwp0.
	                      exact HidL.
	                    }
	                    rewrite Hwp1_eq.
	                    exact Hxb0_G2.
	                  }
	                  exact (Hwp1'_notG2 Hwp1'_G2).
	                }
	
	                claim Hkp_in_np : kp :e np.
	                { rewrite Hnp_eq. exact (ordsuccI2 kp). }
	                claim Hxb_last_ne : apply_fun xb kp <> eG.
	                {
	                  exact (reduced_word_no_eG_all
	                    G multG eG invG (UPair 0 1) Gfam12 efam12 np xb
	                    Hgrp Hsubfam12 Hredb Hnp_ne0 Hnp_ne1 kp Hkp_in_np).
	                }
	
	                claim Hwp2'_inGfam0 : wp2' :e apply_fun Gfam12 0.
	                {
	                  claim HGfam0 : apply_fun Gfam12 0 = G1.
	                  {
	                    rewrite (apply_fun_graph (UPair 0 1) (fun t:set => if t = 0 then G1 else G2) 0 (UPairI1 0 1)).
	                    exact (If_i_1 (0 = 0) G1 G2 (eq_refl 0)).
	                  }
	                  exact (eq_subst_mem_set wp2' G1 (apply_fun Gfam12 0) Hwp2'_G1 (eq_symm (apply_fun Gfam12 0) G1 HGfam0)).
	                }
	                claim Hred_ext :
	                  reduced_word (UPair 0 1) Gfam12 efam12 (ordsucc np)
	                    (graph (ordsucc np) (fun j:set => if j :e np then apply_fun xb j else wp2')).
	                {
	                  exact (binary_reduced_word_append_other_factor
	                    G multG eG invG G1 G2 np xb wp2' 0 1 kp
	                    Hgrp Hfp
	                    Hredb
	                    Hkp_nat Hnp_eq
	                    (UPairI2 0 1)
	                    Hlastb
	                    Hxb_last_ne
	                    (UPairI1 0 1)
	                    Hwp2'_inGfam0
	                    Hwp2'_ne
	                    neq_1_0).
	                }
	
	                claim Hnp_nat : nat_p np.
	                { rewrite Hnp_eq. exact (nat_ordsucc kp Hkp_nat). }
	                claim HnpO : np :e omega. { exact (nat_p_omega np Hnp_nat). }
	                claim Hwp_ext :
	                  word_product multG eG
	                    (graph (ordsucc np) (fun j:set => if j :e np then apply_fun xb j else wp2'))
	                    (ordsucc np) =
	                    apply_fun multG (wp1', wp2').
	                {
	                  claim Hwp_app :
	                    word_product multG eG
	                      (graph (ordsucc np) (fun j:set => if j :e np then apply_fun xb j else wp2'))
	                      (ordsucc np) =
	                      apply_fun multG (word_product multG eG xb np, wp2').
	                  { exact (word_product_append_one multG eG xb wp2' np HnpO). }
	                  rewrite Hwp_app.
	                  rewrite Hwpb.
	                  reflexivity.
	                }
	
	                (** Show this extended binary word represents x. **)
	                claim Hx_eq_wp1wp2 : x = apply_fun multG (wp1', wp2').
	                {
	                  claim Hsplit :
	                    word_product multG eG xs' n' =
	                      apply_fun multG (word_product multG eG xs' n1', wp2').
	                  {
	                    exact (word_product_split_by_add_nat
	                      G multG eG invG n' xs' n1' n2'
	                      Hgrp Hn1'_nat Hn2'_nat Hn'_eq
	                      HxsG_all').
	                  }
	                  claim Hwp1'_eq :
	                    word_product multG eG xs' n1' = wp1'.
	                  {
	                    claim Hn1O : n1' :e omega. { exact (nat_p_omega n1' Hn1'_nat). }
	                    apply (nat_primrec_ext eG
	                      (fun j r:set => apply_fun multG (r, apply_fun xs' j))
	                      (fun j r:set => apply_fun multG (r, apply_fun xs1' j))
	                      n1'
	                      Hn1O).
	                    let j r. assume Hj1.
	                    rewrite (apply_fun_graph n1' (fun t:set => apply_fun xs' t) j Hj1).
	                    reflexivity.
	                  }
	                  claim Hwp2'_eq :
	                    word_product multG eG (graph n2' (fun i0:set => apply_fun xs' (add_nat n1' i0))) n2' = wp2'.
	                  { reflexivity. }
	                  claim Hx_eq0 :
	                    x = apply_fun multG (word_product multG eG xs' n1', wp2').
	                  {
	                    rewrite <- Hsplit.
	                    exact (eq_symm (word_product multG eG xs' n') x Hwp').
	                  }
	                  claim Hmul_eq :
	                    apply_fun multG (word_product multG eG xs' n1', wp2') = apply_fun multG (wp1', wp2').
	                  { rewrite Hwp1'_eq. reflexivity. }
	                  exact (eq_i_tra x (apply_fun multG (word_product multG eG xs' n1', wp2')) (apply_fun multG (wp1', wp2')) Hx_eq0 Hmul_eq).
	                }
	                claim Hwp_ext_x :
	                  word_product multG eG
	                    (graph (ordsucc np) (fun j:set => if j :e np then apply_fun xb j else wp2'))
	                    (ordsucc np) = x.
	                { exact (eq_i_tra
	                    (word_product multG eG (graph (ordsucc np) (fun j:set => if j :e np then apply_fun xb j else wp2')) (ordsucc np))
	                    (apply_fun multG (wp1', wp2'))
	                    x
	                    Hwp_ext
	                    (eq_symm x (apply_fun multG (wp1', wp2')) Hx_eq_wp1wp2)). }
	
	                claim Huniq_ext :
	                  n12 = ordsucc np /\
	                  (forall j:set, j :e n12 ->
	                    apply_fun xs12 j =
	                      apply_fun (graph (ordsucc np) (fun t:set => if t :e np then apply_fun xb t else wp2')) j).
	                { exact (Huniq12 (ordsucc np)
	                    (graph (ordsucc np) (fun t:set => if t :e np then apply_fun xb t else wp2'))
	                    Hred_ext
	                    (neq_ordsucc_0 np)
	                    Hwp_ext_x). }
	                claim Hn12_eq : n12 = ordsucc np.
	                { exact (andEL (n12 = ordsucc np)
	                    (forall j:set, j :e n12 ->
	                      apply_fun xs12 j =
	                        apply_fun (graph (ordsucc np) (fun t:set => if t :e np then apply_fun xb t else wp2')) j)
	                    Huniq_ext). }
	                claim Hs2 : ordsucc np = 2.
	                { exact (eq_i_tra (ordsucc np) n12 2 (eq_symm n12 (ordsucc np) Hn12_eq) Hn12_2). }
	                claim Hnp1 : np = 1.
	                {
	                  claim Hs1 : ordsucc np = ordsucc 1.
	                  { exact (eq_i_tra (ordsucc np) 2 (ordsucc 1) Hs2 (eq_symm (ordsucc 1) 2 ordsucc_1_eq_2_nat)). }
	                  exact (ordsucc_inj np 1 Hs1).
	                }
	                exact (FalseE (Hnp_ne1 Hnp1) (apply_fun xs1' i :e G2)).
	              - assume HxiG2. exact HxiG2.
	            }
	
	            (** Now use uniqueness in G1 and G2 to compare prefix/suffix words. **)
	            set wp1 := word_product multG eG xs1 n1.
	            set wp2 := word_product multG eG xs2 n2.
	            set wp1' := word_product multG eG xs1' n1'.
	            set wp2' := word_product multG eG xs2' n2'.
	
	            claim Hwp1_G2 : wp1 :e G2.
	            { exact (Hword_product_in_G2 n1 xs1 Hred1 HallG2_1). }
	            claim Hwp2_G1 : wp2 :e G1.
	            { exact (Hword_product_in_G1 n2 xs2 Hred2 HallG1_2). }
	            claim Hwp1'_G2 : wp1' :e G2.
	            { exact (Hword_product_in_G2 n1' xs1' Hred1' HallG2_1'). }
	            claim Hwp2'_G1 : wp2' :e G1.
	            { exact (Hword_product_in_G1 n2' xs2' Hred2' HallG1_2'). }
	            claim Hwp1_ne : wp1 <> eG.
	            {
	              assume Hwp1_e.
	              claim Hx_eq :
	                x = apply_fun multG (wp1, wp2).
	              {
	                (** Split the original word product. **)
	                claim HxsG_all : forall j:set, j :e n -> apply_fun xs j :e G.
	                {
	                  let j. assume Hj.
	                  apply (Hside_union n xs Hred j Hj).
	                  - assume HjG1.
	                    exact (subgroup_of_subset G1 G multG eG invG Hsub1 (apply_fun xs j) HjG1).
	                  - assume HjG2.
	                    exact (subgroup_of_subset G2 G multG eG invG Hsub2 (apply_fun xs j) HjG2).
	                }
	                claim Hsplit :
	                  word_product multG eG xs n =
	                    apply_fun multG (word_product multG eG xs n1, wp2).
	                {
	                  exact (word_product_split_by_add_nat
	                    G multG eG invG n xs n1 n2
	                    Hgrp Hn1_nat Hn2_nat Hn_eq
	                    HxsG_all).
	                }
	                claim Hwp1_eq :
	                  word_product multG eG xs n1 = wp1.
	                {
	                  claim Hn1O : n1 :e omega. { exact (nat_p_omega n1 Hn1_nat). }
	                  apply (nat_primrec_ext eG
	                    (fun j r:set => apply_fun multG (r, apply_fun xs j))
	                    (fun j r:set => apply_fun multG (r, apply_fun xs1 j))
	                    n1
	                    Hn1O).
	                  let j r. assume Hj1.
	                  claim Hxsj : apply_fun xs j = apply_fun xs1 j.
	                  {
	                    claim Hxs1j : apply_fun xs1 j = apply_fun xs j.
	                    { exact (apply_fun_graph n1 (fun t:set => apply_fun xs t) j Hj1). }
	                    exact (eq_symm (apply_fun xs1 j) (apply_fun xs j) Hxs1j).
	                  }
	                  rewrite Hxsj.
	                  reflexivity.
	                }
	                claim Hx_eq0 :
	                  x = apply_fun multG (word_product multG eG xs n1, wp2).
	                {
	                  rewrite <- Hsplit.
	                  exact (eq_symm (word_product multG eG xs n) x Hwp).
	                }
	                claim Hmul_eq :
	                  apply_fun multG (word_product multG eG xs n1, wp2) = apply_fun multG (wp1, wp2).
	                { rewrite Hwp1_eq. reflexivity. }
	                exact (eq_i_tra x (apply_fun multG (word_product multG eG xs n1, wp2)) (apply_fun multG (wp1, wp2)) Hx_eq0 Hmul_eq).
	              }
	              claim Hx_eq2 : x = apply_fun multG (eG, wp2).
	              {
	                claim Hmul_eq : apply_fun multG (wp1, wp2) = apply_fun multG (eG, wp2).
	                { rewrite Hwp1_e. reflexivity. }
	                exact (eq_i_tra x (apply_fun multG (wp1, wp2)) (apply_fun multG (eG, wp2)) Hx_eq Hmul_eq).
	              }
	              claim Hwp2_G : wp2 :e G.
	              { exact (subgroup_of_subset G1 G multG eG invG Hsub1 wp2 Hwp2_G1). }
	              claim HidL :
	                apply_fun multG (eG, wp2) = wp2.
	              {
	                apply (and6E
	                  (function_on multG (setprod G G) G)
	                  (function_on invG G G)
	                  (eG :e G)
	                  (forall y z w:set, y :e G -> z :e G -> w :e G ->
	                    apply_fun multG (apply_fun multG (y, z), w) =
	                      apply_fun multG (y, apply_fun multG (z, w)))
	                  (forall y:set, y :e G -> apply_fun multG (eG, y) = y /\ apply_fun multG (y, eG) = y)
	                  (forall y:set, y :e G ->
	                    apply_fun multG (y, apply_fun invG y) = eG /\
	                    apply_fun multG (apply_fun invG y, y) = eG)
	                  Hgrp).
	                assume _ _ _ _ Hid _.
	                exact (andEL
	                  (apply_fun multG (eG, wp2) = wp2)
	                  (apply_fun multG (wp2, eG) = wp2)
	                  (Hid wp2 Hwp2_G)).
	              }
	              claim Hx_eq3 : x = wp2.
	              { exact (eq_i_tra x (apply_fun multG (eG, wp2)) wp2 Hx_eq2 HidL). }
	              claim HxG1 : x :e G1.
	              { rewrite Hx_eq3. exact Hwp2_G1. }
	              exact (Hx_not_G1 HxG1).
	            }
	            claim Hwp2_ne : wp2 <> eG. { exact Hsuf_ne. }
	            claim Hwp1'_ne : wp1' <> eG.
	            {
	              assume Hwp1'_e.
	              claim Hx_eq :
	                x = apply_fun multG (wp1', wp2').
	              {
	                claim Hsplit :
	                  word_product multG eG xs' n' =
	                    apply_fun multG (word_product multG eG xs' n1', wp2').
	                {
	                  claim HxsG_all' : forall j:set, j :e n' -> apply_fun xs' j :e G.
	                  {
	                    let j. assume Hj.
	                    apply (Hside_union n' xs' Hred' j Hj).
	                    - assume HjG1.
	                      exact (subgroup_of_subset G1 G multG eG invG Hsub1 (apply_fun xs' j) HjG1).
	                    - assume HjG2.
	                      exact (subgroup_of_subset G2 G multG eG invG Hsub2 (apply_fun xs' j) HjG2).
	                  }
	                  exact (word_product_split_by_add_nat
	                    G multG eG invG n' xs' n1' n2'
	                    Hgrp Hn1'_nat Hn2'_nat Hn'_eq
	                    HxsG_all').
	                }
	                claim Hwp1'_eq :
	                  word_product multG eG xs' n1' = wp1'.
	                {
	                  claim Hn1O : n1' :e omega. { exact (nat_p_omega n1' Hn1'_nat). }
	                  apply (nat_primrec_ext eG
	                    (fun j r:set => apply_fun multG (r, apply_fun xs' j))
	                    (fun j r:set => apply_fun multG (r, apply_fun xs1' j))
	                    n1'
	                    Hn1O).
	                  let j r. assume Hj1.
	                  rewrite (apply_fun_graph n1' (fun t:set => apply_fun xs' t) j Hj1).
	                  reflexivity.
	                }
	                claim Hx_eq0 :
	                  x = apply_fun multG (word_product multG eG xs' n1', wp2').
	                {
	                  rewrite <- Hsplit.
	                  exact (eq_symm (word_product multG eG xs' n') x Hwp').
	                }
	                claim Hmul_eq :
	                  apply_fun multG (word_product multG eG xs' n1', wp2') = apply_fun multG (wp1', wp2').
	                { rewrite Hwp1'_eq. reflexivity. }
	                exact (eq_i_tra x (apply_fun multG (word_product multG eG xs' n1', wp2')) (apply_fun multG (wp1', wp2')) Hx_eq0 Hmul_eq).
	              }
	              claim Hx_eq2 : x = apply_fun multG (eG, wp2').
	              {
	                claim Hmul_eq : apply_fun multG (wp1', wp2') = apply_fun multG (eG, wp2').
	                { rewrite Hwp1'_e. reflexivity. }
	                exact (eq_i_tra x (apply_fun multG (wp1', wp2')) (apply_fun multG (eG, wp2')) Hx_eq Hmul_eq).
	              }
	              claim Hwp2'_G : wp2' :e G.
	              { exact (subgroup_of_subset G1 G multG eG invG Hsub1 wp2' Hwp2'_G1). }
	              claim HidL :
	                apply_fun multG (eG, wp2') = wp2'.
	              {
	                apply (and6E
	                  (function_on multG (setprod G G) G)
	                  (function_on invG G G)
	                  (eG :e G)
	                  (forall y z w:set, y :e G -> z :e G -> w :e G ->
	                    apply_fun multG (apply_fun multG (y, z), w) =
	                      apply_fun multG (y, apply_fun multG (z, w)))
	                  (forall y:set, y :e G -> apply_fun multG (eG, y) = y /\ apply_fun multG (y, eG) = y)
	                  (forall y:set, y :e G ->
	                    apply_fun multG (y, apply_fun invG y) = eG /\
	                    apply_fun multG (apply_fun invG y, y) = eG)
	                  Hgrp).
	                assume _ _ _ _ Hid _.
	                exact (andEL
	                  (apply_fun multG (eG, wp2') = wp2')
	                  (apply_fun multG (wp2', eG) = wp2')
	                  (Hid wp2' Hwp2'_G)).
	              }
	              claim Hx_eq3 : x = wp2'.
	              { exact (eq_i_tra x (apply_fun multG (eG, wp2')) wp2' Hx_eq2 HidL). }
	              claim HxG1 : x :e G1.
	              { rewrite Hx_eq3. exact Hwp2'_G1. }
	              exact (Hx_not_G1 HxG1).
	            }
	            claim Hwp2'_ne : wp2' <> eG. { exact Hsuf_ne'. }
	
	            (** Use binary normal form uniqueness to identify the factor products. **)
	            set xb := graph 2 (fun t:set => If_i (t = 0) wp1 wp2).
	            set xb' := graph 2 (fun t:set => If_i (t = 0) wp1' wp2').
	            claim Hdisj12 :
	              forall a b:set, a :e (UPair 0 1) -> b :e (UPair 0 1) -> a <> b ->
	                forall z:set, z :e apply_fun Gfam12 a -> z :e apply_fun Gfam12 b -> z = eG.
	            {
	              let a b. assume Ha Hb Hab.
	              let z. assume Hz1 Hz2.
	              claim HGfam0 : apply_fun Gfam12 0 = G1.
	              {
	                rewrite (apply_fun_graph (UPair 0 1) (fun u:set => if u = 0 then G1 else G2) 0 (UPairI1 0 1)).
	                rewrite (If_i_1 (0 = 0) G1 G2 (eq_refl 0)).
	                reflexivity.
	              }
	              claim HGfam1 : apply_fun Gfam12 1 = G2.
	              {
	                rewrite (apply_fun_graph (UPair 0 1) (fun u:set => if u = 0 then G1 else G2) 1 (UPairI2 0 1)).
	                rewrite (If_i_0 (1 = 0) G1 G2 neq_1_0).
	                reflexivity.
	              }
	              apply (UPairE a 0 1 Ha).
	              - assume Ha0.
	                apply (UPairE b 0 1 Hb).
	                + assume Hb0.
	                  claim Hab0 : a = b.
	                  { exact (eq_i_tra a 0 b Ha0 (eq_symm b 0 Hb0)). }
	                  exact (FalseE (Hab Hab0) (z = eG)).
	                + assume Hb1.
	                  claim HzG1 : z :e G1.
	                  {
	                    claim Hga : apply_fun Gfam12 a = G1.
	                    { rewrite Ha0. exact HGfam0. }
	                    exact (eq_subst_mem_set z (apply_fun Gfam12 a) G1 Hz1 Hga).
	                  }
	                  claim HzG2 : z :e G2.
	                  {
	                    claim Hgb : apply_fun Gfam12 b = G2.
	                    { rewrite Hb1. exact HGfam1. }
	                    exact (eq_subst_mem_set z (apply_fun Gfam12 b) G2 Hz2 Hgb).
	                  }
	                  exact (free_product_binary_factors_intersect_trivial
	                    G multG eG invG G1 G2 z Hfp HzG1 HzG2).
	              - assume Ha1.
	                apply (UPairE b 0 1 Hb).
	                + assume Hb0.
	                  claim HzG2 : z :e G2.
	                  {
	                    claim Hga : apply_fun Gfam12 a = G2.
	                    { rewrite Ha1. exact HGfam1. }
	                    exact (eq_subst_mem_set z (apply_fun Gfam12 a) G2 Hz1 Hga).
	                  }
	                  claim HzG1 : z :e G1.
	                  {
	                    claim Hgb : apply_fun Gfam12 b = G1.
	                    { rewrite Hb0. exact HGfam0. }
	                    exact (eq_subst_mem_set z (apply_fun Gfam12 b) G1 Hz2 Hgb).
	                  }
	                  exact (free_product_binary_factors_intersect_trivial
	                    G multG eG invG G1 G2 z Hfp HzG1 HzG2).
	                + assume Hb1.
	                  claim Hab0 : a = b.
	                  { exact (eq_i_tra a 1 b Ha1 (eq_symm b 1 Hb1)). }
	                  exact (FalseE (Hab Hab0) (z = eG)).
	            }
	
	            claim Hwp_xb : word_product multG eG xb 2 = x.
	            {
	              claim HxbG : forall t:set, t :e 2 -> apply_fun xb t :e G.
	              {
	                let t. assume Ht.
	                apply (xm (t = 0)).
	                - assume Ht0.
	                  rewrite (apply_fun_graph 2 (fun i0:set => If_i (i0 = 0) wp1 wp2) t Ht).
	                  rewrite (If_i_1 (t = 0) wp1 wp2 Ht0).
	                  exact (subgroup_of_subset G2 G multG eG invG Hsub2 wp1 Hwp1_G2).
	                - assume Ht0ne.
	                  rewrite (apply_fun_graph 2 (fun i0:set => If_i (i0 = 0) wp1 wp2) t Ht).
	                  rewrite (If_i_0 (t = 0) wp1 wp2 (fun Heq => Ht0ne Heq)).
	                  exact (subgroup_of_subset G1 G multG eG invG Hsub1 wp2 Hwp2_G1).
	              }
	              claim Hwp2eq :
	                word_product multG eG xb 2 = apply_fun multG (apply_fun xb 0, apply_fun xb 1).
	              { exact (word_product_two_group G multG eG invG xb Hgrp HxbG). }
	              claim Hxb0 : apply_fun xb 0 = wp1.
	              {
	                rewrite (apply_fun_graph 2 (fun i0:set => If_i (i0 = 0) wp1 wp2) 0 In_0_2).
	                exact (If_i_1 (0 = 0) wp1 wp2 (eq_refl 0)).
	              }
	              claim Hxb1 : apply_fun xb 1 = wp2.
	              {
	                rewrite (apply_fun_graph 2 (fun i0:set => If_i (i0 = 0) wp1 wp2) 1 In_1_2).
	                exact (If_i_0 (1 = 0) wp1 wp2 neq_1_0).
	              }
	              rewrite Hwp2eq.
	              rewrite Hxb0.
	              rewrite Hxb1.
	
	              (** Compute x = apply_fun multG (wp1, wp2) from the original decomposition. **)
	              claim HxsG_all : forall j:set, j :e n -> apply_fun xs j :e G.
	              {
	                let j. assume Hj.
	                apply (Hside_union n xs Hred j Hj).
	                - assume HjG1.
	                  exact (subgroup_of_subset G1 G multG eG invG Hsub1 (apply_fun xs j) HjG1).
	                - assume HjG2.
	                  exact (subgroup_of_subset G2 G multG eG invG Hsub2 (apply_fun xs j) HjG2).
	              }
	              claim Hsplit :
	                word_product multG eG xs n =
	                  apply_fun multG (word_product multG eG xs n1, wp2).
	              {
	                exact (word_product_split_by_add_nat
	                  G multG eG invG n xs n1 n2
	                  Hgrp Hn1_nat Hn2_nat Hn_eq
	                  HxsG_all).
	              }
	              claim Hwp1_eq :
	                word_product multG eG xs n1 = wp1.
	              {
	                claim Hn1O : n1 :e omega. { exact (nat_p_omega n1 Hn1_nat). }
	                apply (nat_primrec_ext eG
	                  (fun j r:set => apply_fun multG (r, apply_fun xs j))
	                  (fun j r:set => apply_fun multG (r, apply_fun xs1 j))
	                  n1
	                  Hn1O).
	                let j r. assume Hj1.
	                claim Hxsj : apply_fun xs j = apply_fun xs1 j.
	                {
	                  claim Hxs1j : apply_fun xs1 j = apply_fun xs j.
	                  { exact (apply_fun_graph n1 (fun t:set => apply_fun xs t) j Hj1). }
	                  exact (eq_symm (apply_fun xs1 j) (apply_fun xs j) Hxs1j).
	                }
	                rewrite Hxsj.
	                reflexivity.
	              }
	              rewrite <- Hwp.
	              rewrite Hsplit.
	              rewrite Hwp1_eq.
	              reflexivity.
	            }
	
	            claim Hwp_xb' : word_product multG eG xb' 2 = x.
	            {
	              claim HxbG : forall t:set, t :e 2 -> apply_fun xb' t :e G.
	              {
	                let t. assume Ht.
	                apply (xm (t = 0)).
	                - assume Ht0.
	                  rewrite (apply_fun_graph 2 (fun i0:set => If_i (i0 = 0) wp1' wp2') t Ht).
	                  rewrite (If_i_1 (t = 0) wp1' wp2' Ht0).
	                  exact (subgroup_of_subset G2 G multG eG invG Hsub2 wp1' Hwp1'_G2).
	                - assume Ht0ne.
	                  rewrite (apply_fun_graph 2 (fun i0:set => If_i (i0 = 0) wp1' wp2') t Ht).
	                  rewrite (If_i_0 (t = 0) wp1' wp2' (fun Heq => Ht0ne Heq)).
	                  exact (subgroup_of_subset G1 G multG eG invG Hsub1 wp2' Hwp2'_G1).
	              }
	              claim Hwp2eq :
	                word_product multG eG xb' 2 = apply_fun multG (apply_fun xb' 0, apply_fun xb' 1).
	              { exact (word_product_two_group G multG eG invG xb' Hgrp HxbG). }
	              claim Hxb0 : apply_fun xb' 0 = wp1'.
	              {
	                rewrite (apply_fun_graph 2 (fun i0:set => If_i (i0 = 0) wp1' wp2') 0 In_0_2).
	                exact (If_i_1 (0 = 0) wp1' wp2' (eq_refl 0)).
	              }
	              claim Hxb1 : apply_fun xb' 1 = wp2'.
	              {
	                rewrite (apply_fun_graph 2 (fun i0:set => If_i (i0 = 0) wp1' wp2') 1 In_1_2).
	                exact (If_i_0 (1 = 0) wp1' wp2' neq_1_0).
	              }
	              rewrite Hwp2eq.
	              rewrite Hxb0.
	              rewrite Hxb1.
	
	              claim HxsG_all' : forall j:set, j :e n' -> apply_fun xs' j :e G.
	              {
	                let j. assume Hj.
	                apply (Hside_union n' xs' Hred' j Hj).
	                - assume HjG1.
	                  exact (subgroup_of_subset G1 G multG eG invG Hsub1 (apply_fun xs' j) HjG1).
	                - assume HjG2.
	                  exact (subgroup_of_subset G2 G multG eG invG Hsub2 (apply_fun xs' j) HjG2).
	              }
	              claim Hsplit :
	                word_product multG eG xs' n' =
	                  apply_fun multG (word_product multG eG xs' n1', wp2').
	              {
	                exact (word_product_split_by_add_nat
	                  G multG eG invG n' xs' n1' n2'
	                  Hgrp Hn1'_nat Hn2'_nat Hn'_eq
	                  HxsG_all').
	              }
	              claim Hwp1'_eq :
	                word_product multG eG xs' n1' = wp1'.
	              {
	                claim Hn1O : n1' :e omega. { exact (nat_p_omega n1' Hn1'_nat). }
	                apply (nat_primrec_ext eG
	                  (fun j r:set => apply_fun multG (r, apply_fun xs' j))
	                  (fun j r:set => apply_fun multG (r, apply_fun xs1' j))
	                  n1'
	                  Hn1O).
	                let j r. assume Hj1.
	                claim Hxsj : apply_fun xs' j = apply_fun xs1' j.
	                {
	                  claim Hxs1j : apply_fun xs1' j = apply_fun xs' j.
	                  { exact (apply_fun_graph n1' (fun t:set => apply_fun xs' t) j Hj1). }
	                  exact (eq_symm (apply_fun xs1' j) (apply_fun xs' j) Hxs1j).
	                }
	                rewrite Hxsj.
	                reflexivity.
	              }
	              rewrite <- Hwp'.
	              rewrite Hsplit.
	              rewrite Hwp1'_eq.
	              reflexivity.
	            }
	
	            claim Hred_xb : reduced_word (UPair 0 1) Gfam12 efam12 2 xb.
	            {
	              claim HGfam1 : apply_fun Gfam12 1 = G2.
	              {
	                rewrite (apply_fun_graph (UPair 0 1) (fun u:set => if u = 0 then G1 else G2) 1 (UPairI2 0 1)).
	                rewrite (If_i_0 (1 = 0) G1 G2 neq_1_0).
	                reflexivity.
	              }
	              claim HGfam0 : apply_fun Gfam12 0 = G1.
	              {
	                rewrite (apply_fun_graph (UPair 0 1) (fun u:set => if u = 0 then G1 else G2) 0 (UPairI1 0 1)).
	                rewrite (If_i_1 (0 = 0) G1 G2 (eq_refl 0)).
	                reflexivity.
	              }
	              claim Hef1 : apply_fun efam12 1 = eG.
	              { exact (apply_fun_graph (UPair 0 1) (fun _:set => eG) 1 (UPairI2 0 1)). }
	              claim Hef0 : apply_fun efam12 0 = eG.
	              { exact (apply_fun_graph (UPair 0 1) (fun _:set => eG) 0 (UPairI1 0 1)). }
	              claim Hwp1_in : wp1 :e apply_fun Gfam12 1.
	              { rewrite HGfam1. exact Hwp1_G2. }
	              claim Hwp2_in : wp2 :e apply_fun Gfam12 0.
	              { rewrite HGfam0. exact Hwp2_G1. }
	              claim Hwp1_ne_ef : wp1 <> apply_fun efam12 1.
	              { rewrite Hef1. exact Hwp1_ne. }
	              claim Hwp2_ne_ef : wp2 <> apply_fun efam12 0.
	              { rewrite Hef0. exact Hwp2_ne. }
	              exact (reduced_word_two_graph_disjoint
	                G multG eG invG (UPair 0 1) Gfam12 efam12
	                1 0 wp1 wp2
	                Hdisj12
	                (UPairI2 0 1) (UPairI1 0 1) neq_1_0
	                Hwp1_in Hwp1_ne Hwp1_ne_ef
	                Hwp2_in Hwp2_ne Hwp2_ne_ef).
	            }
	            claim Hred_xb' : reduced_word (UPair 0 1) Gfam12 efam12 2 xb'.
	            {
	              claim HGfam1 : apply_fun Gfam12 1 = G2.
	              {
	                rewrite (apply_fun_graph (UPair 0 1) (fun u:set => if u = 0 then G1 else G2) 1 (UPairI2 0 1)).
	                rewrite (If_i_0 (1 = 0) G1 G2 neq_1_0).
	                reflexivity.
	              }
	              claim HGfam0 : apply_fun Gfam12 0 = G1.
	              {
	                rewrite (apply_fun_graph (UPair 0 1) (fun u:set => if u = 0 then G1 else G2) 0 (UPairI1 0 1)).
	                rewrite (If_i_1 (0 = 0) G1 G2 (eq_refl 0)).
	                reflexivity.
	              }
	              claim Hef1 : apply_fun efam12 1 = eG.
	              { exact (apply_fun_graph (UPair 0 1) (fun _:set => eG) 1 (UPairI2 0 1)). }
	              claim Hef0 : apply_fun efam12 0 = eG.
	              { exact (apply_fun_graph (UPair 0 1) (fun _:set => eG) 0 (UPairI1 0 1)). }
	              claim Hwp1_in : wp1' :e apply_fun Gfam12 1.
	              { rewrite HGfam1. exact Hwp1'_G2. }
	              claim Hwp2_in : wp2' :e apply_fun Gfam12 0.
	              { rewrite HGfam0. exact Hwp2'_G1. }
	              claim Hwp1_ne_ef : wp1' <> apply_fun efam12 1.
	              { rewrite Hef1. exact Hwp1'_ne. }
	              claim Hwp2_ne_ef : wp2' <> apply_fun efam12 0.
	              { rewrite Hef0. exact Hwp2'_ne. }
	              exact (reduced_word_two_graph_disjoint
	                G multG eG invG (UPair 0 1) Gfam12 efam12
	                1 0 wp1' wp2'
	                Hdisj12
	                (UPairI2 0 1) (UPairI1 0 1) neq_1_0
	                (eq_subst_mem_set wp1' G2 (apply_fun Gfam12 1) Hwp1'_G2 (eq_symm (apply_fun Gfam12 1) G2 HGfam1))
	                Hwp1'_ne Hwp1_ne_ef
	                (eq_subst_mem_set wp2' G1 (apply_fun Gfam12 0) Hwp2'_G1 (eq_symm (apply_fun Gfam12 0) G1 HGfam0))
	                Hwp2'_ne Hwp2_ne_ef).
	            }
	
	            claim Huniqb :
	              n12 = 2 /\ (forall i0:set, i0 :e n12 -> apply_fun xs12 i0 = apply_fun xb i0).
	            { exact (Huniq12 2 xb Hred_xb neq_2_0 Hwp_xb). }
	            claim Huniqb' :
	              n12 = 2 /\ (forall i0:set, i0 :e n12 -> apply_fun xs12 i0 = apply_fun xb' i0).
	            { exact (Huniq12 2 xb' Hred_xb' neq_2_0 Hwp_xb'). }
	            claim Hpt : forall i0:set, i0 :e n12 -> apply_fun xs12 i0 = apply_fun xb i0.
	            { exact (andER (n12 = 2) (forall i0:set, i0 :e n12 -> apply_fun xs12 i0 = apply_fun xb i0) Huniqb). }
	            claim Hpt' : forall i0:set, i0 :e n12 -> apply_fun xs12 i0 = apply_fun xb' i0.
	            { exact (andER (n12 = 2) (forall i0:set, i0 :e n12 -> apply_fun xs12 i0 = apply_fun xb' i0) Huniqb'). }
	            claim Hwp1_eq0 : wp1 = apply_fun xs12 0.
	            {
	              claim H0 : apply_fun xs12 0 = apply_fun xb 0.
	              { exact (Hpt 0 H0in12). }
	              claim Hxb0 : apply_fun xb 0 = wp1.
	              {
	                rewrite (apply_fun_graph 2 (fun i0:set => If_i (i0 = 0) wp1 wp2) 0 In_0_2).
	                exact (If_i_1 (0 = 0) wp1 wp2 (eq_refl 0)).
	              }
	              exact (eq_i_tra wp1 (apply_fun xb 0) (apply_fun xs12 0) (eq_symm (apply_fun xb 0) wp1 Hxb0) (eq_symm (apply_fun xs12 0) (apply_fun xb 0) H0)).
	            }
	            claim Hwp2_eq1 : wp2 = apply_fun xs12 1.
	            {
	              claim H1 : apply_fun xs12 1 = apply_fun xb 1.
	              { exact (Hpt 1 H1in12). }
	              claim Hxb1 : apply_fun xb 1 = wp2.
	              {
	                rewrite (apply_fun_graph 2 (fun i0:set => If_i (i0 = 0) wp1 wp2) 1 In_1_2).
	                exact (If_i_0 (1 = 0) wp1 wp2 neq_1_0).
	              }
	              exact (eq_i_tra wp2 (apply_fun xb 1) (apply_fun xs12 1) (eq_symm (apply_fun xb 1) wp2 Hxb1) (eq_symm (apply_fun xs12 1) (apply_fun xb 1) H1)).
	            }
	            claim Hwp1'_eq0 : wp1' = apply_fun xs12 0.
	            {
	              claim H0 : apply_fun xs12 0 = apply_fun xb' 0.
	              { exact (Hpt' 0 H0in12). }
	              claim Hxb0 : apply_fun xb' 0 = wp1'.
	              {
	                rewrite (apply_fun_graph 2 (fun i0:set => If_i (i0 = 0) wp1' wp2') 0 In_0_2).
	                exact (If_i_1 (0 = 0) wp1' wp2' (eq_refl 0)).
	              }
	              exact (eq_i_tra wp1' (apply_fun xb' 0) (apply_fun xs12 0) (eq_symm (apply_fun xb' 0) wp1' Hxb0) (eq_symm (apply_fun xs12 0) (apply_fun xb' 0) H0)).
	            }
	            claim Hwp2'_eq1 : wp2' = apply_fun xs12 1.
	            {
	              claim H1 : apply_fun xs12 1 = apply_fun xb' 1.
	              { exact (Hpt' 1 H1in12). }
	              claim Hxb1 : apply_fun xb' 1 = wp2'.
	              {
	                rewrite (apply_fun_graph 2 (fun i0:set => If_i (i0 = 0) wp1' wp2') 1 In_1_2).
	                exact (If_i_0 (1 = 0) wp1' wp2' neq_1_0).
	              }
	              exact (eq_i_tra wp2' (apply_fun xb' 1) (apply_fun xs12 1) (eq_symm (apply_fun xb' 1) wp2' Hxb1) (eq_symm (apply_fun xs12 1) (apply_fun xb' 1) H1)).
	            }
	            claim Hwp1_eq : wp1 = wp1'.
	            { exact (eq_i_tra wp1 (apply_fun xs12 0) wp1' Hwp1_eq0 (eq_symm wp1' (apply_fun xs12 0) Hwp1'_eq0)). }
	            claim Hwp2_eq : wp2 = wp2'.
	            { exact (eq_i_tra wp2 (apply_fun xs12 1) wp2' Hwp2_eq1 (eq_symm wp2' (apply_fun xs12 1) Hwp2'_eq1)). }
	
	            (** Unique reduced word decomposition inside K for wp1. **)
	            claim HallNe1 : forall j:set, j :e n1 -> apply_fun xs1 j <> eG.
	            {
	              let j. assume Hj1.
	              rewrite (apply_fun_graph n1 (fun t:set => apply_fun xs t) j Hj1).
	              exact (HallNe j (Hn1_sub_n j Hj1)).
	            }
	            claim HredK1 : reduced_word K (graph K (fun b:set => apply_fun Hfam b))
	              (graph K (fun b:set => apply_fun efamH b)) n1 xs1.
	            { exact (Hred_K_of_union n1 xs1 Hred1 HallG2_1 HallNe1). }
	            claim HallNe1'2 : forall j:set, j :e n1' -> apply_fun xs1' j <> eG.
	            {
	              let j. assume Hj1.
	              rewrite (apply_fun_graph n1' (fun t:set => apply_fun xs' t) j Hj1).
	              exact (HallNe' j (Hn1'_sub_n' j Hj1)).
	            }
	            claim HredK1' : reduced_word K (graph K (fun b:set => apply_fun Hfam b))
	              (graph K (fun b:set => apply_fun efamH b)) n1' xs1'.
	            { exact (Hred_K_of_union n1' xs1' Hred1' HallG2_1' HallNe1'2). }
	            claim Hn1_ne0 : n1 <> 0. { exact (neq_ordsucc_0 m). }
	            claim Hn1'_ne0 : n1' <> 0. { exact (neq_ordsucc_0 m'). }
	
	            apply (and6E
	              (group_structure G2 multG eG invG)
	              (forall beta:set, beta :e K ->
	                subgroup_of (apply_fun (graph K (fun b:set => apply_fun Hfam b)) beta) G2 multG eG invG)
	              (forall beta gamma:set, beta :e K -> gamma :e K -> beta <> gamma ->
	                forall y:set, y :e apply_fun (graph K (fun b:set => apply_fun Hfam b)) beta ->
	                  y :e apply_fun (graph K (fun b:set => apply_fun Hfam b)) gamma -> y = eG)
	              (subgroups_generate G2 multG eG invG K (graph K (fun b:set => apply_fun Hfam b)))
	              (forall y:set, y :e G2 -> y <> eG ->
	                exists mK ysK:set,
	                  reduced_word K (graph K (fun b:set => apply_fun Hfam b))
	                    (graph K (fun b:set => apply_fun efamH b)) mK ysK /\ mK <> 0 /\
	                  word_product multG eG ysK mK = y /\
	                  (forall m' ys':set,
	                    reduced_word K (graph K (fun b:set => apply_fun Hfam b))
	                      (graph K (fun b:set => apply_fun efamH b)) m' ys' -> m' <> 0 ->
	                    word_product multG eG ys' m' = y ->
	                    mK = m' /\ (forall i:set, i :e mK -> apply_fun ysK i = apply_fun ys' i)))
	              (forall alpha:set, alpha :e K -> apply_fun (graph K (fun b:set => apply_fun efamH b)) alpha = eG)
	              Hfp2).
	            assume _ _ _ _ HuniqK _.
	            apply (HuniqK wp1 Hwp1_G2 Hwp1_ne).
	            let mK. assume HmK_pack.
	            apply HmK_pack. let ysK. assume HysK_pack.
	            apply (and4E
	              (reduced_word K (graph K (fun b:set => apply_fun Hfam b))
	                (graph K (fun b:set => apply_fun efamH b)) mK ysK)
	              (mK <> 0)
	              (word_product multG eG ysK mK = wp1)
	              (forall m' ys':set,
	                reduced_word K (graph K (fun b:set => apply_fun Hfam b))
	                  (graph K (fun b:set => apply_fun efamH b)) m' ys' -> m' <> 0 ->
	                word_product multG eG ys' m' = wp1 ->
	                mK = m' /\ (forall i:set, i :e mK -> apply_fun ysK i = apply_fun ys' i))
	              HysK_pack).
	            assume HredK0 HmK_ne HwpK0 HuniqK0.
	            claim Huniq_xs1 : mK = n1 /\ (forall i:set, i :e mK -> apply_fun ysK i = apply_fun xs1 i).
	            { exact (HuniqK0 n1 xs1 HredK1 Hn1_ne0 (eq_refl wp1)). }
	            claim Huniq_xs1' : mK = n1' /\ (forall i:set, i :e mK -> apply_fun ysK i = apply_fun xs1' i).
	            {
	              claim Hwp1'_def : word_product multG eG xs1' n1' = wp1'.
	              { reflexivity. }
	              claim Hwp1'_eq : word_product multG eG xs1' n1' = wp1.
	              { exact (eq_i_tra (word_product multG eG xs1' n1') wp1' wp1 Hwp1'_def (eq_symm wp1 wp1' Hwp1_eq)). }
	              exact (HuniqK0 n1' xs1' HredK1' Hn1'_ne0 Hwp1'_eq).
	            }
	            claim Hn1_eq : n1 = n1'.
	            {
	              claim HmK_eq_n1 : mK = n1.
	              { exact (andEL (mK = n1) (forall i:set, i :e mK -> apply_fun ysK i = apply_fun xs1 i) Huniq_xs1). }
	              claim HmK_eq_n1' : mK = n1'.
	              { exact (andEL (mK = n1') (forall i:set, i :e mK -> apply_fun ysK i = apply_fun xs1' i) Huniq_xs1'). }
	              exact (eq_i_tra n1 mK n1'
	                (eq_symm mK n1 HmK_eq_n1)
	                HmK_eq_n1').
	            }
	
	            (** Unique reduced word decomposition inside J for wp2. **)
	            claim HredJ2 : reduced_word J (graph J (fun a:set => apply_fun Hfam a))
	              (graph J (fun a:set => apply_fun efamH a)) n2 xs2.
	            { exact (Hred_J_of_union n2 xs2 Hred2 HallG1_2 HallNe2). }
	            claim HredJ2' : reduced_word J (graph J (fun a:set => apply_fun Hfam a))
	              (graph J (fun a:set => apply_fun efamH a)) n2' xs2'.
	            { exact (Hred_J_of_union n2' xs2' Hred2' HallG1_2' HallNe2'). }
	            claim Hn2_ne0 : n2 <> 0. { exact Hn2_ne0. }
	            claim Hn2'_ne0' : n2' <> 0. { exact Hn2'_ne0. }
	
	            apply (and6E
	              (group_structure G1 multG eG invG)
	              (forall alpha:set, alpha :e J ->
	                subgroup_of (apply_fun (graph J (fun a:set => apply_fun Hfam a)) alpha) G1 multG eG invG)
	              (forall alpha beta:set, alpha :e J -> beta :e J -> alpha <> beta ->
	                forall y:set, y :e apply_fun (graph J (fun a:set => apply_fun Hfam a)) alpha ->
	                  y :e apply_fun (graph J (fun a:set => apply_fun Hfam a)) beta -> y = eG)
	              (subgroups_generate G1 multG eG invG J (graph J (fun a:set => apply_fun Hfam a)))
	              (forall y:set, y :e G1 -> y <> eG ->
	                exists mJ ysJ:set,
	                  reduced_word J (graph J (fun a:set => apply_fun Hfam a))
	                    (graph J (fun a:set => apply_fun efamH a)) mJ ysJ /\ mJ <> 0 /\
	                  word_product multG eG ysJ mJ = y /\
	                  (forall m' ys':set,
	                    reduced_word J (graph J (fun a:set => apply_fun Hfam a))
	                      (graph J (fun a:set => apply_fun efamH a)) m' ys' -> m' <> 0 ->
	                    word_product multG eG ys' m' = y ->
	                    mJ = m' /\ (forall i:set, i :e mJ -> apply_fun ysJ i = apply_fun ys' i)))
	              (forall alpha:set, alpha :e J -> apply_fun (graph J (fun a:set => apply_fun efamH a)) alpha = eG)
	              Hfp1).
	            assume _ _ _ _ HuniqJ _.
	            apply (HuniqJ wp2 Hwp2_G1 Hwp2_ne).
	            let mJ. assume HmJ_pack.
	            apply HmJ_pack. let ysJ. assume HysJ_pack.
	            apply (and4E
	              (reduced_word J (graph J (fun a:set => apply_fun Hfam a))
	                (graph J (fun a:set => apply_fun efamH a)) mJ ysJ)
	              (mJ <> 0)
	              (word_product multG eG ysJ mJ = wp2)
	              (forall m' ys':set,
	                reduced_word J (graph J (fun a:set => apply_fun Hfam a))
	                  (graph J (fun a:set => apply_fun efamH a)) m' ys' -> m' <> 0 ->
	                word_product multG eG ys' m' = wp2 ->
	                mJ = m' /\ (forall i:set, i :e mJ -> apply_fun ysJ i = apply_fun ys' i))
	              HysJ_pack).
	            assume HredJ0 HmJ_ne HwpJ0 HuniqJ0.
	            claim Huniq_xs2 : mJ = n2 /\ (forall i:set, i :e mJ -> apply_fun ysJ i = apply_fun xs2 i).
	            { exact (HuniqJ0 n2 xs2 HredJ2 Hn2_ne0 (eq_refl wp2)). }
	            claim Huniq_xs2' : mJ = n2' /\ (forall i:set, i :e mJ -> apply_fun ysJ i = apply_fun xs2' i).
	            {
	              claim Hwp2'_eq : word_product multG eG xs2' n2' = wp2.
	              { exact (eq_i_tra (word_product multG eG xs2' n2') wp2' wp2 (eq_refl wp2') (eq_symm wp2 wp2' Hwp2_eq)). }
	              exact (HuniqJ0 n2' xs2' HredJ2' Hn2'_ne0' (eq_i_tra (word_product multG eG xs2' n2') wp2' wp2 (eq_refl wp2') (eq_symm wp2 wp2' Hwp2_eq))).
	            }
	            claim Hn2_eq : n2 = n2'.
	            {
	              claim HmJ_eq_n2 : mJ = n2.
	              { exact (andEL (mJ = n2) (forall i:set, i :e mJ -> apply_fun ysJ i = apply_fun xs2 i) Huniq_xs2). }
	              claim HmJ_eq_n2' : mJ = n2'.
	              { exact (andEL (mJ = n2') (forall i:set, i :e mJ -> apply_fun ysJ i = apply_fun xs2' i) Huniq_xs2'). }
	              exact (eq_i_tra n2 mJ n2'
	                (eq_symm mJ n2 HmJ_eq_n2)
	                HmJ_eq_n2').
	            }
	
	            (** Conclude n = n' and pointwise equality of xs and xs'. **)
	            claim Hn_eq_final : n = n'.
	            {
	              rewrite Hn_eq.
	              rewrite Hn'_eq.
	              rewrite Hn1_eq.
	              rewrite Hn2_eq.
	              reflexivity.
	            }
	            apply andI.
	            - exact Hn_eq_final.
	            - let i. assume Hi : i :e n.
	              claim Hi_in_sum : i :e add_nat n1 n2.
	              { exact (eq_subst_mem_set i n (add_nat n1 n2) Hi Hn_eq). }
	              apply (xm (i :e n1)).
	              + assume Hi1.
	                claim Hi1' : i :e n1'.
	                { exact (eq_subst_mem_set i n1 n1' Hi1 Hn1_eq). }
	                claim Hxs_i : apply_fun xs i = apply_fun xs1 i.
	                {
	                  claim Hxseq : apply_fun xs1 i = apply_fun xs i.
	                  { exact (apply_fun_graph n1 (fun t:set => apply_fun xs t) i Hi1). }
	                  exact (eq_symm (apply_fun xs1 i) (apply_fun xs i) Hxseq).
	                }
	                claim Hxs'_i : apply_fun xs' i = apply_fun xs1' i.
	                {
	                  claim Hxseq : apply_fun xs1' i = apply_fun xs' i.
	                  { exact (apply_fun_graph n1' (fun t:set => apply_fun xs' t) i Hi1'). }
	                  exact (eq_symm (apply_fun xs1' i) (apply_fun xs' i) Hxseq).
	                }
	                (** Use the canonical K-word equality. **)
	                claim HysK_xs1 : forall j:set, j :e mK -> apply_fun ysK j = apply_fun xs1 j.
	                { exact (andER (mK = n1) (forall i0:set, i0 :e mK -> apply_fun ysK i0 = apply_fun xs1 i0) Huniq_xs1). }
	                claim HysK_xs1' : forall j:set, j :e mK -> apply_fun ysK j = apply_fun xs1' j.
	                { exact (andER (mK = n1') (forall i0:set, i0 :e mK -> apply_fun ysK i0 = apply_fun xs1' i0) Huniq_xs1'). }
	                claim HimK : i :e mK.
	                { exact (eq_subst_mem_set i n1 mK Hi1 (eq_symm mK n1 (andEL (mK = n1) (forall i0:set, i0 :e mK -> apply_fun ysK i0 = apply_fun xs1 i0) Huniq_xs1))). }
	                claim Hxs1_eq : apply_fun xs1 i = apply_fun ysK i.
	                { exact (eq_symm (apply_fun ysK i) (apply_fun xs1 i) (HysK_xs1 i HimK)). }
	                claim Hxs1'_eq : apply_fun ysK i = apply_fun xs1' i.
	                { exact (HysK_xs1' i HimK). }
	                claim Hxs1_xs1' : apply_fun xs1 i = apply_fun xs1' i.
	                { exact (eq_i_tra (apply_fun xs1 i) (apply_fun ysK i) (apply_fun xs1' i) Hxs1_eq Hxs1'_eq). }
	                exact (eq_i_tra (apply_fun xs i) (apply_fun xs1 i) (apply_fun xs' i)
	                  Hxs_i
	                  (eq_i_tra (apply_fun xs1 i) (apply_fun xs1' i) (apply_fun xs' i)
	                    Hxs1_xs1'
	                    (eq_symm (apply_fun xs' i) (apply_fun xs1' i) Hxs'_i))).
	              + assume Hi_not1.
	                (** Then i is in the right part: i = n1 + j. **)
	                claim Hdecomp : exists j:set, j :e n2 /\ i = add_nat n1 j.
	                { exact (nat_add_nat_decomp_beyond_left n1 n2 i Hn1_nat Hn2_nat Hi_in_sum Hi_not1). }
	                apply Hdecomp. let j. assume Hj_pack.
	                claim Hj2 : j :e n2.
	                { exact (andEL (j :e n2) (i = add_nat n1 j) Hj_pack). }
	                claim Hi_eq : i = add_nat n1 j.
	                { exact (andER (j :e n2) (i = add_nat n1 j) Hj_pack). }
	                claim Hj2' : j :e n2'.
	                { exact (eq_subst_mem_set j n2 n2' Hj2 Hn2_eq). }
	                claim Hxs_i : apply_fun xs i = apply_fun xs2 j.
	                {
	                  rewrite Hi_eq.
	                  exact (eq_symm
	                    (apply_fun xs2 j)
	                    (apply_fun xs (add_nat n1 j))
	                    (apply_fun_graph n2 (fun t:set => apply_fun xs (add_nat n1 t)) j Hj2)).
	                }
	                claim Hxs'_i : apply_fun xs' i = apply_fun xs2' j.
	                {
	                  rewrite Hi_eq.
	                  rewrite Hn1_eq.
	                  exact (eq_symm
	                    (apply_fun xs2' j)
	                    (apply_fun xs' (add_nat n1' j))
	                    (apply_fun_graph n2' (fun t:set => apply_fun xs' (add_nat n1' t)) j Hj2')).
	                }
	                claim HysJ_xs2 : forall j0:set, j0 :e mJ -> apply_fun ysJ j0 = apply_fun xs2 j0.
	                { exact (andER (mJ = n2) (forall i0:set, i0 :e mJ -> apply_fun ysJ i0 = apply_fun xs2 i0) Huniq_xs2). }
	                claim HysJ_xs2' : forall j0:set, j0 :e mJ -> apply_fun ysJ j0 = apply_fun xs2' j0.
	                { exact (andER (mJ = n2') (forall i0:set, i0 :e mJ -> apply_fun ysJ i0 = apply_fun xs2' i0) Huniq_xs2'). }
	                claim Hj_mJ : j :e mJ.
	                { exact (eq_subst_mem_set j n2 mJ Hj2 (eq_symm mJ n2 (andEL (mJ = n2) (forall i0:set, i0 :e mJ -> apply_fun ysJ i0 = apply_fun xs2 i0) Huniq_xs2))). }
	                claim Hxs2_eq : apply_fun xs2 j = apply_fun ysJ j.
	                { exact (eq_symm (apply_fun ysJ j) (apply_fun xs2 j) (HysJ_xs2 j Hj_mJ)). }
	                claim Hxs2'_eq : apply_fun ysJ j = apply_fun xs2' j.
	                { exact (HysJ_xs2' j Hj_mJ). }
	                claim Hxs2_xs2' : apply_fun xs2 j = apply_fun xs2' j.
	                { exact (eq_i_tra (apply_fun xs2 j) (apply_fun ysJ j) (apply_fun xs2' j) Hxs2_eq Hxs2'_eq). }
	                exact (eq_i_tra (apply_fun xs i) (apply_fun xs2 j) (apply_fun xs' i)
	                  Hxs_i
	                  (eq_i_tra (apply_fun xs2 j) (apply_fun xs2' j) (apply_fun xs' i) Hxs2_xs2' (eq_symm (apply_fun xs' i) (apply_fun xs2' j) Hxs'_i))).
	          }
	        - assume Halpha1_1.
          (** Symmetric case: last binary factor is G2. **)
          (** Then the first factor is G1. **)
          claim Halpha0_0 : alpha0 = 0.
          {
            apply (UPairE alpha0 0 1 Hal0).
            + assume Halpha0_0. exact Halpha0_0.
            + assume Halpha0_1.
              claim Heq : alpha0 = alpha1.
              { rewrite Halpha0_1. rewrite Halpha1_1. reflexivity. }
              exact (FalseE (Halpha_ne Heq) (alpha0 = 0)).
          }

          (** Translate xs12 letters into the actual factors. **)
          claim Hx0G1 : apply_fun xs12 0 :e G1.
          {
            claim HG0 : apply_fun Gfam12 alpha0 = G1.
            {
              rewrite (apply_fun_graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2) alpha0 Hal0).
              exact (If_i_1 (alpha0 = 0) G1 G2 Halpha0_0).
            }
            exact (eq_subst_mem_set (apply_fun xs12 0) (apply_fun Gfam12 alpha0) G1 Hx0fam HG0).
          }
          claim Hx1G2 : apply_fun xs12 1 :e G2.
          {
            claim HG1 : apply_fun Gfam12 alpha1 = G2.
            {
              rewrite (apply_fun_graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2) alpha1 Hal1).
              claim Hne0 : alpha1 <> 0.
              { rewrite Halpha1_1. exact neq_1_0. }
              exact (If_i_0 (alpha1 = 0) G1 G2 Hne0).
            }
            exact (eq_subst_mem_set (apply_fun xs12 1) (apply_fun Gfam12 alpha1) G2 Hx1fam HG1).
          }
          claim Hx0neG : apply_fun xs12 0 <> eG.
          {
            claim He0 : apply_fun efam12 alpha0 = eG.
            { exact (apply_fun_graph (UPair 0 1) (fun _:set => eG) alpha0 Hal0). }
            assume Heq0 : apply_fun xs12 0 = eG.
            apply Hx0ne.
            rewrite He0.
            exact Heq0.
          }
          claim Hx1neG : apply_fun xs12 1 <> eG.
          {
            claim He1 : apply_fun efam12 alpha1 = eG.
            { exact (apply_fun_graph (UPair 0 1) (fun _:set => eG) alpha1 Hal1). }
            assume Heq1 : apply_fun xs12 1 = eG.
            apply Hx1ne.
            rewrite He1.
            exact Heq1.
          }

          (** Setup for the symmetric (max-G1) decomposition; proof pending. **)
          claim Hm_pack :
            exists m:set,
              m :e n /\ apply_fun xs m :e G1 /\
              (forall i:set, i :e n -> apply_fun xs i :e G1 -> i c= m) /\
              (forall i:set, i :e n -> ordsucc m c= i -> apply_fun xs i :e G2).
          {
            exact (cor68_6_max_G1_index_suffix_all_in_G2
              G multG eG invG G1 G2 J K Hfam efamH n xs
              Hgrp Hsub1 Hsub2 Hfp Hfp1 Hfp2
              Hred HallNe
              HexG1 HexG2).
          }
          apply Hm_pack. let m. assume Hm_pack0.
          apply (and4E
            (m :e n)
            (apply_fun xs m :e G1)
            (forall i:set, i :e n -> apply_fun xs i :e G1 -> i c= m)
            (forall i:set, i :e n -> ordsucc m c= i -> apply_fun xs i :e G2)
            Hm_pack0).
          assume Hm_in HymG1 Hm_maxG1 Hsuffix_all_G2.

          set n1 := ordsucc m.

          (** n is a natural number. **)
          claim HnO : n :e omega.
          {
            apply (and3E
              (n :e omega)
              (forall i:set, i :e n ->
                exists alpha:set, alpha :e J :\/: K /\
                  apply_fun xs i :e apply_fun Hfam alpha /\
                  apply_fun xs i <> apply_fun efamH alpha)
              (forall i:set, i :e n -> ordsucc i :e n ->
                forall alpha beta:set, alpha :e J :\/: K -> beta :e J :\/: K ->
                  apply_fun xs i :e apply_fun Hfam alpha ->
                  apply_fun xs (ordsucc i) :e apply_fun Hfam beta ->
                  alpha <> beta)
              Hred).
            assume HnO0 _ _. exact HnO0.
          }
          claim Hn_nat : nat_p n. { exact (omega_nat_p n HnO). }
          claim Hn_ord : ordinal n. { exact (nat_p_ordinal n Hn_nat). }
          claim HmO : m :e omega.
          {
            claim Hn_sub_omega : n c= omega.
            { exact (omega_TransSet n HnO). }
            exact (Hn_sub_omega m Hm_in).
          }
          claim Hm_nat : nat_p m. { exact (omega_nat_p m HmO). }

          (** Decompose n = n1 + n2. **)
          claim Hn1_nat : nat_p n1.
          { exact (nat_ordsucc m Hm_nat). }
          claim Hn1_sub_n : n1 c= n.
          { exact (ordinal_ordsucc_In_Subq n Hn_ord m Hm_in). }
          apply (nat_Subq_add_ex n1 Hn1_nat n Hn_nat Hn1_sub_n).
          let n2. assume Hn2_pack.
          claim Hn2_nat : nat_p n2.
          { exact (andEL (nat_p n2) (n = add_nat n2 n1) Hn2_pack). }
          claim Hn_eq' : n = add_nat n2 n1.
          { exact (andER (nat_p n2) (n = add_nat n2 n1) Hn2_pack). }
          claim Hn_eq : n = add_nat n1 n2.
          { rewrite Hn_eq'. rewrite (add_nat_com n2 Hn2_nat n1 Hn1_nat). reflexivity. }

          (** Prefix and suffix words. **)
          set xs1 := graph n1 (fun i:set => apply_fun xs i).
          set xs2 := graph n2 (fun i:set => apply_fun xs (add_nat n1 i)).
          claim Hred2 : reduced_word (J :\/: K) Hfam efamH n2 xs2.
          { exact (reduced_word_suffix_by_add_nat (J :\/: K) Hfam efamH n xs n1 n2 Hred Hn1_nat Hn2_nat Hn_eq). }
          claim HallNe2 : forall i:set, i :e n2 -> apply_fun xs2 i <> eG.
          {
            let i. assume Hi2.
            rewrite (apply_fun_graph n2 (fun t:set => apply_fun xs (add_nat n1 t)) i Hi2).
            claim Hin_sum : add_nat n1 i :e add_nat n1 n2.
            { exact (add_nat_In_L n1 Hn1_nat n2 Hn2_nat i Hi2). }
            claim Hin_n : add_nat n1 i :e n.
            { exact (eq_subst_mem_set (add_nat n1 i) (add_nat n1 n2) n Hin_sum (eq_symm n (add_nat n1 n2) Hn_eq)). }
            exact (HallNe (add_nat n1 i) Hin_n).
          }
          claim HallG2_2 : forall i:set, i :e n2 -> apply_fun xs2 i :e G2.
          {
            let i. assume Hi2.
            rewrite (apply_fun_graph n2 (fun t:set => apply_fun xs (add_nat n1 t)) i Hi2).
            claim Hin_sum : add_nat n1 i :e add_nat n1 n2.
            { exact (add_nat_In_L n1 Hn1_nat n2 Hn2_nat i Hi2). }
            claim Hin_n : add_nat n1 i :e n.
            { exact (eq_subst_mem_set (add_nat n1 i) (add_nat n1 n2) n Hin_sum (eq_symm n (add_nat n1 n2) Hn_eq)). }
            claim Hsub : n1 c= add_nat n1 i.
            { exact (add_nat_Subq_R' n1 Hn1_nat i (nat_p_trans n2 Hn2_nat i Hi2)). }
            exact (Hsuffix_all_G2 (add_nat n1 i) Hin_n Hsub).
          }

          (** Suffix product is nontrivial. **)
          claim Hn2_ne0 : n2 <> 0.
          {
            assume Hn20.
            (** Then n = ordsucc m, so xs ends in a G1-letter, contradicting alpha1 = 1. **)
            claim Hn_eq_sm : n = ordsucc m.
            {
              rewrite Hn_eq.
              rewrite Hn20.
              rewrite (add_nat_0R n1).
              reflexivity.
            }
            claim Hred_sm : reduced_word (J :\/: K) Hfam efamH (ordsucc m) xs.
            { rewrite <- Hn_eq_sm. exact Hred. }
            claim HallNe_sm : forall i:set, i :e ordsucc m -> apply_fun xs i <> eG.
            {
              let i. assume Hi.
              claim Hi_n : i :e n.
              { exact (eq_subst_mem_set i (ordsucc m) n Hi (eq_symm n (ordsucc m) Hn_eq_sm)). }
              exact (HallNe i Hi_n).
            }
            claim Hlast_m : apply_fun xs m :e apply_fun Gfam12 0.
            {
              rewrite (apply_fun_graph (UPair 0 1) (fun t:set => if t = 0 then G1 else G2) 0 (UPairI1 0 1)).
              rewrite (If_i_1 (0 = 0) G1 G2 (eq_refl 0)).
              exact HymG1.
            }
            claim Hcoll_last :
              exists nb xb kb:set,
                reduced_word (UPair 0 1) Gfam12 efam12 nb xb /\
                word_product multG eG xb nb = word_product multG eG xs (ordsucc m) /\
                nb <> 0 /\ nat_p kb /\ nb = ordsucc kb /\
                apply_fun xb kb :e apply_fun Gfam12 0.
            {
              exact (cor68_6_collapse_union_word_to_binary_end_in_factor
                G multG eG invG G1 G2 J K Hfam efamH m xs 0
                Hgrp Hsub1 Hsub2 Hfp Hfp1 Hfp2
                Hm_nat
                Hred_sm
                HallNe_sm
                (UPairI1 0 1)
                Hlast_m).
            }
            apply Hcoll_last. let nb. assume Hnb_pack.
            apply Hnb_pack. let xb. assume Hxb_pack.
            apply Hxb_pack. let kb. assume Hkb_pack.
            apply (and6E
              (reduced_word (UPair 0 1) Gfam12 efam12 nb xb)
              (word_product multG eG xb nb = word_product multG eG xs (ordsucc m))
              (nb <> 0)
              (nat_p kb)
              (nb = ordsucc kb)
              (apply_fun xb kb :e apply_fun Gfam12 0)
              Hkb_pack).
            assume Hredb Hwpb Hnb_ne0 Hkb_nat Hnb_eq Hlastb.
            claim Hwp_sm : word_product multG eG xs (ordsucc m) = x.
            { rewrite <- Hn_eq_sm. exact Hwp. }
            claim Hwpb_x : word_product multG eG xb nb = x.
            { exact (eq_i_tra (word_product multG eG xb nb) (word_product multG eG xs (ordsucc m)) x Hwpb Hwp_sm). }
            claim Huniqb :
              n12 = nb /\ (forall i0:set, i0 :e n12 -> apply_fun xs12 i0 = apply_fun xb i0).
            { exact (Huniq12 nb xb Hredb Hnb_ne0 Hwpb_x). }
            claim Hn12_eq_nb : n12 = nb.
            { exact (andEL (n12 = nb) (forall i0:set, i0 :e n12 -> apply_fun xs12 i0 = apply_fun xb i0) Huniqb). }
            claim Hpt : forall i0:set, i0 :e n12 -> apply_fun xs12 i0 = apply_fun xb i0.
            { exact (andER (n12 = nb) (forall i0:set, i0 :e n12 -> apply_fun xs12 i0 = apply_fun xb i0) Huniqb). }
            claim Hnb_2 : nb = 2.
            { exact (eq_i_tra nb n12 2 (eq_symm n12 nb Hn12_eq_nb) Hn12_2). }
            claim Hkb1 : kb = 1.
            {
              claim Hs : ordsucc kb = 2.
              { exact (eq_i_tra (ordsucc kb) nb 2 (eq_symm nb (ordsucc kb) Hnb_eq) Hnb_2). }
              claim Hs' : ordsucc kb = ordsucc 1.
              { exact (eq_i_tra (ordsucc kb) 2 (ordsucc 1) Hs (eq_symm (ordsucc 1) 2 ordsucc_1_eq_2_nat)). }
              exact (ordsucc_inj kb 1 Hs').
            }
            claim Hx12_1_eq : apply_fun xs12 1 = apply_fun xb 1.
            { exact (Hpt 1 H1in12). }
            claim Hxb1_inG1 : apply_fun xb 1 :e G1.
            {
              claim HGfam0 : apply_fun Gfam12 0 = G1.
              {
                rewrite (apply_fun_graph (UPair 0 1) (fun t:set => if t = 0 then G1 else G2) 0 (UPairI1 0 1)).
                exact (If_i_1 (0 = 0) G1 G2 (eq_refl 0)).
              }
              claim Hxb1_fam0 : apply_fun xb 1 :e apply_fun Gfam12 0.
              {
                claim Hxb1_eq : apply_fun xb 1 = apply_fun xb kb.
                { rewrite Hkb1. reflexivity. }
                exact (eq_subst_mem (apply_fun xb 1) (apply_fun xb kb) (apply_fun Gfam12 0) Hxb1_eq Hlastb).
              }
              exact (eq_subst_mem_set (apply_fun xb 1) (apply_fun Gfam12 0) G1 Hxb1_fam0 HGfam0).
            }
            claim Hx12_1_G1 : apply_fun xs12 1 :e G1.
            { exact (eq_subst_mem (apply_fun xs12 1) (apply_fun xb 1) G1 Hx12_1_eq Hxb1_inG1). }
            claim Hx12_1_e : apply_fun xs12 1 = eG.
            { exact (free_product_binary_factors_intersect_trivial
                G multG eG invG G1 G2 (apply_fun xs12 1) Hfp Hx12_1_G1 Hx1G2). }
            exact (Hx1neG Hx12_1_e).
          }

          claim Hsuf_ne : word_product multG eG xs2 n2 <> eG.
          {
            exact (cor68_6_reduced_word_all_in_G2_product_ne_eG
              G multG eG invG G1 G2 J K Hfam efamH n2 xs2
              Hgrp Hsub1 Hsub2 Hfp Hfp1 Hfp2
              Hred2 HallNe2 HallG2_2 Hn2_ne0).
          }

          (** Now show prefix letters are all in G1 (symmetric to the alpha1 = 0 case). **)
          (** n1 lies strictly before n since the suffix length n2 is nonzero. **)
          claim H0_in_n2 : 0 :e n2.
          {
            claim Hn2_succ : exists k2:set, n2 = ordsucc k2.
            { exact (Hnat_nonzero_succ n2 Hn2_nat Hn2_ne0). }
            apply Hn2_succ. let k2. assume Hn2_eq.
            claim Hk2_nat : nat_p k2.
            {
              claim Hk2_in : k2 :e n2.
              { rewrite Hn2_eq. exact (ordsuccI2 k2). }
              exact (nat_p_trans n2 Hn2_nat k2 Hk2_in).
            }
            rewrite Hn2_eq.
            exact (nat_0_in_ordsucc k2 Hk2_nat).
          }
          claim Hn1_in_n : n1 :e n.
          {
            claim Hn10_in_sum : add_nat n1 0 :e add_nat n1 n2.
            { exact (add_nat_In_L n1 Hn1_nat n2 Hn2_nat 0 H0_in_n2). }
            claim Hn1_in_sum : n1 :e add_nat n1 n2.
            { exact (eq_subst_mem_rev (add_nat n1 0) n1 (add_nat n1 n2) (add_nat_0R n1) Hn10_in_sum). }
            exact (eq_subst_mem_set n1 (add_nat n1 n2) n Hn1_in_sum (eq_symm n (add_nat n1 n2) Hn_eq)).
          }
          claim Hred1 : reduced_word (J :\/: K) Hfam efamH n1 xs1.
          { exact (reduced_word_prefix (J :\/: K) Hfam efamH n xs n1 Hred Hn1_in_n). }

          (** Prefix letters are all in G1 (otherwise we could build a longer binary reduced word for x). **)
          claim HallG1_1 : forall i:set, i :e n1 -> apply_fun xs1 i :e G1.
          {
            let i. assume Hi1.
            apply (Hside_union n1 xs1 Hred1 i Hi1).
            - assume HxiG1. exact HxiG1.
            - assume HxiG2.
              (** If some prefix letter lies in G2, then the prefix product is mixed and nontrivial,
                  hence gives a binary reduced word of length >= 2 ending in factor 0.
                  Appending the nontrivial suffix product in G2 yields a longer binary reduced word for x,
                  contradicting uniqueness of the binary normal form (n12 = 2). **)

              (** Nontriviality of suffix product (already established) and its side. **)
              set wp2 := word_product multG eG xs2 n2.
              claim Hwp2_ne : wp2 <> eG. { exact Hsuf_ne. }
              claim Hwp2_G2 : wp2 :e G2.
              { exact (Hword_product_in_G2 n2 xs2 Hred2 HallG2_2). }

              (** Split x into prefix and suffix products. **)
              claim HxsG_all : forall j:set, j :e n -> apply_fun xs j :e G.
              {
                let j. assume Hj.
                apply (Hside_union n xs Hred j Hj).
                - assume HjG1.
                  exact (subgroup_of_subset G1 G multG eG invG Hsub1 (apply_fun xs j) HjG1).
                - assume HjG2.
                  exact (subgroup_of_subset G2 G multG eG invG Hsub2 (apply_fun xs j) HjG2).
              }
              claim Hxs1G_all : forall j:set, j :e n1 -> apply_fun xs1 j :e G.
              {
                let j. assume Hj1.
                rewrite (apply_fun_graph n1 (fun t:set => apply_fun xs t) j Hj1).
                exact (HxsG_all j (Hn1_sub_n j Hj1)).
              }
              set wp1 := word_product multG eG xs1 n1.
              claim Hwp1_ne : wp1 <> eG.
              {
                assume Hwp1_e.
                (** Use word_product_split_by_add_nat on the full word to conclude x :e G2. **)
                claim Hsplit :
                  word_product multG eG xs n =
                    apply_fun multG (word_product multG eG xs n1, wp2).
                {
                  claim Hsplit0 :
                    word_product multG eG xs n =
                      apply_fun multG
                        (word_product multG eG xs n1,
                         word_product multG eG (graph n2 (fun t:set => apply_fun xs (add_nat n1 t))) n2).
                  {
                    exact (word_product_split_by_add_nat
                      G multG eG invG n xs n1 n2
                      Hgrp Hn1_nat Hn2_nat Hn_eq
                      HxsG_all).
                  }
                  rewrite Hsplit0.
                  reflexivity.
                }
                claim Hx_eq :
                  x = apply_fun multG (word_product multG eG xs n1, wp2).
                {
                  rewrite <- Hsplit.
                  exact (eq_symm (word_product multG eG xs n) x Hwp).
                }
                (** Since wp1 = word_product xs n1, rewrite the prefix product and simplify. **)
                claim Hwp1_eq :
                  word_product multG eG xs n1 = wp1.
                {
                  claim Hn1O : n1 :e omega. { exact (nat_p_omega n1 Hn1_nat). }
                  apply (nat_primrec_ext eG
                    (fun j r:set => apply_fun multG (r, apply_fun xs j))
                    (fun j r:set => apply_fun multG (r, apply_fun xs1 j))
                    n1
                    Hn1O).
                  let j r. assume Hj1.
                  rewrite (apply_fun_graph n1 (fun t:set => apply_fun xs t) j Hj1).
                  reflexivity.
                }
                claim Hx_eq2 :
                  x = apply_fun multG (wp1, wp2).
                {
                  claim Hmul_eq :
                    apply_fun multG (word_product multG eG xs n1, wp2) =
                      apply_fun multG (wp1, wp2).
                  { rewrite Hwp1_eq. reflexivity. }
                  exact (eq_i_tra
                    x
                    (apply_fun multG (word_product multG eG xs n1, wp2))
                    (apply_fun multG (wp1, wp2))
                    Hx_eq
                    Hmul_eq).
                }
                claim Hx_eq3 : x = apply_fun multG (eG, wp2).
                {
                  claim Hmul_eq :
                    apply_fun multG (wp1, wp2) = apply_fun multG (eG, wp2).
                  { rewrite Hwp1_e. reflexivity. }
                  exact (eq_i_tra
                    x
                    (apply_fun multG (wp1, wp2))
                    (apply_fun multG (eG, wp2))
                    Hx_eq2
                    Hmul_eq).
                }
                claim Hwp2_G : wp2 :e G.
                { exact (subgroup_of_subset G2 G multG eG invG Hsub2 wp2 Hwp2_G2). }
                claim HidL :
                  apply_fun multG (eG, wp2) = wp2.
                {
                  apply (and6E
                    (function_on multG (setprod G G) G)
                    (function_on invG G G)
                    (eG :e G)
                    (forall y z w:set, y :e G -> z :e G -> w :e G ->
                      apply_fun multG (apply_fun multG (y, z), w) =
                        apply_fun multG (y, apply_fun multG (z, w)))
                    (forall y:set, y :e G -> apply_fun multG (eG, y) = y /\ apply_fun multG (y, eG) = y)
                    (forall y:set, y :e G ->
                      apply_fun multG (y, apply_fun invG y) = eG /\
                      apply_fun multG (apply_fun invG y, y) = eG)
                    Hgrp).
                  assume _ _ _ _ Hid _.
                  exact (andEL
                    (apply_fun multG (eG, wp2) = wp2)
                    (apply_fun multG (wp2, eG) = wp2)
                    (Hid wp2 Hwp2_G)).
                }
                claim Hx_eq4 : x = wp2.
                { exact (eq_i_tra x (apply_fun multG (eG, wp2)) wp2 Hx_eq3 HidL). }
                claim HxG2 : x :e G2.
                { rewrite Hx_eq4. exact Hwp2_G2. }
                exact (Hx_not_G2 HxG2).
              }

              (** All prefix letters are nontrivial. **)
              claim HallNe1 : forall j:set, j :e n1 -> apply_fun xs1 j <> eG.
              {
                let j. assume Hj1.
                rewrite (apply_fun_graph n1 (fun t:set => apply_fun xs t) j Hj1).
                exact (HallNe j (Hn1_sub_n j Hj1)).
              }

              (** The prefix is mixed: it contains a G1-letter (at m) and a G2-letter (at i). **)
              claim Hm_in_n1 : m :e n1. { exact (ordsuccI2 m). }
              claim Hxm_G1 : apply_fun xs1 m :e G1.
              {
                rewrite (apply_fun_graph n1 (fun t:set => apply_fun xs t) m Hm_in_n1).
                exact HymG1.
              }
              claim HexG1_1 : exists j:set, j :e n1 /\ apply_fun xs1 j :e G1.
              { witness m. exact (andI (m :e n1) (apply_fun xs1 m :e G1) Hm_in_n1 Hxm_G1). }
              claim HexG2_1 : exists j:set, j :e n1 /\ apply_fun xs1 j :e G2.
              { witness i. exact (andI (i :e n1) (apply_fun xs1 i :e G2) Hi1 HxiG2). }

              (** Hence the prefix product is not in G1. **)
              claim Hwp1_notG1 : wp1 /:e G1.
              {
                exact (cor68_6_binary_collapse_mixed_not_in_G1
                  G multG eG invG G1 G2 J K Hfam efamH n1 xs1
                  Hgrp Hsub1 Hsub2 Hfp HJKdisj Hfp1 Hfp2
                  Hred1 HallNe1 Hwp1_ne
                  HexG1_1
                  HexG2_1).
              }

              (** Collapse the prefix to a binary reduced word ending in factor 0 (G1). **)
              claim Halpha0U : 0 :e (UPair 0 1). { exact (UPairI1 0 1). }
              claim Hlast_pref :
                apply_fun xs1 m :e apply_fun Gfam12 0.
              {
                rewrite (apply_fun_graph (UPair 0 1) (fun t:set => if t = 0 then G1 else G2) 0 (UPairI1 0 1)).
                rewrite (If_i_1 (0 = 0) G1 G2 (eq_refl 0)).
                exact Hxm_G1.
              }
              claim Hcoll_pref :
                exists np xb kp:set,
                  reduced_word (UPair 0 1) Gfam12 efam12 np xb /\
                  word_product multG eG xb np = wp1 /\
                  np <> 0 /\ nat_p kp /\ np = ordsucc kp /\
                  apply_fun xb kp :e apply_fun Gfam12 0.
              {
                exact (cor68_6_collapse_union_word_to_binary_end_in_factor
                  G multG eG invG G1 G2 J K Hfam efamH m xs1 0
                  Hgrp Hsub1 Hsub2 Hfp Hfp1 Hfp2
                  Hm_nat
                  Hred1
                  HallNe1
                  Halpha0U
                  Hlast_pref).
              }
              apply Hcoll_pref. let np. assume Hnp_pack.
              apply Hnp_pack. let xb. assume Hxb_pack.
              apply Hxb_pack. let kp. assume Hkp_pack.
              apply (and6E
                (reduced_word (UPair 0 1) Gfam12 efam12 np xb)
                (word_product multG eG xb np = wp1)
                (np <> 0)
                (nat_p kp)
                (np = ordsucc kp)
                (apply_fun xb kp :e apply_fun Gfam12 0)
                Hkp_pack).
              assume Hredb Hwpb Hnp_ne0 Hkp_nat Hnp_eq Hlastb.

              (** np is not 1: otherwise wp1 would lie in G1, contradicting Hwp1_notG1. **)
              claim Hnp_ne1 : np <> 1.
              {
                assume Hnp1.
                claim Hkp0 : kp = 0.
                {
                  claim Hs : ordsucc kp = ordsucc 0.
                  {
                    claim Hsk : ordsucc kp = 1.
                    { exact (eq_i_tra (ordsucc kp) np 1 (eq_symm np (ordsucc kp) Hnp_eq) Hnp1). }
                    exact (eq_i_tra (ordsucc kp) 1 (ordsucc 0) Hsk
                      (eq_symm (ordsucc 0) 1 ordsucc_0_eq_1_nat)).
                  }
                  exact (ordsucc_inj kp 0 Hs).
                }
                claim Hxb0_G1 : apply_fun xb 0 :e G1.
                {
                  claim Hxb0_eq : apply_fun xb 0 = apply_fun xb kp.
                  { rewrite Hkp0. reflexivity. }
                  claim HGfam0 : apply_fun Gfam12 0 = G1.
                  {
                    rewrite (apply_fun_graph (UPair 0 1) (fun t:set => if t = 0 then G1 else G2) 0 (UPairI1 0 1)).
                    exact (If_i_1 (0 = 0) G1 G2 (eq_refl 0)).
                  }
                  claim Hxbkp_G1 : apply_fun xb kp :e G1.
                  { exact (eq_subst_mem_set (apply_fun xb kp) (apply_fun Gfam12 0) G1 Hlastb HGfam0). }
                  exact (eq_subst_mem (apply_fun xb 0) (apply_fun xb kp) G1 Hxb0_eq Hxbkp_G1).
                }
                claim Hxb0_G : apply_fun xb 0 :e G.
                { exact (subgroup_of_subset G1 G multG eG invG Hsub1 (apply_fun xb 0) Hxb0_G1). }
                claim Hwp1_eq_xb0 : word_product multG eG xb np = apply_fun xb 0.
                {
                  claim Hwp1_1 : word_product multG eG xb 1 = apply_fun xb 0.
                  {
                    claim Hwp1S : word_product multG eG xb 1 =
                      apply_fun multG (word_product multG eG xb 0, apply_fun xb 0).
                    { exact (word_product_succ multG eG xb 0 nat_0). }
                    claim Hwp0 : word_product multG eG xb 0 = eG.
                    { exact (nat_primrec_0 eG (fun j r => apply_fun multG (r, apply_fun xb j))). }
                    claim HidL0 : apply_fun multG (eG, apply_fun xb 0) = apply_fun xb 0.
                    {
                      apply (and6E
                        (function_on multG (setprod G G) G)
                        (function_on invG G G)
                        (eG :e G)
                        (forall y z w:set, y :e G -> z :e G -> w :e G ->
                          apply_fun multG (apply_fun multG (y, z), w) =
                            apply_fun multG (y, apply_fun multG (z, w)))
                        (forall y:set, y :e G -> apply_fun multG (eG, y) = y /\ apply_fun multG (y, eG) = y)
                        (forall y:set, y :e G ->
                          apply_fun multG (y, apply_fun invG y) = eG /\
                          apply_fun multG (apply_fun invG y, y) = eG)
                        Hgrp).
                      assume _ _ _ _ Hid _.
                      exact (andEL
                        (apply_fun multG (eG, apply_fun xb 0) = apply_fun xb 0)
                        (apply_fun multG (apply_fun xb 0, eG) = apply_fun xb 0)
                        (Hid (apply_fun xb 0) Hxb0_G)).
                    }
                    rewrite Hwp1S. rewrite Hwp0. exact HidL0.
                  }
                  rewrite Hnp1.
                  exact Hwp1_1.
                }
                claim Hwp1_G1 : wp1 :e G1.
                {
                  rewrite <- Hwpb.
                  rewrite Hwp1_eq_xb0.
                  exact Hxb0_G1.
                }
                exact (Hwp1_notG1 Hwp1_G1).
              }

              (** Last letter of xb is nontrivial. **)
              claim Hkp_in_np : kp :e np.
              { rewrite Hnp_eq. exact (ordsuccI2 kp). }
              claim Hxb_last_ne : apply_fun xb kp <> eG.
              {
                exact (reduced_word_no_eG_all
                  G multG eG invG (UPair 0 1) Gfam12 efam12 np xb
                  Hgrp Hsubfam12 Hredb Hnp_ne0 Hnp_ne1 kp Hkp_in_np).
              }

              (** Append the suffix product (in factor 1) to the binary word for the prefix. **)
              claim Hwp2_inGfam1 : wp2 :e apply_fun Gfam12 1.
              {
                claim HGfam1 : apply_fun Gfam12 1 = G2.
                {
                  rewrite (apply_fun_graph (UPair 0 1) (fun t:set => if t = 0 then G1 else G2) 1 (UPairI2 0 1)).
                  exact (If_i_0 (1 = 0) G1 G2 neq_1_0).
                }
                exact (eq_subst_mem_set wp2 G2 (apply_fun Gfam12 1) Hwp2_G2 (eq_symm (apply_fun Gfam12 1) G2 HGfam1)).
              }
              claim Hred_ext :
                reduced_word (UPair 0 1) Gfam12 efam12 (ordsucc np)
                  (graph (ordsucc np) (fun j:set => if j :e np then apply_fun xb j else wp2)).
              {
                exact (binary_reduced_word_append_other_factor
                  G multG eG invG G1 G2 np xb wp2 1 0 kp
                  Hgrp Hfp
                  Hredb
                  Hkp_nat Hnp_eq
                  (UPairI1 0 1)
                  Hlastb
                  Hxb_last_ne
                  (UPairI2 0 1)
                  Hwp2_inGfam1
                  Hwp2_ne
                  neq_0_1).
              }

              (** Compute the product of the extended binary word. **)
              claim Hnp_nat : nat_p np.
              { rewrite Hnp_eq. exact (nat_ordsucc kp Hkp_nat). }
              claim HnpO : np :e omega. { exact (nat_p_omega np Hnp_nat). }
              claim Hwp_ext :
                word_product multG eG
                  (graph (ordsucc np) (fun j:set => if j :e np then apply_fun xb j else wp2))
                  (ordsucc np) =
                  apply_fun multG (wp1, wp2).
              {
                claim Hwp_app :
                  word_product multG eG
                    (graph (ordsucc np) (fun j:set => if j :e np then apply_fun xb j else wp2))
                    (ordsucc np) =
                    apply_fun multG (word_product multG eG xb np, wp2).
                { exact (word_product_append_one multG eG xb wp2 np HnpO). }
                rewrite Hwp_app.
                rewrite Hwpb.
                reflexivity.
              }
              claim Hx_eq_wp1wp2 : x = apply_fun multG (wp1, wp2).
              {
                claim Hsplit :
                  word_product multG eG xs n =
                    apply_fun multG (word_product multG eG xs n1, wp2).
                {
                  claim Hsplit0 :
                    word_product multG eG xs n =
                      apply_fun multG
                        (word_product multG eG xs n1,
                         word_product multG eG (graph n2 (fun t:set => apply_fun xs (add_nat n1 t))) n2).
                  {
                    exact (word_product_split_by_add_nat
                      G multG eG invG n xs n1 n2
                      Hgrp Hn1_nat Hn2_nat Hn_eq
                      HxsG_all).
                  }
                  rewrite Hsplit0.
                  reflexivity.
                }
                claim Hwp1_eq :
                  word_product multG eG xs n1 = wp1.
                {
                  claim Hn1O : n1 :e omega. { exact (nat_p_omega n1 Hn1_nat). }
                  apply (nat_primrec_ext eG
                    (fun j r:set => apply_fun multG (r, apply_fun xs j))
                    (fun j r:set => apply_fun multG (r, apply_fun xs1 j))
                    n1
                    Hn1O).
                  let j r. assume Hj1.
                  rewrite (apply_fun_graph n1 (fun t:set => apply_fun xs t) j Hj1).
                  reflexivity.
                }
                claim Hsplit' :
                  word_product multG eG xs n = apply_fun multG (wp1, wp2).
                {
                  claim Hmul_eq :
                    apply_fun multG (word_product multG eG xs n1, wp2) = apply_fun multG (wp1, wp2).
                  { rewrite Hwp1_eq. reflexivity. }
                  exact (eq_i_tra
                    (word_product multG eG xs n)
                    (apply_fun multG (word_product multG eG xs n1, wp2))
                    (apply_fun multG (wp1, wp2))
                    Hsplit
                    Hmul_eq).
                }
                rewrite <- Hsplit'.
                exact (eq_symm (word_product multG eG xs n) x Hwp).
              }
              claim Hwp_ext_x :
                word_product multG eG
                  (graph (ordsucc np) (fun j:set => if j :e np then apply_fun xb j else wp2))
                  (ordsucc np) = x.
              {
                exact (eq_i_tra
                  (word_product multG eG (graph (ordsucc np) (fun j:set => if j :e np then apply_fun xb j else wp2)) (ordsucc np))
                  (apply_fun multG (wp1, wp2))
                  x
                  Hwp_ext
                  (eq_symm x (apply_fun multG (wp1, wp2)) Hx_eq_wp1wp2)).
              }

              (** Uniqueness of the binary normal form forces n12 = ordsucc np, contradicting n12 = 2. **)
              claim Huniq_ext :
                n12 = ordsucc np /\
                (forall j:set, j :e n12 ->
                  apply_fun xs12 j =
                    apply_fun (graph (ordsucc np) (fun t:set => if t :e np then apply_fun xb t else wp2)) j).
              {
                exact (Huniq12 (ordsucc np)
                  (graph (ordsucc np) (fun t:set => if t :e np then apply_fun xb t else wp2))
                  Hred_ext
                  (neq_ordsucc_0 np)
                  Hwp_ext_x).
              }
              claim Hn12_eq : n12 = ordsucc np.
              {
                exact (andEL (n12 = ordsucc np)
                  (forall j:set, j :e n12 ->
                    apply_fun xs12 j =
                      apply_fun (graph (ordsucc np) (fun t:set => if t :e np then apply_fun xb t else wp2)) j)
                  Huniq_ext).
              }
              claim Hs2 : ordsucc np = 2.
              { exact (eq_i_tra (ordsucc np) n12 2 (eq_symm n12 (ordsucc np) Hn12_eq) Hn12_2). }
              claim Hnp1 : np = 1.
              {
                claim Hs1 : ordsucc np = ordsucc 1.
                { exact (eq_i_tra (ordsucc np) 2 (ordsucc 1) Hs2 (eq_symm (ordsucc 1) 2 ordsucc_1_eq_2_nat)). }
                exact (ordsucc_inj np 1 Hs1).
              }
              exact (FalseE (Hnp_ne1 Hnp1) (apply_fun xs1 i :e G1)).
          }

          (** Now compare the decompositions for xs and xs'. Proof pending. **)
          {
            (** Decompose xs' via maximal G1 index. **)
            apply (cor68_6_max_G1_index_suffix_all_in_G2
              G multG eG invG G1 G2 J K Hfam efamH n' xs'
              Hgrp Hsub1 Hsub2 Hfp Hfp1 Hfp2
              Hred' HallNe'
              HexG1' HexG2').
            let m'. assume Hm'_pack.
            apply (and4E
              (m' :e n')
              (apply_fun xs' m' :e G1)
              (forall i:set, i :e n' -> apply_fun xs' i :e G1 -> i c= m')
              (forall i:set, i :e n' -> ordsucc m' c= i -> apply_fun xs' i :e G2)
              Hm'_pack).
            assume Hm'_in Hym'G1 Hm'_maxG1 Hsuffix'_all_G2.

            set n1' := ordsucc m'.

            (** n' is a natural number. **)
            claim HnO' : n' :e omega.
            {
              apply (and3E
                (n' :e omega)
                (forall i:set, i :e n' ->
                  exists alpha:set, alpha :e J :\/: K /\
                    apply_fun xs' i :e apply_fun Hfam alpha /\
                    apply_fun xs' i <> apply_fun efamH alpha)
                (forall i:set, i :e n' -> ordsucc i :e n' ->
                  forall alpha beta:set, alpha :e J :\/: K -> beta :e J :\/: K ->
                    apply_fun xs' i :e apply_fun Hfam alpha ->
                    apply_fun xs' (ordsucc i) :e apply_fun Hfam beta ->
                    alpha <> beta)
                Hred').
              assume HnO0 _ _. exact HnO0.
            }
            claim Hn'_nat : nat_p n'. { exact (omega_nat_p n' HnO'). }
            claim Hn'_ord : ordinal n'. { exact (nat_p_ordinal n' Hn'_nat). }
            claim HmO' : m' :e omega.
            {
              claim Hn'_sub_omega : n' c= omega.
              { exact (omega_TransSet n' HnO'). }
              exact (Hn'_sub_omega m' Hm'_in).
            }
            claim Hm'_nat : nat_p m'. { exact (omega_nat_p m' HmO'). }

            (** Decompose n' = n1' + n2'. **)
            claim Hn1'_nat : nat_p n1'. { exact (nat_ordsucc m' Hm'_nat). }
            claim Hn1'_sub_n' : n1' c= n'.
            { exact (ordinal_ordsucc_In_Subq n' Hn'_ord m' Hm'_in). }
            apply (nat_Subq_add_ex n1' Hn1'_nat n' Hn'_nat Hn1'_sub_n').
            let n2'. assume Hn2'_pack.
            claim Hn2'_nat : nat_p n2'.
            { exact (andEL (nat_p n2') (n' = add_nat n2' n1') Hn2'_pack). }
            claim Hn'_eq' : n' = add_nat n2' n1'.
            { exact (andER (nat_p n2') (n' = add_nat n2' n1') Hn2'_pack). }
            claim Hn'_eq : n' = add_nat n1' n2'.
            { rewrite Hn'_eq'. rewrite (add_nat_com n2' Hn2'_nat n1' Hn1'_nat). reflexivity. }

            (** Prefix and suffix words for xs'. **)
            set xs1' := graph n1' (fun i:set => apply_fun xs' i).
            set xs2' := graph n2' (fun i:set => apply_fun xs' (add_nat n1' i)).

            claim Hred2' : reduced_word (J :\/: K) Hfam efamH n2' xs2'.
            { exact (reduced_word_suffix_by_add_nat (J :\/: K) Hfam efamH n' xs' n1' n2' Hred' Hn1'_nat Hn2'_nat Hn'_eq). }
            claim HallNe2' : forall i:set, i :e n2' -> apply_fun xs2' i <> eG.
            {
              let i. assume Hi2.
              rewrite (apply_fun_graph n2' (fun t:set => apply_fun xs' (add_nat n1' t)) i Hi2).
              claim Hin_sum : add_nat n1' i :e add_nat n1' n2'.
              { exact (add_nat_In_L n1' Hn1'_nat n2' Hn2'_nat i Hi2). }
              claim Hin_n' : add_nat n1' i :e n'.
              { exact (eq_subst_mem_set (add_nat n1' i) (add_nat n1' n2') n' Hin_sum (eq_symm n' (add_nat n1' n2') Hn'_eq)). }
              exact (HallNe' (add_nat n1' i) Hin_n').
            }
            claim HallG2_2' : forall i:set, i :e n2' -> apply_fun xs2' i :e G2.
            {
              let i. assume Hi2.
              rewrite (apply_fun_graph n2' (fun t:set => apply_fun xs' (add_nat n1' t)) i Hi2).
              claim Hin_sum : add_nat n1' i :e add_nat n1' n2'.
              { exact (add_nat_In_L n1' Hn1'_nat n2' Hn2'_nat i Hi2). }
              claim Hin_n' : add_nat n1' i :e n'.
              { exact (eq_subst_mem_set (add_nat n1' i) (add_nat n1' n2') n' Hin_sum (eq_symm n' (add_nat n1' n2') Hn'_eq)). }
              claim Hsub : n1' c= add_nat n1' i.
              { exact (add_nat_Subq_R' n1' Hn1'_nat i (nat_p_trans n2' Hn2'_nat i Hi2)). }
              exact (Hsuffix'_all_G2 (add_nat n1' i) Hin_n' Hsub).
            }

            (** Suffix length is nonzero, else the binary normal form would end in factor 0. **)
            claim Hn2'_ne0 : n2' <> 0.
            {
              assume Hn2'0.
              claim Hn'_eq_sm : n' = ordsucc m'.
              {
                rewrite Hn'_eq.
                rewrite Hn2'0.
                rewrite (add_nat_0R n1').
                reflexivity.
              }
              claim Hred_sm : reduced_word (J :\/: K) Hfam efamH (ordsucc m') xs'.
              { rewrite <- Hn'_eq_sm. exact Hred'. }
              claim HallNe_sm : forall i:set, i :e ordsucc m' -> apply_fun xs' i <> eG.
              {
                let i. assume Hi.
                claim Hi_n' : i :e n'.
                { exact (eq_subst_mem_set i (ordsucc m') n' Hi (eq_symm n' (ordsucc m') Hn'_eq_sm)). }
                exact (HallNe' i Hi_n').
              }
              claim Hlast_m : apply_fun xs' m' :e apply_fun Gfam12 0.
              {
                rewrite (apply_fun_graph (UPair 0 1) (fun t:set => if t = 0 then G1 else G2) 0 (UPairI1 0 1)).
                rewrite (If_i_1 (0 = 0) G1 G2 (eq_refl 0)).
                exact Hym'G1.
              }
              claim Hcoll_last :
                exists nb xb kb:set,
                  reduced_word (UPair 0 1) Gfam12 efam12 nb xb /\
                  word_product multG eG xb nb = word_product multG eG xs' (ordsucc m') /\
                  nb <> 0 /\ nat_p kb /\ nb = ordsucc kb /\
                  apply_fun xb kb :e apply_fun Gfam12 0.
              {
                exact (cor68_6_collapse_union_word_to_binary_end_in_factor
                  G multG eG invG G1 G2 J K Hfam efamH m' xs' 0
                  Hgrp Hsub1 Hsub2 Hfp Hfp1 Hfp2
                  Hm'_nat
                  Hred_sm
                  HallNe_sm
                  (UPairI1 0 1)
                  Hlast_m).
              }
              apply Hcoll_last. let nb. assume Hnb_pack.
              apply Hnb_pack. let xb. assume Hxb_pack.
              apply Hxb_pack. let kb. assume Hkb_pack.
              apply (and6E
                (reduced_word (UPair 0 1) Gfam12 efam12 nb xb)
                (word_product multG eG xb nb = word_product multG eG xs' (ordsucc m'))
                (nb <> 0)
                (nat_p kb)
                (nb = ordsucc kb)
                (apply_fun xb kb :e apply_fun Gfam12 0)
                Hkb_pack).
              assume Hredb Hwpb Hnb_ne0 Hkb_nat Hnb_eq Hlastb.
              claim Hwp_sm : word_product multG eG xs' (ordsucc m') = x.
              { rewrite <- Hn'_eq_sm. exact Hwp'. }
              claim Hwpb_x : word_product multG eG xb nb = x.
              { exact (eq_i_tra (word_product multG eG xb nb) (word_product multG eG xs' (ordsucc m')) x Hwpb Hwp_sm). }
              claim Huniqb :
                n12 = nb /\ (forall i0:set, i0 :e n12 -> apply_fun xs12 i0 = apply_fun xb i0).
              { exact (Huniq12 nb xb Hredb Hnb_ne0 Hwpb_x). }
              claim Hn12_eq_nb : n12 = nb.
              { exact (andEL (n12 = nb) (forall i0:set, i0 :e n12 -> apply_fun xs12 i0 = apply_fun xb i0) Huniqb). }
              claim Hpt : forall i0:set, i0 :e n12 -> apply_fun xs12 i0 = apply_fun xb i0.
              { exact (andER (n12 = nb) (forall i0:set, i0 :e n12 -> apply_fun xs12 i0 = apply_fun xb i0) Huniqb). }
              claim Hnb_2 : nb = 2.
              { exact (eq_i_tra nb n12 2 (eq_symm n12 nb Hn12_eq_nb) Hn12_2). }
              claim Hkb1 : kb = 1.
              {
                claim Hs : ordsucc kb = 2.
                { exact (eq_i_tra (ordsucc kb) nb 2 (eq_symm nb (ordsucc kb) Hnb_eq) Hnb_2). }
                claim Hs' : ordsucc kb = ordsucc 1.
                { exact (eq_i_tra (ordsucc kb) 2 (ordsucc 1) Hs (eq_symm (ordsucc 1) 2 ordsucc_1_eq_2_nat)). }
                exact (ordsucc_inj kb 1 Hs').
              }
              claim Hx12_1_eq : apply_fun xs12 1 = apply_fun xb 1.
              { exact (Hpt 1 H1in12). }
              claim Hxb1_inG1 : apply_fun xb 1 :e G1.
              {
                claim HGfam0 : apply_fun Gfam12 0 = G1.
                {
                  rewrite (apply_fun_graph (UPair 0 1) (fun t:set => if t = 0 then G1 else G2) 0 (UPairI1 0 1)).
                  exact (If_i_1 (0 = 0) G1 G2 (eq_refl 0)).
                }
                claim Hxb1_fam0 : apply_fun xb 1 :e apply_fun Gfam12 0.
                {
                  claim Hxb1_eq : apply_fun xb 1 = apply_fun xb kb.
                  { rewrite Hkb1. reflexivity. }
                  exact (eq_subst_mem (apply_fun xb 1) (apply_fun xb kb) (apply_fun Gfam12 0) Hxb1_eq Hlastb).
                }
                exact (eq_subst_mem_set (apply_fun xb 1) (apply_fun Gfam12 0) G1 Hxb1_fam0 HGfam0).
              }
              claim Hx12_1_G1 : apply_fun xs12 1 :e G1.
              { exact (eq_subst_mem (apply_fun xs12 1) (apply_fun xb 1) G1 Hx12_1_eq Hxb1_inG1). }
              claim Hx12_1_e : apply_fun xs12 1 = eG.
              { exact (free_product_binary_factors_intersect_trivial
                  G multG eG invG G1 G2 (apply_fun xs12 1) Hfp Hx12_1_G1 Hx1G2). }
              exact (Hx1neG Hx12_1_e).
            }

            (** Suffix product is nontrivial. **)
            claim Hn1'_in_n' : n1' :e n'.
            {
              claim H0_in_n2' : 0 :e n2'.
              {
                claim Hn2'_succ : exists k2:set, n2' = ordsucc k2.
                { exact (Hnat_nonzero_succ n2' Hn2'_nat Hn2'_ne0). }
                apply Hn2'_succ. let k2. assume Hn2'_eq.
                claim Hk2_nat : nat_p k2.
                {
                  claim Hk2_in : k2 :e n2'.
                  { rewrite Hn2'_eq. exact (ordsuccI2 k2). }
                  exact (nat_p_trans n2' Hn2'_nat k2 Hk2_in).
                }
                rewrite Hn2'_eq.
                exact (nat_0_in_ordsucc k2 Hk2_nat).
              }
              claim Hn10_in_sum : add_nat n1' 0 :e add_nat n1' n2'.
              { exact (add_nat_In_L n1' Hn1'_nat n2' Hn2'_nat 0 H0_in_n2'). }
              claim Hn1_in_sum : n1' :e add_nat n1' n2'.
              { exact (eq_subst_mem_rev (add_nat n1' 0) n1' (add_nat n1' n2') (add_nat_0R n1') Hn10_in_sum). }
              exact (eq_subst_mem_set n1' (add_nat n1' n2') n' Hn1_in_sum (eq_symm n' (add_nat n1' n2') Hn'_eq)).
            }
            claim Hred1' : reduced_word (J :\/: K) Hfam efamH n1' xs1'.
            { exact (reduced_word_prefix (J :\/: K) Hfam efamH n' xs' n1' Hred' Hn1'_in_n'). }
            claim Hsuf_ne' : word_product multG eG xs2' n2' <> eG.
            {
              exact (cor68_6_reduced_word_all_in_G2_product_ne_eG
                G multG eG invG G1 G2 J K Hfam efamH n2' xs2'
                Hgrp Hsub1 Hsub2 Hfp Hfp1 Hfp2
                Hred2' HallNe2' HallG2_2' Hn2'_ne0).
            }

            (** Prefix letters of xs' are all in G1 (same argument as for xs). **)
            claim HallG1_1' : forall i:set, i :e n1' -> apply_fun xs1' i :e G1.
            {
              let i. assume Hi1.
              apply (Hside_union n1' xs1' Hred1' i Hi1).
              - assume HxiG1. exact HxiG1.
              - assume HxiG2.
                (** If some prefix letter lies in G2, then the prefix product is mixed and nontrivial,
                    hence gives a binary reduced word of length >= 2 ending in factor 0.
                    Appending the nontrivial suffix product in G2 yields a longer binary reduced word for x,
                    contradicting uniqueness of the binary normal form (n12 = 2). **)

                (** Nontriviality of suffix product (already established) and its side. **)
                set wp2' := word_product multG eG xs2' n2'.
                claim Hwp2'_ne : wp2' <> eG. { exact Hsuf_ne'. }
                claim Hwp2'_G2 : wp2' :e G2.
                { exact (Hword_product_in_G2 n2' xs2' Hred2' HallG2_2'). }

                (** Split x into prefix and suffix products. **)
                claim HxsG_all' : forall j:set, j :e n' -> apply_fun xs' j :e G.
                {
                  let j. assume Hj.
                  apply (Hside_union n' xs' Hred' j Hj).
                  - assume HjG1.
                    exact (subgroup_of_subset G1 G multG eG invG Hsub1 (apply_fun xs' j) HjG1).
                  - assume HjG2.
                    exact (subgroup_of_subset G2 G multG eG invG Hsub2 (apply_fun xs' j) HjG2).
                }
                claim Hxs1G_all' : forall j:set, j :e n1' -> apply_fun xs1' j :e G.
                {
                  let j. assume Hj1.
                  rewrite (apply_fun_graph n1' (fun t:set => apply_fun xs' t) j Hj1).
                  exact (HxsG_all' j (Hn1'_sub_n' j Hj1)).
                }
                set wp1' := word_product multG eG xs1' n1'.
                claim Hwp1'_ne : wp1' <> eG.
                {
                  assume Hwp1'_e.
                  (** Use word_product_split_by_add_nat on the full word to conclude x :e G2. **)
                  claim Hsplit :
                    word_product multG eG xs' n' =
                      apply_fun multG (word_product multG eG xs' n1', wp2').
                  {
                    claim Hsplit0 :
                      word_product multG eG xs' n' =
                        apply_fun multG
                          (word_product multG eG xs' n1',
                           word_product multG eG (graph n2' (fun t:set => apply_fun xs' (add_nat n1' t))) n2').
                    {
                      exact (word_product_split_by_add_nat
                        G multG eG invG n' xs' n1' n2'
                        Hgrp Hn1'_nat Hn2'_nat Hn'_eq
                        HxsG_all').
                    }
                    rewrite Hsplit0.
                    reflexivity.
                  }
                  claim Hx_eq :
                    x = apply_fun multG (word_product multG eG xs' n1', wp2').
                  {
                    rewrite <- Hsplit.
                    exact (eq_symm (word_product multG eG xs' n') x Hwp').
                  }
                  (** Since wp1' = word_product xs' n1', rewrite the prefix product and simplify. **)
                  claim Hwp1'_eq :
                    word_product multG eG xs' n1' = wp1'.
                  {
                    claim Hn1O : n1' :e omega. { exact (nat_p_omega n1' Hn1'_nat). }
                    apply (nat_primrec_ext eG
                      (fun j r:set => apply_fun multG (r, apply_fun xs' j))
                      (fun j r:set => apply_fun multG (r, apply_fun xs1' j))
                      n1'
                      Hn1O).
                    let j r. assume Hj1.
                    rewrite (apply_fun_graph n1' (fun t:set => apply_fun xs' t) j Hj1).
                    reflexivity.
                  }
                  claim Hx_eq2 :
                    x = apply_fun multG (wp1', wp2').
                  {
                    claim Hmul_eq :
                      apply_fun multG (word_product multG eG xs' n1', wp2') =
                        apply_fun multG (wp1', wp2').
                    { rewrite Hwp1'_eq. reflexivity. }
                    exact (eq_i_tra
                      x
                      (apply_fun multG (word_product multG eG xs' n1', wp2'))
                      (apply_fun multG (wp1', wp2'))
                      Hx_eq
                      Hmul_eq).
                  }
                  claim Hx_eq3 : x = apply_fun multG (eG, wp2').
                  {
                    claim Hmul_eq :
                      apply_fun multG (wp1', wp2') = apply_fun multG (eG, wp2').
                    { rewrite Hwp1'_e. reflexivity. }
                    exact (eq_i_tra
                      x
                      (apply_fun multG (wp1', wp2'))
                      (apply_fun multG (eG, wp2'))
                      Hx_eq2
                      Hmul_eq).
                  }
                  claim Hwp2'_G : wp2' :e G.
                  { exact (subgroup_of_subset G2 G multG eG invG Hsub2 wp2' Hwp2'_G2). }
                  claim HidL :
                    apply_fun multG (eG, wp2') = wp2'.
                  {
                    apply (and6E
                      (function_on multG (setprod G G) G)
                      (function_on invG G G)
                      (eG :e G)
                      (forall y z w:set, y :e G -> z :e G -> w :e G ->
                        apply_fun multG (apply_fun multG (y, z), w) =
                          apply_fun multG (y, apply_fun multG (z, w)))
                      (forall y:set, y :e G -> apply_fun multG (eG, y) = y /\ apply_fun multG (y, eG) = y)
                      (forall y:set, y :e G ->
                        apply_fun multG (y, apply_fun invG y) = eG /\
                        apply_fun multG (apply_fun invG y, y) = eG)
                      Hgrp).
                    assume _ _ _ _ Hid _.
                    exact (andEL
                      (apply_fun multG (eG, wp2') = wp2')
                      (apply_fun multG (wp2', eG) = wp2')
                      (Hid wp2' Hwp2'_G)).
                  }
                  claim Hx_eq4 : x = wp2'.
                  { exact (eq_i_tra x (apply_fun multG (eG, wp2')) wp2' Hx_eq3 HidL). }
                  claim HxG2 : x :e G2.
                  { rewrite Hx_eq4. exact Hwp2'_G2. }
                  exact (Hx_not_G2 HxG2).
                }

                (** All prefix letters are nontrivial. **)
                claim HallNe1' : forall j:set, j :e n1' -> apply_fun xs1' j <> eG.
                {
                  let j. assume Hj1.
                  rewrite (apply_fun_graph n1' (fun t:set => apply_fun xs' t) j Hj1).
                  exact (HallNe' j (Hn1'_sub_n' j Hj1)).
                }

                (** The prefix is mixed: it contains a G1-letter (at m') and a G2-letter (at i). **)
                claim Hm'_in_n1' : m' :e n1'. { exact (ordsuccI2 m'). }
                claim Hxm'_G1 : apply_fun xs1' m' :e G1.
                {
                  rewrite (apply_fun_graph n1' (fun t:set => apply_fun xs' t) m' Hm'_in_n1').
                  exact Hym'G1.
                }
                claim HexG1_1' : exists j:set, j :e n1' /\ apply_fun xs1' j :e G1.
                { witness m'. exact (andI (m' :e n1') (apply_fun xs1' m' :e G1) Hm'_in_n1' Hxm'_G1). }
                claim HexG2_1' : exists j:set, j :e n1' /\ apply_fun xs1' j :e G2.
                { witness i. exact (andI (i :e n1') (apply_fun xs1' i :e G2) Hi1 HxiG2). }

                (** Hence the prefix product is not in G1. **)
                claim Hwp1'_notG1 : wp1' /:e G1.
                {
                  exact (cor68_6_binary_collapse_mixed_not_in_G1
                    G multG eG invG G1 G2 J K Hfam efamH n1' xs1'
                    Hgrp Hsub1 Hsub2 Hfp HJKdisj Hfp1 Hfp2
                    Hred1' HallNe1' Hwp1'_ne
                    HexG1_1'
                    HexG2_1').
                }

                (** Collapse the prefix to a binary reduced word ending in factor 0 (G1). **)
                claim Halpha0U : 0 :e (UPair 0 1). { exact (UPairI1 0 1). }
                claim Hlast_pref :
                  apply_fun xs1' m' :e apply_fun Gfam12 0.
                {
                  rewrite (apply_fun_graph (UPair 0 1) (fun t:set => if t = 0 then G1 else G2) 0 (UPairI1 0 1)).
                  rewrite (If_i_1 (0 = 0) G1 G2 (eq_refl 0)).
                  exact Hxm'_G1.
                }
                claim Hcoll_pref :
                  exists np xb kp:set,
                    reduced_word (UPair 0 1) Gfam12 efam12 np xb /\
                    word_product multG eG xb np = wp1' /\
                    np <> 0 /\ nat_p kp /\ np = ordsucc kp /\
                    apply_fun xb kp :e apply_fun Gfam12 0.
                {
                  exact (cor68_6_collapse_union_word_to_binary_end_in_factor
                    G multG eG invG G1 G2 J K Hfam efamH m' xs1' 0
                    Hgrp Hsub1 Hsub2 Hfp Hfp1 Hfp2
                    Hm'_nat
                    Hred1'
                    HallNe1'
                    Halpha0U
                    Hlast_pref).
                }
                apply Hcoll_pref. let np. assume Hnp_pack.
                apply Hnp_pack. let xb. assume Hxb_pack.
                apply Hxb_pack. let kp. assume Hkp_pack.
                apply (and6E
                  (reduced_word (UPair 0 1) Gfam12 efam12 np xb)
                  (word_product multG eG xb np = wp1')
                  (np <> 0)
                  (nat_p kp)
                  (np = ordsucc kp)
                  (apply_fun xb kp :e apply_fun Gfam12 0)
                  Hkp_pack).
                assume Hredb Hwpb Hnp_ne0 Hkp_nat Hnp_eq Hlastb.

                (** np is not 1: otherwise wp1' would lie in G1, contradicting Hwp1'_notG1. **)
                claim Hnp_ne1 : np <> 1.
                {
                  assume Hnp1.
                  claim Hkp0 : kp = 0.
                  {
                    claim Hs : ordsucc kp = ordsucc 0.
                    {
                      claim Hsk : ordsucc kp = 1.
                      { exact (eq_i_tra (ordsucc kp) np 1 (eq_symm np (ordsucc kp) Hnp_eq) Hnp1). }
                      exact (eq_i_tra (ordsucc kp) 1 (ordsucc 0) Hsk
                        (eq_symm (ordsucc 0) 1 ordsucc_0_eq_1_nat)).
                    }
                    exact (ordsucc_inj kp 0 Hs).
                  }
                  claim Hxb0_G1 : apply_fun xb 0 :e G1.
                  {
                    claim Hxb0_eq : apply_fun xb 0 = apply_fun xb kp.
                    { rewrite Hkp0. reflexivity. }
                    claim HGfam0 : apply_fun Gfam12 0 = G1.
                    {
                      rewrite (apply_fun_graph (UPair 0 1) (fun t:set => if t = 0 then G1 else G2) 0 (UPairI1 0 1)).
                      exact (If_i_1 (0 = 0) G1 G2 (eq_refl 0)).
                    }
                    claim Hxbkp_G1 : apply_fun xb kp :e G1.
                    { exact (eq_subst_mem_set (apply_fun xb kp) (apply_fun Gfam12 0) G1 Hlastb HGfam0). }
                    exact (eq_subst_mem (apply_fun xb 0) (apply_fun xb kp) G1 Hxb0_eq Hxbkp_G1).
                  }
                  claim Hxb0_G : apply_fun xb 0 :e G.
                  { exact (subgroup_of_subset G1 G multG eG invG Hsub1 (apply_fun xb 0) Hxb0_G1). }
                  claim Hwp1'_eq_xb0 : word_product multG eG xb np = apply_fun xb 0.
                  {
                    claim Hwp1_1 : word_product multG eG xb 1 = apply_fun xb 0.
                    {
                      claim Hwp1S : word_product multG eG xb 1 =
                        apply_fun multG (word_product multG eG xb 0, apply_fun xb 0).
                      { exact (word_product_succ multG eG xb 0 nat_0). }
                      claim Hwp0 : word_product multG eG xb 0 = eG.
                      { exact (nat_primrec_0 eG (fun j r => apply_fun multG (r, apply_fun xb j))). }
                      claim HidL0 : apply_fun multG (eG, apply_fun xb 0) = apply_fun xb 0.
                      {
                        apply (and6E
                          (function_on multG (setprod G G) G)
                          (function_on invG G G)
                          (eG :e G)
                          (forall y z w:set, y :e G -> z :e G -> w :e G ->
                            apply_fun multG (apply_fun multG (y, z), w) =
                              apply_fun multG (y, apply_fun multG (z, w)))
                          (forall y:set, y :e G -> apply_fun multG (eG, y) = y /\ apply_fun multG (y, eG) = y)
                          (forall y:set, y :e G ->
                            apply_fun multG (y, apply_fun invG y) = eG /\
                            apply_fun multG (apply_fun invG y, y) = eG)
                          Hgrp).
                        assume _ _ _ _ Hid _.
                        exact (andEL
                          (apply_fun multG (eG, apply_fun xb 0) = apply_fun xb 0)
                          (apply_fun multG (apply_fun xb 0, eG) = apply_fun xb 0)
                          (Hid (apply_fun xb 0) Hxb0_G)).
                      }
                      rewrite Hwp1S. rewrite Hwp0. exact HidL0.
                    }
                    rewrite Hnp1.
                    exact Hwp1_1.
                  }
                  claim Hwp1'_G1 : wp1' :e G1.
                  {
                    rewrite <- Hwpb.
                    rewrite Hwp1'_eq_xb0.
                    exact Hxb0_G1.
                  }
                  exact (Hwp1'_notG1 Hwp1'_G1).
                }

                (** Last letter of xb is nontrivial. **)
                claim Hkp_in_np : kp :e np.
                { rewrite Hnp_eq. exact (ordsuccI2 kp). }
                claim Hxb_last_ne : apply_fun xb kp <> eG.
                {
                  exact (reduced_word_no_eG_all
                    G multG eG invG (UPair 0 1) Gfam12 efam12 np xb
                    Hgrp Hsubfam12 Hredb Hnp_ne0 Hnp_ne1 kp Hkp_in_np).
                }

                (** Append the suffix product (in factor 1) to the binary word for the prefix. **)
                claim Hwp2_inGfam1 : wp2' :e apply_fun Gfam12 1.
                {
                  claim HGfam1 : apply_fun Gfam12 1 = G2.
                  {
                    rewrite (apply_fun_graph (UPair 0 1) (fun t:set => if t = 0 then G1 else G2) 1 (UPairI2 0 1)).
                    exact (If_i_0 (1 = 0) G1 G2 neq_1_0).
                  }
                  exact (eq_subst_mem_set wp2' G2 (apply_fun Gfam12 1) Hwp2'_G2 (eq_symm (apply_fun Gfam12 1) G2 HGfam1)).
                }
                claim Hred_ext :
                  reduced_word (UPair 0 1) Gfam12 efam12 (ordsucc np)
                    (graph (ordsucc np) (fun j:set => if j :e np then apply_fun xb j else wp2')).
                {
                  exact (binary_reduced_word_append_other_factor
                    G multG eG invG G1 G2 np xb wp2' 1 0 kp
                    Hgrp Hfp
                    Hredb
                    Hkp_nat Hnp_eq
                    (UPairI1 0 1)
                    Hlastb
                    Hxb_last_ne
                    (UPairI2 0 1)
                    Hwp2_inGfam1
                    Hwp2'_ne
                    neq_0_1).
                }

                (** Compute the product of the extended binary word. **)
                claim Hnp_nat : nat_p np.
                { rewrite Hnp_eq. exact (nat_ordsucc kp Hkp_nat). }
                claim HnpO : np :e omega. { exact (nat_p_omega np Hnp_nat). }
                claim Hwp_ext :
                  word_product multG eG
                    (graph (ordsucc np) (fun j:set => if j :e np then apply_fun xb j else wp2'))
                    (ordsucc np) =
                    apply_fun multG (wp1', wp2').
                {
                  claim Hwp_app :
                    word_product multG eG
                      (graph (ordsucc np) (fun j:set => if j :e np then apply_fun xb j else wp2'))
                      (ordsucc np) =
                      apply_fun multG (word_product multG eG xb np, wp2').
                  { exact (word_product_append_one multG eG xb wp2' np HnpO). }
                  rewrite Hwp_app.
                  rewrite Hwpb.
                  reflexivity.
                }
                claim Hx_eq_wp1wp2 : x = apply_fun multG (wp1', wp2').
                {
                  claim Hsplit :
                    word_product multG eG xs' n' =
                      apply_fun multG (word_product multG eG xs' n1', wp2').
                  {
                    claim Hsplit0 :
                      word_product multG eG xs' n' =
                        apply_fun multG
                          (word_product multG eG xs' n1',
                           word_product multG eG (graph n2' (fun t:set => apply_fun xs' (add_nat n1' t))) n2').
                    {
                      exact (word_product_split_by_add_nat
                        G multG eG invG n' xs' n1' n2'
                        Hgrp Hn1'_nat Hn2'_nat Hn'_eq
                        HxsG_all').
                    }
                    rewrite Hsplit0.
                    reflexivity.
                  }
                  claim Hwp1_eq :
                    word_product multG eG xs' n1' = wp1'.
                  {
                    claim Hn1O : n1' :e omega. { exact (nat_p_omega n1' Hn1'_nat). }
                    apply (nat_primrec_ext eG
                      (fun j r:set => apply_fun multG (r, apply_fun xs' j))
                      (fun j r:set => apply_fun multG (r, apply_fun xs1' j))
                      n1'
                      Hn1O).
                    let j r. assume Hj1.
                    rewrite (apply_fun_graph n1' (fun t:set => apply_fun xs' t) j Hj1).
                    reflexivity.
                  }
                  claim Hsplit' :
                    word_product multG eG xs' n' = apply_fun multG (wp1', wp2').
                  {
                    claim Hmul_eq :
                      apply_fun multG (word_product multG eG xs' n1', wp2') = apply_fun multG (wp1', wp2').
                    { rewrite Hwp1_eq. reflexivity. }
                    exact (eq_i_tra
                      (word_product multG eG xs' n')
                      (apply_fun multG (word_product multG eG xs' n1', wp2'))
                      (apply_fun multG (wp1', wp2'))
                      Hsplit
                      Hmul_eq).
                  }
                  rewrite <- Hsplit'.
                  exact (eq_symm (word_product multG eG xs' n') x Hwp').
                }
                claim Hwp_ext_x :
                  word_product multG eG
                    (graph (ordsucc np) (fun j:set => if j :e np then apply_fun xb j else wp2'))
                    (ordsucc np) = x.
                {
                  exact (eq_i_tra
                    (word_product multG eG (graph (ordsucc np) (fun j:set => if j :e np then apply_fun xb j else wp2')) (ordsucc np))
                    (apply_fun multG (wp1', wp2'))
                    x
                    Hwp_ext
                    (eq_symm x (apply_fun multG (wp1', wp2')) Hx_eq_wp1wp2)).
                }

                (** Uniqueness of the binary normal form forces n12 = ordsucc np, contradicting n12 = 2. **)
                claim Huniq_ext :
                  n12 = ordsucc np /\
                  (forall j:set, j :e n12 ->
                    apply_fun xs12 j =
                      apply_fun (graph (ordsucc np) (fun t:set => if t :e np then apply_fun xb t else wp2')) j).
                {
                  exact (Huniq12 (ordsucc np)
                    (graph (ordsucc np) (fun t:set => if t :e np then apply_fun xb t else wp2'))
                    Hred_ext
                    (neq_ordsucc_0 np)
                    Hwp_ext_x).
                }
                claim Hn12_eq : n12 = ordsucc np.
                {
                  exact (andEL (n12 = ordsucc np)
                    (forall j:set, j :e n12 ->
                      apply_fun xs12 j =
                        apply_fun (graph (ordsucc np) (fun t:set => if t :e np then apply_fun xb t else wp2')) j)
                    Huniq_ext).
                }
                claim Hs2 : ordsucc np = 2.
                { exact (eq_i_tra (ordsucc np) n12 2 (eq_symm n12 (ordsucc np) Hn12_eq) Hn12_2). }
                claim Hnp1 : np = 1.
                {
                  claim Hs1 : ordsucc np = ordsucc 1.
                  { exact (eq_i_tra (ordsucc np) 2 (ordsucc 1) Hs2 (eq_symm (ordsucc 1) 2 ordsucc_1_eq_2_nat)). }
                  exact (ordsucc_inj np 1 Hs1).
                }
                exact (FalseE (Hnp_ne1 Hnp1) (apply_fun xs1' i :e G1)).
            }

            (** Remaining comparison proof. **)
            (** Identify prefix/suffix products using binary normal form uniqueness, then use uniqueness in G1 and G2. **)
            set wp1 := word_product multG eG xs1 n1.
            set wp2 := word_product multG eG xs2 n2.
            set wp1' := word_product multG eG xs1' n1'.
            set wp2' := word_product multG eG xs2' n2'.

            claim Hwp1_G1 : wp1 :e G1.
            { exact (Hword_product_in_G1 n1 xs1 Hred1 HallG1_1). }
            claim Hwp2_G2 : wp2 :e G2.
            { exact (Hword_product_in_G2 n2 xs2 Hred2 HallG2_2). }
            claim Hwp1'_G1 : wp1' :e G1.
            { exact (Hword_product_in_G1 n1' xs1' Hred1' HallG1_1'). }
            claim Hwp2'_G2 : wp2' :e G2.
            { exact (Hword_product_in_G2 n2' xs2' Hred2' HallG2_2'). }

            claim HallNe1 : forall j:set, j :e n1 -> apply_fun xs1 j <> eG.
            {
              let j. assume Hj1.
              rewrite (apply_fun_graph n1 (fun t:set => apply_fun xs t) j Hj1).
              exact (HallNe j (Hn1_sub_n j Hj1)).
            }
            claim HallNe1'2 : forall j:set, j :e n1' -> apply_fun xs1' j <> eG.
            {
              let j. assume Hj1.
              rewrite (apply_fun_graph n1' (fun t:set => apply_fun xs' t) j Hj1).
              exact (HallNe' j (Hn1'_sub_n' j Hj1)).
            }

            claim Hn1_ne0 : n1 <> 0. { exact (neq_ordsucc_0 m). }
            claim Hn1'_ne0 : n1' <> 0. { exact (neq_ordsucc_0 m'). }

            claim Hwp1_ne : wp1 <> eG.
            {
              exact (cor68_6_reduced_word_all_in_G1_product_ne_eG
                G multG eG invG G1 G2 J K Hfam efamH n1 xs1
                Hgrp Hsub1 Hsub2 Hfp Hfp1 Hfp2
                Hred1 HallNe1 HallG1_1 Hn1_ne0).
            }
            claim Hwp1'_ne : wp1' <> eG.
            {
              exact (cor68_6_reduced_word_all_in_G1_product_ne_eG
                G multG eG invG G1 G2 J K Hfam efamH n1' xs1'
                Hgrp Hsub1 Hsub2 Hfp Hfp1 Hfp2
                Hred1' HallNe1'2 HallG1_1' Hn1'_ne0).
            }
            claim Hwp2_ne : wp2 <> eG. { exact Hsuf_ne. }
            claim Hwp2'_ne : wp2' <> eG. { exact Hsuf_ne'. }

            (** Binary disjointness between the two factors. **)
            claim Hdisj12 :
              forall a b:set, a :e (UPair 0 1) -> b :e (UPair 0 1) -> a <> b ->
                forall z:set, z :e apply_fun Gfam12 a -> z :e apply_fun Gfam12 b -> z = eG.
            {
              let a b. assume Ha Hb Hab.
              let z. assume Hz1 Hz2.
              claim HGfam0 : apply_fun Gfam12 0 = G1.
              {
                rewrite (apply_fun_graph (UPair 0 1) (fun u:set => if u = 0 then G1 else G2) 0 (UPairI1 0 1)).
                rewrite (If_i_1 (0 = 0) G1 G2 (eq_refl 0)).
                reflexivity.
              }
              claim HGfam1 : apply_fun Gfam12 1 = G2.
              {
                rewrite (apply_fun_graph (UPair 0 1) (fun u:set => if u = 0 then G1 else G2) 1 (UPairI2 0 1)).
                rewrite (If_i_0 (1 = 0) G1 G2 neq_1_0).
                reflexivity.
              }
              apply (UPairE a 0 1 Ha).
              - assume Ha0.
                apply (UPairE b 0 1 Hb).
                + assume Hb0.
                  claim Hab0 : a = b.
                  { exact (eq_i_tra a 0 b Ha0 (eq_symm b 0 Hb0)). }
                  exact (FalseE (Hab Hab0) (z = eG)).
                + assume Hb1.
                  claim HzG1 : z :e G1.
                  {
                    claim Hga : apply_fun Gfam12 a = G1.
                    { rewrite Ha0. exact HGfam0. }
                    exact (eq_subst_mem_set z (apply_fun Gfam12 a) G1 Hz1 Hga).
                  }
                  claim HzG2 : z :e G2.
                  {
                    claim Hgb : apply_fun Gfam12 b = G2.
                    { rewrite Hb1. exact HGfam1. }
                    exact (eq_subst_mem_set z (apply_fun Gfam12 b) G2 Hz2 Hgb).
                  }
                  exact (free_product_binary_factors_intersect_trivial
                    G multG eG invG G1 G2 z Hfp HzG1 HzG2).
              - assume Ha1.
                apply (UPairE b 0 1 Hb).
                + assume Hb0.
                  claim HzG2 : z :e G2.
                  {
                    claim Hga : apply_fun Gfam12 a = G2.
                    { rewrite Ha1. exact HGfam1. }
                    exact (eq_subst_mem_set z (apply_fun Gfam12 a) G2 Hz1 Hga).
                  }
                  claim HzG1 : z :e G1.
                  {
                    claim Hgb : apply_fun Gfam12 b = G1.
                    { rewrite Hb0. exact HGfam0. }
                    exact (eq_subst_mem_set z (apply_fun Gfam12 b) G1 Hz2 Hgb).
                  }
                  exact (free_product_binary_factors_intersect_trivial
                    G multG eG invG G1 G2 z Hfp HzG1 HzG2).
                + assume Hb1.
                  claim Hab0 : a = b.
                  { exact (eq_i_tra a 1 b Ha1 (eq_symm b 1 Hb1)). }
                  exact (FalseE (Hab Hab0) (z = eG)).
            }

            (** Build the length-2 binary words for x. **)
            set xb := graph 2 (fun t:set => If_i (t = 0) wp1 wp2).
            set xb' := graph 2 (fun t:set => If_i (t = 0) wp1' wp2').

            claim Hwp_xb : word_product multG eG xb 2 = x.
            {
              claim HxbG : forall t:set, t :e 2 -> apply_fun xb t :e G.
              {
                let t. assume Ht.
                apply (xm (t = 0)).
                - assume Ht0.
                  rewrite (apply_fun_graph 2 (fun i0:set => If_i (i0 = 0) wp1 wp2) t Ht).
                  rewrite (If_i_1 (t = 0) wp1 wp2 Ht0).
                  exact (subgroup_of_subset G1 G multG eG invG Hsub1 wp1 Hwp1_G1).
                - assume Ht0ne.
                  rewrite (apply_fun_graph 2 (fun i0:set => If_i (i0 = 0) wp1 wp2) t Ht).
                  rewrite (If_i_0 (t = 0) wp1 wp2 (fun Heq => Ht0ne Heq)).
                  exact (subgroup_of_subset G2 G multG eG invG Hsub2 wp2 Hwp2_G2).
              }
              claim Hwp2eq :
                word_product multG eG xb 2 = apply_fun multG (apply_fun xb 0, apply_fun xb 1).
              { exact (word_product_two_group G multG eG invG xb Hgrp HxbG). }
              claim Hxb0 : apply_fun xb 0 = wp1.
              {
                rewrite (apply_fun_graph 2 (fun i0:set => If_i (i0 = 0) wp1 wp2) 0 In_0_2).
                exact (If_i_1 (0 = 0) wp1 wp2 (eq_refl 0)).
              }
              claim Hxb1 : apply_fun xb 1 = wp2.
              {
                rewrite (apply_fun_graph 2 (fun i0:set => If_i (i0 = 0) wp1 wp2) 1 In_1_2).
                exact (If_i_0 (1 = 0) wp1 wp2 neq_1_0).
              }
              rewrite Hwp2eq.
              rewrite Hxb0.
              rewrite Hxb1.

              claim HxsG_all : forall j:set, j :e n -> apply_fun xs j :e G.
              {
                let j. assume Hj.
                apply (Hside_union n xs Hred j Hj).
                - assume HjG1.
                  exact (subgroup_of_subset G1 G multG eG invG Hsub1 (apply_fun xs j) HjG1).
                - assume HjG2.
                  exact (subgroup_of_subset G2 G multG eG invG Hsub2 (apply_fun xs j) HjG2).
              }
              claim Hsplit :
                word_product multG eG xs n =
                  apply_fun multG (word_product multG eG xs n1, wp2).
              {
                exact (word_product_split_by_add_nat
                  G multG eG invG n xs n1 n2
                  Hgrp Hn1_nat Hn2_nat Hn_eq
                  HxsG_all).
              }
              claim Hwp1_eq :
                word_product multG eG xs n1 = wp1.
              {
                claim Hn1O : n1 :e omega. { exact (nat_p_omega n1 Hn1_nat). }
                apply (nat_primrec_ext eG
                  (fun j r:set => apply_fun multG (r, apply_fun xs j))
                  (fun j r:set => apply_fun multG (r, apply_fun xs1 j))
                  n1
                  Hn1O).
                let j r. assume Hj1.
                rewrite (apply_fun_graph n1 (fun t:set => apply_fun xs t) j Hj1).
                reflexivity.
              }
              rewrite <- Hwp.
              rewrite Hsplit.
              rewrite Hwp1_eq.
              reflexivity.
            }

            claim Hwp_xb' : word_product multG eG xb' 2 = x.
            {
              claim HxbG : forall t:set, t :e 2 -> apply_fun xb' t :e G.
              {
                let t. assume Ht.
                apply (xm (t = 0)).
                - assume Ht0.
                  rewrite (apply_fun_graph 2 (fun i0:set => If_i (i0 = 0) wp1' wp2') t Ht).
                  rewrite (If_i_1 (t = 0) wp1' wp2' Ht0).
                  exact (subgroup_of_subset G1 G multG eG invG Hsub1 wp1' Hwp1'_G1).
                - assume Ht0ne.
                  rewrite (apply_fun_graph 2 (fun i0:set => If_i (i0 = 0) wp1' wp2') t Ht).
                  rewrite (If_i_0 (t = 0) wp1' wp2' (fun Heq => Ht0ne Heq)).
                  exact (subgroup_of_subset G2 G multG eG invG Hsub2 wp2' Hwp2'_G2).
              }
              claim Hwp2eq :
                word_product multG eG xb' 2 = apply_fun multG (apply_fun xb' 0, apply_fun xb' 1).
              { exact (word_product_two_group G multG eG invG xb' Hgrp HxbG). }
              claim Hxb0 : apply_fun xb' 0 = wp1'.
              {
                rewrite (apply_fun_graph 2 (fun i0:set => If_i (i0 = 0) wp1' wp2') 0 In_0_2).
                exact (If_i_1 (0 = 0) wp1' wp2' (eq_refl 0)).
              }
              claim Hxb1 : apply_fun xb' 1 = wp2'.
              {
                rewrite (apply_fun_graph 2 (fun i0:set => If_i (i0 = 0) wp1' wp2') 1 In_1_2).
                exact (If_i_0 (1 = 0) wp1' wp2' neq_1_0).
              }
              rewrite Hwp2eq.
              rewrite Hxb0.
              rewrite Hxb1.

              claim HxsG_all' : forall j:set, j :e n' -> apply_fun xs' j :e G.
              {
                let j. assume Hj.
                apply (Hside_union n' xs' Hred' j Hj).
                - assume HjG1.
                  exact (subgroup_of_subset G1 G multG eG invG Hsub1 (apply_fun xs' j) HjG1).
                - assume HjG2.
                  exact (subgroup_of_subset G2 G multG eG invG Hsub2 (apply_fun xs' j) HjG2).
              }
              claim Hsplit :
                word_product multG eG xs' n' =
                  apply_fun multG (word_product multG eG xs' n1', wp2').
              {
                exact (word_product_split_by_add_nat
                  G multG eG invG n' xs' n1' n2'
                  Hgrp Hn1'_nat Hn2'_nat Hn'_eq
                  HxsG_all').
              }
              claim Hwp1'_eq :
                word_product multG eG xs' n1' = wp1'.
              {
                claim Hn1O : n1' :e omega. { exact (nat_p_omega n1' Hn1'_nat). }
                apply (nat_primrec_ext eG
                  (fun j r:set => apply_fun multG (r, apply_fun xs' j))
                  (fun j r:set => apply_fun multG (r, apply_fun xs1' j))
                  n1'
                  Hn1O).
                let j r. assume Hj1.
                rewrite (apply_fun_graph n1' (fun t:set => apply_fun xs' t) j Hj1).
                reflexivity.
              }
              rewrite <- Hwp'.
              rewrite Hsplit.
              rewrite Hwp1'_eq.
              reflexivity.
            }

            claim Hred_xb : reduced_word (UPair 0 1) Gfam12 efam12 2 xb.
            {
              claim HGfam0 : apply_fun Gfam12 0 = G1.
              {
                rewrite (apply_fun_graph (UPair 0 1) (fun u:set => if u = 0 then G1 else G2) 0 (UPairI1 0 1)).
                rewrite (If_i_1 (0 = 0) G1 G2 (eq_refl 0)).
                reflexivity.
              }
              claim HGfam1 : apply_fun Gfam12 1 = G2.
              {
                rewrite (apply_fun_graph (UPair 0 1) (fun u:set => if u = 0 then G1 else G2) 1 (UPairI2 0 1)).
                rewrite (If_i_0 (1 = 0) G1 G2 neq_1_0).
                reflexivity.
              }
              claim Hef0 : apply_fun efam12 0 = eG.
              { exact (apply_fun_graph (UPair 0 1) (fun _:set => eG) 0 (UPairI1 0 1)). }
              claim Hef1 : apply_fun efam12 1 = eG.
              { exact (apply_fun_graph (UPair 0 1) (fun _:set => eG) 1 (UPairI2 0 1)). }
              claim Hwp1_in : wp1 :e apply_fun Gfam12 0.
              { rewrite HGfam0. exact Hwp1_G1. }
              claim Hwp2_in : wp2 :e apply_fun Gfam12 1.
              { rewrite HGfam1. exact Hwp2_G2. }
              claim Hwp1_ne_ef : wp1 <> apply_fun efam12 0.
              { rewrite Hef0. exact Hwp1_ne. }
              claim Hwp2_ne_ef : wp2 <> apply_fun efam12 1.
              { rewrite Hef1. exact Hwp2_ne. }
              exact (reduced_word_two_graph_disjoint
                G multG eG invG (UPair 0 1) Gfam12 efam12
                0 1 wp1 wp2
                Hdisj12
                (UPairI1 0 1) (UPairI2 0 1) neq_0_1
                Hwp1_in Hwp1_ne Hwp1_ne_ef
                Hwp2_in Hwp2_ne Hwp2_ne_ef).
            }
            claim Hred_xb' : reduced_word (UPair 0 1) Gfam12 efam12 2 xb'.
            {
              claim HGfam0 : apply_fun Gfam12 0 = G1.
              {
                rewrite (apply_fun_graph (UPair 0 1) (fun u:set => if u = 0 then G1 else G2) 0 (UPairI1 0 1)).
                rewrite (If_i_1 (0 = 0) G1 G2 (eq_refl 0)).
                reflexivity.
              }
              claim HGfam1 : apply_fun Gfam12 1 = G2.
              {
                rewrite (apply_fun_graph (UPair 0 1) (fun u:set => if u = 0 then G1 else G2) 1 (UPairI2 0 1)).
                rewrite (If_i_0 (1 = 0) G1 G2 neq_1_0).
                reflexivity.
              }
              claim Hef0 : apply_fun efam12 0 = eG.
              { exact (apply_fun_graph (UPair 0 1) (fun _:set => eG) 0 (UPairI1 0 1)). }
              claim Hef1 : apply_fun efam12 1 = eG.
              { exact (apply_fun_graph (UPair 0 1) (fun _:set => eG) 1 (UPairI2 0 1)). }
              claim Hwp1_in : wp1' :e apply_fun Gfam12 0.
              { rewrite HGfam0. exact Hwp1'_G1. }
              claim Hwp2_in : wp2' :e apply_fun Gfam12 1.
              { rewrite HGfam1. exact Hwp2'_G2. }
              claim Hwp1_ne_ef : wp1' <> apply_fun efam12 0.
              { rewrite Hef0. exact Hwp1'_ne. }
              claim Hwp2_ne_ef : wp2' <> apply_fun efam12 1.
              { rewrite Hef1. exact Hwp2'_ne. }
              exact (reduced_word_two_graph_disjoint
                G multG eG invG (UPair 0 1) Gfam12 efam12
                0 1 wp1' wp2'
                Hdisj12
                (UPairI1 0 1) (UPairI2 0 1) neq_0_1
                (eq_subst_mem_set wp1' G1 (apply_fun Gfam12 0) Hwp1'_G1 (eq_symm (apply_fun Gfam12 0) G1 HGfam0))
                Hwp1'_ne Hwp1_ne_ef
                (eq_subst_mem_set wp2' G2 (apply_fun Gfam12 1) Hwp2'_G2 (eq_symm (apply_fun Gfam12 1) G2 HGfam1))
                Hwp2'_ne Hwp2_ne_ef).
            }

            (** Use uniqueness of the binary normal form to identify factor products. **)
            claim Huniqb :
              n12 = 2 /\ (forall i0:set, i0 :e n12 -> apply_fun xs12 i0 = apply_fun xb i0).
            { exact (Huniq12 2 xb Hred_xb neq_2_0 Hwp_xb). }
            claim Huniqb' :
              n12 = 2 /\ (forall i0:set, i0 :e n12 -> apply_fun xs12 i0 = apply_fun xb' i0).
            { exact (Huniq12 2 xb' Hred_xb' neq_2_0 Hwp_xb'). }
            claim Hpt : forall i0:set, i0 :e n12 -> apply_fun xs12 i0 = apply_fun xb i0.
            { exact (andER (n12 = 2) (forall i0:set, i0 :e n12 -> apply_fun xs12 i0 = apply_fun xb i0) Huniqb). }
            claim Hpt' : forall i0:set, i0 :e n12 -> apply_fun xs12 i0 = apply_fun xb' i0.
            { exact (andER (n12 = 2) (forall i0:set, i0 :e n12 -> apply_fun xs12 i0 = apply_fun xb' i0) Huniqb'). }
            claim Hwp1_eq0 : wp1 = apply_fun xs12 0.
            {
              claim H0 : apply_fun xs12 0 = apply_fun xb 0.
              { exact (Hpt 0 H0in12). }
              claim Hxb0 : apply_fun xb 0 = wp1.
              {
                rewrite (apply_fun_graph 2 (fun i0:set => If_i (i0 = 0) wp1 wp2) 0 In_0_2).
                exact (If_i_1 (0 = 0) wp1 wp2 (eq_refl 0)).
              }
              exact (eq_i_tra wp1 (apply_fun xb 0) (apply_fun xs12 0)
                (eq_symm (apply_fun xb 0) wp1 Hxb0)
                (eq_symm (apply_fun xs12 0) (apply_fun xb 0) H0)).
            }
            claim Hwp2_eq1 : wp2 = apply_fun xs12 1.
            {
              claim H1 : apply_fun xs12 1 = apply_fun xb 1.
              { exact (Hpt 1 H1in12). }
              claim Hxb1 : apply_fun xb 1 = wp2.
              {
                rewrite (apply_fun_graph 2 (fun i0:set => If_i (i0 = 0) wp1 wp2) 1 In_1_2).
                exact (If_i_0 (1 = 0) wp1 wp2 neq_1_0).
              }
              exact (eq_i_tra wp2 (apply_fun xb 1) (apply_fun xs12 1)
                (eq_symm (apply_fun xb 1) wp2 Hxb1)
                (eq_symm (apply_fun xs12 1) (apply_fun xb 1) H1)).
            }
            claim Hwp1'_eq0 : wp1' = apply_fun xs12 0.
            {
              claim H0 : apply_fun xs12 0 = apply_fun xb' 0.
              { exact (Hpt' 0 H0in12). }
              claim Hxb0 : apply_fun xb' 0 = wp1'.
              {
                rewrite (apply_fun_graph 2 (fun i0:set => If_i (i0 = 0) wp1' wp2') 0 In_0_2).
                exact (If_i_1 (0 = 0) wp1' wp2' (eq_refl 0)).
              }
              exact (eq_i_tra wp1' (apply_fun xb' 0) (apply_fun xs12 0)
                (eq_symm (apply_fun xb' 0) wp1' Hxb0)
                (eq_symm (apply_fun xs12 0) (apply_fun xb' 0) H0)).
            }
            claim Hwp2'_eq1 : wp2' = apply_fun xs12 1.
            {
              claim H1 : apply_fun xs12 1 = apply_fun xb' 1.
              { exact (Hpt' 1 H1in12). }
              claim Hxb1 : apply_fun xb' 1 = wp2'.
              {
                rewrite (apply_fun_graph 2 (fun i0:set => If_i (i0 = 0) wp1' wp2') 1 In_1_2).
                exact (If_i_0 (1 = 0) wp1' wp2' neq_1_0).
              }
              exact (eq_i_tra wp2' (apply_fun xb' 1) (apply_fun xs12 1)
                (eq_symm (apply_fun xb' 1) wp2' Hxb1)
                (eq_symm (apply_fun xs12 1) (apply_fun xb' 1) H1)).
            }
            claim Hwp1_eq : wp1 = wp1'.
            { exact (eq_i_tra wp1 (apply_fun xs12 0) wp1' Hwp1_eq0 (eq_symm wp1' (apply_fun xs12 0) Hwp1'_eq0)). }
            claim Hwp2_eq : wp2 = wp2'.
            { exact (eq_i_tra wp2 (apply_fun xs12 1) wp2' Hwp2_eq1 (eq_symm wp2' (apply_fun xs12 1) Hwp2'_eq1)). }

            (** Unique reduced word decomposition inside J for wp1. **)
            claim HredJ1 : reduced_word J (graph J (fun a:set => apply_fun Hfam a))
              (graph J (fun a:set => apply_fun efamH a)) n1 xs1.
            { exact (Hred_J_of_union n1 xs1 Hred1 HallG1_1 HallNe1). }
            claim HredJ1' : reduced_word J (graph J (fun a:set => apply_fun Hfam a))
              (graph J (fun a:set => apply_fun efamH a)) n1' xs1'.
            { exact (Hred_J_of_union n1' xs1' Hred1' HallG1_1' HallNe1'2). }

            apply (and6E
              (group_structure G1 multG eG invG)
              (forall alpha:set, alpha :e J ->
                subgroup_of (apply_fun (graph J (fun a:set => apply_fun Hfam a)) alpha) G1 multG eG invG)
              (forall alpha beta:set, alpha :e J -> beta :e J -> alpha <> beta ->
                forall y:set, y :e apply_fun (graph J (fun a:set => apply_fun Hfam a)) alpha ->
                  y :e apply_fun (graph J (fun a:set => apply_fun Hfam a)) beta -> y = eG)
              (subgroups_generate G1 multG eG invG J (graph J (fun a:set => apply_fun Hfam a)))
              (forall y:set, y :e G1 -> y <> eG ->
                exists mJ ysJ:set,
                  reduced_word J (graph J (fun a:set => apply_fun Hfam a))
                    (graph J (fun a:set => apply_fun efamH a)) mJ ysJ /\ mJ <> 0 /\
                  word_product multG eG ysJ mJ = y /\
                  (forall m' ys':set,
                    reduced_word J (graph J (fun a:set => apply_fun Hfam a))
                      (graph J (fun a:set => apply_fun efamH a)) m' ys' -> m' <> 0 ->
                    word_product multG eG ys' m' = y ->
                    mJ = m' /\ (forall i:set, i :e mJ -> apply_fun ysJ i = apply_fun ys' i)))
              (forall alpha:set, alpha :e J -> apply_fun (graph J (fun a:set => apply_fun efamH a)) alpha = eG)
              Hfp1).
            assume _ _ _ _ HuniqJ _.
            apply (HuniqJ wp1 Hwp1_G1 Hwp1_ne).
            let mJ. assume HmJ_pack.
            apply HmJ_pack. let ysJ. assume HysJ_pack.
            apply (and4E
              (reduced_word J (graph J (fun a:set => apply_fun Hfam a))
                (graph J (fun a:set => apply_fun efamH a)) mJ ysJ)
              (mJ <> 0)
              (word_product multG eG ysJ mJ = wp1)
              (forall m' ys':set,
                reduced_word J (graph J (fun a:set => apply_fun Hfam a))
                  (graph J (fun a:set => apply_fun efamH a)) m' ys' -> m' <> 0 ->
                word_product multG eG ys' m' = wp1 ->
                mJ = m' /\ (forall i:set, i :e mJ -> apply_fun ysJ i = apply_fun ys' i))
              HysJ_pack).
            assume HredJ0 HmJ_ne HwpJ0 HuniqJ0.
            claim Huniq_xs1 : mJ = n1 /\ (forall i:set, i :e mJ -> apply_fun ysJ i = apply_fun xs1 i).
            { exact (HuniqJ0 n1 xs1 HredJ1 Hn1_ne0 (eq_refl wp1)). }
            claim Huniq_xs1' : mJ = n1' /\ (forall i:set, i :e mJ -> apply_fun ysJ i = apply_fun xs1' i).
            {
              claim Hwp1'_eq : word_product multG eG xs1' n1' = wp1.
              { exact (eq_i_tra (word_product multG eG xs1' n1') wp1' wp1 (eq_refl wp1') (eq_symm wp1 wp1' Hwp1_eq)). }
              exact (HuniqJ0 n1' xs1' HredJ1' Hn1'_ne0 Hwp1'_eq).
            }
            claim Hn1_eq : n1 = n1'.
            {
              claim HmJ_eq_n1 : mJ = n1.
              { exact (andEL (mJ = n1) (forall i0:set, i0 :e mJ -> apply_fun ysJ i0 = apply_fun xs1 i0) Huniq_xs1). }
              claim HmJ_eq_n1' : mJ = n1'.
              { exact (andEL (mJ = n1') (forall i0:set, i0 :e mJ -> apply_fun ysJ i0 = apply_fun xs1' i0) Huniq_xs1'). }
              exact (eq_i_tra n1 mJ n1' (eq_symm mJ n1 HmJ_eq_n1) HmJ_eq_n1').
            }

            (** Unique reduced word decomposition inside K for wp2. **)
            claim HredK2 : reduced_word K (graph K (fun b:set => apply_fun Hfam b))
              (graph K (fun b:set => apply_fun efamH b)) n2 xs2.
            { exact (Hred_K_of_union n2 xs2 Hred2 HallG2_2 HallNe2). }
            claim HredK2' : reduced_word K (graph K (fun b:set => apply_fun Hfam b))
              (graph K (fun b:set => apply_fun efamH b)) n2' xs2'.
            { exact (Hred_K_of_union n2' xs2' Hred2' HallG2_2' HallNe2'). }

            claim Hn2_ne0 : n2 <> 0. { exact Hn2_ne0. }
            claim Hn2'_ne0' : n2' <> 0. { exact Hn2'_ne0. }

            apply (and6E
              (group_structure G2 multG eG invG)
              (forall beta:set, beta :e K ->
                subgroup_of (apply_fun (graph K (fun b:set => apply_fun Hfam b)) beta) G2 multG eG invG)
              (forall beta gamma:set, beta :e K -> gamma :e K -> beta <> gamma ->
                forall y:set, y :e apply_fun (graph K (fun b:set => apply_fun Hfam b)) beta ->
                  y :e apply_fun (graph K (fun b:set => apply_fun Hfam b)) gamma -> y = eG)
              (subgroups_generate G2 multG eG invG K (graph K (fun b:set => apply_fun Hfam b)))
              (forall y:set, y :e G2 -> y <> eG ->
                exists mK ysK:set,
                  reduced_word K (graph K (fun b:set => apply_fun Hfam b))
                    (graph K (fun b:set => apply_fun efamH b)) mK ysK /\ mK <> 0 /\
                  word_product multG eG ysK mK = y /\
                  (forall m' ys':set,
                    reduced_word K (graph K (fun b:set => apply_fun Hfam b))
                      (graph K (fun b:set => apply_fun efamH b)) m' ys' -> m' <> 0 ->
                    word_product multG eG ys' m' = y ->
                    mK = m' /\ (forall i:set, i :e mK -> apply_fun ysK i = apply_fun ys' i)))
              (forall alpha:set, alpha :e K -> apply_fun (graph K (fun b:set => apply_fun efamH b)) alpha = eG)
              Hfp2).
            assume _ _ _ _ HuniqK _.
            apply (HuniqK wp2 Hwp2_G2 Hwp2_ne).
            let mK. assume HmK_pack.
            apply HmK_pack. let ysK. assume HysK_pack.
            apply (and4E
              (reduced_word K (graph K (fun b:set => apply_fun Hfam b))
                (graph K (fun b:set => apply_fun efamH b)) mK ysK)
              (mK <> 0)
              (word_product multG eG ysK mK = wp2)
              (forall m' ys':set,
                reduced_word K (graph K (fun b:set => apply_fun Hfam b))
                  (graph K (fun b:set => apply_fun efamH b)) m' ys' -> m' <> 0 ->
                word_product multG eG ys' m' = wp2 ->
                mK = m' /\ (forall i:set, i :e mK -> apply_fun ysK i = apply_fun ys' i))
              HysK_pack).
            assume HredK0 HmK_ne HwpK0 HuniqK0.
            claim Huniq_xs2 : mK = n2 /\ (forall i:set, i :e mK -> apply_fun ysK i = apply_fun xs2 i).
            { exact (HuniqK0 n2 xs2 HredK2 Hn2_ne0 (eq_refl wp2)). }
            claim Huniq_xs2' : mK = n2' /\ (forall i:set, i :e mK -> apply_fun ysK i = apply_fun xs2' i).
            {
              claim Hwp2'_eq : word_product multG eG xs2' n2' = wp2.
              { exact (eq_i_tra (word_product multG eG xs2' n2') wp2' wp2 (eq_refl wp2') (eq_symm wp2 wp2' Hwp2_eq)). }
              exact (HuniqK0 n2' xs2' HredK2' Hn2'_ne0' Hwp2'_eq).
            }
            claim Hn2_eq : n2 = n2'.
            {
              claim HmK_eq_n2 : mK = n2.
              { exact (andEL (mK = n2) (forall i0:set, i0 :e mK -> apply_fun ysK i0 = apply_fun xs2 i0) Huniq_xs2). }
              claim HmK_eq_n2' : mK = n2'.
              { exact (andEL (mK = n2') (forall i0:set, i0 :e mK -> apply_fun ysK i0 = apply_fun xs2' i0) Huniq_xs2'). }
              exact (eq_i_tra n2 mK n2' (eq_symm mK n2 HmK_eq_n2) HmK_eq_n2').
            }

            (** Conclude n = n' and pointwise equality. **)
            claim Hn_eq_final : n = n'.
            {
              rewrite Hn_eq.
              rewrite Hn'_eq.
              rewrite Hn1_eq.
              rewrite Hn2_eq.
              reflexivity.
            }
            apply andI.
            - exact Hn_eq_final.
            - let i. assume Hi : i :e n.
              claim Hi_in_sum : i :e add_nat n1 n2.
              { exact (eq_subst_mem_set i n (add_nat n1 n2) Hi Hn_eq). }
              apply (xm (i :e n1)).
              + assume Hi1.
                claim Hi1' : i :e n1'.
                { exact (eq_subst_mem_set i n1 n1' Hi1 Hn1_eq). }
                claim Hxs_i : apply_fun xs i = apply_fun xs1 i.
                {
                  claim Hxseq : apply_fun xs1 i = apply_fun xs i.
                  { exact (apply_fun_graph n1 (fun t:set => apply_fun xs t) i Hi1). }
                  exact (eq_symm (apply_fun xs1 i) (apply_fun xs i) Hxseq).
                }
                claim Hxs'_i : apply_fun xs' i = apply_fun xs1' i.
                {
                  claim Hxseq : apply_fun xs1' i = apply_fun xs' i.
                  { exact (apply_fun_graph n1' (fun t:set => apply_fun xs' t) i Hi1'). }
                  exact (eq_symm (apply_fun xs1' i) (apply_fun xs' i) Hxseq).
                }
                (** Use the canonical J-word equality. **)
                claim HysJ_xs1 : forall j:set, j :e mJ -> apply_fun ysJ j = apply_fun xs1 j.
                { exact (andER (mJ = n1) (forall i0:set, i0 :e mJ -> apply_fun ysJ i0 = apply_fun xs1 i0) Huniq_xs1). }
                claim HysJ_xs1' : forall j:set, j :e mJ -> apply_fun ysJ j = apply_fun xs1' j.
                { exact (andER (mJ = n1') (forall i0:set, i0 :e mJ -> apply_fun ysJ i0 = apply_fun xs1' i0) Huniq_xs1'). }
                claim HimJ : i :e mJ.
                { exact (eq_subst_mem_set i n1 mJ Hi1 (eq_symm mJ n1 (andEL (mJ = n1) (forall i0:set, i0 :e mJ -> apply_fun ysJ i0 = apply_fun xs1 i0) Huniq_xs1))). }
                claim Hxs1_eq : apply_fun xs1 i = apply_fun ysJ i.
                { exact (eq_symm (apply_fun ysJ i) (apply_fun xs1 i) (HysJ_xs1 i HimJ)). }
                claim Hxs1'_eq : apply_fun ysJ i = apply_fun xs1' i.
                { exact (HysJ_xs1' i HimJ). }
                claim Hxs1_xs1' : apply_fun xs1 i = apply_fun xs1' i.
                { exact (eq_i_tra (apply_fun xs1 i) (apply_fun ysJ i) (apply_fun xs1' i) Hxs1_eq Hxs1'_eq). }
                exact (eq_i_tra (apply_fun xs i) (apply_fun xs1 i) (apply_fun xs' i)
                  Hxs_i
                  (eq_i_tra (apply_fun xs1 i) (apply_fun xs1' i) (apply_fun xs' i)
                    Hxs1_xs1'
                    (eq_symm (apply_fun xs' i) (apply_fun xs1' i) Hxs'_i))).
              + assume Hi_not1.
                (** Then i is in the right part: i = n1 + j. **)
                claim Hdecomp : exists j:set, j :e n2 /\ i = add_nat n1 j.
                { exact (nat_add_nat_decomp_beyond_left n1 n2 i Hn1_nat Hn2_nat Hi_in_sum Hi_not1). }
                apply Hdecomp. let j. assume Hj_pack.
                claim Hj2 : j :e n2.
                { exact (andEL (j :e n2) (i = add_nat n1 j) Hj_pack). }
                claim Hi_eq : i = add_nat n1 j.
                { exact (andER (j :e n2) (i = add_nat n1 j) Hj_pack). }
                claim Hj2' : j :e n2'.
                { exact (eq_subst_mem_set j n2 n2' Hj2 Hn2_eq). }
                claim Hxs_i : apply_fun xs i = apply_fun xs2 j.
                {
                  rewrite Hi_eq.
                  exact (eq_symm
                    (apply_fun xs2 j)
                    (apply_fun xs (add_nat n1 j))
                    (apply_fun_graph n2 (fun t:set => apply_fun xs (add_nat n1 t)) j Hj2)).
                }
                claim Hxs'_i : apply_fun xs' i = apply_fun xs2' j.
                {
                  rewrite Hi_eq.
                  rewrite Hn1_eq.
                  exact (eq_symm
                    (apply_fun xs2' j)
                    (apply_fun xs' (add_nat n1' j))
                    (apply_fun_graph n2' (fun t:set => apply_fun xs' (add_nat n1' t)) j Hj2')).
                }
                claim HysK_xs2 : forall j0:set, j0 :e mK -> apply_fun ysK j0 = apply_fun xs2 j0.
                { exact (andER (mK = n2) (forall i0:set, i0 :e mK -> apply_fun ysK i0 = apply_fun xs2 i0) Huniq_xs2). }
                claim HysK_xs2' : forall j0:set, j0 :e mK -> apply_fun ysK j0 = apply_fun xs2' j0.
                { exact (andER (mK = n2') (forall i0:set, i0 :e mK -> apply_fun ysK i0 = apply_fun xs2' i0) Huniq_xs2'). }
                claim Hj_mK : j :e mK.
                { exact (eq_subst_mem_set j n2 mK Hj2 (eq_symm mK n2 (andEL (mK = n2) (forall i0:set, i0 :e mK -> apply_fun ysK i0 = apply_fun xs2 i0) Huniq_xs2))). }
                claim Hxs2_eq : apply_fun xs2 j = apply_fun ysK j.
                { exact (eq_symm (apply_fun ysK j) (apply_fun xs2 j) (HysK_xs2 j Hj_mK)). }
                claim Hxs2'_eq : apply_fun ysK j = apply_fun xs2' j.
                { exact (HysK_xs2' j Hj_mK). }
                claim Hxs2_xs2' : apply_fun xs2 j = apply_fun xs2' j.
                { exact (eq_i_tra (apply_fun xs2 j) (apply_fun ysK j) (apply_fun xs2' j) Hxs2_eq Hxs2'_eq). }
                exact (eq_i_tra (apply_fun xs i) (apply_fun xs2 j) (apply_fun xs' i)
                  Hxs_i
                  (eq_i_tra (apply_fun xs2 j) (apply_fun xs2' j) (apply_fun xs' i) Hxs2_xs2' (eq_symm (apply_fun xs' i) (apply_fun xs2' j) Hxs'_i))).
          }
	    + assume Hn12_ne2.
	      (** General case n12 >= 3.  Reduce to a dedicated lemma for the remaining concatenation
	          and uniqueness argument. **)
	      claim Hn12_ne0 : n12 <> 0. { exact Hn12ne. }
	
	      (** x is not in either factor since the binary normal form length is >= 2. **)
	      claim Hx_not_G1 : x /:e G1.
	      {
	        claim Hwp_not_G1 : word_product multG eG xs12 n12 /:e G1.
	        {
	          exact (free_product_binary_reduced_word_length_ge2_not_in_left_factor
	            G multG eG invG G1 G2 n12 xs12
	            Hsub1 Hsub2 Hfp
	            Hred12word
	            Hn12_ne0
	            Hn12_ne1).
	        }
	        assume HxG1 : x :e G1.
	        claim HwpG1 : word_product multG eG xs12 n12 :e G1.
	        { exact (eq_subst_mem_rev x (word_product multG eG xs12 n12) G1 (eq_symm (word_product multG eG xs12 n12) x Hwp12) HxG1). }
	        exact (Hwp_not_G1 HwpG1).
	      }
	      claim Hx_not_G2 : x /:e G2.
	      {
	        claim Hwp_not_G2 : word_product multG eG xs12 n12 /:e G2.
	        {
	          exact (free_product_binary_reduced_word_length_ge2_not_in_right_factor
	            G multG eG invG G1 G2 n12 xs12
	            Hsub1 Hsub2 Hfp
	            Hred12word
	            Hn12_ne0
	            Hn12_ne1).
	        }
	        assume HxG2 : x :e G2.
	        claim HwpG2 : word_product multG eG xs12 n12 :e G2.
	        { exact (eq_subst_mem_rev x (word_product multG eG xs12 n12) G2 (eq_symm (word_product multG eG xs12 n12) x Hwp12) HxG2). }
	        exact (Hwp_not_G2 HwpG2).
	      }
	
		      claim Hge3_case :
		        exists n xs:set,
		          reduced_word (J :\/: K) Hfam efamH n xs /\ n <> 0 /\
		          word_product multG eG xs n = x /\
		          (forall n' xs':set,
		            reduced_word (J :\/: K) Hfam efamH n' xs' -> n' <> 0 ->
		            word_product multG eG xs' n' = x ->
		            n = n' /\ (forall i:set, i :e n -> apply_fun xs i = apply_fun xs' i)).
		      {
		        (** Setup lemmas for the remaining n12 >= 3 construction. **)
		        claim Hn12O : n12 :e omega.
		        {
		          apply (and3E
		            (n12 :e omega)
		            (forall i:set, i :e n12 ->
		              exists alpha:set, alpha :e (UPair 0 1) /\
		                apply_fun xs12 i :e apply_fun Gfam12 alpha /\
		                apply_fun xs12 i <> apply_fun (graph (UPair 0 1) (fun i:set => eG)) alpha)
		            (forall i:set, i :e n12 -> ordsucc i :e n12 ->
		              forall alpha beta:set, alpha :e (UPair 0 1) -> beta :e (UPair 0 1) ->
		                apply_fun xs12 i :e apply_fun Gfam12 alpha ->
		                apply_fun xs12 (ordsucc i) :e apply_fun Gfam12 beta ->
		                alpha <> beta)
		            Hred12word).
		          assume Hn12O _ _. exact Hn12O.
		        }
		        claim Hn12_nat : nat_p n12.
		        { exact (omega_nat_p n12 Hn12O). }
		        claim Hn12_succ : exists kmax:set, nat_p kmax /\ n12 = ordsucc kmax.
		        {
		          apply (nat_inv n12 Hn12_nat).
		          - assume Hn0.
		            exact (FalseE (Hn12ne Hn0) (exists kmax:set, nat_p kmax /\ n12 = ordsucc kmax)).
		          - assume Hk_ex. exact Hk_ex.
		        }

		        claim Hxs12_fam :
		          forall i:set, i :e n12 ->
		            exists alpha:set, alpha :e (UPair 0 1) /\
		              apply_fun xs12 i :e apply_fun Gfam12 alpha /\
		              apply_fun xs12 i <> eG.
		        {
		          let i. assume Hi.
		          apply (and3E
		            (n12 :e omega)
		            (forall j:set, j :e n12 ->
		              exists alpha:set, alpha :e (UPair 0 1) /\
		                apply_fun xs12 j :e apply_fun Gfam12 alpha /\
		                apply_fun xs12 j <> apply_fun (graph (UPair 0 1) (fun i:set => eG)) alpha)
		            (forall j:set, j :e n12 -> ordsucc j :e n12 ->
		              forall alpha beta:set, alpha :e (UPair 0 1) -> beta :e (UPair 0 1) ->
		                apply_fun xs12 j :e apply_fun Gfam12 alpha ->
		                apply_fun xs12 (ordsucc j) :e apply_fun Gfam12 beta ->
		                alpha <> beta)
		            Hred12word).
		          assume _ Hfam _.
		          apply (Hfam i Hi).
		          let alpha. assume Halpha_pack.
		          apply (and3E
		            (alpha :e (UPair 0 1))
		            (apply_fun xs12 i :e apply_fun Gfam12 alpha)
		            (apply_fun xs12 i <> apply_fun (graph (UPair 0 1) (fun i:set => eG)) alpha)
		            Halpha_pack).
		          assume Hal HxG Hxne0.
		          witness alpha.
		          apply and3I.
		          - exact Hal.
		          - exact HxG.
		          - exact (Hxs12_ne i Hi).
		        }

		        claim Hxs12_side :
		          forall i:set, i :e n12 ->
		            apply_fun xs12 i :e G1 \/ apply_fun xs12 i :e G2.
		        {
		          let i. assume Hi.
		          apply (Hxs12_fam i Hi).
		          let alpha. assume Halpha_pack.
		          apply (and3E
		            (alpha :e (UPair 0 1))
		            (apply_fun xs12 i :e apply_fun Gfam12 alpha)
		            (apply_fun xs12 i <> eG)
		            Halpha_pack).
		          assume Hal HxG _.
		          apply (UPairE alpha 0 1 Hal).
		          - assume Ha0 : alpha = 0.
		            apply orIL.
		            claim HGfam0 : apply_fun Gfam12 alpha = G1.
		            {
		              rewrite (apply_fun_graph (UPair 0 1) (fun j:set => if j = 0 then G1 else G2) alpha Hal).
		              exact (If_i_1 (alpha = 0) G1 G2 Ha0).
		            }
		            exact (eq_subst_mem_set (apply_fun xs12 i) (apply_fun Gfam12 alpha) G1 HxG HGfam0).
		          - assume Ha1 : alpha = 1.
		            apply orIR.
			            claim HGfam1 : apply_fun Gfam12 alpha = G2.
			            {
			              rewrite (apply_fun_graph (UPair 0 1) (fun j:set => if j = 0 then G1 else G2) alpha Hal).
			              rewrite Ha1.
			              exact (If_i_0 (1 = 0) G1 G2 neq_1_0).
			            }
		            exact (eq_subst_mem_set (apply_fun xs12 i) (apply_fun Gfam12 alpha) G2 HxG HGfam1).
		        }

		        claim Hxs12_adj_side :
		          forall i:set, i :e n12 -> ordsucc i :e n12 ->
		            (apply_fun xs12 i :e G1 -> apply_fun xs12 (ordsucc i) :e G2) /\
		            (apply_fun xs12 i :e G2 -> apply_fun xs12 (ordsucc i) :e G1).
		        {
		          let i. assume Hi Hsi.
		          apply andI.
		          - assume HxiG1.
		            claim Hxi0 : apply_fun xs12 i :e apply_fun Gfam12 0.
		            {
		              rewrite (apply_fun_graph (UPair 0 1) (fun j:set => if j = 0 then G1 else G2) 0 (UPairI1 0 1)).
		              rewrite (If_i_1 (0 = 0) G1 G2 (eq_refl 0)).
		              exact HxiG1.
		            }
		            apply (Hxs12_fam (ordsucc i) Hsi). let beta. assume Hbeta_pack.
		            apply (and3E
		              (beta :e (UPair 0 1))
		              (apply_fun xs12 (ordsucc i) :e apply_fun Gfam12 beta)
		              (apply_fun xs12 (ordsucc i) <> eG)
		              Hbeta_pack).
		            assume HbeU Hxsi _.
		            claim Hadj :
		              forall alpha beta0:set,
		                alpha :e (UPair 0 1) -> beta0 :e (UPair 0 1) ->
		                  apply_fun xs12 i :e apply_fun Gfam12 alpha ->
		                  apply_fun xs12 (ordsucc i) :e apply_fun Gfam12 beta0 ->
		                  alpha <> beta0.
		            {
		              apply (and3E
		                (n12 :e omega)
		                (forall j:set, j :e n12 ->
		                  exists alpha:set, alpha :e (UPair 0 1) /\
		                    apply_fun xs12 j :e apply_fun Gfam12 alpha /\
		                    apply_fun xs12 j <> apply_fun (graph (UPair 0 1) (fun i:set => eG)) alpha)
		                (forall j:set, j :e n12 -> ordsucc j :e n12 ->
		                  forall alpha beta0:set, alpha :e (UPair 0 1) -> beta0 :e (UPair 0 1) ->
		                    apply_fun xs12 j :e apply_fun Gfam12 alpha ->
		                    apply_fun xs12 (ordsucc j) :e apply_fun Gfam12 beta0 ->
		                    alpha <> beta0)
		                Hred12word).
		              assume _ _ Hadj. exact (Hadj i Hi Hsi).
		            }
		            claim H0_ne_beta : 0 <> beta.
		            { exact (Hadj 0 beta (UPairI1 0 1) HbeU Hxi0 Hxsi). }
			            claim Hbeta1 : beta = 1.
			            {
			              apply (UPairE beta 0 1 HbeU).
			              - assume Hb0. exact (FalseE (H0_ne_beta (eq_symm beta 0 Hb0)) (beta = 1)).
			              - assume Hb1. exact Hb1.
			            }
		            claim HGfam1 : apply_fun Gfam12 beta = G2.
		            {
		              rewrite (apply_fun_graph (UPair 0 1) (fun j:set => if j = 0 then G1 else G2) beta HbeU).
		              rewrite Hbeta1.
		              rewrite (If_i_0 (1 = 0) G1 G2 neq_1_0).
		              reflexivity.
		            }
		            exact (eq_subst_mem_set (apply_fun xs12 (ordsucc i)) (apply_fun Gfam12 beta) G2 Hxsi HGfam1).
		          - assume HxiG2.
		            claim Hxi1 : apply_fun xs12 i :e apply_fun Gfam12 1.
		            {
		              rewrite (apply_fun_graph (UPair 0 1) (fun j:set => if j = 0 then G1 else G2) 1 (UPairI2 0 1)).
		              rewrite (If_i_0 (1 = 0) G1 G2 neq_1_0).
		              exact HxiG2.
		            }
		            apply (Hxs12_fam (ordsucc i) Hsi). let beta. assume Hbeta_pack.
		            apply (and3E
		              (beta :e (UPair 0 1))
		              (apply_fun xs12 (ordsucc i) :e apply_fun Gfam12 beta)
		              (apply_fun xs12 (ordsucc i) <> eG)
		              Hbeta_pack).
		            assume HbeU Hxsi _.
		            claim Hadj :
		              forall alpha beta0:set,
		                alpha :e (UPair 0 1) -> beta0 :e (UPair 0 1) ->
		                  apply_fun xs12 i :e apply_fun Gfam12 alpha ->
		                  apply_fun xs12 (ordsucc i) :e apply_fun Gfam12 beta0 ->
		                  alpha <> beta0.
		            {
		              apply (and3E
		                (n12 :e omega)
		                (forall j:set, j :e n12 ->
		                  exists alpha:set, alpha :e (UPair 0 1) /\
		                    apply_fun xs12 j :e apply_fun Gfam12 alpha /\
		                    apply_fun xs12 j <> apply_fun (graph (UPair 0 1) (fun i:set => eG)) alpha)
		                (forall j:set, j :e n12 -> ordsucc j :e n12 ->
		                  forall alpha beta0:set, alpha :e (UPair 0 1) -> beta0 :e (UPair 0 1) ->
		                    apply_fun xs12 j :e apply_fun Gfam12 alpha ->
		                    apply_fun xs12 (ordsucc j) :e apply_fun Gfam12 beta0 ->
		                    alpha <> beta0)
		                Hred12word).
		              assume _ _ Hadj. exact (Hadj i Hi Hsi).
		            }
		            claim H1_ne_beta : 1 <> beta.
		            { exact (Hadj 1 beta (UPairI2 0 1) HbeU Hxi1 Hxsi). }
			            claim Hbeta0 : beta = 0.
			            {
			              apply (UPairE beta 0 1 HbeU).
			              - assume Hb0. exact Hb0.
			              - assume Hb1. exact (FalseE (H1_ne_beta (eq_symm beta 1 Hb1)) (beta = 0)).
			            }
		            claim HGfam0 : apply_fun Gfam12 beta = G1.
		            {
		              rewrite (apply_fun_graph (UPair 0 1) (fun j:set => if j = 0 then G1 else G2) beta HbeU).
		              rewrite Hbeta0.
		              rewrite (If_i_1 (0 = 0) G1 G2 (eq_refl 0)).
		              reflexivity.
		            }
		            exact (eq_subst_mem_set (apply_fun xs12 (ordsucc i)) (apply_fun Gfam12 beta) G1 Hxsi HGfam0).
		        }

		        (** TODO: n12 >= 3 case. Use Hexp_red_each_G1_non_e / Hexp_red_each_G2_non_e and
		            fold over xs12 with Happend_word_G1 / Happend_word_G2. **)
		        apply Hn12_succ. let kmax. assume Hkmax_pack.
		        claim Hkmax_nat : nat_p kmax.
		        { exact (andEL (nat_p kmax) (n12 = ordsucc kmax) Hkmax_pack). }
		        claim Hn12_eq : n12 = ordsucc kmax.
		        { exact (andER (nat_p kmax) (n12 = ordsucc kmax) Hkmax_pack). }
		        claim Hkmax_in12 : kmax :e n12.
		        { rewrite Hn12_eq. exact (ordsuccI2 kmax). }

		        claim Hbuild :
		          forall t:set, nat_p t ->
		            (t :e n12 ->
		              exists m zs:set,
		                reduced_word (J :\/: K) Hfam efamH m zs /\ m <> 0 /\
		                word_product multG eG zs m = word_product multG eG xs12 (ordsucc t) /\
		                (forall i:set, i :e m -> apply_fun zs i <> eG) /\
		                ((apply_fun xs12 t :e G1 /\ exists r:set, m = ordsucc r /\ apply_fun zs r :e G1) \/
			                 (apply_fun xs12 t :e G2 /\ exists r:set, m = ordsucc r /\ apply_fun zs r :e G2))).
			        {
			          let u. assume Hu_nat.
			          apply (nat_ind (fun t0:set =>
			            t0 :e n12 ->
			              exists m zs:set,
			                reduced_word (J :\/: K) Hfam efamH m zs /\ m <> 0 /\
		                word_product multG eG zs m = word_product multG eG xs12 (ordsucc t0) /\
		                (forall i:set, i :e m -> apply_fun zs i <> eG) /\
		                ((apply_fun xs12 t0 :e G1 /\ exists r:set, m = ordsucc r /\ apply_fun zs r :e G1) \/
		                 (apply_fun xs12 t0 :e G2 /\ exists r:set, m = ordsucc r /\ apply_fun zs r :e G2)))).
		          - assume H0in12 : 0 :e n12.
		            apply (Hxs12_side 0 H0in12).
		            + assume Hx0G1 : apply_fun xs12 0 :e G1.
		              apply (Hexp_red_each_G1_non_e 0 H0in12 Hx0G1).
		              let m0. assume Hm0_pack.
		              apply Hm0_pack. let ys0. assume Hys0_pack.
		              apply (and5E
		                (reduced_word (J :\/: K) Hfam efamH m0 ys0)
		                (m0 <> 0)
		                (word_product multG eG ys0 m0 = apply_fun xs12 0)
		                (forall j:set, j :e m0 -> apply_fun ys0 j :e G1)
		                (forall j:set, j :e m0 -> apply_fun ys0 j <> eG)
		                Hys0_pack).
		              assume Hred0 Hm0_ne Hwp0 HallG1 HallNe0.
		              claim Hx0G : apply_fun xs12 0 :e G.
		              { exact (subgroup_of_subset G1 G multG eG invG Hsub1 (apply_fun xs12 0) Hx0G1). }
		              claim Hwp_bin0 : word_product multG eG xs12 (ordsucc 0) = apply_fun xs12 0.
		              {
		                rewrite ordsucc_0_eq_1_nat.
		                claim Hwp1 : word_product multG eG xs12 1 =
		                  apply_fun multG (word_product multG eG xs12 0, apply_fun xs12 0).
		                { exact (word_product_succ multG eG xs12 0 nat_0). }
		                claim Hwp0z : word_product multG eG xs12 0 = eG.
		                {
		                  exact (nat_primrec_0 eG
		                    (fun i r => apply_fun multG (r, apply_fun xs12 i))).
		                }
		                apply (and6E
		                  (function_on multG (setprod G G) G)
		                  (function_on invG G G)
		                  (eG :e G)
		                  (forall x0 y z:set, x0 :e G -> y :e G -> z :e G ->
		                    apply_fun multG (apply_fun multG (x0, y), z) = apply_fun multG (x0, apply_fun multG (y, z)))
		                  (forall x0:set, x0 :e G -> apply_fun multG (eG, x0) = x0 /\ apply_fun multG (x0, eG) = x0)
		                  (forall x0:set, x0 :e G ->
		                    apply_fun multG (x0, apply_fun invG x0) = eG /\ apply_fun multG (apply_fun invG x0, x0) = eG)
		                  Hgrp).
		                assume _ _ _ _ HidG _.
		                rewrite Hwp1.
		                rewrite Hwp0z.
		                exact (andEL
		                  (apply_fun multG (eG, apply_fun xs12 0) = apply_fun xs12 0)
		                  (apply_fun multG (apply_fun xs12 0, eG) = apply_fun xs12 0)
		                  (HidG (apply_fun xs12 0) Hx0G)).
		              }
		              witness m0. witness ys0.
		              apply and5I.
		              * exact Hred0.
		              * exact Hm0_ne.
		              * rewrite Hwp0.
		                exact (eq_symm (word_product multG eG xs12 (ordsucc 0)) (apply_fun xs12 0) Hwp_bin0).
		              * exact HallNe0.
		              * apply orIL.
		                apply andI.
		                { exact Hx0G1. }
		                claim Hm0O : m0 :e omega.
		                {
		                  apply (and3E
		                    (m0 :e omega)
		                    (forall i:set, i :e m0 ->
		                      exists alpha:set, alpha :e (J :\/: K) /\
		                        apply_fun ys0 i :e apply_fun Hfam alpha /\
		                        apply_fun ys0 i <> apply_fun efamH alpha)
		                    (forall i:set, i :e m0 -> ordsucc i :e m0 ->
		                      forall alpha beta:set, alpha :e (J :\/: K) -> beta :e (J :\/: K) ->
		                        apply_fun ys0 i :e apply_fun Hfam alpha ->
		                        apply_fun ys0 (ordsucc i) :e apply_fun Hfam beta ->
		                        alpha <> beta)
		                    Hred0).
		                  assume Hm0O _ _. exact Hm0O.
		                }
		                claim Hm0_nat : nat_p m0.
		                { exact (omega_nat_p m0 Hm0O). }
		                claim Hm0_succ : exists r:set, nat_p r /\ m0 = ordsucc r.
		                {
		                  apply (nat_inv m0 Hm0_nat).
		                  - assume Hm0z.
		                    exact (FalseE (Hm0_ne Hm0z) (exists r:set, nat_p r /\ m0 = ordsucc r)).
		                  - assume Hr_ex. exact Hr_ex.
		                }
		                apply Hm0_succ. let r. assume Hr_pack.
		                witness r.
		                apply andI.
		                { exact (andER (nat_p r) (m0 = ordsucc r) Hr_pack). }
		                claim Hr_in : r :e m0.
		                { rewrite (andER (nat_p r) (m0 = ordsucc r) Hr_pack). exact (ordsuccI2 r). }
		                exact (HallG1 r Hr_in).
		            + assume Hx0G2 : apply_fun xs12 0 :e G2.
		              apply (Hexp_red_each_G2_non_e 0 H0in12 Hx0G2).
		              let m0. assume Hm0_pack.
		              apply Hm0_pack. let ys0. assume Hys0_pack.
		              apply (and5E
		                (reduced_word (J :\/: K) Hfam efamH m0 ys0)
		                (m0 <> 0)
		                (word_product multG eG ys0 m0 = apply_fun xs12 0)
		                (forall j:set, j :e m0 -> apply_fun ys0 j :e G2)
		                (forall j:set, j :e m0 -> apply_fun ys0 j <> eG)
		                Hys0_pack).
		              assume Hred0 Hm0_ne Hwp0 HallG2 HallNe0.
		              claim Hx0G : apply_fun xs12 0 :e G.
		              { exact (subgroup_of_subset G2 G multG eG invG Hsub2 (apply_fun xs12 0) Hx0G2). }
		              claim Hwp_bin0 : word_product multG eG xs12 (ordsucc 0) = apply_fun xs12 0.
		              {
		                rewrite ordsucc_0_eq_1_nat.
		                claim Hwp1 : word_product multG eG xs12 1 =
		                  apply_fun multG (word_product multG eG xs12 0, apply_fun xs12 0).
		                { exact (word_product_succ multG eG xs12 0 nat_0). }
		                claim Hwp0z : word_product multG eG xs12 0 = eG.
		                {
		                  exact (nat_primrec_0 eG
		                    (fun i r => apply_fun multG (r, apply_fun xs12 i))).
		                }
		                apply (and6E
		                  (function_on multG (setprod G G) G)
		                  (function_on invG G G)
		                  (eG :e G)
		                  (forall x0 y z:set, x0 :e G -> y :e G -> z :e G ->
		                    apply_fun multG (apply_fun multG (x0, y), z) = apply_fun multG (x0, apply_fun multG (y, z)))
		                  (forall x0:set, x0 :e G -> apply_fun multG (eG, x0) = x0 /\ apply_fun multG (x0, eG) = x0)
		                  (forall x0:set, x0 :e G ->
		                    apply_fun multG (x0, apply_fun invG x0) = eG /\ apply_fun multG (apply_fun invG x0, x0) = eG)
		                  Hgrp).
		                assume _ _ _ _ HidG _.
		                rewrite Hwp1.
		                rewrite Hwp0z.
		                exact (andEL
		                  (apply_fun multG (eG, apply_fun xs12 0) = apply_fun xs12 0)
		                  (apply_fun multG (apply_fun xs12 0, eG) = apply_fun xs12 0)
		                  (HidG (apply_fun xs12 0) Hx0G)).
		              }
		              witness m0. witness ys0.
		              apply and5I.
		              * exact Hred0.
		              * exact Hm0_ne.
		              * rewrite Hwp0.
		                exact (eq_symm (word_product multG eG xs12 (ordsucc 0)) (apply_fun xs12 0) Hwp_bin0).
		              * exact HallNe0.
		              * apply orIR.
		                apply andI.
		                { exact Hx0G2. }
		                claim Hm0O : m0 :e omega.
		                {
		                  apply (and3E
		                    (m0 :e omega)
		                    (forall i:set, i :e m0 ->
		                      exists alpha:set, alpha :e (J :\/: K) /\
		                        apply_fun ys0 i :e apply_fun Hfam alpha /\
		                        apply_fun ys0 i <> apply_fun efamH alpha)
		                    (forall i:set, i :e m0 -> ordsucc i :e m0 ->
		                      forall alpha beta:set, alpha :e (J :\/: K) -> beta :e (J :\/: K) ->
		                        apply_fun ys0 i :e apply_fun Hfam alpha ->
		                        apply_fun ys0 (ordsucc i) :e apply_fun Hfam beta ->
		                        alpha <> beta)
		                    Hred0).
		                  assume Hm0O _ _. exact Hm0O.
		                }
		                claim Hm0_nat : nat_p m0.
		                { exact (omega_nat_p m0 Hm0O). }
		                claim Hm0_succ : exists r:set, nat_p r /\ m0 = ordsucc r.
		                {
		                  apply (nat_inv m0 Hm0_nat).
		                  - assume Hm0z.
		                    exact (FalseE (Hm0_ne Hm0z) (exists r:set, nat_p r /\ m0 = ordsucc r)).
		                  - assume Hr_ex. exact Hr_ex.
		                }
		                apply Hm0_succ. let r. assume Hr_pack.
		                witness r.
		                apply andI.
		                { exact (andER (nat_p r) (m0 = ordsucc r) Hr_pack). }
		                claim Hr_in : r :e m0.
		                { rewrite (andER (nat_p r) (m0 = ordsucc r) Hr_pack). exact (ordsuccI2 r). }
		                exact (HallG2 r Hr_in).
		          - let t. assume Ht_nat IHt.
		            assume Hst_in12 : ordsucc t :e n12.
		            claim Hn12_ord : ordinal n12.
		            { exact (nat_p_ordinal n12 Hn12_nat). }
		            claim Hst_sub : ordsucc t c= n12.
		            { exact (ordinal_TransSet n12 Hn12_ord (ordsucc t) Hst_in12). }
		            claim Ht_in12 : t :e n12.
		            { exact (Hst_sub t (ordsuccI2 t)). }
		            apply (IHt Ht_in12).
		            let m. assume Hm_pack.
		            apply Hm_pack. let zs. assume Hzs_pack.
		            apply (and5E
		              (reduced_word (J :\/: K) Hfam efamH m zs)
		              (m <> 0)
		              (word_product multG eG zs m = word_product multG eG xs12 (ordsucc t))
		              (forall i:set, i :e m -> apply_fun zs i <> eG)
		              ((apply_fun xs12 t :e G1 /\ exists r:set, m = ordsucc r /\ apply_fun zs r :e G1) \/
		               (apply_fun xs12 t :e G2 /\ exists r:set, m = ordsucc r /\ apply_fun zs r :e G2))
		              Hzs_pack).
		            assume Hred_zs Hm_ne0 Hwp_zs HallNe_zs Hlast_side.
		            apply Hlast_side.
		            + assume HcaseG1.
		              claim HxtG1 : apply_fun xs12 t :e G1.
		              { exact (andEL (apply_fun xs12 t :e G1) (exists r:set, m = ordsucc r /\ apply_fun zs r :e G1) HcaseG1). }
		              claim HnextG2 : apply_fun xs12 (ordsucc t) :e G2.
		              {
		                claim Hadj_pack :
		                  (apply_fun xs12 t :e G1 -> apply_fun xs12 (ordsucc t) :e G2) /\
		                  (apply_fun xs12 t :e G2 -> apply_fun xs12 (ordsucc t) :e G1).
		                { exact (Hxs12_adj_side t Ht_in12 Hst_in12). }
		                exact ((andEL
		                  (apply_fun xs12 t :e G1 -> apply_fun xs12 (ordsucc t) :e G2)
		                  (apply_fun xs12 t :e G2 -> apply_fun xs12 (ordsucc t) :e G1)
		                  Hadj_pack) HxtG1).
		              }
		              apply (Hexp_red_each_G2_non_e (ordsucc t) Hst_in12 HnextG2).
		              let p. assume Hp_pack.
		              apply Hp_pack. let ys. assume Hys_pack.
		              apply (and5E
		                (reduced_word (J :\/: K) Hfam efamH p ys)
		                (p <> 0)
		                (word_product multG eG ys p = apply_fun xs12 (ordsucc t))
		                (forall j:set, j :e p -> apply_fun ys j :e G2)
		                (forall j:set, j :e p -> apply_fun ys j <> eG)
		                Hys_pack).
		              assume Hred_ys Hp_ne0 Hwp_ys HallG2_ys HallNe_ys.
		              claim Hboundary :
		                forall k alpha beta:set, m = ordsucc k -> alpha :e J :\/: K -> beta :e J :\/: K ->
		                  apply_fun zs k :e apply_fun Hfam alpha ->
		                  apply_fun ys 0 :e apply_fun Hfam beta ->
		                  alpha <> beta.
		              {
		                let k alpha beta.
		                assume Hm_eq Hal Hbe Hzk Hy0.
		                apply (andER (apply_fun xs12 t :e G1) (exists r:set, m = ordsucc r /\ apply_fun zs r :e G1) HcaseG1).
		                let r. assume Hr_pack.
		                claim Hmr : m = ordsucc r.
		                { exact (andEL (m = ordsucc r) (apply_fun zs r :e G1) Hr_pack). }
		                claim HzrG1 : apply_fun zs r :e G1.
		                { exact (andER (m = ordsucc r) (apply_fun zs r :e G1) Hr_pack). }
		                claim Hsk_eq : ordsucc k = ordsucc r.
		                { exact (eq_i_tra (ordsucc k) m (ordsucc r) (eq_symm m (ordsucc k) Hm_eq) Hmr). }
		                claim Hk_eq : k = r.
		                { exact (ordsucc_inj k r Hsk_eq). }
		                claim Hk_in : k :e m.
		                { rewrite Hm_eq. exact (ordsuccI2 k). }
		                claim HzkG1 : apply_fun zs k :e G1.
		                { rewrite Hk_eq. exact HzrG1. }
		                claim Hzk_ne : apply_fun zs k <> eG.
		                { exact (HallNe_zs k Hk_in). }
		                claim HpO : p :e omega.
		                {
		                  apply (and3E
		                    (p :e omega)
		                    (forall j:set, j :e p ->
		                      exists alpha0:set, alpha0 :e (J :\/: K) /\
		                        apply_fun ys j :e apply_fun Hfam alpha0 /\
		                        apply_fun ys j <> apply_fun efamH alpha0)
		                    (forall j:set, j :e p -> ordsucc j :e p ->
		                      forall alpha0 beta0:set, alpha0 :e (J :\/: K) -> beta0 :e (J :\/: K) ->
		                        apply_fun ys j :e apply_fun Hfam alpha0 ->
		                        apply_fun ys (ordsucc j) :e apply_fun Hfam beta0 ->
		                        alpha0 <> beta0)
		                    Hred_ys).
		                  assume HpO _ _. exact HpO.
		                }
		                claim Hp_nat : nat_p p.
		                { exact (omega_nat_p p HpO). }
		                claim Hp_succ : exists rp:set, nat_p rp /\ p = ordsucc rp.
		                {
		                  apply (nat_inv p Hp_nat).
		                  - assume Hp0. exact (FalseE (Hp_ne0 Hp0) (exists rp:set, nat_p rp /\ p = ordsucc rp)).
		                  - assume Hr_ex. exact Hr_ex.
		                }
		                apply Hp_succ. let rp. assume Hrp_pack.
		                claim H0in_p : 0 :e p.
		                { rewrite (andER (nat_p rp) (p = ordsucc rp) Hrp_pack). exact (nat_0_in_ordsucc rp (andEL (nat_p rp) (p = ordsucc rp) Hrp_pack)). }
		                claim Hy0G2 : apply_fun ys 0 :e G2.
		                { exact (HallG2_ys 0 H0in_p). }
		                claim Hy0_ne : apply_fun ys 0 <> eG.
		                { exact (HallNe_ys 0 H0in_p). }
		                exact (Halpha_beta_diff
		                  (apply_fun zs k) (apply_fun ys 0) alpha beta
		                  HzkG1 Hzk_ne Hy0G2 Hy0_ne
		                  Hal Hbe Hzk Hy0).
		              }
		              apply (Happend_word_G2 m zs Hred_zs Hm_ne0 HallNe_zs p ys Hred_ys Hp_ne0 HallG2_ys HallNe_ys Hboundary).
		              let m'. assume Hm'_pack.
		              apply Hm'_pack. let zs'. assume Hzs'_pack.
		              apply (and4E
		                (reduced_word (J :\/: K) Hfam efamH m' zs')
		                (word_product multG eG zs' m' =
		                  apply_fun multG (word_product multG eG zs m, word_product multG eG ys p))
		                (forall i:set, i :e m' -> apply_fun zs' i <> eG)
		                (exists r:set, m' = ordsucc r /\ apply_fun zs' r :e G2)
		                Hzs'_pack).
		              assume Hred_zs' Hprod_zs' HallNe_zs' HlastG2.
		              claim Hm'_ne0 : m' <> 0.
		              {
		                apply HlastG2. let r. assume Hr_pack.
		                claim Hr_eq : m' = ordsucc r.
		                { exact (andEL (m' = ordsucc r) (apply_fun zs' r :e G2) Hr_pack). }
		                rewrite Hr_eq.
		                exact (neq_ordsucc_0 r).
		              }
		              witness m'. witness zs'.
		              apply and5I.
		              * exact Hred_zs'.
		              * exact Hm'_ne0.
		              * rewrite Hprod_zs'.
		                rewrite Hwp_zs.
		                rewrite Hwp_ys.
		                exact (eq_symm
		                  (word_product multG eG xs12 (ordsucc (ordsucc t)))
		                  (apply_fun multG (word_product multG eG xs12 (ordsucc t), apply_fun xs12 (ordsucc t)))
		                  (word_product_succ multG eG xs12 (ordsucc t) (nat_ordsucc t Ht_nat))).
		              * exact HallNe_zs'.
		              * apply orIR.
		                apply andI.
		                { exact HnextG2. }
		                { exact HlastG2. }
		            + assume HcaseG2.
		              claim HxtG2 : apply_fun xs12 t :e G2.
		              { exact (andEL (apply_fun xs12 t :e G2) (exists r:set, m = ordsucc r /\ apply_fun zs r :e G2) HcaseG2). }
		              claim HnextG1 : apply_fun xs12 (ordsucc t) :e G1.
		              {
		                claim Hadj_pack :
		                  (apply_fun xs12 t :e G1 -> apply_fun xs12 (ordsucc t) :e G2) /\
		                  (apply_fun xs12 t :e G2 -> apply_fun xs12 (ordsucc t) :e G1).
		                { exact (Hxs12_adj_side t Ht_in12 Hst_in12). }
		                exact ((andER
		                  (apply_fun xs12 t :e G1 -> apply_fun xs12 (ordsucc t) :e G2)
		                  (apply_fun xs12 t :e G2 -> apply_fun xs12 (ordsucc t) :e G1)
		                  Hadj_pack) HxtG2).
		              }
		              apply (Hexp_red_each_G1_non_e (ordsucc t) Hst_in12 HnextG1).
		              let p. assume Hp_pack.
		              apply Hp_pack. let ys. assume Hys_pack.
		              apply (and5E
		                (reduced_word (J :\/: K) Hfam efamH p ys)
		                (p <> 0)
		                (word_product multG eG ys p = apply_fun xs12 (ordsucc t))
		                (forall j:set, j :e p -> apply_fun ys j :e G1)
		                (forall j:set, j :e p -> apply_fun ys j <> eG)
		                Hys_pack).
		              assume Hred_ys Hp_ne0 Hwp_ys HallG1_ys HallNe_ys.
		              claim Hboundary :
		                forall k alpha beta:set, m = ordsucc k -> alpha :e J :\/: K -> beta :e J :\/: K ->
		                  apply_fun zs k :e apply_fun Hfam alpha ->
		                  apply_fun ys 0 :e apply_fun Hfam beta ->
		                  alpha <> beta.
		              {
		                let k alpha beta.
		                assume Hm_eq Hal Hbe Hzk Hy0.
		                apply (andER (apply_fun xs12 t :e G2) (exists r:set, m = ordsucc r /\ apply_fun zs r :e G2) HcaseG2).
		                let r. assume Hr_pack.
		                claim Hmr : m = ordsucc r.
		                { exact (andEL (m = ordsucc r) (apply_fun zs r :e G2) Hr_pack). }
		                claim HzrG2 : apply_fun zs r :e G2.
		                { exact (andER (m = ordsucc r) (apply_fun zs r :e G2) Hr_pack). }
		                claim Hsk_eq : ordsucc k = ordsucc r.
		                { exact (eq_i_tra (ordsucc k) m (ordsucc r) (eq_symm m (ordsucc k) Hm_eq) Hmr). }
		                claim Hk_eq : k = r.
		                { exact (ordsucc_inj k r Hsk_eq). }
		                claim Hk_in : k :e m.
		                { rewrite Hm_eq. exact (ordsuccI2 k). }
		                claim HzkG2 : apply_fun zs k :e G2.
		                { rewrite Hk_eq. exact HzrG2. }
		                claim Hzk_ne : apply_fun zs k <> eG.
		                { exact (HallNe_zs k Hk_in). }
		                claim HpO : p :e omega.
		                {
		                  apply (and3E
		                    (p :e omega)
		                    (forall j:set, j :e p ->
		                      exists alpha0:set, alpha0 :e (J :\/: K) /\
		                        apply_fun ys j :e apply_fun Hfam alpha0 /\
		                        apply_fun ys j <> apply_fun efamH alpha0)
		                    (forall j:set, j :e p -> ordsucc j :e p ->
		                      forall alpha0 beta0:set, alpha0 :e (J :\/: K) -> beta0 :e (J :\/: K) ->
		                        apply_fun ys j :e apply_fun Hfam alpha0 ->
		                        apply_fun ys (ordsucc j) :e apply_fun Hfam beta0 ->
		                        alpha0 <> beta0)
		                    Hred_ys).
		                  assume HpO _ _. exact HpO.
		                }
		                claim Hp_nat : nat_p p.
		                { exact (omega_nat_p p HpO). }
		                claim Hp_succ : exists rp:set, nat_p rp /\ p = ordsucc rp.
		                {
		                  apply (nat_inv p Hp_nat).
		                  - assume Hp0. exact (FalseE (Hp_ne0 Hp0) (exists rp:set, nat_p rp /\ p = ordsucc rp)).
		                  - assume Hr_ex. exact Hr_ex.
		                }
		                apply Hp_succ. let rp. assume Hrp_pack.
		                claim H0in_p : 0 :e p.
		                { rewrite (andER (nat_p rp) (p = ordsucc rp) Hrp_pack). exact (nat_0_in_ordsucc rp (andEL (nat_p rp) (p = ordsucc rp) Hrp_pack)). }
		                claim Hy0G1 : apply_fun ys 0 :e G1.
		                { exact (HallG1_ys 0 H0in_p). }
		                claim Hy0_ne : apply_fun ys 0 <> eG.
		                { exact (HallNe_ys 0 H0in_p). }
		                exact (neq_i_sym beta alpha
		                  (Halpha_beta_diff
		                    (apply_fun ys 0) (apply_fun zs k) beta alpha
		                    Hy0G1 Hy0_ne HzkG2 Hzk_ne
		                    Hbe Hal Hy0 Hzk)).
		              }
		              apply (Happend_word_G1 m zs Hred_zs Hm_ne0 HallNe_zs p ys Hred_ys Hp_ne0 HallG1_ys HallNe_ys Hboundary).
		              let m'. assume Hm'_pack.
		              apply Hm'_pack. let zs'. assume Hzs'_pack.
		              apply (and4E
		                (reduced_word (J :\/: K) Hfam efamH m' zs')
		                (word_product multG eG zs' m' =
		                  apply_fun multG (word_product multG eG zs m, word_product multG eG ys p))
		                (forall i:set, i :e m' -> apply_fun zs' i <> eG)
		                (exists r:set, m' = ordsucc r /\ apply_fun zs' r :e G1)
		                Hzs'_pack).
		              assume Hred_zs' Hprod_zs' HallNe_zs' HlastG1.
		              claim Hm'_ne0 : m' <> 0.
		              {
		                apply HlastG1. let r. assume Hr_pack.
		                claim Hr_eq : m' = ordsucc r.
		                { exact (andEL (m' = ordsucc r) (apply_fun zs' r :e G1) Hr_pack). }
		                rewrite Hr_eq.
		                exact (neq_ordsucc_0 r).
		              }
		              witness m'. witness zs'.
		              apply and5I.
		              * exact Hred_zs'.
		              * exact Hm'_ne0.
		              * rewrite Hprod_zs'.
		                rewrite Hwp_zs.
		                rewrite Hwp_ys.
		                exact (eq_symm
		                  (word_product multG eG xs12 (ordsucc (ordsucc t)))
		                  (apply_fun multG (word_product multG eG xs12 (ordsucc t), apply_fun xs12 (ordsucc t)))
		                  (word_product_succ multG eG xs12 (ordsucc t) (nat_ordsucc t Ht_nat))).
		              * exact HallNe_zs'.
		              * apply orIL.
			                apply andI.
			                { exact HnextG1. }
			                { exact HlastG1. }
			          - exact Hu_nat.
			        }

		        apply (Hbuild kmax Hkmax_nat Hkmax_in12).
		        let n. assume Hn_pack. apply Hn_pack.
		        let xs. assume Hxs_pack.
		        apply (and5E
		          (reduced_word (J :\/: K) Hfam efamH n xs)
		          (n <> 0)
		          (word_product multG eG xs n = word_product multG eG xs12 (ordsucc kmax))
		          (forall i:set, i :e n -> apply_fun xs i <> eG)
		          ((apply_fun xs12 kmax :e G1 /\ exists r:set, n = ordsucc r /\ apply_fun xs r :e G1) \/
		           (apply_fun xs12 kmax :e G2 /\ exists r:set, n = ordsucc r /\ apply_fun xs r :e G2))
		          Hxs_pack).
		        assume Hred Hn_ne Hwp HallNe Hlast_side.
		        witness n. witness xs.
		        apply and4I.
		        - exact Hred.
		        - exact Hn_ne.
		        - rewrite Hwp.
		          rewrite <- Hn12_eq.
		          exact Hwp12.
						- let n' xs'. assume Hred' Hn'_ne Hwp'.
						  claim Hwp'_eq :
						    word_product multG eG xs' n' = word_product multG eG xs12 (ordsucc kmax).
						  {
						    rewrite Hwp'.
						    rewrite <- Hwp12.
						    rewrite Hn12_eq.
						    reflexivity.
						  }
						  claim Huniq_binprefix :
						    forall t:set, nat_p t -> t :e n12 -> t <> 0 ->
						      forall nA xsA nB xsB:set,
						        reduced_word (J :\/: K) Hfam efamH nA xsA -> nA <> 0 ->
						        word_product multG eG xsA nA = word_product multG eG xs12 (ordsucc t) ->
						        reduced_word (J :\/: K) Hfam efamH nB xsB -> nB <> 0 ->
						        word_product multG eG xsB nB = word_product multG eG xs12 (ordsucc t) ->
						        nA = nB /\ (forall i:set, i :e nA -> apply_fun xsA i = apply_fun xsB i).
							  {
							    let t. assume Ht_nat.
							    set P := fun t0:set =>
							      t0 :e n12 -> t0 <> 0 ->
							        forall nA xsA nB xsB:set,
							          reduced_word (J :\/: K) Hfam efamH nA xsA -> nA <> 0 ->
							          word_product multG eG xsA nA = word_product multG eG xs12 (ordsucc t0) ->
							          reduced_word (J :\/: K) Hfam efamH nB xsB -> nB <> 0 ->
							          word_product multG eG xsB nB = word_product multG eG xs12 (ordsucc t0) ->
							          nA = nB /\ (forall i:set, i :e nA -> apply_fun xsA i = apply_fun xsB i).
							    claim Hstep :
							      forall t0:set, nat_p t0 ->
							        (forall r:set, r :e t0 -> P r) ->
							        P t0.
							    {
							      let t. assume Ht_nat IHt.
							      assume Ht_in12 Ht_ne0.
							    let nA xsA nB xsB.
							    assume HredA HnA_ne0 HwpA HredB HnB_ne0 HwpB.

						    set xt := word_product multG eG xs12 (ordsucc t).

						    claim Hn12O : n12 :e omega.
						    {
						      apply (and3E
						        (n12 :e omega)
						        (forall i:set, i :e n12 ->
						          exists alpha:set, alpha :e (UPair 0 1) /\
						            apply_fun xs12 i :e apply_fun Gfam12 alpha /\
						            apply_fun xs12 i <> apply_fun (graph (UPair 0 1) (fun _:set => eG)) alpha)
						        (forall i:set, i :e n12 -> ordsucc i :e n12 ->
						          forall alpha beta:set, alpha :e (UPair 0 1) -> beta :e (UPair 0 1) ->
						            apply_fun xs12 i :e apply_fun Gfam12 alpha ->
						            apply_fun xs12 (ordsucc i) :e apply_fun Gfam12 beta ->
						            alpha <> beta)
						        Hred12word).
						      assume Hn12O0 _ _. exact Hn12O0.
						    }
						    claim Hn12_nat : nat_p n12. { exact (omega_nat_p n12 Hn12O). }
						    claim Hn12_ord : ordinal n12. { exact (nat_p_ordinal n12 Hn12_nat). }
						    claim Hst_sub : ordsucc t c= n12.
						    { exact (ordinal_ordsucc_In_Subq n12 Hn12_ord t Ht_in12). }

						    claim Hred12t :
						      reduced_word (UPair 0 1) Gfam12 (graph (UPair 0 1) (fun _:set => eG)) (ordsucc t) xs12.
						    {
						      apply (and3E
						        (n12 :e omega)
						        (forall i:set, i :e n12 ->
						          exists alpha:set, alpha :e (UPair 0 1) /\
						            apply_fun xs12 i :e apply_fun Gfam12 alpha /\
						            apply_fun xs12 i <> apply_fun (graph (UPair 0 1) (fun _:set => eG)) alpha)
						        (forall i:set, i :e n12 -> ordsucc i :e n12 ->
						          forall alpha beta:set, alpha :e (UPair 0 1) -> beta :e (UPair 0 1) ->
						            apply_fun xs12 i :e apply_fun Gfam12 alpha ->
						            apply_fun xs12 (ordsucc i) :e apply_fun Gfam12 beta ->
						            alpha <> beta)
						        Hred12word).
						      assume _ Hxs12fam Hxs12adj.
						      prove (ordsucc t :e omega) /\
						        (forall i:set, i :e ordsucc t ->
						          exists alpha:set, alpha :e (UPair 0 1) /\
						            apply_fun xs12 i :e apply_fun Gfam12 alpha /\
						            apply_fun xs12 i <> apply_fun (graph (UPair 0 1) (fun _:set => eG)) alpha) /\
						        (forall i:set, i :e ordsucc t -> ordsucc i :e ordsucc t ->
						          forall alpha beta:set, alpha :e (UPair 0 1) -> beta :e (UPair 0 1) ->
						            apply_fun xs12 i :e apply_fun Gfam12 alpha ->
						            apply_fun xs12 (ordsucc i) :e apply_fun Gfam12 beta ->
						            alpha <> beta).
						      apply and3I.
						      - exact (nat_p_omega (ordsucc t) (nat_ordsucc t Ht_nat)).
						      - let i. assume Hi.
						        claim Hi12 : i :e n12. { exact (Hst_sub i Hi). }
						        exact (Hxs12fam i Hi12).
						      - let i. assume Hi Hsi.
						        let alpha beta. assume Hal Hbe Hxi Hxsi.
						        claim Hi12 : i :e n12. { exact (Hst_sub i Hi). }
						        claim Hsi12 : ordsucc i :e n12. { exact (Hst_sub (ordsucc i) Hsi). }
						        exact (Hxs12adj i Hi12 Hsi12 alpha beta Hal Hbe Hxi Hxsi).
						    }

						    claim Hsn_ne0 : ordsucc t <> 0.
						    { exact (neq_ordsucc_0 t). }
						    claim Hsn_ne1 : ordsucc t <> 1.
						    {
						      assume Hs1.
						      claim Hs1' : ordsucc t = ordsucc 0.
						      { rewrite Hs1. symmetry. exact ordsucc_0_eq_1_nat. }
						      exact (Ht_ne0 (ordsucc_inj t 0 Hs1')).
						    }

						    claim Hxt_notG1 : xt /:e G1.
						    {
						      exact (free_product_binary_reduced_word_length_ge2_not_in_left_factor
						        G multG eG invG G1 G2 (ordsucc t) xs12
						        Hsub1 Hsub2 Hfp
						        Hred12t
						        Hsn_ne0
						        Hsn_ne1).
						    }
							    claim Hxt_notG2 : xt /:e G2.
							    {
							      exact (free_product_binary_reduced_word_length_ge2_not_in_right_factor
							        G multG eG invG G1 G2 (ordsucc t) xs12
							        Hsub1 Hsub2 Hfp
							        Hred12t
							        Hsn_ne0
							        Hsn_ne1).
							    }
							
							    (** The binary reduced word product is nontrivial. **)
								    claim Hxt_ne_e : xt <> eG.
								    {
								      exact (free_product_reduced_word_length_ge2_product_ne_e
								        G multG eG invG
								        (UPair 0 1)
								        (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2))
								        (graph (UPair 0 1) (fun _:set => eG))
								        (ordsucc t) xs12
								        Hfp
								        Hred12t
								        Hsn_ne0
								        Hsn_ne1).
								    }
								    
								    (** Uniqueness of the binary normal form for xt. **)
								    claim Huniq_xt :
								      forall n0 xs0:set,
								        reduced_word (UPair 0 1)
								          (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2))
								          (graph (UPair 0 1) (fun _:set => eG))
								          n0 xs0 ->
								        n0 <> 0 ->
								        word_product multG eG xs0 n0 = xt ->
								        ordsucc t = n0 /\
								          (forall i:set, i :e ordsucc t -> apply_fun xs12 i = apply_fun xs0 i).
								    {
								      let n0 xs0.
								      assume Hred0 Hn0_ne0 Hwp0.
								      apply (and6E
								        (group_structure G multG eG invG)
								        (forall alpha:set, alpha :e (UPair 0 1) ->
								          subgroup_of
								            (apply_fun (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2)) alpha)
								            G multG eG invG)
								        (forall alpha beta:set, alpha :e (UPair 0 1) -> beta :e (UPair 0 1) -> alpha <> beta ->
								          forall x:set,
								            x :e apply_fun (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2)) alpha ->
								            x :e apply_fun (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2)) beta ->
								            x = eG)
								        (subgroups_generate G multG eG invG (UPair 0 1)
								          (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2)))
								        (forall x:set, x :e G -> x <> eG ->
								          exists n1 xs1:set,
								            reduced_word (UPair 0 1)
								              (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2))
								              (graph (UPair 0 1) (fun _:set => eG))
								              n1 xs1 /\
								            n1 <> 0 /\
								            word_product multG eG xs1 n1 = x /\
								            (forall n' xs':set,
								              reduced_word (UPair 0 1)
								                (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2))
								                (graph (UPair 0 1) (fun _:set => eG))
								                n' xs' ->
								              n' <> 0 ->
								              word_product multG eG xs' n' = x ->
								              n1 = n' /\ (forall i0:set, i0 :e n1 -> apply_fun xs1 i0 = apply_fun xs' i0)))
								        (forall alpha:set, alpha :e (UPair 0 1) -> apply_fun (graph (UPair 0 1) (fun _:set => eG)) alpha = eG)
								        Hfp).
								      assume Hgrp0 Hsubfam12 _ _ Huniq_all _.
								      claim HxtG : xt :e G.
								      {
								        claim Hst_nat : nat_p (ordsucc t).
								        { exact (nat_ordsucc t Ht_nat). }
								        claim Hxs12G : forall i:set, i :e ordsucc t -> apply_fun xs12 i :e G.
								        {
								          exact (reduced_word_in_G
								            G multG eG invG
								            (UPair 0 1)
								            (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2))
								            (graph (UPair 0 1) (fun _:set => eG))
								            (ordsucc t) xs12
								            Hsubfam12
								            Hred12t).
								        }
								        exact (word_product_in_G_group
								          G multG eG invG (ordsucc t) xs12 Hgrp Hst_nat Hxs12G).
								      }
								      apply (Huniq_all xt HxtG Hxt_ne_e).
								      let n1. assume Hn1_pack.
								      apply Hn1_pack. let xs1. assume Hxs1_pack.
								      apply (and4E
								        (reduced_word (UPair 0 1)
								          (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2))
								          (graph (UPair 0 1) (fun _:set => eG))
								          n1 xs1)
								        (n1 <> 0)
								        (word_product multG eG xs1 n1 = xt)
								        (forall n' xs':set,
								          reduced_word (UPair 0 1)
								            (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2))
								            (graph (UPair 0 1) (fun _:set => eG))
								            n' xs' ->
								          n' <> 0 ->
								          word_product multG eG xs' n' = xt ->
								          n1 = n' /\ (forall i0:set, i0 :e n1 -> apply_fun xs1 i0 = apply_fun xs' i0))
								        Hxs1_pack).
								      assume Hred1 Hn1_ne0 Hwp1 Huniq1.
								      claim Huniq_xs12 : n1 = ordsucc t /\ (forall i0:set, i0 :e n1 -> apply_fun xs1 i0 = apply_fun xs12 i0).
								      {
								        claim Hwp_xs12 : word_product multG eG xs12 (ordsucc t) = xt.
								        { reflexivity. }
								        exact (Huniq1 (ordsucc t) xs12 Hred12t Hsn_ne0 Hwp_xs12).
								      }
								      claim Huniq_xs0 : n1 = n0 /\ (forall i0:set, i0 :e n1 -> apply_fun xs1 i0 = apply_fun xs0 i0).
								      { exact (Huniq1 n0 xs0 Hred0 Hn0_ne0 Hwp0). }
								      claim Hst_eq_n0 : ordsucc t = n0.
								      {
								        claim Hn1_eq_st : n1 = ordsucc t.
								        { exact (andEL (n1 = ordsucc t) (forall i0:set, i0 :e n1 -> apply_fun xs1 i0 = apply_fun xs12 i0) Huniq_xs12). }
								        claim Hn1_eq_n0 : n1 = n0.
								        { exact (andEL (n1 = n0) (forall i0:set, i0 :e n1 -> apply_fun xs1 i0 = apply_fun xs0 i0) Huniq_xs0). }
								        exact (eq_i_tra (ordsucc t) n1 n0 (eq_symm n1 (ordsucc t) Hn1_eq_st) Hn1_eq_n0).
								      }
								      apply andI.
								      - exact Hst_eq_n0.
								      - let i. assume Hi : i :e ordsucc t.
								        claim Hi_n1 : i :e n1.
								        {
								          claim Hn1_eq_st : n1 = ordsucc t.
								          { exact (andEL (n1 = ordsucc t) (forall i0:set, i0 :e n1 -> apply_fun xs1 i0 = apply_fun xs12 i0) Huniq_xs12). }
								          exact (eq_subst_mem_set i (ordsucc t) n1 Hi (eq_symm n1 (ordsucc t) Hn1_eq_st)).
								        }
								        claim Hxs1_xs12 : apply_fun xs1 i = apply_fun xs12 i.
								        {
								          exact (andER
								            (n1 = ordsucc t)
								            (forall i0:set, i0 :e n1 -> apply_fun xs1 i0 = apply_fun xs12 i0)
								            Huniq_xs12
								            i Hi_n1).
								        }
								        claim Hxs1_xs0 : apply_fun xs1 i = apply_fun xs0 i.
								        {
								          exact (andER
								            (n1 = n0)
								            (forall i0:set, i0 :e n1 -> apply_fun xs1 i0 = apply_fun xs0 i0)
								            Huniq_xs0
								            i Hi_n1).
								        }
								        exact (eq_i_tra (apply_fun xs12 i) (apply_fun xs1 i) (apply_fun xs0 i)
								          (eq_symm (apply_fun xs1 i) (apply_fun xs12 i) Hxs1_xs12)
								          Hxs1_xs0).
								    }

								    claim HnA_ne1 : nA <> 1.
								    {
								      assume HnA1.
						      claim H0in : 0 :e nA.
						      { rewrite HnA1. exact (nat_0_in_ordsucc 0 nat_0). }
							      apply (Hside_union nA xsA HredA 0 H0in).
							      - assume Hy0G1.
							        claim HxtG1 : xt :e G1.
							        {
							          rewrite <- HwpA. rewrite HnA1.
							          claim Hwp1 : word_product multG eG xsA 1 =
							            apply_fun multG (word_product multG eG xsA 0, apply_fun xsA 0).
							          { exact (word_product_succ multG eG xsA 0 nat_0). }
							          claim Hwp0 : word_product multG eG xsA 0 = eG.
							          { exact (nat_primrec_0 eG (fun k r => apply_fun multG (r, apply_fun xsA k))). }
							          claim Hy0_G : apply_fun xsA 0 :e G.
							          { exact (subgroup_of_subset G1 G multG eG invG Hsub1 (apply_fun xsA 0) Hy0G1). }
							          apply (and6E
							            (function_on multG (setprod G G) G)
							            (function_on invG G G)
							            (eG :e G)
							            (forall u v w:set, u :e G -> v :e G -> w :e G ->
							              apply_fun multG (apply_fun multG (u, v), w) =
							                apply_fun multG (u, apply_fun multG (v, w)))
							            (forall u:set, u :e G -> apply_fun multG (eG, u) = u /\ apply_fun multG (u, eG) = u)
							            (forall u:set, u :e G ->
							              apply_fun multG (u, apply_fun invG u) = eG /\
							              apply_fun multG (apply_fun invG u, u) = eG)
							            Hgrp).
							          assume _ _ _ _ Hid _.
							          claim Hwp1_eq : word_product multG eG xsA 1 = apply_fun xsA 0.
							          {
							            rewrite Hwp1. rewrite Hwp0.
							            exact (andEL
							              (apply_fun multG (eG, apply_fun xsA 0) = apply_fun xsA 0)
							              (apply_fun multG (apply_fun xsA 0, eG) = apply_fun xsA 0)
							              (Hid (apply_fun xsA 0) Hy0_G)).
							          }
							          rewrite Hwp1_eq.
							          exact Hy0G1.
							        }
							        exact (Hxt_notG1 HxtG1).
							      - assume Hy0G2.
							        claim HxtG2 : xt :e G2.
							        {
							          rewrite <- HwpA. rewrite HnA1.
							          claim Hwp1 : word_product multG eG xsA 1 =
							            apply_fun multG (word_product multG eG xsA 0, apply_fun xsA 0).
							          { exact (word_product_succ multG eG xsA 0 nat_0). }
							          claim Hwp0 : word_product multG eG xsA 0 = eG.
							          { exact (nat_primrec_0 eG (fun k r => apply_fun multG (r, apply_fun xsA k))). }
							          claim Hy0_G : apply_fun xsA 0 :e G.
							          { exact (subgroup_of_subset G2 G multG eG invG Hsub2 (apply_fun xsA 0) Hy0G2). }
							          apply (and6E
							            (function_on multG (setprod G G) G)
							            (function_on invG G G)
							            (eG :e G)
							            (forall u v w:set, u :e G -> v :e G -> w :e G ->
							              apply_fun multG (apply_fun multG (u, v), w) =
							                apply_fun multG (u, apply_fun multG (v, w)))
							            (forall u:set, u :e G -> apply_fun multG (eG, u) = u /\ apply_fun multG (u, eG) = u)
							            (forall u:set, u :e G ->
							              apply_fun multG (u, apply_fun invG u) = eG /\
							              apply_fun multG (apply_fun invG u, u) = eG)
							            Hgrp).
							          assume _ _ _ _ Hid _.
							          claim Hwp1_eq : word_product multG eG xsA 1 = apply_fun xsA 0.
							          {
							            rewrite Hwp1. rewrite Hwp0.
							            exact (andEL
							              (apply_fun multG (eG, apply_fun xsA 0) = apply_fun xsA 0)
							              (apply_fun multG (apply_fun xsA 0, eG) = apply_fun xsA 0)
							              (Hid (apply_fun xsA 0) Hy0_G)).
							          }
							          rewrite Hwp1_eq.
							          exact Hy0G2.
							        }
							        exact (Hxt_notG2 HxtG2).
						    }

						    claim HnB_ne1 : nB <> 1.
						    {
						      assume HnB1.
						      claim H0in : 0 :e nB.
						      { rewrite HnB1. exact (nat_0_in_ordsucc 0 nat_0). }
							      apply (Hside_union nB xsB HredB 0 H0in).
							      - assume Hy0G1.
							        claim HxtG1 : xt :e G1.
							        {
							          rewrite <- HwpB. rewrite HnB1.
							          claim Hwp1 : word_product multG eG xsB 1 =
							            apply_fun multG (word_product multG eG xsB 0, apply_fun xsB 0).
							          { exact (word_product_succ multG eG xsB 0 nat_0). }
							          claim Hwp0 : word_product multG eG xsB 0 = eG.
							          { exact (nat_primrec_0 eG (fun k r => apply_fun multG (r, apply_fun xsB k))). }
							          claim Hy0_G : apply_fun xsB 0 :e G.
							          { exact (subgroup_of_subset G1 G multG eG invG Hsub1 (apply_fun xsB 0) Hy0G1). }
							          apply (and6E
							            (function_on multG (setprod G G) G)
							            (function_on invG G G)
							            (eG :e G)
							            (forall u v w:set, u :e G -> v :e G -> w :e G ->
							              apply_fun multG (apply_fun multG (u, v), w) =
							                apply_fun multG (u, apply_fun multG (v, w)))
							            (forall u:set, u :e G -> apply_fun multG (eG, u) = u /\ apply_fun multG (u, eG) = u)
							            (forall u:set, u :e G ->
							              apply_fun multG (u, apply_fun invG u) = eG /\
							              apply_fun multG (apply_fun invG u, u) = eG)
							            Hgrp).
							          assume _ _ _ _ Hid _.
							          claim Hwp1_eq : word_product multG eG xsB 1 = apply_fun xsB 0.
							          {
							            rewrite Hwp1. rewrite Hwp0.
							            exact (andEL
							              (apply_fun multG (eG, apply_fun xsB 0) = apply_fun xsB 0)
							              (apply_fun multG (apply_fun xsB 0, eG) = apply_fun xsB 0)
							              (Hid (apply_fun xsB 0) Hy0_G)).
							          }
							          rewrite Hwp1_eq.
							          exact Hy0G1.
							        }
							        exact (Hxt_notG1 HxtG1).
							      - assume Hy0G2.
							        claim HxtG2 : xt :e G2.
							        {
							          rewrite <- HwpB. rewrite HnB1.
							          claim Hwp1 : word_product multG eG xsB 1 =
							            apply_fun multG (word_product multG eG xsB 0, apply_fun xsB 0).
							          { exact (word_product_succ multG eG xsB 0 nat_0). }
							          claim Hwp0 : word_product multG eG xsB 0 = eG.
							          { exact (nat_primrec_0 eG (fun k r => apply_fun multG (r, apply_fun xsB k))). }
							          claim Hy0_G : apply_fun xsB 0 :e G.
							          { exact (subgroup_of_subset G2 G multG eG invG Hsub2 (apply_fun xsB 0) Hy0G2). }
							          apply (and6E
							            (function_on multG (setprod G G) G)
							            (function_on invG G G)
							            (eG :e G)
							            (forall u v w:set, u :e G -> v :e G -> w :e G ->
							              apply_fun multG (apply_fun multG (u, v), w) =
							                apply_fun multG (u, apply_fun multG (v, w)))
							            (forall u:set, u :e G -> apply_fun multG (eG, u) = u /\ apply_fun multG (u, eG) = u)
							            (forall u:set, u :e G ->
							              apply_fun multG (u, apply_fun invG u) = eG /\
							              apply_fun multG (apply_fun invG u, u) = eG)
							            Hgrp).
							          assume _ _ _ _ Hid _.
							          claim Hwp1_eq : word_product multG eG xsB 1 = apply_fun xsB 0.
							          {
							            rewrite Hwp1. rewrite Hwp0.
							            exact (andEL
							              (apply_fun multG (eG, apply_fun xsB 0) = apply_fun xsB 0)
							              (apply_fun multG (apply_fun xsB 0, eG) = apply_fun xsB 0)
							              (Hid (apply_fun xsB 0) Hy0_G)).
							          }
							          rewrite Hwp1_eq.
							          exact Hy0G2.
							        }
							        exact (Hxt_notG2 HxtG2).
						    }

						    claim HallNeA : forall i:set, i :e nA -> apply_fun xsA i <> eG.
						    {
						      let i. assume Hi.
						      exact (reduced_word_no_eG_all
						        G multG eG invG (J :\/: K) Hfam efamH nA xsA
						        Hgrp Hsubfam_union HredA HnA_ne0 HnA_ne1 i Hi).
						    }
							    claim HallNeB : forall i:set, i :e nB -> apply_fun xsB i <> eG.
							    {
							      let i. assume Hi.
							      exact (reduced_word_no_eG_all
							        G multG eG invG (J :\/: K) Hfam efamH nB xsB
							        Hgrp Hsubfam_union HredB HnB_ne0 HnB_ne1 i Hi).
							    }

							    (** Determine which factor the last binary letter xs12(t) lies in. **)
							    claim Hxs12t_side : (apply_fun xs12 t :e G1) \/ (apply_fun xs12 t :e G2).
							    {
							      apply (and3E
							        (ordsucc t :e omega)
							        (forall i:set, i :e ordsucc t ->
							          exists alpha:set, alpha :e (UPair 0 1) /\
							            apply_fun xs12 i :e apply_fun Gfam12 alpha /\
							            apply_fun xs12 i <> apply_fun (graph (UPair 0 1) (fun _:set => eG)) alpha)
							        (forall i:set, i :e ordsucc t -> ordsucc i :e ordsucc t ->
							          forall alpha beta:set, alpha :e (UPair 0 1) -> beta :e (UPair 0 1) ->
							            apply_fun xs12 i :e apply_fun Gfam12 alpha ->
							            apply_fun xs12 (ordsucc i) :e apply_fun Gfam12 beta ->
							            alpha <> beta)
							        Hred12t).
							      assume _ Helem12 _.
							      apply (Helem12 t (ordsuccI2 t)). let alpha. assume Halpha_pack.
							      apply (and3E
							        (alpha :e (UPair 0 1))
							        (apply_fun xs12 t :e apply_fun Gfam12 alpha)
							        (apply_fun xs12 t <> apply_fun (graph (UPair 0 1) (fun _:set => eG)) alpha)
							        Halpha_pack).
							      assume Hal Hfam _.
							      apply (UPairE alpha 0 1 Hal).
							      - assume Halpha0.
							        apply orIL.
							        claim HGfam0 : apply_fun Gfam12 alpha = G1.
							        {
							          rewrite (apply_fun_graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2) alpha Hal).
							          exact (If_i_1 (alpha = 0) G1 G2 Halpha0).
							        }
							        exact (eq_subst_mem_set (apply_fun xs12 t) (apply_fun Gfam12 alpha) G1 Hfam HGfam0).
							      - assume Halpha1.
							        apply orIR.
							        claim HGfam1 : apply_fun Gfam12 alpha = G2.
							        {
							          rewrite (apply_fun_graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2) alpha Hal).
							          claim Hne0 : alpha <> 0.
							          { rewrite Halpha1. exact neq_1_0. }
							          exact (If_i_0 (alpha = 0) G1 G2 Hne0).
							        }
							        exact (eq_subst_mem_set (apply_fun xs12 t) (apply_fun Gfam12 alpha) G2 Hfam HGfam1).
							    }
							    claim Hxs12t_ne : apply_fun xs12 t <> eG.
							    {
							      apply (and3E
							        (ordsucc t :e omega)
							        (forall i:set, i :e ordsucc t ->
							          exists alpha:set, alpha :e (UPair 0 1) /\
							            apply_fun xs12 i :e apply_fun Gfam12 alpha /\
							            apply_fun xs12 i <> apply_fun (graph (UPair 0 1) (fun _:set => eG)) alpha)
							        (forall i:set, i :e ordsucc t -> ordsucc i :e ordsucc t ->
							          forall alpha beta:set, alpha :e (UPair 0 1) -> beta :e (UPair 0 1) ->
							            apply_fun xs12 i :e apply_fun Gfam12 alpha ->
							            apply_fun xs12 (ordsucc i) :e apply_fun Gfam12 beta ->
							            alpha <> beta)
							        Hred12t).
							      assume _ Helem12 _.
							      apply (Helem12 t (ordsuccI2 t)). let alpha. assume Halpha_pack.
							      apply (and3E
							        (alpha :e (UPair 0 1))
							        (apply_fun xs12 t :e apply_fun Gfam12 alpha)
							        (apply_fun xs12 t <> apply_fun (graph (UPair 0 1) (fun _:set => eG)) alpha)
							        Halpha_pack).
							      assume Hal _ Hne.
							      claim Hef : apply_fun (graph (UPair 0 1) (fun _:set => eG)) alpha = eG.
							      { exact (apply_fun_graph (UPair 0 1) (fun _:set => eG) alpha Hal). }
							      assume Heq : apply_fun xs12 t = eG.
							      apply Hne.
							      rewrite Hef.
							      exact Heq.
							    }
							    apply Hxs12t_side.
							    * assume Hxs12tG1.
							      (** Last binary letter lies in G1. **)
							      claim HnAO : nA :e omega.
							      {
							        apply (and3E
							          (nA :e omega)
							          (forall i:set, i :e nA ->
							            exists alpha:set, alpha :e (J :\/: K) /\
							              apply_fun xsA i :e apply_fun Hfam alpha /\
							              apply_fun xsA i <> apply_fun efamH alpha)
							          (forall i:set, i :e nA -> ordsucc i :e nA ->
							            forall alpha beta:set, alpha :e (J :\/: K) -> beta :e (J :\/: K) ->
							              apply_fun xsA i :e apply_fun Hfam alpha ->
							              apply_fun xsA (ordsucc i) :e apply_fun Hfam beta ->
							              alpha <> beta)
							          HredA).
							        assume HnAO _ _. exact HnAO.
							      }
							      claim HnA_nat : nat_p nA. { exact (omega_nat_p nA HnAO). }
							      claim HnA_succ : exists kA:set, nat_p kA /\ nA = ordsucc kA.
							      {
							        apply (nat_inv nA HnA_nat).
							        - assume Hn0.
							          exact (FalseE (HnA_ne0 Hn0) (exists kA:set, nat_p kA /\ nA = ordsucc kA)).
							        - assume Hex. exact Hex.
							      }
							      apply HnA_succ. let kA. assume HkA_pack.
							      claim HkA_nat : nat_p kA.
							      { exact (andEL (nat_p kA) (nA = ordsucc kA) HkA_pack). }
							      claim HnA_eq : nA = ordsucc kA.
							      { exact (andER (nat_p kA) (nA = ordsucc kA) HkA_pack). }
							      claim HkA_in : kA :e nA.
							      { rewrite HnA_eq. exact (ordsuccI2 kA). }
							      
							      claim HlastA_G1 : apply_fun xsA kA :e G1.
							      {
							        apply (Hside_union nA xsA HredA kA HkA_in).
							        - assume HyG1. exact HyG1.
							        - assume HyG2.
							          (** Collapse A to a binary reduced word ending in G2 and contradict Hxs12tG1. **)
							          claim HredA_k : reduced_word (J :\/: K) Hfam efamH (ordsucc kA) xsA.
							          { rewrite <- HnA_eq. exact HredA. }
							          claim HallNeA_k : forall i:set, i :e ordsucc kA -> apply_fun xsA i <> eG.
							          {
							            let i. assume Hi.
							            claim HiA : i :e nA.
							            { rewrite HnA_eq. exact Hi. }
							            exact (HallNeA i HiA).
							          }
							          claim Hlast_in : apply_fun xsA kA :e apply_fun Gfam12 1.
							          {
							            rewrite (apply_fun_graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2) 1 (UPairI2 0 1)).
							            rewrite (If_i_0 (1 = 0) G1 G2 neq_1_0).
							            exact HyG2.
							          }
							          claim HcollA :
							            exists n0 xs0 k0:set,
							              reduced_word (UPair 0 1)
							                (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2))
							                (graph (UPair 0 1) (fun _:set => eG))
							                n0 xs0 /\
							              word_product multG eG xs0 n0 = word_product multG eG xsA (ordsucc kA) /\
							              n0 <> 0 /\ nat_p k0 /\ n0 = ordsucc k0 /\
							              apply_fun xs0 k0 :e apply_fun (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2)) 1.
							          {
							            exact (cor68_6_collapse_union_word_to_binary_end_in_factor
							              G multG eG invG G1 G2 J K Hfam efamH kA xsA 1
							              Hgrp Hsub1 Hsub2 Hfp Hfp1 Hfp2
							              HkA_nat
							              HredA_k
							              HallNeA_k
							              (UPairI2 0 1)
							              Hlast_in).
							          }
							          apply HcollA. let n0. assume Hn0_pack.
							          apply Hn0_pack. let xs0. assume Hxs0_pack.
							          apply Hxs0_pack. let k0. assume Hk0_pack.
							          apply (and6E
							            (reduced_word (UPair 0 1)
							              (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2))
							              (graph (UPair 0 1) (fun _:set => eG))
							              n0 xs0)
							            (word_product multG eG xs0 n0 = word_product multG eG xsA (ordsucc kA))
							            (n0 <> 0)
							            (nat_p k0)
							            (n0 = ordsucc k0)
							            (apply_fun xs0 k0 :e apply_fun (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2)) 1)
							            Hk0_pack).
							          assume Hred0 Hwp0 Hn0_ne0 Hk0_nat Hn0_eq Hlast0.
							          claim Hwp0_xt : word_product multG eG xs0 n0 = xt.
							          {
							            rewrite Hwp0.
							            rewrite <- HnA_eq.
							            exact HwpA.
							          }
							          claim Huniq0 : ordsucc t = n0 /\ (forall i:set, i :e ordsucc t -> apply_fun xs12 i = apply_fun xs0 i).
							          { exact (Huniq_xt n0 xs0 Hred0 Hn0_ne0 Hwp0_xt). }
							          claim Hst_eq : ordsucc t = n0.
							          { exact (andEL (ordsucc t = n0) (forall i:set, i :e ordsucc t -> apply_fun xs12 i = apply_fun xs0 i) Huniq0). }
							          claim Hpt : forall i:set, i :e ordsucc t -> apply_fun xs12 i = apply_fun xs0 i.
							          { exact (andER (ordsucc t = n0) (forall i:set, i :e ordsucc t -> apply_fun xs12 i = apply_fun xs0 i) Huniq0). }
							          claim Ht_in_n0 : t :e n0.
							          { rewrite <- Hst_eq. exact (ordsuccI2 t). }
							          claim Hxst_eq : apply_fun xs12 t = apply_fun xs0 t.
							          { exact (Hpt t (ordsuccI2 t)). }
								          claim Hxst_G2 : apply_fun xs12 t :e G2.
								          {
								            claim Hx0 : apply_fun xs0 t = apply_fun xs0 k0.
								            {
								              claim Hs : ordsucc t = ordsucc k0.
								              { rewrite Hst_eq. rewrite Hn0_eq. reflexivity. }
								              claim Htk0 : t = k0.
								              { exact (ordsucc_inj t k0 Hs). }
								              rewrite Htk0.
								              reflexivity.
								            }
									            claim Hxk0_G2 : apply_fun xs0 k0 :e G2.
									            {
									              claim HGfam1 :
									                apply_fun (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2)) 1 = G2.
									              {
									                rewrite (apply_fun_graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2) 1 (UPairI2 0 1)).
									                rewrite (If_i_0 (1 = 0) G1 G2 neq_1_0).
									                reflexivity.
									              }
										              exact (eq_subst_mem_set (apply_fun xs0 k0)
										                (apply_fun (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2)) 1) G2
										                Hlast0
										                HGfam1).
										            }
								            exact (eq_subst_mem (apply_fun xs12 t) (apply_fun xs0 k0) G2 (eq_i_tra (apply_fun xs12 t) (apply_fun xs0 t) (apply_fun xs0 k0) Hxst_eq Hx0) Hxk0_G2).
								          }
							          claim Hxe : apply_fun xs12 t = eG.
							          { exact (free_product_binary_factors_intersect_trivial G multG eG invG G1 G2 (apply_fun xs12 t) Hfp Hxs12tG1 Hxst_G2). }
							          exact (FalseE (Hxs12t_ne Hxe) (apply_fun xsA kA :e G1)).
							      }
							      
							      (** Existence of a G2-letter in A. **)
							      claim HexG2A : exists i:set, i :e nA /\ apply_fun xsA i :e G2.
							      {
							        apply (xm (exists i:set, i :e nA /\ apply_fun xsA i :e G2)).
							        - assume Hex. exact Hex.
							        - assume Hno.
							          claim HallG1A : forall i:set, i :e nA -> apply_fun xsA i :e G1.
							          {
							            let i. assume Hi.
							            apply (Hside_union nA xsA HredA i Hi).
							            - assume HiG1. exact HiG1.
							            - assume HiG2.
							              claim Hex : exists j:set, j :e nA /\ apply_fun xsA j :e G2.
							              { witness i. exact (andI (i :e nA) (apply_fun xsA i :e G2) Hi HiG2). }
							              exact (FalseE (Hno Hex) (apply_fun xsA i :e G1)).
							          }
							          claim HxtG1 : xt :e G1.
							          {
							            rewrite <- HwpA.
							            exact (Hword_product_in_G1 nA xsA HredA HallG1A).
							          }
							          exact (FalseE (Hxt_notG1 HxtG1) (exists i:set, i :e nA /\ apply_fun xsA i :e G2)).
							      }
							      claim HexG1A : exists i:set, i :e nA /\ apply_fun xsA i :e G1.
							      { witness kA. exact (andI (kA :e nA) (apply_fun xsA kA :e G1) HkA_in HlastA_G1). }
							      
							      (** Split A using maximal G2 index. **)
							      apply (cor68_6_max_G2_index_suffix_all_in_G1
							        G multG eG invG G1 G2 J K Hfam efamH nA xsA
							        Hgrp Hsub1 Hsub2 Hfp Hfp1 Hfp2
							        HredA
							        HallNeA
							        HexG1A
							        HexG2A).
							      let mA. assume HmA_pack.
							      apply (and4E
							        (mA :e nA)
							        (apply_fun xsA mA :e G2)
							        (forall i:set, i :e nA -> apply_fun xsA i :e G2 -> i c= mA)
							        (forall i:set, i :e nA -> ordsucc mA c= i -> apply_fun xsA i :e G1)
							        HmA_pack).
							      assume HmA_in HxmA_G2 HmA_maxG2 HsuffixA_all_G1.
							      
							      (** mA is not the last index kA. **)
							      claim HmA_ne_kA : mA <> kA.
							      {
							        assume Hmk.
							        claim Hxk_G2 : apply_fun xsA kA :e G2.
								        { rewrite <- Hmk. exact HxmA_G2. }
								        claim Hxe : apply_fun xsA kA = eG.
								        { exact (free_product_binary_factors_intersect_trivial G multG eG invG G1 G2 (apply_fun xsA kA) Hfp HlastA_G1 Hxk_G2). }
								        exact (HallNeA kA HkA_in Hxe).
								      }
								      claim HmA_in_kA : mA :e kA.
								      {
								        apply (ordsuccE kA mA (eq_subst_mem_set mA nA (ordsucc kA) HmA_in HnA_eq)).
								        - assume Hm_in. exact Hm_in.
								        - assume Hmeq. exact (FalseE (HmA_ne_kA Hmeq) (mA :e kA)).
								      }
							      set n1A := ordsucc mA.
							      claim Hn1A_nat : nat_p n1A.
							      {
							        claim HmA_omega : mA :e omega.
							        { exact (omega_TransSet nA HnAO mA HmA_in). }
							        exact (nat_ordsucc mA (omega_nat_p mA HmA_omega)).
							      }
							      claim Hn1A_in_nA : n1A :e nA.
							      {
							        rewrite HnA_eq.
							        exact (nat_ordsucc_in_ordsucc kA HkA_nat mA HmA_in_kA).
							      }
							      apply (nat_mem_add_nat_decomp nA n1A HnA_nat Hn1A_in_nA).
							      let n2A. assume Hn2A_pack.
							      claim Hn2A_nat : nat_p n2A.
							      { exact (andEL (nat_p n2A) (nA = add_nat n1A n2A) Hn2A_pack). }
							      claim HnA_add : nA = add_nat n1A n2A.
							      { exact (andER (nat_p n2A) (nA = add_nat n1A n2A) Hn2A_pack). }
							      set xsA1 := graph n1A (fun i:set => apply_fun xsA i).
							      set xsA2 := graph n2A (fun i:set => apply_fun xsA (add_nat n1A i)).
							      claim HredA1 : reduced_word (J :\/: K) Hfam efamH n1A xsA1.
							      { exact (reduced_word_prefix (J :\/: K) Hfam efamH nA xsA n1A HredA Hn1A_in_nA). }
							      claim HredA2 : reduced_word (J :\/: K) Hfam efamH n2A xsA2.
							      { exact (reduced_word_suffix_by_add_nat (J :\/: K) Hfam efamH nA xsA n1A n2A HredA Hn1A_nat Hn2A_nat HnA_add). }
							      claim HallNeA1 : forall i:set, i :e n1A -> apply_fun xsA1 i <> eG.
							      {
							        let i. assume Hi1.
							        rewrite (apply_fun_graph n1A (fun j:set => apply_fun xsA j) i Hi1).
							        claim HiA : i :e nA.
							        {
							          claim Hsub : n1A c= add_nat n1A n2A.
							          { exact (add_nat_Subq_R' n1A Hn1A_nat n2A Hn2A_nat). }
							          claim Hi_sum : i :e add_nat n1A n2A.
							          { exact (Hsub i Hi1). }
							          exact (eq_subst_mem_set i (add_nat n1A n2A) nA Hi_sum (eq_symm nA (add_nat n1A n2A) HnA_add)).
							        }
							        exact (HallNeA i HiA).
							      }
							      claim HallNeA2 : forall i:set, i :e n2A -> apply_fun xsA2 i <> eG.
							      {
							        let i. assume Hi2.
							        rewrite (apply_fun_graph n2A (fun j:set => apply_fun xsA (add_nat n1A j)) i Hi2).
							        claim Hi_sum : add_nat n1A i :e add_nat n1A n2A.
							        { exact (add_nat_In_L n1A Hn1A_nat n2A Hn2A_nat i Hi2). }
							        claim HiA : add_nat n1A i :e nA.
							        { exact (eq_subst_mem_set (add_nat n1A i) (add_nat n1A n2A) nA Hi_sum (eq_symm nA (add_nat n1A n2A) HnA_add)). }
							        exact (HallNeA (add_nat n1A i) HiA).
							      }
							      claim HallG1A2 : forall i:set, i :e n2A -> apply_fun xsA2 i :e G1.
							      {
							        let i. assume Hi2.
							        rewrite (apply_fun_graph n2A (fun j:set => apply_fun xsA (add_nat n1A j)) i Hi2).
							        claim Hi_sum : add_nat n1A i :e add_nat n1A n2A.
							        { exact (add_nat_In_L n1A Hn1A_nat n2A Hn2A_nat i Hi2). }
							        claim HiA : add_nat n1A i :e nA.
							        { exact (eq_subst_mem_set (add_nat n1A i) (add_nat n1A n2A) nA Hi_sum (eq_symm nA (add_nat n1A n2A) HnA_add)). }
							        claim Hsub : ordsucc mA c= add_nat n1A i.
							        {
							          claim Hsub1 : n1A c= add_nat n1A i.
							          { exact (add_nat_Subq_R' n1A Hn1A_nat i (nat_p_trans n2A Hn2A_nat i Hi2)). }
							          exact Hsub1.
							        }
							        exact (HsuffixA_all_G1 (add_nat n1A i) HiA Hsub).
							      }
							      claim Hn2A_ne0 : n2A <> 0.
							      {
							        assume Hn20.
							        claim HnA_eq_n1 : nA = n1A.
							        { rewrite HnA_add. rewrite Hn20. rewrite (add_nat_0R n1A). reflexivity. }
							        claim Hk_eq : kA = mA.
							        {
							          claim Hs : ordsucc kA = ordsucc mA.
								          { rewrite <- HnA_eq. rewrite HnA_eq_n1. reflexivity. }
								          exact (ordsucc_inj kA mA Hs).
								        }
								        exact (HmA_ne_kA (eq_symm kA mA Hk_eq)).
								      }
							      set wpA2 := word_product multG eG xsA2 n2A.
							      claim HwpA2_G1 : wpA2 :e G1.
							      { exact (Hword_product_in_G1 n2A xsA2 HredA2 HallG1A2). }
							      claim HwpA2_ne : wpA2 <> eG.
							      {
							        exact (cor68_6_reduced_word_all_in_G1_product_ne_eG
							          G multG eG invG G1 G2 J K Hfam efamH n2A xsA2
							          Hgrp Hsub1 Hsub2 Hfp Hfp1 Hfp2
							          HredA2 HallNeA2 HallG1A2 Hn2A_ne0).
							      }
							      (** Collapse prefix A1 to a binary reduced word ending in G2 and append wpA2 in G1. **)
							      claim HmA_nat : nat_p mA.
							      { exact (nat_p_trans nA HnA_nat mA HmA_in). }
							      claim HmA_in_n1A : mA :e n1A.
							      { exact (ordsuccI2 mA). }
							      claim Hlast_prefA : apply_fun xsA1 mA :e apply_fun Gfam12 1.
							      {
							        rewrite (apply_fun_graph n1A (fun i:set => apply_fun xsA i) mA HmA_in_n1A).
							        rewrite (apply_fun_graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2) 1 (UPairI2 0 1)).
							        rewrite (If_i_0 (1 = 0) G1 G2 neq_1_0).
							        exact HxmA_G2.
							      }
							      claim HcollA1 :
							        exists np xb kp:set,
							          reduced_word (UPair 0 1)
							            (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2))
							            (graph (UPair 0 1) (fun _:set => eG))
							            np xb /\
							          word_product multG eG xb np = word_product multG eG xsA1 n1A /\
							          np <> 0 /\ nat_p kp /\ np = ordsucc kp /\
							          apply_fun xb kp :e apply_fun (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2)) 1.
							      {
							        exact (cor68_6_collapse_union_word_to_binary_end_in_factor
								          G multG eG invG G1 G2 J K Hfam efamH mA xsA1 1
								          Hgrp Hsub1 Hsub2 Hfp Hfp1 Hfp2
								          HmA_nat
								          HredA1
								          HallNeA1
								          (UPairI2 0 1)
								          Hlast_prefA).
								      }
							      apply HcollA1. let npA. assume HnpA_pack.
							      apply HnpA_pack. let xbA. assume HxbA_pack.
							      apply HxbA_pack. let kpA. assume HkpA_pack.
							      apply (and6E
							        (reduced_word (UPair 0 1)
							          (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2))
							          (graph (UPair 0 1) (fun _:set => eG))
							          npA xbA)
							        (word_product multG eG xbA npA = word_product multG eG xsA1 n1A)
							        (npA <> 0)
							        (nat_p kpA)
							        (npA = ordsucc kpA)
							        (apply_fun xbA kpA :e apply_fun (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2)) 1)
							        HkpA_pack).
							      assume HredbA HwpbA HnpA_ne0 HkpA_nat HnpA_eq HlastbA.
							      claim HxbA_last_ne : apply_fun xbA kpA <> eG.
							      {
							        apply (and3E
							          (npA :e omega)
							          (forall i:set, i :e npA ->
							            exists alpha:set, alpha :e (UPair 0 1) /\
							              apply_fun xbA i :e apply_fun Gfam12 alpha /\
							              apply_fun xbA i <> apply_fun (graph (UPair 0 1) (fun _:set => eG)) alpha)
							          (forall i:set, i :e npA -> ordsucc i :e npA ->
							            forall alpha beta:set, alpha :e (UPair 0 1) -> beta :e (UPair 0 1) ->
							              apply_fun xbA i :e apply_fun Gfam12 alpha ->
							              apply_fun xbA (ordsucc i) :e apply_fun Gfam12 beta ->
							              alpha <> beta)
							          HredbA).
							        assume _ Helem _.
							        claim Hkp_in : kpA :e npA.
							        { rewrite HnpA_eq. exact (ordsuccI2 kpA). }
							        apply (Helem kpA Hkp_in). let alpha. assume Halpha_pack.
							        apply (and3E (alpha :e (UPair 0 1))
							          (apply_fun xbA kpA :e apply_fun Gfam12 alpha)
							          (apply_fun xbA kpA <> apply_fun (graph (UPair 0 1) (fun _:set => eG)) alpha)
							          Halpha_pack).
							        assume Hal _ Hne.
							        claim Hef : apply_fun (graph (UPair 0 1) (fun _:set => eG)) alpha = eG.
							        { exact (apply_fun_graph (UPair 0 1) (fun _:set => eG) alpha Hal). }
							        assume Heq : apply_fun xbA kpA = eG.
							        apply Hne. rewrite Hef. exact Heq.
							      }
							      claim HwpA1_eq : word_product multG eG xsA1 n1A = word_product multG eG xbA npA.
							      { exact (eq_symm (word_product multG eG xbA npA) (word_product multG eG xsA1 n1A) HwpbA). }
							      set xsAext := graph (ordsucc npA) (fun i:set => if i :e npA then apply_fun xbA i else wpA2).
								      claim HredAext : reduced_word (UPair 0 1)
								        (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2))
								        (graph (UPair 0 1) (fun _:set => eG))
								        (ordsucc npA) xsAext.
								      {
								        claim HGfam0 :
								          apply_fun (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2)) 0 = G1.
								        {
								          rewrite (apply_fun_graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2) 0 (UPairI1 0 1)).
								          rewrite (If_i_1 (0 = 0) G1 G2 (eq_refl 0)).
								          reflexivity.
								        }
								        exact (binary_reduced_word_append_other_factor
								          G multG eG invG G1 G2 npA xbA wpA2 0 1 kpA
								          Hgrp Hfp HredbA
								          HkpA_nat HnpA_eq
								          (UPairI2 0 1)
								          HlastbA
								          HxbA_last_ne
								          (UPairI1 0 1)
								          (eq_subst_mem_set wpA2 G1 (apply_fun (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2)) 0) HwpA2_G1
								            (eq_symm (apply_fun (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2)) 0) G1 HGfam0))
								          HwpA2_ne
								          neq_1_0).
								      }
							      claim HxsAext_prod : word_product multG eG xsAext (ordsucc npA) =
							        apply_fun multG (word_product multG eG xbA npA, wpA2).
							      {
							        claim HnpA_omega : npA :e omega.
							        {
							          apply (and3E
							            (npA :e omega)
							            (forall i:set, i :e npA ->
							              exists alpha:set, alpha :e (UPair 0 1) /\
							                apply_fun xbA i :e apply_fun Gfam12 alpha /\
							                apply_fun xbA i <> apply_fun (graph (UPair 0 1) (fun _:set => eG)) alpha)
							            (forall i:set, i :e npA -> ordsucc i :e npA ->
							              forall alpha beta:set, alpha :e (UPair 0 1) -> beta :e (UPair 0 1) ->
							                apply_fun xbA i :e apply_fun Gfam12 alpha ->
							                apply_fun xbA (ordsucc i) :e apply_fun Gfam12 beta ->
							                alpha <> beta)
							            HredbA).
							          assume Hnp _ _. exact Hnp.
							        }
							        exact (word_product_append_one multG eG xbA wpA2 npA HnpA_omega).
							      }
							      (** Product of xsA is xt, hence the appended binary word also multiplies to xt. **)
							      claim HxsAG : forall i:set, i :e nA -> apply_fun xsA i :e G.
							      {
							        let i. assume Hi.
							        exact (reduced_word_in_G
							          G multG eG invG (J :\/: K) Hfam efamH nA xsA
							          Hsubfam_union HredA i Hi).
							      }
								      claim Hwp_splitA :
								        word_product multG eG xsA nA =
								          apply_fun multG
								            (word_product multG eG xsA1 n1A, word_product multG eG xsA2 n2A).
								      {
								        claim Hsplit0 :
								          word_product multG eG xsA nA =
								            apply_fun multG
								              (word_product multG eG xsA n1A,
								               word_product multG eG (graph n2A (fun i:set => apply_fun xsA (add_nat n1A i))) n2A).
								        {
								          exact (word_product_split_by_add_nat
								            G multG eG invG nA xsA n1A n2A
								            Hgrp Hn1A_nat Hn2A_nat HnA_add HxsAG).
								        }
								        claim HwpA1_eq2 :
								          word_product multG eG xsA n1A = word_product multG eG xsA1 n1A.
								        {
								          claim Hn1A_O : n1A :e omega. { exact (nat_p_omega n1A Hn1A_nat). }
								          apply (nat_primrec_ext eG
								            (fun j r:set => apply_fun multG (r, apply_fun xsA j))
								            (fun j r:set => apply_fun multG (r, apply_fun xsA1 j))
								            n1A
								            Hn1A_O).
								          let j r. assume Hj1.
								          rewrite (apply_fun_graph n1A (fun t:set => apply_fun xsA t) j Hj1).
								          reflexivity.
								        }
								        rewrite Hsplit0.
								        rewrite HwpA1_eq2.
								        reflexivity.
								      }
							      claim HwpAext_xt : word_product multG eG xsAext (ordsucc npA) = xt.
							      {
								        rewrite HxsAext_prod.
								        rewrite <- HwpA1_eq.
								        rewrite <- Hwp_splitA.
								        exact HwpA.
								      }
							      claim HuniqAext : ordsucc t = ordsucc npA /\
							        (forall i:set, i :e ordsucc t -> apply_fun xs12 i = apply_fun xsAext i).
							      { exact (Huniq_xt (ordsucc npA) xsAext HredAext (neq_ordsucc_0 npA) HwpAext_xt). }
							      claim Ht_eq_npA : t = npA.
							      {
							        claim Hs : ordsucc t = ordsucc npA.
							        { exact (andEL (ordsucc t = ordsucc npA) (forall i:set, i :e ordsucc t -> apply_fun xs12 i = apply_fun xsAext i) HuniqAext). }
							        exact (ordsucc_inj t npA Hs).
							      }
							      claim HwpA2_eq : wpA2 = apply_fun xs12 t.
							      {
							        claim Hpt : forall i:set, i :e ordsucc t -> apply_fun xs12 i = apply_fun xsAext i.
							        { exact (andER (ordsucc t = ordsucc npA) (forall i:set, i :e ordsucc t -> apply_fun xs12 i = apply_fun xsAext i) HuniqAext). }
							        claim Ht_in : t :e ordsucc t. { exact (ordsuccI2 t). }
							        claim Hxs12t_eq : apply_fun xs12 t = apply_fun xsAext t.
							        { exact (Hpt t Ht_in). }
							        claim HxsAext_t : apply_fun xsAext t = wpA2.
							        {
							          rewrite Ht_eq_npA.
							          claim Hgr : apply_fun xsAext npA =
							            if npA :e npA then apply_fun xbA npA else wpA2.
							          { exact (apply_fun_graph (ordsucc npA) (fun i:set => if i :e npA then apply_fun xbA i else wpA2) npA (ordsuccI2 npA)). }
							          rewrite Hgr.
							          rewrite (If_i_0 (npA :e npA) (apply_fun xbA npA) wpA2 (In_irref npA)).
							          reflexivity.
							        }
							        exact (eq_symm (apply_fun xs12 t) wpA2 (eq_i_tra (apply_fun xs12 t) (apply_fun xsAext t) wpA2 Hxs12t_eq HxsAext_t)).
							      }
							      
							      (** Symmetric decomposition and uniqueness for B are analogous. **)
							      claim HnBO : nB :e omega.
							      {
							        apply (and3E
							          (nB :e omega)
							          (forall i:set, i :e nB ->
							            exists alpha:set, alpha :e (J :\/: K) /\
							              apply_fun xsB i :e apply_fun Hfam alpha /\
							              apply_fun xsB i <> apply_fun efamH alpha)
							          (forall i:set, i :e nB -> ordsucc i :e nB ->
							            forall alpha beta:set, alpha :e (J :\/: K) -> beta :e (J :\/: K) ->
							              apply_fun xsB i :e apply_fun Hfam alpha ->
							              apply_fun xsB (ordsucc i) :e apply_fun Hfam beta ->
							              alpha <> beta)
							          HredB).
							        assume HnBO _ _. exact HnBO.
							      }
							      claim HnB_nat : nat_p nB. { exact (omega_nat_p nB HnBO). }
							      claim HnB_succ : exists kB:set, nat_p kB /\ nB = ordsucc kB.
							      {
							        apply (nat_inv nB HnB_nat).
							        - assume Hn0.
							          exact (FalseE (HnB_ne0 Hn0) (exists kB:set, nat_p kB /\ nB = ordsucc kB)).
							        - assume Hex. exact Hex.
							      }
							      apply HnB_succ. let kB. assume HkB_pack.
							      claim HkB_nat : nat_p kB.
							      { exact (andEL (nat_p kB) (nB = ordsucc kB) HkB_pack). }
							      claim HnB_eq : nB = ordsucc kB.
							      { exact (andER (nat_p kB) (nB = ordsucc kB) HkB_pack). }
							      claim HkB_in : kB :e nB.
							      { rewrite HnB_eq. exact (ordsuccI2 kB). }
							      
							      claim HlastB_G1 : apply_fun xsB kB :e G1.
							      {
							        apply (Hside_union nB xsB HredB kB HkB_in).
							        - assume HyG1. exact HyG1.
							        - assume HyG2.
							          (** Collapse A to a binary reduced word ending in G2 and contradict Hxs12tG1. **)
							          claim HredB_k : reduced_word (J :\/: K) Hfam efamH (ordsucc kB) xsB.
							          { rewrite <- HnB_eq. exact HredB. }
							          claim HallNeB_k : forall i:set, i :e ordsucc kB -> apply_fun xsB i <> eG.
							          {
							            let i. assume Hi.
							            claim HiA : i :e nB.
							            { rewrite HnB_eq. exact Hi. }
							            exact (HallNeB i HiA).
							          }
							          claim Hlast_inB : apply_fun xsB kB :e apply_fun Gfam12 1.
							          {
							            rewrite (apply_fun_graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2) 1 (UPairI2 0 1)).
							            rewrite (If_i_0 (1 = 0) G1 G2 neq_1_0).
							            exact HyG2.
							          }
							          claim HcollB :
							            exists n0 xs0 k0:set,
							              reduced_word (UPair 0 1)
							                (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2))
							                (graph (UPair 0 1) (fun _:set => eG))
							                n0 xs0 /\
							              word_product multG eG xs0 n0 = word_product multG eG xsB (ordsucc kB) /\
							              n0 <> 0 /\ nat_p k0 /\ n0 = ordsucc k0 /\
							              apply_fun xs0 k0 :e apply_fun (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2)) 1.
							          {
							            exact (cor68_6_collapse_union_word_to_binary_end_in_factor
							              G multG eG invG G1 G2 J K Hfam efamH kB xsB 1
							              Hgrp Hsub1 Hsub2 Hfp Hfp1 Hfp2
							              HkB_nat
							              HredB_k
							              HallNeB_k
							              (UPairI2 0 1)
							              Hlast_inB).
							          }
							          apply HcollB. let n0. assume Hn0_pack.
							          apply Hn0_pack. let xs0. assume Hxs0_pack.
							          apply Hxs0_pack. let k0. assume Hk0_pack.
							          apply (and6E
							            (reduced_word (UPair 0 1)
							              (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2))
							              (graph (UPair 0 1) (fun _:set => eG))
							              n0 xs0)
							            (word_product multG eG xs0 n0 = word_product multG eG xsB (ordsucc kB))
							            (n0 <> 0)
							            (nat_p k0)
							            (n0 = ordsucc k0)
							            (apply_fun xs0 k0 :e apply_fun (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2)) 1)
							            Hk0_pack).
							          assume Hred0 Hwp0 Hn0_ne0 Hk0_nat Hn0_eq Hlast0.
							          claim Hwp0_xt : word_product multG eG xs0 n0 = xt.
							          {
							            rewrite Hwp0.
							            rewrite <- HnB_eq.
							            exact HwpB.
							          }
							          claim Huniq0 : ordsucc t = n0 /\ (forall i:set, i :e ordsucc t -> apply_fun xs12 i = apply_fun xs0 i).
							          { exact (Huniq_xt n0 xs0 Hred0 Hn0_ne0 Hwp0_xt). }
							          claim Hst_eq : ordsucc t = n0.
							          { exact (andEL (ordsucc t = n0) (forall i:set, i :e ordsucc t -> apply_fun xs12 i = apply_fun xs0 i) Huniq0). }
							          claim Hpt : forall i:set, i :e ordsucc t -> apply_fun xs12 i = apply_fun xs0 i.
							          { exact (andER (ordsucc t = n0) (forall i:set, i :e ordsucc t -> apply_fun xs12 i = apply_fun xs0 i) Huniq0). }
							          claim Ht_in_n0 : t :e n0.
							          { rewrite <- Hst_eq. exact (ordsuccI2 t). }
							          claim Hxst_eq : apply_fun xs12 t = apply_fun xs0 t.
							          { exact (Hpt t (ordsuccI2 t)). }
								          claim Hxst_G2 : apply_fun xs12 t :e G2.
								          {
								            claim Hx0 : apply_fun xs0 t = apply_fun xs0 k0.
								            {
								              claim Hs : ordsucc t = ordsucc k0.
								              { rewrite Hst_eq. rewrite Hn0_eq. reflexivity. }
								              claim Htk0 : t = k0.
								              { exact (ordsucc_inj t k0 Hs). }
								              rewrite Htk0.
								              reflexivity.
								            }
									            claim Hxk0_G2 : apply_fun xs0 k0 :e G2.
									            {
									              claim HGfam1 :
									                apply_fun (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2)) 1 = G2.
									              {
									                rewrite (apply_fun_graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2) 1 (UPairI2 0 1)).
									                rewrite (If_i_0 (1 = 0) G1 G2 neq_1_0).
									                reflexivity.
									              }
										              exact (eq_subst_mem_set (apply_fun xs0 k0)
										                (apply_fun (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2)) 1) G2
										                Hlast0
										                HGfam1).
										            }
								            exact (eq_subst_mem (apply_fun xs12 t) (apply_fun xs0 k0) G2 (eq_i_tra (apply_fun xs12 t) (apply_fun xs0 t) (apply_fun xs0 k0) Hxst_eq Hx0) Hxk0_G2).
								          }
							          claim Hxe : apply_fun xs12 t = eG.
							          { exact (free_product_binary_factors_intersect_trivial G multG eG invG G1 G2 (apply_fun xs12 t) Hfp Hxs12tG1 Hxst_G2). }
							          exact (FalseE (Hxs12t_ne Hxe) (apply_fun xsB kB :e G1)).
							      }
							      
							      (** Existence of a G2-letter in A. **)
							      claim HexG2B : exists i:set, i :e nB /\ apply_fun xsB i :e G2.
							      {
							        apply (xm (exists i:set, i :e nB /\ apply_fun xsB i :e G2)).
							        - assume Hex. exact Hex.
							        - assume Hno.
							          claim HallG1B : forall i:set, i :e nB -> apply_fun xsB i :e G1.
							          {
							            let i. assume Hi.
							            apply (Hside_union nB xsB HredB i Hi).
							            - assume HiG1. exact HiG1.
							            - assume HiG2.
							              claim Hex : exists j:set, j :e nB /\ apply_fun xsB j :e G2.
							              { witness i. exact (andI (i :e nB) (apply_fun xsB i :e G2) Hi HiG2). }
							              exact (FalseE (Hno Hex) (apply_fun xsB i :e G1)).
							          }
							          claim HxtG1 : xt :e G1.
							          {
							            rewrite <- HwpB.
							            exact (Hword_product_in_G1 nB xsB HredB HallG1B).
							          }
							          exact (FalseE (Hxt_notG1 HxtG1) (exists i:set, i :e nB /\ apply_fun xsB i :e G2)).
							      }
							      claim HexG1A : exists i:set, i :e nB /\ apply_fun xsB i :e G1.
							      { witness kB. exact (andI (kB :e nB) (apply_fun xsB kB :e G1) HkB_in HlastB_G1). }
							      
							      (** Split A using maximal G2 index. **)
							      apply (cor68_6_max_G2_index_suffix_all_in_G1
							        G multG eG invG G1 G2 J K Hfam efamH nB xsB
							        Hgrp Hsub1 Hsub2 Hfp Hfp1 Hfp2
							        HredB
							        HallNeB
							        HexG1A
							        HexG2B).
							      let mB. assume HmB_pack.
							      apply (and4E
							        (mB :e nB)
							        (apply_fun xsB mB :e G2)
							        (forall i:set, i :e nB -> apply_fun xsB i :e G2 -> i c= mB)
							        (forall i:set, i :e nB -> ordsucc mB c= i -> apply_fun xsB i :e G1)
							        HmB_pack).
							      assume HmB_in HxmB_G2 HmB_maxG2 HsuffixB_all_G1.
							      
							      (** mB is not the last index kB. **)
							      claim HmB_ne_kB : mB <> kB.
							      {
							        assume Hmk.
							        claim Hxk_G2 : apply_fun xsB kB :e G2.
								        { rewrite <- Hmk. exact HxmB_G2. }
								        claim Hxe : apply_fun xsB kB = eG.
								        { exact (free_product_binary_factors_intersect_trivial G multG eG invG G1 G2 (apply_fun xsB kB) Hfp HlastB_G1 Hxk_G2). }
								        exact (HallNeB kB HkB_in Hxe).
								      }
								      claim HmB_in_kB : mB :e kB.
								      {
								        apply (ordsuccE kB mB (eq_subst_mem_set mB nB (ordsucc kB) HmB_in HnB_eq)).
								        - assume Hm_in. exact Hm_in.
								        - assume Hmeq. exact (FalseE (HmB_ne_kB Hmeq) (mB :e kB)).
								      }
								      set n1B := ordsucc mB.
								      claim Hn1B_nat : nat_p n1B.
								      {
								        claim HmA_omega : mB :e omega.
								        { exact (omega_TransSet nB HnBO mB HmB_in). }
								        exact (nat_ordsucc mB (omega_nat_p mB HmA_omega)).
								      }
								      claim Hn1B_in_nB : n1B :e nB.
								      {
								        rewrite HnB_eq.
								        exact (nat_ordsucc_in_ordsucc kB HkB_nat mB HmB_in_kB).
								      }
								      apply (nat_mem_add_nat_decomp nB n1B HnB_nat Hn1B_in_nB).
								      let n2B. assume Hn2B_pack.
								      claim Hn2B_nat : nat_p n2B.
								      { exact (andEL (nat_p n2B) (nB = add_nat n1B n2B) Hn2B_pack). }
								      claim HnB_add : nB = add_nat n1B n2B.
								      { exact (andER (nat_p n2B) (nB = add_nat n1B n2B) Hn2B_pack). }
								      set xsB1 := graph n1B (fun i:set => apply_fun xsB i).
								      set xsB2 := graph n2B (fun i:set => apply_fun xsB (add_nat n1B i)).
								      claim HredB1 : reduced_word (J :\/: K) Hfam efamH n1B xsB1.
								      { exact (reduced_word_prefix (J :\/: K) Hfam efamH nB xsB n1B HredB Hn1B_in_nB). }
								      claim HredB2 : reduced_word (J :\/: K) Hfam efamH n2B xsB2.
								      { exact (reduced_word_suffix_by_add_nat (J :\/: K) Hfam efamH nB xsB n1B n2B HredB Hn1B_nat Hn2B_nat HnB_add). }
							      claim HallNeB1 : forall i:set, i :e n1B -> apply_fun xsB1 i <> eG.
							      {
							        let i. assume Hi1.
							        rewrite (apply_fun_graph n1B (fun j:set => apply_fun xsB j) i Hi1).
								        claim HiA : i :e nB.
								        {
								          claim Hsub : n1B c= add_nat n1B n2B.
								          { exact (add_nat_Subq_R' n1B Hn1B_nat n2B Hn2B_nat). }
								          claim Hi_sum : i :e add_nat n1B n2B.
								          { exact (Hsub i Hi1). }
								          exact (eq_subst_mem_set i (add_nat n1B n2B) nB Hi_sum (eq_symm nB (add_nat n1B n2B) HnB_add)).
								        }
							        exact (HallNeB i HiA).
							      }
							      claim HallNeB2 : forall i:set, i :e n2B -> apply_fun xsB2 i <> eG.
							      {
							        let i. assume Hi2.
								        rewrite (apply_fun_graph n2B (fun j:set => apply_fun xsB (add_nat n1B j)) i Hi2).
								        claim Hi_sum : add_nat n1B i :e add_nat n1B n2B.
								        { exact (add_nat_In_L n1B Hn1B_nat n2B Hn2B_nat i Hi2). }
								        claim HiA : add_nat n1B i :e nB.
								        { exact (eq_subst_mem_set (add_nat n1B i) (add_nat n1B n2B) nB Hi_sum (eq_symm nB (add_nat n1B n2B) HnB_add)). }
								        exact (HallNeB (add_nat n1B i) HiA).
								      }
							      claim HallG1B2 : forall i:set, i :e n2B -> apply_fun xsB2 i :e G1.
							      {
							        let i. assume Hi2.
								        rewrite (apply_fun_graph n2B (fun j:set => apply_fun xsB (add_nat n1B j)) i Hi2).
								        claim Hi_sum : add_nat n1B i :e add_nat n1B n2B.
								        { exact (add_nat_In_L n1B Hn1B_nat n2B Hn2B_nat i Hi2). }
								        claim HiA : add_nat n1B i :e nB.
								        { exact (eq_subst_mem_set (add_nat n1B i) (add_nat n1B n2B) nB Hi_sum (eq_symm nB (add_nat n1B n2B) HnB_add)). }
								        claim Hsub : ordsucc mB c= add_nat n1B i.
								        {
								          claim Hsub1 : n1B c= add_nat n1B i.
								          { exact (add_nat_Subq_R' n1B Hn1B_nat i (nat_p_trans n2B Hn2B_nat i Hi2)). }
								          exact Hsub1.
								        }
								        exact (HsuffixB_all_G1 (add_nat n1B i) HiA Hsub).
								      }
							      claim Hn2B_ne0 : n2B <> 0.
							      {
							        assume Hn20.
							        claim HnB_eq_n1 : nB = n1B.
							        { rewrite HnB_add. rewrite Hn20. rewrite (add_nat_0R n1B). reflexivity. }
							        claim Hk_eq : kB = mB.
							        {
							          claim Hs : ordsucc kB = ordsucc mB.
								          { rewrite <- HnB_eq. rewrite HnB_eq_n1. reflexivity. }
								          exact (ordsucc_inj kB mB Hs).
								        }
								        exact (HmB_ne_kB (eq_symm kB mB Hk_eq)).
								      }
							      set wpB2 := word_product multG eG xsB2 n2B.
							      claim HwpB2_G1 : wpB2 :e G1.
							      { exact (Hword_product_in_G1 n2B xsB2 HredB2 HallG1B2). }
							      claim HwpB2_ne : wpB2 <> eG.
							      {
							        exact (cor68_6_reduced_word_all_in_G1_product_ne_eG
							          G multG eG invG G1 G2 J K Hfam efamH n2B xsB2
							          Hgrp Hsub1 Hsub2 Hfp Hfp1 Hfp2
							          HredB2 HallNeB2 HallG1B2 Hn2B_ne0).
							      }
							      (** Collapse prefix A1 to a binary reduced word ending in G2 and append wpB2 in G1. **)
							      claim HmB_nat : nat_p mB.
							      { exact (nat_p_trans nB HnB_nat mB HmB_in). }
							      claim HmA_in_n1A : mB :e n1B.
							      { exact (ordsuccI2 mB). }
							      claim Hlast_prefB : apply_fun xsB1 mB :e apply_fun Gfam12 1.
							      {
							        rewrite (apply_fun_graph n1B (fun i:set => apply_fun xsB i) mB HmA_in_n1A).
							        rewrite (apply_fun_graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2) 1 (UPairI2 0 1)).
							        rewrite (If_i_0 (1 = 0) G1 G2 neq_1_0).
							        exact HxmB_G2.
							      }
							      claim HcollB1 :
							        exists np xb kp:set,
							          reduced_word (UPair 0 1)
							            (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2))
							            (graph (UPair 0 1) (fun _:set => eG))
							            np xb /\
							          word_product multG eG xb np = word_product multG eG xsB1 n1B /\
							          np <> 0 /\ nat_p kp /\ np = ordsucc kp /\
							          apply_fun xb kp :e apply_fun (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2)) 1.
							      {
							        exact (cor68_6_collapse_union_word_to_binary_end_in_factor
								          G multG eG invG G1 G2 J K Hfam efamH mB xsB1 1
								          Hgrp Hsub1 Hsub2 Hfp Hfp1 Hfp2
								          HmB_nat
								          HredB1
								          HallNeB1
								          (UPairI2 0 1)
								          Hlast_prefB).
								      }
							      apply HcollB1. let npB. assume HnpA_pack.
							      apply HnpA_pack. let xbB. assume HxbA_pack.
							      apply HxbA_pack. let kpB. assume HkpA_pack.
							      apply (and6E
							        (reduced_word (UPair 0 1)
							          (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2))
							          (graph (UPair 0 1) (fun _:set => eG))
							          npB xbB)
							        (word_product multG eG xbB npB = word_product multG eG xsB1 n1B)
							        (npB <> 0)
							        (nat_p kpB)
							        (npB = ordsucc kpB)
							        (apply_fun xbB kpB :e apply_fun (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2)) 1)
							        HkpA_pack).
							      assume HredbB HwpbB HnpB_ne0 HkpB_nat HnpB_eq HlastbB.
							      claim HxbB_last_ne : apply_fun xbB kpB <> eG.
							      {
							        apply (and3E
							          (npB :e omega)
							          (forall i:set, i :e npB ->
							            exists alpha:set, alpha :e (UPair 0 1) /\
							              apply_fun xbB i :e apply_fun Gfam12 alpha /\
							              apply_fun xbB i <> apply_fun (graph (UPair 0 1) (fun _:set => eG)) alpha)
							          (forall i:set, i :e npB -> ordsucc i :e npB ->
							            forall alpha beta:set, alpha :e (UPair 0 1) -> beta :e (UPair 0 1) ->
							              apply_fun xbB i :e apply_fun Gfam12 alpha ->
							              apply_fun xbB (ordsucc i) :e apply_fun Gfam12 beta ->
							              alpha <> beta)
							          HredbB).
							        assume _ Helem _.
							        claim Hkp_in : kpB :e npB.
							        { rewrite HnpB_eq. exact (ordsuccI2 kpB). }
							        apply (Helem kpB Hkp_in). let alpha. assume Halpha_pack.
							        apply (and3E (alpha :e (UPair 0 1))
							          (apply_fun xbB kpB :e apply_fun Gfam12 alpha)
							          (apply_fun xbB kpB <> apply_fun (graph (UPair 0 1) (fun _:set => eG)) alpha)
							          Halpha_pack).
							        assume Hal _ Hne.
							        claim Hef : apply_fun (graph (UPair 0 1) (fun _:set => eG)) alpha = eG.
							        { exact (apply_fun_graph (UPair 0 1) (fun _:set => eG) alpha Hal). }
							        assume Heq : apply_fun xbB kpB = eG.
							        apply Hne. rewrite Hef. exact Heq.
							      }
							      claim HwpB1_eq : word_product multG eG xsB1 n1B = word_product multG eG xbB npB.
							      { exact (eq_symm (word_product multG eG xbB npB) (word_product multG eG xsB1 n1B) HwpbB). }
							      set xsBext := graph (ordsucc npB) (fun i:set => if i :e npB then apply_fun xbB i else wpB2).
								      claim HredBext : reduced_word (UPair 0 1)
								        (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2))
								        (graph (UPair 0 1) (fun _:set => eG))
								        (ordsucc npB) xsBext.
								      {
								        claim HGfam0 :
								          apply_fun (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2)) 0 = G1.
								        {
								          rewrite (apply_fun_graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2) 0 (UPairI1 0 1)).
								          rewrite (If_i_1 (0 = 0) G1 G2 (eq_refl 0)).
								          reflexivity.
								        }
								        exact (binary_reduced_word_append_other_factor
								          G multG eG invG G1 G2 npB xbB wpB2 0 1 kpB
								          Hgrp Hfp HredbB
								          HkpB_nat HnpB_eq
								          (UPairI2 0 1)
								          HlastbB
								          HxbB_last_ne
								          (UPairI1 0 1)
								          (eq_subst_mem_set wpB2 G1 (apply_fun (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2)) 0) HwpB2_G1
								            (eq_symm (apply_fun (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2)) 0) G1 HGfam0))
								          HwpB2_ne
								          neq_1_0).
								      }
							      claim HxsBext_prod : word_product multG eG xsBext (ordsucc npB) =
							        apply_fun multG (word_product multG eG xbB npB, wpB2).
							      {
							        claim HnpA_omega : npB :e omega.
							        {
							          apply (and3E
							            (npB :e omega)
							            (forall i:set, i :e npB ->
							              exists alpha:set, alpha :e (UPair 0 1) /\
							                apply_fun xbB i :e apply_fun Gfam12 alpha /\
							                apply_fun xbB i <> apply_fun (graph (UPair 0 1) (fun _:set => eG)) alpha)
							            (forall i:set, i :e npB -> ordsucc i :e npB ->
							              forall alpha beta:set, alpha :e (UPair 0 1) -> beta :e (UPair 0 1) ->
							                apply_fun xbB i :e apply_fun Gfam12 alpha ->
							                apply_fun xbB (ordsucc i) :e apply_fun Gfam12 beta ->
							                alpha <> beta)
							            HredbB).
							          assume Hnp _ _. exact Hnp.
							        }
							        exact (word_product_append_one multG eG xbB wpB2 npB HnpA_omega).
							      }
							      (** Product of xsB is xt, hence the appended binary word also multiplies to xt. **)
							      claim HxsBG : forall i:set, i :e nB -> apply_fun xsB i :e G.
							      {
							        let i. assume Hi.
							        exact (reduced_word_in_G
							          G multG eG invG (J :\/: K) Hfam efamH nB xsB
							          Hsubfam_union HredB i Hi).
							      }
								      claim Hwp_splitB :
								        word_product multG eG xsB nB =
								          apply_fun multG
								            (word_product multG eG xsB1 n1B, word_product multG eG xsB2 n2B).
								      {
								        claim Hsplit0 :
								          word_product multG eG xsB nB =
								            apply_fun multG
								              (word_product multG eG xsB n1B,
								               word_product multG eG (graph n2B (fun i:set => apply_fun xsB (add_nat n1B i))) n2B).
									        {
									          exact (word_product_split_by_add_nat
									            G multG eG invG nB xsB n1B n2B
									            Hgrp Hn1B_nat Hn2B_nat HnB_add HxsBG).
									        }
									        claim HwpB1_eq2 :
									          word_product multG eG xsB n1B = word_product multG eG xsB1 n1B.
									        {
									          claim Hn1B_O : n1B :e omega. { exact (nat_p_omega n1B Hn1B_nat). }
									          apply (nat_primrec_ext eG
									            (fun j r:set => apply_fun multG (r, apply_fun xsB j))
									            (fun j r:set => apply_fun multG (r, apply_fun xsB1 j))
									            n1B
									            Hn1B_O).
									          let j r. assume Hj1.
									          rewrite (apply_fun_graph n1B (fun t:set => apply_fun xsB t) j Hj1).
									          reflexivity.
									        }
									        rewrite Hsplit0.
									        rewrite HwpB1_eq2.
									        reflexivity.
									      }
							      claim HwpBext_xt : word_product multG eG xsBext (ordsucc npB) = xt.
							      {
								        rewrite HxsBext_prod.
								        rewrite <- HwpB1_eq.
								        rewrite <- Hwp_splitB.
								        exact HwpB.
								      }
							      claim HuniqBext : ordsucc t = ordsucc npB /\
							        (forall i:set, i :e ordsucc t -> apply_fun xs12 i = apply_fun xsBext i).
							      { exact (Huniq_xt (ordsucc npB) xsBext HredBext (neq_ordsucc_0 npB) HwpBext_xt). }
							      claim Ht_eq_npB : t = npB.
							      {
							        claim Hs : ordsucc t = ordsucc npB.
							        { exact (andEL (ordsucc t = ordsucc npB) (forall i:set, i :e ordsucc t -> apply_fun xs12 i = apply_fun xsBext i) HuniqBext). }
							        exact (ordsucc_inj t npB Hs).
							      }
							      claim HwpB2_eq : wpB2 = apply_fun xs12 t.
							      {
							        claim Hpt : forall i:set, i :e ordsucc t -> apply_fun xs12 i = apply_fun xsBext i.
							        { exact (andER (ordsucc t = ordsucc npB) (forall i:set, i :e ordsucc t -> apply_fun xs12 i = apply_fun xsBext i) HuniqBext). }
							        claim Ht_in : t :e ordsucc t. { exact (ordsuccI2 t). }
							        claim Hxs12t_eq : apply_fun xs12 t = apply_fun xsBext t.
							        { exact (Hpt t Ht_in). }
							        claim HxsBext_t : apply_fun xsBext t = wpB2.
							        {
							          rewrite Ht_eq_npB.
							          claim Hgr : apply_fun xsBext npB =
							            if npB :e npB then apply_fun xbB npB else wpB2.
							          { exact (apply_fun_graph (ordsucc npB) (fun i:set => if i :e npB then apply_fun xbB i else wpB2) npB (ordsuccI2 npB)). }
							          rewrite Hgr.
							          rewrite (If_i_0 (npB :e npB) (apply_fun xbB npB) wpB2 (In_irref npB)).
							          reflexivity.
							        }
							        exact (eq_symm (apply_fun xs12 t) wpB2 (eq_i_tra (apply_fun xs12 t) (apply_fun xsBext t) wpB2 Hxs12t_eq HxsBext_t)).
							      }
								      

										      (** TODO: compare A and B and conclude uniqueness. **)
										      claim Hwp2_eq_AB : wpA2 = wpB2.
										      {
										        exact (eq_i_tra
										          wpA2
										          (apply_fun xs12 t)
										          wpB2
										          HwpA2_eq
										          (eq_symm wpB2 (apply_fun xs12 t) HwpB2_eq)).
										      }
										      set GfamJ := graph J (fun a:set => apply_fun Hfam a).
										      set efamJ := graph J (fun a:set => apply_fun efamH a).
										      claim HredA2_J : reduced_word J GfamJ efamJ n2A xsA2.
										      {
										        exact (cor68_6_reduced_word_all_in_G1_is_reduced_word_J
										          G multG eG invG G1 G2 J K Hfam efamH n2A xsA2
										          Hgrp Hsub1 Hsub2 Hfp Hfp1 Hfp2
										          HredA2 HallNeA2 HallG1A2).
										      }
										      claim HredB2_J : reduced_word J GfamJ efamJ n2B xsB2.
										      {
										        exact (cor68_6_reduced_word_all_in_G1_is_reduced_word_J
										          G multG eG invG G1 G2 J K Hfam efamH n2B xsB2
										          Hgrp Hsub1 Hsub2 Hfp Hfp1 Hfp2
										          HredB2 HallNeB2 HallG1B2).
										      }
										      claim HwpB2_eqA : word_product multG eG xsB2 n2B = wpA2.
										      {
										        claim HwpB2_def : word_product multG eG xsB2 n2B = wpB2.
										        { reflexivity. }
										        exact (eq_i_tra
										          (word_product multG eG xsB2 n2B)
										          wpB2
										          wpA2
										          HwpB2_def
										          (eq_symm wpA2 wpB2 Hwp2_eq_AB)).
										      }
										      claim Hsuffix_pack : n2A = n2B /\ (forall i:set, i :e n2A -> apply_fun xsA2 i = apply_fun xsB2 i).
										      {
										        apply (and6E
										          (group_structure G1 multG eG invG)
										          (forall alpha:set, alpha :e J ->
										            subgroup_of (apply_fun GfamJ alpha) G1 multG eG invG)
										          (forall alpha beta:set, alpha :e J -> beta :e J -> alpha <> beta ->
										            forall x:set, x :e apply_fun GfamJ alpha -> x :e apply_fun GfamJ beta -> x = eG)
										          (subgroups_generate G1 multG eG invG J GfamJ)
										          (forall x:set, x :e G1 -> x <> eG ->
										            exists n0 xs0:set,
										              reduced_word J GfamJ efamJ n0 xs0 /\ n0 <> 0 /\
										              word_product multG eG xs0 n0 = x /\
										              (forall n' xs':set,
										                reduced_word J GfamJ efamJ n' xs' ->
										                n' <> 0 -> word_product multG eG xs' n' = x ->
										                n0 = n' /\ (forall i0:set, i0 :e n0 -> apply_fun xs0 i0 = apply_fun xs' i0)))
										          (forall alpha:set, alpha :e J -> apply_fun efamJ alpha = eG)
										          Hfp1).
										        assume _ _ _ _ HuniqJ _.
										        claim Huniq_pack :
										          exists n0 xs0:set,
										            reduced_word J GfamJ efamJ n0 xs0 /\ n0 <> 0 /\
										            word_product multG eG xs0 n0 = wpA2 /\
										            (forall n' xs':set,
										              reduced_word J GfamJ efamJ n' xs' ->
										              n' <> 0 -> word_product multG eG xs' n' = wpA2 ->
										              n0 = n' /\ (forall i0:set, i0 :e n0 -> apply_fun xs0 i0 = apply_fun xs' i0)).
										        { exact (HuniqJ wpA2 HwpA2_G1 HwpA2_ne). }
										        apply Huniq_pack. let n0. assume Hn0_pack.
										        apply Hn0_pack. let xs0. assume Hxs0_pack.
										        apply (and4E
										          (reduced_word J GfamJ efamJ n0 xs0)
										          (n0 <> 0)
										          (word_product multG eG xs0 n0 = wpA2)
										          (forall n' xs':set,
										            reduced_word J GfamJ efamJ n' xs' ->
										            n' <> 0 -> word_product multG eG xs' n' = wpA2 ->
										            n0 = n' /\ (forall i0:set, i0 :e n0 -> apply_fun xs0 i0 = apply_fun xs' i0))
										          Hxs0_pack).
										        assume Hred0 Hn0_ne0 Hwp0 Huniq0.
										        claim HuA : n0 = n2A /\ (forall i0:set, i0 :e n0 -> apply_fun xs0 i0 = apply_fun xsA2 i0).
										        { exact (Huniq0 n2A xsA2 HredA2_J Hn2A_ne0 (eq_refl wpA2)). }
										        claim HuB : n0 = n2B /\ (forall i0:set, i0 :e n0 -> apply_fun xs0 i0 = apply_fun xsB2 i0).
										        { exact (Huniq0 n2B xsB2 HredB2_J Hn2B_ne0 HwpB2_eqA). }
										        claim Hn2_eq : n2A = n2B.
										        {
										          claim H0A : n0 = n2A.
										          { exact (andEL (n0 = n2A) (forall i0:set, i0 :e n0 -> apply_fun xs0 i0 = apply_fun xsA2 i0) HuA). }
										          claim H0B : n0 = n2B.
										          { exact (andEL (n0 = n2B) (forall i0:set, i0 :e n0 -> apply_fun xs0 i0 = apply_fun xsB2 i0) HuB). }
										          exact (eq_i_tra n2A n0 n2B (eq_symm n0 n2A H0A) H0B).
										        }
										        apply andI.
										        - exact Hn2_eq.
										        - let i. assume Hi2.
										          claim Hi0 : i :e n0.
										          {
										            claim H0A : n0 = n2A.
										            { exact (andEL (n0 = n2A) (forall i0:set, i0 :e n0 -> apply_fun xs0 i0 = apply_fun xsA2 i0) HuA). }
										            exact (eq_subst_mem_set i n2A n0 Hi2 (eq_symm n0 n2A H0A)).
										          }
										          claim H0Aeq : apply_fun xs0 i = apply_fun xsA2 i.
										          { exact (andER (n0 = n2A) (forall i0:set, i0 :e n0 -> apply_fun xs0 i0 = apply_fun xsA2 i0) HuA i Hi0). }
										          claim H0Beq : apply_fun xs0 i = apply_fun xsB2 i.
										          { exact (andER (n0 = n2B) (forall i0:set, i0 :e n0 -> apply_fun xs0 i0 = apply_fun xsB2 i0) HuB i Hi0). }
										          exact (eq_i_tra
										            (apply_fun xsA2 i)
										            (apply_fun xs0 i)
										            (apply_fun xsB2 i)
										            (eq_symm (apply_fun xs0 i) (apply_fun xsA2 i) H0Aeq)
										            H0Beq).
										      }
											      apply (xm (t = 1)).
											      - assume Ht1.
											        (** Base case t = 1: compare prefixes directly using the K-uniqueness in G2. **)
											        set xtp := word_product multG eG xs12 t.
											        claim Hxs12tG : apply_fun xs12 t :e G.
											        { exact (subgroup_of_subset G1 G multG eG invG Hsub1 (apply_fun xs12 t) Hxs12tG1). }
											        claim Hxt_split :
											          word_product multG eG xs12 (ordsucc t) =
											          apply_fun multG (xtp, apply_fun xs12 t).
											        { exact (word_product_succ multG eG xs12 t Ht_nat). }
											        claim Hxs12t_ne' : apply_fun xs12 t <> eG.
											        { exact Hxs12t_ne. }
											        claim Ht_eq1 : t = 1. { exact Ht1. }
											
											        (** Show xtp is the first binary letter and lies in G2. **)
											        claim Hx0_in_sn : 0 :e ordsucc t.
											        { exact (nat_0_in_ordsucc t Ht_nat). }
											        claim Hxtp_eq_x0 : xtp = apply_fun xs12 0.
											        {
											          rewrite Ht_eq1.
											          claim HwpS :
											            word_product multG eG xs12 (ordsucc 0) =
											            apply_fun multG (word_product multG eG xs12 0, apply_fun xs12 0).
											          {
											            exact (nat_primrec_S
											              eG
											              (fun i r:set => apply_fun multG (r, apply_fun xs12 i))
											              0
