		                        exact (group_homomorphism_preserves_power_nat_cyclic_helper
		                          int
		                          integers_group_mult
		                          0
		                          integers_group_inv
		                          G
		                          multG
		                          eG
		                          invG
		                          hifam
		                          1
		                          t
