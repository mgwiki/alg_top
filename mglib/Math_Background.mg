    X
    Tx
    x0
    x1
    alpha
    x
    Hx).
  reflexivity.
}
rewrite HcompExpand.
claim HxExpand : x = cls_beta.
{
  rewrite HxDef.
  exact HbetaMapEq.
}
rewrite HxExpand.
set pby :=
  path_concat
    (Eps_i (fun g:set => g :e y))
    beta.
claim HepsYLoop :
  (Eps_i (fun g:set => g :e y)) :e loop_space X Tx x1.
