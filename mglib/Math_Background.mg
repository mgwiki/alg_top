            }
            claim HrEx :
              exists r:set, r :e k /\
                ordsucc m0 = add_nat (mul_nat q k) r.
            {
              exact (andER
                (q :e omega)
                (exists r:set, r :e k /\
                  ordsucc m0 = add_nat (mul_nat q k) r)
