    assume Halpha0JH0 HxiH0 HxiNeEfam0.
    claim HpackB :
      exists beta0:set, beta0 :e JH0 /\
        apply_fun xs (ordsucc i) :e apply_fun GfamH0 beta0 /\
        apply_fun xs (ordsucc i) <> apply_fun efamH0 beta0.
