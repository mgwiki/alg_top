											        (** Membership facts for cancellation. **)
											        claim HxsA1G : forall i:set, i :e n1A -> apply_fun xsA1 i :e G.
											        {
											          let i. assume Hi1.
											          rewrite (apply_fun_graph n1A (fun j:set => apply_fun xsA j) i Hi1).
											          claim HiA : i :e nA.
											          {
											            claim Hsub : n1A c= add_nat n1A n2A.
