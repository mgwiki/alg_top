(** Helper: least_normal_subgroup has the expected properties (early copy) **)
(** Proven Bob **)
Lemma least_normal_subgroup_props_early :
  forall G mult e inv S:set,
  group_structure G mult e inv ->
  S c= G ->
  normal_subgroup (least_normal_subgroup G mult e inv S) G mult e inv /\
  S c= (least_normal_subgroup G mult e inv S) /\
  (forall N':set, normal_subgroup N' G mult e inv -> S c= N' ->
    (least_normal_subgroup G mult e inv S) c= N').
let G mult e inv S.
assume HgrpG : group_structure G mult e inv.
assume HSsubG : S c= G.
(** Construct the intersection of all normal subgroups containing S **)
set I := {g :e G | forall M:set, normal_subgroup M G mult e inv -> S c= M -> g :e M}.
(** Extract group structure components **)
claim HmultF : function_on mult (setprod G G) G.
{ apply (and6E
    (function_on mult (setprod G G) G) (function_on inv G G) (e :e G)
    (forall a b c:set, a :e G -> b :e G -> c :e G ->
      apply_fun mult (apply_fun mult (a, b), c) = apply_fun mult (a, apply_fun mult (b, c)))
    (forall a:set, a :e G -> apply_fun mult (e, a) = a /\ apply_fun mult (a, e) = a)
    (forall a:set, a :e G ->
      apply_fun mult (a, apply_fun inv a) = e /\ apply_fun mult (apply_fun inv a, a) = e)
    HgrpG).
  assume Hmult _ _ _ _ _. exact Hmult. }
claim HinvF : function_on inv G G.
{ apply (and6E
    (function_on mult (setprod G G) G) (function_on inv G G) (e :e G)
    (forall a b c:set, a :e G -> b :e G -> c :e G ->
      apply_fun mult (apply_fun mult (a, b), c) = apply_fun mult (a, apply_fun mult (b, c)))
    (forall a:set, a :e G -> apply_fun mult (e, a) = a /\ apply_fun mult (a, e) = a)
    (forall a:set, a :e G ->
      apply_fun mult (a, apply_fun inv a) = e /\ apply_fun mult (apply_fun inv a, a) = e)
    HgrpG).
  assume _ Hinv _ _ _ _. exact Hinv. }
claim HeG : e :e G.
{ apply (and6E
    (function_on mult (setprod G G) G) (function_on inv G G) (e :e G)
    (forall a b c:set, a :e G -> b :e G -> c :e G ->
      apply_fun mult (apply_fun mult (a, b), c) = apply_fun mult (a, apply_fun mult (b, c)))
    (forall a:set, a :e G -> apply_fun mult (e, a) = a /\ apply_fun mult (a, e) = a)
    (forall a:set, a :e G ->
      apply_fun mult (a, apply_fun inv a) = e /\ apply_fun mult (apply_fun inv a, a) = e)
    HgrpG).
  assume _ _ He _ _ _. exact He. }
claim HinvG : forall x:set, x :e G -> apply_fun inv x :e G.
{ let x. assume HxG. exact (HinvF x HxG). }
claim HmultG : forall x y:set, x :e G -> y :e G -> apply_fun mult (x, y) :e G.
{ let x y. assume HxG HyG.
  exact (HmultF (x, y) (tuple_2_setprod_by_pair_Sigma G G x y HxG HyG)). }
(** I is a subset of G **)
claim HIsubG : I c= G.
{ let g. assume HgI : g :e I. exact (SepE1 G (fun g:set => forall M:set, normal_subgroup M G mult e inv -> S c= M -> g :e M) g HgI). }
(** S subset of I **)
claim HSsubI : S c= I.
{ let s. assume HsS : s :e S.
  exact (SepI G (fun g:set => forall M:set, normal_subgroup M G mult e inv -> S c= M -> g :e M)
    s (HSsubG s HsS)
    (fun M:set => fun HnormM : normal_subgroup M G mult e inv =>
      fun HSsubM : S c= M => HSsubM s HsS)). }
(** e in I **)
claim HeI : e :e I.
{ exact (SepI G (fun g:set => forall M:set, normal_subgroup M G mult e inv -> S c= M -> g :e M)
    e HeG
    (fun M:set => fun HnormM : normal_subgroup M G mult e inv =>
      fun HSsubM : S c= M =>
        subgroup_of_unit M G mult e inv
          (normal_subgroup_subgroup M G mult e inv HnormM))). }
(** I closed under mult **)
claim HImult : forall x y:set, x :e I -> y :e I -> apply_fun mult (x, y) :e I.
{ let x y. assume HxI : x :e I. assume HyI : y :e I.
  claim HxG : x :e G. { exact (HIsubG x HxI). }
  claim HyG : y :e G. { exact (HIsubG y HyI). }
  claim Hx_prop : forall M:set, normal_subgroup M G mult e inv -> S c= M -> x :e M.
  { exact (SepE2 G (fun g:set => forall M:set, normal_subgroup M G mult e inv -> S c= M -> g :e M) x HxI). }
  claim Hy_prop : forall M:set, normal_subgroup M G mult e inv -> S c= M -> y :e M.
  { exact (SepE2 G (fun g:set => forall M:set, normal_subgroup M G mult e inv -> S c= M -> g :e M) y HyI). }
  exact (SepI G (fun g:set => forall M:set, normal_subgroup M G mult e inv -> S c= M -> g :e M)
    (apply_fun mult (x, y)) (HmultG x y HxG HyG)
    (fun M:set => fun HnormM : normal_subgroup M G mult e inv =>
      fun HSsubM : S c= M =>
        subgroup_of_mult_closed M G mult e inv x y
          (normal_subgroup_subgroup M G mult e inv HnormM)
          (Hx_prop M HnormM HSsubM) (Hy_prop M HnormM HSsubM))). }
(** I closed under inv **)
claim HIinv : forall x:set, x :e I -> apply_fun inv x :e I.
{ let x. assume HxI : x :e I.
  claim HxG : x :e G. { exact (HIsubG x HxI). }
  claim Hx_prop : forall M:set, normal_subgroup M G mult e inv -> S c= M -> x :e M.
  { exact (SepE2 G (fun g:set => forall M:set, normal_subgroup M G mult e inv -> S c= M -> g :e M) x HxI). }
  exact (SepI G (fun g:set => forall M:set, normal_subgroup M G mult e inv -> S c= M -> g :e M)
    (apply_fun inv x) (HinvG x HxG)
    (fun M:set => fun HnormM : normal_subgroup M G mult e inv =>
      fun HSsubM : S c= M =>
        subgroup_of_inv_closed M G mult e inv x
          (normal_subgroup_subgroup M G mult e inv HnormM)
          (Hx_prop M HnormM HSsubM))). }
(** I is a subgroup of G **)
claim HsubI : subgroup_of I G mult e inv.
{ exact (and4I (I c= G) (e :e I)
    (forall x y:set, x :e I -> y :e I -> apply_fun mult (x, y) :e I)
    (forall x:set, x :e I -> apply_fun inv x :e I)
    HIsubG HeI HImult HIinv). }
(** I is closed under conjugation **)
claim HIconj : forall n g:set, n :e I -> g :e G ->
  apply_fun mult (apply_fun mult (g, n), apply_fun inv g) :e I.
{ let n g. assume HnI : n :e I. assume HgG : g :e G.
  claim HnG : n :e G. { exact (HIsubG n HnI). }
  claim Hn_prop : forall M:set, normal_subgroup M G mult e inv -> S c= M -> n :e M.
  { exact (SepE2 G (fun g:set => forall M:set, normal_subgroup M G mult e inv -> S c= M -> g :e M) n HnI). }
  claim Hconj_in_G : apply_fun mult (apply_fun mult (g, n), apply_fun inv g) :e G.
  { exact (HmultG (apply_fun mult (g, n)) (apply_fun inv g)
      (HmultG g n HgG HnG) (HinvG g HgG)). }
  exact (SepI G (fun h:set => forall M:set, normal_subgroup M G mult e inv -> S c= M -> h :e M)
    (apply_fun mult (apply_fun mult (g, n), apply_fun inv g)) Hconj_in_G
    (fun M:set => fun HnormM : normal_subgroup M G mult e inv =>
      fun HSsubM : S c= M =>
        normal_subgroup_conj_closed M G mult e inv
          n g HnormM (Hn_prop M HnormM HSsubM) HgG)). }
(** I is normal in G **)
claim HnormI : normal_subgroup I G mult e inv.
{ exact (andI (subgroup_of I G mult e inv)
    (forall n g:set, n :e I -> g :e G ->
      apply_fun mult (apply_fun mult (g, n), apply_fun inv g) :e I)
    HsubI HIconj). }
(** Minimality **)
claim Hminimal : forall N':set, normal_subgroup N' G mult e inv -> S c= N' -> I c= N'.
{ let N'. assume HnormN' : normal_subgroup N' G mult e inv.
  assume HSsubN' : S c= N'.
  let g. assume HgI : g :e I.
  exact (SepE2 G (fun h:set => forall M:set, normal_subgroup M G mult e inv -> S c= M -> h :e M)
    g HgI N' HnormN' HSsubN'). }
(** Existence witness for Eps_i **)
claim Hex : exists N:set,
  normal_subgroup N G mult e inv /\
  S c= N /\
  (forall N':set, normal_subgroup N' G mult e inv -> S c= N' -> N c= N').
{ witness I. exact (and3I
    (normal_subgroup I G mult e inv)
    (S c= I)
    (forall N':set, normal_subgroup N' G mult e inv -> S c= N' -> I c= N')
    HnormI HSsubI Hminimal). }
(** Apply Eps_i_ex **)
exact (Eps_i_ex
  (fun N:set =>
    normal_subgroup N G mult e inv /\
    S c= N /\
    (forall N':set, normal_subgroup N' G mult e inv -> S c= N' -> N c= N'))
  Hex).
Qed.

(** from S68 Lem 68.9 (line 3010 in algtop.tex): generators of least normal subgroup **)
(** LATEX VERSION: If N is the least normal subgroup of G containing S, then N is **)
(** generated by all conjugates of elements of S. **)
(** Admin-approved-refactored per noticeboard proposal 1772562734 **)
(** Admin-approved-refactored per noticeboard proposal 1772588215 **)
(** EFFORT: 8 lines textbook, difficulty 4/10, USD 80 **)
(** Collected Bob 88 **)
(** Proven Bob **)
Theorem lemma68_9_least_normal_generated_by_conjugates :
  forall G mult e inv S:set,
  group_structure G mult e inv ->
  S c= G ->
  let N := least_normal_subgroup G mult e inv S in
  let conjugates := Union (Repl G (fun c:set =>
    Repl S (fun t:set => apply_fun mult (apply_fun mult (c, t), apply_fun inv c)))) in
  conjugates c= N.
let G mult e inv S.
assume Hgrp HSsub.
set N := least_normal_subgroup G mult e inv S.
set conjugates := Union (Repl G (fun c:set =>
  Repl S (fun t:set => apply_fun mult (apply_fun mult (c, t), apply_fun inv c)))).
claim Hprops :
  normal_subgroup N G mult e inv /\ S c= N /\
  (forall N':set, normal_subgroup N' G mult e inv -> S c= N' -> N c= N').
{
  exact (least_normal_subgroup_props_early G mult e inv S Hgrp HSsub).
}
apply (and3E
  (normal_subgroup N G mult e inv)
  (S c= N)
  (forall N':set, normal_subgroup N' G mult e inv -> S c= N' -> N c= N')
  Hprops).
assume HnormN HSsubN _.
let x. assume Hx : x :e conjugates.
apply (UnionE
  (Repl G (fun c:set =>
    Repl S (fun t:set => apply_fun mult (apply_fun mult (c, t), apply_fun inv c))))
  x
  Hx).
let C.
assume HCpack.
claim HxC : x :e C.
{
  exact (andEL
    (x :e C)
    (C :e Repl G (fun c:set =>
      Repl S (fun t:set => apply_fun mult (apply_fun mult (c, t), apply_fun inv c))))
    HCpack).
}
claim HCIn : C :e Repl G (fun c:set =>
  Repl S (fun t:set => apply_fun mult (apply_fun mult (c, t), apply_fun inv c))).
{
  exact (andER
    (x :e C)
    (C :e Repl G (fun c:set =>
      Repl S (fun t:set => apply_fun mult (apply_fun mult (c, t), apply_fun inv c))))
    HCpack).
}
apply (ReplE
  G
  (fun c:set =>
    Repl S (fun t:set => apply_fun mult (apply_fun mult (c, t), apply_fun inv c)))
  C
  HCIn).
let c.
assume HcPack.
claim HcG : c :e G.
{
  exact (andEL
    (c :e G)
    (C = Repl S (fun t:set => apply_fun mult (apply_fun mult (c, t), apply_fun inv c)))
    HcPack).
}
claim HCeq : C = Repl S (fun t:set =>
  apply_fun mult (apply_fun mult (c, t), apply_fun inv c)).
{
  exact (andER
    (c :e G)
    (C = Repl S (fun t:set => apply_fun mult (apply_fun mult (c, t), apply_fun inv c)))
    HcPack).
}
claim HxRepl : x :e Repl S (fun t:set =>
  apply_fun mult (apply_fun mult (c, t), apply_fun inv c)).
{
  rewrite <- HCeq.
  exact HxC.
}
apply (ReplE S (fun t:set => apply_fun mult (apply_fun mult (c, t), apply_fun inv c)) x HxRepl).
let t.
assume HtPack.
claim HtS : t :e S.
{
  exact (andEL
    (t :e S)
    (x = apply_fun mult (apply_fun mult (c, t), apply_fun inv c))
    HtPack).
}
claim HxEq : x = apply_fun mult (apply_fun mult (c, t), apply_fun inv c).
{
  exact (andER
    (t :e S)
    (x = apply_fun mult (apply_fun mult (c, t), apply_fun inv c))
    HtPack).
}
rewrite HxEq.
claim HtN : t :e N.
{ exact (HSsubN t HtS). }
exact (normal_subgroup_conj_closed N G mult e inv t c HnormN HtN HcG).
Qed.

(** Helper: in a free product, mult(a,b) <> e when a in G1\{e} and b in G2\{e} **)
Lemma ex68_2a_ab_ne_e : forall G mult e inv G1 G2 a b:set,
  group_structure G mult e inv ->
  G1 c= G -> G2 c= G ->
  (forall x:set, x :e G1 -> apply_fun inv x :e G1) ->
  (forall x:set, x :e G1 -> x :e G2 -> x = e) ->
  a :e G1 -> a <> e -> b :e G2 -> b <> e ->
  apply_fun mult (a, b) <> e.
let G mult e inv G1 G2 a b.
assume Hgrp HG1sub HG2sub HG1inv Hinter HaG1 Hane HbG2 Hbne.
assume Hab_eq_e : apply_fun mult (a, b) = e.
apply (and6E
  (function_on mult (setprod G G) G)
  (function_on inv G G)
  (e :e G)
  (forall x y z:set, x :e G -> y :e G -> z :e G ->
    apply_fun mult (apply_fun mult (x, y), z) = apply_fun mult (x, apply_fun mult (y, z)))
  (forall x:set, x :e G -> apply_fun mult (e, x) = x /\ apply_fun mult (x, e) = x)
  (forall x:set, x :e G ->
    apply_fun mult (x, apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x, x) = e)
  Hgrp).
assume HmultF HinvF HeG Hassoc Hid Hinverse.
claim HaG : a :e G. { exact (HG1sub a HaG1). }
claim HbG : b :e G. { exact (HG2sub b HbG2). }
claim HinvaG1 : apply_fun inv a :e G1. { exact (HG1inv a HaG1). }
claim HinvaG : apply_fun inv a :e G. { exact (HG1sub (apply_fun inv a) HinvaG1). }
claim Hinva_a : apply_fun mult (apply_fun inv a, a) = e.
{ exact (andER
    (apply_fun mult (a, apply_fun inv a) = e)
    (apply_fun mult (apply_fun inv a, a) = e)
    (Hinverse a HaG)). }
claim HidL_b : apply_fun mult (e, b) = b.
{ exact (andEL
    (apply_fun mult (e, b) = b)
    (apply_fun mult (b, e) = b)
    (Hid b HbG)). }
claim HidR_inva : apply_fun mult (apply_fun inv a, e) = apply_fun inv a.
{ exact (andER
    (apply_fun mult (e, apply_fun inv a) = apply_fun inv a)
    (apply_fun mult (apply_fun inv a, e) = apply_fun inv a)
    (Hid (apply_fun inv a) HinvaG)). }
claim Hassoc_step : apply_fun mult (apply_fun mult (apply_fun inv a, a), b)
  = apply_fun mult (apply_fun inv a, apply_fun mult (a, b)).
{ exact (Hassoc (apply_fun inv a) a b HinvaG HaG HbG). }
claim Hlhs : apply_fun mult (apply_fun inv a, apply_fun mult (a, b)) = b.
{ rewrite <- Hassoc_step. rewrite Hinva_a. exact HidL_b. }
claim Hrhs : apply_fun mult (apply_fun inv a, apply_fun mult (a, b))
  = apply_fun inv a.
{ rewrite Hab_eq_e. exact HidR_inva. }
claim Hbeq : b = apply_fun inv a.
{ rewrite <- Hlhs. exact Hrhs. }
claim Hb_in_G1 : b :e G1. { rewrite Hbeq. exact HinvaG1. }
exact (Hbne (Hinter b Hb_in_G1 HbG2)).
Qed.

(** Helper: construct a 2-element reduced word [x,y] and compute its product **)
Lemma ex68_2a_word_helper : forall G mult e inv G1 G2 x y:set,
  group_structure G mult e inv ->
  G1 c= G -> G2 c= G ->
  (forall alpha beta:set, alpha :e 2 -> beta :e 2 -> alpha <> beta ->
    forall z:set, z :e apply_fun (graph 2 (fun i:set => If_i (i = 0) G1 G2)) alpha ->
      z :e apply_fun (graph 2 (fun i:set => If_i (i = 0) G1 G2)) beta ->
      z = e) ->
  x :e G1 -> x <> e -> y :e G2 -> y <> e ->
  let Gfam := graph 2 (fun i:set => If_i (i = 0) G1 G2) in
  let efam := graph 2 (fun _:set => e) in
  let xs := graph 2 (fun i:set => If_i (i = 0) x y) in
  reduced_word 2 Gfam efam 2 xs /\
  word_product mult e xs 2 = apply_fun mult (x, y).
let G mult e inv G1 G2 x y.
assume Hgrp HG1sub HG2sub Hinter HxG1 Hxne HyG2 Hyne.
set Gfam := graph 2 (fun i:set => If_i (i = 0) G1 G2).
set efam := graph 2 (fun _:set => e).
set xs := graph 2 (fun i:set => If_i (i = 0) x y).
apply (and6E
  (function_on mult (setprod G G) G)
  (function_on inv G G)
  (e :e G)
  (forall u v w:set, u :e G -> v :e G -> w :e G ->
    apply_fun mult (apply_fun mult (u, v), w) = apply_fun mult (u, apply_fun mult (v, w)))
  (forall u:set, u :e G -> apply_fun mult (e, u) = u /\ apply_fun mult (u, e) = u)
  (forall u:set, u :e G ->
    apply_fun mult (u, apply_fun inv u) = e /\ apply_fun mult (apply_fun inv u, u) = e)
  Hgrp).
assume HmultF HinvF HeG Hassoc Hid Hinverse.
claim HxG : x :e G. { exact (HG1sub x HxG1). }
claim HyG : y :e G. { exact (HG2sub y HyG2). }
claim H00 : 0 = 0. { reflexivity. }
claim Hn00 : ~(1 = 0). { exact neq_1_0. }
claim HGfam0 : apply_fun Gfam 0 = G1.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 0 In_0_2).
  exact (If_i_1 (0 = 0) G1 G2 H00). }
claim HGfam1 : apply_fun Gfam 1 = G2.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 1 In_1_2).
  exact (If_i_0 (1 = 0) G1 G2 Hn00). }
claim Hefam0 : apply_fun efam 0 = e.
{ exact (apply_fun_graph 2 (fun _:set => e) 0 In_0_2). }
claim Hefam1 : apply_fun efam 1 = e.
{ exact (apply_fun_graph 2 (fun _:set => e) 1 In_1_2). }
claim Hxs0 : apply_fun xs 0 = x.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) x y) 0 In_0_2).
  exact (If_i_1 (0 = 0) x y H00). }
claim Hxs1 : apply_fun xs 1 = y.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) x y) 1 In_1_2).
  exact (If_i_0 (1 = 0) x y Hn00). }
claim H2omega : 2 :e omega. { exact (nat_p_omega 2 nat_2). }
(** Prove reduced_word **)
claim Hreduced : reduced_word 2 Gfam efam 2 xs.
{
  prove 2 :e omega /\
    (forall i:set, i :e 2 ->
      exists alpha:set, alpha :e 2 /\
        apply_fun xs i :e apply_fun Gfam alpha /\ apply_fun xs i <> apply_fun efam alpha) /\
    (forall i:set, i :e 2 -> ordsucc i :e 2 ->
      forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
        apply_fun xs i :e apply_fun Gfam alpha ->
        apply_fun xs (ordsucc i) :e apply_fun Gfam beta -> alpha <> beta).
  apply and3I.
  - exact H2omega.
  - let i. assume Hi : i :e 2.
    apply (cases_2 i Hi
      (fun j:set => exists alpha:set, alpha :e 2 /\
        apply_fun xs j :e apply_fun Gfam alpha /\ apply_fun xs j <> apply_fun efam alpha)).
    + prove exists alpha:set, alpha :e 2 /\
        apply_fun xs 0 :e apply_fun Gfam alpha /\ apply_fun xs 0 <> apply_fun efam alpha.
      witness 0. apply and3I.
      * exact In_0_2.
      * { rewrite Hxs0. rewrite HGfam0. exact HxG1. }
      * { rewrite Hxs0. rewrite Hefam0. exact Hxne. }
    + prove exists alpha:set, alpha :e 2 /\
        apply_fun xs 1 :e apply_fun Gfam alpha /\ apply_fun xs 1 <> apply_fun efam alpha.
      witness 1. apply and3I.
      * exact In_1_2.
      * { rewrite Hxs1. rewrite HGfam1. exact HyG2. }
      * { rewrite Hxs1. rewrite Hefam1. exact Hyne. }
  - let i. assume Hi : i :e 2. assume Hsi : ordsucc i :e 2.
    let alpha beta. assume Halpha : alpha :e 2. assume Hbeta : beta :e 2.
    assume Hxi : apply_fun xs i :e apply_fun Gfam alpha.
    assume Hxsi : apply_fun xs (ordsucc i) :e apply_fun Gfam beta.
    claim Hcase_i0 : ordsucc 0 :e 2 ->
      apply_fun xs 0 :e apply_fun Gfam alpha ->
      apply_fun xs (ordsucc 0) :e apply_fun Gfam beta -> alpha <> beta.
    {
      assume Hs0 : ordsucc 0 :e 2.
      assume Hx0a : apply_fun xs 0 :e apply_fun Gfam alpha.
      assume Hx1b : apply_fun xs (ordsucc 0) :e apply_fun Gfam beta.
      claim HxInAlpha : x :e apply_fun Gfam alpha. { rewrite <- Hxs0. exact Hx0a. }
      claim Hx1b_eq : apply_fun xs 1 :e apply_fun Gfam beta.
      { rewrite <- ordsucc_0_eq_1_nat. exact Hx1b. }
      claim HyInBeta : y :e apply_fun Gfam beta. { rewrite <- Hxs1. exact Hx1b_eq. }
      assume Heq : alpha = beta.
      prove False.
      claim HyInAlpha : y :e apply_fun Gfam alpha. { rewrite Heq. exact HyInBeta. }
      claim Hca0 : x :e apply_fun Gfam 0 -> y :e apply_fun Gfam 0 -> False.
      {
        assume HxG10 : x :e apply_fun Gfam 0.
        assume HyG10 : y :e apply_fun Gfam 0.
        claim HyGfam1 : y :e apply_fun Gfam 1. { rewrite HGfam1. exact HyG2. }
        exact (Hyne (Hinter 1 0 In_1_2 In_0_2 neq_1_0 y HyGfam1 HyG10)).
      }
      claim Hca1 : x :e apply_fun Gfam 1 -> y :e apply_fun Gfam 1 -> False.
      {
        assume HxG11 : x :e apply_fun Gfam 1.
        assume HyG11 : y :e apply_fun Gfam 1.
        claim HxGfam0 : x :e apply_fun Gfam 0. { rewrite HGfam0. exact HxG1. }
        exact (Hxne (Hinter 0 1 In_0_2 In_1_2 neq_0_1 x HxGfam0 HxG11)).
      }
      exact (cases_2 alpha Halpha
        (fun a:set => x :e apply_fun Gfam a -> y :e apply_fun Gfam a -> False)
        Hca0 Hca1 HxInAlpha HyInAlpha).
    }
    claim Hcase_i1 : ordsucc 1 :e 2 ->
      apply_fun xs 1 :e apply_fun Gfam alpha ->
      apply_fun xs (ordsucc 1) :e apply_fun Gfam beta -> alpha <> beta.
    {
      assume Hs1 : ordsucc 1 :e 2.
      assume Hx1a : apply_fun xs 1 :e apply_fun Gfam alpha.
      assume Hx2b : apply_fun xs (ordsucc 1) :e apply_fun Gfam beta.
      assume Heq : alpha = beta.
      prove False.
      claim H2in2 : 2 :e 2.
      { rewrite <- ordsucc_1_eq_2_nat. exact Hs1. }
      exact (In_irref 2 H2in2).
    }
    exact (cases_2 i Hi
      (fun j:set => ordsucc j :e 2 ->
        apply_fun xs j :e apply_fun Gfam alpha ->
        apply_fun xs (ordsucc j) :e apply_fun Gfam beta -> alpha <> beta)
      Hcase_i0 Hcase_i1 Hsi Hxi Hxsi).
}
(** Prove word_product **)
claim Hprod : word_product mult e xs 2 = apply_fun mult (x, y).
{
  prove nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) 2 = apply_fun mult (x, y).
  claim Hstep0 : nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) 0 = e.
  { exact (nat_primrec_0 e (fun i r => apply_fun mult (r, apply_fun xs i))). }
  claim Hstep1 : nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) 1
    = apply_fun mult (e, x).
  { rewrite <- ordsucc_0_eq_1_nat.
    rewrite (nat_primrec_S e (fun i r => apply_fun mult (r, apply_fun xs i)) 0 nat_0).
    rewrite Hstep0. rewrite Hxs0. reflexivity. }
  claim HidLx : apply_fun mult (e, x) = x.
  { exact (andEL (apply_fun mult (e, x) = x) (apply_fun mult (x, e) = x) (Hid x HxG)). }
  claim Hstep1eq : nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) 1 = x.
  { rewrite Hstep1. exact HidLx. }
  rewrite <- ordsucc_1_eq_2_nat.
  rewrite (nat_primrec_S e (fun i r => apply_fun mult (r, apply_fun xs i)) 1 nat_1).
  rewrite Hstep1eq. rewrite Hxs1. reflexivity.
}
exact (andI
  (reduced_word 2 Gfam efam 2 xs)
  (word_product mult e xs 2 = apply_fun mult (x, y))
  Hreduced
  Hprod).
Qed.

(** Helper: construct reduced word [y,x] (reversed: G2 element first, G1 element second) **)
Lemma ex68_2a_word_helper_rev : forall G mult e inv G1 G2 x y:set,
  group_structure G mult e inv ->
  G1 c= G -> G2 c= G ->
  (forall alpha beta:set, alpha :e 2 -> beta :e 2 -> alpha <> beta ->
    forall z:set, z :e apply_fun (graph 2 (fun i:set => If_i (i = 0) G1 G2)) alpha ->
      z :e apply_fun (graph 2 (fun i:set => If_i (i = 0) G1 G2)) beta ->
      z = e) ->
  x :e G1 -> x <> e -> y :e G2 -> y <> e ->
  let Gfam := graph 2 (fun i:set => If_i (i = 0) G1 G2) in
  let efam := graph 2 (fun _:set => e) in
  let ys := graph 2 (fun i:set => If_i (i = 0) y x) in
  reduced_word 2 Gfam efam 2 ys /\
  word_product mult e ys 2 = apply_fun mult (y, x).
let G mult e inv G1 G2 x y.
assume Hgrp HG1sub HG2sub Hinter HxG1 Hxne HyG2 Hyne.
set Gfam := graph 2 (fun i:set => If_i (i = 0) G1 G2).
set efam := graph 2 (fun _:set => e).
set ys := graph 2 (fun i:set => If_i (i = 0) y x).
apply (and6E
  (function_on mult (setprod G G) G)
  (function_on inv G G)
  (e :e G)
  (forall u v w:set, u :e G -> v :e G -> w :e G ->
    apply_fun mult (apply_fun mult (u, v), w) = apply_fun mult (u, apply_fun mult (v, w)))
  (forall u:set, u :e G -> apply_fun mult (e, u) = u /\ apply_fun mult (u, e) = u)
  (forall u:set, u :e G ->
    apply_fun mult (u, apply_fun inv u) = e /\ apply_fun mult (apply_fun inv u, u) = e)
  Hgrp).
assume HmultF HinvF HeG Hassoc Hid Hinverse.
claim HxG : x :e G. { exact (HG1sub x HxG1). }
claim HyG : y :e G. { exact (HG2sub y HyG2). }
claim H00 : 0 = 0. { reflexivity. }
claim Hn00 : ~(1 = 0). { exact neq_1_0. }
claim HGfam0 : apply_fun Gfam 0 = G1.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 0 In_0_2).
  exact (If_i_1 (0 = 0) G1 G2 H00). }
claim HGfam1 : apply_fun Gfam 1 = G2.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 1 In_1_2).
  exact (If_i_0 (1 = 0) G1 G2 Hn00). }
claim Hefam0 : apply_fun efam 0 = e.
{ exact (apply_fun_graph 2 (fun _:set => e) 0 In_0_2). }
claim Hefam1 : apply_fun efam 1 = e.
{ exact (apply_fun_graph 2 (fun _:set => e) 1 In_1_2). }
claim Hys0 : apply_fun ys 0 = y.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) y x) 0 In_0_2).
  exact (If_i_1 (0 = 0) y x H00). }
claim Hys1 : apply_fun ys 1 = x.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) y x) 1 In_1_2).
  exact (If_i_0 (1 = 0) y x Hn00). }
claim H2omega : 2 :e omega. { exact (nat_p_omega 2 nat_2). }
(** Prove reduced_word for [y,x] **)
claim Hreduced : reduced_word 2 Gfam efam 2 ys.
{
  prove 2 :e omega /\
    (forall i:set, i :e 2 ->
      exists alpha:set, alpha :e 2 /\
        apply_fun ys i :e apply_fun Gfam alpha /\ apply_fun ys i <> apply_fun efam alpha) /\
    (forall i:set, i :e 2 -> ordsucc i :e 2 ->
      forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
        apply_fun ys i :e apply_fun Gfam alpha ->
        apply_fun ys (ordsucc i) :e apply_fun Gfam beta -> alpha <> beta).
  apply and3I.
  - exact H2omega.
  - let i. assume Hi : i :e 2.
    apply (cases_2 i Hi
      (fun j:set => exists alpha:set, alpha :e 2 /\
        apply_fun ys j :e apply_fun Gfam alpha /\ apply_fun ys j <> apply_fun efam alpha)).
    + prove exists alpha:set, alpha :e 2 /\
        apply_fun ys 0 :e apply_fun Gfam alpha /\ apply_fun ys 0 <> apply_fun efam alpha.
      witness 1. apply and3I.
      * exact In_1_2.
      * { rewrite Hys0. rewrite HGfam1. exact HyG2. }
      * { rewrite Hys0. rewrite Hefam1. exact Hyne. }
    + prove exists alpha:set, alpha :e 2 /\
        apply_fun ys 1 :e apply_fun Gfam alpha /\ apply_fun ys 1 <> apply_fun efam alpha.
      witness 0. apply and3I.
      * exact In_0_2.
      * { rewrite Hys1. rewrite HGfam0. exact HxG1. }
      * { rewrite Hys1. rewrite Hefam0. exact Hxne. }
  - let i. assume Hi : i :e 2. assume Hsi : ordsucc i :e 2.
    let alpha beta. assume Halpha : alpha :e 2. assume Hbeta : beta :e 2.
    assume Hyi : apply_fun ys i :e apply_fun Gfam alpha.
    assume Hysi : apply_fun ys (ordsucc i) :e apply_fun Gfam beta.
    claim Hcase_i0 : ordsucc 0 :e 2 ->
      apply_fun ys 0 :e apply_fun Gfam alpha ->
      apply_fun ys (ordsucc 0) :e apply_fun Gfam beta -> alpha <> beta.
    {
      assume Hs0 : ordsucc 0 :e 2.
      assume Hy0a : apply_fun ys 0 :e apply_fun Gfam alpha.
      assume Hy1b : apply_fun ys (ordsucc 0) :e apply_fun Gfam beta.
      claim HyInAlpha : y :e apply_fun Gfam alpha. { rewrite <- Hys0. exact Hy0a. }
      claim Hy1b_eq : apply_fun ys 1 :e apply_fun Gfam beta.
      { rewrite <- ordsucc_0_eq_1_nat. exact Hy1b. }
      claim HxInBeta : x :e apply_fun Gfam beta. { rewrite <- Hys1. exact Hy1b_eq. }
      assume Heq : alpha = beta.
      prove False.
      claim HxInAlpha : x :e apply_fun Gfam alpha. { rewrite Heq. exact HxInBeta. }
      claim Hca0 : y :e apply_fun Gfam 0 -> x :e apply_fun Gfam 0 -> False.
      {
        assume HyG10 : y :e apply_fun Gfam 0.
        assume HxG10 : x :e apply_fun Gfam 0.
        claim HyGfam1 : y :e apply_fun Gfam 1. { rewrite HGfam1. exact HyG2. }
        exact (Hyne (Hinter 1 0 In_1_2 In_0_2 neq_1_0 y HyGfam1 HyG10)).
      }
      claim Hca1 : y :e apply_fun Gfam 1 -> x :e apply_fun Gfam 1 -> False.
      {
        assume HyG11 : y :e apply_fun Gfam 1.
        assume HxG11 : x :e apply_fun Gfam 1.
        claim HxGfam0 : x :e apply_fun Gfam 0. { rewrite HGfam0. exact HxG1. }
        exact (Hxne (Hinter 0 1 In_0_2 In_1_2 neq_0_1 x HxGfam0 HxG11)).
      }
      exact (cases_2 alpha Halpha
        (fun a:set => y :e apply_fun Gfam a -> x :e apply_fun Gfam a -> False)
        Hca0 Hca1 HyInAlpha HxInAlpha).
    }
    claim Hcase_i1 : ordsucc 1 :e 2 ->
      apply_fun ys 1 :e apply_fun Gfam alpha ->
      apply_fun ys (ordsucc 1) :e apply_fun Gfam beta -> alpha <> beta.
    {
      assume Hs1 : ordsucc 1 :e 2.
      assume Hy1a : apply_fun ys 1 :e apply_fun Gfam alpha.
      assume Hy2b : apply_fun ys (ordsucc 1) :e apply_fun Gfam beta.
      assume Heq : alpha = beta.
      prove False.
      claim H2in2 : 2 :e 2.
      { rewrite <- ordsucc_1_eq_2_nat. exact Hs1. }
      exact (In_irref 2 H2in2).
    }
    exact (cases_2 i Hi
      (fun j:set => ordsucc j :e 2 ->
        apply_fun ys j :e apply_fun Gfam alpha ->
        apply_fun ys (ordsucc j) :e apply_fun Gfam beta -> alpha <> beta)
      Hcase_i0 Hcase_i1 Hsi Hyi Hysi).
}
(** Prove word_product for [y,x] **)
claim Hprod : word_product mult e ys 2 = apply_fun mult (y, x).
{
  prove nat_primrec e (fun i r => apply_fun mult (r, apply_fun ys i)) 2 = apply_fun mult (y, x).
  claim Hstep0 : nat_primrec e (fun i r => apply_fun mult (r, apply_fun ys i)) 0 = e.
  { exact (nat_primrec_0 e (fun i r => apply_fun mult (r, apply_fun ys i))). }
  claim Hstep1 : nat_primrec e (fun i r => apply_fun mult (r, apply_fun ys i)) 1
    = apply_fun mult (e, y).
  { rewrite <- ordsucc_0_eq_1_nat.
    rewrite (nat_primrec_S e (fun i r => apply_fun mult (r, apply_fun ys i)) 0 nat_0).
    rewrite Hstep0. rewrite Hys0. reflexivity. }
  claim HidLy : apply_fun mult (e, y) = y.
  { exact (andEL (apply_fun mult (e, y) = y) (apply_fun mult (y, e) = y) (Hid y HyG)). }
  claim Hstep1eq : nat_primrec e (fun i r => apply_fun mult (r, apply_fun ys i)) 1 = y.
  { rewrite Hstep1. exact HidLy. }
  rewrite <- ordsucc_1_eq_2_nat.
  rewrite (nat_primrec_S e (fun i r => apply_fun mult (r, apply_fun ys i)) 1 nat_1).
  rewrite Hstep1eq. rewrite Hys1. reflexivity.
}
exact (andI
  (reduced_word 2 Gfam efam 2 ys)
  (word_product mult e ys 2 = apply_fun mult (y, x))
  Hreduced
  Hprod).
Qed.

(** from S68 Exercise 2(a) (line 3025 in algtop.tex) **)
(** LATEX VERSION: Let G = G1 free-product G2 where G1, G2 nontrivial. Then G is not abelian. **)
(** EFFORT: 3 lines textbook, difficulty 2/10, USD 30 **)
(** Collected Alice 33 **)
(** Proven Alice **)
Theorem ex68_2a_free_product_not_abelian :
  forall G mult e inv G1 G2:set,
  free_product_of_subgroups G mult e inv 2
    (graph 2 (fun i => if i = 0 then G1 else G2))
    (graph 2 (fun _ => e)) ->
  (exists a:set, a :e G1 /\ a <> e) ->
  (exists b:set, b :e G2 /\ b <> e) ->
  ~(abelian_group G mult e inv).
let G mult e inv G1 G2.
set Gfam := graph 2 (fun i:set => If_i (i = 0) G1 G2).
set efam := graph 2 (fun _:set => e).
assume Hfp : free_product_of_subgroups G mult e inv 2 Gfam efam.
assume Hexa : exists a:set, a :e G1 /\ a <> e.
assume Hexb : exists b:set, b :e G2 /\ b <> e.
assume Habel : abelian_group G mult e inv.
prove False.
(** Extract free product components **)
apply (and6E
  (group_structure G mult e inv)
  (forall alpha:set, alpha :e 2 -> subgroup_of (apply_fun Gfam alpha) G mult e inv)
  (forall alpha beta:set, alpha :e 2 -> beta :e 2 -> alpha <> beta ->
    forall x:set, x :e apply_fun Gfam alpha -> x :e apply_fun Gfam beta -> x = e)
  (subgroups_generate G mult e inv 2 Gfam)
  (forall x:set, x :e G -> x <> e ->
    exists n xs:set,
      reduced_word 2 Gfam efam n xs /\ n <> 0 /\
      word_product mult e xs n = x /\
      (forall n' xs':set,
        reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
        word_product mult e xs' n' = x ->
        n = n' /\ (forall i:set, i :e n -> apply_fun xs i = apply_fun xs' i)))
  (forall alpha:set, alpha :e 2 -> apply_fun efam alpha = e)
  Hfp).
assume Hgrp Hsub Hinter Hgen Hunique _.
(** Extract commutativity from abelian **)
claim Hcomm : forall x y:set, x :e G -> y :e G ->
  apply_fun mult (x, y) = apply_fun mult (y, x).
{ exact (andER
    (group_structure G mult e inv)
    (forall x y:set, x :e G -> y :e G -> apply_fun mult (x, y) = apply_fun mult (y, x))
    Habel). }
(** Extract witnesses a, b **)
apply (exandE_i (fun a:set => a :e G1) (fun a:set => a <> e) Hexa).
let a. assume HaG1 : a :e G1. assume Hane : a <> e.
apply (exandE_i (fun b:set => b :e G2) (fun b:set => b <> e) Hexb).
let b. assume HbG2 : b :e G2. assume Hbne : b <> e.
(** Compute Gfam evaluations **)
claim H00 : 0 = 0. { reflexivity. }
claim Hn00 : ~(1 = 0). { exact neq_1_0. }
claim HGfam0 : apply_fun Gfam 0 = G1.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 0 In_0_2).
  exact (If_i_1 (0 = 0) G1 G2 H00). }
claim HGfam1 : apply_fun Gfam 1 = G2.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 1 In_1_2).
  exact (If_i_0 (1 = 0) G1 G2 Hn00). }
(** Get subgroup properties **)
claim HsubG1 : subgroup_of G1 G mult e inv.
{ rewrite <- HGfam0. exact (Hsub 0 In_0_2). }
claim HsubG2 : subgroup_of G2 G mult e inv.
{ rewrite <- HGfam1. exact (Hsub 1 In_1_2). }
apply (and4E
  (G1 c= G) (e :e G1)
  (forall x y:set, x :e G1 -> y :e G1 -> apply_fun mult (x, y) :e G1)
  (forall x:set, x :e G1 -> apply_fun inv x :e G1)
  HsubG1).
assume HG1sub HeG1 HG1mult HG1inv.
apply (and4E
  (G2 c= G) (e :e G2)
  (forall x y:set, x :e G2 -> y :e G2 -> apply_fun mult (x, y) :e G2)
  (forall x:set, x :e G2 -> apply_fun inv x :e G2)
  HsubG2).
assume HG2sub HeG2 HG2mult HG2inv.
(** Derive simple intersection property for ab_ne_e helper **)
claim Hinter_simple : forall x:set, x :e G1 -> x :e G2 -> x = e.
{
  let x. assume HxG1 : x :e G1. assume HxG2 : x :e G2.
  claim HxGfam0 : x :e apply_fun Gfam 0. { rewrite HGfam0. exact HxG1. }
  claim HxGfam1 : x :e apply_fun Gfam 1. { rewrite HGfam1. exact HxG2. }
  exact (Hinter 0 1 In_0_2 In_1_2 neq_0_1 x HxGfam0 HxGfam1).
}
claim HaG : a :e G. { exact (HG1sub a HaG1). }
claim HbG : b :e G. { exact (HG2sub b HbG2). }
(** mult(a,b) <> e **)
claim Hab_ne_e : apply_fun mult (a, b) <> e.
{ exact (ex68_2a_ab_ne_e G mult e inv G1 G2 a b
    Hgrp HG1sub HG2sub HG1inv Hinter_simple HaG1 Hane HbG2 Hbne). }
(** mult(a,b) :e G **)
apply (and6E
  (function_on mult (setprod G G) G)
  (function_on inv G G)
  (e :e G)
  (forall x y z:set, x :e G -> y :e G -> z :e G ->
    apply_fun mult (apply_fun mult (x, y), z) = apply_fun mult (x, apply_fun mult (y, z)))
  (forall x:set, x :e G -> apply_fun mult (e, x) = x /\ apply_fun mult (x, e) = x)
  (forall x:set, x :e G ->
    apply_fun mult (x, apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x, x) = e)
  Hgrp).
assume HmultF HinvF HeG Hassoc Hid Hinv.
claim Hab_pair : (a, b) :e setprod G G.
{ exact (tuple_2_setprod_by_pair_Sigma G G a b HaG HbG). }
claim Hab_G : apply_fun mult (a, b) :e G.
{ exact (HmultF (a, b) Hab_pair). }
(** Apply word helpers **)
set xs_ab := graph 2 (fun i:set => If_i (i = 0) a b).
set ys_ba := graph 2 (fun i:set => If_i (i = 0) b a).
claim Hword_ab : reduced_word 2 Gfam efam 2 xs_ab /\
  word_product mult e xs_ab 2 = apply_fun mult (a, b).
{ exact (ex68_2a_word_helper G mult e inv G1 G2 a b
    Hgrp HG1sub HG2sub Hinter HaG1 Hane HbG2 Hbne). }
claim Hred_ab : reduced_word 2 Gfam efam 2 xs_ab.
{ exact (andEL
    (reduced_word 2 Gfam efam 2 xs_ab)
    (word_product mult e xs_ab 2 = apply_fun mult (a, b))
    Hword_ab). }
claim Hprod_ab : word_product mult e xs_ab 2 = apply_fun mult (a, b).
{ exact (andER
    (reduced_word 2 Gfam efam 2 xs_ab)
    (word_product mult e xs_ab 2 = apply_fun mult (a, b))
    Hword_ab). }
claim Hword_ba : reduced_word 2 Gfam efam 2 ys_ba /\
  word_product mult e ys_ba 2 = apply_fun mult (b, a).
{ exact (ex68_2a_word_helper_rev G mult e inv G1 G2 a b
    Hgrp HG1sub HG2sub Hinter HaG1 Hane HbG2 Hbne). }
claim Hred_ba : reduced_word 2 Gfam efam 2 ys_ba.
{ exact (andEL
    (reduced_word 2 Gfam efam 2 ys_ba)
    (word_product mult e ys_ba 2 = apply_fun mult (b, a))
    Hword_ba). }
claim Hprod_ba : word_product mult e ys_ba 2 = apply_fun mult (b, a).
{ exact (andER
    (reduced_word 2 Gfam efam 2 ys_ba)
    (word_product mult e ys_ba 2 = apply_fun mult (b, a))
    Hword_ba). }
(** By commutativity: mult(b,a) = mult(a,b), so word_product ys_ba = mult(a,b) **)
claim Hcomm_ba : apply_fun mult (b, a) = apply_fun mult (a, b).
{ exact (Hcomm b a HbG HaG). }
claim Hprod_ba_eq : word_product mult e ys_ba 2 = apply_fun mult (a, b).
{ rewrite Hprod_ba. exact Hcomm_ba. }
(** Apply uniqueness: extract canonical word and uniqueness clause **)
apply (Hunique (apply_fun mult (a, b)) Hab_G Hab_ne_e).
let n_c. assume Hn_c_ex : exists xs_c:set,
  reduced_word 2 Gfam efam n_c xs_c /\ n_c <> 0 /\
  word_product mult e xs_c n_c = apply_fun mult (a, b) /\
  (forall n' xs':set,
    reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
    word_product mult e xs' n' = apply_fun mult (a, b) ->
    n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i)).
apply Hn_c_ex.
let xs_c. assume Hxs_c_conj :
  reduced_word 2 Gfam efam n_c xs_c /\ n_c <> 0 /\
  word_product mult e xs_c n_c = apply_fun mult (a, b) /\
  (forall n' xs':set,
    reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
    word_product mult e xs' n' = apply_fun mult (a, b) ->
    n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i)).
apply (and4E
  (reduced_word 2 Gfam efam n_c xs_c)
  (n_c <> 0)
  (word_product mult e xs_c n_c = apply_fun mult (a, b))
  (forall n' xs':set,
    reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
    word_product mult e xs' n' = apply_fun mult (a, b) ->
    n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i))
  Hxs_c_conj).
assume Hred_c Hnc_ne0 Hprod_c Huniq_clause.
(** Apply uniqueness to [a,b] and [b,a] **)
claim Huniq_ab : n_c = 2 /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs_ab i).
{ exact (Huniq_clause 2 xs_ab Hred_ab neq_2_0 Hprod_ab). }
claim Hnc_eq_2 : n_c = 2.
{ exact (andEL (n_c = 2) (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs_ab i)
    Huniq_ab). }
claim Hxsc_eq_ab : forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs_ab i.
{ exact (andER (n_c = 2) (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs_ab i)
    Huniq_ab). }
claim Huniq_ba : n_c = 2 /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun ys_ba i).
{ exact (Huniq_clause 2 ys_ba Hred_ba neq_2_0 Hprod_ba_eq). }
claim Hxsc_eq_ba : forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun ys_ba i.
{ exact (andER (n_c = 2) (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun ys_ba i)
    Huniq_ba). }
(** Evaluate xs_ab(0) = a and ys_ba(0) = b **)
claim H0_in_nc : 0 :e n_c. { rewrite Hnc_eq_2. exact In_0_2. }
claim Hxsc0_eq_xsab0 : apply_fun xs_c 0 = apply_fun xs_ab 0.
{ exact (Hxsc_eq_ab 0 H0_in_nc). }
claim Hxs_ab_0 : apply_fun xs_ab 0 = a.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) a b) 0 In_0_2).
  exact (If_i_1 (0 = 0) a b H00). }
claim Hxsc0_eq_a : apply_fun xs_c 0 = a.
{ rewrite Hxsc0_eq_xsab0. exact Hxs_ab_0. }
claim Hxsc0_eq_ysba0 : apply_fun xs_c 0 = apply_fun ys_ba 0.
{ exact (Hxsc_eq_ba 0 H0_in_nc). }
claim Hys_ba_0 : apply_fun ys_ba 0 = b.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) b a) 0 In_0_2).
  exact (If_i_1 (0 = 0) b a H00). }
claim Hxsc0_eq_b : apply_fun xs_c 0 = b.
{ rewrite Hxsc0_eq_ysba0. exact Hys_ba_0. }
(** Conclude a = b, then a :e G1 /\ a :e G2, so a = e, contradiction **)
claim Haeqb : a = b.
{ rewrite <- Hxsc0_eq_a. exact Hxsc0_eq_b. }
claim HaG2 : a :e G2.
{ rewrite Haeqb. exact HbG2. }
exact (Hane (Hinter_simple a HaG1 HaG2)).
Qed.

(** Helper: group power of conjugate equals conjugate of group power **)
(** Proven Alice **)
Theorem conjugate_power_nat :
  forall G mult e inv a x:set,
  group_structure G mult e inv ->
  a :e G -> x :e G ->
  forall n:set, n :e omega ->
  group_power_nat mult e (apply_fun mult (a, apply_fun mult (x, apply_fun inv a))) n =
  apply_fun mult (a, apply_fun mult (group_power_nat mult e x n, apply_fun inv a)).
let G mult e inv a x.
assume Hgrp : group_structure G mult e inv.
assume HaG : a :e G. assume HxG : x :e G.
apply (and6E
  (function_on mult (setprod G G) G)
  (function_on inv G G)
  (e :e G)
  (forall x y z:set, x :e G -> y :e G -> z :e G ->
    apply_fun mult (apply_fun mult (x, y), z) = apply_fun mult (x, apply_fun mult (y, z)))
  (forall x:set, x :e G -> apply_fun mult (e, x) = x /\ apply_fun mult (x, e) = x)
  (forall x:set, x :e G ->
    apply_fun mult (x, apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x, x) = e)
  Hgrp).
assume HmultF HinvF HeG Hassoc Hid Hinverse.
claim HmG : forall u v:set, u :e G -> v :e G -> apply_fun mult (u, v) :e G.
{ let u v. assume HuG HvG.
  exact (HmultF (u, v) (tuple_2_setprod_by_pair_Sigma G G u v HuG HvG)). }
claim HinvG : forall u:set, u :e G -> apply_fun inv u :e G.
{ let u. assume HuG. exact (HinvF u HuG). }
set ainv := apply_fun inv a.
claim HainvG : ainv :e G. { exact (HinvG a HaG). }
claim Ha_ainv : apply_fun mult (a, ainv) = e.
{ exact (andEL (apply_fun mult (a, ainv) = e) (apply_fun mult (ainv, a) = e)
    (Hinverse a HaG)). }
claim Hainv_a : apply_fun mult (ainv, a) = e.
{ exact (andER (apply_fun mult (a, ainv) = e) (apply_fun mult (ainv, a) = e)
    (Hinverse a HaG)). }
set conj := apply_fun mult (a, apply_fun mult (x, ainv)).
claim HconjG : conj :e G. { exact (HmG a (apply_fun mult (x, ainv)) HaG (HmG x ainv HxG HainvG)). }
claim HpowG : forall n:set, nat_p n -> group_power_nat mult e x n :e G.
{ apply nat_ind.
  - claim H0 : group_power_nat mult e x 0 = e.
    { exact (nat_primrec_0 e (fun _ r => apply_fun mult (x, r))). }
    rewrite H0. exact HeG.
  - let j. assume Hj IH.
    claim HS : group_power_nat mult e x (ordsucc j) = apply_fun mult (x, group_power_nat mult e x j).
    { exact (nat_primrec_S e (fun _ r => apply_fun mult (x, r)) j Hj). }
    rewrite HS. exact (HmG x (group_power_nat mult e x j) HxG IH). }
claim HconjpowG : forall n:set, nat_p n -> group_power_nat mult e conj n :e G.
{ apply nat_ind.
  - claim H0 : group_power_nat mult e conj 0 = e.
    { exact (nat_primrec_0 e (fun _ r => apply_fun mult (conj, r))). }
    rewrite H0. exact HeG.
  - let j. assume Hj IH.
    claim HS : group_power_nat mult e conj (ordsucc j) = apply_fun mult (conj, group_power_nat mult e conj j).
    { exact (nat_primrec_S e (fun _ r => apply_fun mult (conj, r)) j Hj). }
    rewrite HS. exact (HmG conj (group_power_nat mult e conj j) HconjG IH). }
claim Hmain : forall n:set, nat_p n ->
  group_power_nat mult e conj n =
  apply_fun mult (a, apply_fun mult (group_power_nat mult e x n, ainv)).
{ apply nat_ind.
  - prove group_power_nat mult e conj 0 =
      apply_fun mult (a, apply_fun mult (group_power_nat mult e x 0, ainv)).
    claim Hc0 : group_power_nat mult e conj 0 = e.
    { exact (nat_primrec_0 e (fun _ r => apply_fun mult (conj, r))). }
    claim Hx0 : group_power_nat mult e x 0 = e.
    { exact (nat_primrec_0 e (fun _ r => apply_fun mult (x, r))). }
    claim Hrhs : apply_fun mult (a, apply_fun mult (e, ainv)) =
      apply_fun mult (a, ainv).
    { claim Hle : apply_fun mult (e, ainv) = ainv.
      { exact (andEL (apply_fun mult (e, ainv) = ainv) (apply_fun mult (ainv, e) = ainv) (Hid ainv HainvG)). }
      rewrite Hle. reflexivity. }
    rewrite Hc0. rewrite Hx0. rewrite Hrhs. symmetry. exact Ha_ainv.
  - let n. assume Hn : nat_p n.
    assume IH : group_power_nat mult e conj n =
      apply_fun mult (a, apply_fun mult (group_power_nat mult e x n, ainv)).
    prove group_power_nat mult e conj (ordsucc n) =
      apply_fun mult (a, apply_fun mult (group_power_nat mult e x (ordsucc n), ainv)).
    claim HcS : group_power_nat mult e conj (ordsucc n) =
      apply_fun mult (conj, group_power_nat mult e conj n).
    { exact (nat_primrec_S e (fun _ r => apply_fun mult (conj, r)) n Hn). }
    claim HxS : group_power_nat mult e x (ordsucc n) =
      apply_fun mult (x, group_power_nat mult e x n).
    { exact (nat_primrec_S e (fun _ r => apply_fun mult (x, r)) n Hn). }
    claim HpnG : group_power_nat mult e x n :e G. { exact (HpowG n Hn). }
    claim HcpnG : group_power_nat mult e conj n :e G. { exact (HconjpowG n Hn). }
    claim HxainvG : apply_fun mult (x, ainv) :e G. { exact (HmG x ainv HxG HainvG). }
    claim HpnainvG : apply_fun mult (group_power_nat mult e x n, ainv) :e G.
    { exact (HmG (group_power_nat mult e x n) ainv HpnG HainvG). }
    claim Hapn : apply_fun mult (a, apply_fun mult (group_power_nat mult e x n, ainv)) :e G.
    { exact (HmG a (apply_fun mult (group_power_nat mult e x n, ainv)) HaG HpnainvG). }
    claim Hstep1 : apply_fun mult (conj, group_power_nat mult e conj n) =
      apply_fun mult (conj, apply_fun mult (a, apply_fun mult (group_power_nat mult e x n, ainv))).
    { rewrite IH. reflexivity. }
    claim Hstep2 : apply_fun mult (conj, apply_fun mult (a, apply_fun mult (group_power_nat mult e x n, ainv))) =
      apply_fun mult (apply_fun mult (conj, a), apply_fun mult (group_power_nat mult e x n, ainv)).
    { symmetry. exact (Hassoc conj a (apply_fun mult (group_power_nat mult e x n, ainv)) HconjG HaG HpnainvG). }
    claim Hconj_a : apply_fun mult (conj, a) =
      apply_fun mult (a, apply_fun mult (apply_fun mult (x, ainv), a)).
    { exact (Hassoc a (apply_fun mult (x, ainv)) a HaG HxainvG HaG). }
    claim Hassoc_x_ainv_a : apply_fun mult (apply_fun mult (x, ainv), a) =
      apply_fun mult (x, apply_fun mult (ainv, a)).
    { exact (Hassoc x ainv a HxG HainvG HaG). }
    claim Hxa_simp : apply_fun mult (apply_fun mult (x, ainv), a) = x.
    { claim Hx_ainv_a : apply_fun mult (x, apply_fun mult (ainv, a)) =
        apply_fun mult (x, e).
      { rewrite Hainv_a. reflexivity. }
      claim Hx_e : apply_fun mult (x, e) = x.
      { exact (andER (apply_fun mult (e, x) = x) (apply_fun mult (x, e) = x)
          (Hid x HxG)). }
      exact (eq_i_tra (apply_fun mult (apply_fun mult (x, ainv), a))
        (apply_fun mult (x, apply_fun mult (ainv, a)))
        x Hassoc_x_ainv_a
        (eq_i_tra (apply_fun mult (x, apply_fun mult (ainv, a)))
          (apply_fun mult (x, e)) x Hx_ainv_a Hx_e)). }
    claim Hconj_a_simp : apply_fun mult (conj, a) =
      apply_fun mult (a, x).
    { claim Hrew : apply_fun mult (a, apply_fun mult (apply_fun mult (x, ainv), a)) =
        apply_fun mult (a, x). { rewrite Hxa_simp. reflexivity. }
      exact (eq_i_tra (apply_fun mult (conj, a))
        (apply_fun mult (a, apply_fun mult (apply_fun mult (x, ainv), a)))
        (apply_fun mult (a, x)) Hconj_a Hrew). }
    claim Hstep3 : apply_fun mult (apply_fun mult (conj, a), apply_fun mult (group_power_nat mult e x n, ainv)) =
      apply_fun mult (apply_fun mult (a, x), apply_fun mult (group_power_nat mult e x n, ainv)).
    { rewrite Hconj_a_simp. reflexivity. }
    claim HaxG : apply_fun mult (a, x) :e G. { exact (HmG a x HaG HxG). }
    claim Hassoc_ax_pn_ainv : apply_fun mult (apply_fun mult (a, x), apply_fun mult (group_power_nat mult e x n, ainv)) =
      apply_fun mult (a, apply_fun mult (x, apply_fun mult (group_power_nat mult e x n, ainv))).
    { exact (Hassoc a x (apply_fun mult (group_power_nat mult e x n, ainv)) HaG HxG HpnainvG). }
    claim Hassoc_x_pn_ainv : apply_fun mult (x, apply_fun mult (group_power_nat mult e x n, ainv)) =
      apply_fun mult (apply_fun mult (x, group_power_nat mult e x n), ainv).
    { symmetry. exact (Hassoc x (group_power_nat mult e x n) ainv HxG HpnG HainvG). }
    claim Hgoal_rhs : apply_fun mult (a, apply_fun mult (group_power_nat mult e x (ordsucc n), ainv)) =
      apply_fun mult (a, apply_fun mult (apply_fun mult (x, group_power_nat mult e x n), ainv)).
    { rewrite HxS. reflexivity. }
    rewrite HcS. rewrite Hstep1. rewrite Hstep2. rewrite Hstep3.
    rewrite Hassoc_ax_pn_ainv. rewrite Hassoc_x_pn_ainv.
    symmetry. exact Hgoal_rhs. }
let n. assume HnO : n :e omega.
exact (Hmain n (omega_nat_p n HnO)).
Qed.

(** Helper: word_product agrees when sequences agree on indices **)
Theorem word_product_agree : forall mult e xs1 xs2 n:set,
  n :e omega ->
  (forall j:set, j :e n -> apply_fun xs1 j = apply_fun xs2 j) ->
  word_product mult e xs1 n = word_product mult e xs2 n.
let mult e xs1 xs2.
claim Hnat : forall n:set, nat_p n ->
  (forall j:set, j :e n -> apply_fun xs1 j = apply_fun xs2 j) ->
  word_product mult e xs1 n = word_product mult e xs2 n.
{
  apply nat_ind.
  - prove (forall j:set, j :e 0 -> apply_fun xs1 j = apply_fun xs2 j) ->
      word_product mult e xs1 0 = word_product mult e xs2 0.
    assume Hagree.
    claim H1 : word_product mult e xs1 0 = e.
    { exact (nat_primrec_0 e (fun j r => apply_fun mult (r, apply_fun xs1 j))). }
    claim H2 : word_product mult e xs2 0 = e.
    { exact (nat_primrec_0 e (fun j r => apply_fun mult (r, apply_fun xs2 j))). }
    rewrite H1. rewrite H2. reflexivity.
  - let k. assume Hk : nat_p k.
    assume IH : (forall j:set, j :e k -> apply_fun xs1 j = apply_fun xs2 j) ->
      word_product mult e xs1 k = word_product mult e xs2 k.
    prove (forall j:set, j :e ordsucc k -> apply_fun xs1 j = apply_fun xs2 j) ->
      word_product mult e xs1 (ordsucc k) = word_product mult e xs2 (ordsucc k).
    assume Hagree : forall j:set, j :e ordsucc k -> apply_fun xs1 j = apply_fun xs2 j.
    claim Hagree_k : forall j:set, j :e k -> apply_fun xs1 j = apply_fun xs2 j.
    { let j. assume Hjk : j :e k. exact (Hagree j (ordsuccI1 k j Hjk)). }
    claim Hwp_k : word_product mult e xs1 k = word_product mult e xs2 k.
    { exact (IH Hagree_k). }
    claim Hxs_k : apply_fun xs1 k = apply_fun xs2 k.
    { exact (Hagree k (ordsuccI2 k)). }
    claim HS1 : word_product mult e xs1 (ordsucc k) =
      apply_fun mult (word_product mult e xs1 k, apply_fun xs1 k).
    { exact (nat_primrec_S e (fun j r => apply_fun mult (r, apply_fun xs1 j)) k Hk). }
    claim HS2 : word_product mult e xs2 (ordsucc k) =
      apply_fun mult (word_product mult e xs2 k, apply_fun xs2 k).
    { exact (nat_primrec_S e (fun j r => apply_fun mult (r, apply_fun xs2 j)) k Hk). }
    rewrite HS1. rewrite HS2. rewrite Hwp_k. rewrite Hxs_k. reflexivity.
}
let n. assume Hn : n :e omega.
exact (Hnat n (omega_nat_p n Hn)).
Qed.

(** from S68 Exercise 2(c) (line 3028 in algtop.tex) **)
(** LATEX VERSION: The only elements of G that have finite order are elements **)
(** of G1 and G2 that have finite order, and their conjugates. **)
(** EFFORT: 8 lines textbook, difficulty 5/10, USD 100 **)
(** Collected Alice 121 **)
(** Proven Alice **)
Theorem ex68_2c_finite_order_elements :
  forall G mult e inv G1 G2:set,
  free_product_of_subgroups G mult e inv 2
    (graph 2 (fun i => if i = 0 then G1 else G2))
    (graph 2 (fun _ => e)) ->
  forall x:set, x :e G ->
    (exists m:set, m :e omega /\ m <> 0 /\ group_power_nat mult e x m = e) ->
    exists c y:set, c :e G /\ (y :e G1 \/ y :e G2) /\
      (exists m:set, m :e omega /\ m <> 0 /\ group_power_nat mult e y m = e) /\
      x = apply_fun mult (apply_fun mult (c, y), apply_fun inv c).
let G mult e inv G1 G2.
set Gfam := graph 2 (fun i:set => If_i (i = 0) G1 G2).
set efam := graph 2 (fun _:set => e).
assume Hfp : free_product_of_subgroups G mult e inv 2 Gfam efam.
let x. assume HxG : x :e G.
assume Hfin : exists m:set, m :e omega /\ m <> 0 /\ group_power_nat mult e x m = e.
(** Unpack free product structure **)
apply (and6E
  (group_structure G mult e inv)
  (forall alpha:set, alpha :e 2 -> subgroup_of (apply_fun Gfam alpha) G mult e inv)
  (forall alpha beta:set, alpha :e 2 -> beta :e 2 -> alpha <> beta ->
    forall z:set, z :e apply_fun Gfam alpha -> z :e apply_fun Gfam beta -> z = e)
  (subgroups_generate G mult e inv 2 Gfam)
  (forall z:set, z :e G -> z <> e ->
    exists n xs:set,
      reduced_word 2 Gfam efam n xs /\ n <> 0 /\
      word_product mult e xs n = z /\
      (forall n' xs':set,
        reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
        word_product mult e xs' n' = z ->
        n = n' /\ (forall i:set, i :e n -> apply_fun xs i = apply_fun xs' i)))
  (forall alpha:set, alpha :e 2 -> apply_fun efam alpha = e)
  Hfp).
assume Hgrp Hsubfam Hdisjoint _ Huniq _.
(** Extract group operations **)
apply (and6E
  (function_on mult (setprod G G) G) (function_on inv G G) (e :e G)
  (forall a b d:set, a :e G -> b :e G -> d :e G ->
    apply_fun mult (apply_fun mult (a, b), d) = apply_fun mult (a, apply_fun mult (b, d)))
  (forall a:set, a :e G -> apply_fun mult (e, a) = a /\ apply_fun mult (a, e) = a)
  (forall a:set, a :e G ->
    apply_fun mult (a, apply_fun inv a) = e /\ apply_fun mult (apply_fun inv a, a) = e)
  Hgrp).
assume HmultF HinvF HeG Hassoc Hid Hinverse.
claim HmultG : forall a b:set, a :e G -> b :e G -> apply_fun mult (a, b) :e G.
{ let a b. assume Ha Hb. exact (HmultF (a, b) (tuple_2_setprod_by_pair_Sigma G G a b Ha Hb)). }
claim HinvG : forall a:set, a :e G -> apply_fun inv a :e G.
{ let a. assume Ha. exact (HinvF a Ha). }
claim Hsub_in_G : forall alpha:set, alpha :e 2 -> forall z:set, z :e apply_fun Gfam alpha -> z :e G.
{ let alpha. assume HaJ. let z. assume Hz.
  exact (subgroup_of_subset (apply_fun Gfam alpha) G mult e inv (Hsubfam alpha HaJ) z Hz). }
(** efam(alpha) = e for all alpha in 2 **)
claim Hefam0 : apply_fun efam 0 = e.
{ exact (apply_fun_graph 2 (fun _:set => e) 0 In_0_2). }
claim Hefam1 : apply_fun efam 1 = e.
{ exact (apply_fun_graph 2 (fun _:set => e) 1 In_1_2). }
claim Hefam_e : forall alpha:set, alpha :e 2 -> apply_fun efam alpha = e.
{ let alpha. assume Halpha.
  apply (ordsuccE 1 alpha Halpha).
  - assume Ha1 : alpha :e 1.
    apply (ordsuccE 0 alpha Ha1).
    + assume Ha0 : alpha :e 0. exact (FalseE (EmptyE alpha Ha0) (apply_fun efam alpha = e)).
    + assume Ha_eq_0 : alpha = 0. rewrite Ha_eq_0. exact Hefam0.
  - assume Ha_eq_1 : alpha = 1. rewrite Ha_eq_1. exact Hefam1. }
(** Gfam(0) = G1, Gfam(1) = G2 **)
claim HGfam0 : apply_fun Gfam 0 = G1.
{ claim H : apply_fun Gfam 0 = If_i (0 = 0) G1 G2.
  { exact (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 0 In_0_2). }
  rewrite H. exact (If_i_1 (0 = 0) G1 G2 (eq_refl 0)). }
claim HGfam1 : apply_fun Gfam 1 = G2.
{ claim H : apply_fun Gfam 1 = If_i (1 = 0) G1 G2.
  { exact (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 1 In_1_2). }
  claim H10 : ~(1 = 0). { exact neq_1_0. }
  rewrite H. exact (If_i_0 (1 = 0) G1 G2 H10). }
(** Case: x = e (trivial) **)
apply (xm (x = e)).
- assume Hxe : x = e.
  (** Take c = e, y = e in G1; e has finite order 1 **)
  witness e. witness e.
  apply and4I.
  + exact HeG.
  + apply orIL. claim He_G1 : e :e apply_fun Gfam 0.
    { exact (subgroup_of_unit (apply_fun Gfam 0) G mult e inv (Hsubfam 0 In_0_2)). }
    exact (eq_subst_mem_set e (apply_fun Gfam 0) G1 He_G1 HGfam0).
  + witness 1. apply and3I.
    * exact (nat_p_omega 1 (nat_ordsucc 0 nat_0)).
    * exact (neq_ordsucc_0 0).
    * claim Hgp1 : group_power_nat mult e e 1 = apply_fun mult (e, group_power_nat mult e e 0).
      { exact (nat_primrec_S e (fun _ r:set => apply_fun mult (e, r)) 0 nat_0). }
      claim Hgp0 : group_power_nat mult e e 0 = e.
      { exact (nat_primrec_0 e (fun _ r:set => apply_fun mult (e, r))). }
      rewrite Hgp1. rewrite Hgp0.
      exact (andEL (apply_fun mult (e, e) = e) (apply_fun mult (e, e) = e) (Hid e HeG)).
  + rewrite Hxe.
    claim Hee : apply_fun mult (e, e) = e.
    { exact (andEL (apply_fun mult (e, e) = e) (apply_fun mult (e, e) = e) (Hid e HeG)). }
    claim Hinve : apply_fun inv e = e.
    { claim Hei : apply_fun mult (e, apply_fun inv e) = e.
      { exact (andEL (apply_fun mult (e, apply_fun inv e) = e)
          (apply_fun mult (apply_fun inv e, e) = e) (Hinverse e HeG)). }
      claim Hle : apply_fun mult (e, apply_fun inv e) = apply_fun inv e.
      { exact (andEL (apply_fun mult (e, apply_fun inv e) = apply_fun inv e)
          (apply_fun mult (apply_fun inv e, e) = apply_fun inv e)
          (Hid (apply_fun inv e) (HinvG e HeG))). }
      exact (eq_i_tra (apply_fun inv e)
        (apply_fun mult (e, apply_fun inv e)) e
        (eq_symm (apply_fun mult (e, apply_fun inv e)) (apply_fun inv e) Hle) Hei). }
    claim Hmee_re : apply_fun mult (apply_fun mult (e, e), apply_fun inv e) = apply_fun mult (e, apply_fun inv e).
    { claim Hee2 : apply_fun mult (e, e) = e. { exact Hee. }
      rewrite Hee2. reflexivity. }
    claim Hme_inve : apply_fun mult (e, apply_fun inv e) = e.
    { exact (andEL (apply_fun mult (e, apply_fun inv e) = e)
        (apply_fun mult (apply_fun inv e, e) = e) (Hinverse e HeG)). }
    claim Hfinal : apply_fun mult (apply_fun mult (e, e), apply_fun inv e) = e.
    { exact (eq_i_tra (apply_fun mult (apply_fun mult (e, e), apply_fun inv e))
        (apply_fun mult (e, apply_fun inv e)) e Hmee_re Hme_inve). }
    symmetry. exact Hfinal.
- assume Hxne : x <> e.
  (** x != e: get unique reduced word **)
  apply (Huniq x HxG Hxne). let nx. assume Hex_nx.
  apply Hex_nx. let xs. assume Hxs_pack :
    reduced_word 2 Gfam efam nx xs /\ nx <> 0 /\
    word_product mult e xs nx = x /\
    (forall n' xs':set, reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
      word_product mult e xs' n' = x ->
      nx = n' /\ (forall i:set, i :e nx -> apply_fun xs i = apply_fun xs' i)).
  apply (and4E (reduced_word 2 Gfam efam nx xs) (nx <> 0)
    (word_product mult e xs nx = x)
    (forall n' xs':set, reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
      word_product mult e xs' n' = x ->
      nx = n' /\ (forall i:set, i :e nx -> apply_fun xs i = apply_fun xs' i))
    Hxs_pack).
  assume Hred Hnx_ne0 Hwp Huniq_x.
  (** Strong induction on nx **)
  (** The key claim: for elements with reduced word of length k, if they have finite order, **)
  (** they are conjugate to a factor element with finite order **)
  claim Hmain : forall k:set, nat_p k ->
    forall z:set, z :e G -> z <> e ->
    (exists m:set, m :e omega /\ m <> 0 /\ group_power_nat mult e z m = e) ->
    forall nz zs:set,
    reduced_word 2 Gfam efam nz zs -> nz <> 0 ->
    word_product mult e zs nz = z ->
    (forall n' xs':set, reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
      word_product mult e xs' n' = z ->
      nz = n' /\ (forall i:set, i :e nz -> apply_fun zs i = apply_fun xs' i)) ->
    nz :e ordsucc k ->
    exists c y:set, c :e G /\ (y :e G1 \/ y :e G2) /\
      (exists m:set, m :e omega /\ m <> 0 /\ group_power_nat mult e y m = e) /\
      z = apply_fun mult (apply_fun mult (c, y), apply_fun inv c).
  {
    apply (nat_strong_ind
      (fun k => forall z:set, z :e G -> z <> e ->
        (exists m:set, m :e omega /\ m <> 0 /\ group_power_nat mult e z m = e) ->
        forall nz zs:set,
        reduced_word 2 Gfam efam nz zs -> nz <> 0 ->
        word_product mult e zs nz = z ->
        (forall n' xs':set, reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
          word_product mult e xs' n' = z ->
          nz = n' /\ (forall i:set, i :e nz -> apply_fun zs i = apply_fun xs' i)) ->
        nz :e ordsucc k ->
        exists c y:set, c :e G /\ (y :e G1 \/ y :e G2) /\
          (exists m:set, m :e omega /\ m <> 0 /\ group_power_nat mult e y m = e) /\
          z = apply_fun mult (apply_fun mult (c, y), apply_fun inv c))).
    let k. assume Hk_nat : nat_p k. assume HIH : forall j:set, j :e k ->
      forall z:set, z :e G -> z <> e ->
        (exists m:set, m :e omega /\ m <> 0 /\ group_power_nat mult e z m = e) ->
        forall nz zs:set,
        reduced_word 2 Gfam efam nz zs -> nz <> 0 ->
        word_product mult e zs nz = z ->
        (forall n' xs':set, reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
          word_product mult e xs' n' = z ->
          nz = n' /\ (forall i:set, i :e nz -> apply_fun zs i = apply_fun xs' i)) ->
        nz :e ordsucc j ->
        exists c y:set, c :e G /\ (y :e G1 \/ y :e G2) /\
          (exists m:set, m :e omega /\ m <> 0 /\ group_power_nat mult e y m = e) /\
          z = apply_fun mult (apply_fun mult (c, y), apply_fun inv c).
    let z. assume HzG Hzne Hzfin.
    let nz zs. assume Hredz Hnz_ne0 Hwpz Huniq_z Hnz_bound.
    (** Extract reduced word omega-membership **)
    claim HnzO : nz :e omega.
    { apply (and3E (nz :e omega)
        (forall i:set, i :e nz -> exists a:set, a :e 2 /\ apply_fun zs i :e apply_fun Gfam a /\ apply_fun zs i <> apply_fun efam a)
        (forall i:set, i :e nz -> ordsucc i :e nz ->
          forall a b:set, a :e 2 -> b :e 2 -> apply_fun zs i :e apply_fun Gfam a -> apply_fun zs (ordsucc i) :e apply_fun Gfam b -> a <> b)
        Hredz). assume HnO _ _. exact HnO. }
    claim Hnz_nat : nat_p nz. { exact (omega_nat_p nz HnzO). }
    (** Case: nz = 1 **)
    apply (xm (nz = 1)).
    * assume Hnz1 : nz = 1.
      (** z has word of length 1, so z = zs(0) in some factor **)
      claim H0nz : 0 :e nz. { rewrite Hnz1. exact (ordsuccI2 0). }
      apply (and3E (nz :e omega)
        (forall i:set, i :e nz -> exists a:set, a :e 2 /\ apply_fun zs i :e apply_fun Gfam a /\ apply_fun zs i <> apply_fun efam a)
        (forall i:set, i :e nz -> ordsucc i :e nz ->
          forall a b:set, a :e 2 -> b :e 2 -> apply_fun zs i :e apply_fun Gfam a -> apply_fun zs (ordsucc i) :e apply_fun Gfam b -> a <> b)
        Hredz). assume _ Hentries _.
      apply (Hentries 0 H0nz). let alpha0.
      assume Halpha0_pack : alpha0 :e 2 /\ apply_fun zs 0 :e apply_fun Gfam alpha0 /\ apply_fun zs 0 <> apply_fun efam alpha0.
      apply (and3E (alpha0 :e 2) (apply_fun zs 0 :e apply_fun Gfam alpha0) (apply_fun zs 0 <> apply_fun efam alpha0) Halpha0_pack).
      assume Ha0J Hzs0_Ga0 _.
      (** z = word_product(zs, 1) = zs(0) **)
      claim Hwp1_step : word_product mult e zs 1 = apply_fun mult (word_product mult e zs 0, apply_fun zs 0).
      { exact (word_product_succ mult e zs 0 nat_0). }
      claim Hwp0 : word_product mult e zs 0 = e.
      { exact (nat_primrec_0 e (fun i r:set => apply_fun mult (r, apply_fun zs i))). }
      claim Hwp1 : word_product mult e zs 1 = apply_fun mult (e, apply_fun zs 0).
      { rewrite Hwp1_step. rewrite Hwp0. reflexivity. }
      claim Hzs0_G : apply_fun zs 0 :e G. { exact (Hsub_in_G alpha0 Ha0J (apply_fun zs 0) Hzs0_Ga0). }
      claim Hle : apply_fun mult (e, apply_fun zs 0) = apply_fun zs 0.
      { exact (andEL (apply_fun mult (e, apply_fun zs 0) = apply_fun zs 0)
          (apply_fun mult (apply_fun zs 0, e) = apply_fun zs 0) (Hid (apply_fun zs 0) Hzs0_G)). }
      claim Hz_eq : z = apply_fun zs 0.
      { claim Hwp_nz : word_product mult e zs nz = z. { exact Hwpz. }
        claim Hwp_1_eq_nz : word_product mult e zs 1 = word_product mult e zs nz.
        { rewrite Hnz1. reflexivity. }
        claim Hwp_1_eq_z : word_product mult e zs 1 = z.
        { exact (eq_i_tra (word_product mult e zs 1) (word_product mult e zs nz) z Hwp_1_eq_nz Hwp_nz). }
        claim Hwp_1_eq_zs0 : word_product mult e zs 1 = apply_fun zs 0.
        { rewrite Hwp1. exact Hle. }
        exact (eq_i_tra z (word_product mult e zs 1) (apply_fun zs 0)
          (eq_symm (word_product mult e zs 1) z Hwp_1_eq_z) Hwp_1_eq_zs0). }
      (** z is in G1 or G2 **)
      witness e. witness z.
      apply and4I.
      + exact HeG.
      + (** z in G1 or G2 **)
        rewrite Hz_eq.
        claim Hzs0_G1_or_G2 : apply_fun zs 0 :e G1 \/ apply_fun zs 0 :e G2.
        { apply (ordsuccE 1 alpha0 Ha0J).
          - assume Ha1 : alpha0 :e 1.
            apply (ordsuccE 0 alpha0 Ha1).
            + assume Ha0 : alpha0 :e 0. exact (FalseE (EmptyE alpha0 Ha0)
                  (apply_fun zs 0 :e G1 \/ apply_fun zs 0 :e G2)).
            + assume Ha_eq_0 : alpha0 = 0.
              apply orIL.
              claim HGa_eq : apply_fun Gfam alpha0 = G1. { rewrite Ha_eq_0. exact HGfam0. }
              exact (eq_subst_mem_set (apply_fun zs 0) (apply_fun Gfam alpha0) G1 Hzs0_Ga0 HGa_eq).
          - assume Ha_eq_1 : alpha0 = 1.
            apply orIR.
            claim HGa_eq : apply_fun Gfam alpha0 = G2. { rewrite Ha_eq_1. exact HGfam1. }
            exact (eq_subst_mem_set (apply_fun zs 0) (apply_fun Gfam alpha0) G2 Hzs0_Ga0 HGa_eq). }
        exact Hzs0_G1_or_G2.
      + (** z has finite order **)
        exact Hzfin.
      + (** z = mult(mult(e, z), inv(e)) = z **)
        claim Hez : apply_fun mult (e, z) = z.
        { exact (andEL (apply_fun mult (e, z) = z) (apply_fun mult (z, e) = z) (Hid z HzG)). }
        claim Hinve : apply_fun inv e = e.
        { claim Hei : apply_fun mult (e, apply_fun inv e) = e.
          { exact (andEL (apply_fun mult (e, apply_fun inv e) = e)
              (apply_fun mult (apply_fun inv e, e) = e) (Hinverse e HeG)). }
          claim Hle2 : apply_fun mult (e, apply_fun inv e) = apply_fun inv e.
          { exact (andEL (apply_fun mult (e, apply_fun inv e) = apply_fun inv e)
              (apply_fun mult (apply_fun inv e, e) = apply_fun inv e)
              (Hid (apply_fun inv e) (HinvG e HeG))). }
          exact (eq_i_tra (apply_fun inv e) (apply_fun mult (e, apply_fun inv e)) e
            (eq_symm (apply_fun mult (e, apply_fun inv e)) (apply_fun inv e) Hle2) Hei). }
        claim Hze : apply_fun mult (z, e) = z.
        { exact (andER (apply_fun mult (e, z) = z) (apply_fun mult (z, e) = z) (Hid z HzG)). }
        rewrite Hinve. rewrite Hez. exact (eq_symm (apply_fun mult (z, e)) z Hze).
    * assume Hnz_ne1 : nz <> 1.
      (** nz >= 2 **)
      claim HnzO : nz :e omega.
      { apply (and3E (nz :e omega)
          (forall i:set, i :e nz -> exists a:set, a :e 2 /\ apply_fun zs i :e apply_fun Gfam a /\ apply_fun zs i <> apply_fun efam a)
          (forall i:set, i :e nz -> ordsucc i :e nz ->
            forall a b:set, a :e 2 -> b :e 2 -> apply_fun zs i :e apply_fun Gfam a -> apply_fun zs (ordsucc i) :e apply_fun Gfam b -> a <> b)
          Hredz). assume HnO _ _. exact HnO. }
      claim Hnz_nat : nat_p nz. { exact (omega_nat_p nz HnzO). }
      (** nz = ordsucc mz **)
      claim Hex_mz : exists mz:set, nat_p mz /\ nz = ordsucc mz.
      { apply (nat_inv nz Hnz_nat).
        - assume Hnz0 : nz = 0. exact (FalseE (Hnz_ne0 Hnz0) (exists mz:set, nat_p mz /\ nz = ordsucc mz)).
        - assume H. exact H. }
      set mz := Eps_i (fun m:set => nat_p m /\ nz = ordsucc m).
      claim Hmz_pack : nat_p mz /\ nz = ordsucc mz. { exact (Eps_i_ex (fun m:set => nat_p m /\ nz = ordsucc m) Hex_mz). }
      claim Hmz_nat : nat_p mz. { exact (andEL (nat_p mz) (nz = ordsucc mz) Hmz_pack). }
      claim Hnz_eq : nz = ordsucc mz. { exact (andER (nat_p mz) (nz = ordsucc mz) Hmz_pack). }
      claim H0_nz : 0 :e nz.
      { exact (eq_subst_mem_set 0 (ordsucc mz) nz (nat_0_in_ordsucc mz Hmz_nat) (eq_symm nz (ordsucc mz) Hnz_eq)). }
      claim Hmz_nz : mz :e nz.
      { exact (eq_subst_mem_set mz (ordsucc mz) nz (ordsuccI2 mz) (eq_symm nz (ordsucc mz) Hnz_eq)). }
      (** Get factor labels **)
      set alpha_first := Eps_i (fun a:set => a :e 2 /\ apply_fun zs 0 :e apply_fun Gfam a /\ apply_fun zs 0 <> apply_fun efam a).
      claim Haf_pack : alpha_first :e 2 /\ apply_fun zs 0 :e apply_fun Gfam alpha_first /\ apply_fun zs 0 <> apply_fun efam alpha_first.
      { exact (Eps_i_ex (fun a:set => a :e 2 /\ apply_fun zs 0 :e apply_fun Gfam a /\ apply_fun zs 0 <> apply_fun efam a)
          (reduced_word_elem 2 Gfam efam nz zs 0 Hredz H0_nz)). }
      claim Haf_AB : alpha_first :e 2 /\ apply_fun zs 0 :e apply_fun Gfam alpha_first.
      { exact (andEL (alpha_first :e 2 /\ apply_fun zs 0 :e apply_fun Gfam alpha_first)
          (apply_fun zs 0 <> apply_fun efam alpha_first) Haf_pack). }
      claim Haf_J : alpha_first :e 2.
      { exact (andEL (alpha_first :e 2) (apply_fun zs 0 :e apply_fun Gfam alpha_first) Haf_AB). }
      claim Hzs0_Gaf : apply_fun zs 0 :e apply_fun Gfam alpha_first.
      { exact (andER (alpha_first :e 2) (apply_fun zs 0 :e apply_fun Gfam alpha_first) Haf_AB). }
      set alpha_last := Eps_i (fun a:set => a :e 2 /\ apply_fun zs mz :e apply_fun Gfam a /\ apply_fun zs mz <> apply_fun efam a).
      claim Hal_pack : alpha_last :e 2 /\ apply_fun zs mz :e apply_fun Gfam alpha_last /\ apply_fun zs mz <> apply_fun efam alpha_last.
      { exact (Eps_i_ex (fun a:set => a :e 2 /\ apply_fun zs mz :e apply_fun Gfam a /\ apply_fun zs mz <> apply_fun efam a)
          (reduced_word_elem 2 Gfam efam nz zs mz Hredz Hmz_nz)). }
      claim Hal_AB : alpha_last :e 2 /\ apply_fun zs mz :e apply_fun Gfam alpha_last.
      { exact (andEL (alpha_last :e 2 /\ apply_fun zs mz :e apply_fun Gfam alpha_last)
          (apply_fun zs mz <> apply_fun efam alpha_last) Hal_pack). }
      claim Hal_J : alpha_last :e 2.
      { exact (andEL (alpha_last :e 2) (apply_fun zs mz :e apply_fun Gfam alpha_last) Hal_AB). }
      claim Hzsmz_Gal : apply_fun zs mz :e apply_fun Gfam alpha_last.
      { exact (andER (alpha_last :e 2) (apply_fun zs mz :e apply_fun Gfam alpha_last) Hal_AB). }
      claim Hzsmz_G : apply_fun zs mz :e G. { exact (Hsub_in_G alpha_last Hal_J (apply_fun zs mz) Hzsmz_Gal). }
      claim Hzs0_G : apply_fun zs 0 :e G. { exact (Hsub_in_G alpha_first Haf_J (apply_fun zs 0) Hzs0_Gaf). }
      claim Hinvzsmz_G : apply_fun inv (apply_fun zs mz) :e G. { exact (HinvG (apply_fun zs mz) Hzsmz_G). }
      (** Case split **)
      apply (xm (alpha_first = alpha_last)).
      + assume Haf_al : alpha_first = alpha_last.
        (** Not cyclically reduced: conjugate to shorter word **)
        set zc := apply_fun mult (apply_fun zs mz,
          apply_fun mult (z, apply_fun inv (apply_fun zs mz))).
        claim Hzi_G : apply_fun mult (z, apply_fun inv (apply_fun zs mz)) :e G.
        { exact (HmultG z (apply_fun inv (apply_fun zs mz))
            HzG Hinvzsmz_G). }
        claim HzcG : zc :e G.
        { exact (HmultG (apply_fun zs mz)
            (apply_fun mult (z, apply_fun inv (apply_fun zs mz)))
            Hzsmz_G Hzi_G). }
        (** z = mult(mult(inv(zsmz), zc), zsmz) **)
        claim Hz_conj : z = apply_fun mult (apply_fun mult
          (apply_fun inv (apply_fun zs mz), zc), apply_fun zs mz).
        { set a := apply_fun zs mz.
          set ia := apply_fun inv (apply_fun zs mz).
          claim HaG : a :e G. { exact Hzsmz_G. }
          claim HiaG : ia :e G. { exact Hinvzsmz_G. }
          claim Hzia : apply_fun mult (z, ia) :e G.
          { exact (HmultG z ia HzG HiaG). }
          claim Hia_a : apply_fun mult (ia, a) = e.
          { exact (andER (apply_fun mult (a, ia) = e)
              (apply_fun mult (ia, a) = e) (Hinverse a HaG)). }
          claim Ha_ia : apply_fun mult (a, ia) = e.
          { exact (andEL (apply_fun mult (a, ia) = e)
              (apply_fun mult (ia, a) = e) (Hinverse a HaG)). }
          claim Hassoc1 : apply_fun mult (ia, zc) =
            apply_fun mult (ia, apply_fun mult (a, apply_fun mult (z, ia))).
          { reflexivity. }
          claim Hassoc2 : apply_fun mult (ia, apply_fun mult (a, apply_fun mult (z, ia))) =
            apply_fun mult (apply_fun mult (ia, a), apply_fun mult (z, ia)).
          { symmetry. exact (Hassoc ia a (apply_fun mult (z, ia))
              HiaG HaG Hzia). }
          claim Hstep1 : apply_fun mult (apply_fun mult (ia, a), apply_fun mult (z, ia)) =
            apply_fun mult (e, apply_fun mult (z, ia)).
          { rewrite Hia_a. reflexivity. }
          claim Hle : apply_fun mult (e, apply_fun mult (z, ia)) = apply_fun mult (z, ia).
          { exact (andEL (apply_fun mult (e, apply_fun mult (z, ia)) = apply_fun mult (z, ia))
              (apply_fun mult (apply_fun mult (z, ia), e) = apply_fun mult (z, ia))
              (Hid (apply_fun mult (z, ia)) Hzia)). }
          claim Hia_zc : apply_fun mult (ia, zc) = apply_fun mult (z, ia).
          { exact (eq_i_tra (apply_fun mult (ia, zc))
              (apply_fun mult (apply_fun mult (ia, a), apply_fun mult (z, ia)))
              (apply_fun mult (z, ia))
              (eq_i_tra (apply_fun mult (ia, zc))
                (apply_fun mult (ia, apply_fun mult (a, apply_fun mult (z, ia))))
                (apply_fun mult (apply_fun mult (ia, a), apply_fun mult (z, ia)))
                Hassoc1 Hassoc2)
              (eq_i_tra (apply_fun mult (apply_fun mult (ia, a), apply_fun mult (z, ia)))
                (apply_fun mult (e, apply_fun mult (z, ia)))
                (apply_fun mult (z, ia)) Hstep1 Hle)). }
          claim Hassoc3 : apply_fun mult (apply_fun mult (z, ia), a) =
            apply_fun mult (z, apply_fun mult (ia, a)).
          { exact (Hassoc z ia a HzG HiaG HaG). }
          claim Hstep2 : apply_fun mult (z, apply_fun mult (ia, a)) =
            apply_fun mult (z, e).
          { rewrite Hia_a. reflexivity. }
          claim Hre : apply_fun mult (z, e) = z.
          { exact (andER (apply_fun mult (e, z) = z)
              (apply_fun mult (z, e) = z) (Hid z HzG)). }
          claim Hzia_a : apply_fun mult (apply_fun mult (z, ia), a) = z.
          { exact (eq_i_tra (apply_fun mult (apply_fun mult (z, ia), a))
              (apply_fun mult (z, apply_fun mult (ia, a)))
              z
              Hassoc3
              (eq_i_tra (apply_fun mult (z, apply_fun mult (ia, a)))
                (apply_fun mult (z, e)) z Hstep2 Hre)). }
          claim Hfinal : apply_fun mult (apply_fun mult (ia, zc), a) = z.
          { claim Hstep : apply_fun mult (apply_fun mult (ia, zc), a) =
              apply_fun mult (apply_fun mult (z, ia), a).
            { rewrite Hia_zc. reflexivity. }
            exact (eq_i_tra (apply_fun mult (apply_fun mult (ia, zc), a))
              (apply_fun mult (apply_fun mult (z, ia), a)) z Hstep Hzia_a). }
          symmetry. exact Hfinal. }
        (** zc has finite order **)
        claim Hzcfin : exists m:set, m :e omega /\ m <> 0 /\
          group_power_nat mult e zc m = e.
        { set m0 := Eps_i (fun m => m :e omega /\ m <> 0 /\ group_power_nat mult e z m = e).
          claim Hm0 : m0 :e omega /\ m0 <> 0 /\ group_power_nat mult e z m0 = e.
          { exact (Eps_i_ex (fun m => m :e omega /\ m <> 0 /\ group_power_nat mult e z m = e)
              Hzfin). }
          apply (and3E (m0 :e omega) (m0 <> 0) (group_power_nat mult e z m0 = e) Hm0).
          assume Hm0O : m0 :e omega. assume Hm0ne : m0 <> 0.
          assume Hzm0 : group_power_nat mult e z m0 = e.
          witness m0. apply and3I.
          - exact Hm0O.
          - exact Hm0ne.
          - claim Hconj_eq : group_power_nat mult e zc m0 =
              apply_fun mult (apply_fun zs mz,
                apply_fun mult (group_power_nat mult e z m0,
                  apply_fun inv (apply_fun zs mz))).
            { exact (conjugate_power_nat G mult e inv (apply_fun zs mz) z
                Hgrp Hzsmz_G HzG m0 Hm0O). }
            claim Hstep1 : apply_fun mult (apply_fun zs mz,
              apply_fun mult (group_power_nat mult e z m0,
                apply_fun inv (apply_fun zs mz))) =
              apply_fun mult (apply_fun zs mz,
                apply_fun mult (e, apply_fun inv (apply_fun zs mz))).
            { rewrite Hzm0. reflexivity. }
            claim Hle_inv : apply_fun mult (e, apply_fun inv (apply_fun zs mz)) =
              apply_fun inv (apply_fun zs mz).
            { exact (andEL
                (apply_fun mult (e, apply_fun inv (apply_fun zs mz)) =
                  apply_fun inv (apply_fun zs mz))
                (apply_fun mult (apply_fun inv (apply_fun zs mz), e) =
                  apply_fun inv (apply_fun zs mz))
                (Hid (apply_fun inv (apply_fun zs mz)) Hinvzsmz_G)). }
            claim Hstep2 : apply_fun mult (apply_fun zs mz,
              apply_fun mult (e, apply_fun inv (apply_fun zs mz))) =
              apply_fun mult (apply_fun zs mz, apply_fun inv (apply_fun zs mz)).
            { rewrite Hle_inv. reflexivity. }
            claim Hinv_cancel : apply_fun mult (apply_fun zs mz,
              apply_fun inv (apply_fun zs mz)) = e.
            { exact (andEL
                (apply_fun mult (apply_fun zs mz, apply_fun inv (apply_fun zs mz)) = e)
                (apply_fun mult (apply_fun inv (apply_fun zs mz), apply_fun zs mz) = e)
                (Hinverse (apply_fun zs mz) Hzsmz_G)). }
            exact (eq_i_tra (group_power_nat mult e zc m0)
              (apply_fun mult (apply_fun zs mz,
                apply_fun mult (group_power_nat mult e z m0,
                  apply_fun inv (apply_fun zs mz))))
              e Hconj_eq
              (eq_i_tra (apply_fun mult (apply_fun zs mz,
                apply_fun mult (group_power_nat mult e z m0,
                  apply_fun inv (apply_fun zs mz))))
                (apply_fun mult (apply_fun zs mz, apply_fun inv (apply_fun zs mz)))
                e
                (eq_i_tra (apply_fun mult (apply_fun zs mz,
                  apply_fun mult (group_power_nat mult e z m0,
                    apply_fun inv (apply_fun zs mz))))
                  (apply_fun mult (apply_fun zs mz,
                    apply_fun mult (e, apply_fun inv (apply_fun zs mz))))
                  (apply_fun mult (apply_fun zs mz, apply_fun inv (apply_fun zs mz)))
                  Hstep1 Hstep2)
                Hinv_cancel)). }
        (** zc != e **)
        claim Hzcne : zc <> e.
        { assume Hzce : zc = e.
          claim Hz_is_e : z = e.
          { rewrite Hz_conj. rewrite Hzce.
            claim Hia_e : apply_fun mult (apply_fun inv (apply_fun zs mz), e) =
              apply_fun inv (apply_fun zs mz).
            { exact (andER
                (apply_fun mult (e, apply_fun inv (apply_fun zs mz)) = apply_fun inv (apply_fun zs mz))
                (apply_fun mult (apply_fun inv (apply_fun zs mz), e) = apply_fun inv (apply_fun zs mz))
                (Hid (apply_fun inv (apply_fun zs mz)) Hinvzsmz_G)). }
            rewrite Hia_e.
            exact (andER
              (apply_fun mult (apply_fun zs mz, apply_fun inv (apply_fun zs mz)) = e)
              (apply_fun mult (apply_fun inv (apply_fun zs mz), apply_fun zs mz) = e)
              (Hinverse (apply_fun zs mz) Hzsmz_G)). }
          exact (Hzne Hz_is_e). }
        (** By IH, zc = mult(mult(c0,y0),inv(c0)) **)
        (** zc has a reduced word from free product structure **)
        claim Hzc_wp : exists nzc xszc:set,
          reduced_word 2 Gfam efam nzc xszc /\ nzc <> 0 /\
          word_product mult e xszc nzc = zc /\
          (forall n' xs':set,
            reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
            word_product mult e xs' n' = zc ->
            nzc = n' /\ (forall i:set, i :e nzc -> apply_fun xszc i = apply_fun xs' i)).
        { apply (and6E
            (group_structure G mult e inv)
            (forall alpha:set, alpha :e 2 -> subgroup_of (apply_fun Gfam alpha) G mult e inv)
            (forall alpha beta:set, alpha :e 2 -> beta :e 2 -> alpha <> beta ->
              forall x:set, x :e apply_fun Gfam alpha -> x :e apply_fun Gfam beta -> x = e)
            (subgroups_generate G mult e inv 2 Gfam)
            (forall x:set, x :e G -> x <> e ->
              exists n0 xs0:set,
                reduced_word 2 Gfam efam n0 xs0 /\ n0 <> 0 /\
                word_product mult e xs0 n0 = x /\
                (forall n' xs':set,
                  reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
                  word_product mult e xs' n' = x ->
                  n0 = n' /\ (forall i:set, i :e n0 -> apply_fun xs0 i = apply_fun xs' i)))
            (forall alpha:set, alpha :e 2 -> apply_fun efam alpha = e)
            Hfp).
          assume _ _ _ _ Huniq_all _.
          exact (Huniq_all zc HzcG Hzcne). }
        apply Hzc_wp. let nzc.
        assume Hzc_wp2 : exists xszc:set,
          reduced_word 2 Gfam efam nzc xszc /\ nzc <> 0 /\
          word_product mult e xszc nzc = zc /\
          (forall n' xs':set,
            reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
            word_product mult e xs' n' = zc ->
            nzc = n' /\ (forall i:set, i :e nzc -> apply_fun xszc i = apply_fun xs' i)).
        apply Hzc_wp2. let xszc.
        assume Hzc_pack : reduced_word 2 Gfam efam nzc xszc /\ nzc <> 0 /\
          word_product mult e xszc nzc = zc /\
          (forall n' xs':set,
            reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
            word_product mult e xs' n' = zc ->
            nzc = n' /\ (forall i:set, i :e nzc -> apply_fun xszc i = apply_fun xs' i)).
        (** Extract components using left-assoc /\: ((A /\ B) /\ C) /\ D **)
        claim Hred_zc : reduced_word 2 Gfam efam nzc xszc.
        { exact (andEL (reduced_word 2 Gfam efam nzc xszc) (nzc <> 0)
            (andEL (reduced_word 2 Gfam efam nzc xszc /\ (nzc <> 0))
              (word_product mult e xszc nzc = zc)
              (andEL ((reduced_word 2 Gfam efam nzc xszc /\ (nzc <> 0)) /\
                (word_product mult e xszc nzc = zc))
                (forall n' xs':set,
                  reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
                  word_product mult e xs' n' = zc ->
                  nzc = n' /\ (forall i:set, i :e nzc -> apply_fun xszc i = apply_fun xs' i))
                Hzc_pack))). }
        claim Hnzc_ne0 : nzc <> 0.
        { exact (andER (reduced_word 2 Gfam efam nzc xszc) (nzc <> 0)
            (andEL (reduced_word 2 Gfam efam nzc xszc /\ (nzc <> 0))
              (word_product mult e xszc nzc = zc)
              (andEL ((reduced_word 2 Gfam efam nzc xszc /\ (nzc <> 0)) /\
                (word_product mult e xszc nzc = zc))
                (forall n' xs':set,
                  reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
                  word_product mult e xs' n' = zc ->
                  nzc = n' /\ (forall i:set, i :e nzc -> apply_fun xszc i = apply_fun xs' i))
                Hzc_pack))). }
        claim Hwpzc : word_product mult e xszc nzc = zc.
        { exact (andER (reduced_word 2 Gfam efam nzc xszc /\ (nzc <> 0))
              (word_product mult e xszc nzc = zc)
              (andEL ((reduced_word 2 Gfam efam nzc xszc /\ (nzc <> 0)) /\
                (word_product mult e xszc nzc = zc))
                (forall n' xs':set,
                  reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
                  word_product mult e xs' n' = zc ->
                  nzc = n' /\ (forall i:set, i :e nzc -> apply_fun xszc i = apply_fun xs' i))
                Hzc_pack)). }
        claim Huniq_zc : forall n' xs':set,
          reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
          word_product mult e xs' n' = zc ->
          nzc = n' /\ (forall i:set, i :e nzc -> apply_fun xszc i = apply_fun xs' i).
        { exact (andER ((reduced_word 2 Gfam efam nzc xszc /\ (nzc <> 0)) /\
                (word_product mult e xszc nzc = zc))
                (forall n' xs':set,
                  reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
                  word_product mult e xs' n' = zc ->
                  nzc = n' /\ (forall i:set, i :e nzc -> apply_fun xszc i = apply_fun xs' i))
                Hzc_pack). }
        (** Now need: nzc :e nz (so nzc < nz) **)
        (** This follows from: zc has a word representation of length mz **)
        (** Construct the word representation of zc **)
        claim Hnzc_in_nz : nzc :e nz.
        {
          (** zs(0) :e Gfam(alpha_last) since alpha_first = alpha_last **)
          claim Hzs0_Gal : apply_fun zs 0 :e apply_fun Gfam alpha_last.
          { exact (eq_subst_mem_set (apply_fun zs 0) (apply_fun Gfam alpha_first)
              (apply_fun Gfam alpha_last) Hzs0_Gaf
              (apply_fun_congr_arg Gfam alpha_first alpha_last Haf_al)). }
          claim Hsub_al : subgroup_of (apply_fun Gfam alpha_last) G mult e inv.
          { exact (Hsubfam alpha_last Hal_J). }
          (** p = mult(zs(mz), zs(0)) is in Gfam(alpha_last) **)
          claim Hp_in_fac : apply_fun mult (apply_fun zs mz, apply_fun zs 0) :e apply_fun Gfam alpha_last.
          { exact (subgroup_of_mult_closed (apply_fun Gfam alpha_last) G mult e inv
              (apply_fun zs mz) (apply_fun zs 0) Hsub_al Hzsmz_Gal Hzs0_Gal). }
          (** Use the suffix [zs(1), ..., zs(mz)] as a reduced word (reduced_word_suffix) **)
          claim Hred_suf : reduced_word 2 Gfam efam mz
            (graph mz (fun i:set => apply_fun zs (ordsucc i))).
          { claim Hred_sm : reduced_word 2 Gfam efam (ordsucc mz) zs.
            { rewrite <- Hnz_eq. exact Hredz. }
            exact (reduced_word_suffix 2 Gfam efam mz zs Hred_sm). }
          (** The prefix [zs(1), ..., zs(mz-1)] is also reduced (by reduced_word_prefix of suffix) **)
          (** But we need mz >= 1, which we have since nz >= 2 **)
          (** Case split on p = e or p <> e **)
          (** Actually, we need a case split on p = efam(alpha_last) or not **)
          (** But efam(alpha_last) = e, so this is p = e or p <> e **)
          (** Strategy: construct a reduced word for zc of length mz (or less) **)
          (** Since mz :e ordsucc mz = nz, we get nzc :e nz by uniqueness **)
          (** The construction and its verification are admitted for now **)
          (** First establish: z = mult(word_product(zs, mz), zs(mz)) **)
          claim Hwp_nz_expanded : word_product mult e zs nz =
            apply_fun mult (word_product mult e zs mz, apply_fun zs mz).
          { exact (word_product_succ_eq mult e zs nz mz Hmz_nat Hnz_eq). }
          claim Hwp_decomp : z = apply_fun mult (word_product mult e zs mz, apply_fun zs mz).
          { exact (eq_i_tra z (word_product mult e zs nz)
              (apply_fun mult (word_product mult e zs mz, apply_fun zs mz))
              (eq_symm (word_product mult e zs nz) z Hwpz)
              Hwp_nz_expanded). }
          (** Now prove zc = mult(zs(mz), word_product(zs, mz)) via associativity chain **)
          claim Hzs_in_G_mz : forall i:set, i :e mz -> apply_fun zs i :e G.
          { let i. assume Hi : i :e mz.
            exact (reduced_word_in_G G mult e inv 2 Gfam efam nz zs Hsubfam Hredz i
              (ordinal_TransSet nz (nat_p_ordinal nz (omega_nat_p nz HnzO)) mz Hmz_nz i Hi)). }
          claim Hwp_mz_G : word_product mult e zs mz :e G.
          { exact (word_product_in_G_group G mult e inv mz zs Hgrp Hmz_nat Hzs_in_G_mz). }
          claim HzmzG : apply_fun zs mz :e G. { exact Hzsmz_G. }
          claim HinvzmzG : apply_fun inv (apply_fun zs mz) :e G. { exact Hinvzsmz_G. }
          claim Ha_inva : apply_fun mult (apply_fun zs mz, apply_fun inv (apply_fun zs mz)) = e.
          { exact (andEL
              (apply_fun mult (apply_fun zs mz, apply_fun inv (apply_fun zs mz)) = e)
              (apply_fun mult (apply_fun inv (apply_fun zs mz), apply_fun zs mz) = e)
              (Hinverse (apply_fun zs mz) HzmzG)). }
          claim Hwpmz_a_inva : apply_fun mult (apply_fun mult (word_product mult e zs mz, apply_fun zs mz),
            apply_fun inv (apply_fun zs mz)) =
            apply_fun mult (word_product mult e zs mz,
              apply_fun mult (apply_fun zs mz, apply_fun inv (apply_fun zs mz))).
          { exact (Hassoc (word_product mult e zs mz) (apply_fun zs mz)
              (apply_fun inv (apply_fun zs mz)) Hwp_mz_G HzmzG HinvzmzG). }
          claim Hwpmz_e : apply_fun mult (word_product mult e zs mz, e) = word_product mult e zs mz.
          { exact (andER
              (apply_fun mult (e, word_product mult e zs mz) = word_product mult e zs mz)
              (apply_fun mult (word_product mult e zs mz, e) = word_product mult e zs mz)
              (Hid (word_product mult e zs mz) Hwp_mz_G)). }
          claim Hzi_eq : apply_fun mult (z, apply_fun inv (apply_fun zs mz)) =
            word_product mult e zs mz.
          { claim Hstep1 : apply_fun mult (z, apply_fun inv (apply_fun zs mz)) =
              apply_fun mult (apply_fun mult (word_product mult e zs mz, apply_fun zs mz),
                apply_fun inv (apply_fun zs mz)).
            { rewrite Hwp_decomp. reflexivity. }
            claim Hstep2a : apply_fun mult (word_product mult e zs mz,
                apply_fun mult (apply_fun zs mz, apply_fun inv (apply_fun zs mz))) =
              apply_fun mult (word_product mult e zs mz, e).
            { rewrite Ha_inva. reflexivity. }
            claim Hstep2 : apply_fun mult (apply_fun mult (word_product mult e zs mz, apply_fun zs mz),
                apply_fun inv (apply_fun zs mz)) =
              apply_fun mult (word_product mult e zs mz, e).
            { exact (eq_i_tra
                (apply_fun mult (apply_fun mult (word_product mult e zs mz, apply_fun zs mz),
                  apply_fun inv (apply_fun zs mz)))
                (apply_fun mult (word_product mult e zs mz,
                  apply_fun mult (apply_fun zs mz, apply_fun inv (apply_fun zs mz))))
                (apply_fun mult (word_product mult e zs mz, e))
                Hwpmz_a_inva Hstep2a). }
            exact (eq_i_tra
              (apply_fun mult (z, apply_fun inv (apply_fun zs mz)))
              (apply_fun mult (apply_fun mult (word_product mult e zs mz, apply_fun zs mz),
                apply_fun inv (apply_fun zs mz)))
              (word_product mult e zs mz)
              Hstep1
              (eq_i_tra
                (apply_fun mult (apply_fun mult (word_product mult e zs mz, apply_fun zs mz),
                  apply_fun inv (apply_fun zs mz)))
                (apply_fun mult (word_product mult e zs mz, e))
                (word_product mult e zs mz)
                Hstep2 Hwpmz_e)). }
          claim Hzc_prod : zc = apply_fun mult (apply_fun zs mz, word_product mult e zs mz).
          { rewrite Hzi_eq. reflexivity. }
          (** Now case split on p = mult(zs(mz), zs(0)) **)
          set p := apply_fun mult (apply_fun zs mz, apply_fun zs 0).
          claim HpG : p :e G. { exact (HmultG (apply_fun zs mz) (apply_fun zs 0) Hzsmz_G Hzs0_G). }
          claim Hmz_ne0 : mz <> 0.
          { assume Hmz0 : mz = 0.
            claim Hnz1 : nz = 1.
            { rewrite Hnz_eq. rewrite Hmz0. reflexivity. }
            exact (Hnz_ne1 Hnz1). }
          claim Hefam_al : apply_fun efam alpha_last = e.
          { exact (Hefam_e alpha_last Hal_J). }
          (** Hex_short_word proof via claims **)
          claim Hex_short_word_case_pe : p = e ->
            exists nw ws:set,
              reduced_word 2 Gfam efam nw ws /\ nw <> 0 /\
              word_product mult e ws nw = zc /\ nw :e nz.
          { assume Hpe : p = e.
            (** Get k_mz with mz = ordsucc k_mz **)
            claim Hkmz_ex2 : exists k:set, nat_p k /\ mz = ordsucc k.
            { claim H : mz = 0 \/ (exists k:set, nat_p k /\ mz = ordsucc k).
              { exact (nat_inv mz Hmz_nat). }
              apply H.
              - assume Hmz0 : mz = 0. exact (FalseE (Hmz_ne0 Hmz0) (exists k:set, nat_p k /\ mz = ordsucc k)).
              - assume Hex. exact Hex. }
            apply Hkmz_ex2. let k_mz.
            assume Hkmz_pack : nat_p k_mz /\ mz = ordsucc k_mz.
            claim Hkmz_nat : nat_p k_mz. { exact (andEL (nat_p k_mz) (mz = ordsucc k_mz) Hkmz_pack). }
            claim Hmz_sk : mz = ordsucc k_mz. { exact (andER (nat_p k_mz) (mz = ordsucc k_mz) Hkmz_pack). }
            claim HkmzO : k_mz :e omega. { exact (nat_p_omega k_mz Hkmz_nat). }
            (** First-element decomposition of word_product(zs, mz) **)
            claim Hshift_zs2 : word_product mult e zs mz =
              apply_fun mult (apply_fun zs 0,
                word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz).
            { exact (word_product_shift_first_eq G mult e inv k_mz mz zs
                Hgrp Hkmz_nat Hmz_sk Hzs_in_G_mz). }
            (** Membership for suffix word product **)
            claim Hzs_suf_in_G2 : forall i:set, i :e k_mz ->
              apply_fun (graph k_mz (fun i0:set => apply_fun zs (ordsucc i0))) i :e G.
            { let i. assume Hi : i :e k_mz.
              rewrite (apply_fun_graph k_mz (fun i0:set => apply_fun zs (ordsucc i0)) i Hi).
              claim Hsi_mz : ordsucc i :e mz.
              { rewrite Hmz_sk. exact (nat_ordsucc_in_ordsucc k_mz Hkmz_nat i Hi). }
              exact (Hzs_in_G_mz (ordsucc i) Hsi_mz). }
            claim Hwp_suf_G2 : word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz :e G.
            { exact (word_product_in_G_group G mult e inv k_mz
                (graph k_mz (fun i:set => apply_fun zs (ordsucc i)))
                Hgrp Hkmz_nat Hzs_suf_in_G2). }
            (** zc = word_product(zs_mid, k_mz) **)
            (** zc = mult(zs(mz), word_product(zs, mz))  [Hzc_prod] **)
            (**    = mult(zs(mz), mult(zs(0), wp_mid))    [Hshift_zs2] **)
            (**    = mult(mult(zs(mz), zs(0)), wp_mid)    [assoc] **)
            (**    = mult(p, wp_mid)                       [p def] **)
            (**    = mult(e, wp_mid)                       [Hpe] **)
            (**    = wp_mid                                [left id] **)
            claim Hassoc_pe : apply_fun mult (apply_fun mult (apply_fun zs mz, apply_fun zs 0),
                word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz) =
              apply_fun mult (apply_fun zs mz,
                apply_fun mult (apply_fun zs 0,
                  word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz)).
            { exact (Hassoc (apply_fun zs mz) (apply_fun zs 0)
                (word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz)
                Hzsmz_G Hzs0_G Hwp_suf_G2). }
            claim Hle_wp : apply_fun mult (e,
                word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz) =
              word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz.
            { exact (andEL
                (apply_fun mult (e, word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz) =
                  word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz)
                (apply_fun mult (word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz, e) =
                  word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz)
                (Hid (word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz) Hwp_suf_G2)). }
            claim Hstep_a : zc = apply_fun mult (apply_fun zs mz,
                apply_fun mult (apply_fun zs 0,
                  word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz)).
            { rewrite Hzc_prod. rewrite Hshift_zs2. reflexivity. }
            claim Hassoc_pe_sym : apply_fun mult (apply_fun zs mz,
                apply_fun mult (apply_fun zs 0,
                  word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz)) =
              apply_fun mult (apply_fun mult (apply_fun zs mz, apply_fun zs 0),
                word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz).
            { symmetry. exact Hassoc_pe. }
            claim Hstep_b : zc = apply_fun mult (p,
                word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz).
            { exact (eq_i_tra zc
                (apply_fun mult (apply_fun zs mz,
                  apply_fun mult (apply_fun zs 0,
                    word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz)))
                (apply_fun mult (p,
                  word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz))
                Hstep_a Hassoc_pe_sym). }
            claim Hpe_step : apply_fun mult (p,
                word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz) =
              apply_fun mult (e,
                word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz).
            { rewrite Hpe. reflexivity. }
            claim Hstep_c : zc = apply_fun mult (e,
                word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz).
            { exact (eq_i_tra zc
                (apply_fun mult (p,
                  word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz))
                (apply_fun mult (e,
                  word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz))
                Hstep_b Hpe_step). }
            claim Hzc_eq_mid : zc = word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz.
            { exact (eq_i_tra zc
                (apply_fun mult (e,
                  word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz))
                (word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz)
                Hstep_c Hle_wp). }
            (** Now case split on k_mz **)
            apply (xm (k_mz = 0)).
            - assume Hk0 : k_mz = 0.
              (** k_mz = 0 means mz = 1, nz = 2 **)
              (** zc = word_product(zs_mid, 0) = e **)
              claim Hwp0 : word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz = e.
              { rewrite Hk0.
                exact (nat_primrec_0 e (fun i r:set =>
                  apply_fun mult (r, apply_fun (graph 0 (fun i0:set => apply_fun zs (ordsucc i0))) i))). }
              claim Hzce : zc = e. { exact (eq_i_tra zc
                (word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz)
                e Hzc_eq_mid Hwp0). }
              exact (FalseE (Hzcne Hzce)
                (exists nw ws:set, reduced_word 2 Gfam efam nw ws /\ nw <> 0 /\
                  word_product mult e ws nw = zc /\ nw :e nz)).
            - assume Hkne0 : k_mz <> 0.
              (** k_mz >= 1, use prefix of suffix as reduced word **)
              witness k_mz.
              witness (graph k_mz (fun i:set => apply_fun zs (ordsucc i))).
              (** Reduced word: prefix of Hred_suf **)
              claim Hkmz_mz : k_mz :e mz.
              { rewrite Hmz_sk. exact (ordsuccI2 k_mz). }
              claim Hred_prefix_raw : reduced_word 2 Gfam efam k_mz
                (graph k_mz (fun j:set => apply_fun (graph mz (fun i:set => apply_fun zs (ordsucc i))) j)).
              { exact (reduced_word_prefix 2 Gfam efam mz
                  (graph mz (fun i:set => apply_fun zs (ordsucc i)))
                  k_mz Hred_suf Hkmz_mz). }
              claim Hcongr : forall j:set, j :e k_mz ->
                apply_fun (graph k_mz (fun j0:set => apply_fun (graph mz (fun i:set => apply_fun zs (ordsucc i))) j0)) j =
                apply_fun (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) j.
              { let j. assume Hj : j :e k_mz.
                rewrite (apply_fun_graph k_mz
                  (fun j0:set => apply_fun (graph mz (fun i:set => apply_fun zs (ordsucc i))) j0) j Hj).
                rewrite (apply_fun_graph k_mz (fun i:set => apply_fun zs (ordsucc i)) j Hj).
                claim Hj_mz : j :e mz.
                { exact (ordinal_TransSet mz (nat_p_ordinal mz Hmz_nat) k_mz Hkmz_mz j Hj). }
                exact (apply_fun_graph mz (fun i:set => apply_fun zs (ordsucc i)) j Hj_mz). }
              claim Hred_mid : reduced_word 2 Gfam efam k_mz (graph k_mz (fun i:set => apply_fun zs (ordsucc i))).
              { exact (reduced_word_congr_on 2 Gfam efam k_mz
                  (graph k_mz (fun j:set => apply_fun (graph mz (fun i:set => apply_fun zs (ordsucc i))) j))
                  (graph k_mz (fun i:set => apply_fun zs (ordsucc i)))
                  Hred_prefix_raw Hcongr). }
              claim Hkmz_nz : k_mz :e nz.
              { exact (ordinal_TransSet nz (nat_p_ordinal nz (omega_nat_p nz HnzO)) mz Hmz_nz k_mz Hkmz_mz). }
              claim Hzc_eq_mid_sym : word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz = zc.
              { symmetry. exact Hzc_eq_mid. }
              prove ((reduced_word 2 Gfam efam k_mz (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) /\ (k_mz <> 0)) /\
                word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz = zc) /\ k_mz :e nz.
              apply andI.
              + apply andI.
                * apply andI. exact Hred_mid. exact Hkne0.
                * exact Hzc_eq_mid_sym.
              + exact Hkmz_nz. }
          claim Hex_short_word_case_pne : p <> e ->
            exists nw ws:set,
              reduced_word 2 Gfam efam nw ws /\ nw <> 0 /\
              word_product mult e ws nw = zc /\ nw :e nz.
          { assume Hpne : p <> e.
            (** p :e Gfam(alpha_last) and p <> e **)
            (** Use: zc = mult(zs(mz), word_product(zs, mz)) = mult(p_element, rest) **)
            (** When p <> e, zc lies in Gfam(alpha_first) if mz = 1, otherwise construct a reduced word **)
            (** For any mz >= 1, we can construct a reduced word of length mz for zc **)
            (** The word is ws(0) = p, ws(i) = zs(i) for 1 <= i < mz **)
            witness mz.
            set ws_pne := graph mz (fun i:set => If_i (i = 0) p (apply_fun zs i)).
            witness ws_pne.
            claim Hmz_in_nz : mz :e nz.
            { exact (eq_subst_mem_set mz (ordsucc mz) nz (ordsuccI2 mz)
                (eq_symm nz (ordsucc mz) Hnz_eq)). }
            claim HmzO : mz :e omega. { exact (nat_p_omega mz Hmz_nat). }
            (** ws_pne value helpers **)
            claim H0_in_mz : 0 :e mz.
            { claim Hmz_cases : mz = 0 \/ (exists k_mz:set, nat_p k_mz /\ mz = ordsucc k_mz).
              { exact (nat_inv mz Hmz_nat). }
              apply Hmz_cases.
              - assume Hmz0 : mz = 0. exact (FalseE (Hmz_ne0 Hmz0) (0 :e mz)).
              - assume Hex : exists k_mz:set, nat_p k_mz /\ mz = ordsucc k_mz.
                apply Hex. let k_mz. assume Hk : nat_p k_mz /\ mz = ordsucc k_mz.
                rewrite (andER (nat_p k_mz) (mz = ordsucc k_mz) Hk).
                exact (nat_0_in_ordsucc k_mz (andEL (nat_p k_mz) (mz = ordsucc k_mz) Hk)). }
            claim Hws_val : forall i:set, i :e mz ->
              apply_fun ws_pne i = If_i (i = 0) p (apply_fun zs i).
            { let i. assume Hi.
              exact (apply_fun_graph mz (fun j:set => If_i (j = 0) p (apply_fun zs j)) i Hi). }
            claim Hws0 : apply_fun ws_pne 0 = p.
            { exact (eq_i_tra (apply_fun ws_pne 0) (If_i (0 = 0) p (apply_fun zs 0)) p
                (Hws_val 0 H0_in_mz)
                (If_i_1 (0 = 0) p (apply_fun zs 0) (eq_refl 0))). }
            claim Hws_ne0 : forall i:set, i :e mz -> i <> 0 ->
              apply_fun ws_pne i = apply_fun zs i.
            { let i. assume Hi Hine0.
              exact (eq_i_tra (apply_fun ws_pne i) (If_i (i = 0) p (apply_fun zs i))
                (apply_fun zs i) (Hws_val i Hi)
                (If_i_0 (i = 0) p (apply_fun zs i) Hine0)). }
            (** Word product equality: word_product(ws_pne, mz) = zc **)
            (** Get k_mz such that mz = ordsucc k_mz **)
            claim Hkmz_ex : exists k_mz:set, nat_p k_mz /\ mz = ordsucc k_mz.
            { claim H : mz = 0 \/ (exists k_mz:set, nat_p k_mz /\ mz = ordsucc k_mz).
              { exact (nat_inv mz Hmz_nat). }
              apply H.
              - assume Hmz0 : mz = 0. exact (FalseE (Hmz_ne0 Hmz0) (exists k_mz:set, nat_p k_mz /\ mz = ordsucc k_mz)).
              - assume Hex : exists k_mz:set, nat_p k_mz /\ mz = ordsucc k_mz. exact Hex. }
            apply Hkmz_ex. let k_mz.
            assume Hkmz_pack : nat_p k_mz /\ mz = ordsucc k_mz.
            claim Hkmz_nat : nat_p k_mz. { exact (andEL (nat_p k_mz) (mz = ordsucc k_mz) Hkmz_pack). }
            claim Hmz_sk : mz = ordsucc k_mz. { exact (andER (nat_p k_mz) (mz = ordsucc k_mz) Hkmz_pack). }
            (** Elements of ws_pne are in G **)
            claim Hws_in_G : forall i:set, i :e mz -> apply_fun ws_pne i :e G.
            { let i. assume Hi : i :e mz.
              apply (xm (i = 0)).
              - assume Hi0 : i = 0. rewrite Hi0. rewrite Hws0. exact HpG.
              - assume Hine0 : i <> 0. rewrite (Hws_ne0 i Hi Hine0).
                exact (Hzs_in_G_mz i Hi). }
            (** First-element decomposition of word_product(ws_pne, mz) **)
            claim Hshift_ws : word_product mult e ws_pne mz =
              apply_fun mult (apply_fun ws_pne 0,
                word_product mult e (graph k_mz (fun i:set => apply_fun ws_pne (ordsucc i))) k_mz).
            { exact (word_product_shift_first_eq G mult e inv k_mz mz ws_pne
                Hgrp Hkmz_nat Hmz_sk Hws_in_G). }
            (** Suffix agreement: ws_pne(ordsucc i) = zs(ordsucc i) for i in k_mz **)
            claim HkmzO : k_mz :e omega. { exact (nat_p_omega k_mz Hkmz_nat). }
            claim Hagree_suf : forall j:set, j :e k_mz ->
              apply_fun (graph k_mz (fun i:set => apply_fun ws_pne (ordsucc i))) j =
              apply_fun (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) j.
            { let j. assume Hj : j :e k_mz.
              rewrite (apply_fun_graph k_mz (fun i:set => apply_fun ws_pne (ordsucc i)) j Hj).
              rewrite (apply_fun_graph k_mz (fun i:set => apply_fun zs (ordsucc i)) j Hj).
              claim Hsj_in_mz : ordsucc j :e mz.
              { rewrite Hmz_sk. exact (nat_ordsucc_in_ordsucc k_mz Hkmz_nat j Hj). }
              exact (Hws_ne0 (ordsucc j) Hsj_in_mz (neq_ordsucc_0 j)). }
            claim Hwp_suf_agree : word_product mult e (graph k_mz (fun i:set => apply_fun ws_pne (ordsucc i))) k_mz =
              word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz.
            { exact (word_product_agree mult e
                (graph k_mz (fun i:set => apply_fun ws_pne (ordsucc i)))
                (graph k_mz (fun i:set => apply_fun zs (ordsucc i)))
                k_mz HkmzO Hagree_suf). }
            (** First-element decomposition of word_product(zs, mz) **)
            claim Hshift_zs : word_product mult e zs mz =
              apply_fun mult (apply_fun zs 0,
                word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz).
            { exact (word_product_shift_first_eq G mult e inv k_mz mz zs
                Hgrp Hkmz_nat Hmz_sk Hzs_in_G_mz). }
            (** Membership for suffix word product **)
            claim Hzs_suf_in_G : forall i:set, i :e k_mz ->
              apply_fun (graph k_mz (fun i0:set => apply_fun zs (ordsucc i0))) i :e G.
            { let i. assume Hi : i :e k_mz.
              rewrite (apply_fun_graph k_mz (fun i0:set => apply_fun zs (ordsucc i0)) i Hi).
              claim Hsi_mz : ordsucc i :e mz.
              { rewrite Hmz_sk. exact (nat_ordsucc_in_ordsucc k_mz Hkmz_nat i Hi). }
              exact (Hzs_in_G_mz (ordsucc i) Hsi_mz). }
            claim Hwp_suf_G : word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz :e G.
            { exact (word_product_in_G_group G mult e inv k_mz
                (graph k_mz (fun i:set => apply_fun zs (ordsucc i)))
                Hgrp Hkmz_nat Hzs_suf_in_G). }
            (** Associativity: mult(mult(zs(mz), zs(0)), wp_suf) = mult(zs(mz), mult(zs(0), wp_suf)) **)
            claim Hassoc_step : apply_fun mult (apply_fun mult (apply_fun zs mz, apply_fun zs 0),
                word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz) =
              apply_fun mult (apply_fun zs mz,
                apply_fun mult (apply_fun zs 0,
                  word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz)).
            { exact (Hassoc (apply_fun zs mz) (apply_fun zs 0)
                (word_product mult e (graph k_mz (fun i:set => apply_fun zs (ordsucc i))) k_mz)
                Hzsmz_G Hzs0_G Hwp_suf_G). }
            (** Chain: wp(ws_pne, mz) = mult(p, wp_zs_suf) = mult(zs(mz), mult(zs(0), wp_zs_suf)) = zc **)
            claim Hwp_ws_eq : word_product mult e ws_pne mz = zc.
            { rewrite Hshift_ws. rewrite Hws0. rewrite Hwp_suf_agree.
              rewrite Hassoc_step. rewrite Hzc_prod. rewrite Hshift_zs.
              reflexivity. }
            (** Reduced word conditions **)
            (** Extract components from Hredz **)
            claim Hredz_elem : forall i:set, i :e nz ->
              exists a:set, a :e 2 /\ apply_fun zs i :e apply_fun Gfam a /\ apply_fun zs i <> apply_fun efam a.
            { apply (and3E (nz :e omega)
                (forall i:set, i :e nz -> exists a:set, a :e 2 /\ apply_fun zs i :e apply_fun Gfam a /\ apply_fun zs i <> apply_fun efam a)
                (forall i:set, i :e nz -> ordsucc i :e nz ->
                  forall a b:set, a :e 2 -> b :e 2 -> apply_fun zs i :e apply_fun Gfam a -> apply_fun zs (ordsucc i) :e apply_fun Gfam b -> a <> b)
                Hredz). assume _ Helem _. exact Helem. }
            claim Hredz_adj : forall i:set, i :e nz -> ordsucc i :e nz ->
              forall a b:set, a :e 2 -> b :e 2 ->
                apply_fun zs i :e apply_fun Gfam a -> apply_fun zs (ordsucc i) :e apply_fun Gfam b -> a <> b.
            { apply (and3E (nz :e omega)
                (forall i:set, i :e nz -> exists a:set, a :e 2 /\ apply_fun zs i :e apply_fun Gfam a /\ apply_fun zs i <> apply_fun efam a)
                (forall i:set, i :e nz -> ordsucc i :e nz ->
                  forall a b:set, a :e 2 -> b :e 2 -> apply_fun zs i :e apply_fun Gfam a -> apply_fun zs (ordsucc i) :e apply_fun Gfam b -> a <> b)
                Hredz). assume _ _ Hadj. exact Hadj. }
            claim Hred_ws : reduced_word 2 Gfam efam mz ws_pne.
            { prove mz :e omega /\
                (forall i:set, i :e mz ->
                  exists alpha:set, alpha :e 2 /\
                    apply_fun ws_pne i :e apply_fun Gfam alpha /\
                    apply_fun ws_pne i <> apply_fun efam alpha) /\
                (forall i:set, i :e mz -> ordsucc i :e mz ->
                  forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
                    apply_fun ws_pne i :e apply_fun Gfam alpha ->
                    apply_fun ws_pne (ordsucc i) :e apply_fun Gfam beta -> alpha <> beta).
              apply and3I.
              - exact HmzO.
              - (** Element condition **)
                let i. assume Hi : i :e mz.
                apply (xm (i = 0)).
                + assume Hi0 : i = 0. rewrite Hi0. rewrite Hws0.
                  witness alpha_last.
                  prove alpha_last :e 2 /\ p :e apply_fun Gfam alpha_last /\ p <> apply_fun efam alpha_last.
                  apply and3I.
                  * exact Hal_J.
                  * exact Hp_in_fac.
                  * rewrite Hefam_al. exact Hpne.
                + assume Hine0 : i <> 0. rewrite (Hws_ne0 i Hi Hine0).
                  claim Hi_nz : i :e nz.
                  { exact (ordinal_TransSet nz (nat_p_ordinal nz (omega_nat_p nz HnzO)) mz Hmz_nz i Hi). }
                  exact (Hredz_elem i Hi_nz).
              - (** Adjacency condition **)
                let i. assume Hi : i :e mz. assume Hsi_mz : ordsucc i :e mz.
                let alpha beta. assume HaJ : alpha :e 2. assume HbJ : beta :e 2.
                apply (xm (i = 0)).
                + assume Hi0 : i = 0.
                  rewrite Hi0. rewrite Hws0.
                  claim Hsi_ne0 : ordsucc 0 <> 0. { exact (neq_ordsucc_0 0). }
                  claim Hsi0_mz : ordsucc 0 :e mz. { rewrite <- Hi0. exact Hsi_mz. }
                  rewrite (Hws_ne0 (ordsucc 0) Hsi0_mz Hsi_ne0).
                  (** Now: p :e Gfam(alpha), zs(1) :e Gfam(beta), need alpha <> beta **)
                  assume Hp_Ga : p :e apply_fun Gfam alpha.
                  assume Hzs1_Gb : apply_fun zs (ordsucc 0) :e apply_fun Gfam beta.
                  (** From disjointness: p :e Gfam(alpha) and p :e Gfam(alpha_last) and p <> e implies alpha = alpha_last **)
                  apply (xm (alpha = alpha_last)).
                  * assume Haeq : alpha = alpha_last.
                    (** zs(0) :e Gfam(alpha_first) = Gfam(alpha_last) and zs(1) :e Gfam(beta) **)
                    (** From Hredz adjacency at 0: alpha_last <> beta **)
                    claim H0_nz2 : 0 :e nz.
                    { exact (eq_subst_mem_set 0 (ordsucc mz) nz (nat_0_in_ordsucc mz Hmz_nat) (eq_symm nz (ordsucc mz) Hnz_eq)). }
                    claim H1_nz : ordsucc 0 :e nz.
                    { exact (ordinal_TransSet nz (nat_p_ordinal nz (omega_nat_p nz HnzO)) mz (eq_subst_mem_set mz (ordsucc mz) nz (ordsuccI2 mz) (eq_symm nz (ordsucc mz) Hnz_eq)) (ordsucc 0) Hsi0_mz). }
                    claim Hzs0_Gal2 : apply_fun zs 0 :e apply_fun Gfam alpha_last.
                    { exact (eq_subst_mem_set (apply_fun zs 0) (apply_fun Gfam alpha_first)
                        (apply_fun Gfam alpha_last) Hzs0_Gaf
                        (apply_fun_congr_arg Gfam alpha_first alpha_last Haf_al)). }
                    claim Hadj_orig : alpha_last <> beta.
                    { exact (Hredz_adj 0 H0_nz2 H1_nz alpha_last beta Hal_J HbJ Hzs0_Gal2 Hzs1_Gb). }
                    rewrite Haeq. exact Hadj_orig.
                  * assume Hane : alpha <> alpha_last.
                    (** p :e Gfam(alpha) and p :e Gfam(alpha_last) and alpha <> alpha_last **)
                    (** By disjointness: p = e, contradicting Hpne **)
                    claim Hp_e : p = e.
                    { exact (Hdisjoint alpha alpha_last HaJ Hal_J Hane p Hp_Ga Hp_in_fac). }
                    exact (FalseE (Hpne Hp_e) (alpha <> beta)).
                + assume Hine0 : i <> 0.
                  claim Hsi_ne0 : ordsucc i <> 0. { exact (neq_ordsucc_0 i). }
                  rewrite (Hws_ne0 i Hi Hine0).
                  rewrite (Hws_ne0 (ordsucc i) Hsi_mz Hsi_ne0).
                  (** Now: zs(i) :e Gfam(alpha), zs(ordsucc i) :e Gfam(beta), need alpha <> beta **)
                  assume Hzsi_Ga : apply_fun zs i :e apply_fun Gfam alpha.
                  assume Hzssi_Gb : apply_fun zs (ordsucc i) :e apply_fun Gfam beta.
                  claim Hi_nz : i :e nz.
                  { exact (ordinal_TransSet nz (nat_p_ordinal nz (omega_nat_p nz HnzO)) mz Hmz_nz i Hi). }
                  claim Hsi_nz : ordsucc i :e nz.
                  { exact (ordinal_TransSet nz (nat_p_ordinal nz (omega_nat_p nz HnzO)) mz Hmz_nz (ordsucc i) Hsi_mz). }
                  exact (Hredz_adj i Hi_nz Hsi_nz alpha beta HaJ HbJ Hzsi_Ga Hzssi_Gb). }
            (** Goal: (((reduced_word /\ ne0) /\ wp=zc) /\ mz_in_nz) left-associated **)
            prove ((reduced_word 2 Gfam efam mz ws_pne /\ (mz <> 0)) /\
              word_product mult e ws_pne mz = zc) /\ mz :e nz.
            apply andI.
            - prove (reduced_word 2 Gfam efam mz ws_pne /\ (mz <> 0)) /\
                word_product mult e ws_pne mz = zc.
              apply andI.
              + apply andI. exact Hred_ws. exact Hmz_ne0.
              + exact Hwp_ws_eq.
            - exact Hmz_in_nz. }
          claim Hex_short_word : exists nw ws:set,
            reduced_word 2 Gfam efam nw ws /\ nw <> 0 /\
            word_product mult e ws nw = zc /\ nw :e nz.
          { apply (xm (p = e)).
            - exact Hex_short_word_case_pe.
            - exact Hex_short_word_case_pne. }
          apply Hex_short_word. let nw.
          assume Hex_ws : exists ws:set,
            reduced_word 2 Gfam efam nw ws /\ nw <> 0 /\
            word_product mult e ws nw = zc /\ nw :e nz.
          apply Hex_ws. let ws.
          assume Hshort : reduced_word 2 Gfam efam nw ws /\ nw <> 0 /\
            word_product mult e ws nw = zc /\ nw :e nz.
          claim Hred_w : reduced_word 2 Gfam efam nw ws.
          { exact (andEL (reduced_word 2 Gfam efam nw ws) (nw <> 0)
              (andEL (reduced_word 2 Gfam efam nw ws /\ (nw <> 0))
                (word_product mult e ws nw = zc)
                (andEL ((reduced_word 2 Gfam efam nw ws /\ (nw <> 0)) /\
                  (word_product mult e ws nw = zc))
                  (nw :e nz) Hshort))). }
          claim Hnw_ne0 : nw <> 0.
          { exact (andER (reduced_word 2 Gfam efam nw ws) (nw <> 0)
              (andEL (reduced_word 2 Gfam efam nw ws /\ (nw <> 0))
                (word_product mult e ws nw = zc)
                (andEL ((reduced_word 2 Gfam efam nw ws /\ (nw <> 0)) /\
                  (word_product mult e ws nw = zc))
                  (nw :e nz) Hshort))). }
          claim Hwp_w : word_product mult e ws nw = zc.
          { exact (andER (reduced_word 2 Gfam efam nw ws /\ (nw <> 0))
              (word_product mult e ws nw = zc)
              (andEL ((reduced_word 2 Gfam efam nw ws /\ (nw <> 0)) /\
                (word_product mult e ws nw = zc))
                (nw :e nz) Hshort)). }
          claim Hnw_in_nz : nw :e nz.
          { exact (andER ((reduced_word 2 Gfam efam nw ws /\ (nw <> 0)) /\
              (word_product mult e ws nw = zc))
              (nw :e nz) Hshort). }
          claim Hnzc_eq_nw : nzc = nw.
          { exact (andEL (nzc = nw)
              (forall i:set, i :e nzc -> apply_fun xszc i = apply_fun ws i)
              (Huniq_zc nw ws Hred_w Hnw_ne0 Hwp_w)). }
          exact (eq_subst_mem nzc nw nz Hnzc_eq_nw Hnw_in_nz). }
        (** Apply IH **)
        claim HnzcO : nzc :e omega.
        { apply (and3E (nzc :e omega)
            (forall i:set, i :e nzc -> exists a:set, a :e 2 /\ apply_fun xszc i :e apply_fun Gfam a /\ apply_fun xszc i <> apply_fun efam a)
            (forall i:set, i :e nzc -> ordsucc i :e nzc ->
              forall a b:set, a :e 2 -> b :e 2 -> apply_fun xszc i :e apply_fun Gfam a -> apply_fun xszc (ordsucc i) :e apply_fun Gfam b -> a <> b)
            Hred_zc). assume HnO _ _. exact HnO. }
        claim Hnzc_in_k : nzc :e k.
        { (** nzc :e nz and nz :e ordsucc k **)
          (** nz :e ordsucc k means nz :e k or nz = k **)
          apply (ordsuccE k nz Hnz_bound).
          - assume Hnz_in_k : nz :e k.
            exact (ordinal_TransSet k (nat_p_ordinal k Hk_nat) nz Hnz_in_k nzc Hnzc_in_nz).
          - assume Hnz_eq_k : nz = k.
            exact (eq_subst_mem_set nzc nz k Hnzc_in_nz Hnz_eq_k). }
        claim Hzc_decomp : exists c0 y0:set,
          c0 :e G /\ (y0 :e G1 \/ y0 :e G2) /\
          (exists m:set, m :e omega /\ m <> 0 /\
            group_power_nat mult e y0 m = e) /\
          zc = apply_fun mult (apply_fun mult (c0, y0),
            apply_fun inv c0).
        { exact (HIH nzc Hnzc_in_k zc HzcG Hzcne Hzcfin
            nzc xszc Hred_zc Hnzc_ne0 Hwpzc Huniq_zc
            (ordsuccI2 nzc)). }
        set c0 := Eps_i (fun c0:set => exists y0:set,
          c0 :e G /\ (y0 :e G1 \/ y0 :e G2) /\
          (exists m:set, m :e omega /\ m <> 0 /\
            group_power_nat mult e y0 m = e) /\
          zc = apply_fun mult (apply_fun mult (c0, y0),
            apply_fun inv c0)).
        set y0 := Eps_i (fun y0:set =>
          c0 :e G /\ (y0 :e G1 \/ y0 :e G2) /\
          (exists m:set, m :e omega /\ m <> 0 /\
            group_power_nat mult e y0 m = e) /\
          zc = apply_fun mult (apply_fun mult (c0, y0),
            apply_fun inv c0)).
        claim Hc0y0_pack : c0 :e G /\ (y0 :e G1 \/ y0 :e G2) /\
          (exists m:set, m :e omega /\ m <> 0 /\
            group_power_nat mult e y0 m = e) /\
          zc = apply_fun mult (apply_fun mult (c0, y0),
            apply_fun inv c0).
        { exact (Eps_i_ex (fun y0:set =>
            c0 :e G /\ (y0 :e G1 \/ y0 :e G2) /\
            (exists m:set, m :e omega /\ m <> 0 /\
              group_power_nat mult e y0 m = e) /\
            zc = apply_fun mult (apply_fun mult (c0, y0),
              apply_fun inv c0))
            (Eps_i_ex (fun c0:set => exists y0:set,
              c0 :e G /\ (y0 :e G1 \/ y0 :e G2) /\
              (exists m:set, m :e omega /\ m <> 0 /\
                group_power_nat mult e y0 m = e) /\
              zc = apply_fun mult (apply_fun mult (c0, y0),
                apply_fun inv c0))
              Hzc_decomp)). }
        (** Construct final witnesses **)
        set cnew := apply_fun mult
          (apply_fun inv (apply_fun zs mz), c0).
        claim Hc0G : c0 :e G.
        { exact (andEL (c0 :e G) (y0 :e G1 \/ y0 :e G2)
            (andEL (c0 :e G /\ (y0 :e G1 \/ y0 :e G2))
              (exists m:set, m :e omega /\ m <> 0 /\
                group_power_nat mult e y0 m = e)
              (andEL ((c0 :e G /\ (y0 :e G1 \/ y0 :e G2)) /\
                (exists m:set, m :e omega /\ m <> 0 /\
                  group_power_nat mult e y0 m = e))
                (zc = apply_fun mult (apply_fun mult (c0, y0),
                  apply_fun inv c0))
                Hc0y0_pack))). }
        claim Hy0fac : y0 :e G1 \/ y0 :e G2.
        { exact (andER (c0 :e G) (y0 :e G1 \/ y0 :e G2)
            (andEL (c0 :e G /\ (y0 :e G1 \/ y0 :e G2))
              (exists m:set, m :e omega /\ m <> 0 /\
                group_power_nat mult e y0 m = e)
              (andEL ((c0 :e G /\ (y0 :e G1 \/ y0 :e G2)) /\
                (exists m:set, m :e omega /\ m <> 0 /\
                  group_power_nat mult e y0 m = e))
                (zc = apply_fun mult (apply_fun mult (c0, y0),
                  apply_fun inv c0))
                Hc0y0_pack))). }
        claim Hy0fin : exists m:set, m :e omega /\ m <> 0 /\
          group_power_nat mult e y0 m = e.
        { exact (andER (c0 :e G /\ (y0 :e G1 \/ y0 :e G2))
            (exists m:set, m :e omega /\ m <> 0 /\
              group_power_nat mult e y0 m = e)
            (andEL ((c0 :e G /\ (y0 :e G1 \/ y0 :e G2)) /\
              (exists m:set, m :e omega /\ m <> 0 /\
                group_power_nat mult e y0 m = e))
              (zc = apply_fun mult (apply_fun mult (c0, y0),
                apply_fun inv c0))
              Hc0y0_pack)). }
        witness cnew. witness y0.
        apply andI.
        - apply andI.
          + apply andI.
            * exact (HmultG (apply_fun inv (apply_fun zs mz)) c0
                Hinvzsmz_G Hc0G).
            * exact Hy0fac.
          + exact Hy0fin.
        - claim Hzc_eq : zc = apply_fun mult (apply_fun mult (c0, y0),
            apply_fun inv c0).
          { exact (andER ((c0 :e G /\ (y0 :e G1 \/ y0 :e G2)) /\
              (exists m:set, m :e omega /\ m <> 0 /\
                group_power_nat mult e y0 m = e))
              (zc = apply_fun mult (apply_fun mult (c0, y0),
                apply_fun inv c0))
              Hc0y0_pack). }
          claim Hy0G : y0 :e G.
          { apply (Hy0fac). - assume Hy0G1 : y0 :e G1.
              exact (Hsub_in_G 0 In_0_2 y0
                (eq_subst_mem_set y0 G1 (apply_fun Gfam 0) Hy0G1
                  (eq_symm (apply_fun Gfam 0) G1 HGfam0))).
            - assume Hy0G2 : y0 :e G2.
              exact (Hsub_in_G 1 In_1_2 y0
                (eq_subst_mem_set y0 G2 (apply_fun Gfam 1) Hy0G2
                  (eq_symm (apply_fun Gfam 1) G2 HGfam1))). }
          claim HinvcG : apply_fun inv c0 :e G. { exact (HinvG c0 Hc0G). }
          claim Hc0y0G : apply_fun mult (c0, y0) :e G. { exact (HmultG c0 y0 Hc0G Hy0G). }
          claim Hc0y0ic0G : apply_fun mult (apply_fun mult (c0, y0), apply_fun inv c0) :e G.
          { exact (HmultG (apply_fun mult (c0, y0)) (apply_fun inv c0) Hc0y0G HinvcG). }
          claim HinvcaG : apply_fun mult (apply_fun inv c0, apply_fun zs mz) :e G.
          { exact (HmultG (apply_fun inv c0) (apply_fun zs mz) HinvcG Hzsmz_G). }
          prove z = apply_fun mult (apply_fun mult (cnew, y0), apply_fun inv cnew).
          claim Hinv_cnew : apply_fun inv cnew =
            apply_fun mult (apply_fun inv c0, apply_fun zs mz).
          { claim Hinv_prod : apply_fun inv (apply_fun mult (apply_fun inv (apply_fun zs mz), c0)) =
              apply_fun mult (apply_fun inv c0, apply_fun inv (apply_fun inv (apply_fun zs mz))).
            { exact (group_inv_mult G mult e inv (apply_fun inv (apply_fun zs mz)) c0
                Hgrp Hinvzsmz_G Hc0G). }
            claim Hinv_inv_a : apply_fun inv (apply_fun inv (apply_fun zs mz)) = apply_fun zs mz.
            { exact (group_inv_inv G mult inv e (apply_fun zs mz) HmultF HinvF HeG Hassoc Hid Hinverse Hzsmz_G). }
            claim Hstep2 : apply_fun mult (apply_fun inv c0, apply_fun inv (apply_fun inv (apply_fun zs mz))) =
              apply_fun mult (apply_fun inv c0, apply_fun zs mz).
            { rewrite Hinv_inv_a. reflexivity. }
            exact (eq_i_tra (apply_fun inv cnew)
              (apply_fun mult (apply_fun inv c0, apply_fun inv (apply_fun inv (apply_fun zs mz))))
              (apply_fun mult (apply_fun inv c0, apply_fun zs mz))
              Hinv_prod
              Hstep2). }
          rewrite Hinv_cnew.
          claim Hy0G : y0 :e G.
          { apply (Hy0fac). - assume Hy0G1 : y0 :e G1.
              exact (Hsub_in_G 0 In_0_2 y0
                (eq_subst_mem_set y0 G1 (apply_fun Gfam 0) Hy0G1
                  (eq_symm (apply_fun Gfam 0) G1 HGfam0))).
            - assume Hy0G2 : y0 :e G2.
              exact (Hsub_in_G 1 In_1_2 y0
                (eq_subst_mem_set y0 G2 (apply_fun Gfam 1) Hy0G2
                  (eq_symm (apply_fun Gfam 1) G2 HGfam1))). }
          claim HinvcG : apply_fun inv c0 :e G. { exact (HinvG c0 Hc0G). }
          claim Hc0y0G : apply_fun mult (c0, y0) :e G. { exact (HmultG c0 y0 Hc0G Hy0G). }
          claim HinvcaG : apply_fun mult (apply_fun inv c0, apply_fun zs mz) :e G.
          { exact (HmultG (apply_fun inv c0) (apply_fun zs mz) HinvcG Hzsmz_G). }
          claim Hass_a : apply_fun mult (cnew, y0) =
            apply_fun mult (apply_fun inv (apply_fun zs mz), apply_fun mult (c0, y0)).
          { exact (Hassoc (apply_fun inv (apply_fun zs mz)) c0 y0 Hinvzsmz_G Hc0G Hy0G). }
          rewrite Hass_a.
          claim Hass_b : apply_fun mult (apply_fun mult (apply_fun inv (apply_fun zs mz),
            apply_fun mult (c0, y0)), apply_fun mult (apply_fun inv c0, apply_fun zs mz)) =
            apply_fun mult (apply_fun inv (apply_fun zs mz), apply_fun mult (
              apply_fun mult (c0, y0), apply_fun mult (apply_fun inv c0, apply_fun zs mz))).
          { exact (Hassoc (apply_fun inv (apply_fun zs mz)) (apply_fun mult (c0, y0))
              (apply_fun mult (apply_fun inv c0, apply_fun zs mz)) Hinvzsmz_G Hc0y0G HinvcaG). }
          rewrite Hass_b.
          claim Hass_c : apply_fun mult (apply_fun mult (c0, y0),
            apply_fun mult (apply_fun inv c0, apply_fun zs mz)) =
            apply_fun mult (apply_fun mult (apply_fun mult (c0, y0), apply_fun inv c0),
              apply_fun zs mz).
          { symmetry. exact (Hassoc (apply_fun mult (c0, y0)) (apply_fun inv c0)
              (apply_fun zs mz) Hc0y0G HinvcG Hzsmz_G). }
          rewrite Hass_c.
          claim Hass_d : apply_fun mult (apply_fun inv (apply_fun zs mz),
            apply_fun mult (apply_fun mult (apply_fun mult (c0, y0), apply_fun inv c0),
              apply_fun zs mz)) =
            apply_fun mult (apply_fun mult (apply_fun inv (apply_fun zs mz),
              apply_fun mult (apply_fun mult (c0, y0), apply_fun inv c0)), apply_fun zs mz).
          { symmetry. exact (Hassoc (apply_fun inv (apply_fun zs mz))
              (apply_fun mult (apply_fun mult (c0, y0), apply_fun inv c0))
              (apply_fun zs mz) Hinvzsmz_G
              (HmultG (apply_fun mult (c0, y0)) (apply_fun inv c0) Hc0y0G HinvcG) Hzsmz_G). }
          rewrite Hass_d.
          claim Hzc_eq : zc = apply_fun mult (apply_fun mult (c0, y0), apply_fun inv c0).
          { exact (andER ((c0 :e G /\ (y0 :e G1 \/ y0 :e G2)) /\
              (exists m:set, m :e omega /\ m <> 0 /\
                group_power_nat mult e y0 m = e))
              (zc = apply_fun mult (apply_fun mult (c0, y0),
                apply_fun inv c0))
              Hc0y0_pack). }
          claim Hzc_eq_sym : apply_fun mult (apply_fun mult (c0, y0), apply_fun inv c0) = zc.
          { symmetry. exact Hzc_eq. }
          rewrite Hzc_eq_sym.
          exact Hz_conj.
      + assume Haf_nal : alpha_first <> alpha_last.
        (** Cyclically reduced: infinite order, contradiction **)
        prove False.
        (** Extract m0 from Hzfin **)
        apply Hzfin. let m0.
        assume Hm0_pack : m0 :e omega /\ m0 <> 0 /\ group_power_nat mult e z m0 = e.
        apply (and3E (m0 :e omega) (m0 <> 0) (group_power_nat mult e z m0 = e) Hm0_pack).
        assume Hm0O Hm0ne0 Hzm0e.
        claim Hm0_nat : nat_p m0. { exact (omega_nat_p m0 Hm0O). }
        (** Boundary condition: zs(mz) and zs(0) are in different factors **)
        claim Hboundary_cyc : forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
          apply_fun zs mz :e apply_fun Gfam alpha ->
          apply_fun zs 0 :e apply_fun Gfam beta ->
          alpha <> beta.
        { let alpha beta. assume HaJ HbJ Ha_in Hb_in.
          assume Hab : alpha = beta.
          (** If alpha = alpha_last: then beta = alpha_last = alpha. **)
          (** Since alpha = beta and zs(0) :e Gfam(beta) = Gfam(alpha) = Gfam(alpha_last) **)
          (** And zs(mz) :e Gfam(alpha_last), so both in same factor **)
          (** But then alpha_first = alpha_last (via factor uniqueness from disjointness), contradiction **)
          apply (xm (alpha = alpha_last)).
          - assume Ha_al : alpha = alpha_last.
            (** beta = alpha since alpha = beta, so beta = alpha_last **)
            (** zs(0) :e Gfam(beta) = Gfam(alpha_last), and zs(0) :e Gfam(alpha_first) **)
            (** If alpha_first <> alpha_last, disjointness gives zs(0) = e, contradiction **)
            apply (xm (alpha_first = alpha_last)).
            + assume Haf_eq_al : alpha_first = alpha_last.
              exact (Haf_nal Haf_eq_al).
            + assume Haf_nel : alpha_first <> alpha_last.
              claim Hzs0_Gal : apply_fun zs 0 :e apply_fun Gfam alpha_last.
              { claim Hb_al : beta = alpha_last.
                { exact (eq_i_tra beta alpha alpha_last (eq_symm alpha beta Hab) Ha_al). }
                exact (eq_subst_mem_set (apply_fun zs 0) (apply_fun Gfam beta) (apply_fun Gfam alpha_last)
                  Hb_in (apply_fun_congr_arg Gfam beta alpha_last Hb_al)). }
              claim Hzs0_e : apply_fun zs 0 = e.
              { exact (Hdisjoint alpha_first alpha_last Haf_J Hal_J Haf_nel (apply_fun zs 0) Hzs0_Gaf Hzs0_Gal). }
              claim Hzs0_ne : apply_fun zs 0 <> apply_fun efam alpha_first.
              { exact (andER (alpha_first :e 2 /\ apply_fun zs 0 :e apply_fun Gfam alpha_first)
                  (apply_fun zs 0 <> apply_fun efam alpha_first) Haf_pack). }
              claim Hefam_af : apply_fun efam alpha_first = e. { exact (Hefam_e alpha_first Haf_J). }
              claim Hzs0_ne_e : apply_fun zs 0 <> e. { rewrite <- Hefam_af. exact Hzs0_ne. }
              exact (Hzs0_ne_e Hzs0_e).
          - assume Ha_nal : alpha <> alpha_last.
            claim Hzsmz_e : apply_fun zs mz = e.
            { exact (Hdisjoint alpha alpha_last HaJ Hal_J Ha_nal (apply_fun zs mz) Ha_in Hzsmz_Gal). }
            claim Hzsmz_ne : apply_fun zs mz <> apply_fun efam alpha_last.
            { exact (andER (alpha_last :e 2 /\ apply_fun zs mz :e apply_fun Gfam alpha_last)
                (apply_fun zs mz <> apply_fun efam alpha_last) Hal_pack). }
            claim Hefam_al : apply_fun efam alpha_last = e. { exact (Hefam_e alpha_last Hal_J). }
            claim Hzsmz_ne_e : apply_fun zs mz <> e. { rewrite <- Hefam_al. exact Hzsmz_ne. }
            exact (Hzsmz_ne_e Hzsmz_e). }
        set R := (fun k:set =>
          k <> 0 ->
          exists ys_k:set,
            reduced_word 2 Gfam efam (mul_nat k nz) ys_k /\
            word_product mult e ys_k (mul_nat k nz) = group_power_nat mult e z k /\
            apply_fun ys_k 0 = apply_fun zs 0 /\
            (exists mk:set, nat_p mk /\ mul_nat k nz = ordsucc mk /\
              apply_fun ys_k mk = apply_fun zs mz)).
        claim Hpow_red : forall k:set, nat_p k -> R k.
        { apply (nat_ind R).
          - (** k = 0: vacuously true **)
            assume H0ne : 0 <> 0. exact (FalseE (H0ne (eq_refl 0))
              (exists ys_k:set, reduced_word 2 Gfam efam (mul_nat 0 nz) ys_k /\
                word_product mult e ys_k (mul_nat 0 nz) = group_power_nat mult e z 0 /\
                apply_fun ys_k 0 = apply_fun zs 0 /\
                (exists mk:set, nat_p mk /\ mul_nat 0 nz = ordsucc mk /\
                  apply_fun ys_k mk = apply_fun zs mz))).
          - (** k -> k+1 **)
            let k. assume Hk_nat IH.
            prove R (ordsucc k).
            assume Hsk_ne0 : ordsucc k <> 0.
            apply (xm (k = 0)).
            + assume Hk0 : k = 0.
              (** k+1 = 1, so z^1 = z with reduced word (nz, zs) **)
              claim Hlen : mul_nat (ordsucc k) nz = nz.
              { rewrite Hk0.
                claim H1_nat : nat_p 1. { exact (nat_ordsucc 0 nat_0). }
                claim Hcom : mul_nat 1 nz = mul_nat nz 1.
                { exact (mul_nat_com 1 H1_nat nz Hnz_nat). }
                exact (eq_i_tra (mul_nat 1 nz) (mul_nat nz 1) nz Hcom (mul_nat_1R nz)). }
              witness zs.
              apply and4I.
              * rewrite Hlen. exact Hredz.
              * rewrite Hlen.
                claim Hgp1 : group_power_nat mult e z (ordsucc k) =
                  apply_fun mult (z, group_power_nat mult e z k).
                { exact (nat_primrec_S e (fun _ r:set => apply_fun mult (z, r)) k Hk_nat). }
                claim Hgp0 : group_power_nat mult e z k = e.
                { rewrite Hk0. exact (nat_primrec_0 e (fun _ r:set => apply_fun mult (z, r))). }
                claim Hz1 : group_power_nat mult e z (ordsucc k) = apply_fun mult (z, e).
                { rewrite Hgp1. rewrite Hgp0. reflexivity. }
                claim Hze : apply_fun mult (z, e) = z.
                { exact (andER (apply_fun mult (e, z) = z) (apply_fun mult (z, e) = z) (Hid z HzG)). }
                claim Hz1z : group_power_nat mult e z (ordsucc k) = z.
                { exact (eq_i_tra (group_power_nat mult e z (ordsucc k))
                    (apply_fun mult (z, e)) z Hz1 Hze). }
                claim Hwpz_sym : z = word_product mult e zs nz.
                { symmetry. exact Hwpz. }
                exact (eq_i_tra (word_product mult e zs nz)
                  z (group_power_nat mult e z (ordsucc k))
                  Hwpz (eq_symm (group_power_nat mult e z (ordsucc k)) z Hz1z)).
              * reflexivity.
              * witness mz. apply and3I.
                { exact Hmz_nat. }
                { rewrite Hlen. exact Hnz_eq. }
                { reflexivity. }
            + assume Hk_ne0 : k <> 0.
              (** IH gives reduced word for z^k **)
              apply (IH Hk_ne0). let ys_k.
              assume Hyk_pack :
                reduced_word 2 Gfam efam (mul_nat k nz) ys_k /\
                word_product mult e ys_k (mul_nat k nz) = group_power_nat mult e z k /\
                apply_fun ys_k 0 = apply_fun zs 0 /\
                (exists mk:set, nat_p mk /\ mul_nat k nz = ordsucc mk /\
                  apply_fun ys_k mk = apply_fun zs mz).
              apply (and4E
                (reduced_word 2 Gfam efam (mul_nat k nz) ys_k)
                (word_product mult e ys_k (mul_nat k nz) = group_power_nat mult e z k)
                (apply_fun ys_k 0 = apply_fun zs 0)
                (exists mk:set, nat_p mk /\ mul_nat k nz = ordsucc mk /\
                  apply_fun ys_k mk = apply_fun zs mz)
                Hyk_pack).
              assume Hred_yk Hwp_yk Hfirst_yk Hlast_ex.
              (** Get mk from last element **)
              apply Hlast_ex. let mk.
              assume Hmk_pack : nat_p mk /\ mul_nat k nz = ordsucc mk /\ apply_fun ys_k mk = apply_fun zs mz.
              apply (and3E (nat_p mk) (mul_nat k nz = ordsucc mk) (apply_fun ys_k mk = apply_fun zs mz) Hmk_pack).
              assume Hmk_nat Hknz_smk Hyk_last.
              (** mul_nat k nz <> 0 **)
              claim Hknz_ne0 : mul_nat k nz <> 0. { rewrite Hknz_smk. exact (neq_ordsucc_0 mk). }
              claim Hknz_nat : nat_p (mul_nat k nz). { exact (mul_nat_p k Hk_nat nz Hnz_nat). }
              (** Boundary: zs(mz) :e Gfam(alpha_last), ys_k(0) = zs(0) :e Gfam(alpha_first), diff factors **)
              claim Hbnd_concat : forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
                apply_fun zs mz :e apply_fun Gfam alpha ->
                apply_fun ys_k 0 :e apply_fun Gfam beta ->
                alpha <> beta.
              { let alpha beta. assume HaJ HbJ Ha_in Hb_in.
                claim Hb2 : apply_fun zs 0 :e apply_fun Gfam beta.
                { rewrite <- Hfirst_yk. exact Hb_in. }
                exact (Hboundary_cyc alpha beta HaJ HbJ Ha_in Hb2). }
              apply (reduced_word_concat_agree G mult e inv 2 Gfam efam
                nz zs (mul_nat k nz) ys_k mz
                Hgrp Hsubfam Hredz Hred_yk Hnz_ne0 Hknz_ne0 Hmz_nat Hnz_eq Hbnd_concat).
              let ys_new.
              assume Hynew_pack :
                reduced_word 2 Gfam efam (add_nat nz (mul_nat k nz)) ys_new /\
                word_product mult e ys_new (add_nat nz (mul_nat k nz)) =
                  apply_fun mult (word_product mult e zs nz, word_product mult e ys_k (mul_nat k nz)) /\
                (forall t:set, nat_p t -> mul_nat k nz = ordsucc t ->
                  apply_fun ys_new (add_nat nz t) = apply_fun ys_k t) /\
                (forall i:set, i :e nz -> apply_fun ys_new i = apply_fun zs i).
              apply (and4E
                (reduced_word 2 Gfam efam (add_nat nz (mul_nat k nz)) ys_new)
                (word_product mult e ys_new (add_nat nz (mul_nat k nz)) =
                  apply_fun mult (word_product mult e zs nz, word_product mult e ys_k (mul_nat k nz)))
                (forall t:set, nat_p t -> mul_nat k nz = ordsucc t ->
                  apply_fun ys_new (add_nat nz t) = apply_fun ys_k t)
                (forall i:set, i :e nz -> apply_fun ys_new i = apply_fun zs i)
                Hynew_pack).
              assume Hred_new Hwp_new Hlast_new Hagree_new.
              (** Length equation **)
              claim Hlen_eq : add_nat nz (mul_nat k nz) = mul_nat (ordsucc k) nz.
              { claim Hsl : mul_nat (ordsucc k) nz = add_nat (mul_nat k nz) nz.
                { exact (mul_nat_SL k Hk_nat nz Hnz_nat). }
                claim Hcom : add_nat nz (mul_nat k nz) = add_nat (mul_nat k nz) nz.
                { exact (add_nat_com nz Hnz_nat (mul_nat k nz) Hknz_nat). }
                exact (eq_i_tra (add_nat nz (mul_nat k nz))
                  (add_nat (mul_nat k nz) nz)
                  (mul_nat (ordsucc k) nz)
                  Hcom (eq_symm (mul_nat (ordsucc k) nz) (add_nat (mul_nat k nz) nz) Hsl)). }
              witness ys_new.
              apply and4I.
              * (** reduced_word **)
                rewrite <- Hlen_eq. exact Hred_new.
              * (** word product **)
                rewrite <- Hlen_eq.
                claim Hgp_sk : group_power_nat mult e z (ordsucc k) =
                  apply_fun mult (z, group_power_nat mult e z k).
                { exact (nat_primrec_S e (fun _ r:set => apply_fun mult (z, r)) k Hk_nat). }
                claim Hwp_eq : word_product mult e ys_new (add_nat nz (mul_nat k nz)) =
                  apply_fun mult (z, group_power_nat mult e z k).
                { rewrite Hwp_new. rewrite Hwpz. rewrite Hwp_yk. reflexivity. }
                claim Hgp_sk_sym : apply_fun mult (z, group_power_nat mult e z k) =
                  group_power_nat mult e z (ordsucc k).
                { symmetry. exact Hgp_sk. }
                exact (eq_i_tra
                  (word_product mult e ys_new (add_nat nz (mul_nat k nz)))
                  (apply_fun mult (z, group_power_nat mult e z k))
                  (group_power_nat mult e z (ordsucc k))
                  Hwp_eq Hgp_sk_sym).
              * (** first element = zs(0) **)
                exact (Hagree_new 0 H0_nz).
              * (** last element = zs(mz) **)
                (** Last element of ys_new at index add_nat nz mk = ys_k(mk) = zs(mz) **)
                witness (add_nat nz mk).
                apply and3I.
                { exact (add_nat_p nz Hnz_nat mk Hmk_nat). }
                { claim Hsk_nz : mul_nat (ordsucc k) nz = add_nat (mul_nat k nz) nz.
                  { exact (mul_nat_SL k Hk_nat nz Hnz_nat). }
                  claim Hcom : add_nat (mul_nat k nz) nz = add_nat nz (mul_nat k nz).
                  { exact (add_nat_com (mul_nat k nz) Hknz_nat nz Hnz_nat). }
                  claim Hadd_smk : add_nat nz (mul_nat k nz) = ordsucc (add_nat nz mk).
                  { rewrite Hknz_smk. exact (add_nat_SR nz mk Hmk_nat). }
                  exact (eq_i_tra (mul_nat (ordsucc k) nz)
                    (add_nat nz (mul_nat k nz))
                    (ordsucc (add_nat nz mk))
                    (eq_i_tra (mul_nat (ordsucc k) nz) (add_nat (mul_nat k nz) nz) (add_nat nz (mul_nat k nz))
                      Hsk_nz Hcom)
                    Hadd_smk). }
                { claim Hynew_mk : apply_fun ys_new (add_nat nz mk) = apply_fun ys_k mk.
                  { exact (Hlast_new mk Hmk_nat Hknz_smk). }
                  exact (eq_i_tra (apply_fun ys_new (add_nat nz mk)) (apply_fun ys_k mk) (apply_fun zs mz)
                    Hynew_mk Hyk_last). }
        }
        (** Apply the induction result to m0 **)
        apply (Hpow_red m0 Hm0_nat Hm0ne0). let ys_m0.
        assume Hym0_pack :
          reduced_word 2 Gfam efam (mul_nat m0 nz) ys_m0 /\
          word_product mult e ys_m0 (mul_nat m0 nz) = group_power_nat mult e z m0 /\
          apply_fun ys_m0 0 = apply_fun zs 0 /\
          (exists mk:set, nat_p mk /\ mul_nat m0 nz = ordsucc mk /\
            apply_fun ys_m0 mk = apply_fun zs mz).
        apply (and4E
          (reduced_word 2 Gfam efam (mul_nat m0 nz) ys_m0)
          (word_product mult e ys_m0 (mul_nat m0 nz) = group_power_nat mult e z m0)
          (apply_fun ys_m0 0 = apply_fun zs 0)
          (exists mk:set, nat_p mk /\ mul_nat m0 nz = ordsucc mk /\
            apply_fun ys_m0 mk = apply_fun zs mz)
          Hym0_pack).
        assume Hred_m0 Hwp_m0 _ Hlast_m0_ex.
        (** z^m0 = e but word_product = z^m0 <> e since length >= 2 **)
        (** mul_nat m0 nz <> 0 and <> 1 since m0 >= 1, nz >= 2 **)
        apply Hlast_m0_ex. let mk_m0.
        assume Hmk_m0_pack : nat_p mk_m0 /\ mul_nat m0 nz = ordsucc mk_m0 /\
          apply_fun ys_m0 mk_m0 = apply_fun zs mz.
        claim Hmk_m0_AB : nat_p mk_m0 /\ mul_nat m0 nz = ordsucc mk_m0.
        { exact (andEL (nat_p mk_m0 /\ mul_nat m0 nz = ordsucc mk_m0)
            (apply_fun ys_m0 mk_m0 = apply_fun zs mz) Hmk_m0_pack). }
        claim Hmknz_eq : mul_nat m0 nz = ordsucc mk_m0.
        { exact (andER (nat_p mk_m0) (mul_nat m0 nz = ordsucc mk_m0) Hmk_m0_AB). }
        claim Hm0nz_ne0 : mul_nat m0 nz <> 0.
        { rewrite Hmknz_eq. exact (neq_ordsucc_0 mk_m0). }
        (** mul_nat m0 nz >= nz >= 2, so <> 1 **)
        (** nz >= 2 means 1 :e nz **)
        claim H1_nz : 1 :e nz.
        { apply (nat_inv nz Hnz_nat).
          - assume Hnz0. exact (FalseE (Hnz_ne0 Hnz0) (1 :e nz)).
          - assume Hex_p : exists p:set, nat_p p /\ nz = ordsucc p.
            apply Hex_p. let p. assume Hp_pack : nat_p p /\ nz = ordsucc p.
            claim Hp_nat : nat_p p. { exact (andEL (nat_p p) (nz = ordsucc p) Hp_pack). }
            claim Hnz_sp : nz = ordsucc p. { exact (andER (nat_p p) (nz = ordsucc p) Hp_pack). }
            apply (nat_inv p Hp_nat).
            + assume Hp0 : p = 0.
              claim Hnz1 : nz = 1. { rewrite Hnz_sp. rewrite Hp0. reflexivity. }
              exact (FalseE (Hnz_ne1 Hnz1) (1 :e nz)).
            + assume Hex_q : exists q:set, nat_p q /\ p = ordsucc q.
              apply Hex_q. let q. assume Hq_pack : nat_p q /\ p = ordsucc q.
              claim Hq_nat : nat_p q. { exact (andEL (nat_p q) (p = ordsucc q) Hq_pack). }
              rewrite Hnz_sp. rewrite (andER (nat_p q) (p = ordsucc q) Hq_pack).
              exact (nat_ordsucc_in_ordsucc (ordsucc q) (nat_ordsucc q Hq_nat) 0
                (nat_0_in_ordsucc q Hq_nat)). }
        (** nz c= m0 nz (since m0 >= 1) **)
        claim Hm0nz_nat : nat_p (mul_nat m0 nz). { exact (mul_nat_p m0 Hm0_nat nz Hnz_nat). }
        claim Hnz_sub_m0nz : nz c= mul_nat m0 nz.
        { claim H1_nat : nat_p 1. { exact (nat_ordsucc 0 nat_0). }
          claim Hm1l : mul_nat 1 nz = nz.
          { claim Hcom : mul_nat 1 nz = mul_nat nz 1.
            { exact (mul_nat_com 1 H1_nat nz Hnz_nat). }
            exact (eq_i_tra (mul_nat 1 nz) (mul_nat nz 1) nz Hcom (mul_nat_1R nz)). }
          claim H1_sub_m0 : 1 c= m0.
          { apply (nat_inv m0 Hm0_nat).
            - assume Hm00. exact (FalseE (Hm0ne0 Hm00) (1 c= m0)).
            - assume Hex : exists p:set, nat_p p /\ m0 = ordsucc p.
              apply Hex. let p. assume Hp_pack : nat_p p /\ m0 = ordsucc p.
              rewrite (andER (nat_p p) (m0 = ordsucc p) Hp_pack).
              let i. assume Hi : i :e 1.
              apply (ordsuccE 0 i Hi).
              + assume Hi0 : i :e 0. exact (FalseE (EmptyE i Hi0) (i :e ordsucc p)).
              + assume Hi_eq : i = 0. rewrite Hi_eq. exact (nat_0_in_ordsucc p (andEL (nat_p p) (m0 = ordsucc p) Hp_pack)). }
          claim Hmul_sub : mul_nat 1 nz c= mul_nat m0 nz.
          { exact (mul_nat_Subq_R 1 m0 H1_nat Hm0_nat H1_sub_m0 nz Hnz_nat). }
          let i. assume Hi. exact (Hmul_sub i (eq_subst_mem_set i nz (mul_nat 1 nz) Hi (eq_symm (mul_nat 1 nz) nz Hm1l))). }
        claim H1_m0nz : 1 :e mul_nat m0 nz.
        { exact (Hnz_sub_m0nz 1 H1_nz). }
        claim Hm0nz_ne1 : mul_nat m0 nz <> 1.
        { assume Hm0nz1 : mul_nat m0 nz = 1.
          claim H1_1 : 1 :e 1.
          { exact (eq_subst_mem_set 1 (mul_nat m0 nz) 1 H1_m0nz Hm0nz1). }
          exact (In_irref 1 H1_1). }
        claim Hwpm0_ne_e : word_product mult e ys_m0 (mul_nat m0 nz) <> e.
        { exact (free_product_reduced_word_length_ge2_product_ne_e
            G mult e inv 2 Gfam efam (mul_nat m0 nz) ys_m0
            Hfp Hred_m0 Hm0nz_ne0 Hm0nz_ne1). }
        claim Hwpm0_e : word_product mult e ys_m0 (mul_nat m0 nz) = e.
        { exact (eq_i_tra (word_product mult e ys_m0 (mul_nat m0 nz))
            (group_power_nat mult e z m0) e Hwp_m0 Hzm0e). }
        exact (Hwpm0_ne_e Hwpm0_e).
  }
  (** Apply the main claim to x **)
  claim Hnx_nat : nat_p nx.
  { apply (and3E (nx :e omega)
      (forall i:set, i :e nx -> exists a:set, a :e 2 /\ apply_fun xs i :e apply_fun Gfam a /\ apply_fun xs i <> apply_fun efam a)
      (forall i:set, i :e nx -> ordsucc i :e nx ->
        forall a b:set, a :e 2 -> b :e 2 -> apply_fun xs i :e apply_fun Gfam a -> apply_fun xs (ordsucc i) :e apply_fun Gfam b -> a <> b)
      Hred). assume HnO _ _. exact (omega_nat_p nx HnO). }
  exact (Hmain nx Hnx_nat x HxG Hxne Hfin nx xs Hred Hnx_ne0 Hwp Huniq_x (ordsuccI2 nx)).
Qed.

(** Helper: word_product of elements in G stays in G **)
Lemma word_product_in_G : forall mult e G n xs:set,
  e :e G ->
  (forall x y:set, x :e G -> y :e G -> apply_fun mult (x, y) :e G) ->
  n :e omega ->
  (forall i:set, i :e n -> apply_fun xs i :e G) ->
  word_product mult e xs n :e G.
let mult e G.
claim Hnat : forall n:set, nat_p n ->
  forall xs:set,
  e :e G ->
  (forall x y:set, x :e G -> y :e G -> apply_fun mult (x, y) :e G) ->
  (forall i:set, i :e n -> apply_fun xs i :e G) ->
  word_product mult e xs n :e G.
{
  apply nat_ind.
  - let xs. assume HeG : e :e G.
    assume Hmcl : forall x y:set, x :e G -> y :e G -> apply_fun mult (x, y) :e G.
    assume Hxs : forall i:set, i :e 0 -> apply_fun xs i :e G.
    claim H0 : word_product mult e xs 0 = e.
    { exact (nat_primrec_0 e (fun j r => apply_fun mult (r, apply_fun xs j))). }
    rewrite H0. exact HeG.
  - let k. assume Hk : nat_p k.
    assume IH : forall xs:set,
      e :e G ->
      (forall x y:set, x :e G -> y :e G -> apply_fun mult (x, y) :e G) ->
      (forall i:set, i :e k -> apply_fun xs i :e G) ->
      word_product mult e xs k :e G.
    let xs. assume HeG : e :e G.
    assume Hmcl : forall x y:set, x :e G -> y :e G -> apply_fun mult (x, y) :e G.
    assume Hxs : forall i:set, i :e ordsucc k -> apply_fun xs i :e G.
    claim Hxs_k : forall i:set, i :e k -> apply_fun xs i :e G.
    { let i. assume Hik : i :e k. exact (Hxs i (ordsuccI1 k i Hik)). }
    claim Hwp_k : word_product mult e xs k :e G.
    { exact (IH xs HeG Hmcl Hxs_k). }
    claim Hxsk : apply_fun xs k :e G.
    { exact (Hxs k (ordsuccI2 k)). }
    claim HS : word_product mult e xs (ordsucc k) =
      apply_fun mult (word_product mult e xs k, apply_fun xs k).
    { exact (nat_primrec_S e (fun j r => apply_fun mult (r, apply_fun xs j)) k Hk). }
    rewrite HS. exact (Hmcl (word_product mult e xs k) (apply_fun xs k) Hwp_k Hxsk).
}
let n xs. assume HeG Hmcl. assume Hn : n :e omega. assume Hxs.
exact (Hnat n (omega_nat_p n Hn) xs HeG Hmcl Hxs).
Qed.

(** Helper: prepending an element g to a word product **)
(** word_product [g, xs(0), ..., xs(n-1)] (ordsucc n) = mult(g, word_product xs n) **)
Lemma word_product_prepend : forall mult e G n xs vs:set,
  e :e G ->
  (forall x:set, x :e G -> apply_fun mult (e, x) = x /\ apply_fun mult (x, e) = x) ->
  (forall x y:set, x :e G -> y :e G -> apply_fun mult (x, y) :e G) ->
  (forall x y z:set, x :e G -> y :e G -> z :e G ->
    apply_fun mult (apply_fun mult (x, y), z) = apply_fun mult (x, apply_fun mult (y, z))) ->
  apply_fun vs 0 :e G ->
  n :e omega ->
  (forall i:set, i :e n -> apply_fun xs i :e G) ->
  (forall i:set, i :e n -> apply_fun vs (ordsucc i) = apply_fun xs i) ->
  word_product mult e vs (ordsucc n) = apply_fun mult (apply_fun vs 0, word_product mult e xs n).
let mult e G.
claim Hnat : forall n:set, nat_p n ->
  forall xs vs:set,
  e :e G ->
  (forall x:set, x :e G -> apply_fun mult (e, x) = x /\ apply_fun mult (x, e) = x) ->
  (forall x y:set, x :e G -> y :e G -> apply_fun mult (x, y) :e G) ->
  (forall x y z:set, x :e G -> y :e G -> z :e G ->
    apply_fun mult (apply_fun mult (x, y), z) = apply_fun mult (x, apply_fun mult (y, z))) ->
  apply_fun vs 0 :e G ->
  (forall i:set, i :e n -> apply_fun xs i :e G) ->
  (forall i:set, i :e n -> apply_fun vs (ordsucc i) = apply_fun xs i) ->
  word_product mult e vs (ordsucc n) = apply_fun mult (apply_fun vs 0, word_product mult e xs n).
{
  apply nat_ind.
  - (** Base: n = 0 **)
    let xs vs.
    assume HeG : e :e G.
    assume Hid : forall x:set, x :e G -> apply_fun mult (e, x) = x /\ apply_fun mult (x, e) = x.
    assume Hmcl : forall x y:set, x :e G -> y :e G -> apply_fun mult (x, y) :e G.
    assume Hassoc : forall x y z:set, x :e G -> y :e G -> z :e G ->
      apply_fun mult (apply_fun mult (x, y), z) = apply_fun mult (x, apply_fun mult (y, z)).
    assume Hvs0G : apply_fun vs 0 :e G.
    assume Hxs_mem : forall i:set, i :e 0 -> apply_fun xs i :e G.
    assume Hvs_shift : forall i:set, i :e 0 -> apply_fun vs (ordsucc i) = apply_fun xs i.
    claim Hwp_vs_1 : word_product mult e vs (ordsucc 0) =
      apply_fun mult (word_product mult e vs 0, apply_fun vs 0).
    { exact (nat_primrec_S e (fun j r => apply_fun mult (r, apply_fun vs j)) 0 nat_0). }
    claim Hwp_vs_0 : word_product mult e vs 0 = e.
    { exact (nat_primrec_0 e (fun j r => apply_fun mult (r, apply_fun vs j))). }
    claim Hwp_xs_0 : word_product mult e xs 0 = e.
    { exact (nat_primrec_0 e (fun j r => apply_fun mult (r, apply_fun xs j))). }
    claim LHS_eq : word_product mult e vs 1 = apply_fun mult (e, apply_fun vs 0).
    { rewrite Hwp_vs_1. rewrite Hwp_vs_0. reflexivity. }
    claim LHS_simp : apply_fun mult (e, apply_fun vs 0) = apply_fun vs 0.
    { exact (andEL
        (apply_fun mult (e, apply_fun vs 0) = apply_fun vs 0)
        (apply_fun mult (apply_fun vs 0, e) = apply_fun vs 0)
        (Hid (apply_fun vs 0) Hvs0G)). }
    claim RHS_simp : apply_fun mult (apply_fun vs 0, e) = apply_fun vs 0.
    { exact (andER
        (apply_fun mult (e, apply_fun vs 0) = apply_fun vs 0)
        (apply_fun mult (apply_fun vs 0, e) = apply_fun vs 0)
        (Hid (apply_fun vs 0) Hvs0G)). }
    rewrite LHS_eq. rewrite LHS_simp. rewrite Hwp_xs_0. rewrite RHS_simp. reflexivity.
  - (** Step: n = ordsucc k, assuming for k **)
    let k. assume Hk : nat_p k.
    assume IH : forall xs vs:set,
      e :e G ->
      (forall x:set, x :e G -> apply_fun mult (e, x) = x /\ apply_fun mult (x, e) = x) ->
      (forall x y:set, x :e G -> y :e G -> apply_fun mult (x, y) :e G) ->
      (forall x y z:set, x :e G -> y :e G -> z :e G ->
        apply_fun mult (apply_fun mult (x, y), z) = apply_fun mult (x, apply_fun mult (y, z))) ->
      apply_fun vs 0 :e G ->
      (forall i:set, i :e k -> apply_fun xs i :e G) ->
      (forall i:set, i :e k -> apply_fun vs (ordsucc i) = apply_fun xs i) ->
      word_product mult e vs (ordsucc k) = apply_fun mult (apply_fun vs 0, word_product mult e xs k).
    let xs vs.
    assume HeG : e :e G.
    assume Hid : forall x:set, x :e G -> apply_fun mult (e, x) = x /\ apply_fun mult (x, e) = x.
    assume Hmcl : forall x y:set, x :e G -> y :e G -> apply_fun mult (x, y) :e G.
    assume Hassoc : forall x y z:set, x :e G -> y :e G -> z :e G ->
      apply_fun mult (apply_fun mult (x, y), z) = apply_fun mult (x, apply_fun mult (y, z)).
    assume Hvs0G : apply_fun vs 0 :e G.
    assume Hxs_mem : forall i:set, i :e ordsucc k -> apply_fun xs i :e G.
    assume Hvs_shift : forall i:set, i :e ordsucc k -> apply_fun vs (ordsucc i) = apply_fun xs i.
    claim Hxs_k : forall i:set, i :e k -> apply_fun xs i :e G.
    { let i. assume Hik : i :e k. exact (Hxs_mem i (ordsuccI1 k i Hik)). }
    claim Hvs_k : forall i:set, i :e k -> apply_fun vs (ordsucc i) = apply_fun xs i.
    { let i. assume Hik : i :e k. exact (Hvs_shift i (ordsuccI1 k i Hik)). }
    claim Hwp_vs_sk : word_product mult e vs (ordsucc k) =
      apply_fun mult (apply_fun vs 0, word_product mult e xs k).
    { exact (IH xs vs HeG Hid Hmcl Hassoc Hvs0G Hxs_k Hvs_k). }
    claim Hwp_vs_ssk_step : word_product mult e vs (ordsucc (ordsucc k)) =
      apply_fun mult (word_product mult e vs (ordsucc k), apply_fun vs (ordsucc k)).
    { exact (nat_primrec_S e (fun j r => apply_fun mult (r, apply_fun vs j))
        (ordsucc k) (nat_ordsucc k Hk)). }
    claim Hvs_sk_eq : apply_fun vs (ordsucc k) = apply_fun xs k.
    { exact (Hvs_shift k (ordsuccI2 k)). }
    claim Hxsk_G : apply_fun xs k :e G.
    { exact (Hxs_mem k (ordsuccI2 k)). }
    claim Hwp_xs_k_G : word_product mult e xs k :e G.
    { exact (word_product_in_G mult e G k xs HeG Hmcl (nat_p_omega k Hk) Hxs_k). }
    claim Hvs0_wp_G : apply_fun mult (apply_fun vs 0, word_product mult e xs k) :e G.
    { exact (Hmcl (apply_fun vs 0) (word_product mult e xs k) Hvs0G Hwp_xs_k_G). }
    claim Hassoc_step :
      apply_fun mult (apply_fun mult (apply_fun vs 0, word_product mult e xs k), apply_fun xs k) =
      apply_fun mult (apply_fun vs 0, apply_fun mult (word_product mult e xs k, apply_fun xs k)).
    { exact (Hassoc (apply_fun vs 0) (word_product mult e xs k) (apply_fun xs k)
        Hvs0G Hwp_xs_k_G Hxsk_G). }
    claim Hwp_xs_sk_step : word_product mult e xs (ordsucc k) =
      apply_fun mult (word_product mult e xs k, apply_fun xs k).
    { exact (nat_primrec_S e (fun j r => apply_fun mult (r, apply_fun xs j)) k Hk). }
    rewrite Hwp_vs_ssk_step. rewrite Hvs_sk_eq. rewrite Hwp_vs_sk.
    rewrite Hassoc_step. rewrite Hwp_xs_sk_step. reflexivity.
}
let n xs vs. assume HeG Hid Hmcl Hassoc Hvs0G. assume Hn : n :e omega.
assume Hxs_mem Hvs_shift.
exact (Hnat n (omega_nat_p n Hn) xs vs HeG Hid Hmcl Hassoc Hvs0G Hxs_mem Hvs_shift).
Qed.

(** Sub-sub-helper: Case last entry G2, first entry G1 **)
(** Strategy: Build vs = [y, cs(0), ..., cs(k)] for yc = cx.
    Uniqueness: entry 0 of canonical = cs(0) (from ws) = y (from vs).
    cs(0) in G1 cap G2 = e, contradiction. **)
Lemma ex68_3_case_G2_first_G1 : forall G mult e inv G1 G2 c x m cs k ws:set,
  free_product_of_subgroups G mult e inv 2
    (graph 2 (fun i:set => If_i (i = 0) G1 G2))
    (graph 2 (fun _:set => e)) ->
  c :e G -> x :e G1 ->
  apply_fun mult (apply_fun mult (c, x), apply_fun inv c) :e G2 ->
  apply_fun mult (apply_fun mult (c, x), apply_fun inv c) <> e ->
  x <> e ->
  apply_fun mult (c, x) <> e ->
  reduced_word 2 (graph 2 (fun i:set => If_i (i = 0) G1 G2))
    (graph 2 (fun _:set => e)) m cs ->
  m <> 0 -> word_product mult e cs m = c ->
  m = ordsucc k -> nat_p k ->
  apply_fun cs k :e G2 ->
  apply_fun cs 0 :e G1 -> apply_fun cs 0 <> e ->
  reduced_word 2 (graph 2 (fun i:set => If_i (i = 0) G1 G2))
    (graph 2 (fun _:set => e)) (ordsucc m) ws ->
  word_product mult e ws (ordsucc m) = apply_fun mult (c, x) ->
  apply_fun ws 0 = apply_fun cs 0 ->
  False.
let G mult e inv G1 G2 c x m cs k ws.
set Gfam := graph 2 (fun i:set => If_i (i = 0) G1 G2).
set efam := graph 2 (fun _:set => e).
set y := apply_fun mult (apply_fun mult (c, x), apply_fun inv c).
assume Hfp : free_product_of_subgroups G mult e inv 2 Gfam efam.
assume HcG : c :e G. assume HxG1 : x :e G1.
assume HyG2 : y :e G2. assume Hyne : y <> e.
assume Hxne : x <> e.
assume Hcxne : apply_fun mult (c, x) <> e.
assume Hred : reduced_word 2 Gfam efam m cs.
assume Hmne : m <> 0. assume Hprod : word_product mult e cs m = c.
assume Hm_eq : m = ordsucc k. assume Hk_nat : nat_p k.
assume Hcsk_G2 : apply_fun cs k :e G2.
assume Hcs0_G1 : apply_fun cs 0 :e G1.
assume Hcs0_ne_e : apply_fun cs 0 <> e.
assume Hws_red : reduced_word 2 Gfam efam (ordsucc m) ws.
assume Hwp_cx : word_product mult e ws (ordsucc m) = apply_fun mult (c, x).
assume Hws0 : apply_fun ws 0 = apply_fun cs 0.
(** Extract free product components **)
apply (and6E
  (group_structure G mult e inv)
  (forall alpha:set, alpha :e 2 -> subgroup_of (apply_fun Gfam alpha) G mult e inv)
  (forall alpha beta:set, alpha :e 2 -> beta :e 2 -> alpha <> beta ->
    forall z:set, z :e apply_fun Gfam alpha -> z :e apply_fun Gfam beta -> z = e)
  (subgroups_generate G mult e inv 2 Gfam)
  (forall z:set, z :e G -> z <> e ->
    exists n xs:set,
      reduced_word 2 Gfam efam n xs /\ n <> 0 /\
      word_product mult e xs n = z /\
      (forall n' xs':set,
        reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
        word_product mult e xs' n' = z ->
        n = n' /\ (forall i:set, i :e n -> apply_fun xs i = apply_fun xs' i)))
  (forall alpha:set, alpha :e 2 -> apply_fun efam alpha = e)
  Hfp).
assume Hgrp Hsub Hinter Hgen Hunique _.
claim H00 : 0 = 0. { reflexivity. }
claim HGfam0 : apply_fun Gfam 0 = G1.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 0 In_0_2).
  exact (If_i_1 (0 = 0) G1 G2 H00). }
claim HGfam1 : apply_fun Gfam 1 = G2.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 1 In_1_2).
  exact (If_i_0 (1 = 0) G1 G2 neq_1_0). }
claim Hefam1 : apply_fun efam 1 = e.
{ rewrite (apply_fun_graph 2 (fun _:set => e) 1 In_1_2). reflexivity. }
claim HsubG1 : subgroup_of G1 G mult e inv.
{ rewrite <- HGfam0. exact (Hsub 0 In_0_2). }
claim HsubG2 : subgroup_of G2 G mult e inv.
{ rewrite <- HGfam1. exact (Hsub 1 In_1_2). }
apply (and4E (G1 c= G) (e :e G1)
  (forall x1 y1:set, x1 :e G1 -> y1 :e G1 -> apply_fun mult (x1, y1) :e G1)
  (forall x1:set, x1 :e G1 -> apply_fun inv x1 :e G1) HsubG1).
assume HG1sub HeG1 HG1mult HG1inv.
apply (and4E (G2 c= G) (e :e G2)
  (forall x1 y1:set, x1 :e G2 -> y1 :e G2 -> apply_fun mult (x1, y1) :e G2)
  (forall x1:set, x1 :e G2 -> apply_fun inv x1 :e G2) HsubG2).
assume HG2sub HeG2 HG2mult HG2inv.
claim Hinter_simple : forall z:set, z :e G1 -> z :e G2 -> z = e.
{ let z. assume HzG1 : z :e G1. assume HzG2 : z :e G2.
  claim HzGfam0 : z :e apply_fun Gfam 0. { rewrite HGfam0. exact HzG1. }
  claim HzGfam1 : z :e apply_fun Gfam 1. { rewrite HGfam1. exact HzG2. }
  exact (Hinter 0 1 In_0_2 In_1_2 neq_0_1 z HzGfam0 HzGfam1). }
apply (and6E
  (function_on mult (setprod G G) G) (function_on inv G G) (e :e G)
  (forall x1 y1 z1:set, x1 :e G -> y1 :e G -> z1 :e G ->
    apply_fun mult (apply_fun mult (x1, y1), z1) = apply_fun mult (x1, apply_fun mult (y1, z1)))
  (forall x1:set, x1 :e G -> apply_fun mult (e, x1) = x1 /\ apply_fun mult (x1, e) = x1)
  (forall x1:set, x1 :e G ->
    apply_fun mult (x1, apply_fun inv x1) = e /\ apply_fun mult (apply_fun inv x1, x1) = e)
  Hgrp).
assume HmultF HinvF HeG Hassoc Hid Hinverse.
(** Extract reduced word components early (need Hm_omega for Hm_nat) **)
apply (and3E
  (m :e omega)
  (forall i:set, i :e m ->
    exists alpha:set, alpha :e 2 /\
      apply_fun cs i :e apply_fun Gfam alpha /\
      apply_fun cs i <> apply_fun efam alpha)
  (forall i:set, i :e m -> ordsucc i :e m ->
    forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
      apply_fun cs i :e apply_fun Gfam alpha ->
      apply_fun cs (ordsucc i) :e apply_fun Gfam beta -> alpha <> beta)
  Hred).
assume Hm_omega Hcs_mem Hcs_adj.
(** Key memberships **)
claim HxG : x :e G. { exact (HG1sub x HxG1). }
claim HyG : y :e G. { exact (HG2sub y HyG2). }
claim HinvcG : apply_fun inv c :e G. { exact (HinvF c HcG). }
claim HcxG : apply_fun mult (c, x) :e G.
{ exact (HmultF (c, x) (tuple_2_setprod_by_pair_Sigma G G c x HcG HxG)). }
claim Hm_nat : nat_p m. { exact (omega_nat_p m Hm_omega). }
claim Hmult_cl : forall a1 b1:set, a1 :e G -> b1 :e G -> apply_fun mult (a1, b1) :e G.
{ let a1 b1. assume Ha1 : a1 :e G. assume Hb1 : b1 :e G.
  exact (HmultF (a1, b1) (tuple_2_setprod_by_pair_Sigma G G a1 b1 Ha1 Hb1)). }
(** Derive cx = yc **)
claim Hinvc_c : apply_fun mult (apply_fun inv c, c) = e.
{ exact (andER
    (apply_fun mult (c, apply_fun inv c) = e)
    (apply_fun mult (apply_fun inv c, c) = e)
    (Hinverse c HcG)). }
claim Hcx_e : apply_fun mult (apply_fun mult (c, x), e) = apply_fun mult (c, x).
{ exact (andER
    (apply_fun mult (e, apply_fun mult (c, x)) = apply_fun mult (c, x))
    (apply_fun mult (apply_fun mult (c, x), e) = apply_fun mult (c, x))
    (Hid (apply_fun mult (c, x)) HcxG)). }
claim Hassoc_yc : apply_fun mult (y, c) =
  apply_fun mult (apply_fun mult (c, x), apply_fun mult (apply_fun inv c, c)).
{ exact (Hassoc (apply_fun mult (c, x)) (apply_fun inv c) c HcxG HinvcG HcG). }
claim Hcx_eq_yc : apply_fun mult (c, x) = apply_fun mult (y, c).
{ rewrite Hassoc_yc. rewrite Hinvc_c. symmetry. exact Hcx_e. }
claim Hsm_omega : ordsucc m :e omega. { exact (omega_ordsucc m Hm_omega). }
claim H0_in_m : 0 :e m. { rewrite Hm_eq. exact (nat_0_in_ordsucc k Hk_nat). }
(** Construct vs = [y, cs(0), ..., cs(k)] using Union trick for predecessor **)
set vs := graph (ordsucc m) (fun i:set => If_i (i = 0) y (apply_fun cs (Union i))).
claim Hvs_0 : apply_fun vs 0 = y.
{ claim H0_sm : 0 :e ordsucc m. { exact (nat_0_in_ordsucc m Hm_nat). }
  rewrite (apply_fun_graph (ordsucc m)
    (fun i:set => If_i (i = 0) y (apply_fun cs (Union i))) 0 H0_sm).
  exact (If_i_1 (0 = 0) y (apply_fun cs (Union 0)) H00). }
claim Hvs_shift : forall j:set, j :e m -> apply_fun vs (ordsucc j) = apply_fun cs j.
{ let j. assume Hjm : j :e m.
  claim Hj_nat : nat_p j.
  { exact (omega_nat_p j (omega_TransSet m Hm_omega j Hjm)). }
  claim Hsj_sm : ordsucc j :e ordsucc m.
  { exact (nat_ordsucc_in_ordsucc m Hm_nat j Hjm). }
  rewrite (apply_fun_graph (ordsucc m)
    (fun i:set => If_i (i = 0) y (apply_fun cs (Union i))) (ordsucc j) Hsj_sm).
  claim Hsj_ne0 : ordsucc j <> 0. { exact (neq_ordsucc_0 j). }
  rewrite (If_i_0 (ordsucc j = 0) y (apply_fun cs (Union (ordsucc j))) Hsj_ne0).
  claim Hunion_sj : Union (ordsucc j) = j.
  { exact (Union_ordsucc_eq j Hj_nat). }
  rewrite Hunion_sj. reflexivity. }
(** Show vs is reduced: membership **)
claim Hvs_mem : forall i:set, i :e ordsucc m ->
  exists alpha:set, alpha :e 2 /\
    apply_fun vs i :e apply_fun Gfam alpha /\
    apply_fun vs i <> apply_fun efam alpha.
{ let i. assume Hi : i :e ordsucc m.
  apply (xm (i = 0)).
  - assume Hi0 : i = 0.
    rewrite Hi0. rewrite Hvs_0.
    witness 1. apply and3I.
    + exact In_1_2.
    + rewrite HGfam1. exact HyG2.
    + rewrite Hefam1. exact Hyne.
  - assume Hi_ne0 : i <> 0.
    claim Hi_nat : nat_p i.
    { exact (omega_nat_p i (omega_TransSet (ordsucc m) Hsm_omega i Hi)). }
    apply (nat_inv i Hi_nat).
    + assume Habs : i = 0. exact (Hi_ne0 Habs (exists alpha:set, alpha :e 2 /\
        apply_fun vs i :e apply_fun Gfam alpha /\
        apply_fun vs i <> apply_fun efam alpha)).
    + assume Hex : exists j:set, nat_p j /\ i = ordsucc j.
      apply Hex. let j. assume Hjconj : nat_p j /\ i = ordsucc j.
      claim Hi_eq_sj : i = ordsucc j.
      { exact (andER (nat_p j) (i = ordsucc j) Hjconj). }
      claim Hsj_sm : ordsucc j :e ordsucc m. { rewrite <- Hi_eq_sj. exact Hi. }
      claim Hjm : j :e m.
      { apply (ordsuccE m (ordsucc j) Hsj_sm).
        * assume Hsjm : ordsucc j :e m.
          exact (nat_trans m Hm_nat (ordsucc j) Hsjm j (ordsuccI2 j)).
        * assume Hsjeqm : ordsucc j = m.
          claim Hsj_sk : ordsucc j = ordsucc k. { rewrite Hsjeqm. exact Hm_eq. }
          claim Hjeqk : j = k. { exact (ordsucc_inj j k Hsj_sk). }
          rewrite Hjeqk. rewrite Hm_eq. exact (ordsuccI2 k). }
      claim Hvsi_eq : apply_fun vs i = apply_fun cs j.
      { rewrite Hi_eq_sj. exact (Hvs_shift j Hjm). }
      rewrite Hvsi_eq. exact (Hcs_mem j Hjm). }
(** Show vs is reduced: adjacency **)
claim Hvs_adj : forall i:set, i :e ordsucc m -> ordsucc i :e ordsucc m ->
  forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
    apply_fun vs i :e apply_fun Gfam alpha ->
    apply_fun vs (ordsucc i) :e apply_fun Gfam beta ->
    alpha <> beta.
{ let i. assume Hi : i :e ordsucc m. assume Hsi : ordsucc i :e ordsucc m.
  let alpha beta. assume Hal2 : alpha :e 2. assume Hbe2 : beta :e 2.
  assume Hvsi_al : apply_fun vs i :e apply_fun Gfam alpha.
  assume Hvssi_be : apply_fun vs (ordsucc i) :e apply_fun Gfam beta.
  apply (xm (i = 0)).
  - assume Hi0 : i = 0.
    (** vs(0) = y in G2 (factor 1), vs(1) = cs(0) in G1 (factor 0) **)
    claim Hvsi_eq_y : apply_fun vs i = y.
    { rewrite Hi0. exact Hvs_0. }
    claim Hvs0_al : y :e apply_fun Gfam alpha.
    { rewrite <- Hvsi_eq_y. exact Hvsi_al. }
    claim Hvssi_eq_cs0 : apply_fun vs (ordsucc i) = apply_fun cs 0.
    { rewrite Hi0. exact (Hvs_shift 0 H0_in_m). }
    claim Hvs1_be : apply_fun cs 0 :e apply_fun Gfam beta.
    { rewrite <- Hvssi_eq_cs0. exact Hvssi_be. }
    assume Haleqbe : alpha = beta.
    apply (xm (alpha = 1)).
    + assume Hal1 : alpha = 1.
      claim Hbe1 : beta = 1. { rewrite <- Haleqbe. exact Hal1. }
      claim HGfam_be : apply_fun Gfam beta = G2. { rewrite Hbe1. exact HGfam1. }
      claim Hcs0_G2' : apply_fun cs 0 :e G2. { rewrite <- HGfam_be. exact Hvs1_be. }
      exact (Hcs0_ne_e (Hinter_simple (apply_fun cs 0) Hcs0_G1 Hcs0_G2')).
    + assume Hal_ne1 : alpha <> 1.
      claim Hal0 : alpha = 0.
      { apply (ordsuccE 1 alpha Hal2).
        * assume H : alpha :e 1. apply (ordsuccE 0 alpha H).
          { assume H2 : alpha :e 0. exact (EmptyE alpha H2 (alpha = 0)). }
          assume H2 : alpha = 0. exact H2.
        * assume H : alpha = 1. exact (Hal_ne1 H (alpha = 0)). }
      claim HGfam_al : apply_fun Gfam alpha = G1. { rewrite Hal0. exact HGfam0. }
      claim Hy_G1 : y :e G1. { rewrite <- HGfam_al. exact Hvs0_al. }
      exact (Hyne (Hinter_simple y Hy_G1 HyG2)).
  - assume Hi_ne0 : i <> 0.
    (** Both i and ordsucc i correspond to cs entries **)
    claim Hi_nat : nat_p i.
    { exact (omega_nat_p i (omega_TransSet (ordsucc m) Hsm_omega i Hi)). }
    apply (nat_inv i Hi_nat).
    + assume Habs : i = 0. exact (Hi_ne0 Habs (alpha <> beta)).
    + assume Hex : exists j:set, nat_p j /\ i = ordsucc j.
      apply Hex. let j. assume Hjconj : nat_p j /\ i = ordsucc j.
      claim Hi_eq_sj : i = ordsucc j.
      { exact (andER (nat_p j) (i = ordsucc j) Hjconj). }
      claim Hsj_sm : ordsucc j :e ordsucc m. { rewrite <- Hi_eq_sj. exact Hi. }
      claim Hjm : j :e m.
      { apply (ordsuccE m (ordsucc j) Hsj_sm).
        * assume Hsjm : ordsucc j :e m.
          exact (nat_trans m Hm_nat (ordsucc j) Hsjm j (ordsuccI2 j)).
        * assume Hsjeqm : ordsucc j = m.
          claim Hsj_sk : ordsucc j = ordsucc k. { rewrite Hsjeqm. exact Hm_eq. }
          claim Hjeqk : j = k. { exact (ordsucc_inj j k Hsj_sk). }
          rewrite Hjeqk. rewrite Hm_eq. exact (ordsuccI2 k). }
      claim Hssj_sm : ordsucc (ordsucc j) :e ordsucc m. { rewrite <- Hi_eq_sj. exact Hsi. }
      claim Hsjm : ordsucc j :e m.
      { apply (ordsuccE m (ordsucc (ordsucc j)) Hssj_sm).
        * assume H : ordsucc (ordsucc j) :e m.
          exact (nat_trans m Hm_nat (ordsucc (ordsucc j)) H (ordsucc j) (ordsuccI2 (ordsucc j))).
        * assume H : ordsucc (ordsucc j) = m.
          claim Hssj_sk : ordsucc (ordsucc j) = ordsucc k. { rewrite H. exact Hm_eq. }
          claim Hsjk : ordsucc j = k. { exact (ordsucc_inj (ordsucc j) k Hssj_sk). }
          rewrite Hsjk. rewrite Hm_eq. exact (ordsuccI2 k). }
      claim Hvsi_csj : apply_fun vs i = apply_fun cs j.
      { rewrite Hi_eq_sj. exact (Hvs_shift j Hjm). }
      claim Hvssi_cssj : apply_fun vs (ordsucc i) = apply_fun cs (ordsucc j).
      { rewrite Hi_eq_sj. exact (Hvs_shift (ordsucc j) Hsjm). }
      claim Hcsj_al : apply_fun cs j :e apply_fun Gfam alpha.
      { rewrite <- Hvsi_csj. exact Hvsi_al. }
      claim Hcssj_be : apply_fun cs (ordsucc j) :e apply_fun Gfam beta.
      { rewrite <- Hvssi_cssj. exact Hvssi_be. }
      exact (Hcs_adj j Hjm Hsjm alpha beta Hal2 Hbe2 Hcsj_al Hcssj_be). }
claim Hvs_red : reduced_word 2 Gfam efam (ordsucc m) vs.
{ prove (ordsucc m :e omega /\
    (forall i:set, i :e ordsucc m ->
      exists alpha:set, alpha :e 2 /\
        apply_fun vs i :e apply_fun Gfam alpha /\
        apply_fun vs i <> apply_fun efam alpha)) /\
    (forall i:set, i :e ordsucc m -> ordsucc i :e ordsucc m ->
      forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
        apply_fun vs i :e apply_fun Gfam alpha ->
        apply_fun vs (ordsucc i) :e apply_fun Gfam beta ->
        alpha <> beta).
  apply andI.
  - apply andI.
    + exact Hsm_omega.
    + exact Hvs_mem.
  - exact Hvs_adj. }
(** Word product of vs = mult(y, c) = yc = cx **)
claim Hvs_all_G : forall i:set, i :e m -> apply_fun cs i :e G.
{ let i. assume Him : i :e m.
  apply (exandE_i
    (fun al:set => al :e 2 /\ apply_fun cs i :e apply_fun Gfam al)
    (fun al:set => apply_fun cs i <> apply_fun efam al) (Hcs_mem i Him)).
  let al. assume Hal_conj : al :e 2 /\ apply_fun cs i :e apply_fun Gfam al.
  assume Hne : apply_fun cs i <> apply_fun efam al.
  claim Hal2' : al :e 2.
  { exact (andEL (al :e 2) (apply_fun cs i :e apply_fun Gfam al) Hal_conj). }
  claim Hcsi_fam : apply_fun cs i :e apply_fun Gfam al.
  { exact (andER (al :e 2) (apply_fun cs i :e apply_fun Gfam al) Hal_conj). }
  apply (xm (al = 0)).
  - assume Hal0 : al = 0.
    claim Hcsi_G1 : apply_fun cs i :e G1.
    { claim Hfam0 : apply_fun Gfam al = G1. { rewrite Hal0. exact HGfam0. }
      rewrite <- Hfam0. exact Hcsi_fam. }
    exact (HG1sub (apply_fun cs i) Hcsi_G1).
  - assume Hal_ne0 : al <> 0.
    claim Hal1 : al = 1.
    { apply (ordsuccE 1 al Hal2').
      * assume H : al :e 1. apply (ordsuccE 0 al H).
        { assume H2 : al :e 0. exact (EmptyE al H2 (al = 1)). }
        assume H2 : al = 0. exact (Hal_ne0 H2 (al = 1)).
      * assume H : al = 1. exact H. }
    claim Hcsi_G2 : apply_fun cs i :e G2.
    { claim Hfam1 : apply_fun Gfam al = G2. { rewrite Hal1. exact HGfam1. }
      rewrite <- Hfam1. exact Hcsi_fam. }
    exact (HG2sub (apply_fun cs i) Hcsi_G2). }
claim Hvs0_G : apply_fun vs 0 :e G.
{ rewrite Hvs_0. exact HyG. }
claim Hwp_vs : word_product mult e vs (ordsucc m) =
  apply_fun mult (apply_fun vs 0, word_product mult e cs m).
{ exact (word_product_prepend mult e G m cs vs HeG Hid Hmult_cl Hassoc
    Hvs0_G Hm_omega Hvs_all_G Hvs_shift). }
claim Hwp_vs_eq : word_product mult e vs (ordsucc m) = apply_fun mult (y, c).
{ rewrite Hwp_vs. rewrite Hvs_0. rewrite Hprod. reflexivity. }
claim Hwp_vs_cx : word_product mult e vs (ordsucc m) = apply_fun mult (c, x).
{ rewrite Hwp_vs_eq. symmetry. exact Hcx_eq_yc. }
(** Apply uniqueness to cx **)
apply (Hunique (apply_fun mult (c, x)) HcxG Hcxne).
let n_c. assume Hn_c_ex : exists xs_c:set,
  reduced_word 2 Gfam efam n_c xs_c /\ n_c <> 0 /\
  word_product mult e xs_c n_c = apply_fun mult (c, x) /\
  (forall n' xs':set,
    reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
    word_product mult e xs' n' = apply_fun mult (c, x) ->
    n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i)).
apply Hn_c_ex.
let xs_c. assume Hxsc_all :
  reduced_word 2 Gfam efam n_c xs_c /\ n_c <> 0 /\
  word_product mult e xs_c n_c = apply_fun mult (c, x) /\
  (forall n' xs':set,
    reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
    word_product mult e xs' n' = apply_fun mult (c, x) ->
    n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i)).
claim Huniq_clause : forall n' xs':set,
  reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
  word_product mult e xs' n' = apply_fun mult (c, x) ->
  n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i).
{ exact (andER
    ((reduced_word 2 Gfam efam n_c xs_c /\ n_c <> 0) /\ word_product mult e xs_c n_c = apply_fun mult (c, x))
    (forall n' xs':set,
      reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
      word_product mult e xs' n' = apply_fun mult (c, x) ->
      n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i))
    Hxsc_all). }
claim Hsm_ne0 : ordsucc m <> 0. { exact (neq_ordsucc_0 m). }
claim Huniq_ws : n_c = ordsucc m /\
  (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun ws i).
{ exact (Huniq_clause (ordsucc m) ws Hws_red Hsm_ne0 Hwp_cx). }
claim Huniq_vs : n_c = ordsucc m /\
  (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun vs i).
{ exact (Huniq_clause (ordsucc m) vs Hvs_red Hsm_ne0 Hwp_vs_cx). }
claim Hnc_sm : n_c = ordsucc m.
{ exact (andEL (n_c = ordsucc m)
    (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun ws i) Huniq_ws). }
claim H0_in_nc : 0 :e n_c. { rewrite Hnc_sm. exact (nat_0_in_ordsucc m Hm_nat). }
claim Hxsc0_ws : apply_fun xs_c 0 = apply_fun ws 0.
{ exact ((andER (n_c = ordsucc m)
    (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun ws i) Huniq_ws) 0 H0_in_nc). }
claim Hxsc0_vs : apply_fun xs_c 0 = apply_fun vs 0.
{ exact ((andER (n_c = ordsucc m)
    (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun vs i) Huniq_vs) 0 H0_in_nc). }
claim Hcs0_eq_y : apply_fun cs 0 = y.
{ rewrite <- Hws0. rewrite <- Hxsc0_ws. rewrite Hxsc0_vs. exact Hvs_0. }
claim Hcs0_G2' : apply_fun cs 0 :e G2.
{ rewrite Hcs0_eq_y. exact HyG2. }
exact (Hcs0_ne_e (Hinter_simple (apply_fun cs 0) Hcs0_G1 Hcs0_G2')).
Qed.

(** Sub-sub-helper: Case last G2, first G2 (merge argument) **)
(** Strategy: Merge y and cs(0) since both in G2. Get reduced word for cx
    of length m (or less), contradicting ws of length ordsucc m via uniqueness. **)
Lemma ex68_3_case_G2_first_G2 : forall G mult e inv G1 G2 c x m cs k ws:set,
  free_product_of_subgroups G mult e inv 2
    (graph 2 (fun i:set => If_i (i = 0) G1 G2))
    (graph 2 (fun _:set => e)) ->
  c :e G -> x :e G1 ->
  apply_fun mult (apply_fun mult (c, x), apply_fun inv c) :e G2 ->
  apply_fun mult (apply_fun mult (c, x), apply_fun inv c) <> e ->
  x <> e ->
  apply_fun mult (c, x) <> e ->
  reduced_word 2 (graph 2 (fun i:set => If_i (i = 0) G1 G2))
    (graph 2 (fun _:set => e)) m cs ->
  m <> 0 -> word_product mult e cs m = c ->
  m = ordsucc k -> nat_p k ->
  apply_fun cs k :e G2 ->
  apply_fun cs 0 :e G2 ->
  reduced_word 2 (graph 2 (fun i:set => If_i (i = 0) G1 G2))
    (graph 2 (fun _:set => e)) (ordsucc m) ws ->
  word_product mult e ws (ordsucc m) = apply_fun mult (c, x) ->
  False.
let G mult e inv G1 G2 c x m cs k ws.
set Gfam := graph 2 (fun i:set => If_i (i = 0) G1 G2).
set efam := graph 2 (fun _:set => e).
assume Hfp : free_product_of_subgroups G mult e inv 2 Gfam efam.
assume HcG : c :e G. assume HxG1 : x :e G1.
set y := apply_fun mult (apply_fun mult (c, x), apply_fun inv c).
assume HyG2 : y :e G2.
assume Hyne : y <> e. assume Hxne : x <> e.
assume Hcxne : apply_fun mult (c, x) <> e.
assume Hred : reduced_word 2 Gfam efam m cs.
assume Hmne : m <> 0. assume Hprod : word_product mult e cs m = c.
assume Hm_eq : m = ordsucc k. assume Hk_nat : nat_p k.
assume Hcsk_G2 : apply_fun cs k :e G2.
assume Hcs0_G2 : apply_fun cs 0 :e G2.
assume Hws_red : reduced_word 2 Gfam efam (ordsucc m) ws.
assume Hwp_cx : word_product mult e ws (ordsucc m) = apply_fun mult (c, x).
prove False.
(** Extract free product components **)
apply (and6E
  (group_structure G mult e inv)
  (forall alpha:set, alpha :e 2 -> subgroup_of (apply_fun Gfam alpha) G mult e inv)
  (forall alpha beta:set, alpha :e 2 -> beta :e 2 -> alpha <> beta ->
    forall z:set, z :e apply_fun Gfam alpha -> z :e apply_fun Gfam beta -> z = e)
  (subgroups_generate G mult e inv 2 Gfam)
  (forall z:set, z :e G -> z <> e ->
    exists n xs:set,
      reduced_word 2 Gfam efam n xs /\ n <> 0 /\
      word_product mult e xs n = z /\
      (forall n' xs':set,
        reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
        word_product mult e xs' n' = z ->
        n = n' /\ (forall i:set, i :e n -> apply_fun xs i = apply_fun xs' i)))
  (forall alpha:set, alpha :e 2 -> apply_fun efam alpha = e)
  Hfp).
assume Hgrp Hsub Hinter Hgen Hunique _.
claim H00 : 0 = 0. { reflexivity. }
claim HGfam0 : apply_fun Gfam 0 = G1.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 0 In_0_2).
  exact (If_i_1 (0 = 0) G1 G2 H00). }
claim HGfam1 : apply_fun Gfam 1 = G2.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 1 In_1_2).
  exact (If_i_0 (1 = 0) G1 G2 neq_1_0). }
claim HsubG1 : subgroup_of G1 G mult e inv.
{ rewrite <- HGfam0. exact (Hsub 0 In_0_2). }
claim HsubG2 : subgroup_of G2 G mult e inv.
{ rewrite <- HGfam1. exact (Hsub 1 In_1_2). }
apply (and4E (G1 c= G) (e :e G1)
  (forall x1 y1:set, x1 :e G1 -> y1 :e G1 -> apply_fun mult (x1, y1) :e G1)
  (forall x1:set, x1 :e G1 -> apply_fun inv x1 :e G1) HsubG1).
assume HG1sub HeG1 HG1mult HG1inv.
apply (and4E (G2 c= G) (e :e G2)
  (forall x1 y1:set, x1 :e G2 -> y1 :e G2 -> apply_fun mult (x1, y1) :e G2)
  (forall x1:set, x1 :e G2 -> apply_fun inv x1 :e G2) HsubG2).
assume HG2sub HeG2 HG2mult HG2inv.
apply (and6E
  (function_on mult (setprod G G) G) (function_on inv G G) (e :e G)
  (forall x1 y1 z1:set, x1 :e G -> y1 :e G -> z1 :e G ->
    apply_fun mult (apply_fun mult (x1, y1), z1) = apply_fun mult (x1, apply_fun mult (y1, z1)))
  (forall x1:set, x1 :e G -> apply_fun mult (e, x1) = x1 /\ apply_fun mult (x1, e) = x1)
  (forall x1:set, x1 :e G ->
    apply_fun mult (x1, apply_fun inv x1) = e /\ apply_fun mult (apply_fun inv x1, x1) = e)
  Hgrp).
assume HmultF HinvF HeG Hassoc Hid Hinverse.
apply (and3E
  (m :e omega)
  (forall i:set, i :e m ->
    exists alpha:set, alpha :e 2 /\
      apply_fun cs i :e apply_fun Gfam alpha /\
      apply_fun cs i <> apply_fun efam alpha)
  (forall i:set, i :e m -> ordsucc i :e m ->
    forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
      apply_fun cs i :e apply_fun Gfam alpha ->
      apply_fun cs (ordsucc i) :e apply_fun Gfam beta -> alpha <> beta)
  Hred).
assume Hm_omega Hcs_mem Hcs_adj.
claim Hmult_cl : forall x1 y1:set, x1 :e G -> y1 :e G -> apply_fun mult (x1, y1) :e G.
{ let x1 y1. assume Hx1 : x1 :e G. assume Hy1 : y1 :e G.
  exact (HmultF (x1, y1) (tuple_2_setprod_by_pair_Sigma G G x1 y1 Hx1 Hy1)). }
claim HxG : x :e G. { exact (HG1sub x HxG1). }
claim HyG : y :e G. { exact (HG2sub y HyG2). }
claim HcxG : apply_fun mult (c, x) :e G. { exact (Hmult_cl c x HcG HxG). }
claim HinvcG : apply_fun inv c :e G. { exact (HinvF c HcG). }
claim Hm_nat : nat_p m. { exact (omega_nat_p m Hm_omega). }
claim Hk_in_m : k :e m. { rewrite Hm_eq. exact (ordsuccI2 k). }
claim H0_in_m : 0 :e m. { rewrite Hm_eq. exact (nat_0_in_ordsucc k Hk_nat). }
claim Hcs0_G : apply_fun cs 0 :e G. { exact (HG2sub (apply_fun cs 0) Hcs0_G2). }
(** Derive cx = yc **)
claim Hcx_eq_yc : apply_fun mult (c, x) = apply_fun mult (y, c).
{ claim H1 : apply_fun mult (apply_fun inv c, c) = e.
  { exact (andER (apply_fun mult (c, apply_fun inv c) = e)
      (apply_fun mult (apply_fun inv c, c) = e) (Hinverse c HcG)). }
  claim H2 : apply_fun mult (apply_fun mult (c, x), e) = apply_fun mult (c, x).
  { exact (andER (apply_fun mult (e, apply_fun mult (c, x)) = apply_fun mult (c, x))
      (apply_fun mult (apply_fun mult (c, x), e) = apply_fun mult (c, x))
      (Hid (apply_fun mult (c, x)) HcxG)). }
  rewrite (Hassoc (apply_fun mult (c, x)) (apply_fun inv c) c HcxG HinvcG HcG).
  rewrite H1. symmetry. exact H2. }
(** Define ycs0 and tail **)
set ycs0 := apply_fun mult (y, (apply_fun cs 0)).
claim Hycs0_G2 : ycs0 :e G2. { exact (HG2mult y (apply_fun cs 0) HyG2 Hcs0_G2). }
claim Hycs0_G : ycs0 :e G. { exact (HG2sub ycs0 Hycs0_G2). }
set tail_cs := graph k (fun i:set => apply_fun cs (ordsucc i)).
claim Htail_shift : forall i:set, i :e k ->
  apply_fun tail_cs i = apply_fun cs (ordsucc i).
{ let i. assume Hik : i :e k.
  exact (apply_fun_graph k (fun i:set => apply_fun cs (ordsucc i)) i Hik). }
claim Hcs_to_tail : forall i:set, i :e k ->
  apply_fun cs (ordsucc i) = apply_fun tail_cs i.
{ let i. assume Hik. symmetry. exact (Htail_shift i Hik). }
claim Htail_G : forall i:set, i :e k -> apply_fun tail_cs i :e G.
{ let i. assume Hik : i :e k.
  rewrite (Htail_shift i Hik).
  claim Hsi_m : ordsucc i :e m. { rewrite Hm_eq. exact (nat_ordsucc_in_ordsucc k Hk_nat i Hik). }
  apply (exandE_i
    (fun al:set => al :e 2 /\ apply_fun cs (ordsucc i) :e apply_fun Gfam al)
    (fun al:set => apply_fun cs (ordsucc i) <> apply_fun efam al)
    (Hcs_mem (ordsucc i) Hsi_m)).
  let al. assume Hal_conj : al :e 2 /\ apply_fun cs (ordsucc i) :e apply_fun Gfam al.
  assume Hne_efam : apply_fun cs (ordsucc i) <> apply_fun efam al.
  claim Hal2 : al :e 2.
  { exact (andEL (al :e 2) (apply_fun cs (ordsucc i) :e apply_fun Gfam al) Hal_conj). }
  claim Hcsi_fam : apply_fun cs (ordsucc i) :e apply_fun Gfam al.
  { exact (andER (al :e 2) (apply_fun cs (ordsucc i) :e apply_fun Gfam al) Hal_conj). }
  apply (xm (al = 0)).
  - assume Hal0 : al = 0.
    claim Hcsi_G1 : apply_fun cs (ordsucc i) :e G1.
    { claim Hfam0 : apply_fun Gfam al = G1. { rewrite Hal0. exact HGfam0. }
      rewrite <- Hfam0. exact Hcsi_fam. }
    exact (HG1sub (apply_fun cs (ordsucc i)) Hcsi_G1).
  - assume Hal_ne0 : al <> 0.
    claim Hal1 : al = 1.
    { apply (ordsuccE 1 al Hal2).
      { assume H : al :e 1. apply (ordsuccE 0 al H).
        { assume H2 : al :e 0. exact (EmptyE al H2 (al = 1)). }
        assume H2 : al = 0. exact (Hal_ne0 H2 (al = 1)). }
      assume H : al = 1. exact H. }
    claim Hcsi_G2 : apply_fun cs (ordsucc i) :e G2.
    { claim Hfam1 : apply_fun Gfam al = G2. { rewrite Hal1. exact HGfam1. }
      rewrite <- Hfam1. exact Hcsi_fam. }
    exact (HG2sub (apply_fun cs (ordsucc i)) Hcsi_G2). }
(** Decompose c = mult(cs(0), word_product tail_cs k) via word_product_prepend **)
claim Hwp_prepend : word_product mult e cs (ordsucc k) =
  apply_fun mult (apply_fun cs 0, word_product mult e tail_cs k).
{ exact (word_product_prepend mult e G k tail_cs cs HeG Hid Hmult_cl Hassoc
    Hcs0_G (nat_p_omega k Hk_nat) Htail_G Hcs_to_tail). }
claim Hwp_tail_G : word_product mult e tail_cs k :e G.
{ exact (word_product_in_G mult e G k tail_cs HeG Hmult_cl (nat_p_omega k Hk_nat) Htail_G). }
(** Forward chain: cx = yc = mult(y, c) = mult(y, mult(cs0, wpt))
    = mult(mult(y,cs0), wpt) = mult(ycs0, wpt) **)
(** Step: c = mult(cs0, wpt) via c = wp cs m = wp cs (ordsucc k) = mult(cs0, wpt) **)
claim Hc_eq_wp : c = word_product mult e cs m. { symmetry. exact Hprod. }
claim Hwp_m_sk : word_product mult e cs m = word_product mult e cs (ordsucc k).
{ rewrite Hm_eq. reflexivity. }
claim Hc_eq_wpsk : c = word_product mult e cs (ordsucc k).
{ exact (eq_i_tra c (word_product mult e cs m) (word_product mult e cs (ordsucc k))
    Hc_eq_wp Hwp_m_sk). }
claim Hc_eq_decomp : c = apply_fun mult (apply_fun cs 0, word_product mult e tail_cs k).
{ exact (eq_i_tra c (word_product mult e cs (ordsucc k))
    (apply_fun mult (apply_fun cs 0, word_product mult e tail_cs k))
    Hc_eq_wpsk Hwp_prepend). }
(** Step: mult(y,c) = mult(y, mult(cs0, wpt)) **)
claim Hyc_step : apply_fun mult (y, c) =
  apply_fun mult (y, apply_fun mult (apply_fun cs 0, word_product mult e tail_cs k)).
{ rewrite <- Hc_eq_decomp. reflexivity. }
(** Step: mult(y, mult(cs0, wpt)) = mult(mult(y,cs0), wpt) via assoc reversed **)
claim Hassoc_sym :
  apply_fun mult (y, apply_fun mult (apply_fun cs 0, word_product mult e tail_cs k)) =
  apply_fun mult (apply_fun mult (y, apply_fun cs 0), word_product mult e tail_cs k).
{ symmetry. exact (Hassoc y (apply_fun cs 0) (word_product mult e tail_cs k)
    HyG Hcs0_G Hwp_tail_G). }
(** Chain: mult(y,c) = mult(mult(y,cs0), wpt) = mult(ycs0, wpt) **)
claim Hyc_merge : apply_fun mult (y, c) = apply_fun mult (ycs0, word_product mult e tail_cs k).
{ exact (eq_i_tra
    (apply_fun mult (y, c))
    (apply_fun mult (y, apply_fun mult (apply_fun cs 0, word_product mult e tail_cs k)))
    (apply_fun mult (apply_fun mult (y, apply_fun cs 0), word_product mult e tail_cs k))
    Hyc_step Hassoc_sym). }
(** Chain: cx = yc = mult(ycs0, wpt) **)
claim Hcx_merge : apply_fun mult (c, x) = apply_fun mult (ycs0, word_product mult e tail_cs k).
{ exact (eq_i_tra (apply_fun mult (c, x)) (apply_fun mult (y, c))
    (apply_fun mult (ycs0, word_product mult e tail_cs k))
    Hcx_eq_yc Hyc_merge). }
(** Apply uniqueness to cx, derive n_c = ordsucc m from ws **)
apply (Hunique (apply_fun mult (c, x)) HcxG Hcxne).
let n_c. assume Hn_c_ex : exists xs_c:set,
  reduced_word 2 Gfam efam n_c xs_c /\ n_c <> 0 /\
  word_product mult e xs_c n_c = apply_fun mult (c, x) /\
  (forall n' xs':set,
    reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
    word_product mult e xs' n' = apply_fun mult (c, x) ->
    n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i)).
apply Hn_c_ex.
let xs_c. assume Hxsc_all :
  reduced_word 2 Gfam efam n_c xs_c /\ n_c <> 0 /\
  word_product mult e xs_c n_c = apply_fun mult (c, x) /\
  (forall n' xs':set,
    reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
    word_product mult e xs' n' = apply_fun mult (c, x) ->
    n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i)).
claim Huniq_clause : forall n' xs':set,
  reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
  word_product mult e xs' n' = apply_fun mult (c, x) ->
  n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i).
{ exact (andER
    ((reduced_word 2 Gfam efam n_c xs_c /\ n_c <> 0) /\ word_product mult e xs_c n_c = apply_fun mult (c, x))
    (forall n' xs':set,
      reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
      word_product mult e xs' n' = apply_fun mult (c, x) ->
      n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i))
    Hxsc_all). }
claim Hsm_omega : ordsucc m :e omega. { exact (omega_ordsucc m Hm_omega). }
claim Hnc_sm : n_c = ordsucc m.
{ exact (andEL (n_c = ordsucc m)
    (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun ws i)
    (Huniq_clause (ordsucc m) ws Hws_red (neq_ordsucc_0 m) Hwp_cx)). }
(** Case split on ycs0 = e **)
apply (xm (ycs0 = e)).
- assume Hycs0_e : ycs0 = e.
  (** cx = mult(ycs0, wpt) = mult(e, wpt) = wpt **)
  claim Hcx_ycs0_wpt : apply_fun mult (c, x) =
    apply_fun mult (ycs0, word_product mult e tail_cs k).
  { exact Hcx_merge. }
  claim Hycs0_e_merge : apply_fun mult (ycs0, word_product mult e tail_cs k) =
    apply_fun mult (e, word_product mult e tail_cs k).
  { rewrite Hycs0_e. reflexivity. }
  claim Hid_wpt : apply_fun mult (e, word_product mult e tail_cs k) =
    word_product mult e tail_cs k.
  { exact (andEL
      (apply_fun mult (e, word_product mult e tail_cs k) = word_product mult e tail_cs k)
      (apply_fun mult (word_product mult e tail_cs k, e) = word_product mult e tail_cs k)
      (Hid (word_product mult e tail_cs k) Hwp_tail_G)). }
  claim Hcx_tail : apply_fun mult (c, x) = word_product mult e tail_cs k.
  { exact (eq_i_tra (apply_fun mult (c, x))
      (apply_fun mult (ycs0, word_product mult e tail_cs k))
      (word_product mult e tail_cs k)
      Hcx_ycs0_wpt
      (eq_i_tra
        (apply_fun mult (ycs0, word_product mult e tail_cs k))
        (apply_fun mult (e, word_product mult e tail_cs k))
        (word_product mult e tail_cs k)
        Hycs0_e_merge Hid_wpt)). }
  apply (xm (k = 0)).
  + assume Hk0 : k = 0.
    (** cx = word_product tail_cs k = word_product tail_cs 0 = e **)
    claim Hwpt_k0 : word_product mult e tail_cs k = word_product mult e tail_cs 0.
    { rewrite Hk0. reflexivity. }
    claim Hwpt_0_e : word_product mult e tail_cs 0 = e.
    { exact (nat_primrec_0 e (fun i r => apply_fun mult (r, apply_fun tail_cs i))). }
    claim Hwpt_ke : word_product mult e tail_cs k = e.
    { exact (eq_i_tra (word_product mult e tail_cs k) (word_product mult e tail_cs 0) e
        Hwpt_k0 Hwpt_0_e). }
    claim Hcx_e : apply_fun mult (c, x) = e.
    { exact (eq_i_tra (apply_fun mult (c, x)) (word_product mult e tail_cs k) e
        Hcx_tail Hwpt_ke). }
    exact (Hcxne Hcx_e).
  + assume Hk_ne0 : k <> 0.
    (** tail_cs is reduced of length k **)
    claim Htail_mem : forall i:set, i :e k ->
      exists alpha:set, alpha :e 2 /\
        apply_fun tail_cs i :e apply_fun Gfam alpha /\
        apply_fun tail_cs i <> apply_fun efam alpha.
    { let i. assume Hik : i :e k.
      rewrite (Htail_shift i Hik).
      claim Hsi_m : ordsucc i :e m.
      { rewrite Hm_eq. exact (nat_ordsucc_in_ordsucc k Hk_nat i Hik). }
      exact (Hcs_mem (ordsucc i) Hsi_m). }
    claim Htail_adj : forall i:set, i :e k -> ordsucc i :e k ->
      forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
        apply_fun tail_cs i :e apply_fun Gfam alpha ->
        apply_fun tail_cs (ordsucc i) :e apply_fun Gfam beta -> alpha <> beta.
    { let i. assume Hik : i :e k. assume Hsik : ordsucc i :e k.
      let alpha beta. assume Hal2 : alpha :e 2. assume Hbe2 : beta :e 2.
      rewrite (Htail_shift i Hik). rewrite (Htail_shift (ordsucc i) Hsik).
      assume Hcsi_al : apply_fun cs (ordsucc i) :e apply_fun Gfam alpha.
      assume Hcssi_be : apply_fun cs (ordsucc (ordsucc i)) :e apply_fun Gfam beta.
      claim Hsi_m : ordsucc i :e m.
      { rewrite Hm_eq. exact (nat_ordsucc_in_ordsucc k Hk_nat i Hik). }
      claim Hssi_m : ordsucc (ordsucc i) :e m.
      { rewrite Hm_eq. exact (nat_ordsucc_in_ordsucc k Hk_nat (ordsucc i) Hsik). }
      exact (Hcs_adj (ordsucc i) Hsi_m Hssi_m alpha beta Hal2 Hbe2 Hcsi_al Hcssi_be). }
    claim Htail_red : reduced_word 2 Gfam efam k tail_cs.
    { prove (k :e omega /\
        (forall i:set, i :e k ->
          exists alpha:set, alpha :e 2 /\
            apply_fun tail_cs i :e apply_fun Gfam alpha /\
            apply_fun tail_cs i <> apply_fun efam alpha)) /\
        (forall i:set, i :e k -> ordsucc i :e k ->
          forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
            apply_fun tail_cs i :e apply_fun Gfam alpha ->
            apply_fun tail_cs (ordsucc i) :e apply_fun Gfam beta -> alpha <> beta).
      apply andI.
      - apply andI.
        + exact (nat_p_omega k Hk_nat).
        + exact Htail_mem.
      - exact Htail_adj. }
    (** Length contradiction: n_c = ordsucc m and n_c = k **)
    claim Hcx_tail_rev : word_product mult e tail_cs k = apply_fun mult (c, x).
    { symmetry. exact Hcx_tail. }
    claim Hnc_k : n_c = k.
    { exact (andEL (n_c = k)
        (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun tail_cs i)
        (Huniq_clause k tail_cs Htail_red Hk_ne0 Hcx_tail_rev)). }
    claim Hnc_sm_rev : ordsucc m = n_c. { symmetry. exact Hnc_sm. }
    claim Hsm_eq_k : ordsucc m = k.
    { exact (eq_i_tra (ordsucc m) n_c k Hnc_sm_rev Hnc_k). }
    claim Hsk_eq_k : ordsucc (ordsucc k) = k.
    { claim Hord_sm : ordsucc (ordsucc k) = ordsucc m.
      { rewrite Hm_eq. reflexivity. }
      exact (eq_i_tra (ordsucc (ordsucc k)) (ordsucc m) k
        Hord_sm Hsm_eq_k). }
    claim Hsk_in_ssk : ordsucc k :e ordsucc (ordsucc k). { exact (ordsuccI2 (ordsucc k)). }
    claim Hsk_in_k : ordsucc k :e k.
    { exact (Hsk_eq_k (fun a _:set => ordsucc k :e a) Hsk_in_ssk). }
    exact (In_irref k (nat_trans k Hk_nat (ordsucc k) Hsk_in_k k (ordsuccI2 k))).
- assume Hycs0_ne : ycs0 <> e.
  (** Construct merged word vs = [ycs0, cs(1), ..., cs(k)] of length m **)
  set vs := graph m (fun j:set => If_i (j = 0) ycs0 (apply_fun cs j)).
  claim Hvs_0 : apply_fun vs 0 = ycs0.
  { rewrite (apply_fun_graph m (fun j:set => If_i (j = 0) ycs0 (apply_fun cs j)) 0 H0_in_m).
    exact (If_i_1 (0 = 0) ycs0 (apply_fun cs 0) H00). }
  claim Hvs_shift : forall j:set, j :e k ->
    apply_fun vs (ordsucc j) = apply_fun cs (ordsucc j).
  { let j. assume Hjk : j :e k.
    claim Hsj_m : ordsucc j :e m.
    { rewrite Hm_eq. exact (nat_ordsucc_in_ordsucc k Hk_nat j Hjk). }
    rewrite (apply_fun_graph m (fun j:set => If_i (j = 0) ycs0 (apply_fun cs j))
      (ordsucc j) Hsj_m).
    exact (If_i_0 (ordsucc j = 0) ycs0 (apply_fun cs (ordsucc j)) (neq_ordsucc_0 j)). }
  claim Hvs_to_tail : forall j:set, j :e k ->
    apply_fun vs (ordsucc j) = apply_fun tail_cs j.
  { let j. assume Hjk : j :e k.
    rewrite (Hvs_shift j Hjk). symmetry. exact (Htail_shift j Hjk). }
  (** Word product: wp vs m = cx via forward chain **)
  claim Hvs0_G : apply_fun vs 0 :e G.
  { rewrite Hvs_0. exact Hycs0_G. }
  claim Hwp_vs_prepend : word_product mult e vs (ordsucc k) =
    apply_fun mult (apply_fun vs 0, word_product mult e tail_cs k).
  { exact (word_product_prepend mult e G k tail_cs vs HeG Hid Hmult_cl Hassoc
      Hvs0_G (nat_p_omega k Hk_nat) Htail_G Hvs_to_tail). }
  (** Chain: wp vs m = wp vs (ordsucc k) = mult(vs(0), wpt) = mult(ycs0, wpt) = cx **)
  claim Hwp_m_sk2 : word_product mult e vs m = word_product mult e vs (ordsucc k).
  { rewrite Hm_eq. reflexivity. }
  claim Hwp_vs_step : word_product mult e vs m =
    apply_fun mult (apply_fun vs 0, word_product mult e tail_cs k).
  { exact (eq_i_tra (word_product mult e vs m) (word_product mult e vs (ordsucc k))
      (apply_fun mult (apply_fun vs 0, word_product mult e tail_cs k))
      Hwp_m_sk2 Hwp_vs_prepend). }
  claim Hvs0_to_ycs0 : apply_fun mult (apply_fun vs 0, word_product mult e tail_cs k) =
    apply_fun mult (ycs0, word_product mult e tail_cs k).
  { rewrite Hvs_0. reflexivity. }
  claim Hwp_vs_ycs0 : word_product mult e vs m =
    apply_fun mult (ycs0, word_product mult e tail_cs k).
  { exact (eq_i_tra (word_product mult e vs m)
      (apply_fun mult (apply_fun vs 0, word_product mult e tail_cs k))
      (apply_fun mult (ycs0, word_product mult e tail_cs k))
      Hwp_vs_step Hvs0_to_ycs0). }
  claim Hcx_merge_rev : apply_fun mult (ycs0, word_product mult e tail_cs k) =
    apply_fun mult (c, x).
  { symmetry. exact Hcx_merge. }
  claim Hwp_vs : word_product mult e vs m = apply_fun mult (c, x).
  { exact (eq_i_tra (word_product mult e vs m)
      (apply_fun mult (ycs0, word_product mult e tail_cs k))
      (apply_fun mult (c, x))
      Hwp_vs_ycs0 Hcx_merge_rev). }
  (** Prove vs is reduced **)
  claim Hvs_mem : forall i:set, i :e m ->
    exists alpha:set, alpha :e 2 /\
      apply_fun vs i :e apply_fun Gfam alpha /\
      apply_fun vs i <> apply_fun efam alpha.
  { let i. assume Him : i :e m.
    apply (xm (i = 0)).
    - assume Hi0 : i = 0.
      (** vs(0) = ycs0 in G2 = Gfam(1), ycs0 <> e = efam(1) **)
      witness 1. apply and3I.
      + exact In_1_2.
      + claim Hvsi_ycs0 : apply_fun vs i = ycs0. { rewrite Hi0. exact Hvs_0. }
        rewrite Hvsi_ycs0. rewrite HGfam1. exact Hycs0_G2.
      + claim Hvsi_ycs0 : apply_fun vs i = ycs0. { rewrite Hi0. exact Hvs_0. }
        rewrite Hvsi_ycs0.
        claim Hefam1 : apply_fun efam 1 = e.
        { rewrite (apply_fun_graph 2 (fun _:set => e) 1 In_1_2). reflexivity. }
        rewrite Hefam1. exact Hycs0_ne.
    - assume Hi_ne0 : i <> 0.
      (** i = ordsucc j for some j, vs(i) = cs(i) **)
      claim Hi_nat : nat_p i. { exact (omega_nat_p i (omega_TransSet m Hm_omega i Him)). }
      apply (nat_inv i Hi_nat).
      + assume Habs : i = 0. exact (Hi_ne0 Habs (exists alpha:set, alpha :e 2 /\
          apply_fun vs i :e apply_fun Gfam alpha /\
          apply_fun vs i <> apply_fun efam alpha)).
      + assume Hex : exists j:set, nat_p j /\ i = ordsucc j.
        apply Hex. let j. assume Hj_conj : nat_p j /\ i = ordsucc j.
        claim Hij : i = ordsucc j. { exact (andER (nat_p j) (i = ordsucc j) Hj_conj). }
        claim Hjk : j :e k.
        { claim Hi_in_sk : i :e ordsucc k. { rewrite <- Hm_eq. exact Him. }
          claim Hsj_in_sk : ordsucc j :e ordsucc k. { rewrite <- Hij. exact Hi_in_sk. }
          apply (ordsuccE k (ordsucc j) Hsj_in_sk).
          - assume Hsjk : ordsucc j :e k.
            claim Hj_nat : nat_p j. { exact (andEL (nat_p j) (i = ordsucc j) Hj_conj). }
            exact (nat_trans k Hk_nat (ordsucc j) Hsjk j (ordsuccI2 j)).
          - assume Hsjeqk : ordsucc j = k. rewrite <- Hsjeqk. exact (ordsuccI2 j). }
        claim Hvsi_cs : apply_fun vs i = apply_fun cs i.
        { rewrite Hij. exact (Hvs_shift j Hjk). }
        rewrite Hvsi_cs. exact (Hcs_mem i Him). }
  claim Hvs_adj : forall i:set, i :e m -> ordsucc i :e m ->
    forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
      apply_fun vs i :e apply_fun Gfam alpha ->
      apply_fun vs (ordsucc i) :e apply_fun Gfam beta -> alpha <> beta.
  { let i. assume Him : i :e m. assume Hsim : ordsucc i :e m.
    let alpha beta. assume Hal2 : alpha :e 2. assume Hbe2 : beta :e 2.
    assume Hvsi_al : apply_fun vs i :e apply_fun Gfam alpha.
    assume Hvssi_be : apply_fun vs (ordsucc i) :e apply_fun Gfam beta.
    apply (xm (i = 0)).
    - assume Hi0 : i = 0.
      (** vs(0) = ycs0 in G2 = Gfam(1), vs(1) = cs(1), and cs(0) in Gfam(1) **)
      assume Haleqbe : alpha = beta.
      (** Derive alpha = 1 **)
      claim Hvsi_ycs0 : apply_fun vs i = ycs0. { rewrite Hi0. exact Hvs_0. }
      claim Hycs0_al : ycs0 :e apply_fun Gfam alpha.
      { rewrite <- Hvsi_ycs0. exact Hvsi_al. }
      claim Hycs0_Gfam1 : ycs0 :e apply_fun Gfam 1.
      { rewrite HGfam1. exact Hycs0_G2. }
      apply (xm (alpha = 1)).
      + assume Hal1 : alpha = 1.
        (** beta = 1, so vs(1) in Gfam(1) = G2 **)
        claim Hbe1 : beta = 1. { rewrite <- Haleqbe. exact Hal1. }
        (** vs(ordsucc 0) = cs(1). Need 0 in k for Hvs_shift. **)
        (** We know ordsucc i in m, and i=0, so ordsucc 0 = 1 in m. **)
        (** cs(0) in Gfam(1). cs(1) in Gfam(beta) = Gfam(1). **)
        (** Hcs_adj 0 gives contradiction 1 <> 1 **)
        claim Hcs0_Gfam1 : apply_fun cs 0 :e apply_fun Gfam 1.
        { rewrite HGfam1. exact Hcs0_G2. }
        (** Derive cs(1) in Gfam(beta) **)
        claim Hi0_nat : nat_p 0. { exact nat_0. }
        claim H0k : 0 :e k.
        { claim Hsi_in_sk : ordsucc i :e ordsucc k. { rewrite <- Hm_eq. exact Hsim. }
          claim H1_in_sk : 1 :e ordsucc k. { rewrite <- Hi0. exact Hsi_in_sk. }
          apply (ordsuccE k 1 H1_in_sk).
          { assume H1k : 1 :e k. exact (nat_trans k Hk_nat 1 H1k 0 In_0_1). }
          assume H1eqk : 1 = k. rewrite <- H1eqk. exact In_0_1. }
        claim Hvs1_cs1 : apply_fun vs (ordsucc 0) = apply_fun cs (ordsucc 0).
        { exact (Hvs_shift 0 H0k). }
        claim Hvssi_cs1 : apply_fun vs (ordsucc i) = apply_fun cs (ordsucc 0).
        { rewrite Hi0. exact Hvs1_cs1. }
        claim Hcs1_be : apply_fun cs (ordsucc 0) :e apply_fun Gfam beta.
        { rewrite <- Hvssi_cs1. exact Hvssi_be. }
        claim Hcs1_Gfam1 : apply_fun cs (ordsucc 0) :e apply_fun Gfam 1.
        { exact (Hbe1 (fun a _:set => apply_fun cs (ordsucc 0) :e apply_fun Gfam a) Hcs1_be). }
        claim H1_in_m_deriv : ordsucc 0 :e m.
        { rewrite <- Hi0. exact Hsim. }
        claim H1_ne_1 : 1 <> 1.
        { exact (Hcs_adj 0 H0_in_m H1_in_m_deriv 1 1 In_1_2 In_1_2 Hcs0_Gfam1 Hcs1_Gfam1). }
        claim H11 : 1 = 1. { reflexivity. }
        exact (H1_ne_1 H11).
      + assume Hal_ne1 : alpha <> 1.
        (** ycs0 in Gfam(alpha) inter Gfam(1), alpha <> 1, so ycs0 = e **)
        exact (Hycs0_ne (Hinter alpha 1 Hal2 In_1_2 Hal_ne1 ycs0
          Hycs0_al Hycs0_Gfam1)).
    - assume Hi_ne0 : i <> 0.
      (** i = ordsucc j, vs(i) = cs(i), vs(ordsucc i) = cs(ordsucc i) **)
      claim Hi_nat : nat_p i. { exact (omega_nat_p i (omega_TransSet m Hm_omega i Him)). }
      apply (nat_inv i Hi_nat).
      + assume Habs : i = 0.
        exact (Hi_ne0 Habs (alpha <> beta)).
      + assume Hex : exists j:set, nat_p j /\ i = ordsucc j.
        apply Hex. let j. assume Hj_conj : nat_p j /\ i = ordsucc j.
        claim Hij : i = ordsucc j. { exact (andER (nat_p j) (i = ordsucc j) Hj_conj). }
        claim Hjk : j :e k.
        { claim Hi_in_sk : i :e ordsucc k. { rewrite <- Hm_eq. exact Him. }
          claim Hsj_in_sk : ordsucc j :e ordsucc k. { rewrite <- Hij. exact Hi_in_sk. }
          apply (ordsuccE k (ordsucc j) Hsj_in_sk).
          - assume Hsjk : ordsucc j :e k.
            exact (nat_trans k Hk_nat (ordsucc j) Hsjk j (ordsuccI2 j)).
          - assume Hsjeqk : ordsucc j = k. rewrite <- Hsjeqk. exact (ordsuccI2 j). }
        claim Hvsi_cs : apply_fun vs i = apply_fun cs i.
        { rewrite Hij. exact (Hvs_shift j Hjk). }
        claim Hcsi_al : apply_fun cs i :e apply_fun Gfam alpha.
        { rewrite <- Hvsi_cs. exact Hvsi_al. }
        (** For vs(ordsucc i) = cs(ordsucc i) **)
        claim Hsj_in_k : ordsucc j :e k.
        { claim Hsi_in_sk : ordsucc i :e ordsucc k. { rewrite <- Hm_eq. exact Hsim. }
          claim Hssj_in_sk : ordsucc (ordsucc j) :e ordsucc k. { rewrite <- Hij. exact Hsi_in_sk. }
          apply (ordsuccE k (ordsucc (ordsucc j)) Hssj_in_sk).
          - assume Hssjk : ordsucc (ordsucc j) :e k.
            exact (nat_trans k Hk_nat (ordsucc (ordsucc j)) Hssjk (ordsucc j) (ordsuccI2 (ordsucc j))).
          - assume Hssjeqk : ordsucc (ordsucc j) = k. rewrite <- Hssjeqk. exact (ordsuccI2 (ordsucc j)). }
        claim Hvssi_cs : apply_fun vs (ordsucc i) = apply_fun cs (ordsucc i).
        { rewrite Hij. exact (Hvs_shift (ordsucc j) Hsj_in_k). }
        claim Hcssi_be : apply_fun cs (ordsucc i) :e apply_fun Gfam beta.
        { rewrite <- Hvssi_cs. exact Hvssi_be. }
        exact (Hcs_adj i Him Hsim alpha beta Hal2 Hbe2 Hcsi_al Hcssi_be). }
  claim Hvs_red : reduced_word 2 Gfam efam m vs.
  { prove (m :e omega /\
      (forall i:set, i :e m ->
        exists alpha:set, alpha :e 2 /\
          apply_fun vs i :e apply_fun Gfam alpha /\
          apply_fun vs i <> apply_fun efam alpha)) /\
      (forall i:set, i :e m -> ordsucc i :e m ->
        forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
          apply_fun vs i :e apply_fun Gfam alpha ->
          apply_fun vs (ordsucc i) :e apply_fun Gfam beta -> alpha <> beta).
    apply andI.
    - apply andI.
      + exact Hm_omega.
      + exact Hvs_mem.
    - exact Hvs_adj. }
  (** Length contradiction: n_c = ordsucc m and n_c = m **)
  claim Hnc_m : n_c = m.
  { exact (andEL (n_c = m)
      (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun vs i)
      (Huniq_clause m vs Hvs_red Hmne Hwp_vs)). }
  claim Hnc_m_rev : m = n_c. { symmetry. exact Hnc_m. }
  claim Hm_eq_sm : m = ordsucc m.
  { exact (eq_i_tra m n_c (ordsucc m) Hnc_m_rev Hnc_sm). }
  claim Hm_in_sm : m :e ordsucc m. { exact (ordsuccI2 m). }
  claim Hm_in_m : m :e m.
  { exact (Hm_eq_sm (fun _ b:set => m :e b) Hm_in_sm). }
  exact (In_irref m Hm_in_m).
Qed.

(** Sub-helper: Case last entry of c's word in G2 **)
(** Strategy: cx = yc. Build reduced word for cx by appending x.
    Case split on cs(0) factor. Contradiction via uniqueness. **)
Lemma ex68_3_case_last_G2 : forall G mult e inv G1 G2 c x m cs k:set,
  free_product_of_subgroups G mult e inv 2
    (graph 2 (fun i:set => If_i (i = 0) G1 G2))
    (graph 2 (fun _:set => e)) ->
  c :e G -> x :e G1 ->
  apply_fun mult (apply_fun mult (c, x), apply_fun inv c) :e G2 ->
  apply_fun mult (apply_fun mult (c, x), apply_fun inv c) <> e ->
  x <> e ->
  apply_fun mult (c, x) <> e ->
  reduced_word 2 (graph 2 (fun i:set => If_i (i = 0) G1 G2))
    (graph 2 (fun _:set => e)) m cs ->
  m <> 0 -> word_product mult e cs m = c ->
  m = ordsucc k -> nat_p k ->
  apply_fun cs k :e G2 ->
  False.
let G mult e inv G1 G2 c x m cs k.
set Gfam := graph 2 (fun i:set => If_i (i = 0) G1 G2).
set efam := graph 2 (fun _:set => e).
assume Hfp : free_product_of_subgroups G mult e inv 2 Gfam efam.
assume HcG : c :e G. assume HxG1 : x :e G1.
set y := apply_fun mult (apply_fun mult (c, x), apply_fun inv c).
assume HyG2 : y :e G2.
assume Hyne : y <> e.
assume Hxne : x <> e.
assume Hcxne : apply_fun mult (c, x) <> e.
assume Hred : reduced_word 2 Gfam efam m cs.
assume Hmne : m <> 0. assume Hprod : word_product mult e cs m = c.
assume Hm_eq : m = ordsucc k. assume Hk_nat : nat_p k.
assume Hcsk_G2 : apply_fun cs k :e G2.
(** Extract free product components **)
apply (and6E
  (group_structure G mult e inv)
  (forall alpha:set, alpha :e 2 -> subgroup_of (apply_fun Gfam alpha) G mult e inv)
  (forall alpha beta:set, alpha :e 2 -> beta :e 2 -> alpha <> beta ->
    forall z:set, z :e apply_fun Gfam alpha -> z :e apply_fun Gfam beta -> z = e)
  (subgroups_generate G mult e inv 2 Gfam)
  (forall z:set, z :e G -> z <> e ->
    exists n xs:set,
      reduced_word 2 Gfam efam n xs /\ n <> 0 /\
      word_product mult e xs n = z /\
      (forall n' xs':set,
        reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
        word_product mult e xs' n' = z ->
        n = n' /\ (forall i:set, i :e n -> apply_fun xs i = apply_fun xs' i)))
  (forall alpha:set, alpha :e 2 -> apply_fun efam alpha = e)
  Hfp).
assume Hgrp Hsub Hinter Hgen Hunique _.
claim H00 : 0 = 0. { reflexivity. }
claim HGfam0 : apply_fun Gfam 0 = G1.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 0 In_0_2).
  exact (If_i_1 (0 = 0) G1 G2 H00). }
claim HGfam1 : apply_fun Gfam 1 = G2.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 1 In_1_2).
  exact (If_i_0 (1 = 0) G1 G2 neq_1_0). }
claim HsubG1 : subgroup_of G1 G mult e inv.
{ rewrite <- HGfam0. exact (Hsub 0 In_0_2). }
claim HsubG2 : subgroup_of G2 G mult e inv.
{ rewrite <- HGfam1. exact (Hsub 1 In_1_2). }
apply (and4E (G1 c= G) (e :e G1)
  (forall x1 y1:set, x1 :e G1 -> y1 :e G1 -> apply_fun mult (x1, y1) :e G1)
  (forall x1:set, x1 :e G1 -> apply_fun inv x1 :e G1) HsubG1).
assume HG1sub HeG1 HG1mult HG1inv.
apply (and4E (G2 c= G) (e :e G2)
  (forall x1 y1:set, x1 :e G2 -> y1 :e G2 -> apply_fun mult (x1, y1) :e G2)
  (forall x1:set, x1 :e G2 -> apply_fun inv x1 :e G2) HsubG2).
assume HG2sub HeG2 HG2mult HG2inv.
claim Hinter_simple : forall z:set, z :e G1 -> z :e G2 -> z = e.
{ let z. assume HzG1 : z :e G1. assume HzG2 : z :e G2.
  claim HzGfam0 : z :e apply_fun Gfam 0. { rewrite HGfam0. exact HzG1. }
  claim HzGfam1 : z :e apply_fun Gfam 1. { rewrite HGfam1. exact HzG2. }
  exact (Hinter 0 1 In_0_2 In_1_2 neq_0_1 z HzGfam0 HzGfam1). }
apply (and6E
  (function_on mult (setprod G G) G) (function_on inv G G) (e :e G)
  (forall x1 y1 z1:set, x1 :e G -> y1 :e G -> z1 :e G ->
    apply_fun mult (apply_fun mult (x1, y1), z1) = apply_fun mult (x1, apply_fun mult (y1, z1)))
  (forall x1:set, x1 :e G -> apply_fun mult (e, x1) = x1 /\ apply_fun mult (x1, e) = x1)
  (forall x1:set, x1 :e G ->
    apply_fun mult (x1, apply_fun inv x1) = e /\ apply_fun mult (apply_fun inv x1, x1) = e)
  Hgrp).
assume HmultF HinvF HeG Hassoc Hid Hinverse.
(** Extract reduced word components **)
apply (and3E
  (m :e omega)
  (forall i:set, i :e m ->
    exists alpha:set, alpha :e 2 /\
      apply_fun cs i :e apply_fun Gfam alpha /\
      apply_fun cs i <> apply_fun efam alpha)
  (forall i:set, i :e m -> ordsucc i :e m ->
    forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
      apply_fun cs i :e apply_fun Gfam alpha ->
      apply_fun cs (ordsucc i) :e apply_fun Gfam beta -> alpha <> beta)
  Hred).
assume Hm_omega Hcs_mem Hcs_adj.
claim HxG : x :e G. { exact (HG1sub x HxG1). }
claim HyG : y :e G. { exact (HG2sub y HyG2). }
claim HinvcG : apply_fun inv c :e G. { exact (HinvF c HcG). }
claim HcxG : apply_fun mult (c, x) :e G.
{ exact (HmultF (c, x) (tuple_2_setprod_by_pair_Sigma G G c x HcG HxG)). }
claim Hm_nat : nat_p m. { exact (omega_nat_p m Hm_omega). }
claim Hk_in_m : k :e m. { rewrite Hm_eq. exact (ordsuccI2 k). }
claim H0_in_m : 0 :e m. { rewrite Hm_eq. exact (nat_0_in_ordsucc k Hk_nat). }
(** Derive cx = yc **)
claim Hinvc_c : apply_fun mult (apply_fun inv c, c) = e.
{ exact (andER
    (apply_fun mult (c, apply_fun inv c) = e)
    (apply_fun mult (apply_fun inv c, c) = e)
    (Hinverse c HcG)). }
claim Hcx_e : apply_fun mult (apply_fun mult (c, x), e) = apply_fun mult (c, x).
{ exact (andER
    (apply_fun mult (e, apply_fun mult (c, x)) = apply_fun mult (c, x))
    (apply_fun mult (apply_fun mult (c, x), e) = apply_fun mult (c, x))
    (Hid (apply_fun mult (c, x)) HcxG)). }
claim Hassoc_yc : apply_fun mult (y, c) =
  apply_fun mult (apply_fun mult (c, x), apply_fun mult (apply_fun inv c, c)).
{ exact (Hassoc (apply_fun mult (c, x)) (apply_fun inv c) c HcxG HinvcG HcG). }
claim Hcx_eq_yc : apply_fun mult (c, x) = apply_fun mult (y, c).
{ rewrite Hassoc_yc. rewrite Hinvc_c. symmetry. exact Hcx_e. }
(** Evaluate efam **)
claim Hefam0 : apply_fun efam 0 = e.
{ rewrite (apply_fun_graph 2 (fun _:set => e) 0 In_0_2). reflexivity. }
claim Hefam1 : apply_fun efam 1 = e.
{ rewrite (apply_fun_graph 2 (fun _:set => e) 1 In_1_2). reflexivity. }
(** Construct reduced word ws for cx = [cs(0),...,cs(k),x] of length ordsucc m **)
set ws := graph (ordsucc m) (fun i:set => If_i (i :e m) (apply_fun cs i) x).
claim Hm_notin_m : ~(m :e m). { exact (In_irref m). }
claim Hws_m : apply_fun ws m = x.
{ rewrite (apply_fun_graph (ordsucc m) (fun i:set => If_i (i :e m) (apply_fun cs i) x)
    m (ordsuccI2 m)).
  exact (If_i_0 (m :e m) (apply_fun cs m) x Hm_notin_m). }
claim Hws_agree : forall j:set, j :e m -> apply_fun ws j = apply_fun cs j.
{ let j. assume Hjm : j :e m.
  claim Hj_sm : j :e ordsucc m. { exact (ordsuccI1 m j Hjm). }
  rewrite (apply_fun_graph (ordsucc m) (fun i:set => If_i (i :e m) (apply_fun cs i) x)
    j Hj_sm).
  exact (If_i_1 (j :e m) (apply_fun cs j) x Hjm). }
(** Word product of ws at ordsucc m = mult(c, x) **)
claim Hsm_omega : ordsucc m :e omega. { exact (omega_ordsucc m Hm_omega). }
claim Hwp_m : word_product mult e ws m = c.
{ claim Hagree : word_product mult e ws m = word_product mult e cs m.
  { exact (word_product_agree mult e ws cs m Hm_omega Hws_agree). }
  rewrite Hagree. exact Hprod. }
claim Hwp_sm_step : word_product mult e ws (ordsucc m) =
  apply_fun mult (word_product mult e ws m, apply_fun ws m).
{ exact (nat_primrec_S e (fun i r => apply_fun mult (r, apply_fun ws i)) m Hm_nat). }
claim Hwp_cx : word_product mult e ws (ordsucc m) = apply_fun mult (c, x).
{ rewrite Hwp_sm_step. rewrite Hwp_m. rewrite Hws_m. reflexivity. }
(** Show ws is reduced **)
claim Hcsk_ne_e : apply_fun cs k <> e.
{ apply (exandE_i
    (fun al:set => al :e 2 /\ apply_fun cs k :e apply_fun Gfam al)
    (fun al:set => apply_fun cs k <> apply_fun efam al)
    (Hcs_mem k Hk_in_m)).
  let al_k.
  assume Halk_conj : al_k :e 2 /\ apply_fun cs k :e apply_fun Gfam al_k.
  assume Hne_efam : apply_fun cs k <> apply_fun efam al_k.
  claim Halk2 : al_k :e 2.
  { exact (andEL (al_k :e 2) (apply_fun cs k :e apply_fun Gfam al_k) Halk_conj). }
  claim Hefam_al : apply_fun efam al_k = e.
  { rewrite (apply_fun_graph 2 (fun _:set => e) al_k Halk2). reflexivity. }
  assume Habs : apply_fun cs k = e.
  apply Hne_efam. rewrite Hefam_al. exact Habs. }
(** Prove ws is a reduced word of length ordsucc m **)
claim Hws_mem : forall i:set, i :e ordsucc m ->
  exists alpha:set, alpha :e 2 /\
    apply_fun ws i :e apply_fun Gfam alpha /\
    apply_fun ws i <> apply_fun efam alpha.
{ let i. assume Hi : i :e ordsucc m.
  apply (ordsuccE m i Hi).
  - assume Him : i :e m.
    claim Hwsi_eq : apply_fun ws i = apply_fun cs i. { exact (Hws_agree i Him). }
    rewrite Hwsi_eq. exact (Hcs_mem i Him).
  - assume Hieqm : i = m.
    rewrite Hieqm. rewrite Hws_m.
    witness 0. apply and3I.
    + exact In_0_2.
    + rewrite HGfam0. exact HxG1.
    + rewrite Hefam0. exact Hxne. }
claim Hws_adj : forall i:set, i :e ordsucc m -> ordsucc i :e ordsucc m ->
  forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
    apply_fun ws i :e apply_fun Gfam alpha ->
    apply_fun ws (ordsucc i) :e apply_fun Gfam beta ->
    alpha <> beta.
{ let i. assume Hi : i :e ordsucc m. assume Hsi : ordsucc i :e ordsucc m.
  let alpha beta. assume Hal2 : alpha :e 2. assume Hbe2 : beta :e 2.
  assume Hwsi_al : apply_fun ws i :e apply_fun Gfam alpha.
  assume Hwssi_be : apply_fun ws (ordsucc i) :e apply_fun Gfam beta.
  (** ordsucc i :e ordsucc m means ordsucc i :e m or ordsucc i = m **)
  apply (ordsuccE m (ordsucc i) Hsi).
  - assume Hsim : ordsucc i :e m.
    (** Both i and ordsucc i are in m, so use Hcs_adj **)
    claim Him : i :e m. { exact (nat_trans m Hm_nat (ordsucc i) Hsim i (ordsuccI2 i)). }
    claim Hwsi_cs : apply_fun ws i = apply_fun cs i. { exact (Hws_agree i Him). }
    claim Hwssi_cs : apply_fun ws (ordsucc i) = apply_fun cs (ordsucc i).
    { exact (Hws_agree (ordsucc i) Hsim). }
    claim Hcsi_al : apply_fun cs i :e apply_fun Gfam alpha.
    { rewrite <- Hwsi_cs. exact Hwsi_al. }
    claim Hcssi_be : apply_fun cs (ordsucc i) :e apply_fun Gfam beta.
    { rewrite <- Hwssi_cs. exact Hwssi_be. }
    exact (Hcs_adj i Him Hsim alpha beta Hal2 Hbe2 Hcsi_al Hcssi_be).
  - assume Hsieqm : ordsucc i = m.
    (** ordsucc i = m means i = k (since m = ordsucc k) **)
    claim Hsi_sk : ordsucc i = ordsucc k. { rewrite Hsieqm. exact Hm_eq. }
    claim Hieqk : i = k. { exact (ordsucc_inj i k Hsi_sk). }
    claim Hwsi_csk : apply_fun ws i = apply_fun cs k.
    { rewrite Hieqk. exact (Hws_agree k Hk_in_m). }
    claim Hwssi_x : apply_fun ws (ordsucc i) = x.
    { rewrite Hsieqm. exact Hws_m. }
    claim Hcsk_Gal : apply_fun cs k :e apply_fun Gfam alpha.
    { rewrite <- Hwsi_csk. exact Hwsi_al. }
    claim Hx_Gbe : x :e apply_fun Gfam beta.
    { rewrite <- Hwssi_x. exact Hwssi_be. }
    (** If alpha = beta, contradiction via intersection **)
    assume Haleqbe : alpha = beta.
    apply (xm (alpha = 0)).
    + assume Hal0 : alpha = 0.
      (** cs(k) in Gfam(alpha)=Gfam(0)=G1 AND Gfam(1)=G2 **)
      claim Hal_ne1 : alpha <> 1. { rewrite Hal0. exact neq_0_1. }
      claim Hcsk_eq_e : apply_fun cs k = e.
      { claim Hcsk_G1fam : apply_fun cs k :e apply_fun Gfam 1.
        { rewrite HGfam1. exact Hcsk_G2. }
        exact (Hinter alpha 1 Hal2 In_1_2 Hal_ne1 (apply_fun cs k) Hcsk_Gal Hcsk_G1fam). }
      exact (Hcsk_ne_e Hcsk_eq_e).
    + assume Hal_ne0 : alpha <> 0.
      (** alpha = 1, so beta = 1 too; x in Gfam(beta) = G2 and G1 **)
      claim Hbe_ne0 : beta <> 0.
      { assume Hbe0 : beta = 0. apply Hal_ne0. rewrite Haleqbe. exact Hbe0. }
      claim Hx_G0fam : x :e apply_fun Gfam 0.
      { rewrite HGfam0. exact HxG1. }
      claim Hx_eq_e : x = e.
      { exact (Hinter beta 0 Hbe2 In_0_2 Hbe_ne0 x Hx_Gbe Hx_G0fam). }
      exact (Hxne Hx_eq_e). }
claim Hws_red : reduced_word 2 Gfam efam (ordsucc m) ws.
{ prove (ordsucc m :e omega /\
    (forall i:set, i :e ordsucc m ->
      exists alpha:set, alpha :e 2 /\
        apply_fun ws i :e apply_fun Gfam alpha /\
        apply_fun ws i <> apply_fun efam alpha)) /\
    (forall i:set, i :e ordsucc m -> ordsucc i :e ordsucc m ->
      forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
        apply_fun ws i :e apply_fun Gfam alpha ->
        apply_fun ws (ordsucc i) :e apply_fun Gfam beta ->
        alpha <> beta).
  apply andI.
  - apply andI.
    + exact Hsm_omega.
    + exact Hws_mem.
  - exact Hws_adj. }
(** Now apply uniqueness to get cx's canonical representation **)
(** Delegate remaining case analysis to sub-sub-helpers **)
(** Get first entry's factor **)
apply (exandE_i
  (fun al:set => al :e 2 /\ apply_fun cs 0 :e apply_fun Gfam al)
  (fun al:set => apply_fun cs 0 <> apply_fun efam al)
  (Hcs_mem 0 H0_in_m)).
let alpha_first.
assume Haf_conj : alpha_first :e 2 /\ apply_fun cs 0 :e apply_fun Gfam alpha_first.
assume Hcs0_ne_efam : apply_fun cs 0 <> apply_fun efam alpha_first.
claim Haf2 : alpha_first :e 2.
{ exact (andEL (alpha_first :e 2) (apply_fun cs 0 :e apply_fun Gfam alpha_first) Haf_conj). }
claim Hcs0_fam : apply_fun cs 0 :e apply_fun Gfam alpha_first.
{ exact (andER (alpha_first :e 2) (apply_fun cs 0 :e apply_fun Gfam alpha_first) Haf_conj). }
claim Hcs0_ne_e : apply_fun cs 0 <> e.
{ claim Hefam_af : apply_fun efam alpha_first = e.
  { rewrite (apply_fun_graph 2 (fun _:set => e) alpha_first Haf2). reflexivity. }
  assume H : apply_fun cs 0 = e. apply Hcs0_ne_efam. rewrite Hefam_af. exact H. }
(** Case split on alpha_first **)
apply (xm (alpha_first = 0)).
- assume Haf0 : alpha_first = 0.
  (** cs(0) in G1 (same factor as x): use prepend argument **)
  claim Hcs0_G1 : apply_fun cs 0 :e G1.
  { claim Hfam_af0 : apply_fun Gfam alpha_first = G1.
    { rewrite Haf0. exact HGfam0. }
    rewrite <- Hfam_af0. exact Hcs0_fam. }
  claim Hws0_cs0 : apply_fun ws 0 = apply_fun cs 0.
  { exact (Hws_agree 0 H0_in_m). }
  exact (ex68_3_case_G2_first_G1 G mult e inv G1 G2 c x m cs k ws
    Hfp HcG HxG1 HyG2 Hyne Hxne Hcxne Hred Hmne Hprod Hm_eq Hk_nat Hcsk_G2
    Hcs0_G1 Hcs0_ne_e Hws_red Hwp_cx Hws0_cs0).
- assume Haf_ne0 : alpha_first <> 0.
  (** cs(0) in G2 (same factor as y): use merge argument **)
  claim Haf1 : alpha_first = 1.
  { apply (ordsuccE 1 alpha_first Haf2).
    + assume H : alpha_first :e 1. apply (ordsuccE 0 alpha_first H).
      * assume H2 : alpha_first :e 0. exact (EmptyE alpha_first H2 (alpha_first = 1)).
      * assume H2 : alpha_first = 0. exact (Haf_ne0 H2 (alpha_first = 1)).
    + assume H : alpha_first = 1. exact H. }
  claim Hcs0_G2 : apply_fun cs 0 :e G2.
  { claim Hfam_af1 : apply_fun Gfam alpha_first = G2.
    { rewrite Haf1. exact HGfam1. }
    rewrite <- Hfam_af1. exact Hcs0_fam. }
  exact (ex68_3_case_G2_first_G2 G mult e inv G1 G2 c x m cs k ws
    Hfp HcG HxG1 HyG2 Hyne Hxne Hcxne Hred Hmne Hprod Hm_eq Hk_nat Hcsk_G2
    Hcs0_G2 Hws_red Hwp_cx).
Qed.

(** Sub-helper: Case last in G1, first in G1 - prepend y to build long word **)
Lemma ex68_3_case_G1_first_G1 : forall G mult e inv G1 G2 c x m cs k:set,
  free_product_of_subgroups G mult e inv 2
    (graph 2 (fun i:set => If_i (i = 0) G1 G2))
    (graph 2 (fun _:set => e)) ->
  c :e G -> x :e G1 ->
  apply_fun mult (apply_fun mult (c, x), apply_fun inv c) :e G2 ->
  apply_fun mult (apply_fun mult (c, x), apply_fun inv c) <> e ->
  x <> e ->
  apply_fun mult (c, x) <> e ->
  reduced_word 2 (graph 2 (fun i:set => If_i (i = 0) G1 G2))
    (graph 2 (fun _:set => e)) m cs ->
  m <> 0 -> word_product mult e cs m = c ->
  m = ordsucc k -> nat_p k ->
  apply_fun cs k :e G1 ->
  apply_fun cs 0 :e G1 ->
  False.
let G mult e inv G1 G2 c x m cs k.
set Gfam := graph 2 (fun i:set => If_i (i = 0) G1 G2).
set efam := graph 2 (fun _:set => e).
assume Hfp : free_product_of_subgroups G mult e inv 2 Gfam efam.
assume HcG : c :e G. assume HxG1 : x :e G1.
set y := apply_fun mult (apply_fun mult (c, x), apply_fun inv c).
assume HyG2 : y :e G2.
assume Hyne : y <> e. assume Hxne : x <> e.
assume Hcxne : apply_fun mult (c, x) <> e.
assume Hred : reduced_word 2 Gfam efam m cs.
assume Hmne : m <> 0. assume Hprod : word_product mult e cs m = c.
assume Hm_eq : m = ordsucc k. assume Hk_nat : nat_p k.
assume Hcsk_G1 : apply_fun cs k :e G1.
assume Hcs0_G1 : apply_fun cs 0 :e G1.
prove False.
(** Extract free product components **)
apply (and6E
  (group_structure G mult e inv)
  (forall alpha:set, alpha :e 2 -> subgroup_of (apply_fun Gfam alpha) G mult e inv)
  (forall alpha beta:set, alpha :e 2 -> beta :e 2 -> alpha <> beta ->
    forall z:set, z :e apply_fun Gfam alpha -> z :e apply_fun Gfam beta -> z = e)
  (subgroups_generate G mult e inv 2 Gfam)
  (forall z:set, z :e G -> z <> e ->
    exists n xs:set,
      reduced_word 2 Gfam efam n xs /\ n <> 0 /\
      word_product mult e xs n = z /\
      (forall n' xs':set,
        reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
        word_product mult e xs' n' = z ->
        n = n' /\ (forall i:set, i :e n -> apply_fun xs i = apply_fun xs' i)))
  (forall alpha:set, alpha :e 2 -> apply_fun efam alpha = e)
  Hfp).
assume Hgrp Hsub Hinter Hgen Hunique _.
claim H00 : 0 = 0. { reflexivity. }
claim HGfam0 : apply_fun Gfam 0 = G1.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 0 In_0_2).
  exact (If_i_1 (0 = 0) G1 G2 H00). }
claim HGfam1 : apply_fun Gfam 1 = G2.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 1 In_1_2).
  exact (If_i_0 (1 = 0) G1 G2 neq_1_0). }
claim HsubG1 : subgroup_of G1 G mult e inv.
{ rewrite <- HGfam0. exact (Hsub 0 In_0_2). }
claim HsubG2 : subgroup_of G2 G mult e inv.
{ rewrite <- HGfam1. exact (Hsub 1 In_1_2). }
apply (and4E (G1 c= G) (e :e G1)
  (forall x1 y1:set, x1 :e G1 -> y1 :e G1 -> apply_fun mult (x1, y1) :e G1)
  (forall x1:set, x1 :e G1 -> apply_fun inv x1 :e G1) HsubG1).
assume HG1sub HeG1 HG1mult HG1inv.
apply (and4E (G2 c= G) (e :e G2)
  (forall x1 y1:set, x1 :e G2 -> y1 :e G2 -> apply_fun mult (x1, y1) :e G2)
  (forall x1:set, x1 :e G2 -> apply_fun inv x1 :e G2) HsubG2).
assume HG2sub HeG2 HG2mult HG2inv.
apply (and6E
  (function_on mult (setprod G G) G) (function_on inv G G) (e :e G)
  (forall x1 y1 z1:set, x1 :e G -> y1 :e G -> z1 :e G ->
    apply_fun mult (apply_fun mult (x1, y1), z1) = apply_fun mult (x1, apply_fun mult (y1, z1)))
  (forall x1:set, x1 :e G -> apply_fun mult (e, x1) = x1 /\ apply_fun mult (x1, e) = x1)
  (forall x1:set, x1 :e G ->
    apply_fun mult (x1, apply_fun inv x1) = e /\ apply_fun mult (apply_fun inv x1, x1) = e)
  Hgrp).
assume HmultF HinvF HeG Hassoc Hid Hinverse.
apply (and3E
  (m :e omega)
  (forall i:set, i :e m ->
    exists alpha:set, alpha :e 2 /\
      apply_fun cs i :e apply_fun Gfam alpha /\
      apply_fun cs i <> apply_fun efam alpha)
  (forall i:set, i :e m -> ordsucc i :e m ->
    forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
      apply_fun cs i :e apply_fun Gfam alpha ->
      apply_fun cs (ordsucc i) :e apply_fun Gfam beta -> alpha <> beta)
  Hred).
assume Hm_omega Hcs_mem Hcs_adj.
claim Hmult_cl : forall x1 y1:set, x1 :e G -> y1 :e G -> apply_fun mult (x1, y1) :e G.
{ let x1 y1. assume Hx1 : x1 :e G. assume Hy1 : y1 :e G.
  exact (HmultF (x1, y1) (tuple_2_setprod_by_pair_Sigma G G x1 y1 Hx1 Hy1)). }
claim HxG : x :e G. { exact (HG1sub x HxG1). }
claim HyG : y :e G. { exact (HG2sub y HyG2). }
claim HcxG : apply_fun mult (c, x) :e G. { exact (Hmult_cl c x HcG HxG). }
claim HinvcG : apply_fun inv c :e G. { exact (HinvF c HcG). }
claim Hm_nat : nat_p m. { exact (omega_nat_p m Hm_omega). }
claim Hk_in_m : k :e m. { rewrite Hm_eq. exact (ordsuccI2 k). }
claim H0_in_m : 0 :e m. { rewrite Hm_eq. exact (nat_0_in_ordsucc k Hk_nat). }
claim Hsm_omega : ordsucc m :e omega. { exact (omega_ordsucc m Hm_omega). }
(** Derive cx = yc **)
claim Hcx_eq_yc : apply_fun mult (c, x) = apply_fun mult (y, c).
{ claim H1 : apply_fun mult (apply_fun inv c, c) = e.
  { exact (andER (apply_fun mult (c, apply_fun inv c) = e)
      (apply_fun mult (apply_fun inv c, c) = e) (Hinverse c HcG)). }
  claim H2 : apply_fun mult (apply_fun mult (c, x), e) = apply_fun mult (c, x).
  { exact (andER (apply_fun mult (e, apply_fun mult (c, x)) = apply_fun mult (c, x))
      (apply_fun mult (apply_fun mult (c, x), e) = apply_fun mult (c, x))
      (Hid (apply_fun mult (c, x)) HcxG)). }
  rewrite (Hassoc (apply_fun mult (c, x)) (apply_fun inv c) c HcxG HinvcG HcG).
  rewrite H1. symmetry. exact H2. }
(** Build ws = [y, cs(0), ..., cs(k)] of length ordsucc m **)
set ws := graph (ordsucc m) (fun i:set => If_i (i = 0) y (apply_fun cs (Eps_i (fun j:set => i = ordsucc j)))).
claim Hws_0 : apply_fun ws 0 = y.
{ rewrite (apply_fun_graph (ordsucc m) (fun i:set => If_i (i = 0) y (apply_fun cs (Eps_i (fun j:set => i = ordsucc j))))
    0 (nat_0_in_ordsucc m Hm_nat)).
  exact (If_i_1 (0 = 0) y (apply_fun cs (Eps_i (fun j:set => 0 = ordsucc j))) H00). }
claim Hws_succ : forall j:set, j :e m -> apply_fun ws (ordsucc j) = apply_fun cs j.
{ let j. assume Hjm : j :e m.
  claim Hsj_sm : ordsucc j :e ordsucc m.
  { exact (nat_ordsucc_in_ordsucc m Hm_nat j Hjm). }
  rewrite (apply_fun_graph (ordsucc m) (fun i:set => If_i (i = 0) y (apply_fun cs (Eps_i (fun j0:set => i = ordsucc j0))))
    (ordsucc j) Hsj_sm).
  rewrite (If_i_0 (ordsucc j = 0) y (apply_fun cs (Eps_i (fun j0:set => ordsucc j = ordsucc j0))) (neq_ordsucc_0 j)).
  claim Heps : Eps_i (fun j0:set => ordsucc j = ordsucc j0) = j.
  { claim Hpj : ordsucc j = ordsucc j. { reflexivity. }
    claim Huniq : forall j1:set, ordsucc j = ordsucc j1 -> j1 = j.
    { let j1. assume Hsjeqsj1 : ordsucc j = ordsucc j1.
      claim Hjeqj1 : j = j1. { exact (ordsucc_inj j j1 Hsjeqsj1). }
      symmetry. exact Hjeqj1. }
    exact (Eps_i_unique (fun j0:set => ordsucc j = ordsucc j0) j Hpj Huniq). }
  rewrite Heps. reflexivity. }
(** Word product ws (ordsucc m) = mult(y, c) = cx **)
claim Htail_agree : forall j:set, j :e m -> apply_fun ws (ordsucc j) = apply_fun cs j.
{ let j. assume Hjm : j :e m. exact (Hws_succ j Hjm). }
claim Hws0_G : apply_fun ws 0 :e G. { rewrite Hws_0. exact HyG. }
claim Hcs_G : forall j:set, j :e m -> apply_fun cs j :e G.
{ let j. assume Hjm : j :e m.
  apply (exandE_i
    (fun al:set => al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
    (fun al:set => apply_fun cs j <> apply_fun efam al) (Hcs_mem j Hjm)).
  let al. assume Hal_conj : al :e 2 /\ apply_fun cs j :e apply_fun Gfam al.
  assume Hne.
  claim Hal2 : al :e 2.
  { exact (andEL (al :e 2) (apply_fun cs j :e apply_fun Gfam al) Hal_conj). }
  claim Hcsj_fam : apply_fun cs j :e apply_fun Gfam al.
  { exact (andER (al :e 2) (apply_fun cs j :e apply_fun Gfam al) Hal_conj). }
  apply (xm (al = 0)).
  - assume Hal0 : al = 0.
    claim Hcsj_G1 : apply_fun cs j :e G1.
    { claim Hfam_al : apply_fun Gfam al = G1. { rewrite Hal0. exact HGfam0. }
      rewrite <- Hfam_al. exact Hcsj_fam. }
    exact (HG1sub (apply_fun cs j) Hcsj_G1).
  - assume Hal_ne0 : al <> 0.
    claim Hal1 : al = 1.
    { apply (ordsuccE 1 al Hal2).
      { assume H : al :e 1. apply (ordsuccE 0 al H).
        { assume H2 : al :e 0. exact (EmptyE al H2 (al = 1)). }
        assume H2 : al = 0. exact (Hal_ne0 H2 (al = 1)). }
      assume H : al = 1. exact H. }
    claim Hcsj_G2 : apply_fun cs j :e G2.
    { claim Hfam_al : apply_fun Gfam al = G2. { rewrite Hal1. exact HGfam1. }
      rewrite <- Hfam_al. exact Hcsj_fam. }
    exact (HG2sub (apply_fun cs j) Hcsj_G2). }
claim Hwp_ws_prepend : word_product mult e ws (ordsucc m) =
  apply_fun mult (apply_fun ws 0, word_product mult e cs m).
{ exact (word_product_prepend mult e G m cs ws HeG Hid Hmult_cl Hassoc
    Hws0_G (nat_p_omega m Hm_nat) Hcs_G Htail_agree). }
claim Hwp_ws : word_product mult e ws (ordsucc m) = apply_fun mult (c, x).
{ rewrite Hwp_ws_prepend. rewrite Hws_0. rewrite Hprod.
  symmetry. exact Hcx_eq_yc. }
(** Show ws is reduced **)
claim Hefam0 : apply_fun efam 0 = e.
{ rewrite (apply_fun_graph 2 (fun _:set => e) 0 In_0_2). reflexivity. }
claim Hefam1 : apply_fun efam 1 = e.
{ rewrite (apply_fun_graph 2 (fun _:set => e) 1 In_1_2). reflexivity. }
claim Hws_mem : forall i:set, i :e ordsucc m ->
  exists alpha:set, alpha :e 2 /\
    apply_fun ws i :e apply_fun Gfam alpha /\
    apply_fun ws i <> apply_fun efam alpha.
{ let i. assume Hi : i :e ordsucc m.
  apply (ordsuccE m i Hi).
  - assume Him : i :e m.
    (** i is a successor since i :e m = ordsucc k **)
    claim Hi_nat : nat_p i. { exact (omega_nat_p i (omega_TransSet m Hm_omega i Him)). }
    apply (nat_inv i Hi_nat).
    + assume Hi0 : i = 0.
      (** ws(0) = y in G2 = Gfam(1) **)
      witness 1. apply and3I.
      * exact In_1_2.
      * rewrite Hi0. rewrite Hws_0. rewrite HGfam1. exact HyG2.
      * rewrite Hi0. rewrite Hws_0. rewrite Hefam1. exact Hyne.
    + assume Hex : exists j:set, nat_p j /\ i = ordsucc j.
      apply Hex. let j. assume Hj_conj : nat_p j /\ i = ordsucc j.
      claim Hij : i = ordsucc j. { exact (andER (nat_p j) (i = ordsucc j) Hj_conj). }
      claim Hjm : j :e m.
      { claim Hi_in_sk : i :e ordsucc k. { rewrite <- Hm_eq. exact Him. }
        claim Hsj_in_sk : ordsucc j :e ordsucc k. { rewrite <- Hij. exact Hi_in_sk. }
        apply (ordsuccE k (ordsucc j) Hsj_in_sk).
        - assume Hsjk : ordsucc j :e k.
          claim Hjk : j :e k. { exact (nat_trans k Hk_nat (ordsucc j) Hsjk j (ordsuccI2 j)). }
          rewrite Hm_eq. exact (ordsuccI1 k j Hjk).
        - assume Hsjeqk : ordsucc j = k.
          claim Hj_sj : j :e ordsucc j. { exact (ordsuccI2 j). }
          claim Hjk : j :e k. { rewrite <- Hsjeqk. exact Hj_sj. }
          rewrite Hm_eq. exact (ordsuccI1 k j Hjk). }
      claim Hwsi_cs : apply_fun ws i = apply_fun cs j. { rewrite Hij. exact (Hws_succ j Hjm). }
      rewrite Hwsi_cs. exact (Hcs_mem j Hjm).
  - assume Hieqm : i = m.
    (** ws(m) = cs(k) in G1 = Gfam(0) **)
    claim Hk_in_m2 : k :e m. { exact Hk_in_m. }
    claim Hwsm_csk : apply_fun ws m = apply_fun cs k.
    { exact (Hm_eq (fun _ b:set => apply_fun ws b = apply_fun cs k) (Hws_succ k Hk_in_m2)). }
    claim Hwsi_csk : apply_fun ws i = apply_fun cs k.
    { rewrite Hieqm. exact Hwsm_csk. }
    witness 0. apply and3I.
    + exact In_0_2.
    + rewrite Hwsi_csk. rewrite HGfam0. exact Hcsk_G1.
    + rewrite Hwsi_csk. rewrite Hefam0.
      apply (exandE_i
        (fun al:set => al :e 2 /\ apply_fun cs k :e apply_fun Gfam al)
        (fun al:set => apply_fun cs k <> apply_fun efam al) (Hcs_mem k Hk_in_m)).
      let al_k. assume Halk_conj : al_k :e 2 /\ apply_fun cs k :e apply_fun Gfam al_k.
      assume Hne_efam : apply_fun cs k <> apply_fun efam al_k.
      claim Halk2 : al_k :e 2.
      { exact (andEL (al_k :e 2) (apply_fun cs k :e apply_fun Gfam al_k) Halk_conj). }
      claim Hefam_al : apply_fun efam al_k = e.
      { rewrite (apply_fun_graph 2 (fun _:set => e) al_k Halk2). reflexivity. }
      assume Habs : apply_fun cs k = e.
      apply Hne_efam. rewrite Hefam_al. exact Habs. }
claim Hws_adj : forall i:set, i :e ordsucc m -> ordsucc i :e ordsucc m ->
  forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
    apply_fun ws i :e apply_fun Gfam alpha ->
    apply_fun ws (ordsucc i) :e apply_fun Gfam beta ->
    alpha <> beta.
{ let i. assume Hi : i :e ordsucc m. assume Hsi : ordsucc i :e ordsucc m.
  let alpha beta. assume Hal2 : alpha :e 2. assume Hbe2 : beta :e 2.
  assume Hwsi_al : apply_fun ws i :e apply_fun Gfam alpha.
  assume Hwssi_be : apply_fun ws (ordsucc i) :e apply_fun Gfam beta.
  (** ordsucc i :e ordsucc m means ordsucc i :e m or ordsucc i = m **)
  apply (xm (i = 0)).
  - assume Hi0 : i = 0.
    (** ws(0) = y in G2 = Gfam(1), ws(1) = cs(0) in G1 = Gfam(0) **)
    assume Haleqbe : alpha = beta.
    claim Hwsi_y : apply_fun ws i = y. { rewrite Hi0. exact Hws_0. }
    claim Hy_al : y :e apply_fun Gfam alpha. { rewrite <- Hwsi_y. exact Hwsi_al. }
    claim Hy_Gfam1 : y :e apply_fun Gfam 1. { rewrite HGfam1. exact HyG2. }
    apply (xm (alpha = 1)).
    + assume Hal1 : alpha = 1.
      claim Hbe1 : beta = 1. { rewrite <- Haleqbe. exact Hal1. }
      claim Hwssi_cs0 : apply_fun ws (ordsucc i) = apply_fun cs 0.
      { rewrite Hi0. exact (Hws_succ 0 H0_in_m). }
      claim Hcs0_be : apply_fun cs 0 :e apply_fun Gfam beta.
      { rewrite <- Hwssi_cs0. exact Hwssi_be. }
      claim Hcs0_Gfam1 : apply_fun cs 0 :e apply_fun Gfam 1.
      { exact (Hbe1 (fun a _:set => apply_fun cs 0 :e apply_fun Gfam a) Hcs0_be). }
      claim Hcs0_G2 : apply_fun cs 0 :e G2.
      { rewrite <- HGfam1. exact Hcs0_Gfam1. }
      claim Hcs0_eq_e : apply_fun cs 0 = e.
      { exact (Hinter 0 1 In_0_2 In_1_2 neq_0_1 (apply_fun cs 0)
          (HGfam0 (fun _ b:set => apply_fun cs 0 :e b) Hcs0_G1)
          Hcs0_Gfam1). }
      (** cs(0) = e contradicts cs(0) being in reduced word **)
      apply (exandE_i
        (fun al:set => al :e 2 /\ apply_fun cs 0 :e apply_fun Gfam al)
        (fun al:set => apply_fun cs 0 <> apply_fun efam al) (Hcs_mem 0 H0_in_m)).
      let al0. assume Hal0_conj : al0 :e 2 /\ apply_fun cs 0 :e apply_fun Gfam al0.
      assume Hne_efam0 : apply_fun cs 0 <> apply_fun efam al0.
      claim Hal0_2 : al0 :e 2.
      { exact (andEL (al0 :e 2) (apply_fun cs 0 :e apply_fun Gfam al0) Hal0_conj). }
      claim Hefam_al0 : apply_fun efam al0 = e.
      { rewrite (apply_fun_graph 2 (fun _:set => e) al0 Hal0_2). reflexivity. }
      claim Hefam_al0_rev : e = apply_fun efam al0. { symmetry. exact Hefam_al0. }
      exact (Hne_efam0 (eq_i_tra (apply_fun cs 0) e (apply_fun efam al0)
        Hcs0_eq_e Hefam_al0_rev)).
    + assume Hal_ne1 : alpha <> 1.
      exact (Hyne (Hinter alpha 1 Hal2 In_1_2 Hal_ne1 y Hy_al Hy_Gfam1)).
  - assume Hi_ne0 : i <> 0.
    (** i = ordsucc j for some j, ws(i) = cs(j), ws(ordsucc i) = cs(j+1) **)
    claim Hi_nat : nat_p i.
    { exact (omega_nat_p i (omega_TransSet (ordsucc m) Hsm_omega i Hi)). }
    apply (nat_inv i Hi_nat).
    + assume Habs : i = 0. exact (Hi_ne0 Habs (alpha <> beta)).
    + assume Hex : exists j:set, nat_p j /\ i = ordsucc j.
      apply Hex. let j. assume Hj_conj : nat_p j /\ i = ordsucc j.
      claim Hij : i = ordsucc j. { exact (andER (nat_p j) (i = ordsucc j) Hj_conj). }
      (** Derive j :e m and ordsucc j :e m **)
      claim Him : i :e m.
      { claim Hsi_sm : ordsucc i :e ordsucc m. { exact Hsi. }
        apply (ordsuccE m (ordsucc i) Hsi_sm).
        - assume Hsim : ordsucc i :e m. exact (nat_trans m Hm_nat (ordsucc i) Hsim i (ordsuccI2 i)).
        - assume Hsieqm : ordsucc i = m. rewrite <- Hsieqm. exact (ordsuccI2 i). }
      claim Hjm : j :e m.
      { claim Hsjm2 : ordsucc j :e m.
        { exact (Hij (fun a _:set => a :e m) Him). }
        exact (nat_trans m Hm_nat (ordsucc j) Hsjm2 j (ordsuccI2 j)). }
      claim Hsjm : ordsucc j :e m. { rewrite <- Hij. exact Him. }
      claim Hwsi_cs : apply_fun ws i = apply_fun cs j.
      { rewrite Hij. exact (Hws_succ j Hjm). }
      claim Hcsj_al : apply_fun cs j :e apply_fun Gfam alpha.
      { rewrite <- Hwsi_cs. exact Hwsi_al. }
      (** ws(ordsucc i) = ws(ordsucc (ordsucc j)) = cs(ordsucc j) **)
      claim Hwssi_cs : apply_fun ws (ordsucc i) = apply_fun cs (ordsucc j).
      { rewrite Hij.
        claim Hsjm2 : ordsucc j :e m. { exact Hsjm. }
        exact (Hws_succ (ordsucc j) Hsjm2). }
      claim Hcssj_be : apply_fun cs (ordsucc j) :e apply_fun Gfam beta.
      { rewrite <- Hwssi_cs. exact Hwssi_be. }
      exact (Hcs_adj j Hjm Hsjm alpha beta Hal2 Hbe2 Hcsj_al Hcssj_be). }
claim Hws_red : reduced_word 2 Gfam efam (ordsucc m) ws.
{ prove (ordsucc m :e omega /\
    (forall i:set, i :e ordsucc m ->
      exists alpha:set, alpha :e 2 /\
        apply_fun ws i :e apply_fun Gfam alpha /\
        apply_fun ws i <> apply_fun efam alpha)) /\
    (forall i:set, i :e ordsucc m -> ordsucc i :e ordsucc m ->
      forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
        apply_fun ws i :e apply_fun Gfam alpha ->
        apply_fun ws (ordsucc i) :e apply_fun Gfam beta ->
        alpha <> beta).
  apply andI.
  - apply andI.
    + exact Hsm_omega.
    + exact Hws_mem.
  - exact Hws_adj. }
(** Now build merged word from cx direction **)
set cskx := apply_fun mult (apply_fun cs k, x).
claim Hcskx_G1 : cskx :e G1. { exact (HG1mult (apply_fun cs k) x Hcsk_G1 HxG1). }
(** Apply uniqueness to cx **)
apply (Hunique (apply_fun mult (c, x)) HcxG Hcxne).
let n_c. assume Hn_c_ex : exists xs_c:set,
  reduced_word 2 Gfam efam n_c xs_c /\ n_c <> 0 /\
  word_product mult e xs_c n_c = apply_fun mult (c, x) /\
  (forall n' xs':set,
    reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
    word_product mult e xs' n' = apply_fun mult (c, x) ->
    n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i)).
apply Hn_c_ex.
let xs_c. assume Hxsc_all :
  reduced_word 2 Gfam efam n_c xs_c /\ n_c <> 0 /\
  word_product mult e xs_c n_c = apply_fun mult (c, x) /\
  (forall n' xs':set,
    reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
    word_product mult e xs' n' = apply_fun mult (c, x) ->
    n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i)).
claim Huniq_clause : forall n' xs':set,
  reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
  word_product mult e xs' n' = apply_fun mult (c, x) ->
  n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i).
{ exact (andER
    ((reduced_word 2 Gfam efam n_c xs_c /\ n_c <> 0) /\ word_product mult e xs_c n_c = apply_fun mult (c, x))
    (forall n' xs':set,
      reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
      word_product mult e xs' n' = apply_fun mult (c, x) ->
      n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i))
    Hxsc_all). }
(** n_c = ordsucc m from ws **)
claim Hnc_sm : n_c = ordsucc m.
{ exact (andEL (n_c = ordsucc m)
    (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun ws i)
    (Huniq_clause (ordsucc m) ws Hws_red (neq_ordsucc_0 m) Hwp_ws)). }
(** Now build merged word from cx = mult(c, x) and get contradiction **)
(** cx = wp(cs,m) mult x = wp(cs, ordsucc k) mult x
    = mult(wp(cs,k), mult(cs(k),x)) = mult(wp(cs,k), cskx) **)
(** Case split on cskx = e **)
apply (xm (cskx = e)).
- assume Hcskx_e : cskx = e.
  (** cx = wp(cs, k) **)
  apply (xm (k = 0)).
  + assume Hk0 : k = 0.
    (** wp(cs, k) = wp(cs, 0) = e, so cx = e, contradiction **)
    claim Hwp_k0 : word_product mult e cs k = e.
    { rewrite Hk0. exact (nat_primrec_0 e (fun i r => apply_fun mult (r, apply_fun cs i))). }
    claim Hwp_m_step : word_product mult e cs m = apply_fun mult (word_product mult e cs k, apply_fun cs k).
    { rewrite Hm_eq.
      exact (nat_primrec_S e (fun i r => apply_fun mult (r, apply_fun cs i)) k Hk_nat). }
    claim Hc_decomp : c = apply_fun mult (word_product mult e cs k, apply_fun cs k).
    { claim Hprod_rev : c = word_product mult e cs m. { symmetry. exact Hprod. }
      exact (eq_i_tra c (word_product mult e cs m)
        (apply_fun mult (word_product mult e cs k, apply_fun cs k)) Hprod_rev Hwp_m_step). }
    claim Hcskx_mult : apply_fun mult (apply_fun cs k, x) = e. { exact Hcskx_e. }
    claim Hcsk_G : apply_fun cs k :e G. { exact (HG1sub (apply_fun cs k) Hcsk_G1). }
    claim Hwpk_G : word_product mult e cs k :e G.
    { exact (word_product_in_G mult e G k cs HeG Hmult_cl
        (nat_p_omega k Hk_nat)
        (fun j Hjk => Hcs_G j (nat_trans m Hm_nat k Hk_in_m j Hjk))). }
    claim Hcx_eq : apply_fun mult (c, x) =
      apply_fun mult (word_product mult e cs k, apply_fun mult (apply_fun cs k, x)).
    { rewrite Hc_decomp.
      exact (Hassoc (word_product mult e cs k) (apply_fun cs k) x Hwpk_G Hcsk_G HxG). }
    claim Hid_wpk : apply_fun mult (word_product mult e cs k, e) = word_product mult e cs k.
    { exact (andER
        (apply_fun mult (e, word_product mult e cs k) = word_product mult e cs k)
        (apply_fun mult (word_product mult e cs k, e) = word_product mult e cs k)
        (Hid (word_product mult e cs k) Hwpk_G)). }
    claim Hcx_wpk : apply_fun mult (c, x) = word_product mult e cs k.
    { rewrite Hcx_eq. rewrite Hcskx_e. exact Hid_wpk. }
    claim Hcx_e : apply_fun mult (c, x) = e.
    { exact (eq_i_tra (apply_fun mult (c, x)) (word_product mult e cs k) e Hcx_wpk Hwp_k0). }
    exact (Hcxne Hcx_e).
  + assume Hk_ne0 : k <> 0.
    (** Build init_cs = [cs(0),...,cs(k-1)] of length k **)
    (** This is a reduced word for cx of length k **)
    (** But n_c = ordsucc m = ordsucc (ordsucc k), so ordsucc (ordsucc k) = k **)
    (** Contradiction: ordsucc (ordsucc k) > k **)
    set init_cs := graph k (fun j:set => apply_fun cs j).
    claim Hinit_shift : forall j:set, j :e k -> apply_fun init_cs j = apply_fun cs j.
    { let j. assume Hjk : j :e k. exact (apply_fun_graph k (fun j:set => apply_fun cs j) j Hjk). }
    claim Hinit_mem : forall j:set, j :e k ->
      exists alpha:set, alpha :e 2 /\
        apply_fun init_cs j :e apply_fun Gfam alpha /\
        apply_fun init_cs j <> apply_fun efam alpha.
    { let j. assume Hjk : j :e k.
      claim Hjm2 : j :e m. { exact (nat_trans m Hm_nat k Hk_in_m j Hjk). }
      claim Hinit_eq : apply_fun init_cs j = apply_fun cs j. { exact (Hinit_shift j Hjk). }
      apply (Hcs_mem j Hjm2). let al.
      assume Hal_conj : (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al) /\
        apply_fun cs j <> apply_fun efam al.
      claim Hal2 : al :e 2.
      { exact (andEL (al :e 2) (apply_fun cs j :e apply_fun Gfam al)
          (andEL (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
            (apply_fun cs j <> apply_fun efam al) Hal_conj)). }
      claim Hcsj_fam : apply_fun cs j :e apply_fun Gfam al.
      { exact (andER (al :e 2) (apply_fun cs j :e apply_fun Gfam al)
          (andEL (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
            (apply_fun cs j <> apply_fun efam al) Hal_conj)). }
      claim Hcsj_ne : apply_fun cs j <> apply_fun efam al.
      { exact (andER (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
          (apply_fun cs j <> apply_fun efam al) Hal_conj). }
      witness al. apply and3I.
      - exact Hal2.
      - exact (Hinit_eq (fun _ b:set => b :e apply_fun Gfam al) Hcsj_fam).
      - exact (Hinit_eq (fun _ b:set => b <> apply_fun efam al) Hcsj_ne). }
    claim Hinit_adj : forall j:set, j :e k -> ordsucc j :e k ->
      forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
        apply_fun init_cs j :e apply_fun Gfam alpha ->
        apply_fun init_cs (ordsucc j) :e apply_fun Gfam beta ->
        alpha <> beta.
    { let j. assume Hjk : j :e k. assume Hsjk : ordsucc j :e k.
      let alpha beta. assume Hal2 : alpha :e 2. assume Hbe2 : beta :e 2.
      rewrite (Hinit_shift j Hjk). rewrite (Hinit_shift (ordsucc j) Hsjk).
      assume Hcsj_al : apply_fun cs j :e apply_fun Gfam alpha.
      assume Hcssj_be : apply_fun cs (ordsucc j) :e apply_fun Gfam beta.
      claim Hjm : j :e m. { exact (nat_trans m Hm_nat k Hk_in_m j Hjk). }
      claim Hsjm : ordsucc j :e m. { exact (nat_trans m Hm_nat k Hk_in_m (ordsucc j) Hsjk). }
      exact (Hcs_adj j Hjm Hsjm alpha beta Hal2 Hbe2 Hcsj_al Hcssj_be). }
    claim Hinit_red : reduced_word 2 Gfam efam k init_cs.
    { prove (k :e omega /\
        (forall j:set, j :e k ->
          exists alpha:set, alpha :e 2 /\
            apply_fun init_cs j :e apply_fun Gfam alpha /\
            apply_fun init_cs j <> apply_fun efam alpha)) /\
        (forall j:set, j :e k -> ordsucc j :e k ->
          forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
            apply_fun init_cs j :e apply_fun Gfam alpha ->
            apply_fun init_cs (ordsucc j) :e apply_fun Gfam beta ->
            alpha <> beta).
      apply andI.
      - apply andI.
        + exact (nat_p_omega k Hk_nat).
        + exact Hinit_mem.
      - exact Hinit_adj. }
    (** Word product init_cs k = cx **)
    claim Hwp_m_step : word_product mult e cs m =
      apply_fun mult (word_product mult e cs k, apply_fun cs k).
    { rewrite Hm_eq.
      exact (nat_primrec_S e (fun i r => apply_fun mult (r, apply_fun cs i)) k Hk_nat). }
    claim Hcsk_G : apply_fun cs k :e G. { exact (HG1sub (apply_fun cs k) Hcsk_G1). }
    claim Hwpk_G : word_product mult e cs k :e G.
    { exact (word_product_in_G mult e G k cs HeG Hmult_cl
        (nat_p_omega k Hk_nat)
        (fun j Hjk => Hcs_G j (nat_trans m Hm_nat k Hk_in_m j Hjk))). }
    claim Hcx_eq : apply_fun mult (c, x) =
      apply_fun mult (word_product mult e cs k, cskx).
    { claim Hc_eq : c = apply_fun mult (word_product mult e cs k, apply_fun cs k).
      { claim Hprod_rev : c = word_product mult e cs m. { symmetry. exact Hprod. }
        exact (eq_i_tra c (word_product mult e cs m)
          (apply_fun mult (word_product mult e cs k, apply_fun cs k)) Hprod_rev Hwp_m_step). }
      rewrite Hc_eq.
      exact (Hassoc (word_product mult e cs k) (apply_fun cs k) x Hwpk_G Hcsk_G HxG). }
    claim Hid_wpk : apply_fun mult (word_product mult e cs k, e) = word_product mult e cs k.
    { exact (andER
        (apply_fun mult (e, word_product mult e cs k) = word_product mult e cs k)
        (apply_fun mult (word_product mult e cs k, e) = word_product mult e cs k)
        (Hid (word_product mult e cs k) Hwpk_G)). }
    claim Hcx_wpk : apply_fun mult (c, x) = word_product mult e cs k.
    { rewrite Hcx_eq. rewrite Hcskx_e. exact Hid_wpk. }
    claim Hwp_init_cs : word_product mult e init_cs k = word_product mult e cs k.
    { exact (word_product_agree mult e init_cs cs k (nat_p_omega k Hk_nat) Hinit_shift). }
    claim Hwp_init_cx : word_product mult e init_cs k = apply_fun mult (c, x).
    { claim Hcx_wpk_rev : word_product mult e cs k = apply_fun mult (c, x). { symmetry. exact Hcx_wpk. }
      exact (eq_i_tra (word_product mult e init_cs k) (word_product mult e cs k)
        (apply_fun mult (c, x)) Hwp_init_cs Hcx_wpk_rev). }
    (** Uniqueness gives n_c = k **)
    claim Hnc_k : n_c = k.
    { exact (andEL (n_c = k)
        (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun init_cs i)
        (Huniq_clause k init_cs Hinit_red Hk_ne0 Hwp_init_cx)). }
    (** Contradiction: ordsucc m = k and m = ordsucc k **)
    claim Hnc_sm_rev : ordsucc m = n_c. { symmetry. exact Hnc_sm. }
    claim Hsm_eq_k : ordsucc m = k.
    { exact (eq_i_tra (ordsucc m) n_c k Hnc_sm_rev Hnc_k). }
    claim Hsk_eq_k : ordsucc (ordsucc k) = k.
    { claim Hord_sm : ordsucc (ordsucc k) = ordsucc m. { rewrite Hm_eq. reflexivity. }
      exact (eq_i_tra (ordsucc (ordsucc k)) (ordsucc m) k Hord_sm Hsm_eq_k). }
    claim Hsk_in_ssk : ordsucc k :e ordsucc (ordsucc k). { exact (ordsuccI2 (ordsucc k)). }
    claim Hsk_in_k : ordsucc k :e k.
    { exact (Hsk_eq_k (fun a _:set => ordsucc k :e a) Hsk_in_ssk). }
    exact (In_irref k (nat_trans k Hk_nat (ordsucc k) Hsk_in_k k (ordsuccI2 k))).
- assume Hcskx_ne : cskx <> e.
  (** Build merged_cs = [cs(0),...,cs(k-1), cskx] of length m **)
  set merged_cs := graph m (fun j:set => If_i (j = k) cskx (apply_fun cs j)).
  claim Hmerged_k : apply_fun merged_cs k = cskx.
  { claim Hkk : k = k. { reflexivity. }
    rewrite (apply_fun_graph m (fun j:set => If_i (j = k) cskx (apply_fun cs j)) k Hk_in_m).
    exact (If_i_1 (k = k) cskx (apply_fun cs k) Hkk). }
  claim Hmerged_agree : forall j:set, j :e m -> j <> k -> apply_fun merged_cs j = apply_fun cs j.
  { let j. assume Hjm : j :e m. assume Hjnek : j <> k.
    rewrite (apply_fun_graph m (fun j:set => If_i (j = k) cskx (apply_fun cs j)) j Hjm).
    exact (If_i_0 (j = k) cskx (apply_fun cs j) Hjnek). }
  (** Word product of merged_cs = cx **)
  claim Hwp_merged_sk : word_product mult e merged_cs (ordsucc k) =
    apply_fun mult (word_product mult e merged_cs k, apply_fun merged_cs k).
  { exact (nat_primrec_S e (fun i r => apply_fun mult (r, apply_fun merged_cs i)) k Hk_nat). }
  claim Hmerged_wp_step : word_product mult e merged_cs m =
    apply_fun mult (word_product mult e merged_cs k, apply_fun merged_cs k).
  { exact (Hm_eq (fun _ b:set => word_product mult e merged_cs b =
      apply_fun mult (word_product mult e merged_cs k, apply_fun merged_cs k)) Hwp_merged_sk). }
  claim Hinit_agree : forall j:set, j :e k -> apply_fun merged_cs j = apply_fun cs j.
  { let j. assume Hjk : j :e k.
    exact (Hmerged_agree j (nat_trans m Hm_nat k Hk_in_m j Hjk)
      (fun Hjek : j = k => In_irref k (Hjek (fun a _:set => a :e k) Hjk))). }
  claim Hwp_merged_k : word_product mult e merged_cs k = word_product mult e cs k.
  { exact (word_product_agree mult e merged_cs cs k (nat_p_omega k Hk_nat) Hinit_agree). }
  claim Hwpk_G : word_product mult e cs k :e G.
  { exact (word_product_in_G mult e G k cs HeG Hmult_cl
      (nat_p_omega k Hk_nat)
      (fun j Hjk => Hcs_G j (nat_trans m Hm_nat k Hk_in_m j Hjk))). }
  claim Hcsk_G : apply_fun cs k :e G. { exact (HG1sub (apply_fun cs k) Hcsk_G1). }
  claim Hwp_m_step : word_product mult e cs m =
    apply_fun mult (word_product mult e cs k, apply_fun cs k).
  { rewrite Hm_eq.
    exact (nat_primrec_S e (fun i r => apply_fun mult (r, apply_fun cs i)) k Hk_nat). }
  claim Hc_eq : c = apply_fun mult (word_product mult e cs k, apply_fun cs k).
  { claim Hprod_rev : c = word_product mult e cs m. { symmetry. exact Hprod. }
    exact (eq_i_tra c (word_product mult e cs m)
      (apply_fun mult (word_product mult e cs k, apply_fun cs k)) Hprod_rev Hwp_m_step). }
  claim Hcx_eq : apply_fun mult (c, x) = apply_fun mult (word_product mult e cs k, cskx).
  { rewrite Hc_eq.
    exact (Hassoc (word_product mult e cs k) (apply_fun cs k) x Hwpk_G Hcsk_G HxG). }
  claim Hwp_merged_cx : word_product mult e merged_cs m = apply_fun mult (c, x).
  { rewrite Hmerged_wp_step. rewrite Hmerged_k. rewrite Hwp_merged_k.
    symmetry. exact Hcx_eq. }
  (** Show merged_cs is reduced **)
  claim Hmerged_mem : forall j:set, j :e m ->
    exists alpha:set, alpha :e 2 /\
      apply_fun merged_cs j :e apply_fun Gfam alpha /\
      apply_fun merged_cs j <> apply_fun efam alpha.
  { let j. assume Hjm : j :e m.
    apply (xm (j = k)).
    - assume Hjk : j = k.
      rewrite Hjk. rewrite Hmerged_k.
      witness 0. apply and3I.
      + exact In_0_2.
      + rewrite HGfam0. exact Hcskx_G1.
      + rewrite Hefam0. exact Hcskx_ne.
    - assume Hjnek : j <> k.
      rewrite (Hmerged_agree j Hjm Hjnek). exact (Hcs_mem j Hjm). }
  claim Hmerged_adj : forall j:set, j :e m -> ordsucc j :e m ->
    forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
      apply_fun merged_cs j :e apply_fun Gfam alpha ->
      apply_fun merged_cs (ordsucc j) :e apply_fun Gfam beta ->
      alpha <> beta.
  { let j. assume Hjm : j :e m. assume Hsjm : ordsucc j :e m.
    let alpha beta. assume Hal2 : alpha :e 2. assume Hbe2 : beta :e 2.
    assume Hmj_al : apply_fun merged_cs j :e apply_fun Gfam alpha.
    assume Hmsj_be : apply_fun merged_cs (ordsucc j) :e apply_fun Gfam beta.
    (** Neither j nor ordsucc j can be k since ordsucc j :e m = ordsucc k means ordsucc j :e ordsucc k **)
    (** ordsucc j :e ordsucc k means ordsucc j :e k or ordsucc j = k **)
    apply (xm (ordsucc j = k)).
    - assume Hsjk : ordsucc j = k.
      (** j is just before k; merged_cs(j) = cs(j), merged_cs(ordsucc j) = merged_cs(k) = cskx **)
      claim Hjnek : j <> k.
      { assume Hjek : j = k.
        claim Hsjsk : ordsucc j = ordsucc k.
        { rewrite Hjek. reflexivity. }
        claim Hsj_eq_m : ordsucc j = m.
        { rewrite Hsjsk. symmetry. exact Hm_eq. }
        exact (In_irref m (Hsj_eq_m (fun a _:set => a :e m) Hsjm)). }
      claim Hmerged_j_eq : apply_fun merged_cs j = apply_fun cs j. { exact (Hmerged_agree j Hjm Hjnek). }
      claim Hmerged_sj_eq : apply_fun merged_cs (ordsucc j) = cskx.
      { rewrite (apply_fun_graph m (fun j:set => If_i (j = k) cskx (apply_fun cs j)) (ordsucc j) Hsjm).
        exact (If_i_1 (ordsucc j = k) cskx (apply_fun cs (ordsucc j)) Hsjk). }
      claim Hcsj_al : apply_fun cs j :e apply_fun Gfam alpha.
      { exact (Hmerged_j_eq (fun a _:set => a :e apply_fun Gfam alpha) Hmj_al). }
      claim Hcskx_be : cskx :e apply_fun Gfam beta.
      { exact (Hmerged_sj_eq (fun a _:set => a :e apply_fun Gfam beta) Hmsj_be). }
      assume Haleqbe : alpha = beta.
      (** alpha = beta, cs(j) in Gfam(alpha), cskx in Gfam(beta) = Gfam(alpha) **)
      (** cs(k) in G1 = Gfam(0), and by Hcs_adj j: alpha <> factor of cs(ordsucc j) = cs(k) **)
      claim Hcsk_Gfam0 : apply_fun cs k :e apply_fun Gfam 0.
      { rewrite HGfam0. exact Hcsk_G1. }
      claim Hsjm2 : ordsucc j :e m. { exact Hsjm. }
      claim Hcssk_Gfam0 : apply_fun cs (ordsucc j) :e apply_fun Gfam 0.
      { rewrite Hsjk. exact Hcsk_Gfam0. }
      claim Hal_ne_0 : alpha <> 0.
      { exact (Hcs_adj j Hjm Hsjm2 alpha 0 Hal2 In_0_2 Hcsj_al Hcssk_Gfam0). }
      (** cskx in Gfam(beta) and G1 = Gfam(0). If beta <> 0, cskx in Gfam(beta) inter Gfam(0) = {e}. **)
      claim Hbe_ne_0 : beta <> 0.
      { rewrite <- Haleqbe. exact Hal_ne_0. }
      claim Hcskx_Gfam0 : cskx :e apply_fun Gfam 0. { rewrite HGfam0. exact Hcskx_G1. }
      exact (Hcskx_ne (Hinter beta 0 Hbe2 In_0_2 Hbe_ne_0 cskx Hcskx_be Hcskx_Gfam0)).
    - assume Hsjnek : ordsucc j <> k.
      (** Both j and ordsucc j are < k, so merged_cs agrees with cs **)
      claim Hjnek : j <> k.
      { assume Hjek : j = k.
        claim Hsjsk : ordsucc j = ordsucc k.
        { rewrite Hjek. reflexivity. }
        claim Hsj_eq_m : ordsucc j = m. { rewrite Hsjsk. symmetry. exact Hm_eq. }
        exact (In_irref m (Hsj_eq_m (fun a _:set => a :e m) Hsjm)). }
      claim Hmerged_j_eq2 : apply_fun merged_cs j = apply_fun cs j. { exact (Hmerged_agree j Hjm Hjnek). }
      claim Hmerged_sj_eq2 : apply_fun merged_cs (ordsucc j) = apply_fun cs (ordsucc j).
      { exact (Hmerged_agree (ordsucc j) Hsjm Hsjnek). }
      claim Hcsj_al : apply_fun cs j :e apply_fun Gfam alpha.
      { exact (Hmerged_j_eq2 (fun a _:set => a :e apply_fun Gfam alpha) Hmj_al). }
      claim Hcssj_be : apply_fun cs (ordsucc j) :e apply_fun Gfam beta.
      { exact (Hmerged_sj_eq2 (fun a _:set => a :e apply_fun Gfam beta) Hmsj_be). }
      exact (Hcs_adj j Hjm Hsjm alpha beta Hal2 Hbe2 Hcsj_al Hcssj_be). }
  claim Hmerged_red : reduced_word 2 Gfam efam m merged_cs.
  { prove (m :e omega /\
      (forall j:set, j :e m ->
        exists alpha:set, alpha :e 2 /\
          apply_fun merged_cs j :e apply_fun Gfam alpha /\
          apply_fun merged_cs j <> apply_fun efam alpha)) /\
      (forall j:set, j :e m -> ordsucc j :e m ->
        forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
          apply_fun merged_cs j :e apply_fun Gfam alpha ->
          apply_fun merged_cs (ordsucc j) :e apply_fun Gfam beta ->
          alpha <> beta).
    apply andI.
    - apply andI.
      + exact Hm_omega.
      + exact Hmerged_mem.
    - exact Hmerged_adj. }
  (** Uniqueness: n_c = m, but n_c = ordsucc m. Contradiction. **)
  claim Hnc_m : n_c = m.
  { exact (andEL (n_c = m)
      (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun merged_cs i)
      (Huniq_clause m merged_cs Hmerged_red Hmne Hwp_merged_cx)). }
  claim Hnc_m_rev : m = n_c. { symmetry. exact Hnc_m. }
  claim Hm_eq_sm : m = ordsucc m.
  { exact (eq_i_tra m n_c (ordsucc m) Hnc_m_rev Hnc_sm). }
  claim Hm_in_sm : m :e ordsucc m. { exact (ordsuccI2 m). }
  claim Hm_in_m : m :e m.
  { exact (Hm_eq_sm (fun _ b:set => m :e b) Hm_in_sm). }
  exact (In_irref m Hm_in_m).
Qed.

(** Sub-sub-helper: Both cskx and ycs0 nonzero in the G1-first-G2 case **)
(** Build back-merged and front-merged words of length m, uniqueness gives x = e **)
Lemma ex68_3_case_G1_first_G2_both_ne : forall G mult e inv G1 G2 c x m cs k:set,
  free_product_of_subgroups G mult e inv 2
    (graph 2 (fun i:set => If_i (i = 0) G1 G2))
    (graph 2 (fun _:set => e)) ->
  c :e G -> x :e G1 ->
  apply_fun mult (apply_fun mult (c, x), apply_fun inv c) :e G2 ->
  apply_fun mult (apply_fun mult (c, x), apply_fun inv c) <> e ->
  x <> e -> apply_fun mult (c, x) <> e ->
  reduced_word 2 (graph 2 (fun i:set => If_i (i = 0) G1 G2))
    (graph 2 (fun _:set => e)) m cs ->
  m <> 0 -> word_product mult e cs m = c ->
  m = ordsucc k -> nat_p k ->
  apply_fun cs k :e G1 ->
  apply_fun cs 0 :e G2 ->
  apply_fun mult (apply_fun cs k, x) <> e ->
  apply_fun mult (apply_fun mult (apply_fun mult (c, x), apply_fun inv c), apply_fun cs 0) <> e ->
  False.
let G mult e inv G1 G2 c x m cs k.
set Gfam := graph 2 (fun i:set => If_i (i = 0) G1 G2).
set efam := graph 2 (fun _:set => e).
assume Hfp : free_product_of_subgroups G mult e inv 2 Gfam efam.
assume HcG : c :e G. assume HxG1 : x :e G1.
set y := apply_fun mult (apply_fun mult (c, x), apply_fun inv c).
assume HyG2 : y :e G2.
assume Hyne : y <> e. assume Hxne : x <> e.
assume Hcxne : apply_fun mult (c, x) <> e.
assume Hred : reduced_word 2 Gfam efam m cs.
assume Hmne : m <> 0. assume Hprod : word_product mult e cs m = c.
assume Hm_eq : m = ordsucc k. assume Hk_nat : nat_p k.
assume Hcsk_G1 : apply_fun cs k :e G1.
assume Hcs0_G2 : apply_fun cs 0 :e G2.
set cskx := apply_fun mult (apply_fun cs k, x).
assume Hcskx_ne : cskx <> e.
set ycs0 := apply_fun mult (y, apply_fun cs 0).
assume Hycs0_ne : ycs0 <> e.
(** Extract free product **)
apply (and6E
  (group_structure G mult e inv)
  (forall alpha:set, alpha :e 2 -> subgroup_of (apply_fun Gfam alpha) G mult e inv)
  (forall alpha beta:set, alpha :e 2 -> beta :e 2 -> alpha <> beta ->
    forall z:set, z :e apply_fun Gfam alpha -> z :e apply_fun Gfam beta -> z = e)
  (subgroups_generate G mult e inv 2 Gfam)
  (forall z:set, z :e G -> z <> e ->
    exists n xs:set,
      reduced_word 2 Gfam efam n xs /\ n <> 0 /\
      word_product mult e xs n = z /\
      (forall n' xs':set,
        reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
        word_product mult e xs' n' = z ->
        n = n' /\ (forall i:set, i :e n -> apply_fun xs i = apply_fun xs' i)))
  (forall alpha:set, alpha :e 2 -> apply_fun efam alpha = e)
  Hfp).
assume Hgrp Hsub Hinter Hgen Hunique _.
apply (and6E
  (function_on mult (setprod G G) G)
  (function_on inv G G)
  (e :e G)
  (forall a b z:set, a :e G -> b :e G -> z :e G ->
    apply_fun mult (apply_fun mult (a, b), z) = apply_fun mult (a, apply_fun mult (b, z)))
  (forall z:set, z :e G -> apply_fun mult (e, z) = z /\ apply_fun mult (z, e) = z)
  (forall z:set, z :e G ->
    apply_fun mult (z, apply_fun inv z) = e /\ apply_fun mult (apply_fun inv z, z) = e)
  Hgrp).
assume HmultF HinvF HeG Hassoc Hid Hinverse.
apply (and3E
  (m :e omega)
  (forall i:set, i :e m ->
    exists alpha:set, alpha :e 2 /\
      apply_fun cs i :e apply_fun Gfam alpha /\
      apply_fun cs i <> apply_fun efam alpha)
  (forall i:set, i :e m -> ordsucc i :e m ->
    forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
      apply_fun cs i :e apply_fun Gfam alpha ->
      apply_fun cs (ordsucc i) :e apply_fun Gfam beta -> alpha <> beta)
  Hred).
assume Hm_omega Hcs_mem Hcs_adj.
claim H00 : 0 = 0. { reflexivity. }
claim HGfam0 : apply_fun Gfam 0 = G1.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 0 In_0_2).
  exact (If_i_1 (0 = 0) G1 G2 H00). }
claim HGfam1 : apply_fun Gfam 1 = G2.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 1 In_1_2).
  exact (If_i_0 (1 = 0) G1 G2 neq_1_0). }
claim HsubG1 : subgroup_of G1 G mult e inv.
{ rewrite <- HGfam0. exact (Hsub 0 In_0_2). }
apply (and4E
  (G1 c= G) (e :e G1) (forall x1 y1:set, x1 :e G1 -> y1 :e G1 -> apply_fun mult (x1, y1) :e G1)
  (forall x1:set, x1 :e G1 -> apply_fun inv x1 :e G1) HsubG1).
assume HG1sub HeG1 HG1mult HG1inv.
claim HsubG2 : subgroup_of G2 G mult e inv.
{ rewrite <- HGfam1. exact (Hsub 1 In_1_2). }
apply (and4E
  (G2 c= G) (e :e G2) (forall x1 y1:set, x1 :e G2 -> y1 :e G2 -> apply_fun mult (x1, y1) :e G2)
  (forall x1:set, x1 :e G2 -> apply_fun inv x1 :e G2) HsubG2).
assume HG2sub HeG2 HG2mult HG2inv.
claim HxG : x :e G. { exact (HG1sub x HxG1). }
claim Hmult_cl : forall a b:set, a :e G -> b :e G -> apply_fun mult (a, b) :e G.
{ let a b. assume HaG : a :e G. assume HbG : b :e G.
  exact (HmultF (a, b) (tuple_2_setprod_by_pair_Sigma G G a b HaG HbG)). }
claim Hm_nat : nat_p m. { exact (omega_nat_p m Hm_omega). }
claim Hk_in_m : k :e m. { rewrite Hm_eq. exact (ordsuccI2 k). }
claim H0_in_m : 0 :e m. { rewrite Hm_eq. exact (nat_0_in_ordsucc k Hk_nat). }
claim Hefam0 : apply_fun efam 0 = e.
{ rewrite (apply_fun_graph 2 (fun _:set => e) 0 In_0_2). reflexivity. }
claim Hefam1 : apply_fun efam 1 = e.
{ rewrite (apply_fun_graph 2 (fun _:set => e) 1 In_1_2). reflexivity. }
claim Hcskx_G1 : cskx :e G1. { exact (HG1mult (apply_fun cs k) x Hcsk_G1 HxG1). }
claim Hycs0_G2 : ycs0 :e G2. { exact (HG2mult y (apply_fun cs 0) HyG2 Hcs0_G2). }
claim HcxG : apply_fun mult (c, x) :e G.
{ exact (Hmult_cl c x HcG HxG). }
(** cs membership helper **)
claim Hcs_G : forall j:set, j :e m -> apply_fun cs j :e G.
{ let j. assume Hjm : j :e m.
  apply (exandE_i
    (fun al:set => al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
    (fun al:set => apply_fun cs j <> apply_fun efam al) (Hcs_mem j Hjm)).
  let al. assume Hal_conj : al :e 2 /\ apply_fun cs j :e apply_fun Gfam al. assume Hne.
  claim Hal2 : al :e 2.
  { exact (andEL (al :e 2) (apply_fun cs j :e apply_fun Gfam al) Hal_conj). }
  claim Hcsj_fam : apply_fun cs j :e apply_fun Gfam al.
  { exact (andER (al :e 2) (apply_fun cs j :e apply_fun Gfam al) Hal_conj). }
  apply (ordsuccE 1 al Hal2).
  - assume Hal01 : al :e 1. apply (ordsuccE 0 al Hal01).
    + assume Hal_empty : al :e 0. exact (EmptyE al Hal_empty (apply_fun cs j :e G)).
    + assume Hal0 : al = 0.
      exact (HG1sub (apply_fun cs j)
        (HGfam0 (fun a _:set => apply_fun cs j :e a)
          (Hal0 (fun a _:set => apply_fun cs j :e apply_fun Gfam a) Hcsj_fam))).
  - assume Hal1 : al = 1.
    exact (HG2sub (apply_fun cs j)
      (HGfam1 (fun a _:set => apply_fun cs j :e a)
        (Hal1 (fun a _:set => apply_fun cs j :e apply_fun Gfam a) Hcsj_fam))). }
(** Build back-merged word: replace cs(k) with cskx **)
set back_cs := graph m (fun j:set => If_i (j = k) cskx (apply_fun cs j)).
claim Hback_k : apply_fun back_cs k = cskx.
{ rewrite (apply_fun_graph m (fun j:set => If_i (j = k) cskx (apply_fun cs j)) k Hk_in_m).
  claim Hkk : k = k. { reflexivity. }
  exact (If_i_1 (k = k) cskx (apply_fun cs k) Hkk). }
claim Hback_ne_k : forall j:set, j :e m -> j <> k -> apply_fun back_cs j = apply_fun cs j.
{ let j. assume Hjm : j :e m. assume Hjnek : j <> k.
  rewrite (apply_fun_graph m (fun j:set => If_i (j = k) cskx (apply_fun cs j)) j Hjm).
  exact (If_i_0 (j = k) cskx (apply_fun cs j) Hjnek). }
(** Build front-merged word: replace cs(0) with ycs0 **)
set front_cs := graph m (fun j:set => If_i (j = 0) ycs0 (apply_fun cs j)).
claim Hfront_0 : apply_fun front_cs 0 = ycs0.
{ rewrite (apply_fun_graph m (fun j:set => If_i (j = 0) ycs0 (apply_fun cs j)) 0 H0_in_m).
  exact (If_i_1 (0 = 0) ycs0 (apply_fun cs 0) H00). }
claim Hfront_ne_0 : forall j:set, j :e m -> j <> 0 -> apply_fun front_cs j = apply_fun cs j.
{ let j. assume Hjm : j :e m. assume Hjne0 : j <> 0.
  rewrite (apply_fun_graph m (fun j:set => If_i (j = 0) ycs0 (apply_fun cs j)) j Hjm).
  exact (If_i_0 (j = 0) ycs0 (apply_fun cs j) Hjne0). }
(** Both words are reduced: prove membership and adjacency **)
(** For brevity, prove these via claim blocks. Membership: **)
claim Hback_mem : forall j:set, j :e m ->
  exists alpha:set, alpha :e 2 /\
    apply_fun back_cs j :e apply_fun Gfam alpha /\
    apply_fun back_cs j <> apply_fun efam alpha.
{ let j. assume Hjm : j :e m.
  apply (xm (j = k)).
  - assume Hjk : j = k.
    (** back_cs(k) = cskx in G1 = Gfam(0), cskx ne e = efam(0) **)
    claim Hbj_eq : apply_fun back_cs j = cskx.
    { exact (Hjk (fun _ b:set => apply_fun back_cs b = cskx) Hback_k). }
    witness 0. apply and3I.
    + exact In_0_2.
    + exact (Hbj_eq (fun _ b:set => b :e apply_fun Gfam 0)
        (HGfam0 (fun _ b:set => cskx :e b) (Hcskx_G1))).
    + rewrite Hbj_eq. rewrite Hefam0. exact Hcskx_ne.
  - assume Hjnek : j <> k.
    claim Hbj_eq : apply_fun back_cs j = apply_fun cs j. { exact (Hback_ne_k j Hjm Hjnek). }
    apply (Hcs_mem j Hjm). let al.
    assume Hal_conj : (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al) /\
      apply_fun cs j <> apply_fun efam al.
    witness al. apply and3I.
    + exact (andEL (al :e 2) (apply_fun cs j :e apply_fun Gfam al)
        (andEL (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
          (apply_fun cs j <> apply_fun efam al) Hal_conj)).
    + exact (Hbj_eq (fun _ b:set => b :e apply_fun Gfam al)
        (andER (al :e 2) (apply_fun cs j :e apply_fun Gfam al)
          (andEL (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
            (apply_fun cs j <> apply_fun efam al) Hal_conj))).
    + exact (Hbj_eq (fun _ b:set => b <> apply_fun efam al)
        (andER (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
          (apply_fun cs j <> apply_fun efam al) Hal_conj)). }
(** Front membership **)
claim Hfront_mem : forall j:set, j :e m ->
  exists alpha:set, alpha :e 2 /\
    apply_fun front_cs j :e apply_fun Gfam alpha /\
    apply_fun front_cs j <> apply_fun efam alpha.
{ let j. assume Hjm : j :e m.
  apply (xm (j = 0)).
  - assume Hj0 : j = 0.
    claim Hfj_eq : apply_fun front_cs j = ycs0.
    { exact (Hj0 (fun _ b:set => apply_fun front_cs b = ycs0) Hfront_0). }
    witness 1. apply and3I.
    + exact In_1_2.
    + exact (Hfj_eq (fun _ b:set => b :e apply_fun Gfam 1)
        (HGfam1 (fun _ b:set => ycs0 :e b) Hycs0_G2)).
    + rewrite Hfj_eq. rewrite Hefam1. exact Hycs0_ne.
  - assume Hjne0 : j <> 0.
    claim Hfj_eq : apply_fun front_cs j = apply_fun cs j. { exact (Hfront_ne_0 j Hjm Hjne0). }
    apply (Hcs_mem j Hjm). let al.
    assume Hal_conj : (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al) /\
      apply_fun cs j <> apply_fun efam al.
    witness al. apply and3I.
    + exact (andEL (al :e 2) (apply_fun cs j :e apply_fun Gfam al)
        (andEL (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
          (apply_fun cs j <> apply_fun efam al) Hal_conj)).
    + exact (Hfj_eq (fun _ b:set => b :e apply_fun Gfam al)
        (andER (al :e 2) (apply_fun cs j :e apply_fun Gfam al)
          (andEL (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
            (apply_fun cs j <> apply_fun efam al) Hal_conj))).
    + exact (Hfj_eq (fun _ b:set => b <> apply_fun efam al)
        (andER (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
          (apply_fun cs j <> apply_fun efam al) Hal_conj)). }
(** Back adjacency **)
claim Hback_adj : forall j:set, j :e m -> ordsucc j :e m ->
  forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
    apply_fun back_cs j :e apply_fun Gfam alpha ->
    apply_fun back_cs (ordsucc j) :e apply_fun Gfam beta ->
    alpha <> beta.
{ let j. assume Hjm : j :e m. assume Hsjm : ordsucc j :e m.
  let alpha beta. assume Hal2 : alpha :e 2. assume Hbe2 : beta :e 2.
  assume Hmj_al : apply_fun back_cs j :e apply_fun Gfam alpha.
  assume Hmsj_be : apply_fun back_cs (ordsucc j) :e apply_fun Gfam beta.
  apply (xm (ordsucc j = k)).
  - assume Hsjk : ordsucc j = k.
    claim Hjnek : j <> k.
    { assume Hjek : j = k.
      claim Hsj_eq_m : ordsucc j = m.
      { claim Hsjsk : ordsucc j = ordsucc k. { rewrite Hjek. reflexivity. }
        rewrite Hsjsk. symmetry. exact Hm_eq. }
      exact (In_irref m (Hsj_eq_m (fun a _:set => a :e m) Hsjm)). }
    claim Hback_j_eq : apply_fun back_cs j = apply_fun cs j. { exact (Hback_ne_k j Hjm Hjnek). }
    claim Hback_sj_eq : apply_fun back_cs (ordsucc j) = cskx.
    { rewrite (apply_fun_graph m (fun j:set => If_i (j = k) cskx (apply_fun cs j)) (ordsucc j) Hsjm).
      exact (If_i_1 (ordsucc j = k) cskx (apply_fun cs (ordsucc j)) Hsjk). }
    claim Hcsj_al : apply_fun cs j :e apply_fun Gfam alpha.
    { exact (Hback_j_eq (fun a _:set => a :e apply_fun Gfam alpha) Hmj_al). }
    claim Hcskx_be : cskx :e apply_fun Gfam beta.
    { exact (Hback_sj_eq (fun a _:set => a :e apply_fun Gfam beta) Hmsj_be). }
    assume Haleqbe : alpha = beta.
    claim Hcsk_Gfam0 : apply_fun cs k :e apply_fun Gfam 0. { rewrite HGfam0. exact Hcsk_G1. }
    claim Hcssk_Gfam0 : apply_fun cs (ordsucc j) :e apply_fun Gfam 0.
    { exact (Hsjk (fun _ b:set => apply_fun cs b :e apply_fun Gfam 0) Hcsk_Gfam0). }
    claim Hal_ne_0 : alpha <> 0.
    { exact (Hcs_adj j Hjm Hsjm alpha 0 Hal2 In_0_2 Hcsj_al Hcssk_Gfam0). }
    claim Hbe_ne_0 : beta <> 0. { rewrite <- Haleqbe. exact Hal_ne_0. }
    claim Hcskx_Gfam0 : cskx :e apply_fun Gfam 0. { rewrite HGfam0. exact Hcskx_G1. }
    exact (Hcskx_ne (Hinter beta 0 Hbe2 In_0_2 Hbe_ne_0 cskx Hcskx_be Hcskx_Gfam0)).
  - assume Hsjnek : ordsucc j <> k.
    claim Hjnek : j <> k.
    { assume Hjek : j = k.
      claim Hsj_eq_m : ordsucc j = m.
      { claim Hsjsk : ordsucc j = ordsucc k. { rewrite Hjek. reflexivity. }
        rewrite Hsjsk. symmetry. exact Hm_eq. }
      exact (In_irref m (Hsj_eq_m (fun a _:set => a :e m) Hsjm)). }
    claim Hback_j_eq2 : apply_fun back_cs j = apply_fun cs j. { exact (Hback_ne_k j Hjm Hjnek). }
    claim Hback_sj_eq2 : apply_fun back_cs (ordsucc j) = apply_fun cs (ordsucc j).
    { exact (Hback_ne_k (ordsucc j) Hsjm Hsjnek). }
    claim Hcsj_al : apply_fun cs j :e apply_fun Gfam alpha.
    { exact (Hback_j_eq2 (fun a _:set => a :e apply_fun Gfam alpha) Hmj_al). }
    claim Hcssj_be : apply_fun cs (ordsucc j) :e apply_fun Gfam beta.
    { exact (Hback_sj_eq2 (fun a _:set => a :e apply_fun Gfam beta) Hmsj_be). }
    exact (Hcs_adj j Hjm Hsjm alpha beta Hal2 Hbe2 Hcsj_al Hcssj_be). }
(** Front adjacency **)
claim Hfront_adj : forall j:set, j :e m -> ordsucc j :e m ->
  forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
    apply_fun front_cs j :e apply_fun Gfam alpha ->
    apply_fun front_cs (ordsucc j) :e apply_fun Gfam beta ->
    alpha <> beta.
{ let j. assume Hjm : j :e m. assume Hsjm : ordsucc j :e m.
  let alpha beta. assume Hal2 : alpha :e 2. assume Hbe2 : beta :e 2.
  assume Hmj_al : apply_fun front_cs j :e apply_fun Gfam alpha.
  assume Hmsj_be : apply_fun front_cs (ordsucc j) :e apply_fun Gfam beta.
  claim Hsj_ne0 : ordsucc j <> 0.
  { assume Hsj0 : ordsucc j = 0.
    exact (EmptyE j (Hsj0 (fun a _:set => j :e a) (ordsuccI2 j))). }
  claim Hfront_sj_eq : apply_fun front_cs (ordsucc j) = apply_fun cs (ordsucc j).
  { exact (Hfront_ne_0 (ordsucc j) Hsjm Hsj_ne0). }
  claim Hcssj_be : apply_fun cs (ordsucc j) :e apply_fun Gfam beta.
  { exact (Hfront_sj_eq (fun a _:set => a :e apply_fun Gfam beta) Hmsj_be). }
  apply (xm (j = 0)).
  - assume Hj0 : j = 0.
    claim Hfront_j_eq : apply_fun front_cs j = ycs0.
    { exact (Hj0 (fun _ b:set => apply_fun front_cs b = ycs0) Hfront_0). }
    claim Hycs0_al : ycs0 :e apply_fun Gfam alpha.
    { exact (Hfront_j_eq (fun a _:set => a :e apply_fun Gfam alpha) Hmj_al). }
    claim Hcs0_Gfam1 : apply_fun cs 0 :e apply_fun Gfam 1. { rewrite HGfam1. exact Hcs0_G2. }
    claim Hcsj_Gfam1 : apply_fun cs j :e apply_fun Gfam 1.
    { exact (Hj0 (fun _ b:set => apply_fun cs b :e apply_fun Gfam 1) Hcs0_Gfam1). }
    assume Haleqbe : alpha = beta.
    apply (xm (alpha = 1)).
    + assume Hal1 : alpha = 1.
      claim Hcssj_Gfam1 : apply_fun cs (ordsucc j) :e apply_fun Gfam 1.
      { claim Hbe1 : beta = 1. { rewrite <- Haleqbe. exact Hal1. }
        exact (Hbe1 (fun a _:set => apply_fun cs (ordsucc j) :e apply_fun Gfam a) Hcssj_be). }
      claim H1ne1 : 1 <> 1.
      { exact (Hcs_adj j Hjm Hsjm 1 1 In_1_2 In_1_2 Hcsj_Gfam1 Hcssj_Gfam1). }
      claim H1eq1 : 1 = 1. { reflexivity. }
      exact (H1ne1 H1eq1).
    + assume Hal_ne1 : alpha <> 1.
      claim Hycs0_Gfam1 : ycs0 :e apply_fun Gfam 1. { rewrite HGfam1. exact Hycs0_G2. }
      exact (Hycs0_ne (Hinter alpha 1 Hal2 In_1_2 Hal_ne1 ycs0 Hycs0_al Hycs0_Gfam1)).
  - assume Hj_ne0 : j <> 0.
    claim Hfront_j_eq : apply_fun front_cs j = apply_fun cs j. { exact (Hfront_ne_0 j Hjm Hj_ne0). }
    claim Hcsj_al : apply_fun cs j :e apply_fun Gfam alpha.
    { exact (Hfront_j_eq (fun a _:set => a :e apply_fun Gfam alpha) Hmj_al). }
    exact (Hcs_adj j Hjm Hsjm alpha beta Hal2 Hbe2 Hcsj_al Hcssj_be). }
(** Reduced words **)
claim Hback_red : reduced_word 2 Gfam efam m back_cs.
{ prove (m :e omega /\
    (forall j:set, j :e m ->
      exists alpha:set, alpha :e 2 /\
        apply_fun back_cs j :e apply_fun Gfam alpha /\
        apply_fun back_cs j <> apply_fun efam alpha)) /\
    (forall j:set, j :e m -> ordsucc j :e m ->
      forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
        apply_fun back_cs j :e apply_fun Gfam alpha ->
        apply_fun back_cs (ordsucc j) :e apply_fun Gfam beta ->
        alpha <> beta).
  apply andI.
  - apply andI. + exact Hm_omega. + exact Hback_mem.
  - exact Hback_adj. }
claim Hfront_red : reduced_word 2 Gfam efam m front_cs.
{ prove (m :e omega /\
    (forall j:set, j :e m ->
      exists alpha:set, alpha :e 2 /\
        apply_fun front_cs j :e apply_fun Gfam alpha /\
        apply_fun front_cs j <> apply_fun efam alpha)) /\
    (forall j:set, j :e m -> ordsucc j :e m ->
      forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
        apply_fun front_cs j :e apply_fun Gfam alpha ->
        apply_fun front_cs (ordsucc j) :e apply_fun Gfam beta ->
        alpha <> beta).
  apply andI.
  - apply andI. + exact Hm_omega. + exact Hfront_mem.
  - exact Hfront_adj. }
(** Word product of back_cs = cx **)
claim Hback_agree : forall j:set, j :e k -> apply_fun back_cs j = apply_fun cs j.
{ let j. assume Hjk : j :e k.
  exact (Hback_ne_k j (nat_trans m Hm_nat k Hk_in_m j Hjk)
    (fun Hjek : j = k => In_irref k (Hjek (fun a _:set => a :e k) Hjk))). }
claim Hwpk_G : word_product mult e cs k :e G.
{ exact (word_product_in_G mult e G k cs HeG Hmult_cl
    (nat_p_omega k Hk_nat)
    (fun j Hjk => Hcs_G j (nat_trans m Hm_nat k Hk_in_m j Hjk))). }
claim Hwp_back_k : word_product mult e back_cs k = word_product mult e cs k.
{ exact (word_product_agree mult e back_cs cs k (nat_p_omega k Hk_nat) Hback_agree). }
claim Hcsk_G : apply_fun cs k :e G. { exact (HG1sub (apply_fun cs k) Hcsk_G1). }
claim Hwp_cs_step : word_product mult e cs m =
  apply_fun mult (word_product mult e cs k, apply_fun cs k).
{ rewrite Hm_eq.
  exact (nat_primrec_S e (fun i r => apply_fun mult (r, apply_fun cs i)) k Hk_nat). }
claim Hc_decomp : c = apply_fun mult (word_product mult e cs k, apply_fun cs k).
{ claim Hprod_rev : c = word_product mult e cs m. { symmetry. exact Hprod. }
  exact (eq_i_tra c (word_product mult e cs m)
    (apply_fun mult (word_product mult e cs k, apply_fun cs k)) Hprod_rev Hwp_cs_step). }
claim Hcx_eq_wpk : apply_fun mult (c, x) = apply_fun mult (word_product mult e cs k, cskx).
{ rewrite Hc_decomp.
  exact (Hassoc (word_product mult e cs k) (apply_fun cs k) x Hwpk_G Hcsk_G HxG). }
claim Hwp_back : word_product mult e back_cs m = apply_fun mult (c, x).
{ claim Hwp_step : word_product mult e back_cs (ordsucc k) =
    apply_fun mult (word_product mult e back_cs k, apply_fun back_cs k).
  { exact (nat_primrec_S e (fun i r => apply_fun mult (r, apply_fun back_cs i)) k Hk_nat). }
  claim Hwp_back_m : word_product mult e back_cs m =
    apply_fun mult (word_product mult e back_cs k, apply_fun back_cs k).
  { exact (Hm_eq (fun _ b:set => word_product mult e back_cs b =
      apply_fun mult (word_product mult e back_cs k, apply_fun back_cs k)) Hwp_step). }
  rewrite Hwp_back_m. rewrite Hback_k. rewrite Hwp_back_k.
  symmetry. exact Hcx_eq_wpk. }
(** Word product of front_cs = cx **)
(** First derive cx = yc **)
claim HinvcG : apply_fun inv c :e G. { exact (HinvF c HcG). }
claim Hinvc_c : apply_fun mult (apply_fun inv c, c) = e.
{ exact (andER
    (apply_fun mult (c, apply_fun inv c) = e)
    (apply_fun mult (apply_fun inv c, c) = e) (Hinverse c HcG)). }
claim Hcx_id : apply_fun mult (apply_fun mult (c, x), e) = apply_fun mult (c, x).
{ exact (andER
    (apply_fun mult (e, apply_fun mult (c, x)) = apply_fun mult (c, x))
    (apply_fun mult (apply_fun mult (c, x), e) = apply_fun mult (c, x))
    (Hid (apply_fun mult (c, x)) HcxG)). }
claim Hassoc_yc : apply_fun mult (y, c) =
  apply_fun mult (apply_fun mult (c, x), apply_fun mult (apply_fun inv c, c)).
{ exact (Hassoc (apply_fun mult (c, x)) (apply_fun inv c) c HcxG HinvcG HcG). }
claim Hcx_eq_yc : apply_fun mult (c, x) = apply_fun mult (y, c).
{ rewrite Hassoc_yc. rewrite Hinvc_c. symmetry. exact Hcx_id. }
(** Use word_product_prepend to compute both word products **)
set shifted_cs := graph k (fun i:set => apply_fun cs (ordsucc i)).
claim Hshifted_eval : forall i:set, i :e k -> apply_fun shifted_cs i = apply_fun cs (ordsucc i).
{ let i. assume Hik : i :e k.
  exact (apply_fun_graph k (fun i:set => apply_fun cs (ordsucc i)) i Hik). }
claim Hshifted_G : forall i:set, i :e k -> apply_fun shifted_cs i :e G.
{ let i. assume Hik : i :e k.
  rewrite (Hshifted_eval i Hik).
  claim Hsi_m : ordsucc i :e m.
  { rewrite Hm_eq. exact (nat_ordsucc_in_ordsucc k Hk_nat i Hik). }
  exact (Hcs_G (ordsucc i) Hsi_m). }
claim Hcs_shift : forall i:set, i :e k -> apply_fun cs (ordsucc i) = apply_fun shifted_cs i.
{ let i. assume Hik : i :e k. symmetry. exact (Hshifted_eval i Hik). }
claim Hycs0_G : ycs0 :e G. { exact (HG2sub ycs0 Hycs0_G2). }
claim Hfront_shift : forall i:set, i :e k -> apply_fun front_cs (ordsucc i) = apply_fun shifted_cs i.
{ let i. assume Hik : i :e k.
  claim Hsi_ne0 : ordsucc i <> 0.
  { assume Hsi0 : ordsucc i = 0.
    exact (EmptyE i (Hsi0 (fun a _:set => i :e a) (ordsuccI2 i))). }
  claim Hsi_m : ordsucc i :e m.
  { rewrite Hm_eq. exact (nat_ordsucc_in_ordsucc k Hk_nat i Hik). }
  claim Hfront_si : apply_fun front_cs (ordsucc i) = apply_fun cs (ordsucc i).
  { exact (Hfront_ne_0 (ordsucc i) Hsi_m Hsi_ne0). }
  rewrite Hfront_si. exact (Hcs_shift i Hik). }
claim Hcs0_G : apply_fun cs 0 :e G. { exact (HG2sub (apply_fun cs 0) Hcs0_G2). }
claim Hcs_prepend : word_product mult e cs (ordsucc k) =
  apply_fun mult (apply_fun cs 0, word_product mult e shifted_cs k).
{ exact (word_product_prepend mult e G k shifted_cs cs
    HeG Hid Hmult_cl Hassoc Hcs0_G (nat_p_omega k Hk_nat)
    Hshifted_G Hcs_shift). }
claim Hfront_prepend_raw : word_product mult e front_cs (ordsucc k) =
  apply_fun mult (apply_fun front_cs 0, word_product mult e shifted_cs k).
{ exact (word_product_prepend mult e G k shifted_cs front_cs
    HeG Hid Hmult_cl Hassoc
    (Hfront_0 (fun _ b:set => b :e G) Hycs0_G)
    (nat_p_omega k Hk_nat)
    Hshifted_G Hfront_shift). }
claim Hfront_prepend : word_product mult e front_cs (ordsucc k) =
  apply_fun mult (ycs0, word_product mult e shifted_cs k).
{ rewrite Hfront_prepend_raw. rewrite Hfront_0. reflexivity. }
claim Hsp_G : word_product mult e shifted_cs k :e G.
{ exact (word_product_in_G mult e G k shifted_cs HeG Hmult_cl
    (nat_p_omega k Hk_nat) Hshifted_G). }
claim Hcs0_sp_eq_c : apply_fun mult (apply_fun cs 0, word_product mult e shifted_cs k) = c.
{ claim Hwp_cs_sk : word_product mult e cs (ordsucc k) = c.
  { exact (Hm_eq (fun a _:set => word_product mult e cs a = c) Hprod). }
  rewrite <- Hcs_prepend. exact Hwp_cs_sk. }
claim Hwp_front : word_product mult e front_cs m = apply_fun mult (c, x).
{ claim Hwp_front_sk : word_product mult e front_cs (ordsucc k) =
    apply_fun mult (ycs0, word_product mult e shifted_cs k).
  { exact Hfront_prepend. }
  claim Hwp_front_m : word_product mult e front_cs m =
    apply_fun mult (ycs0, word_product mult e shifted_cs k).
  { exact (Hm_eq (fun _ b:set => word_product mult e front_cs b =
      apply_fun mult (ycs0, word_product mult e shifted_cs k)) Hwp_front_sk). }
  claim Hassoc_ycs0 : apply_fun mult (ycs0, word_product mult e shifted_cs k) =
    apply_fun mult (y, apply_fun mult (apply_fun cs 0, word_product mult e shifted_cs k)).
  { exact (Hassoc y (apply_fun cs 0) (word_product mult e shifted_cs k)
      (HG2sub y HyG2) Hcs0_G Hsp_G). }
  claim Hwp_front_yc : word_product mult e front_cs m = apply_fun mult (y, c).
  { rewrite Hwp_front_m. rewrite Hassoc_ycs0. rewrite Hcs0_sp_eq_c. reflexivity. }
  claim Hyc_eq_cx : apply_fun mult (y, c) = apply_fun mult (c, x).
  { symmetry. exact Hcx_eq_yc. }
  rewrite Hwp_front_yc. exact Hyc_eq_cx. }
(** Apply uniqueness to cx **)
apply (Hunique (apply_fun mult (c, x)) HcxG Hcxne).
let n_c. assume Hn_c_ex : exists xs_c:set,
  reduced_word 2 Gfam efam n_c xs_c /\ n_c <> 0 /\
  word_product mult e xs_c n_c = apply_fun mult (c, x) /\
  (forall n' xs':set,
    reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
    word_product mult e xs' n' = apply_fun mult (c, x) ->
    n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i)).
apply Hn_c_ex.
let xs_c. assume Hxs_c_conj :
  reduced_word 2 Gfam efam n_c xs_c /\ n_c <> 0 /\
  word_product mult e xs_c n_c = apply_fun mult (c, x) /\
  (forall n' xs':set,
    reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
    word_product mult e xs' n' = apply_fun mult (c, x) ->
    n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i)).
apply (and4E
  (reduced_word 2 Gfam efam n_c xs_c)
  (n_c <> 0)
  (word_product mult e xs_c n_c = apply_fun mult (c, x))
  (forall n' xs':set,
    reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
    word_product mult e xs' n' = apply_fun mult (c, x) ->
    n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i))
  Hxs_c_conj).
assume Hred_c Hnc_ne Hprod_c Huniq_clause.
(** Apply uniqueness to both words **)
claim Huniq_back : n_c = m /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun back_cs i).
{ exact (Huniq_clause m back_cs Hback_red Hmne Hwp_back). }
claim Hnc_m : n_c = m.
{ exact (andEL (n_c = m) (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun back_cs i)
    Huniq_back). }
claim Hxsc_eq_back : forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun back_cs i.
{ exact (andER (n_c = m) (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun back_cs i)
    Huniq_back). }
claim Huniq_front : n_c = m /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun front_cs i).
{ exact (Huniq_clause m front_cs Hfront_red Hmne Hwp_front). }
claim Hxsc_eq_front : forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun front_cs i.
{ exact (andER (n_c = m) (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun front_cs i)
    Huniq_front). }
(** Compare at position k **)
claim Hk_in_nc : k :e n_c. { exact (Hnc_m (fun _ b:set => k :e b) Hk_in_m). }
claim Hback_k_eq_front_k : apply_fun back_cs k = apply_fun front_cs k.
{ claim H1 : apply_fun back_cs k = apply_fun xs_c k.
  { symmetry. exact (Hxsc_eq_back k Hk_in_nc). }
  claim H2 : apply_fun xs_c k = apply_fun front_cs k.
  { exact (Hxsc_eq_front k Hk_in_nc). }
  exact (eq_i_tra (apply_fun back_cs k) (apply_fun xs_c k) (apply_fun front_cs k) H1 H2). }
(** back_cs(k) = cskx, derive contradiction **)
claim Hcskx_eq_front_k : cskx = apply_fun front_cs k.
{ claim H : apply_fun back_cs k = apply_fun front_cs k. { exact Hback_k_eq_front_k. }
  rewrite <- Hback_k. exact H. }
apply (xm (k = 0)).
- assume Hk0 : k = 0.
  (** front_cs(0) = ycs0, so cskx = ycs0. But cskx in G1, ycs0 in G2. **)
  claim Hfront_k_ycs0 : apply_fun front_cs k = ycs0.
  { exact (Hk0 (fun _ b:set => apply_fun front_cs b = ycs0) Hfront_0). }
  claim Hcskx_eq_ycs0 : cskx = ycs0.
  { rewrite Hcskx_eq_front_k. exact Hfront_k_ycs0. }
  claim Hcskx_G2 : cskx :e G2.
  { exact (Hcskx_eq_ycs0 (fun _ b:set => b :e G2) Hycs0_G2). }
  claim Hcskx_Gfam0 : cskx :e apply_fun Gfam 0. { rewrite HGfam0. exact Hcskx_G1. }
  claim Hcskx_Gfam1 : cskx :e apply_fun Gfam 1. { rewrite HGfam1. exact Hcskx_G2. }
  exact (Hcskx_ne (Hinter 0 1 In_0_2 In_1_2 neq_0_1 cskx Hcskx_Gfam0 Hcskx_Gfam1)).
- assume Hk_ne0 : k <> 0.
  (** front_cs(k) = cs(k) since k ne 0. So cskx = cs(k). **)
  (** mult(cs(k), x) = cs(k), so x = e, contradiction **)
  claim Hfront_k_csk : apply_fun front_cs k = apply_fun cs k.
  { exact (Hfront_ne_0 k Hk_in_m Hk_ne0). }
  claim Hcskx_eq_csk : cskx = apply_fun cs k.
  { rewrite Hcskx_eq_front_k. exact Hfront_k_csk. }
  (** From cskx = cs(k): mult(inv(cs(k)), cskx) = mult(inv(cs(k)), cs(k)) = e **)
  (** Also mult(inv(cs(k)), cskx) = mult(inv(cs(k)), mult(cs(k), x)) = x by cancel **)
  claim HinvcsK_G : apply_fun inv (apply_fun cs k) :e G.
  { exact (HinvF (apply_fun cs k) Hcsk_G). }
  claim Hinvcsk_csk : apply_fun mult (apply_fun inv (apply_fun cs k), apply_fun cs k) = e.
  { exact (andER
      (apply_fun mult (apply_fun cs k, apply_fun inv (apply_fun cs k)) = e)
      (apply_fun mult (apply_fun inv (apply_fun cs k), apply_fun cs k) = e)
      (Hinverse (apply_fun cs k) Hcsk_G)). }
  claim Hcancel : apply_fun mult (apply_fun inv (apply_fun cs k), cskx) = x.
  { claim Hassoc_inv : apply_fun mult (apply_fun mult (apply_fun inv (apply_fun cs k), apply_fun cs k), x) =
      apply_fun mult (apply_fun inv (apply_fun cs k), cskx).
    { exact (Hassoc (apply_fun inv (apply_fun cs k)) (apply_fun cs k) x HinvcsK_G Hcsk_G HxG). }
    claim Hid_x : apply_fun mult (e, x) = x.
    { exact (andEL
        (apply_fun mult (e, x) = x) (apply_fun mult (x, e) = x)
        (Hid x HxG)). }
    claim Hex : apply_fun mult (apply_fun mult (apply_fun inv (apply_fun cs k), apply_fun cs k), x) = x.
    { rewrite Hinvcsk_csk. exact Hid_x. }
    rewrite <- Hassoc_inv. exact Hex. }
  claim Hcancel_e : apply_fun mult (apply_fun inv (apply_fun cs k), cskx) = e.
  { exact (Hcskx_eq_csk
      (fun _ b:set => apply_fun mult (apply_fun inv (apply_fun cs k), b) = e)
      Hinvcsk_csk). }
  claim Hx_e : x = e.
  { claim Hx_rev : x = apply_fun mult (apply_fun inv (apply_fun cs k), cskx).
    { symmetry. exact Hcancel. }
    exact (eq_i_tra x (apply_fun mult (apply_fun inv (apply_fun cs k), cskx)) e Hx_rev Hcancel_e). }
  exact (Hxne Hx_e).
Qed.

(** Sub-helper: cs(k) in G1 and cs(0) in G2 (both ends need merging) **)
(** Strategy: build back-merged [cs(0),...,cs(k-1),cskx] and front-merged [ycs0,cs(1),...,cs(k)] **)
(** Both represent cx. Uniqueness of reduced words gives contradiction. **)
Lemma ex68_3_case_G1_first_G2 : forall G mult e inv G1 G2 c x m cs k:set,
  free_product_of_subgroups G mult e inv 2
    (graph 2 (fun i:set => If_i (i = 0) G1 G2))
    (graph 2 (fun _:set => e)) ->
  c :e G -> x :e G1 ->
  apply_fun mult (apply_fun mult (c, x), apply_fun inv c) :e G2 ->
  apply_fun mult (apply_fun mult (c, x), apply_fun inv c) <> e ->
  x <> e -> apply_fun mult (c, x) <> e ->
  reduced_word 2 (graph 2 (fun i:set => If_i (i = 0) G1 G2))
    (graph 2 (fun _:set => e)) m cs ->
  m <> 0 -> word_product mult e cs m = c ->
  m = ordsucc k -> nat_p k ->
  apply_fun cs k :e G1 ->
  apply_fun cs 0 :e G2 ->
  False.
let G mult e inv G1 G2 c x m cs k.
set Gfam := graph 2 (fun i:set => If_i (i = 0) G1 G2).
set efam := graph 2 (fun _:set => e).
assume Hfp : free_product_of_subgroups G mult e inv 2 Gfam efam.
assume HcG : c :e G. assume HxG1 : x :e G1.
set y := apply_fun mult (apply_fun mult (c, x), apply_fun inv c).
assume HyG2 : y :e G2.
assume Hyne : y <> e. assume Hxne : x <> e.
assume Hcxne : apply_fun mult (c, x) <> e.
assume Hred : reduced_word 2 Gfam efam m cs.
assume Hmne : m <> 0. assume Hprod : word_product mult e cs m = c.
assume Hm_eq : m = ordsucc k. assume Hk_nat : nat_p k.
assume Hcsk_G1 : apply_fun cs k :e G1.
assume Hcs0_G2 : apply_fun cs 0 :e G2.
(** Extract free product components **)
apply (and6E
  (group_structure G mult e inv)
  (forall alpha:set, alpha :e 2 -> subgroup_of (apply_fun Gfam alpha) G mult e inv)
  (forall alpha beta:set, alpha :e 2 -> beta :e 2 -> alpha <> beta ->
    forall z:set, z :e apply_fun Gfam alpha -> z :e apply_fun Gfam beta -> z = e)
  (subgroups_generate G mult e inv 2 Gfam)
  (forall z:set, z :e G -> z <> e ->
    exists n xs:set,
      reduced_word 2 Gfam efam n xs /\ n <> 0 /\
      word_product mult e xs n = z /\
      (forall n' xs':set,
        reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
        word_product mult e xs' n' = z ->
        n = n' /\ (forall i:set, i :e n -> apply_fun xs i = apply_fun xs' i)))
  (forall alpha:set, alpha :e 2 -> apply_fun efam alpha = e)
  Hfp).
assume Hgrp Hsub Hinter Hgen Hunique _.
apply (and6E
  (function_on mult (setprod G G) G)
  (function_on inv G G)
  (e :e G)
  (forall a b z:set, a :e G -> b :e G -> z :e G ->
    apply_fun mult (apply_fun mult (a, b), z) = apply_fun mult (a, apply_fun mult (b, z)))
  (forall z:set, z :e G -> apply_fun mult (e, z) = z /\ apply_fun mult (z, e) = z)
  (forall z:set, z :e G ->
    apply_fun mult (z, apply_fun inv z) = e /\ apply_fun mult (apply_fun inv z, z) = e)
  Hgrp).
assume HmultF HinvF HeG Hassoc Hid Hinverse.
apply (and3E
  (m :e omega)
  (forall i:set, i :e m ->
    exists alpha:set, alpha :e 2 /\
      apply_fun cs i :e apply_fun Gfam alpha /\
      apply_fun cs i <> apply_fun efam alpha)
  (forall i:set, i :e m -> ordsucc i :e m ->
    forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
      apply_fun cs i :e apply_fun Gfam alpha ->
      apply_fun cs (ordsucc i) :e apply_fun Gfam beta -> alpha <> beta)
  Hred).
assume Hm_omega Hcs_mem Hcs_adj.
claim H00 : 0 = 0. { reflexivity. }
claim HGfam0 : apply_fun Gfam 0 = G1.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 0 In_0_2).
  exact (If_i_1 (0 = 0) G1 G2 H00). }
claim HGfam1 : apply_fun Gfam 1 = G2.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 1 In_1_2).
  exact (If_i_0 (1 = 0) G1 G2 neq_1_0). }
claim HsubG1 : subgroup_of G1 G mult e inv.
{ rewrite <- HGfam0. exact (Hsub 0 In_0_2). }
claim HsubG2 : subgroup_of G2 G mult e inv.
{ rewrite <- HGfam1. exact (Hsub 1 In_1_2). }
apply (and4E
  (G1 c= G) (e :e G1) (forall x1 y1:set, x1 :e G1 -> y1 :e G1 -> apply_fun mult (x1, y1) :e G1)
  (forall x1:set, x1 :e G1 -> apply_fun inv x1 :e G1) HsubG1).
assume HG1sub HeG1 HG1mult HG1inv.
apply (and4E
  (G2 c= G) (e :e G2) (forall x1 y1:set, x1 :e G2 -> y1 :e G2 -> apply_fun mult (x1, y1) :e G2)
  (forall x1:set, x1 :e G2 -> apply_fun inv x1 :e G2) HsubG2).
assume HG2sub HeG2 HG2mult HG2inv.
claim HxG : x :e G. { exact (HG1sub x HxG1). }
claim HyG : y :e G. { exact (HG2sub y HyG2). }
claim HcxG : apply_fun mult (c, x) :e G.
{ exact (HmultF (c, x) (tuple_2_setprod_by_pair_Sigma G G c x HcG HxG)). }
claim Hmult_cl : forall a b:set, a :e G -> b :e G -> apply_fun mult (a, b) :e G.
{ let a b. assume HaG : a :e G. assume HbG : b :e G.
  exact (HmultF (a, b) (tuple_2_setprod_by_pair_Sigma G G a b HaG HbG)). }
claim Hm_nat : nat_p m. { exact (omega_nat_p m Hm_omega). }
claim Hk_in_m : k :e m. { rewrite Hm_eq. exact (ordsuccI2 k). }
claim H0_in_m : 0 :e m. { rewrite Hm_eq. exact (nat_0_in_ordsucc k Hk_nat). }
(** cx = yc **)
claim HinvcG : apply_fun inv c :e G. { exact (HinvF c HcG). }
claim Hinvc_c : apply_fun mult (apply_fun inv c, c) = e.
{ exact (andER
    (apply_fun mult (c, apply_fun inv c) = e)
    (apply_fun mult (apply_fun inv c, c) = e) (Hinverse c HcG)). }
claim Hcx_e : apply_fun mult (apply_fun mult (c, x), e) = apply_fun mult (c, x).
{ exact (andER
    (apply_fun mult (e, apply_fun mult (c, x)) = apply_fun mult (c, x))
    (apply_fun mult (apply_fun mult (c, x), e) = apply_fun mult (c, x))
    (Hid (apply_fun mult (c, x)) HcxG)). }
claim Hassoc_yc : apply_fun mult (y, c) =
  apply_fun mult (apply_fun mult (c, x), apply_fun mult (apply_fun inv c, c)).
{ exact (Hassoc (apply_fun mult (c, x)) (apply_fun inv c) c HcxG HinvcG HcG). }
claim Hcx_eq_yc : apply_fun mult (c, x) = apply_fun mult (y, c).
{ rewrite Hassoc_yc. rewrite Hinvc_c. symmetry. exact Hcx_e. }
(** Merged definitions **)
set cskx := apply_fun mult (apply_fun cs k, x).
set ycs0 := apply_fun mult (y, apply_fun cs 0).
claim Hcskx_G1 : cskx :e G1. { exact (HG1mult (apply_fun cs k) x Hcsk_G1 HxG1). }
claim Hycs0_G2 : ycs0 :e G2. { exact (HG2mult y (apply_fun cs 0) HyG2 Hcs0_G2). }
claim Hcsk_G : apply_fun cs k :e G. { exact (HG1sub (apply_fun cs k) Hcsk_G1). }
claim Hcs0_G2_g : apply_fun cs 0 :e G. { exact (HG2sub (apply_fun cs 0) Hcs0_G2). }
(** Shared infrastructure for k>0 sub-cases **)
claim Hk_omega : k :e omega. { exact (nat_p_omega k Hk_nat). }
claim Hcs_G : forall j:set, j :e m -> apply_fun cs j :e G.
{ let j. assume Hjm : j :e m.
  apply (exandE_i
    (fun al:set => al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
    (fun al:set => apply_fun cs j <> apply_fun efam al) (Hcs_mem j Hjm)).
  let al. assume Hal_conj : al :e 2 /\ apply_fun cs j :e apply_fun Gfam al. assume Hne.
  claim Hal2 : al :e 2.
  { exact (andEL (al :e 2) (apply_fun cs j :e apply_fun Gfam al) Hal_conj). }
  claim Hcsj_fam : apply_fun cs j :e apply_fun Gfam al.
  { exact (andER (al :e 2) (apply_fun cs j :e apply_fun Gfam al) Hal_conj). }
  apply (ordsuccE 1 al Hal2).
  - assume Hal01 : al :e 1. apply (ordsuccE 0 al Hal01).
    + assume Hal_empty : al :e 0. exact (EmptyE al Hal_empty (apply_fun cs j :e G)).
    + assume Hal0 : al = 0.
      exact (HG1sub (apply_fun cs j)
        (HGfam0 (fun a _:set => apply_fun cs j :e a)
          (Hal0 (fun a _:set => apply_fun cs j :e apply_fun Gfam a) Hcsj_fam))).
  - assume Hal1 : al = 1.
    exact (HG2sub (apply_fun cs j)
      (HGfam1 (fun a _:set => apply_fun cs j :e a)
        (Hal1 (fun a _:set => apply_fun cs j :e apply_fun Gfam a) Hcsj_fam))). }
(** init_cs: first k entries of cs **)
set init_cs := graph k (fun j:set => apply_fun cs j).
claim Hinit_eval : forall j:set, j :e k -> apply_fun init_cs j = apply_fun cs j.
{ let j. assume Hjk : j :e k.
  exact (apply_fun_graph k (fun j:set => apply_fun cs j) j Hjk). }
(** tail_cs: entries cs(1),...,cs(k) shifted by 1 **)
set tail_cs := graph k (fun j:set => apply_fun cs (ordsucc j)).
claim Htail_eval : forall j:set, j :e k -> apply_fun tail_cs j = apply_fun cs (ordsucc j).
{ let j. assume Hjk : j :e k.
  exact (apply_fun_graph k (fun j:set => apply_fun cs (ordsucc j)) j Hjk). }
(** init_cs is reduced **)
claim Hinit_red : reduced_word 2 Gfam efam k init_cs.
{ prove (k :e omega /\
    (forall j:set, j :e k ->
      exists alpha:set, alpha :e 2 /\
        apply_fun init_cs j :e apply_fun Gfam alpha /\
        apply_fun init_cs j <> apply_fun efam alpha)) /\
    (forall j:set, j :e k -> ordsucc j :e k ->
      forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
        apply_fun init_cs j :e apply_fun Gfam alpha ->
        apply_fun init_cs (ordsucc j) :e apply_fun Gfam beta ->
        alpha <> beta).
  apply andI.
  - apply andI.
    + exact Hk_omega.
    + let j. assume Hjk : j :e k.
      claim Hjm : j :e m. { exact (nat_trans m Hm_nat k Hk_in_m j Hjk). }
      claim Hinit_j : apply_fun init_cs j = apply_fun cs j. { exact (Hinit_eval j Hjk). }
      apply (Hcs_mem j Hjm). let al.
      assume Hal_conj : (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al) /\
        apply_fun cs j <> apply_fun efam al.
      witness al. apply and3I.
      * exact (andEL (al :e 2) (apply_fun cs j :e apply_fun Gfam al)
          (andEL (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
            (apply_fun cs j <> apply_fun efam al) Hal_conj)).
      * exact (Hinit_j (fun _ b:set => b :e apply_fun Gfam al)
          (andER (al :e 2) (apply_fun cs j :e apply_fun Gfam al)
            (andEL (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
              (apply_fun cs j <> apply_fun efam al) Hal_conj))).
      * exact (Hinit_j (fun _ b:set => b <> apply_fun efam al)
          (andER (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
            (apply_fun cs j <> apply_fun efam al) Hal_conj)).
  - let j. assume Hjk : j :e k. assume Hsjk : ordsucc j :e k.
    let alpha beta. assume Hal2 : alpha :e 2. assume Hbe2 : beta :e 2.
    assume Hmj_al : apply_fun init_cs j :e apply_fun Gfam alpha.
    assume Hmsj_be : apply_fun init_cs (ordsucc j) :e apply_fun Gfam beta.
    claim Hjm : j :e m. { exact (nat_trans m Hm_nat k Hk_in_m j Hjk). }
    claim Hsjm : ordsucc j :e m. { exact (nat_trans m Hm_nat k Hk_in_m (ordsucc j) Hsjk). }
    claim Hinit_j : apply_fun init_cs j = apply_fun cs j. { exact (Hinit_eval j Hjk). }
    claim Hinit_sj : apply_fun init_cs (ordsucc j) = apply_fun cs (ordsucc j).
    { exact (Hinit_eval (ordsucc j) Hsjk). }
    claim Hcsj_al : apply_fun cs j :e apply_fun Gfam alpha.
    { exact (Hinit_j (fun a _:set => a :e apply_fun Gfam alpha) Hmj_al). }
    claim Hcssj_be : apply_fun cs (ordsucc j) :e apply_fun Gfam beta.
    { exact (Hinit_sj (fun a _:set => a :e apply_fun Gfam beta) Hmsj_be). }
    exact (Hcs_adj j Hjm Hsjm alpha beta Hal2 Hbe2 Hcsj_al Hcssj_be). }
(** tail_cs is reduced **)
claim Htail_red : reduced_word 2 Gfam efam k tail_cs.
{ prove (k :e omega /\
    (forall j:set, j :e k ->
      exists alpha:set, alpha :e 2 /\
        apply_fun tail_cs j :e apply_fun Gfam alpha /\
        apply_fun tail_cs j <> apply_fun efam alpha)) /\
    (forall j:set, j :e k -> ordsucc j :e k ->
      forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
        apply_fun tail_cs j :e apply_fun Gfam alpha ->
        apply_fun tail_cs (ordsucc j) :e apply_fun Gfam beta ->
        alpha <> beta).
  apply andI.
  - apply andI.
    + exact Hk_omega.
    + let j. assume Hjk : j :e k.
      claim Hsj_m : ordsucc j :e m.
      { exact (Hm_eq (fun _ b:set => ordsucc j :e b)
          (nat_ordsucc_in_ordsucc k Hk_nat j Hjk)). }
      claim Htail_j : apply_fun tail_cs j = apply_fun cs (ordsucc j).
      { exact (Htail_eval j Hjk). }
      apply (Hcs_mem (ordsucc j) Hsj_m). let al.
      assume Hal_conj : (al :e 2 /\ apply_fun cs (ordsucc j) :e apply_fun Gfam al) /\
        apply_fun cs (ordsucc j) <> apply_fun efam al.
      witness al. apply and3I.
      * exact (andEL (al :e 2) (apply_fun cs (ordsucc j) :e apply_fun Gfam al)
          (andEL (al :e 2 /\ apply_fun cs (ordsucc j) :e apply_fun Gfam al)
            (apply_fun cs (ordsucc j) <> apply_fun efam al) Hal_conj)).
      * exact (Htail_j (fun _ b:set => b :e apply_fun Gfam al)
          (andER (al :e 2) (apply_fun cs (ordsucc j) :e apply_fun Gfam al)
            (andEL (al :e 2 /\ apply_fun cs (ordsucc j) :e apply_fun Gfam al)
              (apply_fun cs (ordsucc j) <> apply_fun efam al) Hal_conj))).
      * exact (Htail_j (fun _ b:set => b <> apply_fun efam al)
          (andER (al :e 2 /\ apply_fun cs (ordsucc j) :e apply_fun Gfam al)
            (apply_fun cs (ordsucc j) <> apply_fun efam al) Hal_conj)).
  - let j. assume Hjk : j :e k. assume Hsjk : ordsucc j :e k.
    let alpha beta. assume Hal2 : alpha :e 2. assume Hbe2 : beta :e 2.
    assume Hmj_al : apply_fun tail_cs j :e apply_fun Gfam alpha.
    assume Hmsj_be : apply_fun tail_cs (ordsucc j) :e apply_fun Gfam beta.
    claim Hsj_m : ordsucc j :e m. { exact (nat_trans m Hm_nat k Hk_in_m (ordsucc j) Hsjk). }
    claim Hssj_m : ordsucc (ordsucc j) :e m.
    { exact (Hm_eq (fun _ b:set => ordsucc (ordsucc j) :e b)
        (nat_ordsucc_in_ordsucc k Hk_nat (ordsucc j) Hsjk)). }
    claim Htail_j : apply_fun tail_cs j = apply_fun cs (ordsucc j). { exact (Htail_eval j Hjk). }
    claim Htail_sj : apply_fun tail_cs (ordsucc j) = apply_fun cs (ordsucc (ordsucc j)).
    { exact (Htail_eval (ordsucc j) Hsjk). }
    claim Hcssj_al : apply_fun cs (ordsucc j) :e apply_fun Gfam alpha.
    { exact (Htail_j (fun a _:set => a :e apply_fun Gfam alpha) Hmj_al). }
    claim Hcsssj_be : apply_fun cs (ordsucc (ordsucc j)) :e apply_fun Gfam beta.
    { exact (Htail_sj (fun a _:set => a :e apply_fun Gfam beta) Hmsj_be). }
    exact (Hcs_adj (ordsucc j) Hsj_m Hssj_m alpha beta Hal2 Hbe2 Hcssj_al Hcsssj_be). }
(** Word product infrastructure **)
claim Hwpk_G : word_product mult e cs k :e G.
{ exact (word_product_in_G mult e G k cs HeG Hmult_cl Hk_omega
    (fun j Hjk => Hcs_G j (nat_trans m Hm_nat k Hk_in_m j Hjk))). }
claim Hwp_cs_step : word_product mult e cs m =
  apply_fun mult (word_product mult e cs k, apply_fun cs k).
{ rewrite Hm_eq.
  exact (nat_primrec_S e (fun i r => apply_fun mult (r, apply_fun cs i)) k Hk_nat). }
claim Hc_decomp : c = apply_fun mult (word_product mult e cs k, apply_fun cs k).
{ claim Hprod_rev : c = word_product mult e cs m. { symmetry. exact Hprod. }
  exact (eq_i_tra c (word_product mult e cs m)
    (apply_fun mult (word_product mult e cs k, apply_fun cs k)) Hprod_rev Hwp_cs_step). }
claim Hwp_init_agree : word_product mult e init_cs k = word_product mult e cs k.
{ exact (word_product_agree mult e init_cs cs k Hk_omega Hinit_eval). }
claim Hcx_eq_wpk : apply_fun mult (c, x) = apply_fun mult (word_product mult e cs k, cskx).
{ rewrite Hc_decomp.
  exact (Hassoc (word_product mult e cs k) (apply_fun cs k) x Hwpk_G Hcsk_G HxG). }
(** Tail word product via word_product_prepend **)
claim Htail_G : forall j:set, j :e k -> apply_fun tail_cs j :e G.
{ let j. assume Hjk : j :e k.
  rewrite (Htail_eval j Hjk).
  claim Hsj_m : ordsucc j :e m.
  { exact (Hm_eq (fun _ b:set => ordsucc j :e b)
      (nat_ordsucc_in_ordsucc k Hk_nat j Hjk)). }
  exact (Hcs_G (ordsucc j) Hsj_m). }
claim Hcs_shift_rev : forall j:set, j :e k -> apply_fun cs (ordsucc j) = apply_fun tail_cs j.
{ let j. assume Hjk : j :e k. symmetry. exact (Htail_eval j Hjk). }
claim Hcs_prepend_eq : word_product mult e cs (ordsucc k) =
  apply_fun mult (apply_fun cs 0, word_product mult e tail_cs k).
{ exact (word_product_prepend mult e G k tail_cs cs
    HeG Hid Hmult_cl Hassoc Hcs0_G2_g Hk_omega
    Htail_G Hcs_shift_rev). }
claim Hsp_G : word_product mult e tail_cs k :e G.
{ exact (word_product_in_G mult e G k tail_cs HeG Hmult_cl Hk_omega Htail_G). }
claim Hcs0_sp_eq_c : apply_fun mult (apply_fun cs 0, word_product mult e tail_cs k) = c.
{ claim Hwp_cs_sk : word_product mult e cs (ordsucc k) = c.
  { exact (Hm_eq (fun a _:set => word_product mult e cs a = c) Hprod). }
  rewrite <- Hcs_prepend_eq. exact Hwp_cs_sk. }
(** front_cs and back_cs definitions **)
set front_cs := graph m (fun j:set => If_i (j = 0) ycs0 (apply_fun cs j)).
claim Hfront_0 : apply_fun front_cs 0 = ycs0.
{ rewrite (apply_fun_graph m (fun j:set => If_i (j = 0) ycs0 (apply_fun cs j)) 0 H0_in_m).
  exact (If_i_1 (0 = 0) ycs0 (apply_fun cs 0) H00). }
claim Hfront_ne_0 : forall j:set, j :e m -> j <> 0 -> apply_fun front_cs j = apply_fun cs j.
{ let j. assume Hjm : j :e m. assume Hjne0 : j <> 0.
  rewrite (apply_fun_graph m (fun j:set => If_i (j = 0) ycs0 (apply_fun cs j)) j Hjm).
  exact (If_i_0 (j = 0) ycs0 (apply_fun cs j) Hjne0). }
set back_cs := graph m (fun j:set => If_i (j = k) cskx (apply_fun cs j)).
claim Hback_k : apply_fun back_cs k = cskx.
{ rewrite (apply_fun_graph m (fun j:set => If_i (j = k) cskx (apply_fun cs j)) k Hk_in_m).
  claim Hkk : k = k. { reflexivity. }
  exact (If_i_1 (k = k) cskx (apply_fun cs k) Hkk). }
claim Hback_ne_k : forall j:set, j :e m -> j <> k -> apply_fun back_cs j = apply_fun cs j.
{ let j. assume Hjm : j :e m. assume Hjnek : j <> k.
  rewrite (apply_fun_graph m (fun j:set => If_i (j = k) cskx (apply_fun cs j)) j Hjm).
  exact (If_i_0 (j = k) cskx (apply_fun cs j) Hjnek). }
claim Hefam0 : apply_fun efam 0 = e.
{ rewrite (apply_fun_graph 2 (fun _:set => e) 0 In_0_2). reflexivity. }
claim Hefam1 : apply_fun efam 1 = e.
{ rewrite (apply_fun_graph 2 (fun _:set => e) 1 In_1_2). reflexivity. }
claim Hycs0_G : ycs0 :e G. { exact (HG2sub ycs0 Hycs0_G2). }
claim Hcskx_G : cskx :e G. { exact (HG1sub cskx Hcskx_G1). }
(** Case split on cskx = e and ycs0 = e **)
apply (xm (cskx = e)).
- assume Hcskx_e : cskx = e.
  apply (xm (ycs0 = e)).
  + assume Hycs0_e : ycs0 = e.
    (** Both zero: k=0 gives cs(0) in G1 cap G2, contradiction. k>0: entry comparison **)
    apply (xm (k = 0)).
    * assume Hk0 : k = 0.
      claim Hcs0_G1 : apply_fun cs 0 :e G1.
      { exact (Hk0 (fun a _:set => apply_fun cs a :e G1) Hcsk_G1). }
      claim Hcs0_e : apply_fun cs 0 = e.
      { exact (Hinter 0 1 In_0_2 In_1_2 neq_0_1 (apply_fun cs 0)
          (HGfam0 (fun _ b:set => apply_fun cs 0 :e b) Hcs0_G1)
          (HGfam1 (fun _ b:set => apply_fun cs 0 :e b) Hcs0_G2)). }
      apply (exandE_i
        (fun al:set => al :e 2 /\ apply_fun cs 0 :e apply_fun Gfam al)
        (fun al:set => apply_fun cs 0 <> apply_fun efam al) (Hcs_mem 0 H0_in_m)).
      let al. assume Hal_c : al :e 2 /\ apply_fun cs 0 :e apply_fun Gfam al.
      assume Hne_efam : apply_fun cs 0 <> apply_fun efam al.
      claim Hal2 : al :e 2. { exact (andEL (al :e 2) (apply_fun cs 0 :e apply_fun Gfam al) Hal_c). }
      claim Hefam_e : apply_fun efam al = e. { exact (apply_fun_graph 2 (fun _:set => e) al Hal2). }
      claim Hefam_rev : e = apply_fun efam al. { symmetry. exact Hefam_e. }
      exact (Hne_efam (eq_i_tra (apply_fun cs 0) e (apply_fun efam al) Hcs0_e Hefam_rev)).
    * assume Hk_ne0 : k <> 0.
      (** k>0, both cskx=e and ycs0=e: entry comparison gives adjacency contradiction **)
      (** Step 1: cx = wp(init_cs, k) via cskx = e **)
      claim Hwpk_id : apply_fun mult (word_product mult e cs k, e) = word_product mult e cs k.
      { exact (andER
          (apply_fun mult (e, word_product mult e cs k) = word_product mult e cs k)
          (apply_fun mult (word_product mult e cs k, e) = word_product mult e cs k)
          (Hid (word_product mult e cs k) Hwpk_G)). }
      claim Hcskx_step : apply_fun mult (word_product mult e cs k, cskx) =
        apply_fun mult (word_product mult e cs k, e).
      { claim Hrefl_wpe : apply_fun mult (word_product mult e cs k, e) =
          apply_fun mult (word_product mult e cs k, e). { reflexivity. }
        exact (Hcskx_e (fun _ b:set =>
          apply_fun mult (word_product mult e cs k, b) =
          apply_fun mult (word_product mult e cs k, e)) Hrefl_wpe). }
      claim Hcx_eq_init : apply_fun mult (c, x) = word_product mult e init_cs k.
      { claim Hcx_wpk : apply_fun mult (c, x) = word_product mult e cs k.
        { exact (eq_i_tra (apply_fun mult (c, x))
            (apply_fun mult (word_product mult e cs k, cskx))
            (word_product mult e cs k)
            Hcx_eq_wpk
            (eq_i_tra (apply_fun mult (word_product mult e cs k, cskx))
              (apply_fun mult (word_product mult e cs k, e))
              (word_product mult e cs k)
              Hcskx_step Hwpk_id)). }
        claim Hwp_init_rev : word_product mult e cs k = word_product mult e init_cs k.
        { symmetry. exact Hwp_init_agree. }
        exact (eq_i_tra (apply_fun mult (c, x)) (word_product mult e cs k)
          (word_product mult e init_cs k) Hcx_wpk Hwp_init_rev). }
      claim Hwp_init_cx : word_product mult e init_cs k = apply_fun mult (c, x).
      { symmetry. exact Hcx_eq_init. }
      (** Step 2: cx = wp(tail_cs, k) via ycs0 = e **)
      claim Hid_sp : apply_fun mult (e, word_product mult e tail_cs k) =
        word_product mult e tail_cs k.
      { exact (andEL
          (apply_fun mult (e, word_product mult e tail_cs k) = word_product mult e tail_cs k)
          (apply_fun mult (word_product mult e tail_cs k, e) = word_product mult e tail_cs k)
          (Hid (word_product mult e tail_cs k) Hsp_G)). }
      claim Hyc_decomp : apply_fun mult (y, c) =
        apply_fun mult (y, apply_fun mult (apply_fun cs 0, word_product mult e tail_cs k)).
      { claim Hrefl_yc : apply_fun mult (y, c) = apply_fun mult (y, c). { reflexivity. }
        exact (Hcs0_sp_eq_c (fun _ b:set =>
          apply_fun mult (y, c) = apply_fun mult (y, b)) Hrefl_yc). }
      claim Hassoc_ycs0_rev :
        apply_fun mult (y, apply_fun mult (apply_fun cs 0, word_product mult e tail_cs k)) =
        apply_fun mult (ycs0, word_product mult e tail_cs k).
      { symmetry. exact (Hassoc y (apply_fun cs 0) (word_product mult e tail_cs k)
          HyG Hcs0_G2_g Hsp_G). }
      claim Hycs0_to_e :
        apply_fun mult (ycs0, word_product mult e tail_cs k) =
        apply_fun mult (e, word_product mult e tail_cs k).
      { claim Hrefl_ewp : apply_fun mult (e, word_product mult e tail_cs k) =
          apply_fun mult (e, word_product mult e tail_cs k). { reflexivity. }
        exact (Hycs0_e (fun _ b:set =>
          apply_fun mult (b, word_product mult e tail_cs k) =
          apply_fun mult (e, word_product mult e tail_cs k)) Hrefl_ewp). }
      claim Hcx_eq_tail : apply_fun mult (c, x) = word_product mult e tail_cs k.
      { claim Hyc_eq_sp : apply_fun mult (y, c) = word_product mult e tail_cs k.
        { exact (eq_i_tra (apply_fun mult (y, c))
            (apply_fun mult (y, apply_fun mult (apply_fun cs 0, word_product mult e tail_cs k)))
            (word_product mult e tail_cs k)
            Hyc_decomp
            (eq_i_tra
              (apply_fun mult (y, apply_fun mult (apply_fun cs 0, word_product mult e tail_cs k)))
              (apply_fun mult (ycs0, word_product mult e tail_cs k))
              (word_product mult e tail_cs k)
              Hassoc_ycs0_rev
              (eq_i_tra
                (apply_fun mult (ycs0, word_product mult e tail_cs k))
                (apply_fun mult (e, word_product mult e tail_cs k))
                (word_product mult e tail_cs k)
                Hycs0_to_e Hid_sp))). }
        exact (eq_i_tra (apply_fun mult (c, x)) (apply_fun mult (y, c))
          (word_product mult e tail_cs k) Hcx_eq_yc Hyc_eq_sp). }
      claim Hwp_tail_cx : word_product mult e tail_cs k = apply_fun mult (c, x).
      { symmetry. exact Hcx_eq_tail. }
      (** Step 3: Derive 0 :e k from k <> 0 **)
      claim H0_in_k : 0 :e k.
      { apply (ordsuccE k 0 (nat_0_in_ordsucc k Hk_nat)).
        - assume H : 0 :e k. exact H.
        - assume H0k : 0 = k.
          exact (Hk_ne0 (H0k (fun a _:set => a = 0) H00) (0 :e k)). }
      (** Step 4: Apply Hunique to cx **)
      apply (Hunique (apply_fun mult (c, x)) HcxG Hcxne).
      let n_c. assume Hn_c_ex : exists xs_c:set,
        reduced_word 2 Gfam efam n_c xs_c /\ n_c <> 0 /\
        word_product mult e xs_c n_c = apply_fun mult (c, x) /\
        (forall n' xs':set,
          reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
          word_product mult e xs' n' = apply_fun mult (c, x) ->
          n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i)).
      apply Hn_c_ex.
      let xs_c. assume Hxs_c_conj :
        reduced_word 2 Gfam efam n_c xs_c /\ n_c <> 0 /\
        word_product mult e xs_c n_c = apply_fun mult (c, x) /\
        (forall n' xs':set,
          reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
          word_product mult e xs' n' = apply_fun mult (c, x) ->
          n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i)).
      apply (and4E
        (reduced_word 2 Gfam efam n_c xs_c) (n_c <> 0)
        (word_product mult e xs_c n_c = apply_fun mult (c, x))
        (forall n' xs':set,
          reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
          word_product mult e xs' n' = apply_fun mult (c, x) ->
          n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i))
        Hxs_c_conj).
      assume Hred_c Hnc_ne Hprod_c Huniq_clause.
      (** Apply uniqueness to init_cs and tail_cs **)
      claim Hnc_k : n_c = k.
      { exact (andEL (n_c = k)
          (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun init_cs i)
          (Huniq_clause k init_cs Hinit_red Hk_ne0 Hwp_init_cx)). }
      claim Hxsc_init : forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun init_cs i.
      { exact (andER (n_c = k)
          (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun init_cs i)
          (Huniq_clause k init_cs Hinit_red Hk_ne0 Hwp_init_cx)). }
      claim Hxsc_tail : forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun tail_cs i.
      { exact (andER (n_c = k)
          (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun tail_cs i)
          (Huniq_clause k tail_cs Htail_red Hk_ne0 Hwp_tail_cx)). }
      (** Step 5: Extract at position 0, derive cs(0) = cs(1) **)
      claim H0_in_nc : 0 :e n_c.
      { exact (Hnc_k (fun _ b:set => 0 :e b) H0_in_k). }
      claim Hinit0 : apply_fun init_cs 0 = apply_fun cs 0.
      { exact (Hinit_eval 0 H0_in_k). }
      claim Htail0 : apply_fun tail_cs 0 = apply_fun cs 1.
      { exact (Htail_eval 0 H0_in_k). }
      claim Hcs0_eq_cs1 : apply_fun cs 0 = apply_fun cs 1.
      { claim Hxsc0_cs0 : apply_fun xs_c 0 = apply_fun cs 0.
        { exact (eq_i_tra (apply_fun xs_c 0) (apply_fun init_cs 0) (apply_fun cs 0)
            (Hxsc_init 0 H0_in_nc) Hinit0). }
        claim Hxsc0_cs1 : apply_fun xs_c 0 = apply_fun cs 1.
        { exact (eq_i_tra (apply_fun xs_c 0) (apply_fun tail_cs 0) (apply_fun cs 1)
            (Hxsc_tail 0 H0_in_nc) Htail0). }
        claim Hcs0_xsc0 : apply_fun cs 0 = apply_fun xs_c 0.
        { symmetry. exact Hxsc0_cs0. }
        exact (eq_i_tra (apply_fun cs 0) (apply_fun xs_c 0) (apply_fun cs 1)
          Hcs0_xsc0 Hxsc0_cs1). }
      (** Step 6: Adjacency contradiction **)
      claim Hcs1_G2 : apply_fun cs 1 :e G2.
      { exact (Hcs0_eq_cs1 (fun a _:set => a :e G2) Hcs0_G2). }
      claim H1_in_m : 1 :e m.
      { exact (Hm_eq (fun _ b:set => 1 :e b)
          (nat_ordsucc_in_ordsucc k Hk_nat 0 H0_in_k)). }
      claim Hcs0_Gfam1 : apply_fun cs 0 :e apply_fun Gfam 1.
      { rewrite HGfam1. exact Hcs0_G2. }
      claim Hcs1_Gfam1 : apply_fun cs 1 :e apply_fun Gfam 1.
      { rewrite HGfam1. exact Hcs1_G2. }
      claim H1ne1 : 1 <> 1.
      { exact (Hcs_adj 0 H0_in_m H1_in_m 1 1 In_1_2 In_1_2 Hcs0_Gfam1 Hcs1_Gfam1). }
      claim H1eq1 : 1 = 1. { reflexivity. }
      exact (H1ne1 H1eq1).
  + assume Hycs0_ne : ycs0 <> e.
    (** cskx=e, ycs0 ne e: k=0 contradiction, k>0 length mismatch **)
    apply (xm (k = 0)).
    * assume Hk0 : k = 0.
      claim Hcs0_G1 : apply_fun cs 0 :e G1.
      { exact (Hk0 (fun a _:set => apply_fun cs a :e G1) Hcsk_G1). }
      claim Hcs0_e : apply_fun cs 0 = e.
      { exact (Hinter 0 1 In_0_2 In_1_2 neq_0_1 (apply_fun cs 0)
          (HGfam0 (fun _ b:set => apply_fun cs 0 :e b) Hcs0_G1)
          (HGfam1 (fun _ b:set => apply_fun cs 0 :e b) Hcs0_G2)). }
      apply (exandE_i
        (fun al:set => al :e 2 /\ apply_fun cs 0 :e apply_fun Gfam al)
        (fun al:set => apply_fun cs 0 <> apply_fun efam al) (Hcs_mem 0 H0_in_m)).
      let al. assume Hal_c : al :e 2 /\ apply_fun cs 0 :e apply_fun Gfam al.
      assume Hne_efam : apply_fun cs 0 <> apply_fun efam al.
      claim Hal2 : al :e 2. { exact (andEL (al :e 2) (apply_fun cs 0 :e apply_fun Gfam al) Hal_c). }
      claim Hefam_e : apply_fun efam al = e. { exact (apply_fun_graph 2 (fun _:set => e) al Hal2). }
      claim Hefam_rev : e = apply_fun efam al. { symmetry. exact Hefam_e. }
      exact (Hne_efam (eq_i_tra (apply_fun cs 0) e (apply_fun efam al) Hcs0_e Hefam_rev)).
    * assume Hk_ne0 : k <> 0.
      (** k>0, cskx=e, ycs0 ne e: init word length k vs front word length m, mismatch **)
      (** Step 1: cx = word_product(init_cs, k) via cskx = e **)
      claim Hwpk_id : apply_fun mult (word_product mult e cs k, e) = word_product mult e cs k.
      { exact (andER
          (apply_fun mult (e, word_product mult e cs k) = word_product mult e cs k)
          (apply_fun mult (word_product mult e cs k, e) = word_product mult e cs k)
          (Hid (word_product mult e cs k) Hwpk_G)). }
      claim Hcskx_step : apply_fun mult (word_product mult e cs k, cskx) =
        apply_fun mult (word_product mult e cs k, e).
      { claim Hrefl_wpe : apply_fun mult (word_product mult e cs k, e) =
          apply_fun mult (word_product mult e cs k, e). { reflexivity. }
        exact (Hcskx_e (fun _ b:set =>
          apply_fun mult (word_product mult e cs k, b) =
          apply_fun mult (word_product mult e cs k, e)) Hrefl_wpe). }
      claim Hcx_eq_init : apply_fun mult (c, x) = word_product mult e init_cs k.
      { claim Hcx_wpk : apply_fun mult (c, x) = word_product mult e cs k.
        { exact (eq_i_tra (apply_fun mult (c, x))
            (apply_fun mult (word_product mult e cs k, cskx))
            (word_product mult e cs k)
            Hcx_eq_wpk
            (eq_i_tra (apply_fun mult (word_product mult e cs k, cskx))
              (apply_fun mult (word_product mult e cs k, e))
              (word_product mult e cs k)
              Hcskx_step Hwpk_id)). }
        claim Hwp_init_rev : word_product mult e cs k = word_product mult e init_cs k.
        { symmetry. exact Hwp_init_agree. }
        exact (eq_i_tra (apply_fun mult (c, x)) (word_product mult e cs k)
          (word_product mult e init_cs k) Hcx_wpk Hwp_init_rev). }
      claim Hwp_init_cx : word_product mult e init_cs k = apply_fun mult (c, x).
      { symmetry. exact Hcx_eq_init. }
      (** Step 2: front_cs is reduced **)
      claim Hfront_mem2 : forall j:set, j :e m ->
        exists alpha:set, alpha :e 2 /\
          apply_fun front_cs j :e apply_fun Gfam alpha /\
          apply_fun front_cs j <> apply_fun efam alpha.
      { let j. assume Hjm : j :e m.
        apply (xm (j = 0)).
        - assume Hj0 : j = 0.
          claim Hfj_eq : apply_fun front_cs j = ycs0.
          { exact (Hj0 (fun _ b:set => apply_fun front_cs b = ycs0) Hfront_0). }
          witness 1. apply and3I.
          + exact In_1_2.
          + exact (Hfj_eq (fun _ b:set => b :e apply_fun Gfam 1)
              (HGfam1 (fun _ b:set => ycs0 :e b) Hycs0_G2)).
          + rewrite Hfj_eq. rewrite Hefam1. exact Hycs0_ne.
        - assume Hjne0 : j <> 0.
          claim Hfj_eq : apply_fun front_cs j = apply_fun cs j.
          { exact (Hfront_ne_0 j Hjm Hjne0). }
          apply (Hcs_mem j Hjm). let al.
          assume Hal_conj : (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al) /\
            apply_fun cs j <> apply_fun efam al.
          witness al. apply and3I.
          + exact (andEL (al :e 2) (apply_fun cs j :e apply_fun Gfam al)
              (andEL (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
                (apply_fun cs j <> apply_fun efam al) Hal_conj)).
          + exact (Hfj_eq (fun _ b:set => b :e apply_fun Gfam al)
              (andER (al :e 2) (apply_fun cs j :e apply_fun Gfam al)
                (andEL (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
                  (apply_fun cs j <> apply_fun efam al) Hal_conj))).
          + exact (Hfj_eq (fun _ b:set => b <> apply_fun efam al)
              (andER (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
                (apply_fun cs j <> apply_fun efam al) Hal_conj)). }
      claim Hfront_adj2 : forall j:set, j :e m -> ordsucc j :e m ->
        forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
          apply_fun front_cs j :e apply_fun Gfam alpha ->
          apply_fun front_cs (ordsucc j) :e apply_fun Gfam beta ->
          alpha <> beta.
      { let j. assume Hjm : j :e m. assume Hsjm : ordsucc j :e m.
        let alpha beta. assume Hal2 : alpha :e 2. assume Hbe2 : beta :e 2.
        assume Hmj_al : apply_fun front_cs j :e apply_fun Gfam alpha.
        assume Hmsj_be : apply_fun front_cs (ordsucc j) :e apply_fun Gfam beta.
        claim Hsj_ne0 : ordsucc j <> 0.
        { assume Hsj0 : ordsucc j = 0.
          exact (EmptyE j (Hsj0 (fun a _:set => j :e a) (ordsuccI2 j))). }
        claim Hfront_sj_eq : apply_fun front_cs (ordsucc j) = apply_fun cs (ordsucc j).
        { exact (Hfront_ne_0 (ordsucc j) Hsjm Hsj_ne0). }
        claim Hcssj_be : apply_fun cs (ordsucc j) :e apply_fun Gfam beta.
        { exact (Hfront_sj_eq (fun a _:set => a :e apply_fun Gfam beta) Hmsj_be). }
        apply (xm (j = 0)).
        - assume Hj0 : j = 0.
          claim Hfront_j_eq : apply_fun front_cs j = ycs0.
          { exact (Hj0 (fun _ b:set => apply_fun front_cs b = ycs0) Hfront_0). }
          claim Hycs0_al : ycs0 :e apply_fun Gfam alpha.
          { exact (Hfront_j_eq (fun a _:set => a :e apply_fun Gfam alpha) Hmj_al). }
          claim Hcs0_Gfam1 : apply_fun cs 0 :e apply_fun Gfam 1. { rewrite HGfam1. exact Hcs0_G2. }
          claim Hcsj_Gfam1 : apply_fun cs j :e apply_fun Gfam 1.
          { exact (Hj0 (fun _ b:set => apply_fun cs b :e apply_fun Gfam 1) Hcs0_Gfam1). }
          assume Haleqbe : alpha = beta.
          apply (xm (alpha = 1)).
          + assume Hal1 : alpha = 1.
            claim Hbe1 : beta = 1. { rewrite <- Haleqbe. exact Hal1. }
            claim Hcssj_Gfam1 : apply_fun cs (ordsucc j) :e apply_fun Gfam 1.
            { exact (Hbe1 (fun a _:set => apply_fun cs (ordsucc j) :e apply_fun Gfam a) Hcssj_be). }
            claim H1ne1 : 1 <> 1.
            { exact (Hcs_adj j Hjm Hsjm 1 1 In_1_2 In_1_2 Hcsj_Gfam1 Hcssj_Gfam1). }
            claim H1eq1 : 1 = 1. { reflexivity. }
            exact (H1ne1 H1eq1).
          + assume Hal_ne1 : alpha <> 1.
            claim Hycs0_Gfam1 : ycs0 :e apply_fun Gfam 1. { rewrite HGfam1. exact Hycs0_G2. }
            exact (Hycs0_ne (Hinter alpha 1 Hal2 In_1_2 Hal_ne1 ycs0 Hycs0_al Hycs0_Gfam1)).
        - assume Hj_ne0 : j <> 0.
          claim Hfront_j_eq2 : apply_fun front_cs j = apply_fun cs j.
          { exact (Hfront_ne_0 j Hjm Hj_ne0). }
          claim Hcsj_al : apply_fun cs j :e apply_fun Gfam alpha.
          { exact (Hfront_j_eq2 (fun a _:set => a :e apply_fun Gfam alpha) Hmj_al). }
          exact (Hcs_adj j Hjm Hsjm alpha beta Hal2 Hbe2 Hcsj_al Hcssj_be). }
      claim Hfront_red2 : reduced_word 2 Gfam efam m front_cs.
      { prove (m :e omega /\
          (forall j:set, j :e m ->
            exists alpha:set, alpha :e 2 /\
              apply_fun front_cs j :e apply_fun Gfam alpha /\
              apply_fun front_cs j <> apply_fun efam alpha)) /\
          (forall j:set, j :e m -> ordsucc j :e m ->
            forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
              apply_fun front_cs j :e apply_fun Gfam alpha ->
              apply_fun front_cs (ordsucc j) :e apply_fun Gfam beta ->
              alpha <> beta).
        apply andI.
        - apply andI. + exact Hm_omega. + exact Hfront_mem2.
        - exact Hfront_adj2. }
      (** Step 3: word_product(front_cs, m) = cx **)
      claim Hfront_shift2 : forall i:set, i :e k ->
        apply_fun front_cs (ordsucc i) = apply_fun tail_cs i.
      { let i. assume Hik : i :e k.
        claim Hsi_ne0 : ordsucc i <> 0.
        { assume Hsi0 : ordsucc i = 0.
          exact (EmptyE i (Hsi0 (fun a _:set => i :e a) (ordsuccI2 i))). }
        claim Hsi_m : ordsucc i :e m.
        { exact (Hm_eq (fun _ b:set => ordsucc i :e b)
            (nat_ordsucc_in_ordsucc k Hk_nat i Hik)). }
        claim Hfront_si : apply_fun front_cs (ordsucc i) = apply_fun cs (ordsucc i).
        { exact (Hfront_ne_0 (ordsucc i) Hsi_m Hsi_ne0). }
        rewrite Hfront_si. exact (Hcs_shift_rev i Hik). }
      claim Hfront_prepend_raw2 : word_product mult e front_cs (ordsucc k) =
        apply_fun mult (apply_fun front_cs 0, word_product mult e tail_cs k).
      { exact (word_product_prepend mult e G k tail_cs front_cs
          HeG Hid Hmult_cl Hassoc
          (Hfront_0 (fun _ b:set => b :e G) Hycs0_G)
          Hk_omega Htail_G Hfront_shift2). }
      claim Hfront_prepend2 : word_product mult e front_cs (ordsucc k) =
        apply_fun mult (ycs0, word_product mult e tail_cs k).
      { rewrite Hfront_prepend_raw2. rewrite Hfront_0. reflexivity. }
      claim Hwp_front_yc : word_product mult e front_cs m = apply_fun mult (y, c).
      { claim Hwp_front_m : word_product mult e front_cs m =
          apply_fun mult (ycs0, word_product mult e tail_cs k).
        { exact (Hm_eq (fun _ b:set => word_product mult e front_cs b =
            apply_fun mult (ycs0, word_product mult e tail_cs k)) Hfront_prepend2). }
        claim Hassoc_ycs0 : apply_fun mult (ycs0, word_product mult e tail_cs k) =
          apply_fun mult (y, apply_fun mult (apply_fun cs 0, word_product mult e tail_cs k)).
        { exact (Hassoc y (apply_fun cs 0) (word_product mult e tail_cs k)
            HyG Hcs0_G2_g Hsp_G). }
        rewrite Hwp_front_m. rewrite Hassoc_ycs0. rewrite Hcs0_sp_eq_c. reflexivity. }
      claim Hwp_front_cx : word_product mult e front_cs m = apply_fun mult (c, x).
      { claim Hyc_eq_cx : apply_fun mult (y, c) = apply_fun mult (c, x).
        { symmetry. exact Hcx_eq_yc. }
        rewrite Hwp_front_yc. exact Hyc_eq_cx. }
      (** Step 4: Apply Hunique, derive length contradiction k = ordsucc k **)
      apply (Hunique (apply_fun mult (c, x)) HcxG Hcxne).
      let n_c. assume Hn_c_ex : exists xs_c:set,
        reduced_word 2 Gfam efam n_c xs_c /\ n_c <> 0 /\
        word_product mult e xs_c n_c = apply_fun mult (c, x) /\
        (forall n' xs':set,
          reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
          word_product mult e xs' n' = apply_fun mult (c, x) ->
          n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i)).
      apply Hn_c_ex.
      let xs_c. assume Hxs_c_conj :
        reduced_word 2 Gfam efam n_c xs_c /\ n_c <> 0 /\
        word_product mult e xs_c n_c = apply_fun mult (c, x) /\
        (forall n' xs':set,
          reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
          word_product mult e xs' n' = apply_fun mult (c, x) ->
          n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i)).
      apply (and4E
        (reduced_word 2 Gfam efam n_c xs_c)
        (n_c <> 0)
        (word_product mult e xs_c n_c = apply_fun mult (c, x))
        (forall n' xs':set,
          reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
          word_product mult e xs' n' = apply_fun mult (c, x) ->
          n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i))
        Hxs_c_conj).
      assume Hred_c Hnc_ne Hprod_c Huniq_clause.
      claim Hnc_k : n_c = k.
      { exact (andEL (n_c = k)
          (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun init_cs i)
          (Huniq_clause k init_cs Hinit_red Hk_ne0 Hwp_init_cx)). }
      claim Hnc_m : n_c = m.
      { exact (andEL (n_c = m)
          (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun front_cs i)
          (Huniq_clause m front_cs Hfront_red2 Hmne Hwp_front_cx)). }
      claim Hk_nc : k = n_c. { symmetry. exact Hnc_k. }
      claim Hk_eq_m : k = m. { exact (eq_i_tra k n_c m Hk_nc Hnc_m). }
      claim Hk_eq_sk : k = ordsucc k. { exact (Hm_eq (fun a _:set => k = a) Hk_eq_m). }
      exact (In_irref k (Hk_eq_sk (fun _ b:set => k :e b) (ordsuccI2 k))).
- assume Hcskx_ne : cskx <> e.
  apply (xm (ycs0 = e)).
  + assume Hycs0_e : ycs0 = e.
    (** cskx ne e, ycs0=e: k=0 contradiction, k>0 length mismatch **)
    apply (xm (k = 0)).
    * assume Hk0 : k = 0.
      claim Hcs0_G1 : apply_fun cs 0 :e G1.
      { exact (Hk0 (fun a _:set => apply_fun cs a :e G1) Hcsk_G1). }
      claim Hcs0_e : apply_fun cs 0 = e.
      { exact (Hinter 0 1 In_0_2 In_1_2 neq_0_1 (apply_fun cs 0)
          (HGfam0 (fun _ b:set => apply_fun cs 0 :e b) Hcs0_G1)
          (HGfam1 (fun _ b:set => apply_fun cs 0 :e b) Hcs0_G2)). }
      apply (exandE_i
        (fun al:set => al :e 2 /\ apply_fun cs 0 :e apply_fun Gfam al)
        (fun al:set => apply_fun cs 0 <> apply_fun efam al) (Hcs_mem 0 H0_in_m)).
      let al. assume Hal_c : al :e 2 /\ apply_fun cs 0 :e apply_fun Gfam al.
      assume Hne_efam : apply_fun cs 0 <> apply_fun efam al.
      claim Hal2 : al :e 2. { exact (andEL (al :e 2) (apply_fun cs 0 :e apply_fun Gfam al) Hal_c). }
      claim Hefam_e : apply_fun efam al = e. { exact (apply_fun_graph 2 (fun _:set => e) al Hal2). }
      claim Hefam_rev : e = apply_fun efam al. { symmetry. exact Hefam_e. }
      exact (Hne_efam (eq_i_tra (apply_fun cs 0) e (apply_fun efam al) Hcs0_e Hefam_rev)).
    * assume Hk_ne0 : k <> 0.
      (** k>0, cskx ne e, ycs0=e: back word length m vs tail word length k, mismatch **)
      (** Step 1: back_cs is reduced **)
      claim Hback_mem3 : forall j:set, j :e m ->
        exists alpha:set, alpha :e 2 /\
          apply_fun back_cs j :e apply_fun Gfam alpha /\
          apply_fun back_cs j <> apply_fun efam alpha.
      { let j. assume Hjm : j :e m.
        apply (xm (j = k)).
        - assume Hjk : j = k.
          claim Hbj_eq : apply_fun back_cs j = cskx.
          { exact (Hjk (fun _ b:set => apply_fun back_cs b = cskx) Hback_k). }
          witness 0. apply and3I.
          + exact In_0_2.
          + exact (Hbj_eq (fun _ b:set => b :e apply_fun Gfam 0)
              (HGfam0 (fun _ b:set => cskx :e b) Hcskx_G1)).
          + rewrite Hbj_eq. rewrite Hefam0. exact Hcskx_ne.
        - assume Hjnek : j <> k.
          claim Hbj_eq : apply_fun back_cs j = apply_fun cs j.
          { exact (Hback_ne_k j Hjm Hjnek). }
          apply (Hcs_mem j Hjm). let al.
          assume Hal_conj : (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al) /\
            apply_fun cs j <> apply_fun efam al.
          witness al. apply and3I.
          + exact (andEL (al :e 2) (apply_fun cs j :e apply_fun Gfam al)
              (andEL (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
                (apply_fun cs j <> apply_fun efam al) Hal_conj)).
          + exact (Hbj_eq (fun _ b:set => b :e apply_fun Gfam al)
              (andER (al :e 2) (apply_fun cs j :e apply_fun Gfam al)
                (andEL (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
                  (apply_fun cs j <> apply_fun efam al) Hal_conj))).
          + exact (Hbj_eq (fun _ b:set => b <> apply_fun efam al)
              (andER (al :e 2 /\ apply_fun cs j :e apply_fun Gfam al)
                (apply_fun cs j <> apply_fun efam al) Hal_conj)). }
      claim Hback_adj3 : forall j:set, j :e m -> ordsucc j :e m ->
        forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
          apply_fun back_cs j :e apply_fun Gfam alpha ->
          apply_fun back_cs (ordsucc j) :e apply_fun Gfam beta ->
          alpha <> beta.
      { let j. assume Hjm : j :e m. assume Hsjm : ordsucc j :e m.
        let alpha beta. assume Hal2 : alpha :e 2. assume Hbe2 : beta :e 2.
        assume Hmj_al : apply_fun back_cs j :e apply_fun Gfam alpha.
        assume Hmsj_be : apply_fun back_cs (ordsucc j) :e apply_fun Gfam beta.
        apply (xm (ordsucc j = k)).
        - assume Hsjk : ordsucc j = k.
          claim Hjnek : j <> k.
          { assume Hjek : j = k.
            claim Hsj_eq_m : ordsucc j = m.
            { claim Hsjsk : ordsucc j = ordsucc k. { rewrite Hjek. reflexivity. }
              rewrite Hsjsk. symmetry. exact Hm_eq. }
            exact (In_irref m (Hsj_eq_m (fun a _:set => a :e m) Hsjm)). }
          claim Hback_j_eq : apply_fun back_cs j = apply_fun cs j.
          { exact (Hback_ne_k j Hjm Hjnek). }
          claim Hback_sj_eq : apply_fun back_cs (ordsucc j) = cskx.
          { rewrite (apply_fun_graph m (fun j:set => If_i (j = k) cskx (apply_fun cs j))
              (ordsucc j) Hsjm).
            exact (If_i_1 (ordsucc j = k) cskx (apply_fun cs (ordsucc j)) Hsjk). }
          claim Hcsj_al : apply_fun cs j :e apply_fun Gfam alpha.
          { exact (Hback_j_eq (fun a _:set => a :e apply_fun Gfam alpha) Hmj_al). }
          claim Hcskx_be : cskx :e apply_fun Gfam beta.
          { exact (Hback_sj_eq (fun a _:set => a :e apply_fun Gfam beta) Hmsj_be). }
          assume Haleqbe : alpha = beta.
          claim Hcsk_Gfam0 : apply_fun cs k :e apply_fun Gfam 0. { rewrite HGfam0. exact Hcsk_G1. }
          claim Hcssk_Gfam0 : apply_fun cs (ordsucc j) :e apply_fun Gfam 0.
          { exact (Hsjk (fun _ b:set => apply_fun cs b :e apply_fun Gfam 0) Hcsk_Gfam0). }
          claim Hal_ne_0 : alpha <> 0.
          { exact (Hcs_adj j Hjm Hsjm alpha 0 Hal2 In_0_2 Hcsj_al Hcssk_Gfam0). }
          claim Hbe_ne_0 : beta <> 0. { rewrite <- Haleqbe. exact Hal_ne_0. }
          claim Hcskx_Gfam0 : cskx :e apply_fun Gfam 0. { rewrite HGfam0. exact Hcskx_G1. }
          exact (Hcskx_ne (Hinter beta 0 Hbe2 In_0_2 Hbe_ne_0 cskx Hcskx_be Hcskx_Gfam0)).
        - assume Hsjnek : ordsucc j <> k.
          claim Hjnek : j <> k.
          { assume Hjek : j = k.
            claim Hsj_eq_m : ordsucc j = m.
            { claim Hsjsk : ordsucc j = ordsucc k. { rewrite Hjek. reflexivity. }
              rewrite Hsjsk. symmetry. exact Hm_eq. }
            exact (In_irref m (Hsj_eq_m (fun a _:set => a :e m) Hsjm)). }
          claim Hback_j_eq2 : apply_fun back_cs j = apply_fun cs j.
          { exact (Hback_ne_k j Hjm Hjnek). }
          claim Hback_sj_eq2 : apply_fun back_cs (ordsucc j) = apply_fun cs (ordsucc j).
          { exact (Hback_ne_k (ordsucc j) Hsjm Hsjnek). }
          claim Hcsj_al : apply_fun cs j :e apply_fun Gfam alpha.
          { exact (Hback_j_eq2 (fun a _:set => a :e apply_fun Gfam alpha) Hmj_al). }
          claim Hcssj_be : apply_fun cs (ordsucc j) :e apply_fun Gfam beta.
          { exact (Hback_sj_eq2 (fun a _:set => a :e apply_fun Gfam beta) Hmsj_be). }
          exact (Hcs_adj j Hjm Hsjm alpha beta Hal2 Hbe2 Hcsj_al Hcssj_be). }
      claim Hback_red3 : reduced_word 2 Gfam efam m back_cs.
      { prove (m :e omega /\
          (forall j:set, j :e m ->
            exists alpha:set, alpha :e 2 /\
              apply_fun back_cs j :e apply_fun Gfam alpha /\
              apply_fun back_cs j <> apply_fun efam alpha)) /\
          (forall j:set, j :e m -> ordsucc j :e m ->
            forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
              apply_fun back_cs j :e apply_fun Gfam alpha ->
              apply_fun back_cs (ordsucc j) :e apply_fun Gfam beta ->
              alpha <> beta).
        apply andI.
        - apply andI. + exact Hm_omega. + exact Hback_mem3.
        - exact Hback_adj3. }
      (** Step 2: word_product(back_cs, m) = cx **)
      claim Hback_agree3 : forall j:set, j :e k -> apply_fun back_cs j = apply_fun cs j.
      { let j. assume Hjk : j :e k.
        exact (Hback_ne_k j (nat_trans m Hm_nat k Hk_in_m j Hjk)
          (fun Hjek : j = k => In_irref k (Hjek (fun a _:set => a :e k) Hjk))). }
      claim Hwp_back_k3 : word_product mult e back_cs k = word_product mult e cs k.
      { exact (word_product_agree mult e back_cs cs k Hk_omega Hback_agree3). }
      claim Hwp_back3 : word_product mult e back_cs m = apply_fun mult (c, x).
      { claim Hwp_step : word_product mult e back_cs (ordsucc k) =
          apply_fun mult (word_product mult e back_cs k, apply_fun back_cs k).
        { exact (nat_primrec_S e (fun i r => apply_fun mult (r, apply_fun back_cs i)) k Hk_nat). }
        claim Hwp_back_m : word_product mult e back_cs m =
          apply_fun mult (word_product mult e back_cs k, apply_fun back_cs k).
        { exact (Hm_eq (fun _ b:set => word_product mult e back_cs b =
            apply_fun mult (word_product mult e back_cs k, apply_fun back_cs k)) Hwp_step). }
        rewrite Hwp_back_m. rewrite Hback_k. rewrite Hwp_back_k3.
        symmetry. exact Hcx_eq_wpk. }
      (** Step 3: word_product(tail_cs, k) = cx via ycs0 = e **)
      claim Hid_sp : apply_fun mult (e, word_product mult e tail_cs k) =
        word_product mult e tail_cs k.
      { exact (andEL
          (apply_fun mult (e, word_product mult e tail_cs k) = word_product mult e tail_cs k)
          (apply_fun mult (word_product mult e tail_cs k, e) = word_product mult e tail_cs k)
          (Hid (word_product mult e tail_cs k) Hsp_G)). }
      claim Hyc_decomp : apply_fun mult (y, c) =
        apply_fun mult (y, apply_fun mult (apply_fun cs 0, word_product mult e tail_cs k)).
      { claim Hrefl_yc : apply_fun mult (y, c) = apply_fun mult (y, c). { reflexivity. }
        exact (Hcs0_sp_eq_c (fun _ b:set =>
          apply_fun mult (y, c) = apply_fun mult (y, b)) Hrefl_yc). }
      claim Hassoc_ycs0_rev :
        apply_fun mult (y, apply_fun mult (apply_fun cs 0, word_product mult e tail_cs k)) =
        apply_fun mult (ycs0, word_product mult e tail_cs k).
      { symmetry. exact (Hassoc y (apply_fun cs 0) (word_product mult e tail_cs k)
          HyG Hcs0_G2_g Hsp_G). }
      claim Hycs0_to_e :
        apply_fun mult (ycs0, word_product mult e tail_cs k) =
        apply_fun mult (e, word_product mult e tail_cs k).
      { claim Hrefl_ewp : apply_fun mult (e, word_product mult e tail_cs k) =
          apply_fun mult (e, word_product mult e tail_cs k). { reflexivity. }
        exact (Hycs0_e (fun _ b:set =>
          apply_fun mult (b, word_product mult e tail_cs k) =
          apply_fun mult (e, word_product mult e tail_cs k)) Hrefl_ewp). }
      claim Hcx_eq_tail : apply_fun mult (c, x) = word_product mult e tail_cs k.
      { claim Hyc_eq_sp : apply_fun mult (y, c) = word_product mult e tail_cs k.
        { exact (eq_i_tra (apply_fun mult (y, c))
            (apply_fun mult (y, apply_fun mult (apply_fun cs 0, word_product mult e tail_cs k)))
            (word_product mult e tail_cs k)
            Hyc_decomp
            (eq_i_tra
              (apply_fun mult (y, apply_fun mult (apply_fun cs 0, word_product mult e tail_cs k)))
              (apply_fun mult (ycs0, word_product mult e tail_cs k))
              (word_product mult e tail_cs k)
              Hassoc_ycs0_rev
              (eq_i_tra
                (apply_fun mult (ycs0, word_product mult e tail_cs k))
                (apply_fun mult (e, word_product mult e tail_cs k))
                (word_product mult e tail_cs k)
                Hycs0_to_e Hid_sp))). }
        exact (eq_i_tra (apply_fun mult (c, x)) (apply_fun mult (y, c))
          (word_product mult e tail_cs k) Hcx_eq_yc Hyc_eq_sp). }
      claim Hwp_tail_cx : word_product mult e tail_cs k = apply_fun mult (c, x).
      { symmetry. exact Hcx_eq_tail. }
      (** Step 4: Apply Hunique, derive m = k contradiction **)
      apply (Hunique (apply_fun mult (c, x)) HcxG Hcxne).
      let n_c. assume Hn_c_ex : exists xs_c:set,
        reduced_word 2 Gfam efam n_c xs_c /\ n_c <> 0 /\
        word_product mult e xs_c n_c = apply_fun mult (c, x) /\
        (forall n' xs':set,
          reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
          word_product mult e xs' n' = apply_fun mult (c, x) ->
          n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i)).
      apply Hn_c_ex.
      let xs_c. assume Hxs_c_conj :
        reduced_word 2 Gfam efam n_c xs_c /\ n_c <> 0 /\
        word_product mult e xs_c n_c = apply_fun mult (c, x) /\
        (forall n' xs':set,
          reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
          word_product mult e xs' n' = apply_fun mult (c, x) ->
          n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i)).
      apply (and4E
        (reduced_word 2 Gfam efam n_c xs_c) (n_c <> 0)
        (word_product mult e xs_c n_c = apply_fun mult (c, x))
        (forall n' xs':set,
          reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
          word_product mult e xs' n' = apply_fun mult (c, x) ->
          n_c = n' /\ (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun xs' i))
        Hxs_c_conj).
      assume Hred_c Hnc_ne Hprod_c Huniq_clause.
      claim Hnc_m : n_c = m.
      { exact (andEL (n_c = m)
          (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun back_cs i)
          (Huniq_clause m back_cs Hback_red3 Hmne Hwp_back3)). }
      claim Hnc_k : n_c = k.
      { exact (andEL (n_c = k)
          (forall i:set, i :e n_c -> apply_fun xs_c i = apply_fun tail_cs i)
          (Huniq_clause k tail_cs Htail_red Hk_ne0 Hwp_tail_cx)). }
      claim Hm_nc : m = n_c. { symmetry. exact Hnc_m. }
      claim Hm_eq_k : m = k. { exact (eq_i_tra m n_c k Hm_nc Hnc_k). }
      claim Hsk_eq_k : ordsucc k = k.
      { claim Hsk_eq_m : ordsucc k = m. { symmetry. exact Hm_eq. }
        exact (eq_i_tra (ordsucc k) m k Hsk_eq_m Hm_eq_k). }
      exact (In_irref k (Hsk_eq_k (fun a _:set => k :e a) (ordsuccI2 k))).
  + assume Hycs0_ne : ycs0 <> e.
    (** Both nonzero: call the both-ne helper **)
    exact (ex68_3_case_G1_first_G2_both_ne G mult e inv G1 G2 c x m cs k
      Hfp HcG HxG1 HyG2 Hyne Hxne Hcxne Hred Hmne Hprod Hm_eq Hk_nat Hcsk_G1 Hcs0_G2
      Hcskx_ne Hycs0_ne).
Qed.

(** Sub-helper: Case last entry of c's word in G1 **)
Lemma ex68_3_case_last_G1 : forall G mult e inv G1 G2 c x m cs k:set,
  free_product_of_subgroups G mult e inv 2
    (graph 2 (fun i:set => If_i (i = 0) G1 G2))
    (graph 2 (fun _:set => e)) ->
  c :e G -> x :e G1 ->
  apply_fun mult (apply_fun mult (c, x), apply_fun inv c) :e G2 ->
  apply_fun mult (apply_fun mult (c, x), apply_fun inv c) <> e ->
  x <> e ->
  apply_fun mult (c, x) <> e ->
  reduced_word 2 (graph 2 (fun i:set => If_i (i = 0) G1 G2))
    (graph 2 (fun _:set => e)) m cs ->
  m <> 0 -> word_product mult e cs m = c ->
  m = ordsucc k -> nat_p k ->
  apply_fun cs k :e G1 ->
  False.
let G mult e inv G1 G2 c x m cs k.
set Gfam := graph 2 (fun i:set => If_i (i = 0) G1 G2).
set efam := graph 2 (fun _:set => e).
assume Hfp : free_product_of_subgroups G mult e inv 2 Gfam efam.
assume HcG : c :e G. assume HxG1 : x :e G1.
set y := apply_fun mult (apply_fun mult (c, x), apply_fun inv c).
assume HyG2 : y :e G2.
assume Hyne : y <> e. assume Hxne : x <> e.
assume Hcxne : apply_fun mult (c, x) <> e.
assume Hred : reduced_word 2 Gfam efam m cs.
assume Hmne : m <> 0. assume Hprod : word_product mult e cs m = c.
assume Hm_eq : m = ordsucc k. assume Hk_nat : nat_p k.
assume Hcsk_G1 : apply_fun cs k :e G1.
(** Get factor of first entry cs(0) **)
claim H0_in_m : 0 :e m. { rewrite Hm_eq. exact (nat_0_in_ordsucc k Hk_nat). }
apply (and3E
  (m :e omega)
  (forall i:set, i :e m ->
    exists alpha:set, alpha :e 2 /\
      apply_fun cs i :e apply_fun Gfam alpha /\
      apply_fun cs i <> apply_fun efam alpha)
  (forall i:set, i :e m -> ordsucc i :e m ->
    forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
      apply_fun cs i :e apply_fun Gfam alpha ->
      apply_fun cs (ordsucc i) :e apply_fun Gfam beta -> alpha <> beta)
  Hred).
assume Hm_omega Hcs_mem Hcs_adj.
apply (exandE_i
  (fun al:set => al :e 2 /\ apply_fun cs 0 :e apply_fun Gfam al)
  (fun al:set => apply_fun cs 0 <> apply_fun efam al)
  (Hcs_mem 0 H0_in_m)).
let alpha_first.
assume Haf_conj : alpha_first :e 2 /\ apply_fun cs 0 :e apply_fun Gfam alpha_first.
assume Hcs0_ne_efam : apply_fun cs 0 <> apply_fun efam alpha_first.
claim Haf2 : alpha_first :e 2.
{ exact (andEL (alpha_first :e 2) (apply_fun cs 0 :e apply_fun Gfam alpha_first) Haf_conj). }
claim Hcs0_fam : apply_fun cs 0 :e apply_fun Gfam alpha_first.
{ exact (andER (alpha_first :e 2) (apply_fun cs 0 :e apply_fun Gfam alpha_first) Haf_conj). }
claim H00 : 0 = 0. { reflexivity. }
claim HGfam0 : apply_fun Gfam 0 = G1.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 0 In_0_2).
  exact (If_i_1 (0 = 0) G1 G2 H00). }
claim HGfam1 : apply_fun Gfam 1 = G2.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 1 In_1_2).
  exact (If_i_0 (1 = 0) G1 G2 neq_1_0). }
apply (xm (alpha_first = 0)).
- assume Haf0 : alpha_first = 0.
  claim Hcs0_G1 : apply_fun cs 0 :e G1.
  { claim Hfam_af0 : apply_fun Gfam alpha_first = G1. { rewrite Haf0. exact HGfam0. }
    rewrite <- Hfam_af0. exact Hcs0_fam. }
  exact (ex68_3_case_G1_first_G1 G mult e inv G1 G2 c x m cs k
    Hfp HcG HxG1 HyG2 Hyne Hxne Hcxne Hred Hmne Hprod Hm_eq Hk_nat Hcsk_G1 Hcs0_G1).
- assume Haf_ne0 : alpha_first <> 0.
  claim Haf1 : alpha_first = 1.
  { apply (ordsuccE 1 alpha_first Haf2).
    + assume H : alpha_first :e 1. apply (ordsuccE 0 alpha_first H).
      * assume H2 : alpha_first :e 0. exact (EmptyE alpha_first H2 (alpha_first = 1)).
      * assume H2 : alpha_first = 0. exact (Haf_ne0 H2 (alpha_first = 1)).
    + assume H : alpha_first = 1. exact H. }
  claim Hcs0_G2 : apply_fun cs 0 :e G2.
  { claim Hfam_af1 : apply_fun Gfam alpha_first = G2. { rewrite Haf1. exact HGfam1. }
    rewrite <- Hfam_af1. exact Hcs0_fam. }
  (** cs(0) in G2, cs(k) in G1: call case_G1_first_G2 helper **)
  exact (ex68_3_case_G1_first_G2 G mult e inv G1 G2 c x m cs k
    Hfp HcG HxG1 HyG2 Hyne Hxne Hcxne Hred Hmne Hprod Hm_eq Hk_nat Hcsk_G1 Hcs0_G2).
Qed.

(** Core helper: given free product and reduced word of c, derive contradiction **)
(** from y = cxc^{-1} in G2, y <> e, x in G1, x <> e, cx <> e **)
Lemma ex68_3_core : forall G mult e inv G1 G2 c x m cs:set,
  let Gfam := graph 2 (fun i:set => If_i (i = 0) G1 G2) in
  let efam := graph 2 (fun _:set => e) in
  let y := apply_fun mult (apply_fun mult (c, x), apply_fun inv c) in
  free_product_of_subgroups G mult e inv 2 Gfam efam ->
  c :e G -> x :e G1 -> y :e G2 -> y <> e -> x <> e ->
  apply_fun mult (c, x) <> e ->
  reduced_word 2 Gfam efam m cs ->
  m <> 0 ->
  word_product mult e cs m = c ->
  False.
let G mult e inv G1 G2 c x m cs.
set Gfam := graph 2 (fun i:set => If_i (i = 0) G1 G2).
set efam := graph 2 (fun _:set => e).
set y := apply_fun mult (apply_fun mult (c, x), apply_fun inv c).
assume Hfp : free_product_of_subgroups G mult e inv 2 Gfam efam.
assume HcG : c :e G.
assume HxG1 : x :e G1.
assume HyG2 : y :e G2.
assume Hyne : y <> e.
assume Hxne : x <> e.
assume Hcxne : apply_fun mult (c, x) <> e.
assume Hred : reduced_word 2 Gfam efam m cs.
assume Hmne : m <> 0.
assume Hprod : word_product mult e cs m = c.
(** Extract free product components **)
apply (and6E
  (group_structure G mult e inv)
  (forall alpha:set, alpha :e 2 -> subgroup_of (apply_fun Gfam alpha) G mult e inv)
  (forall alpha beta:set, alpha :e 2 -> beta :e 2 -> alpha <> beta ->
    forall z:set, z :e apply_fun Gfam alpha -> z :e apply_fun Gfam beta -> z = e)
  (subgroups_generate G mult e inv 2 Gfam)
  (forall z:set, z :e G -> z <> e ->
    exists n xs:set,
      reduced_word 2 Gfam efam n xs /\ n <> 0 /\
      word_product mult e xs n = z /\
      (forall n' xs':set,
        reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
        word_product mult e xs' n' = z ->
        n = n' /\ (forall i:set, i :e n -> apply_fun xs i = apply_fun xs' i)))
  (forall alpha:set, alpha :e 2 -> apply_fun efam alpha = e)
  Hfp).
assume Hgrp Hsub Hinter Hgen Hunique _.
(** Compute Gfam evaluations **)
claim H00 : 0 = 0. { reflexivity. }
claim HGfam0 : apply_fun Gfam 0 = G1.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 0 In_0_2).
  exact (If_i_1 (0 = 0) G1 G2 H00). }
claim HGfam1 : apply_fun Gfam 1 = G2.
{ rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 1 In_1_2).
  exact (If_i_0 (1 = 0) G1 G2 neq_1_0). }
(** Extract subgroup and group structure **)
claim HsubG1 : subgroup_of G1 G mult e inv.
{ rewrite <- HGfam0. exact (Hsub 0 In_0_2). }
claim HsubG2 : subgroup_of G2 G mult e inv.
{ rewrite <- HGfam1. exact (Hsub 1 In_1_2). }
apply (and4E (G1 c= G) (e :e G1)
  (forall x1 y1:set, x1 :e G1 -> y1 :e G1 -> apply_fun mult (x1, y1) :e G1)
  (forall x1:set, x1 :e G1 -> apply_fun inv x1 :e G1) HsubG1).
assume HG1sub HeG1 HG1mult HG1inv.
apply (and4E (G2 c= G) (e :e G2)
  (forall x1 y1:set, x1 :e G2 -> y1 :e G2 -> apply_fun mult (x1, y1) :e G2)
  (forall x1:set, x1 :e G2 -> apply_fun inv x1 :e G2) HsubG2).
assume HG2sub HeG2 HG2mult HG2inv.
claim Hinter_simple : forall z:set, z :e G1 -> z :e G2 -> z = e.
{ let z. assume HzG1 : z :e G1. assume HzG2 : z :e G2.
  claim HzGfam0 : z :e apply_fun Gfam 0. { rewrite HGfam0. exact HzG1. }
  claim HzGfam1 : z :e apply_fun Gfam 1. { rewrite HGfam1. exact HzG2. }
  exact (Hinter 0 1 In_0_2 In_1_2 neq_0_1 z HzGfam0 HzGfam1). }
apply (and6E
  (function_on mult (setprod G G) G) (function_on inv G G) (e :e G)
  (forall x1 y1 z1:set, x1 :e G -> y1 :e G -> z1 :e G ->
    apply_fun mult (apply_fun mult (x1, y1), z1) = apply_fun mult (x1, apply_fun mult (y1, z1)))
  (forall x1:set, x1 :e G -> apply_fun mult (e, x1) = x1 /\ apply_fun mult (x1, e) = x1)
  (forall x1:set, x1 :e G ->
    apply_fun mult (x1, apply_fun inv x1) = e /\ apply_fun mult (apply_fun inv x1, x1) = e)
  Hgrp).
assume HmultF HinvF HeG Hassoc Hid Hinverse.
(** Extract reduced word components **)
apply (and3E
  (m :e omega)
  (forall i:set, i :e m ->
    exists alpha:set, alpha :e 2 /\
      apply_fun cs i :e apply_fun Gfam alpha /\
      apply_fun cs i <> apply_fun efam alpha)
  (forall i:set, i :e m -> ordsucc i :e m ->
    forall alpha beta:set, alpha :e 2 -> beta :e 2 ->
      apply_fun cs i :e apply_fun Gfam alpha ->
      apply_fun cs (ordsucc i) :e apply_fun Gfam beta -> alpha <> beta)
  Hred).
assume Hm_omega Hcs_mem Hcs_adj.
claim HxG : x :e G. { exact (HG1sub x HxG1). }
claim HyG : y :e G. { exact (HG2sub y HyG2). }
(** m is a successor **)
claim Hm_nat : nat_p m. { exact (omega_nat_p m Hm_omega). }
apply (nat_inv m Hm_nat).
{ assume Hm0 : m = 0. exact (Hmne Hm0). }
assume Hm_succ : exists p:set, nat_p p /\ m = ordsucc p.
apply Hm_succ. let k. assume Hk_conj : nat_p k /\ m = ordsucc k.
claim Hk_nat : nat_p k. { exact (andEL (nat_p k) (m = ordsucc k) Hk_conj). }
claim Hm_eq : m = ordsucc k. { exact (andER (nat_p k) (m = ordsucc k) Hk_conj). }
claim Hk_in_m : k :e m. { rewrite Hm_eq. exact (ordsuccI2 k). }
claim H0_in_m : 0 :e m. { rewrite Hm_eq. exact (nat_0_in_ordsucc k Hk_nat). }
(** Get factor of last entry cs(k) and first entry cs(0) **)
apply (Hcs_mem k Hk_in_m). let alpha_last.
assume Hal_conj : alpha_last :e 2 /\ apply_fun cs k :e apply_fun Gfam alpha_last /\
  apply_fun cs k <> apply_fun efam alpha_last.
claim Hal_AB : alpha_last :e 2 /\ apply_fun cs k :e apply_fun Gfam alpha_last.
{ exact (andEL (alpha_last :e 2 /\ apply_fun cs k :e apply_fun Gfam alpha_last)
    (apply_fun cs k <> apply_fun efam alpha_last) Hal_conj). }
claim Hal2 : alpha_last :e 2.
{ exact (andEL (alpha_last :e 2) (apply_fun cs k :e apply_fun Gfam alpha_last) Hal_AB). }
claim Hcsk_fam : apply_fun cs k :e apply_fun Gfam alpha_last.
{ exact (andER (alpha_last :e 2) (apply_fun cs k :e apply_fun Gfam alpha_last) Hal_AB). }
(** Case split on alpha_last using xm **)
apply (xm (alpha_last = 0)).
+ assume Hal0 : alpha_last = 0.
  claim Heval_al0 : apply_fun Gfam alpha_last = G1.
  { rewrite Hal0. exact HGfam0. }
  claim Hcsk_G1 : apply_fun cs k :e G1.
  { rewrite <- Heval_al0. exact Hcsk_fam. }
  exact (ex68_3_case_last_G1 G mult e inv G1 G2 c x m cs k
    Hfp HcG HxG1 HyG2 Hyne Hxne Hcxne Hred Hmne Hprod Hm_eq Hk_nat Hcsk_G1).
+ assume Hal_ne0 : alpha_last <> 0.
  (** alpha_last in {0,1} and != 0, so alpha_last = 1 **)
  claim Hal1 : alpha_last = 1.
  { apply (ordsuccE 1 alpha_last Hal2).
    + assume Hal_in1 : alpha_last :e 1.
      apply (ordsuccE 0 alpha_last Hal_in1).
      * assume Hal_in0 : alpha_last :e 0. exact (EmptyE alpha_last Hal_in0 (alpha_last = 1)).
      * assume Hal_eq0 : alpha_last = 0. exact (Hal_ne0 Hal_eq0 (alpha_last = 1)).
    + assume Hal_eq1 : alpha_last = 1. exact Hal_eq1. }
  claim Heval_al1 : apply_fun Gfam alpha_last = G2.
  { rewrite Hal1. exact HGfam1. }
  claim Hcsk_G2 : apply_fun cs k :e G2.
  { rewrite <- Heval_al1. exact Hcsk_fam. }
  exact (ex68_3_case_last_G2 G mult e inv G1 G2 c x m cs k
    Hfp HcG HxG1 HyG2 Hyne Hxne Hcxne Hred Hmne Hprod Hm_eq Hk_nat Hcsk_G2).
Qed.

(** from S68 Exercise 3 (line 3029 in algtop.tex) **)
(** LATEX VERSION: Let G = G1 free-product G2. Given c in G, cG1c^{-1} cap G2 = {1}. **)
(** EFFORT: 5 lines textbook, difficulty 4/10, USD 60 **)
(** Collected Alice 73 **)
(** Proven Alice **)
Theorem ex68_3_conjugate_intersection_trivial :
  forall G mult e inv G1 G2:set,
  free_product_of_subgroups G mult e inv 2
    (graph 2 (fun i => if i = 0 then G1 else G2))
    (graph 2 (fun _ => e)) ->
  forall c:set, c :e G ->
    forall x:set, x :e G1 ->
      apply_fun mult (apply_fun mult (c, x), apply_fun inv c) :e G2 ->
      apply_fun mult (apply_fun mult (c, x), apply_fun inv c) = e.
let G mult e inv G1 G2.
set Gfam := graph 2 (fun i:set => If_i (i = 0) G1 G2).
set efam := graph 2 (fun _:set => e).
assume Hfp : free_product_of_subgroups G mult e inv 2 Gfam efam.
let c. assume HcG : c :e G.
let x. assume HxG1 : x :e G1.
set y := apply_fun mult (apply_fun mult (c, x), apply_fun inv c).
assume HyG2 : y :e G2.
(** Use excluded middle: either y = e (done) or y <> e (derive contradiction) **)
apply (xm (y = e)).
- assume Hye : y = e. exact Hye.
- assume Hyne : y <> e.
  prove False.
  (** Extract free product components **)
  apply (and6E
    (group_structure G mult e inv)
    (forall alpha:set, alpha :e 2 -> subgroup_of (apply_fun Gfam alpha) G mult e inv)
    (forall alpha beta:set, alpha :e 2 -> beta :e 2 -> alpha <> beta ->
      forall z:set, z :e apply_fun Gfam alpha -> z :e apply_fun Gfam beta -> z = e)
    (subgroups_generate G mult e inv 2 Gfam)
    (forall z:set, z :e G -> z <> e ->
      exists n xs:set,
        reduced_word 2 Gfam efam n xs /\ n <> 0 /\
        word_product mult e xs n = z /\
        (forall n' xs':set,
          reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
          word_product mult e xs' n' = z ->
          n = n' /\ (forall i:set, i :e n -> apply_fun xs i = apply_fun xs' i)))
    (forall alpha:set, alpha :e 2 -> apply_fun efam alpha = e)
    Hfp).
  assume Hgrp Hsub Hinter Hgen Hunique _.
  (** Compute Gfam evaluations **)
  claim H00 : 0 = 0. { reflexivity. }
  claim Hn00 : ~(1 = 0). { exact neq_1_0. }
  claim HGfam0 : apply_fun Gfam 0 = G1.
  { rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 0 In_0_2).
    exact (If_i_1 (0 = 0) G1 G2 H00). }
  claim HGfam1 : apply_fun Gfam 1 = G2.
  { rewrite (apply_fun_graph 2 (fun i:set => If_i (i = 0) G1 G2) 1 In_1_2).
    exact (If_i_0 (1 = 0) G1 G2 Hn00). }
  (** Extract subgroup properties **)
  claim HsubG1 : subgroup_of G1 G mult e inv.
  { rewrite <- HGfam0. exact (Hsub 0 In_0_2). }
  claim HsubG2 : subgroup_of G2 G mult e inv.
  { rewrite <- HGfam1. exact (Hsub 1 In_1_2). }
  apply (and4E
    (G1 c= G) (e :e G1)
    (forall x1 y1:set, x1 :e G1 -> y1 :e G1 -> apply_fun mult (x1, y1) :e G1)
    (forall x1:set, x1 :e G1 -> apply_fun inv x1 :e G1)
    HsubG1).
  assume HG1sub HeG1 HG1mult HG1inv.
  apply (and4E
    (G2 c= G) (e :e G2)
    (forall x1 y1:set, x1 :e G2 -> y1 :e G2 -> apply_fun mult (x1, y1) :e G2)
    (forall x1:set, x1 :e G2 -> apply_fun inv x1 :e G2)
    HsubG2).
  assume HG2sub HeG2 HG2mult HG2inv.
  (** Simple intersection property **)
  claim Hinter_simple : forall z:set, z :e G1 -> z :e G2 -> z = e.
  {
    let z. assume HzG1 : z :e G1. assume HzG2 : z :e G2.
    claim HzGfam0 : z :e apply_fun Gfam 0. { rewrite HGfam0. exact HzG1. }
    claim HzGfam1 : z :e apply_fun Gfam 1. { rewrite HGfam1. exact HzG2. }
    exact (Hinter 0 1 In_0_2 In_1_2 neq_0_1 z HzGfam0 HzGfam1).
  }
  (** Extract group structure **)
  apply (and6E
    (function_on mult (setprod G G) G)
    (function_on inv G G)
    (e :e G)
    (forall x1 y1 z1:set, x1 :e G -> y1 :e G -> z1 :e G ->
      apply_fun mult (apply_fun mult (x1, y1), z1) = apply_fun mult (x1, apply_fun mult (y1, z1)))
    (forall x1:set, x1 :e G -> apply_fun mult (e, x1) = x1 /\ apply_fun mult (x1, e) = x1)
    (forall x1:set, x1 :e G ->
      apply_fun mult (x1, apply_fun inv x1) = e /\ apply_fun mult (apply_fun inv x1, x1) = e)
    Hgrp).
  assume HmultF HinvF HeG Hassoc Hid Hinverse.
  (** Key membership facts **)
  claim HxG : x :e G. { exact (HG1sub x HxG1). }
  claim HyG : y :e G. { exact (HG2sub y HyG2). }
  claim HinvcG : apply_fun inv c :e G. { exact (HinvF c HcG). }
  (** y <> e implies x <> e **)
  claim Hxne : x <> e.
  { assume Hxe : x = e.
    apply Hyne.
    rewrite Hxe.
    claim Hce : apply_fun mult (c, e) = c.
    { exact (andER (apply_fun mult (e, c) = c) (apply_fun mult (c, e) = c) (Hid c HcG)). }
    rewrite Hce.
    claim Hcinvc : apply_fun mult (c, apply_fun inv c) = e.
    { exact (andEL (apply_fun mult (c, apply_fun inv c) = e) (apply_fun mult (apply_fun inv c, c) = e) (Hinverse c HcG)). }
    exact Hcinvc. }
  (** c = e case: y = x, so x in G1 cap G2, x = e, contradiction **)
  apply (xm (c = e)).
  + assume Hce : c = e.
     (** y = mult(mult(c,x), inv(c)). With c = e, y = mult(mult(e,x), inv(e)) = x **)
     claim Hex : apply_fun mult (e, x) = x.
     { exact (andEL (apply_fun mult (e, x) = x) (apply_fun mult (x, e) = x) (Hid x HxG)). }
     claim Hinve : apply_fun inv e = e.
     { claim Hinve1 : apply_fun mult (e, apply_fun inv e) = e.
       { exact (andEL
           (apply_fun mult (e, apply_fun inv e) = e)
           (apply_fun mult (apply_fun inv e, e) = e)
           (Hinverse e HeG)). }
       claim HinveG : apply_fun inv e :e G.
       { exact (HinvF e HeG). }
       claim Hinve2 : apply_fun mult (e, apply_fun inv e) = apply_fun inv e.
       { exact (andEL
           (apply_fun mult (e, apply_fun inv e) = apply_fun inv e)
           (apply_fun mult (apply_fun inv e, e) = apply_fun inv e)
           (Hid (apply_fun inv e) HinveG)). }
       rewrite <- Hinve2. exact Hinve1. }
     claim Hxe2 : apply_fun mult (x, e) = x.
     { exact (andER (apply_fun mult (e, x) = x) (apply_fun mult (x, e) = x) (Hid x HxG)). }
     claim Hyeqx : y = x.
     { prove apply_fun mult (apply_fun mult (c, x), apply_fun inv c) = x.
       rewrite Hce. rewrite Hex. rewrite Hinve. exact Hxe2. }
     claim HxG2 : x :e G2.
     { rewrite <- Hyeqx. exact HyG2. }
     apply Hyne. rewrite Hyeqx. exact (Hinter_simple x HxG1 HxG2).
  + assume Hcne : c <> e.
     (** Main case: c <> e, x <> e, y <> e **)
     (** cx <> e: if cx = e then c = inv(x) in G1, y = inv(c) in G1 cap G2 = e **)
     claim HcxG : apply_fun mult (c, x) :e G.
     { exact (HmultF (c, x) (tuple_2_setprod_by_pair_Sigma G G c x HcG HxG)). }
     apply (xm (apply_fun mult (c, x) = e)).
     * assume Hcxe : apply_fun mult (c, x) = e.
         (** y = mult(mult(c,x), inv(c)) = mult(e, inv(c)) = inv(c) **)
         claim HeInvc : apply_fun mult (e, apply_fun inv c) = apply_fun inv c.
         { exact (andEL
             (apply_fun mult (e, apply_fun inv c) = apply_fun inv c)
             (apply_fun mult (apply_fun inv c, e) = apply_fun inv c)
             (Hid (apply_fun inv c) HinvcG)). }
         claim Hyeqinvc : y = apply_fun inv c.
         { prove apply_fun mult (apply_fun mult (c, x), apply_fun inv c) = apply_fun inv c.
           rewrite Hcxe. exact HeInvc. }
         (** inv(c) = x: from cx = e derive inv(c) = x **)
         claim Hinvc_c : apply_fun mult (apply_fun inv c, c) = e.
         { exact (andER
             (apply_fun mult (c, apply_fun inv c) = e)
             (apply_fun mult (apply_fun inv c, c) = e)
             (Hinverse c HcG)). }
         claim Hex2 : apply_fun mult (e, x) = x.
         { exact (andEL (apply_fun mult (e, x) = x) (apply_fun mult (x, e) = x) (Hid x HxG)). }
         claim HinvcE : apply_fun mult (apply_fun inv c, e) = apply_fun inv c.
         { exact (andER
             (apply_fun mult (e, apply_fun inv c) = apply_fun inv c)
             (apply_fun mult (apply_fun inv c, e) = apply_fun inv c)
             (Hid (apply_fun inv c) HinvcG)). }
         claim Hinvc_eq_x : apply_fun inv c = x.
         { claim Hassoc1 : apply_fun mult (apply_fun inv c, apply_fun mult (c, x)) = apply_fun mult (apply_fun mult (apply_fun inv c, c), x).
           { symmetry. exact (Hassoc (apply_fun inv c) c x HinvcG HcG HxG). }
           claim Hinvc_mult : apply_fun mult (apply_fun inv c, apply_fun mult (c, x)) = apply_fun mult (apply_fun inv c, e).
           { rewrite Hcxe. reflexivity. }
           rewrite <- HinvcE. rewrite <- Hinvc_mult. rewrite Hassoc1. rewrite Hinvc_c. exact Hex2. }
         claim HinvcG1 : apply_fun inv c :e G1.
         { rewrite Hinvc_eq_x. exact HxG1. }
         claim HinvcG2 : apply_fun inv c :e G2.
         { rewrite <- Hyeqinvc. exact HyG2. }
         apply Hyne. rewrite Hyeqinvc.
         exact (Hinter_simple (apply_fun inv c) HinvcG1 HinvcG2).
     * assume Hcxne : apply_fun mult (c, x) <> e.
         (** Main hard case: c <> e, x <> e, y <> e, cx <> e **)
         (** Get reduced word for c **)
         apply (Hunique c HcG Hcne).
         let m. assume Hm_ex : exists cs:set,
           reduced_word 2 Gfam efam m cs /\ m <> 0 /\
           word_product mult e cs m = c /\
           (forall n' xs':set,
             reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
             word_product mult e xs' n' = c ->
             m = n' /\ (forall i:set, i :e m -> apply_fun cs i = apply_fun xs' i)).
         apply Hm_ex.
         let cs. assume Hcs_conj :
           reduced_word 2 Gfam efam m cs /\ m <> 0 /\
           word_product mult e cs m = c /\
           (forall n' xs':set,
             reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
             word_product mult e xs' n' = c ->
             m = n' /\ (forall i:set, i :e m -> apply_fun cs i = apply_fun xs' i)).
         apply (and4E
           (reduced_word 2 Gfam efam m cs)
           (m <> 0)
           (word_product mult e cs m = c)
           (forall n' xs':set,
             reduced_word 2 Gfam efam n' xs' -> n' <> 0 ->
             word_product mult e xs' n' = c ->
             m = n' /\ (forall i:set, i :e m -> apply_fun cs i = apply_fun xs' i))
           Hcs_conj).
         assume Hred_c Hmne0 Hprod_c Huniq_c.
         (** Delegate to core helper **)
         exact (ex68_3_core G mult e inv G1 G2 c x m cs
           Hfp HcG HxG1 HyG2 Hyne Hxne Hcxne Hred_c Hmne0 Hprod_c).
Qed.

(** ============================================================ **)
(** S69 Free Groups                                              **)
(** (lines 3033-3182 in algtop.tex)                              **)
(** ============================================================ **)

(** from S69 Definition (line 3036 in algtop.tex): free group **)
(** LATEX VERSION: If each a_alpha generates an infinite cyclic subgroup G_alpha of G, **)
(** and G is the free product of {G_alpha}, then G is a free group and {a_alpha} **)
(** is a system of free generators. **)
Definition free_group_with_generators : set -> set -> set -> set -> set -> set -> prop :=
  fun G mult e inv J gens =>
    group_structure G mult e inv /\
    function_on gens J G /\
    (forall alpha:set, alpha :e J ->
      infinite_cyclic_subgroup G mult e inv (apply_fun gens alpha)) /\
    free_product_of_subgroups G mult e inv J
      (graph J (fun alpha:set =>
        {g :e G | exists n:set, n :e int /\
          ((n :e omega /\ g = group_power_nat mult e (apply_fun gens alpha) n) \/
           (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
            g = group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m)))}))
      (graph J (fun alpha:set => e)).

(** Generic helper: any subgroup inherits the ambient group structure. **)
(** Proven Bob **)
Theorem subgroup_inherits_group_structure :
  forall G mult e inv H:set,
  group_structure G mult e inv ->
  subgroup_of H G mult e inv ->
  group_structure H mult e inv.
let G mult e inv H.
assume Hgrp : group_structure G mult e inv.
assume Hsub : subgroup_of H G mult e inv.
apply (and4E
  (H c= G)
  (e :e H)
  (forall x y:set, x :e H -> y :e H -> apply_fun mult (x, y) :e H)
  (forall x:set, x :e H -> apply_fun inv x :e H)
  Hsub).
assume HsubG HeH HmulH HinvH.
apply (and6E
  (function_on mult (setprod G G) G)
  (function_on inv G G)
  (e :e G)
  (forall x y z:set, x :e G -> y :e G -> z :e G ->
    apply_fun mult (apply_fun mult (x, y), z) = apply_fun mult (x, apply_fun mult (y, z)))
  (forall x:set, x :e G -> apply_fun mult (e, x) = x /\ apply_fun mult (x, e) = x)
  (forall x:set, x :e G ->
    apply_fun mult (x, apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x, x) = e)
  Hgrp).
assume HmultG HinvG HeG HassocG HidG HinvG_law.
claim HmultH_fn : function_on mult (setprod H H) H.
{
  let p.
  assume Hp : p :e setprod H H.
  claim Hp0 : p 0 :e H.
  {
    exact (ap0_Sigma H (fun _ : set => H) p Hp).
  }
  claim Hp1 : p 1 :e H.
  {
    exact (ap1_Sigma H (fun _ : set => H) p Hp).
  }
  rewrite (setprod_eta H H p Hp).
  exact (HmulH (p 0) (p 1) Hp0 Hp1).
}
claim HinvH_fn : function_on inv H H.
{
  let x.
  assume Hx : x :e H.
  exact (HinvH x Hx).
}
claim HassocH :
  forall x y z:set, x :e H -> y :e H -> z :e H ->
    apply_fun mult (apply_fun mult (x, y), z) =
    apply_fun mult (x, apply_fun mult (y, z)).
{
  let x y z.
  assume Hx : x :e H.
  assume Hy : y :e H.
  assume Hz : z :e H.
  exact (HassocG
    x
    y
    z
    (HsubG x Hx)
    (HsubG y Hy)
    (HsubG z Hz)).
}
claim HidH :
  forall x:set, x :e H ->
    apply_fun mult (e, x) = x /\ apply_fun mult (x, e) = x.
{
  let x.
  assume Hx : x :e H.
  exact (HidG x (HsubG x Hx)).
}
claim HinvH_law :
  forall x:set, x :e H ->
    apply_fun mult (x, apply_fun inv x) = e /\
    apply_fun mult (apply_fun inv x, x) = e.
{
  let x.
  assume Hx : x :e H.
  exact (HinvG_law x (HsubG x Hx)).
}
exact (and6I
  (function_on mult (setprod H H) H)
  (function_on inv H H)
  (e :e H)
  (forall x y z:set, x :e H -> y :e H -> z :e H ->
    apply_fun mult (apply_fun mult (x, y), z) = apply_fun mult (x, apply_fun mult (y, z)))
  (forall x:set, x :e H -> apply_fun mult (e, x) = x /\ apply_fun mult (x, e) = x)
  (forall x:set, x :e H ->
    apply_fun mult (x, apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x, x) = e)
  HmultH_fn
  HinvH_fn
  HeH
  HassocH
  HidH
  HinvH_law).
Qed.

(** Generic helper: group structure plus a chosen generator yields cyclic_group. **)
(** Proven Bob **)
Theorem group_structure_and_generator_of_implies_cyclic_group :
  forall G mult e inv x:set,
  group_structure G mult e inv ->
  generator_of G mult e inv x ->
  cyclic_group G mult e inv.
let G mult e inv x.
assume Hgrp : group_structure G mult e inv.
assume Hgen : generator_of G mult e inv x.
apply (andI
  (group_structure G mult e inv)
  (exists x0:set, x0 :e G /\
    forall g:set, g :e G ->
      exists n:set, n :e int /\
        ((n :e omega /\ g = group_power_nat mult e x0 n) \/
         (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
         g = group_power_nat mult e (apply_fun inv x0) (ordsucc m))))
  Hgrp).
claim HxG : x :e G.
{
  exact (andEL
    (x :e G)
    (forall g:set, g :e G ->
      exists n:set, n :e int /\
        ((n :e omega /\ g = group_power_nat mult e x n) \/
         (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
          g = group_power_nat mult e (apply_fun inv x) (ordsucc m))))
    Hgen).
}
claim HgenAll :
  forall g:set, g :e G ->
    exists n:set, n :e int /\
      ((n :e omega /\ g = group_power_nat mult e x n) \/
       (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
        g = group_power_nat mult e (apply_fun inv x) (ordsucc m))).
{
  exact (andER
    (x :e G)
    (forall g:set, g :e G ->
      exists n:set, n :e int /\
        ((n :e omega /\ g = group_power_nat mult e x n) \/
         (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
          g = group_power_nat mult e (apply_fun inv x) (ordsucc m))))
    Hgen).
}
witness x.
apply andI.
- exact HxG.
- exact HgenAll.
Qed.

(** Infrastructure helper for S69: an infinite cyclic subgroup cannot be finite. **)
(** Proven Bob **)
Theorem infinite_cyclic_subgroup_nonfinite :
  forall G mult e inv a:set,
  group_structure G mult e inv ->
  infinite_cyclic_subgroup G mult e inv a ->
  ~ finite G.
let G mult e inv a.
assume Hgrp : group_structure G mult e inv.
assume Hinf : infinite_cyclic_subgroup G mult e inv a.
apply (and6E
  (function_on mult (setprod G G) G)
  (function_on inv G G)
  (e :e G)
  (forall x y z:set, x :e G -> y :e G -> z :e G ->
    apply_fun mult (apply_fun mult (x, y), z) = apply_fun mult (x, apply_fun mult (y, z)))
  (forall x:set, x :e G -> apply_fun mult (e, x) = x /\ apply_fun mult (x, e) = x)
  (forall x:set, x :e G ->
    apply_fun mult (x, apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x, x) = e)
  Hgrp).
assume HmultFn HinvFn HeG HassocG HidG HinvG.
apply (and4E
  (a :e G)
  (forall n:set, n :e omega -> group_power_nat mult e a n :e G)
  (forall m:set, m :e omega -> group_power_nat mult e (apply_fun inv a) (ordsucc m) :e G)
  (~(exists n:set, n :e omega /\ n <> 0 /\ group_power_nat mult e a n = e))
  Hinf).
assume HaG HpowInG HpowInvInG Hnontriv.
assume HfinG : finite G.
claim Hleft_cancel :
  forall u v:set, u :e G -> v :e G ->
    apply_fun mult (a, u) = apply_fun mult (a, v) ->
    u = v.
{
  let u v.
  assume HuG : u :e G.
  assume HvG : v :e G.
  assume Haeq : apply_fun mult (a, u) = apply_fun mult (a, v).
  claim HaInvG : apply_fun inv a :e G.
  {
    exact (HinvFn a HaG).
  }
  claim HauG : apply_fun mult (a, u) :e G.
  {
    exact (HmultFn
      (a, u)
      (tuple_2_setprod_by_pair_Sigma G G a u HaG HuG)).
  }
  claim HavG : apply_fun mult (a, v) :e G.
  {
    exact (HmultFn
      (a, v)
      (tuple_2_setprod_by_pair_Sigma G G a v HaG HvG)).
  }
  claim HinvauG : apply_fun mult (apply_fun inv a, apply_fun mult (a, u)) :e G.
  {
    exact (HmultFn
      (apply_fun inv a, apply_fun mult (a, u))
      (tuple_2_setprod_by_pair_Sigma
        G
        G
        (apply_fun inv a)
        (apply_fun mult (a, u))
        HaInvG
        HauG)).
  }
  claim HinvavG : apply_fun mult (apply_fun inv a, apply_fun mult (a, v)) :e G.
  {
    exact (HmultFn
      (apply_fun inv a, apply_fun mult (a, v))
      (tuple_2_setprod_by_pair_Sigma
        G
        G
        (apply_fun inv a)
        (apply_fun mult (a, v))
        HaInvG
        HavG)).
  }
  claim Hlhs_u :
    apply_fun mult (apply_fun inv a, apply_fun mult (a, u)) =
    apply_fun mult (apply_fun mult (apply_fun inv a, a), u).
  {
    symmetry.
    exact (HassocG
      (apply_fun inv a)
      a
      u
      HaInvG
      HaG
      HuG).
  }
  claim Hlhs_v :
    apply_fun mult (apply_fun inv a, apply_fun mult (a, v)) =
    apply_fun mult (apply_fun mult (apply_fun inv a, a), v).
  {
    symmetry.
    exact (HassocG
      (apply_fun inv a)
      a
      v
      HaInvG
      HaG
      HvG).
  }
  claim HinvLeftA : apply_fun mult (apply_fun inv a, a) = e.
  {
    exact (andER
      (apply_fun mult (a, apply_fun inv a) = e)
      (apply_fun mult (apply_fun inv a, a) = e)
      (HinvG a HaG)).
  }
  claim Heu : apply_fun mult (e, u) = u.
  {
    exact (andEL
      (apply_fun mult (e, u) = u)
      (apply_fun mult (u, e) = u)
      (HidG u HuG)).
  }
  claim Hev : apply_fun mult (e, v) = v.
  {
    exact (andEL
      (apply_fun mult (e, v) = v)
      (apply_fun mult (v, e) = v)
      (HidG v HvG)).
  }
  claim HleftU : apply_fun mult (apply_fun inv a, apply_fun mult (a, u)) = u.
  {
    rewrite Hlhs_u.
    rewrite HinvLeftA.
    exact Heu.
  }
  claim HleftV : apply_fun mult (apply_fun inv a, apply_fun mult (a, v)) = v.
  {
    rewrite Hlhs_v.
    rewrite HinvLeftA.
    exact Hev.
  }
  claim HmulInvEq :
    apply_fun mult (apply_fun inv a, apply_fun mult (a, u)) =
    apply_fun mult (apply_fun inv a, apply_fun mult (a, v)).
  {
    rewrite Haeq.
    reflexivity.
  }
  rewrite <- HleftU.
  rewrite <- HleftV.
  exact HmulInvEq.
}
claim Hpow_ne_e :
  forall k:set, k :e omega -> k <> 0 -> group_power_nat mult e a k = e -> False.
{
  let k. assume Hk Hkne Hake.
  apply Hnontriv.
  witness k.
  exact (and3I (k :e omega) (k <> 0) (group_power_nat mult e a k = e) Hk Hkne Hake).
}
claim HpowS :
  forall k:set, nat_p k ->
    group_power_nat mult e a (ordsucc k) = apply_fun mult (a, group_power_nat mult e a k).
{
  let k. assume Hk.
  exact (nat_primrec_S e (fun _ r:set => apply_fun mult (a, r)) k Hk).
}
claim Hpow0 : group_power_nat mult e a 0 = e.
{
  exact (nat_primrec_0 e (fun _ r:set => apply_fun mult (a, r))).
}
claim Hpow_repeat_lt_false :
  forall m:set, nat_p m ->
    forall n:set, n :e omega ->
      ordsucc m :e n ->
      group_power_nat mult e a (ordsucc m) = group_power_nat mult e a n ->
      False.
{
  apply nat_ind.
  - let n.
    assume Hn : n :e omega.
    assume Hlt : ordsucc 0 :e n.
    assume Heq : group_power_nat mult e a (ordsucc 0) = group_power_nat mult e a n.
    apply (nat_inv n (omega_nat_p n Hn)).
    + assume Hn0 : n = 0.
      exact (EmptyE (ordsucc 0) (mem_eqR (ordsucc 0) n 0 Hn0 Hlt)).
    + assume HnS : exists n':set, nat_p n' /\ n = ordsucc n'.
      apply HnS.
      let n'.
      assume Hn'pack : nat_p n' /\ n = ordsucc n'.
      claim Hn'nat : nat_p n'.
      { exact (andEL (nat_p n') (n = ordsucc n') Hn'pack). }
      claim Hneq : n = ordsucc n'.
      { exact (andER (nat_p n') (n = ordsucc n') Hn'pack). }
      claim Heq2 : apply_fun mult (a, group_power_nat mult e a 0) =
                    apply_fun mult (a, group_power_nat mult e a n').
      {
        rewrite <- (HpowS 0 nat_0).
        rewrite <- (HpowS n' Hn'nat).
        rewrite <- Hneq.
        exact Heq.
      }
      claim Hen' : group_power_nat mult e a 0 = group_power_nat mult e a n'.
      {
        exact (Hleft_cancel
          (group_power_nat mult e a 0)
          (group_power_nat mult e a n')
          (HpowInG 0 (nat_p_omega 0 nat_0))
          (HpowInG n' (nat_p_omega n' Hn'nat))
          Heq2).
      }
      apply (ordsuccE n' (ordsucc 0) (mem_eqR (ordsucc 0) n (ordsucc n') Hneq Hlt)).
      * assume Hs0n' : ordsucc 0 :e n'.
        claim Hn'ne0 : n' <> 0.
        {
          assume Hn'0 : n' = 0.
          exact (EmptyE (ordsucc 0) (mem_eqR (ordsucc 0) n' 0 Hn'0 Hs0n')).
        }
        claim Han'e : group_power_nat mult e a n' = e.
        {
          rewrite <- Hen'.
          exact Hpow0.
        }
        exact (Hpow_ne_e n' (nat_p_omega n' Hn'nat) Hn'ne0 Han'e).
      * assume Hs0eqn' : ordsucc 0 = n'.
        claim Han'e : group_power_nat mult e a n' = e.
        {
          rewrite <- Hen'.
          exact Hpow0.
        }
        claim Hn'ne0 : n' <> 0.
        {
          rewrite <- Hs0eqn'. exact (neq_ordsucc_0 0).
        }
        exact (Hpow_ne_e n' (nat_p_omega n' Hn'nat) Hn'ne0 Han'e).
  - let m'.
    assume Hm'nat : nat_p m'.
    assume IH : forall n:set, n :e omega ->
      ordsucc m' :e n ->
      group_power_nat mult e a (ordsucc m') = group_power_nat mult e a n ->
      False.
    let n.
    assume Hn : n :e omega.
    assume Hlt : ordsucc (ordsucc m') :e n.
    assume Heq : group_power_nat mult e a (ordsucc (ordsucc m')) = group_power_nat mult e a n.
    apply (nat_inv n (omega_nat_p n Hn)).
    + assume Hn0 : n = 0.
      exact (EmptyE (ordsucc (ordsucc m')) (mem_eqR (ordsucc (ordsucc m')) n 0 Hn0 Hlt)).
    + assume HnS : exists n':set, nat_p n' /\ n = ordsucc n'.
      apply HnS.
      let n'.
      assume Hn'pack : nat_p n' /\ n = ordsucc n'.
      claim Hn'nat : nat_p n'.
      { exact (andEL (nat_p n') (n = ordsucc n') Hn'pack). }
      claim Hneq : n = ordsucc n'.
      { exact (andER (nat_p n') (n = ordsucc n') Hn'pack). }
      claim Hsm'nat : nat_p (ordsucc m').
      { exact (nat_ordsucc m' Hm'nat). }
      claim Heq2 : apply_fun mult (a, group_power_nat mult e a (ordsucc m')) =
                    apply_fun mult (a, group_power_nat mult e a n').
      {
        rewrite <- (HpowS (ordsucc m') Hsm'nat).
        rewrite <- (HpowS n' Hn'nat).
        rewrite <- Hneq.
        exact Heq.
      }
      claim Hcancel : group_power_nat mult e a (ordsucc m') = group_power_nat mult e a n'.
      {
        exact (Hleft_cancel
          (group_power_nat mult e a (ordsucc m'))
          (group_power_nat mult e a n')
          (HpowInG (ordsucc m') (nat_p_omega (ordsucc m') Hsm'nat))
          (HpowInG n' (nat_p_omega n' Hn'nat))
          Heq2).
      }
      apply (ordsuccE n' (ordsucc (ordsucc m'))
        (mem_eqR (ordsucc (ordsucc m')) n (ordsucc n') Hneq Hlt)).
      * assume Hssm'n' : ordsucc (ordsucc m') :e n'.
        claim Hsm'n' : ordsucc m' :e n'.
        {
          exact (ordinal_TransSet n' (nat_p_ordinal n' Hn'nat)
            (ordsucc (ordsucc m')) Hssm'n' (ordsucc m') (ordsuccI2 (ordsucc m'))).
        }
        exact (IH n' (nat_p_omega n' Hn'nat) Hsm'n' Hcancel).
      * assume Hssm'eqn' : ordsucc (ordsucc m') = n'.
        claim Hsm'n' : ordsucc m' :e n'.
        {
          rewrite <- Hssm'eqn'.
          exact (ordsuccI2 (ordsucc m')).
        }
        exact (IH n' (nat_p_omega n' Hn'nat) Hsm'n' Hcancel).
}
claim Hpow_inj :
  forall m n:set, m :e omega -> n :e omega ->
    group_power_nat mult e a m = group_power_nat mult e a n ->
    m = n.
{
  let m n.
  assume Hm : m :e omega.
  assume Hn : n :e omega.
  assume Heq : group_power_nat mult e a m = group_power_nat mult e a n.
  apply (ordinal_trichotomy_or_impred m n
    (nat_p_ordinal m (omega_nat_p m Hm))
    (nat_p_ordinal n (omega_nat_p n Hn))).
  - assume Hmn : m :e n.
    apply (nat_inv m (omega_nat_p m Hm)).
    + assume Hm0 : m = 0.
      claim Han0 : group_power_nat mult e a n = e.
      {
        rewrite <- Heq. rewrite Hm0. exact Hpow0.
      }
      apply (nat_inv n (omega_nat_p n Hn)).
      * assume Hn0 : n = 0.
        rewrite Hn0. exact Hm0.
      * assume HnS : exists n':set, nat_p n' /\ n = ordsucc n'.
        apply HnS. let n'. assume Hn'pack.
        claim Hneq : n = ordsucc n'.
        { exact (andER (nat_p n') (n = ordsucc n') Hn'pack). }
        claim Hn'nat : nat_p n'.
        { exact (andEL (nat_p n') (n = ordsucc n') Hn'pack). }
        claim Hnne0 : n <> 0.
        { rewrite Hneq. exact (neq_ordsucc_0 n'). }
        exact (FalseE (Hpow_ne_e n Hn Hnne0 Han0) (m = n)).
    + assume HmS : exists m':set, nat_p m' /\ m = ordsucc m'.
      apply HmS. let m'. assume Hm'pack.
      claim Hmeq : m = ordsucc m'.
      { exact (andER (nat_p m') (m = ordsucc m') Hm'pack). }
      claim Hm'nat : nat_p m'.
      { exact (andEL (nat_p m') (m = ordsucc m') Hm'pack). }
      claim Hlt : ordsucc m' :e n.
      { rewrite <- Hmeq. exact Hmn. }
      claim Heq2 : group_power_nat mult e a (ordsucc m') = group_power_nat mult e a n.
      { rewrite <- Hmeq. exact Heq. }
      exact (FalseE (Hpow_repeat_lt_false m' Hm'nat n Hn Hlt Heq2) (m = n)).
  - assume Hmeqn : m = n.
    exact Hmeqn.
  - assume Hnm : n :e m.
    apply (nat_inv n (omega_nat_p n Hn)).
    + assume Hn0 : n = 0.
      claim Ham0 : group_power_nat mult e a m = e.
      {
        rewrite Heq. rewrite Hn0. exact Hpow0.
      }
      apply (nat_inv m (omega_nat_p m Hm)).
      * assume Hm0 : m = 0.
        rewrite Hm0. symmetry. exact Hn0.
      * assume HmS : exists m':set, nat_p m' /\ m = ordsucc m'.
        apply HmS. let m'. assume Hm'pack.
        claim Hmeq : m = ordsucc m'.
        { exact (andER (nat_p m') (m = ordsucc m') Hm'pack). }
        claim Hmne0 : m <> 0.
        { rewrite Hmeq. exact (neq_ordsucc_0 m'). }
        exact (FalseE (Hpow_ne_e m Hm Hmne0 Ham0) (m = n)).
    + assume HnS : exists n':set, nat_p n' /\ n = ordsucc n'.
      apply HnS. let n'. assume Hn'pack.
      claim Hneq : n = ordsucc n'.
      { exact (andER (nat_p n') (n = ordsucc n') Hn'pack). }
      claim Hn'nat : nat_p n'.
      { exact (andEL (nat_p n') (n = ordsucc n') Hn'pack). }
      claim Hlt : ordsucc n' :e m.
      { rewrite <- Hneq. exact Hnm. }
      claim Heq2 : group_power_nat mult e a (ordsucc n') = group_power_nat mult e a m.
      { rewrite <- Hneq. symmetry. exact Heq. }
      exact (FalseE (Hpow_repeat_lt_false n' Hn'nat m Hm Hlt Heq2) (m = n)).
}
claim HinjPow : inj omega G (fun n:set => group_power_nat mult e a n).
{
  exact (andI
    (forall u :e omega, group_power_nat mult e a u :e G)
    (forall u v :e omega, group_power_nat mult e a u = group_power_nat mult e a v -> u = v)
    HpowInG
    (fun u:set => fun Hu:u :e omega => fun v:set => fun Hv:v :e omega =>
     fun Heq:group_power_nat mult e a u = group_power_nat mult e a v =>
     Hpow_inj u v Hu Hv Heq)).
}
claim Hatleast : exists f : set -> set, inj omega G f.
{
  witness (fun n:set => group_power_nat mult e a n).
  exact HinjPow.
}
claim HinfG : infinite G.
{
  exact (atleastp_omega_infinite
    G
    Hatleast).
}
exact (HinfG HfinG).
Qed.

(** Helper 2: inv(a^n) = (inv a)^n for group_power_nat **)
(** Proven Alice **)
Theorem inv_of_power_nat_eq_power_inv :
  forall G mult e inv a n:set,
  group_structure G mult e inv ->
  a :e G ->
  n :e omega ->
  apply_fun inv (group_power_nat mult e a n) =
  group_power_nat mult e (apply_fun inv a) n.
let G mult e inv a n.
assume Hgrp : group_structure G mult e inv.
assume HaG : a :e G.
assume HnO : n :e omega.
apply (and6E
  (function_on mult (setprod G G) G)
  (function_on inv G G)
  (e :e G)
  (forall x y z:set, x :e G -> y :e G -> z :e G ->
    apply_fun mult (apply_fun mult (x, y), z) = apply_fun mult (x, apply_fun mult (y, z)))
  (forall x:set, x :e G -> apply_fun mult (e, x) = x /\ apply_fun mult (x, e) = x)
  (forall x:set, x :e G ->
    apply_fun mult (x, apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x, x) = e)
  Hgrp).
assume HmultFn HinvFn HeG Hassoc Hid HinvLaw.
claim HinvaG : apply_fun inv a :e G.
{ exact (HinvFn a HaG). }
claim HpowClosed : forall k:set, nat_p k -> group_power_nat mult e a k :e G.
{
  apply nat_ind.
  - claim Hpow0 : group_power_nat mult e a 0 = e.
    { exact (nat_primrec_0 e (fun _ r => apply_fun mult (a, r))). }
    rewrite Hpow0. exact HeG.
  - let k. assume HkNat. assume IH : group_power_nat mult e a k :e G.
    claim HpowS : group_power_nat mult e a (ordsucc k) = apply_fun mult (a, group_power_nat mult e a k).
    { exact (nat_primrec_S e (fun _ r => apply_fun mult (a, r)) k HkNat). }
    rewrite HpowS.
    exact (HmultFn (a, group_power_nat mult e a k)
      (tuple_2_setprod_by_pair_Sigma G G a (group_power_nat mult e a k) HaG IH)).
}
claim HpowInvClosed : forall k:set, nat_p k -> group_power_nat mult e (apply_fun inv a) k :e G.
{
  apply nat_ind.
  - claim Hpow0 : group_power_nat mult e (apply_fun inv a) 0 = e.
    { exact (nat_primrec_0 e (fun _ r => apply_fun mult (apply_fun inv a, r))). }
    rewrite Hpow0. exact HeG.
  - let k. assume HkNat. assume IH : group_power_nat mult e (apply_fun inv a) k :e G.
    claim HpowS : group_power_nat mult e (apply_fun inv a) (ordsucc k) = apply_fun mult (apply_fun inv a, group_power_nat mult e (apply_fun inv a) k).
    { exact (nat_primrec_S e (fun _ r => apply_fun mult (apply_fun inv a, r)) k HkNat). }
    rewrite HpowS.
    exact (HmultFn (apply_fun inv a, group_power_nat mult e (apply_fun inv a) k)
      (tuple_2_setprod_by_pair_Sigma G G (apply_fun inv a) (group_power_nat mult e (apply_fun inv a) k) HinvaG IH)).
}
claim HnNat : nat_p n. { exact (omega_nat_p n HnO). }
claim HInd : forall k:set, nat_p k ->
  apply_fun inv (group_power_nat mult e a k) =
  group_power_nat mult e (apply_fun inv a) k.
{
apply nat_ind.
- (** Base case: inv(pow(0)) = inv(e) = e = invpow(0) **)
  claim Hpow0a : group_power_nat mult e a 0 = e.
  { exact (nat_primrec_0 e (fun _ r => apply_fun mult (a, r))). }
  claim Hpow0inv : group_power_nat mult e (apply_fun inv a) 0 = e.
  { exact (nat_primrec_0 e (fun _ r => apply_fun mult (apply_fun inv a, r))). }
  rewrite Hpow0a.
  claim HinveE : apply_fun inv e = e.
  {
    claim HinveG : apply_fun inv e :e G. { exact (HinvFn e HeG). }
    claim HeIe : apply_fun mult (e, apply_fun inv e) = e.
    { exact (andEL (apply_fun mult (e, apply_fun inv e) = e) (apply_fun mult (apply_fun inv e, e) = e) (HinvLaw e HeG)). }
    claim HleIe : apply_fun mult (e, apply_fun inv e) = apply_fun inv e.
    { exact (andEL (apply_fun mult (e, apply_fun inv e) = apply_fun inv e) (apply_fun mult (apply_fun inv e, e) = apply_fun inv e) (Hid (apply_fun inv e) HinveG)). }
    claim Hstep : apply_fun inv e = apply_fun mult (e, apply_fun inv e).
    { symmetry. exact HleIe. }
    rewrite Hstep. exact HeIe.
  }
  rewrite HinveE.
  symmetry. exact Hpow0inv.
- (** Inductive step: inv(pow(k+1)) = invpow(k+1) **)
  let k.
  assume HkNat : nat_p k.
  assume IH : apply_fun inv (group_power_nat mult e a k) = group_power_nat mult e (apply_fun inv a) k.
  claim HkO : k :e omega. { exact (nat_p_omega k HkNat). }
  claim HpowkG : group_power_nat mult e a k :e G.
  { exact (HpowClosed k HkNat). }
  claim HpowInvkG : group_power_nat mult e (apply_fun inv a) k :e G.
  { exact (HpowInvClosed k HkNat). }
  claim HinvpowkG : apply_fun inv (group_power_nat mult e a k) :e G.
  { exact (HinvFn (group_power_nat mult e a k) HpowkG). }
  claim HakG : apply_fun mult (a, group_power_nat mult e a k) :e G.
  {
    exact (HmultFn (a, group_power_nat mult e a k)
      (tuple_2_setprod_by_pair_Sigma G G a (group_power_nat mult e a k) HaG HpowkG)).
  }
  claim HinvakG : apply_fun inv (apply_fun mult (a, group_power_nat mult e a k)) :e G.
  { exact (HinvFn (apply_fun mult (a, group_power_nat mult e a k)) HakG). }
  claim Hinvpow_inva_G : apply_fun mult (apply_fun inv (group_power_nat mult e a k), apply_fun inv a) :e G.
  {
    exact (HmultFn (apply_fun inv (group_power_nat mult e a k), apply_fun inv a)
      (tuple_2_setprod_by_pair_Sigma G G (apply_fun inv (group_power_nat mult e a k)) (apply_fun inv a) HinvpowkG HinvaG)).
  }
  (** Step 1: Show mult(mult(a, pow(k)), mult(inv(pow(k)), inv(a))) = e **)
  claim Hprod_inv : apply_fun mult (apply_fun mult (a, group_power_nat mult e a k),
    apply_fun mult (apply_fun inv (group_power_nat mult e a k), apply_fun inv a)) = e.
  {
    rewrite (Hassoc a (group_power_nat mult e a k)
      (apply_fun mult (apply_fun inv (group_power_nat mult e a k), apply_fun inv a))
      HaG HpowkG Hinvpow_inva_G).
    rewrite <- (Hassoc (group_power_nat mult e a k) (apply_fun inv (group_power_nat mult e a k)) (apply_fun inv a)
      HpowkG HinvpowkG HinvaG).
    claim Hcanc : apply_fun mult (group_power_nat mult e a k, apply_fun inv (group_power_nat mult e a k)) = e.
    {
      exact (andEL
        (apply_fun mult (group_power_nat mult e a k, apply_fun inv (group_power_nat mult e a k)) = e)
        (apply_fun mult (apply_fun inv (group_power_nat mult e a k), group_power_nat mult e a k) = e)
        (HinvLaw (group_power_nat mult e a k) HpowkG)).
    }
    rewrite Hcanc.
    claim Hle : apply_fun mult (e, apply_fun inv a) = apply_fun inv a.
    {
      exact (andEL
        (apply_fun mult (e, apply_fun inv a) = apply_fun inv a)
        (apply_fun mult (apply_fun inv a, e) = apply_fun inv a)
        (Hid (apply_fun inv a) HinvaG)).
    }
    rewrite Hle.
    exact (andEL
      (apply_fun mult (a, apply_fun inv a) = e)
      (apply_fun mult (apply_fun inv a, a) = e)
      (HinvLaw a HaG)).
  }
  (** Step 2: inv(mult(a, pow(k))) = mult(inv(pow(k)), inv(a)) via left_cancel **)
  claim Hstd_inv : apply_fun mult (apply_fun mult (a, group_power_nat mult e a k),
    apply_fun inv (apply_fun mult (a, group_power_nat mult e a k))) = e.
  {
    exact (andEL
      (apply_fun mult (apply_fun mult (a, group_power_nat mult e a k),
        apply_fun inv (apply_fun mult (a, group_power_nat mult e a k))) = e)
      (apply_fun mult (apply_fun inv (apply_fun mult (a, group_power_nat mult e a k)),
        apply_fun mult (a, group_power_nat mult e a k)) = e)
      (HinvLaw (apply_fun mult (a, group_power_nat mult e a k)) HakG)).
  }
  claim Hcombo : apply_fun mult (apply_fun mult (a, group_power_nat mult e a k),
    apply_fun inv (apply_fun mult (a, group_power_nat mult e a k))) =
    apply_fun mult (apply_fun mult (a, group_power_nat mult e a k),
    apply_fun mult (apply_fun inv (group_power_nat mult e a k), apply_fun inv a)).
  {
    rewrite Hstd_inv. symmetry. exact Hprod_inv.
  }
  claim Heq_inv_prod : apply_fun inv (apply_fun mult (a, group_power_nat mult e a k)) =
    apply_fun mult (apply_fun inv (group_power_nat mult e a k), apply_fun inv a).
  {
    exact (group_left_cancel
      G mult e inv
      (apply_fun mult (a, group_power_nat mult e a k))
      (apply_fun inv (apply_fun mult (a, group_power_nat mult e a k)))
      (apply_fun mult (apply_fun inv (group_power_nat mult e a k), apply_fun inv a))
      Hgrp HakG HinvakG Hinvpow_inva_G Hcombo).
  }
  (** Step 3: nat_primrec expansion and use commutativity **)
  claim HpowSa : group_power_nat mult e a (ordsucc k) = apply_fun mult (a, group_power_nat mult e a k).
  { exact (nat_primrec_S e (fun _ r => apply_fun mult (a, r)) k HkNat). }
  claim HpowSinv : group_power_nat mult e (apply_fun inv a) (ordsucc k) = apply_fun mult (apply_fun inv a, group_power_nat mult e (apply_fun inv a) k).
  { exact (nat_primrec_S e (fun _ r => apply_fun mult (apply_fun inv a, r)) k HkNat). }
  (** chain: inv(pow(k+1)) = inv(mult(a,pow(k))) by HpowSa **)
  (** = mult(inv(pow(k)), inv(a)) by Heq_inv_prod **)
  (** = mult(invpow(k), inv(a)) by IH **)
  (** = mult(inv(a), invpow(k)) by commutativity **)
  (** = invpow(k+1) by HpowSinv **)
  rewrite HpowSa.
  rewrite Heq_inv_prod.
  rewrite IH.
  rewrite (group_power_nat_commutes_with_base G mult e inv (apply_fun inv a) k Hgrp HinvaG HkO).
  rewrite <- HpowSinv.
  reflexivity.
}
exact (HInd n HnNat).
Qed.


(** Helper for S69 Lem 69.1: each generator lies in its cyclic factor family. **)
(** Proven Bob **)
Theorem lemma69_1_generator_in_factor_family :
  forall G mult e inv J gens alpha:set,
  group_structure G mult e inv ->
  function_on gens J G ->
  alpha :e J ->
  apply_fun gens alpha :e
    apply_fun
      (graph J (fun beta:set =>
        {g :e G | exists n:set, n :e int /\
          ((n :e omega /\ g = group_power_nat mult e (apply_fun gens beta) n) \/
           (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
            g = group_power_nat mult e (apply_fun inv (apply_fun gens beta)) (ordsucc m)))}))
      alpha.
let G mult e inv J gens alpha.
assume Hgrp : group_structure G mult e inv.
assume Hgens : function_on gens J G.
assume Halpha : alpha :e J.
rewrite (apply_fun_graph
  J
  (fun beta:set =>
    {g :e G | exists n:set, n :e int /\
      ((n :e omega /\ g = group_power_nat mult e (apply_fun gens beta) n) \/
       (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
        g = group_power_nat mult e (apply_fun inv (apply_fun gens beta)) (ordsucc m)))})
  alpha
  Halpha).
apply (SepI
  G
  (fun g:set => exists n:set, n :e int /\
    ((n :e omega /\ g = group_power_nat mult e (apply_fun gens alpha) n) \/
     (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
      g = group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m))))
  (apply_fun gens alpha)
  (Hgens alpha Halpha)).
witness (ordsucc 0).
apply andI.
- exact (Subq_omega_int
    (ordsucc 0)
    (nat_p_omega (ordsucc 0) (nat_ordsucc 0 nat_0))).
- apply orIL.
  apply andI.
  + exact (nat_p_omega
      (ordsucc 0)
      (nat_ordsucc 0 nat_0)).
  + claim HS : group_power_nat mult e (apply_fun gens alpha) (ordsucc 0) =
      apply_fun mult (apply_fun gens alpha, group_power_nat mult e (apply_fun gens alpha) 0).
    {
      exact (nat_primrec_S
        e
        (fun _ r => apply_fun mult (apply_fun gens alpha, r))
        0
        nat_0).
    }
    claim H0 : group_power_nat mult e (apply_fun gens alpha) 0 = e.
    {
      exact (nat_primrec_0
        e
        (fun _ r => apply_fun mult (apply_fun gens alpha, r))).
    }
    apply (and6E
      (function_on mult (setprod G G) G)
      (function_on inv G G)
      (e :e G)
      (forall x y z:set, x :e G -> y :e G -> z :e G ->
        apply_fun mult (apply_fun mult (x, y), z) = apply_fun mult (x, apply_fun mult (y, z)))
      (forall x:set, x :e G -> apply_fun mult (e, x) = x /\ apply_fun mult (x, e) = x)
      (forall x:set, x :e G ->
        apply_fun mult (x, apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x, x) = e)
      Hgrp).
    assume HmultF HinvF HeG HassocG HidG HinvG.
    rewrite HS.
    rewrite H0.
    symmetry.
    exact (andER
      (apply_fun mult (e, apply_fun gens alpha) = apply_fun gens alpha)
      (apply_fun mult (apply_fun gens alpha, e) = apply_fun gens alpha)
      (HidG (apply_fun gens alpha) (Hgens alpha Halpha))).
Qed.

(** Helper for S69 Lem 69.1: each cyclic factor is a subset of the ambient group. **)
(** Proven Bob **)
Theorem lemma69_1_factor_family_subset_ambient :
  forall G mult e inv J gens alpha:set,
  alpha :e J ->
  apply_fun
    (graph J (fun beta:set =>
      {g :e G | exists n:set, n :e int /\
        ((n :e omega /\ g = group_power_nat mult e (apply_fun gens beta) n) \/
         (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
          g = group_power_nat mult e (apply_fun inv (apply_fun gens beta)) (ordsucc m)))}))
    alpha c= G.
let G mult e inv J gens alpha.
assume Halpha : alpha :e J.
rewrite (apply_fun_graph
  J
  (fun beta:set =>
    {g :e G | exists n:set, n :e int /\
      ((n :e omega /\ g = group_power_nat mult e (apply_fun gens beta) n) \/
       (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
        g = group_power_nat mult e (apply_fun inv (apply_fun gens beta)) (ordsucc m)))})
  alpha
  Halpha).
exact (Sep_Subq
  G
  (fun g:set => exists n:set, n :e int /\
    ((n :e omega /\ g = group_power_nat mult e (apply_fun gens alpha) n) \/
     (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
      g = group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m))))).
Qed.

(** Helper for S69 Lem 69.1: explicit evaluation of the cyclic factor family at alpha. **)
(** Proven Bob **)
Theorem lemma69_1_factor_family_eval :
  forall G mult e inv J gens alpha:set,
  alpha :e J ->
  apply_fun
    (graph J (fun beta:set =>
      {g :e G | exists n:set, n :e int /\
        ((n :e omega /\ g = group_power_nat mult e (apply_fun gens beta) n) \/
         (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
          g = group_power_nat mult e (apply_fun inv (apply_fun gens beta)) (ordsucc m)))}))
    alpha
  =
  {g :e G | exists n:set, n :e int /\
    ((n :e omega /\ g = group_power_nat mult e (apply_fun gens alpha) n) \/
     (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
      g = group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m)))}.
let G mult e inv J gens alpha.
assume Halpha : alpha :e J.
exact (apply_fun_graph
  J
  (fun beta:set =>
    {g :e G | exists n:set, n :e int /\
      ((n :e omega /\ g = group_power_nat mult e (apply_fun gens beta) n) \/
       (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
        g = group_power_nat mult e (apply_fun inv (apply_fun gens beta)) (ordsucc m)))})
  alpha
  Halpha).
Qed.

(** Helper for S69 Lem 69.1: each cyclic factor family is generated by the indexed generator. **)
(** Proven Bob **)
Theorem lemma69_1_factor_family_generator_of :
  forall G mult e inv J gens alpha:set,
  group_structure G mult e inv ->
  function_on gens J G ->
  alpha :e J ->
  generator_of
    (apply_fun
      (graph J (fun beta:set =>
        {g :e G | exists n:set, n :e int /\
          ((n :e omega /\ g = group_power_nat mult e (apply_fun gens beta) n) \/
           (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
            g = group_power_nat mult e (apply_fun inv (apply_fun gens beta)) (ordsucc m)))}))
      alpha)
    mult
    e
    inv
    (apply_fun gens alpha).
let G mult e inv J gens alpha.
assume Hgrp : group_structure G mult e inv.
assume Hgens : function_on gens J G.
assume Halpha : alpha :e J.
apply (andI
  (apply_fun gens alpha :e
    apply_fun
      (graph J (fun beta:set =>
        {g :e G | exists n:set, n :e int /\
          ((n :e omega /\ g = group_power_nat mult e (apply_fun gens beta) n) \/
           (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
            g = group_power_nat mult e (apply_fun inv (apply_fun gens beta)) (ordsucc m)))}))
      alpha)
  (forall g:set, g :e
    apply_fun
      (graph J (fun beta:set =>
        {g :e G | exists n:set, n :e int /\
          ((n :e omega /\ g = group_power_nat mult e (apply_fun gens beta) n) \/
           (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
            g = group_power_nat mult e (apply_fun inv (apply_fun gens beta)) (ordsucc m)))}))
      alpha ->
    exists n:set, n :e int /\
      ((n :e omega /\ g = group_power_nat mult e (apply_fun gens alpha) n) \/
       (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
         g = group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m))))).
- exact (lemma69_1_generator_in_factor_family
    G
    mult
    e
    inv
    J
    gens
    alpha
    Hgrp
    Hgens
    Halpha).
- let g.
  assume HgA : g :e
    apply_fun
      (graph J (fun beta:set =>
        {g :e G | exists n:set, n :e int /\
          ((n :e omega /\ g = group_power_nat mult e (apply_fun gens beta) n) \/
           (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
            g = group_power_nat mult e (apply_fun inv (apply_fun gens beta)) (ordsucc m)))}))
      alpha.
  claim HgSep :
    g :e {g :e G | exists n:set, n :e int /\
      ((n :e omega /\ g = group_power_nat mult e (apply_fun gens alpha) n) \/
       (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
         g = group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m)))}.
  {
    rewrite <- (lemma69_1_factor_family_eval
      G
      mult
      e
      inv
      J
      gens
      alpha
      Halpha).
    exact HgA.
  }
  exact (SepE2
    G
    (fun g:set => exists n:set, n :e int /\
      ((n :e omega /\ g = group_power_nat mult e (apply_fun gens alpha) n) \/
       (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
         g = group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m))))
    g
    HgSep).
Qed.

(** Helper for S69 Lem 69.1: each factor family is an infinite cyclic subgroup in its own right. **)
