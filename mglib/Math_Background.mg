exact (s55_S1_antipode_map_moves_basepoint
  HbaseEq).
Qed.

(** S55 helper: antipode map is not constant on S1. **)
(** Proven Bob **)
Theorem s55_S1_antipode_map_not_constant :
  ~(exists c:set, forall x:set, x :e S1 ->
    apply_fun s55_S1_antipode_map x = c).
assume Hconst.
apply s55_S1_antipode_map_two_cycle_witness.
let x.
assume HyExists.
apply HyExists.
let y.
assume Hpack.
apply Hconst.
let c.
assume HcAll.
claim Hleft :
  (((x :e S1 /\ y :e S1) /\ x <> y) /\
    apply_fun s55_S1_antipode_map x = y).
{
  exact (andEL
    (((x :e S1 /\ y :e S1) /\ x <> y) /\
      apply_fun s55_S1_antipode_map x = y)
    (apply_fun s55_S1_antipode_map y = x)
    Hpack).
}
claim HpairNe :
  ((x :e S1 /\ y :e S1) /\ x <> y).
{
  exact (andEL
    ((x :e S1 /\ y :e S1) /\ x <> y)
    (apply_fun s55_S1_antipode_map x = y)
    Hleft).
}
claim HxS1 : x :e S1.
{
  exact (andEL
    (x :e S1)
    (y :e S1)
    (andEL
      (x :e S1 /\ y :e S1)
      (x <> y)
      HpairNe)).
}
claim HyS1 : y :e S1.
{
  exact (andER
    (x :e S1)
    (y :e S1)
    (andEL
      (x :e S1 /\ y :e S1)
      (x <> y)
      HpairNe)).
}
claim HxyNe : x <> y.
{
  exact (andER
    (x :e S1 /\ y :e S1)
    (x <> y)
    HpairNe).
}
claim HfxEqY :
  apply_fun s55_S1_antipode_map x = y.
{
  exact (andER
    ((x :e S1 /\ y :e S1) /\ x <> y)
    (apply_fun s55_S1_antipode_map x = y)
    Hleft).
}
claim HfyEqX :
  apply_fun s55_S1_antipode_map y = x.
{
  exact (andER
    (((x :e S1 /\ y :e S1) /\ x <> y) /\
      apply_fun s55_S1_antipode_map x = y)
    (apply_fun s55_S1_antipode_map y = x)
    Hpack).
}
claim HfxEqC :
  apply_fun s55_S1_antipode_map x = c.
{
  exact (HcAll
    x
    HxS1).
}
claim HfyEqC :
  apply_fun s55_S1_antipode_map y = c.
{
  exact (HcAll
    y
    HyS1).
}
claim HyEqC : y = c.
{
  exact (eq_i_tra
    y
    (apply_fun s55_S1_antipode_map x)
    c
    (eq_symm
      (apply_fun s55_S1_antipode_map x)
      y
      HfxEqY)
    HfxEqC).
}
claim HxEqC : x = c.
{
  exact (eq_i_tra
    x
    (apply_fun s55_S1_antipode_map y)
    c
    (eq_symm
      (apply_fun s55_S1_antipode_map y)
      x
      HfyEqX)
    HfyEqC).
}
claim HxEqY : x = y.
{
  exact (eq_i_tra
    x
    c
    y
    HxEqC
    (eq_symm
      y
      c
      HyEqC)).
}
exact (HxyNe
  HxEqY).
Qed.

(** S55 helper: antipode map has two circle points with distinct images. **)
(** Proven Bob **)
Theorem s55_S1_antipode_map_distinct_image_witness :
  exists x:set, exists y:set,
    x :e S1 /\ y :e S1 /\
    apply_fun s55_S1_antipode_map x <>
    apply_fun s55_S1_antipode_map y.
apply s55_S1_antipode_map_two_cycle_witness.
let x.
assume HyExists.
apply HyExists.
let y.
assume Hpack.
witness x.
witness y.
claim Hleft :
  (((x :e S1 /\ y :e S1) /\ x <> y) /\
    apply_fun s55_S1_antipode_map x = y).
{
  exact (andEL
    (((x :e S1 /\ y :e S1) /\ x <> y) /\
      apply_fun s55_S1_antipode_map x = y)
    (apply_fun s55_S1_antipode_map y = x)
    Hpack).
}
claim HpairNe :
  ((x :e S1 /\ y :e S1) /\ x <> y).
{
  exact (andEL
    ((x :e S1 /\ y :e S1) /\ x <> y)
    (apply_fun s55_S1_antipode_map x = y)
    Hleft).
}
claim HxyNe : x <> y.
{
  exact (andER
    (x :e S1 /\ y :e S1)
    (x <> y)
    HpairNe).
}
claim HfxEqY :
  apply_fun s55_S1_antipode_map x = y.
{
  exact (andER
    ((x :e S1 /\ y :e S1) /\ x <> y)
    (apply_fun s55_S1_antipode_map x = y)
    Hleft).
}
claim HfyEqX :
  apply_fun s55_S1_antipode_map y = x.
{
  exact (andER
    (((x :e S1 /\ y :e S1) /\ x <> y) /\
      apply_fun s55_S1_antipode_map x = y)
    (apply_fun s55_S1_antipode_map y = x)
    Hpack).
}
apply andI.
- exact (andEL
    (x :e S1 /\ y :e S1)
    (x <> y)
    HpairNe).
- assume HimgEq.
  claim HyEqX : y = x.
  {
    exact (eq_i_tra
      y
      (apply_fun s55_S1_antipode_map x)
      x
      (eq_symm
        (apply_fun s55_S1_antipode_map x)
        y
        HfxEqY)
      (eq_i_tra
        (apply_fun s55_S1_antipode_map x)
        (apply_fun s55_S1_antipode_map y)
        x
        HimgEq
        HfyEqX)).
  }
  exact (HxyNe
    (eq_symm
      y
      x
      HyEqX)).
Qed.

(** S55 helper: inverse-graph evaluation of the antipode map equals the map itself on S1. **)
(** Proven Bob **)
Theorem s55_S1_antipode_map_inv_fun_graph_apply_eq : forall y:set,
  y :e S1 ->
  apply_fun (inv_fun_graph S1 s55_S1_antipode_map S1) y
  =
  apply_fun s55_S1_antipode_map y.
let y.
assume HyS1.
claim Hbij :
  bijection S1 S1 s55_S1_antipode_map.
{
  exact s55_S1_antipode_map_bijection.
}
claim HsurjRaw :
  forall w :e S1, exists u :e S1,
    apply_fun s55_S1_antipode_map u = w.
{
  let w.
  assume HwS1.
  claim HsurjPack :
    exists x:set, x :e S1 /\
      apply_fun s55_S1_antipode_map x = w /\
      (forall x':set, x' :e S1 ->
        apply_fun s55_S1_antipode_map x' = w -> x' = x).
  {
    exact (andER
      (function_on s55_S1_antipode_map S1 S1)
      (forall y:set, y :e S1 ->
        exists x:set, x :e S1 /\
          apply_fun s55_S1_antipode_map x = y /\
          (forall x':set, x' :e S1 ->
            apply_fun s55_S1_antipode_map x' = y -> x' = x))
      Hbij
      w
      HwS1).
  }
  apply HsurjPack.
  let x.
  assume HxPack.
  witness x.
  exact (andEL
    (x :e S1 /\ apply_fun s55_S1_antipode_map x = w)
    (forall x':set, x' :e S1 ->
      apply_fun s55_S1_antipode_map x' = w -> x' = x)
    HxPack).
}
claim HinvIn :
  inv S1 (fun x:set => apply_fun s55_S1_antipode_map x) y :e S1.
{
  exact (andEL
    (inv S1 (fun x:set => apply_fun s55_S1_antipode_map x) y :e S1)
    (apply_fun s55_S1_antipode_map
      (inv S1 (fun x:set => apply_fun s55_S1_antipode_map x) y) = y)
    (surj_rinv
      S1
      S1
      (fun x:set => apply_fun s55_S1_antipode_map x)
      HsurjRaw
      y
      HyS1)).
}
claim HyImageInS1 :
  apply_fun s55_S1_antipode_map y :e S1.
{
  exact (continuous_map_value_in_space
    S1
    S1_topology
    S1
    S1_topology
    s55_S1_antipode_map
    y
    s55_S1_antipode_map_continuous
    HyS1).
}
claim HrinvY :
  apply_fun s55_S1_antipode_map
    (inv S1 (fun x:set => apply_fun s55_S1_antipode_map x) y)
  =
  y.
{
  exact (andER
    (inv S1 (fun x:set => apply_fun s55_S1_antipode_map x) y :e S1)
    (apply_fun s55_S1_antipode_map
      (inv S1 (fun x:set => apply_fun s55_S1_antipode_map x) y) = y)
    (surj_rinv
      S1
      S1
      (fun x:set => apply_fun s55_S1_antipode_map x)
      HsurjRaw
      y
      HyS1)).
}
claim HinvEqFF :
  apply_fun s55_S1_antipode_map
    (inv S1 (fun x:set => apply_fun s55_S1_antipode_map x) y)
  =
  apply_fun s55_S1_antipode_map
    (apply_fun s55_S1_antipode_map y).
{
  exact (eq_i_tra
    (apply_fun s55_S1_antipode_map
      (inv S1 (fun x:set => apply_fun s55_S1_antipode_map x) y))
    y
    (apply_fun s55_S1_antipode_map
      (apply_fun s55_S1_antipode_map y))
    HrinvY
    (eq_symm
      (apply_fun s55_S1_antipode_map
        (apply_fun s55_S1_antipode_map y))
      y
      (s55_S1_antipode_map_involution
        y
        HyS1))).
}
claim HinvAtY :
  inv S1 (fun x:set => apply_fun s55_S1_antipode_map x) y
  =
  apply_fun s55_S1_antipode_map y.
{
  exact (s55_S1_antipode_map_injective
