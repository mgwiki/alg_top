		                  claim Hhb2Img : apply_fun h (apply_fun basis2 alpha) :e ImgAlpha.
		                  {
		                    claim HmulImg :
		                      apply_fun multG (apply_fun basis2 alpha, apply_fun basis2 alpha) :e ImgAlpha.
		                    { exact (subgroup_of_mult_closed
		                        ImgAlpha
		                        G
		                        multG
		                        eG
		                        invG
