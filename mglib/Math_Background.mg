                (q :e omega)
                (exists r:set, r :e k /\
                  n = add_nat (mul_nat q k) r)
                HqPack).
            }
            claim HrEx :
              exists r:set, r :e k /\
                n = add_nat (mul_nat q k) r.
            {
              exact (andER
                (q :e omega)
                (exists r:set, r :e k /\
                  n = add_nat (mul_nat q k) r)
                HqPack).
            }
            apply HrEx.
            let r.
            assume HrPack.
            claim Hrk : r :e k.
            {
              exact (andEL
                (r :e k)
                (n = add_nat (mul_nat q k) r)
                HrPack).
            }
            claim HnDecomp :
              n = add_nat (mul_nat q k) r.
            {
              exact (andER
                (r :e k)
                (n = add_nat (mul_nat q k) r)
