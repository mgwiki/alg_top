        S1
        (fun z:set => z)
        (1, 0)
        Hb0S1).
      reflexivity.
    }
    rewrite <- HjBaseEq at 2.
    rewrite <- HjBaseEq at 4.
    exact HeqImgs.
  }
  exact (Hinj
