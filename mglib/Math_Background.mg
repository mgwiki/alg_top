claim HzGU : z :e image_of g U0.
{ rewrite <- HVeq. exact HzV. }
apply (ReplE_impred U0 (fun y:set => apply_fun g y) z HzGU).
let y. assume HyU Hzeq.
claim HyX : y :e X.
{ exact (HU0sub y HyU). }
claim HzX : z :e X.
{ rewrite Hzeq. exact (Hfn g HgG y HyX). }
