rewrite (apply_fun_graph
  (euclidean_space 2)
  (fun u:set =>
    graph 3 (fun i:set =>
      if i = 0 then
        mul_SNo
          (mul_SNo 2 (apply_fun u 0))
          (recip_SNo_pos
            (add_SNo 1
              (add_SNo
                (mul_SNo (apply_fun u 0) (apply_fun u 0))
                (mul_SNo (apply_fun u 1) (apply_fun u 1)))))
      else if i = 1 then
