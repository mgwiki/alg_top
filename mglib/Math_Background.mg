    (Rlt r0 (eps_ 1))
    Hr0Pack).
}
claim Hr0lt1 : Rlt r0 1.
{
  exact (Rlt_tra
    r0
    (eps_ 1)
    1
    Hr0LtEps
    eps_1_lt1_R).
}
claim Hr1Ex :
  exists r1:set, r1 :e R /\ Rlt 0 r1 /\
