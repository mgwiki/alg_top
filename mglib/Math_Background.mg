    exact (If_i_1
      (2 = 2)
      (minus_SNo 1)
      0
      (eq_refl 2)).
  }
  claim HequatorD : apply_fun S1_equator_in_S2 z :e Sn 2 :\: {south_pole_3}.
  {
    apply setminusI.
    - exact HequatorSn2.
    - assume HeqSouth.
      claim HeqSouthEq :
