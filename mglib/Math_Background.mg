   <->
   (forall e1 e2:set, e1 :e E -> e2 :e E ->
     apply_fun p e1 = apply_fun p e0 ->
     apply_fun p e2 = apply_fun p e0 ->
     exists h:set, covering_transformation E Te B Tb p h /\ apply_fun h e1 = e2)).
