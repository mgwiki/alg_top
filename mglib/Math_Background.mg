Axiom nonneg_diadic_rational_p_SNoS_omega: forall k :e omega, forall n, nat_p n -> eps_ k * n :e SNoS_ omega.

Definition diadic_rational_p : set -> prop := fun x => exists k :e omega, exists m :e int, x = eps_ k * m.

Axiom diadic_rational_p_SNoS_omega: forall x, diadic_rational_p x -> x :e SNoS_ omega.

Axiom int_diadic_rational_p : forall m :e int, diadic_rational_p m.

Axiom omega_diadic_rational_p : forall m :e omega, diadic_rational_p m.

Axiom eps_diadic_rational_p : forall k :e omega, diadic_rational_p (eps_ k).

Axiom minus_SNo_diadic_rational_p : forall x, diadic_rational_p x -> diadic_rational_p (- x).

Axiom mul_SNo_diadic_rational_p : forall x y, diadic_rational_p x -> diadic_rational_p y -> diadic_rational_p (x * y).

Axiom add_SNo_diadic_rational_p : forall x y, diadic_rational_p x -> diadic_rational_p y -> diadic_rational_p (x + y).

Axiom SNoS_omega_diadic_rational_p_lem: forall n, nat_p n -> forall x, SNo x -> SNoLev x = n -> diadic_rational_p x.

Axiom SNoS_omega_diadic_rational_p: forall x :e SNoS_ omega, diadic_rational_p x.

Axiom mul_SNo_SNoS_omega : forall x y :e SNoS_ omega, x * y :e SNoS_ omega.

End DiadicRationals.

Opaque int.

Section SurrealDiv.
Prefix - 358 := minus_SNo.
Infix + 360 right := add_SNo.
Infix * 355 right := mul_SNo.
Infix < 490 := SNoLt.
(* Unicode <= "2264" *)
Infix <= 490 := SNoLe.
Infix ^ 342 right := exp_SNo_nat.
Definition SNoL_pos : set -> set := fun x => {w :e SNoL x|0 < w}.

Axiom SNo_recip_pos_pos: forall x xi, SNo x -> SNo xi -> 0 < x -> x * xi = 1 -> 0 < xi.

Axiom SNo_recip_lem1: forall x x' x'i y y', SNo x -> 0 < x -> x' :e SNoL_pos x -> SNo x'i -> x' * x'i = 1 -> SNo y -> x * y < 1 -> SNo y' -> 1 + - x * y' = (1 + - x * y) * (x' + - x) * x'i -> 1 < x * y'.

Axiom SNo_recip_lem2: forall x x' x'i y y', SNo x -> 0 < x -> x' :e SNoL_pos x -> SNo x'i -> x' * x'i = 1 -> SNo y -> 1 < x * y -> SNo y' -> 1 + - x * y' = (1 + - x * y) * (x' + - x) * x'i -> x * y' < 1.

Axiom SNo_recip_lem3: forall x x' x'i y y', SNo x -> 0 < x -> x' :e SNoR x -> SNo x'i -> x' * x'i = 1 -> SNo y -> x * y < 1 -> SNo y' -> 1 + - x * y' = (1 + - x * y) * (x' + - x) * x'i -> x * y' < 1.

Axiom SNo_recip_lem4: forall x x' x'i y y', SNo x -> 0 < x -> x' :e SNoR x -> SNo x'i -> x' * x'i = 1 -> SNo y -> 1 < x * y -> SNo y' -> 1 + - x * y' = (1 + - x * y) * (x' + - x) * x'i -> 1 < x * y'.

Definition SNo_recipauxset : set -> set -> set -> (set -> set) -> set := fun Y x X g => \/_ y :e Y, {(1 + (x' + - x) * y) * g x'|x' :e X}.

Axiom SNo_recipauxset_I: forall Y x X, forall g:set -> set,
 forall y :e Y, forall x' :e X, (1 + (x' + - x) * y) * g x' :e SNo_recipauxset Y x X g.

Axiom SNo_recipauxset_E : forall Y x X, forall g:set -> set, forall z :e SNo_recipauxset Y x X g, forall p:prop, (forall y :e Y, forall x' :e X, z = (1 + (x' + - x) * y) * g x' -> p) -> p.

Axiom SNo_recipauxset_ext: forall Y x X, forall g h:set -> set, (forall x' :e X, g x' = h x') -> SNo_recipauxset Y x X g = SNo_recipauxset Y x X h.

Definition SNo_recipaux : set -> (set -> set) -> set -> set :=
 fun x g =>
  nat_primrec ({0},0)
   (fun k p => (p 0 :\/: SNo_recipauxset (p 0) x (SNoR x) g
                    :\/: SNo_recipauxset (p 1) x (SNoL_pos x) g,
                p 1 :\/: SNo_recipauxset (p 0) x (SNoL_pos x) g
                    :\/: SNo_recipauxset (p 1) x (SNoR x) g)).

Axiom SNo_recipaux_0: forall x, forall g:set -> set, SNo_recipaux x g 0 = ({0},0).

Axiom SNo_recipaux_S: forall x, forall g:set -> set, forall n, nat_p n ->
   SNo_recipaux x g (ordsucc n)
 = (SNo_recipaux x g n 0 :\/: SNo_recipauxset (SNo_recipaux x g n 0) x (SNoR x) g
        :\/: SNo_recipauxset (SNo_recipaux x g n 1) x (SNoL_pos x) g,
    SNo_recipaux x g n 1 :\/: SNo_recipauxset (SNo_recipaux x g n 0) x (SNoL_pos x) g
        :\/: SNo_recipauxset (SNo_recipaux x g n 1) x (SNoR x) g).

Axiom SNo_recipaux_lem1: forall x, SNo x -> 0 < x ->
 forall g:set -> set,
    (forall x' :e SNoS_ (SNoLev x), 0 < x' -> SNo (g x') /\ x' * g x' = 1)
 -> forall k, nat_p k ->
         (forall y :e SNo_recipaux x g k 0, SNo y /\ x * y < 1)
      /\ (forall y :e SNo_recipaux x g k 1, SNo y /\ 1 < x * y).

Axiom SNo_recipaux_lem2: forall x, SNo x -> 0 < x ->
 forall g:set -> set,
    (forall x' :e SNoS_ (SNoLev x), 0 < x' -> SNo (g x') /\ x' * g x' = 1)
 -> SNoCutP (\/_ k :e omega, SNo_recipaux x g k 0) (\/_ k :e omega, SNo_recipaux x g k 1).

Axiom SNo_recipaux_ext: forall x, SNo x -> forall g h:set -> set, (forall x' :e SNoS_ (SNoLev x), g x' = h x') -> forall k, nat_p k -> SNo_recipaux x g k = SNo_recipaux x h k.

Section recip_SNo_pos.
Let G : set -> (set -> set) -> set := fun x g => SNoCut (\/_ k :e omega, SNo_recipaux x g k 0) (\/_ k :e omega, SNo_recipaux x g k 1).
Definition recip_SNo_pos : set -> set := SNo_rec_i G.

Axiom recip_SNo_pos_eq: forall x, SNo x -> recip_SNo_pos x = G x recip_SNo_pos.

Axiom recip_SNo_pos_prop1: forall x, SNo x -> 0 < x -> SNo (recip_SNo_pos x) /\ x * recip_SNo_pos x = 1.

Axiom SNo_recip_SNo_pos: forall x, SNo x -> 0 < x -> SNo (recip_SNo_pos x).

Axiom recip_SNo_pos_invR: forall x, SNo x -> 0 < x -> x * recip_SNo_pos x = 1.

Axiom recip_SNo_pos_is_pos: forall x, SNo x -> 0 < x -> 0 < recip_SNo_pos x.

Axiom recip_SNo_pos_invol: forall x, SNo x -> 0 < x -> recip_SNo_pos (recip_SNo_pos x) = x.

Axiom recip_SNo_pos_eps_: forall n, nat_p n -> recip_SNo_pos (eps_ n) = 2 ^ n.

Axiom recip_SNo_pos_pow_2: forall n, nat_p n -> recip_SNo_pos (2 ^ n) = eps_ n.

Axiom recip_SNo_pos_2: recip_SNo_pos 2 = eps_ 1.

End recip_SNo_pos.
Definition recip_SNo : set -> set := fun x => if 0 < x then recip_SNo_pos x else if x < 0 then - recip_SNo_pos (- x) else 0.

Axiom recip_SNo_poscase: forall x, 0 < x -> recip_SNo x = recip_SNo_pos x.

Axiom recip_SNo_negcase: forall x, SNo x -> x < 0 -> recip_SNo x = - recip_SNo_pos (- x).

Axiom recip_SNo_0: recip_SNo 0 = 0.

Axiom SNo_recip_SNo: forall x, SNo x -> SNo (recip_SNo x).

Axiom recip_SNo_invR: forall x, SNo x -> x <> 0 -> x * recip_SNo x = 1.

Axiom recip_SNo_invL: forall x, SNo x -> x <> 0 -> recip_SNo x * x = 1.

Axiom mul_SNo_nonzero_cancel_L: forall x y z, SNo x -> x <> 0 -> SNo y -> SNo z -> x * y = x * z -> y = z.

Axiom recip_SNo_pow_2 : forall n, nat_p n -> recip_SNo (2 ^ n) = eps_ n.

Axiom recip_SNo_of_pos_is_pos: forall x, SNo x -> 0 < x -> 0 < recip_SNo x.

Definition div_SNo : set -> set -> set := fun x y => x * recip_SNo y.

Infix :/: 353 := div_SNo.

Axiom SNo_div_SNo: forall x y, SNo x -> SNo y -> SNo (x :/: y).

Axiom div_SNo_0_num: forall x, SNo x -> 0 :/: x = 0.

Axiom div_SNo_0_denum: forall x, SNo x -> x :/: 0 = 0.

Axiom mul_div_SNo_invL: forall x y, SNo x -> SNo y -> y <> 0 -> (x :/: y) * y = x.

Axiom mul_div_SNo_invR: forall x y, SNo x -> SNo y -> y <> 0 -> y * (x :/: y) = x.

Axiom mul_div_SNo_R: forall x y z, SNo x -> SNo y -> SNo z -> (x :/: y) * z = (x * z) :/: y.

Axiom mul_div_SNo_L: forall x y z, SNo x -> SNo y -> SNo z -> z * (x :/: y) = (z * x) :/: y.

Axiom div_mul_SNo_invL: forall x y, SNo x -> SNo y -> y <> 0 -> (x * y) :/: y = x.

Axiom div_div_SNo: forall x y z, SNo x -> SNo y -> SNo z -> (x :/: y) :/: z = x :/: (y * z).

Axiom mul_div_SNo_both: forall x y z w, SNo x -> SNo y -> SNo z -> SNo w -> (x :/: y) * (z :/: w) = (x * z) :/: (y * w).

Axiom recip_SNo_pos_pos: forall x, SNo x -> 0 < x -> 0 < recip_SNo_pos x.

Axiom div_SNo_pos_pos: forall x y, SNo x -> SNo y -> 0 < x -> 0 < y -> 0 < x :/: y.

Axiom div_SNo_neg_pos: forall x y, SNo x -> SNo y -> x < 0 -> 0 < y -> x :/: y < 0.

Axiom div_SNo_pos_LtL : forall x y z, SNo x -> SNo y -> SNo z -> 0 < y -> x < z * y -> x :/: y < z.

Axiom div_SNo_pos_LtR : forall x y z, SNo x -> SNo y -> SNo z -> 0 < y -> z * y < x -> z < x :/: y.

Axiom div_SNo_pos_LtL' : forall x y z, SNo x -> SNo y -> SNo z -> 0 < y -> x :/: y < z -> x < z * y.

Axiom div_SNo_pos_LtR' : forall x y z, SNo x -> SNo y -> SNo z -> 0 < y -> z < x :/: y -> z * y < x.

Axiom mul_div_SNo_nonzero_eq: forall x y z, SNo x -> SNo y -> SNo z -> y <> 0 -> x = y * z -> x :/: y = z.

End SurrealDiv.

Opaque recip_SNo_pos recip_SNo.

Section Reals.

Prefix - 358 := minus_SNo.
Infix + 360 right := add_SNo.
Infix * 355 right := mul_SNo.
Infix :/: 353 := div_SNo.
Infix ^ 342 right := exp_SNo_nat.
Infix < 490 := SNoLt.
(* Unicode <= "2264" *)
Infix <= 490 := SNoLe.

Axiom SNoS_omega_drat_intvl : forall x :e SNoS_ omega,
  forall k :e omega, exists q :e SNoS_ omega, q < x /\ x < q + eps_ k.

Axiom SNoS_ordsucc_omega_bdd_above : forall x :e SNoS_ (ordsucc omega), x < omega -> exists N :e omega, x < N.

Axiom SNoS_ordsucc_omega_bdd_below : forall x :e SNoS_ (ordsucc omega), - omega < x -> exists N :e omega, - N < x.

Axiom SNoS_ordsucc_omega_bdd_drat_intvl : forall x :e SNoS_ (ordsucc omega),
    - omega < x -> x < omega
 -> forall k :e omega, exists q :e SNoS_ omega, q < x /\ x < q + eps_ k.

Definition real : set := {x :e SNoS_ (ordsucc omega)| x <> omega /\ x <> - omega /\ (forall q :e SNoS_ omega, (forall k :e omega, abs_SNo (q + - x) < eps_ k) -> q = x)}.

Axiom real_I : forall x :e SNoS_ (ordsucc omega),
    x <> omega
 -> x <> - omega
 -> (forall q :e SNoS_ omega, (forall k :e omega, abs_SNo (q + - x) < eps_ k) -> q = x)
 -> x :e real.

Axiom real_E : forall x :e real,
 forall p:prop,
      (SNo x
    -> SNoLev x :e ordsucc omega
    -> x :e SNoS_ (ordsucc omega)
    -> - omega < x
    -> x < omega
    -> (forall q :e SNoS_ omega, (forall k :e omega, abs_SNo (q + - x) < eps_ k) -> q = x)
    -> (forall k :e omega, exists q :e SNoS_ omega, q < x /\ x < q + eps_ k)
    -> p)
   -> p.

Axiom real_SNo : forall x :e real, SNo x.

Axiom real_SNoS_omega_prop : forall x :e real, forall q :e SNoS_ omega, (forall k :e omega, abs_SNo (q + - x) < eps_ k) -> q = x.

Axiom SNoS_omega_real : SNoS_ omega c= real.

Axiom real_0 : 0 :e real.

Axiom real_1 : 1 :e real.

Axiom SNoLev_In_real_SNoS_omega : forall x :e real, forall w, SNo w -> SNoLev w :e SNoLev x -> w :e SNoS_ omega.

Axiom real_SNoCut_SNoS_omega: forall L R c= SNoS_ omega, SNoCutP L R
 -> L <> 0
 -> R <> 0
 -> (forall w :e L, exists w' :e L, w < w')
 -> (forall z :e R, exists z' :e R, z' < z)
 -> SNoCut L R :e real.

Axiom real_SNoCut: forall L R c= real, SNoCutP L R
 -> L <> 0
 -> R <> 0
 -> (forall w :e L, exists w' :e L, w < w')
 -> (forall z :e R, exists z' :e R, z' < z)
 -> SNoCut L R :e real.

Axiom minus_SNo_prereal_1 : forall x, SNo x ->
    (forall q :e SNoS_ omega, (forall k :e omega, abs_SNo (q + - x) < eps_ k) -> q = x)
 -> (forall q :e SNoS_ omega, (forall k :e omega, abs_SNo (q + - - x) < eps_ k) -> q = - x).

Axiom minus_SNo_prereal_2 : forall x, SNo x ->
    (forall k :e omega, exists q :e SNoS_ omega, q < x /\ x < q + eps_ k)
 -> (forall k :e omega, exists q :e SNoS_ omega, q < - x /\ - x < q + eps_ k).

Axiom SNo_prereal_incr_lower_pos: forall x, SNo x -> 0 < x
 -> (forall q :e SNoS_ omega, (forall k :e omega, abs_SNo (q + - x) < eps_ k) -> q = x)
 -> (forall k :e omega, exists q :e SNoS_ omega, q < x /\ x < q + eps_ k)
 -> forall k :e omega,
     forall p:prop,
         (forall q :e SNoS_ omega, 0 < q -> q < x -> x < q + eps_ k -> p)
      -> p.

Axiom real_minus_SNo : forall x :e real, - x :e real.

Axiom SNo_prereal_incr_lower_approx: forall x, SNo x ->
    (forall q :e SNoS_ omega, (forall k :e omega, abs_SNo (q + - x) < eps_ k) -> q = x)
 -> (forall k :e omega, exists q :e SNoS_ omega, q < x /\ x < q + eps_ k)
 -> exists f :e SNoS_ omega :^: omega,
       forall n :e omega, f n < x /\ x < f n + eps_ n
                       /\ forall i :e n, f i < f n.

Axiom SNo_prereal_decr_upper_approx: forall x, SNo x ->
    (forall q :e SNoS_ omega, (forall k :e omega, abs_SNo (q + - x) < eps_ k) -> q = x)
 -> (forall k :e omega, exists q :e SNoS_ omega, q < x /\ x < q + eps_ k)
 -> exists g :e SNoS_ omega :^: omega,
       forall n :e omega, g n + - eps_ n < x /\ x < g n
                       /\ forall i :e n, g n < g i.

Axiom SNoCutP_SNoCut_lim : forall lambda, ordinal lambda
 -> (forall alpha :e lambda, ordsucc alpha :e lambda)
 -> forall L R c= SNoS_ lambda, SNoCutP L R
 -> SNoLev (SNoCut L R) :e ordsucc lambda.

Axiom SNoCutP_SNoCut_omega : forall L R c= SNoS_ omega, SNoCutP L R
 -> SNoLev (SNoCut L R) :e ordsucc omega.

Axiom SNo_approx_real_lem:
  forall f g :e SNoS_ omega :^: omega,
     (forall n m :e omega, f n < g m)
  -> forall p:prop,
         (SNoCutP {f n|n :e omega} {g n|n :e omega}
       -> SNo (SNoCut {f n|n :e omega} {g n|n :e omega})
       -> SNoLev (SNoCut {f n|n :e omega} {g n|n :e omega}) :e ordsucc omega
       -> SNoCut {f n|n :e omega} {g n|n :e omega} :e SNoS_ (ordsucc omega)
       -> (forall n :e omega, f n < SNoCut {f n|n :e omega} {g n|n :e omega})
       -> (forall n :e omega, SNoCut {f n|n :e omega} {g n|n :e omega} < g n)
       -> p)
      -> p.

Axiom SNo_approx_real: forall x, SNo x ->
 forall f g :e SNoS_ omega :^: omega,
     (forall n :e omega, f n < x)
  -> (forall n :e omega, x < f n + eps_ n)
  -> (forall n :e omega, forall i :e n, f i < f n)
  -> (forall n :e omega, x < g n)
  -> (forall n :e omega, forall i :e n, g n < g i)
  -> x = SNoCut {f n|n :e omega} {g n|n :e omega}
  -> x :e real.

Axiom SNo_approx_real_rep : forall x :e real,
 forall p:prop,
     (forall f g :e SNoS_ omega :^: omega,
           (forall n :e omega, f n < x)
        -> (forall n :e omega, x < f n + eps_ n)
        -> (forall n :e omega, forall i :e n, f i < f n)
        -> (forall n :e omega, g n + - eps_ n < x)
        -> (forall n :e omega, x < g n)
        -> (forall n :e omega, forall i :e n, g n < g i)
        -> SNoCutP {f n|n :e omega} {g n|n :e omega}
        -> x = SNoCut {f n|n :e omega} {g n|n :e omega}
        -> p)
  -> p.

Axiom real_add_SNo : forall x y :e real, x + y :e real.

Axiom SNoS_ordsucc_omega_bdd_eps_pos : forall x :e SNoS_ (ordsucc omega), 0 < x -> x < omega -> exists N :e omega, eps_ N * x < 1.

Axiom real_mul_SNo_pos : forall x y :e real, 0 < x -> 0 < y -> x * y :e real.

Axiom real_mul_SNo : forall x y :e real, x * y :e real.

Axiom nonneg_real_nat_interval: forall x :e real, 0 <= x -> exists n :e omega, n <= x /\ x < ordsucc n.

Axiom pos_real_left_approx_double: forall x :e real, 0 < x
 -> x <> 2 -> (forall m :e omega, x <> eps_ m)
 -> exists w :e SNoL_pos x, x < 2 * w.

Axiom real_recip_SNo_lem1: forall x, SNo x -> x :e real -> 0 < x ->
    recip_SNo_pos x :e real
 /\ forall k, nat_p k ->
         (SNo_recipaux x recip_SNo_pos k 0 c= real)
      /\ (SNo_recipaux x recip_SNo_pos k 1 c= real).

Axiom real_recip_SNo_pos: forall x :e real, 0 < x -> recip_SNo_pos x :e real.

Axiom real_recip_SNo: forall x :e real, recip_SNo x :e real.

Axiom real_div_SNo: forall x y :e real, x :/: y :e real.

End Reals.

Opaque real.

Section even_odd.

Infix + 360 right := add_nat.
Infix * 355 right := mul_nat.

Axiom nat_le2_cases: forall m, nat_p m -> m c= 2 -> m = 0 \/ m = 1 \/ m = 2.

Axiom prime_nat_2_lem: forall m, nat_p m -> forall n, nat_p n -> m * n = 2 -> m = 1 \/ m = 2.

Axiom prime_nat_2: prime_nat 2.

Prefix - 358 := minus_SNo.
Infix + 360 right := add_SNo.
Infix * 355 right := mul_SNo.

Axiom not_eq_2m_2n1: forall m n :e int, 2 * m <> 2 * n + 1.

End even_odd.

Section form100_22b.

Let tag : set -> set := fun alpha => SetAdjoin alpha {1}.
Postfix ' 100 := tag.

Prefix - 358 := minus_SNo.
Infix + 360 right := add_SNo.
Infix * 355 right := mul_SNo.

Axiom atleastp_SNoS_ordsucc_omega_Power_omega: atleastp (SNoS_ (ordsucc omega)) (Power omega).

Axiom Repl_finite: forall f:set -> set, forall X, finite X -> finite {f x|x :e X}.

Axiom infinite_bigger: forall X c= omega, infinite X -> forall m :e omega, exists n :e X, m :e n.

Axiom equip_real_Power_omega: equip real (Power omega).

Axiom form100_22_real_uncountable_atleastp: ~atleastp real omega.

Axiom form100_22_real_uncountable_equip: ~equip real omega.

Axiom form100_22_real_uncountable: atleastp omega real /\ ~equip real omega.

End form100_22b.

Section rational.

Prefix - 358 := minus_SNo.
Infix + 360 right := add_SNo.
Infix * 355 right := mul_SNo.
Infix ^ 342 right := exp_SNo_nat.
Infix :/: 353 := div_SNo.
Infix < 490 := SNoLt.
(* Unicode <= "2264" *)
Infix <= 490 := SNoLe.

Definition rational : set := {x :e real | exists m :e int, exists n :e omega :\: {0}, x = m :/: n}.

End rational.

Section form100_3.

(** The Denumerability of the Rational Numbers **)

Prefix - 358 := minus_SNo.
Infix + 360 right := add_SNo.
Infix * 355 right := mul_SNo.
Infix :/: 353 := div_SNo.
Infix ^ 342 right := exp_SNo_nat.

Axiom Subq_int_SNoS_omega: int c= SNoS_ omega.

Axiom Subq_SNoS_omega_rational: SNoS_ omega c= rational.

Axiom Subq_rational_real: rational c= real.

Axiom rational_minus_SNo: forall q :e rational, - q :e rational.

Definition nat_pair : set -> set -> set := fun m n => 2 ^ m * (2 * n + 1).

Axiom nat_pair_In_omega: forall m n :e omega, nat_pair m n :e omega.

Axiom nat_pair_0: forall m n m' n' :e omega, nat_pair m n = nat_pair m' n' -> m = m'.

Axiom nat_pair_1: forall m n m' n' :e omega, nat_pair m n = nat_pair m' n' -> n = n'.

Axiom form100_3: equip omega rational.

End form100_3.

Section SurrealSqrt.
Prefix - 358 := minus_SNo.
Infix + 360 right := add_SNo.
Infix * 355 right := mul_SNo.
Infix :/: 353 := div_SNo.
Infix < 490 := SNoLt.
(* Unicode <= "2264" *)
Infix <= 490 := SNoLe.
Infix ^ 342 right := exp_SNo_nat.
Definition SNoL_nonneg : set -> set := fun x => {w :e SNoL x|0 <= w}.

Axiom SNoL_nonneg_0: SNoL_nonneg 0 = 0.

Axiom SNoL_nonneg_1: SNoL_nonneg 1 = 1.

Definition SNo_sqrtauxset : set -> set -> set -> set := fun Y Z x => \/_ y :e Y, {(x + y * z) :/: (y + z)|z :e Z, 0 < y + z}.

Axiom SNo_sqrtauxset_I : forall Y Z x,
 forall y :e Y, forall z :e Z, 0 < y + z -> (x + y * z) :/: (y + z) :e SNo_sqrtauxset Y Z x.

Axiom SNo_sqrtauxset_E : forall Y Z x,
 forall u :e SNo_sqrtauxset Y Z x, forall p:prop,
     (forall y :e Y, forall z :e Z, 0 < y + z -> u = (x + y * z) :/: (y + z) -> p)
  -> p.

Axiom SNo_sqrtauxset_0: forall Z x, SNo_sqrtauxset 0 Z x = 0.

Axiom SNo_sqrtauxset_0': forall Y x, SNo_sqrtauxset Y 0 x = 0.

Definition SNo_sqrtaux : set -> (set -> set) -> set -> set :=
 fun x g =>
  nat_primrec ({g w|w :e SNoL_nonneg x},{g z|z :e SNoR x})
   (fun k p => (p 0 :\/: SNo_sqrtauxset (p 0) (p 1) x,
                p 1 :\/: SNo_sqrtauxset (p 0) (p 0) x
                    :\/: SNo_sqrtauxset (p 1) (p 1) x)).

Axiom SNo_sqrtaux_0: forall x, forall g:set -> set, SNo_sqrtaux x g 0 = ({g w|w :e SNoL_nonneg x},{g z|z :e SNoR x}).

Axiom SNo_sqrtaux_S: forall x, forall g:set -> set, forall n, nat_p n
 -> SNo_sqrtaux x g (ordsucc n)
  = (SNo_sqrtaux x g n 0
       :\/: SNo_sqrtauxset (SNo_sqrtaux x g n 0) (SNo_sqrtaux x g n 1) x,
     SNo_sqrtaux x g n 1
       :\/: SNo_sqrtauxset (SNo_sqrtaux x g n 0) (SNo_sqrtaux x g n 0) x
       :\/: SNo_sqrtauxset (SNo_sqrtaux x g n 1) (SNo_sqrtaux x g n 1) x).

Axiom SNo_sqrtaux_mon_lem: forall x, forall g:set -> set,
  forall m, nat_p m -> forall n, nat_p n
   -> SNo_sqrtaux x g m 0 c= SNo_sqrtaux x g (add_nat m n) 0
   /\ SNo_sqrtaux x g m 1 c= SNo_sqrtaux x g (add_nat m n) 1.

Axiom SNo_sqrtaux_mon: forall x, forall g:set -> set,
  forall m, nat_p m -> forall n, nat_p n -> m c= n
   -> SNo_sqrtaux x g m 0 c= SNo_sqrtaux x g n 0
   /\ SNo_sqrtaux x g m 1 c= SNo_sqrtaux x g n 1.

Axiom SNo_sqrtaux_ext: forall x, SNo x -> forall g h:set -> set, (forall x' :e SNoS_ (SNoLev x), g x' = h x') -> forall k, nat_p k -> SNo_sqrtaux x g k = SNo_sqrtaux x h k.

Section sqrt_SNo_nonneg.
Let G : set -> (set -> set) -> set := fun x g => SNoCut (\/_ k :e omega, SNo_sqrtaux x g k 0) (\/_ k :e omega, SNo_sqrtaux x g k 1).
Definition sqrt_SNo_nonneg : set -> set := SNo_rec_i G.

Axiom sqrt_SNo_nonneg_eq: forall x, SNo x -> sqrt_SNo_nonneg x = G x sqrt_SNo_nonneg.

Axiom sqrt_SNo_nonneg_prop1a: forall x, SNo x -> 0 <= x ->
    (forall w :e SNoS_ (SNoLev x), 0 <= w -> SNo (sqrt_SNo_nonneg w) /\ 0 <= sqrt_SNo_nonneg w /\ sqrt_SNo_nonneg w * sqrt_SNo_nonneg w = w)
 -> forall k, nat_p k ->
              (forall y :e SNo_sqrtaux x sqrt_SNo_nonneg k 0, SNo y /\ 0 <= y /\ y * y < x)
           /\ (forall y :e SNo_sqrtaux x sqrt_SNo_nonneg k 1, SNo y /\ 0 <= y /\ x < y * y).

Axiom sqrt_SNo_nonneg_prop1b: forall x, SNo x -> 0 <= x
 -> (forall k, nat_p k ->
              (forall y :e SNo_sqrtaux x sqrt_SNo_nonneg k 0, SNo y /\ 0 <= y /\ y * y < x)
           /\ (forall y :e SNo_sqrtaux x sqrt_SNo_nonneg k 1, SNo y /\ 0 <= y /\ x < y * y))
 -> SNoCutP (\/_ k :e omega, SNo_sqrtaux x sqrt_SNo_nonneg k 0) (\/_ k :e omega, SNo_sqrtaux x sqrt_SNo_nonneg k 1).

Axiom sqrt_SNo_nonneg_prop1c: forall x, SNo x -> 0 <= x ->
    SNoCutP (\/_ k :e omega, SNo_sqrtaux x sqrt_SNo_nonneg k 0) (\/_ k :e omega, SNo_sqrtaux x sqrt_SNo_nonneg k 1)
 -> (forall z :e (\/_ k :e omega, SNo_sqrtaux x sqrt_SNo_nonneg k 1), forall p:prop, (SNo z -> 0 <= z -> x < z * z -> p) -> p)
 -> 0 <= G x sqrt_SNo_nonneg.

Axiom sqrt_SNo_nonneg_prop1d: forall x, SNo x -> 0 <= x
  -> (forall w :e SNoS_ (SNoLev x), 0 <= w -> SNo (sqrt_SNo_nonneg w) /\ 0 <= sqrt_SNo_nonneg w /\ sqrt_SNo_nonneg w * sqrt_SNo_nonneg w = w)
  -> SNoCutP (\/_ k :e omega, SNo_sqrtaux x sqrt_SNo_nonneg k 0) (\/_ k :e omega, SNo_sqrtaux x sqrt_SNo_nonneg k 1)
  -> 0 <= G x sqrt_SNo_nonneg
  -> G x sqrt_SNo_nonneg * G x sqrt_SNo_nonneg < x
  -> False.

Axiom sqrt_SNo_nonneg_prop1e: forall x, SNo x -> 0 <= x
  -> (forall w :e SNoS_ (SNoLev x), 0 <= w -> SNo (sqrt_SNo_nonneg w) /\ 0 <= sqrt_SNo_nonneg w /\ sqrt_SNo_nonneg w * sqrt_SNo_nonneg w = w)
  -> SNoCutP (\/_ k :e omega, SNo_sqrtaux x sqrt_SNo_nonneg k 0) (\/_ k :e omega, SNo_sqrtaux x sqrt_SNo_nonneg k 1)
  -> 0 <= G x sqrt_SNo_nonneg
  -> x < G x sqrt_SNo_nonneg * G x sqrt_SNo_nonneg
  -> False.

Axiom sqrt_SNo_nonneg_prop1: forall x, SNo x -> 0 <= x -> SNo (sqrt_SNo_nonneg x) /\ 0 <= sqrt_SNo_nonneg x /\ sqrt_SNo_nonneg x * sqrt_SNo_nonneg x = x.

End sqrt_SNo_nonneg.

Axiom SNo_sqrtaux_0_1_prop: forall x, SNo x -> 0 <= x ->
  forall k, nat_p k ->
      (forall y :e SNo_sqrtaux x sqrt_SNo_nonneg k 0, SNo y /\ 0 <= y /\ y * y < x)
   /\ (forall y :e SNo_sqrtaux x sqrt_SNo_nonneg k 1, SNo y /\ 0 <= y /\ x < y * y).

Axiom SNo_sqrtaux_0_prop: forall x, SNo x -> 0 <= x ->
  forall k, nat_p k ->
  forall y :e SNo_sqrtaux x sqrt_SNo_nonneg k 0, SNo y /\ 0 <= y /\ y * y < x.

Axiom SNo_sqrtaux_1_prop: forall x, SNo x -> 0 <= x ->
  forall k, nat_p k ->
  forall y :e SNo_sqrtaux x sqrt_SNo_nonneg k 1, SNo y /\ 0 <= y /\ x < y * y.

Axiom SNo_sqrt_SNo_SNoCutP: forall x, SNo x -> 0 <= x ->
  SNoCutP (\/_ k :e omega, SNo_sqrtaux x sqrt_SNo_nonneg k 0)
          (\/_ k :e omega, SNo_sqrtaux x sqrt_SNo_nonneg k 1).

Axiom SNo_sqrt_SNo_nonneg: forall x, SNo x -> 0 <= x -> SNo (sqrt_SNo_nonneg x).

Axiom sqrt_SNo_nonneg_nonneg: forall x, SNo x -> 0 <= x -> 0 <= sqrt_SNo_nonneg x.

Axiom sqrt_SNo_nonneg_sqr: forall x, SNo x -> 0 <= x -> sqrt_SNo_nonneg x * sqrt_SNo_nonneg x = x.

Axiom sqrt_SNo_nonneg_0 : sqrt_SNo_nonneg 0 = 0.

Axiom sqrt_SNo_nonneg_1 : sqrt_SNo_nonneg 1 = 1.

Axiom sqrt_SNo_nonneg_0inL0: forall x, SNo x -> 0 <= x -> 0 :e SNoLev x -> 0 :e SNo_sqrtaux x sqrt_SNo_nonneg 0 0.

Axiom sqrt_SNo_nonneg_Lnonempty: forall x, SNo x -> 0 <= x -> 0 :e SNoLev x -> (\/_ k :e omega, SNo_sqrtaux x sqrt_SNo_nonneg k 0) <> 0.

Axiom sqrt_SNo_nonneg_Rnonempty: forall x, SNo x -> 0 <= x -> 1 :e SNoLev x -> (\/_ k :e omega, SNo_sqrtaux x sqrt_SNo_nonneg k 1) <> 0.

Axiom SNo_sqrtauxset_real: forall Y Z x, Y c= real -> Z c= real -> x :e real -> SNo_sqrtauxset Y Z x c= real.

Axiom SNo_sqrtauxset_real_nonneg: forall Y Z x, Y c= {w :e real|0 <= w} -> Z c= {z :e real|0 <= z} -> x :e real -> 0 <= x -> SNo_sqrtauxset Y Z x c= {w :e real|0 <= w}.

Axiom sqrt_SNo_nonneg_SNoS_omega: forall x :e SNoS_ omega, 0 <= x -> sqrt_SNo_nonneg x :e real.

Axiom sqrt_SNo_nonneg_real: forall x :e real, 0 <= x -> sqrt_SNo_nonneg x :e real.

End SurrealSqrt.
Opaque sqrt_SNo_nonneg.

Section form100_1.

Prefix - 358 := minus_SNo.
Infix + 360 right := add_SNo.
Infix * 355 right := mul_SNo.
Infix :/: 353 := div_SNo.

Axiom divides_int_div_SNo_int: forall m n, divides_int m n -> n :/: m :e int.

(** If m times m = 2 times n times n for naturals m and n, then n = 0. **)
Axiom form100_1_lem1 : forall m, nat_p m -> forall n, nat_p n -> m * m = 2 * n * n -> n = 0.

(** There are no nonzero naturals m and n such that m times m = 2 times n times n. **)
Axiom form100_1_lem2 : forall m :e omega, forall n :e omega :\: 1, m * m <> 2 * n * n.

Prefix - 358 := minus_SNo.
Infix + 360 right := add_SNo.
Infix * 355 right := mul_SNo.
Infix :/: 353 := div_SNo.

Axiom sqrt_2_irrational: sqrt_SNo_nonneg 2 :e real :\: rational.

End form100_1.

Section Topology.
Definition topology_on : set -> set -> prop := fun X T => T c= Power X /\ Empty :e T /\ X :e T /\ (forall UFam :e Power T , Union UFam :e T) /\ (forall U :e T , forall V :e T , U :/\: V :e T).
Axiom topology_sub_Power : forall X T : set , topology_on X T -> T c= Power X.
Definition open_in : set -> set -> set -> prop := fun X T U => topology_on X T /\ U :e T.
Axiom open_in_topology : forall X T U : set , open_in X T U -> topology_on X T.
Axiom open_in_elem : forall X T U : set , open_in X T U -> U :e T.
Axiom open_inI : forall X T U : set , topology_on X T -> U :e T -> open_in X T U.
Axiom Eps_i_unique : forall P : set -> prop , forall x : set , P x -> (forall y : set , P y -> y = x) -> Eps_i P = x.
Axiom open_in_subset : forall X T U : set , open_in X T U -> U c= X.
Axiom topology_elem_subset : forall X T U : set , topology_on X T -> U :e T -> U c= X.
Axiom topology_has_empty : forall X T : set , topology_on X T -> Empty :e T.
Axiom topology_has_X : forall X T : set , topology_on X T -> X :e T.
Axiom topology_subset_axiom : forall X T : set , topology_on X T -> T c= Power X.
Axiom topology_union_closed : forall X T UFam : set , topology_on X T -> UFam c= T -> Union UFam :e T.
Axiom topology_union_closed_pow : forall X T UFam : set , topology_on X T -> UFam :e Power T -> Union UFam :e T.
Axiom topology_union_axiom : forall X T : set , topology_on X T -> forall UFam :e Power T , Union UFam :e T.
Axiom topology_binintersect_closed : forall X T U V : set , topology_on X T -> U :e T -> V :e T -> U :/\: V :e T.
Axiom topology_binintersect_axiom : forall X T : set , topology_on X T -> forall U :e T , forall V :e T , U :/\: V :e T.
Axiom Empty_is_open : forall X T : set , topology_on X T -> open_in X T Empty.
Axiom X_is_open : forall X T : set , topology_on X T -> open_in X T X.
Axiom union_open : forall X T UFam : set , topology_on X T -> (forall U :e UFam , open_in X T U) -> open_in X T (Union UFam).
Axiom binintersect_open : forall X T U V : set , open_in X T U -> open_in X T V -> open_in X T (U :/\: V).
Definition closed_in : set -> set -> set -> prop := fun X T C => topology_on X T /\ (C c= X /\ exists U :e T , C = X :\: U).
Axiom closed_in_topology : forall X T C : set , closed_in X T C -> topology_on X T.
Axiom closed_in_package : forall X T C : set , closed_in X T C -> C c= X /\ exists U :e T , C = X :\: U.
Axiom closed_inI : forall X T C : set , topology_on X T -> C c= X -> (exists U :e T , C = X :\: U) -> closed_in X T C.
Axiom tuple_2_setprod_by_pair_Sigma : forall X Y : set , forall x y : set , x :e X -> y :e Y -> (x,y) :e setprod X Y.
Axiom closed_in_exists_open_complement : forall X T C : set , closed_in X T C -> exists U :e T , C = X :\: U.
Axiom closed_in_subset : forall X T C : set , closed_in X T C -> C c= X.
Axiom closed_of_open_complement : forall X T U : set , topology_on X T -> U :e T -> closed_in X T (X :\: U).
Axiom X_is_closed : forall X T : set , topology_on X T -> closed_in X T X.
Axiom Empty_is_closed : forall X T : set , topology_on X T -> closed_in X T Empty.
Axiom closed_binintersect : forall X T C D : set , closed_in X T C -> closed_in X T D -> closed_in X T (C :/\: D).
Axiom closed_binunion : forall X T C D : set , closed_in X T C -> closed_in X T D -> closed_in X T (C :\/: D).
Axiom open_of_closed_complement : forall X T C : set , closed_in X T C -> open_in X T (X :\: C).
Axiom binunion_eq_Union_pair : forall X Y : set , X :\/: Y = Union {X,Y}.
Axiom topology_binunion_closed : forall X T U V : set , topology_on X T -> U :e T -> V :e T -> U :\/: V :e T.
Axiom binunion_open : forall X T U V : set , open_in X T U -> open_in X T V -> open_in X T (U :\/: V).
Definition finer_than : set -> set -> prop := fun T' T => T c= T'.
Definition coarser_than : set -> set -> prop := fun T' T => T' c= T.
Definition discrete_topology : set -> set := fun X => Power X.
Definition indiscrete_topology : set -> set := fun X => {Empty,X}.
Definition finite_complement_topology : set -> set := fun X => {U :e Power X|finite (X :\: U) \/ U = Empty}.
Definition countable : set -> prop := fun X => atleastp X omega.
Definition countably_infinite : set -> prop := fun X => equip X omega.
Axiom countably_infinite_implies_countable : forall X : set , countably_infinite X -> countable X.
Axiom countably_infinite_implies_infinite : forall X : set , countably_infinite X -> infinite X.
Axiom finite_countable : forall X : set , finite X -> countable X.
Axiom countable_Empty : countable Empty.
Axiom Subq_countable : forall X Y : set , countable Y -> X c= Y -> countable X.
Axiom binintersect_countable_left : forall X Y : set , countable X -> countable (X :/\: Y).
Axiom setminus_countable : forall X A : set , countable X -> countable (X :\: A).
Axiom binunion_countable : forall X Y : set , countable X -> countable Y -> countable (X :\/: Y).
Axiom Sigma_countable : forall X : set , countable X -> forall Y : set -> set , (forall x : set , x :e X -> countable (Y x)) -> countable (Sigma_ x :e X , Y x).
Axiom setprod_countable : forall X Y : set , countable X -> countable Y -> countable (X :*: Y).
Axiom Union_Power : forall X Fam : set , Fam c= Power X -> Union Fam c= X.
Axiom binintersect_Power : forall X U V : set , U :e Power X -> V :e Power X -> U :/\: V :e Power X.
Axiom binintersect_Empty_left : forall A : set , Empty :/\: A = Empty.
Axiom binintersect_Empty_right : forall A : set , A :/\: Empty = Empty.
Axiom setminus_Power : forall X U : set , U :e Power X -> X :\: U :e Power X.
Definition countable_complement_topology : set -> set := fun X => {U :e Power X|countable (X :\: U) \/ U = Empty}.
Axiom countable_complement_topology_on : forall X , topology_on X (countable_complement_topology X).
Axiom discrete_topology_on : forall X , topology_on X (discrete_topology X).
Axiom indiscrete_topology_on : forall X , topology_on X (indiscrete_topology X).
Axiom finite_complement_topology_on : forall X , topology_on X (finite_complement_topology X).
Axiom finer_than_refl : forall T : set , finer_than T T.
Axiom finer_than_trans : forall A B C : set , finer_than B A -> finer_than C B -> finer_than C A.
Axiom finer_coarser_dual : forall T T' : set , finer_than T' T -> coarser_than T T'.
Definition comparable_topologies : set -> set -> prop := fun T1 T2 => finer_than T1 T2 \/ finer_than T2 T1.
Definition comparable_topologies_on : set -> set -> set -> prop := fun X T1 T2 => topology_on X T1 /\ topology_on X T2 /\ comparable_topologies T1 T2.
Axiom comparable_topologies_on_topology1 : forall X T1 T2 : set , comparable_topologies_on X T1 T2 -> topology_on X T1.
Axiom comparable_topologies_on_topology2 : forall X T1 T2 : set , comparable_topologies_on X T1 T2 -> topology_on X T2.
Axiom comparable_topologies_on_comparable : forall X T1 T2 : set , comparable_topologies_on X T1 T2 -> comparable_topologies T1 T2.
Definition topology_eq : set -> set -> set -> prop := fun X T1 T2 => topology_on X T1 /\ topology_on X T2 /\ T1 = T2.
Axiom topology_eq_sym : forall X T1 T2 : set , topology_eq X T1 T2 -> topology_eq X T2 T1.
Axiom topology_eq_trans : forall X T1 T2 T3 : set , topology_eq X T1 T2 -> topology_eq X T2 T3 -> topology_eq X T1 T3.
Axiom topology_eq_refl : forall X T : set , topology_on X T -> topology_eq X T T.
Definition strictly_finer_than : set -> set -> prop := fun T' T => finer_than T' T /\ ~ finer_than T T'.
Definition strictly_coarser_than : set -> set -> prop := fun T' T => coarser_than T' T /\ ~ coarser_than T T'.
Definition strictly_finer_than_topology : set -> set -> set -> prop := fun X T' T => topology_on X T' /\ topology_on X T /\ strictly_finer_than T' T.
Definition strictly_coarser_than_topology : set -> set -> set -> prop := fun X T' T => topology_on X T' /\ topology_on X T /\ strictly_coarser_than T' T.
Axiom strictly_finer_than_topology_topology1 : forall X T' T : set , strictly_finer_than_topology X T' T -> topology_on X T'.
Axiom strictly_finer_than_topology_topology2 : forall X T' T : set , strictly_finer_than_topology X T' T -> topology_on X T.
Axiom strictly_finer_than_topology_strict : forall X T' T : set , strictly_finer_than_topology X T' T -> strictly_finer_than T' T.
Axiom strictly_coarser_than_topology_strict : forall X T' T : set , strictly_coarser_than_topology X T' T -> strictly_coarser_than T' T.
Definition discrete_topology_alt : set -> set := discrete_topology.
Definition trivial_topology : set -> set := indiscrete_topology.
Definition finer_than_topology : set -> set -> set -> prop := fun X T' T => topology_on X T' /\ topology_on X T /\ finer_than T' T.
Axiom finer_than_def : forall T T' : set , finer_than T' T <-> coarser_than T T'.
Axiom discrete_topology_finest : forall X T : set , topology_on X T -> finer_than (discrete_topology X) T.
Axiom indiscrete_topology_coarsest : forall X T : set , topology_on X T -> coarser_than (indiscrete_topology X) T.
Axiom discrete_open_all : forall X U : set , U c= X -> U :e discrete_topology X.
Axiom indiscrete_open_iff : forall X U : set , U :e indiscrete_topology X <-> (U = Empty \/ U = X).
Axiom finite_complement_topology_open_criterion : forall X U : set , open_in X (finite_complement_topology X) U -> finite (X :\: U) \/ U = Empty.
Axiom finite_complement_topology_contains_empty : forall X : set , Empty :e finite_complement_topology X.
Axiom finite_complement_topology_contains_full : forall X : set , X :e finite_complement_topology X.
Axiom countable_complement_topology_open_iff : forall X U : set , open_in X (countable_complement_topology X) U -> countable (X :\: U) \/ U = Empty.
Axiom countable_complement_topology_contains_empty : forall X : set , Empty :e countable_complement_topology X.
Axiom countable_complement_topology_contains_full : forall X : set , X :e countable_complement_topology X.
Axiom countable_complement_finer_than_finite_complement : forall X : set , finer_than (countable_complement_topology X) (finite_complement_topology X).
Axiom finite_complement_coarser_than_discrete : forall X : set , coarser_than (finite_complement_topology X) (discrete_topology X).
Axiom indiscrete_coarser_than_countable_complement : forall X : set , coarser_than (indiscrete_topology X) (countable_complement_topology X).
Definition finer_than_topology_by_inclusion : set -> set -> set -> prop := finer_than_topology.
Axiom finer_than_topology_by_inclusion_eq : forall X T' T : set , finer_than_topology X T' T <-> finer_than_topology_by_inclusion X T' T.
Axiom lemma_union_of_topology_family_open : forall X T UFam : set , topology_on X T -> UFam :e Power T -> Union UFam :e T.
Axiom lemma_intersection_two_open : forall X T U V : set , topology_on X T -> U :e T -> V :e T -> U :/\: V :e T.
Definition topological_space : set -> set -> prop := topology_on.
Definition open_set_family : set -> set -> set := fun _ T => T.
Definition open_set : set -> set -> set -> prop := open_in.
Definition basis_on : set -> set -> prop := fun X B => B c= Power X /\ (forall x :e X , exists b :e B , x :e b) /\ (forall b1 :e B , forall b2 :e B , forall x : set , x :e b1 -> x :e b2 -> exists b3 :e B , x :e b3 /\ b3 c= b1 :/\: b2).
Axiom basis_on_sub_Power : forall X B : set , basis_on X B -> B c= Power X.
Axiom basis_on_cover : forall X B : set , basis_on X B -> forall x :e X , exists b :e B , x :e b.
Axiom basis_on_refine : forall X B : set , basis_on X B -> forall b1 :e B , forall b2 :e B , forall x : set , x :e b1 -> x :e b2 -> exists b3 :e B , x :e b3 /\ b3 c= b1 :/\: b2.
Definition generated_topology : set -> set -> set := fun X B => {U :e Power X|forall x :e U , exists b :e B , x :e b /\ b c= U}.
Axiom generated_topology_local_refine : forall X B U x : set , U :e generated_topology X B -> x :e U -> exists b :e B , x :e b /\ b c= U.
Axiom generated_topology_contains_elem : forall X B U : set , U :e Power X -> U :e B -> U :e generated_topology X B.
Axiom basis_elem_subset : forall X B b : set , basis_on X B -> b :e B -> b c= X.
Axiom basis_in_generated : forall X B b : set , basis_on X B -> b :e B -> b :e generated_topology X B.
Axiom generated_topology_subset : forall X B U : set , U :e generated_topology X B -> U c= X.
Axiom lemma_topology_from_basis : forall X B : set , basis_on X B -> topology_on X (generated_topology X B).
Axiom generated_topology_contains_basis : forall X B : set , basis_on X B -> forall b : set , b :e B -> b :e generated_topology X B.
Axiom generated_topology_finer_weak : forall X B T : set , topology_on X T -> (forall b :e B , b :e T) -> finer_than T (generated_topology X B).
Definition basis_generates : set -> set -> set -> prop := fun X B T => basis_on X B /\ generated_topology X B = T.
Definition basis_refines : set -> set -> set -> prop := fun X B T => topology_on X T /\ (forall U :e T , forall x :e U , exists b :e B , x :e b /\ b c= U).
Axiom lemma_generated_topology_characterization : forall X B : set , basis_on X B -> generated_topology X B = {U :e Power X|forall x :e U , exists b :e B , x :e b /\ b c= U}.
Axiom open_sets_as_unions_of_basis : forall X B : set , basis_on X B -> forall U : set , open_in X (generated_topology X B) U -> exists Fam :e Power B , Union Fam = U.
Axiom basis_generates_open_sets : forall X B : set , basis_on X B -> forall U : set , (exists Fam :e Power B , Union Fam = U) -> open_in X (generated_topology X B) U.
Axiom open_as_union_of_basis_elements : forall X B : set , basis_on X B -> forall U : set , open_in X (generated_topology X B) U -> U = Union {b :e B|b c= U}.
Axiom basis_refines_topology : forall X T C : set , topology_on X T -> (forall c :e C , c :e T) -> (forall U :e T , forall x :e U , exists Cx :e C , x :e Cx /\ Cx c= U) -> basis_on X C /\ generated_topology X C = T.
Axiom lemma13_2_basis_from_open_subcollection : forall X T C : set , topology_on X T -> (forall c :e C , c :e T) -> (forall U :e T , forall x :e U , exists c :e C , x :e c /\ c c= U) -> basis_on X C /\ generated_topology X C = T.
Axiom finer_via_basis : forall X B B' : set , basis_on X B -> basis_on X B' -> (forall x :e X , forall b : set , b :e B -> x :e b -> exists b' :e B' , x :e b' /\ b' c= b) -> finer_than (generated_topology X B') (generated_topology X B).
Axiom basis_finer_equiv_condition : forall X B B' : set , basis_on X B -> basis_on X B' -> ((forall x :e X , forall b :e B , x :e b -> exists b' :e B' , x :e b' /\ b' c= b) <-> finer_than (generated_topology X B') (generated_topology X B)).
Axiom generated_topology_finer : forall X B T : set , basis_on X B -> topology_on X T -> (forall b :e B , b :e T) -> finer_than T (generated_topology X B).
Axiom topology_generated_by_basis_is_smallest : forall X B T : set , basis_on X B -> topology_on X T -> (forall b :e B , b :e T) -> finer_than T (generated_topology X B).
Axiom union_of_basis_equals_open : forall X B : set , basis_on X B -> generated_topology X B = {Union Fam|Fam :e Power B}.
Definition singleton_basis : set -> set := fun X => {{x}|x :e X}.
Axiom singleton_basis_is_basis : forall X : set , basis_on X (singleton_basis X).
Axiom generated_topology_singletons_discrete : forall X : set , generated_topology X (singleton_basis X) = discrete_topology X.
Definition R : set := real.
Definition Q : set := rational.
Definition Rlt : set -> set -> prop := fun a b => a :e R /\ b :e R /\ a < b.
Definition Rle : set -> set -> prop := fun a b => a :e R /\ b :e R /\ ~ (Rlt b a).
Axiom RleI : forall a b : set , a :e R -> b :e R -> ~ (Rlt b a) -> Rle a b.
Axiom RleE_left : forall a b : set , Rle a b -> a :e R.
Axiom RleE_right : forall a b : set , Rle a b -> b :e R.
Axiom RleE_nlt : forall a b : set , Rle a b -> ~ (Rlt b a).
Axiom Rle_neq_implies_Rlt : forall a b : set , Rle a b -> ~ (a = b) -> Rlt a b.
Axiom Rle_minus_nonneg : forall t : set , t :e R -> ~ (Rlt t 0) -> Rle (minus_SNo t) 0.
Axiom RltI : forall a b : set , a :e R -> b :e R -> a < b -> Rlt a b.
Axiom RltE_left : forall a b : set , Rlt a b -> a :e R.
Axiom RltE_right : forall a b : set , Rlt a b -> b :e R.
Axiom RltE_lt : forall a b : set , Rlt a b -> a < b.
Axiom Rlt_tra : forall a b c : set , Rlt a b -> Rlt b c -> Rlt a c.
Axiom not_Rlt_refl : forall a : set , a :e R -> ~ (Rlt a a).
Axiom not_Rlt_sym : forall a b : set , Rlt a b -> ~ (Rlt b a).
Axiom Rlt_0_diff_of_lt : forall a b : set , Rlt a b -> Rlt 0 (add_SNo b (minus_SNo a)).
Axiom Rlt_implies_Rle : forall a b : set , Rlt a b -> Rle a b.
Axiom Rle_refl : forall a : set , a :e R -> Rle a a.
Axiom R_eq_of_not_Rlt : forall a b : set , a :e R -> b :e R -> ~ (Rlt a b) -> ~ (Rlt b a) -> a = b.
Axiom Rle_antisym : forall a b : set , Rle a b -> Rle b a -> a = b.
Axiom SNoLe_of_Rle : forall a b : set , Rle a b -> a <= b.
Axiom Rlt_0_1 : Rlt 0 1.
Axiom minus_1_lt_0 : minus_SNo 1 < 0.
Definition EuclidPlane : set := setprod R R.
Definition R2_xcoord : set -> set := fun p => p 0.
Definition R2_ycoord : set -> set := fun p => p 1.
Axiom EuclidPlane_xcoord_in_R : forall p : set , p :e EuclidPlane -> R2_xcoord p :e R.
Axiom EuclidPlane_ycoord_in_R : forall p : set , p :e EuclidPlane -> R2_ycoord p :e R.
Axiom R2_xcoord_tuple : forall x y : set , R2_xcoord (x,y) = x.
Axiom R2_ycoord_tuple : forall x y : set , R2_ycoord (x,y) = y.
Axiom tuple_eq_coords : forall x1 y1 x2 y2 : set , (x1,y1) = (x2,y2) -> x1 = x2 /\ y1 = y2.
Axiom tuple_coords_eq : forall x1 y1 x2 y2 : set , x1 = x2 -> y1 = y2 -> (x1,y1) = (x2,y2).
Axiom coords_eq_tuple : forall x1 y1 x2 y2 : set , x1 = x2 -> y1 = y2 -> (x1,y1) = (x2,y2).
Axiom EuclidPlane_eta : forall p : set , p :e EuclidPlane -> (R2_xcoord p,R2_ycoord p) = p.
Axiom tuple_eq_coords_R2 : forall x1 y1 x2 y2 : set , (x1,y1) = (x2,y2) -> x1 = x2 /\ y1 = y2.
Definition distance_R2 : set -> set -> set := fun p c => sqrt_SNo_nonneg (add_SNo (mul_SNo (add_SNo (R2_xcoord p) (minus_SNo (R2_xcoord c))) (add_SNo (R2_xcoord p) (minus_SNo (R2_xcoord c)))) (mul_SNo (add_SNo (R2_ycoord p) (minus_SNo (R2_ycoord c))) (add_SNo (R2_ycoord p) (minus_SNo (R2_ycoord c))))).
Axiom distance_R2_in_R : forall p c : set , p :e EuclidPlane -> c :e EuclidPlane -> distance_R2 p c :e R.
Axiom distance_R2_nonneg : forall p c : set , p :e EuclidPlane -> c :e EuclidPlane -> 0 <= distance_R2 p c.
Axiom distance_R2_sqr : forall p c : set , p :e EuclidPlane -> c :e EuclidPlane -> mul_SNo (distance_R2 p c) (distance_R2 p c) = add_SNo (mul_SNo (add_SNo (R2_xcoord p) (minus_SNo (R2_xcoord c))) (add_SNo (R2_xcoord p) (minus_SNo (R2_xcoord c)))) (mul_SNo (add_SNo (R2_ycoord p) (minus_SNo (R2_ycoord c))) (add_SNo (R2_ycoord p) (minus_SNo (R2_ycoord c)))).
Axiom abs_SNo_sqr_eq : forall x : set , SNo x -> mul_SNo (abs_SNo x) (abs_SNo x) = mul_SNo x x.
Axiom SNoLe_add_nonneg_right : forall x y : set , SNo x -> SNo y -> 0 <= y -> x <= add_SNo x y.
Axiom SNo_sqr_nonneg : forall x : set , SNo x -> 0 <= mul_SNo x x.
Axiom dx2_le_distance_R2_sqr : forall p c : set , p :e EuclidPlane -> c :e EuclidPlane -> mul_SNo (add_SNo (R2_xcoord p) (minus_SNo (R2_xcoord c))) (add_SNo (R2_xcoord p) (minus_SNo (R2_xcoord c))) <= mul_SNo (distance_R2 p c) (distance_R2 p c).
Axiom dy2_le_distance_R2_sqr : forall p c : set , p :e EuclidPlane -> c :e EuclidPlane -> mul_SNo (add_SNo (R2_ycoord p) (minus_SNo (R2_ycoord c))) (add_SNo (R2_ycoord p) (minus_SNo (R2_ycoord c))) <= mul_SNo (distance_R2 p c) (distance_R2 p c).
Axiom abs_dx2_le_distance_R2_sqr : forall p c : set , p :e EuclidPlane -> c :e EuclidPlane -> mul_SNo (abs_SNo (add_SNo (R2_xcoord p) (minus_SNo (R2_xcoord c)))) (abs_SNo (add_SNo (R2_xcoord p) (minus_SNo (R2_xcoord c)))) <= mul_SNo (distance_R2 p c) (distance_R2 p c).
Axiom abs_dy2_le_distance_R2_sqr : forall p c : set , p :e EuclidPlane -> c :e EuclidPlane -> mul_SNo (abs_SNo (add_SNo (R2_ycoord p) (minus_SNo (R2_ycoord c)))) (abs_SNo (add_SNo (R2_ycoord p) (minus_SNo (R2_ycoord c)))) <= mul_SNo (distance_R2 p c) (distance_R2 p c).
Axiom abs_SNo_nonneg : forall x : set , SNo x -> 0 <= abs_SNo x.
Axiom SNo_sqr_lt_of_lt_nonneg : forall x y : set , SNo x -> SNo y -> 0 <= x -> x < y -> mul_SNo x x < mul_SNo y y.
Axiom abs_dx_le_distance_R2 : forall p c : set , p :e EuclidPlane -> c :e EuclidPlane -> abs_SNo (add_SNo (R2_xcoord p) (minus_SNo (R2_xcoord c))) <= distance_R2 p c.
Axiom abs_dy_le_distance_R2 : forall p c : set , p :e EuclidPlane -> c :e EuclidPlane -> abs_SNo (add_SNo (R2_ycoord p) (minus_SNo (R2_ycoord c))) <= distance_R2 p c.
Axiom abs_SNo_lt_imp_lt : forall t r : set , SNo t -> SNo r -> 0 < r -> abs_SNo t < r -> t < r.
Axiom abs_SNo_lt_imp_neg_lt : forall t r : set , SNo t -> SNo r -> 0 < r -> abs_SNo t < r -> minus_SNo t < r.
Axiom SNo_lt_of_abs_diff_and_margin : forall a x y r : set , SNo a -> SNo x -> SNo y -> SNo r -> 0 < r -> a < add_SNo x (minus_SNo r) -> abs_SNo (add_SNo x (minus_SNo y)) < r -> a < y.
Axiom abs_xcoord_lt_of_distance_lt : forall p x r : set , p :e EuclidPlane -> x :e EuclidPlane -> r :e R -> Rlt (distance_R2 p x) r -> abs_SNo (add_SNo (R2_xcoord p) (minus_SNo (R2_xcoord x))) < r.
Axiom abs_ycoord_lt_of_distance_lt : forall p x r : set , p :e EuclidPlane -> x :e EuclidPlane -> r :e R -> Rlt (distance_R2 p x) r -> abs_SNo (add_SNo (R2_ycoord p) (minus_SNo (R2_ycoord x))) < r.
Axiom distance_R2_refl_0 : forall p : set , p :e EuclidPlane -> distance_R2 p p = 0.
Axiom distance_R2_sym : forall p c : set , p :e EuclidPlane -> c :e EuclidPlane -> distance_R2 p c = distance_R2 c p.
Axiom SNo_nonneg_ne0_pos : forall x : set , SNo x -> 0 <= x -> x <> 0 -> 0 < x.
Axiom SNoLt_sqr_nonneg : forall x y : set , SNo x -> SNo y -> 0 <= x -> 0 <= y -> x < y -> mul_SNo x x < mul_SNo y y.
Axiom SNo_nonneg_sqr_Le_imp_Le : forall x y : set , SNo x -> SNo y -> 0 <= x -> 0 <= y -> mul_SNo x x <= mul_SNo y y -> x <= y.
Axiom CauchySchwarz2_sq : forall a b c d : set , SNo a -> SNo b -> SNo c -> SNo d -> mul_SNo (add_SNo (mul_SNo a c) (mul_SNo b d)) (add_SNo (mul_SNo a c) (mul_SNo b d)) <= mul_SNo (add_SNo (mul_SNo a a) (mul_SNo b b)) (add_SNo (mul_SNo c c) (mul_SNo d d)).
Axiom distance_R2_triangle_sqr_Le : forall x y z : set , x :e EuclidPlane -> y :e EuclidPlane -> z :e EuclidPlane -> mul_SNo (distance_R2 x z) (distance_R2 x z) <= mul_SNo (add_SNo (distance_R2 x y) (distance_R2 y z)) (add_SNo (distance_R2 x y) (distance_R2 y z)).
Axiom distance_R2_triangle_Rle : forall x y z : set , x :e EuclidPlane -> y :e EuclidPlane -> z :e EuclidPlane -> Rle (distance_R2 x z) (add_SNo (distance_R2 x y) (distance_R2 y z)).
Axiom distance_R2_eq0 : forall p c : set , p :e EuclidPlane -> c :e EuclidPlane -> distance_R2 p c = 0 -> p = c.
Axiom distance_R2_not_Rlt_0 : forall p c : set , p :e EuclidPlane -> c :e EuclidPlane -> ~ (Rlt (distance_R2 p c) 0).
Definition circular_regions : set := {U :e Power EuclidPlane|exists c : set , exists r : set , c :e EuclidPlane /\ Rlt 0 r /\ U = {p :e EuclidPlane|Rlt (distance_R2 p c) r}}.
Axiom circular_regionI : forall c r : set , c :e EuclidPlane -> Rlt 0 r -> {p :e EuclidPlane|Rlt (distance_R2 p c) r} :e circular_regions.
Definition rectangular_regions : set := {U :e Power EuclidPlane|exists a b c d : set , a :e R /\ b :e R /\ c :e R /\ d :e R /\ Rlt a b /\ Rlt c d /\ U = {p :e EuclidPlane|exists x y : set , p = (x,y) /\ Rlt a x /\ Rlt x b /\ Rlt c y /\ Rlt y d}}.
Axiom rectangular_regionI : forall a b c d : set , a :e R -> b :e R -> c :e R -> d :e R -> Rlt a b -> Rlt c d -> {p :e EuclidPlane|exists x y : set , p = (x,y) /\ Rlt a x /\ Rlt x b /\ Rlt c y /\ Rlt y d} :e rectangular_regions.
Axiom exists_eps_lt_pos_Euclid : forall d : set , d :e R -> Rlt 0 d -> exists N :e omega , eps_ N < d.
Axiom exists_eps_lt_two_pos_Euclid : forall a b : set , a :e R -> b :e R -> Rlt 0 a -> Rlt 0 b -> exists r3 : set , r3 :e R /\ Rlt 0 r3 /\ Rlt r3 a /\ Rlt r3 b.
Axiom exists_eps_lt_four_pos_Euclid : forall a b c d : set , a :e R -> b :e R -> c :e R -> d :e R -> Rlt 0 a -> Rlt 0 b -> Rlt 0 c -> Rlt 0 d -> exists r3 : set , r3 :e R /\ Rlt 0 r3 /\ Rlt r3 a /\ Rlt r3 b /\ Rlt r3 c /\ Rlt r3 d.
Axiom Rle_Rlt_tra_Euclid : forall a b c : set , Rle a b -> Rlt b c -> Rlt a c.
Axiom ball_refine_two_balls : forall x c1 c2 r1 r2 : set , x :e EuclidPlane -> c1 :e EuclidPlane -> c2 :e EuclidPlane -> Rlt 0 r1 -> Rlt 0 r2 -> Rlt (distance_R2 x c1) r1 -> Rlt (distance_R2 x c2) r2 -> exists r3 : set , Rlt 0 r3 /\ (forall p : set , p :e EuclidPlane -> Rlt (distance_R2 p x) r3 -> Rlt (distance_R2 p c1) r1 /\ Rlt (distance_R2 p c2) r2).
Axiom abs_diff_lt_of_between : forall x y r : set , x :e R -> y :e R -> r :e R -> Rlt 0 r -> Rlt (add_SNo y (minus_SNo r)) x -> Rlt x (add_SNo y r) -> abs_SNo (add_SNo x (minus_SNo y)) < r.
Axiom distance_R2_le_absdx_plus_absdy : forall p c : set , p :e EuclidPlane -> c :e EuclidPlane -> distance_R2 p c <= add_SNo (abs_SNo (add_SNo (R2_xcoord p) (minus_SNo (R2_xcoord c)))) (abs_SNo (add_SNo (R2_ycoord p) (minus_SNo (R2_ycoord c)))).
Axiom rectangle_inside_ball : forall x c r0 : set , x :e EuclidPlane -> c :e EuclidPlane -> Rlt 0 r0 -> Rlt (distance_R2 x c) r0 -> exists r :e rectangular_regions , x :e r /\ r c= {p :e EuclidPlane|Rlt (distance_R2 p c) r0}.
Axiom ball_inside_rectangle : forall b x : set , b :e rectangular_regions -> x :e EuclidPlane -> x :e b -> exists r3 : set , Rlt 0 r3 /\ (forall p : set , p :e EuclidPlane -> Rlt (distance_R2 p x) r3 -> p :e b).
Axiom circular_regions_basis_plane : basis_on EuclidPlane circular_regions.
Axiom rectangular_regions_basis_plane : basis_on EuclidPlane rectangular_regions.
Axiom rectangular_refines_circular_plane : forall b :e circular_regions , forall x : set , x :e b -> exists r :e rectangular_regions , x :e r /\ r c= b.
Axiom circular_refines_rectangular_plane : forall b :e rectangular_regions , forall x : set , x :e b -> exists u :e circular_regions , x :e u /\ u c= b.
Axiom circular_rectangular_same_topology_plane : generated_topology EuclidPlane circular_regions = generated_topology EuclidPlane rectangular_regions.
Axiom lemma_finer_if_basis_refines : forall X B B' : set , basis_on X B -> basis_refines X B' (generated_topology X B) -> finer_than (generated_topology X B') (generated_topology X B).
Definition subbasis_on : set -> set -> prop := fun X S => S c= Power X /\ Union S = X.
Definition intersection_of_family : set -> set -> set := fun X Fam => {x :e X|forall U : set , U :e Fam -> x :e U}.
Definition finite_subcollections : set -> set := fun S => {F :e Power S|finite F}.
Axiom intersection_of_familyI : forall X Fam x : set , x :e X -> (forall U : set , U :e Fam -> x :e U) -> x :e intersection_of_family X Fam.
Axiom intersection_of_familyE1 : forall X Fam x : set , x :e intersection_of_family X Fam -> x :e X.
Axiom intersection_of_familyE2 : forall X Fam x : set , x :e intersection_of_family X Fam -> forall U : set , U :e Fam -> x :e U.
Definition finite_intersections_of : set -> set -> set := fun X S => {intersection_of_family X F|F :e finite_subcollections S}.
Definition basis_of_subbasis : set -> set -> set := fun X S => {b :e finite_intersections_of X S|b <> Empty}.
Axiom finite_intersection_in_basis : forall X S F : set , F :e finite_subcollections S -> intersection_of_family X F <> Empty -> intersection_of_family X F :e basis_of_subbasis X S.
Axiom intersection_of_family_empty_eq : forall X : set , intersection_of_family X Empty = X.
Axiom intersection_of_family_singleton_eq : forall X s : set , s c= X -> intersection_of_family X {s} = s.
Axiom subbasis_elem_in_basis : forall X S s : set , subbasis_on X S -> s :e S -> s <> Empty -> s :e basis_of_subbasis X S.
Axiom X_in_basis_of_subbasis : forall X S : set , X <> Empty -> X :e basis_of_subbasis X S.
Axiom intersection_of_family_adjoin : forall X F U : set , intersection_of_family X (F :\/: {U}) = (intersection_of_family X F) :/\: U.
Axiom finite_intersection_in_topology : forall X T F : set , topology_on X T -> F :e Power T -> finite F -> intersection_of_family X F :e T.
Definition generated_topology_from_subbasis : set -> set -> set := fun X S => generated_topology X (basis_of_subbasis X S).
Axiom finite_intersections_basis_of_subbasis : forall X S : set , subbasis_on X S -> basis_on X (basis_of_subbasis X S).
Axiom topology_from_subbasis_is_topology : forall X S : set , subbasis_on X S -> topology_on X (generated_topology_from_subbasis X S).
Axiom topology_generated_by_basis_is_minimal : forall X S T : set , subbasis_on X S -> topology_on X T -> S c= T -> finer_than T (generated_topology_from_subbasis X S).
Axiom ex13_1_local_open_subset : forall X T A : set , topology_on X T -> (forall x :e A , exists U :e T , x :e U /\ U c= A) -> open_in X T A.
Definition a_elt : set := Empty.
Definition b_elt : set := {Empty}.
Definition c_elt : set := {{Empty}}.
Definition abc_set : set := UPair a_elt b_elt :\/: {c_elt}.
Definition top_abc_1 : set := UPair Empty abc_set.
Definition top_abc_2 : set := Power abc_set.
Definition top_abc_3 : set := UPair Empty {a_elt} :\/: {abc_set}.
Definition top_abc_4 : set := UPair Empty {b_elt} :\/: {abc_set}.
Definition top_abc_5 : set := UPair Empty {c_elt} :\/: {abc_set}.
Definition top_abc_6 : set := UPair Empty (UPair a_elt b_elt) :\/: {abc_set}.
Definition top_abc_7 : set := UPair Empty (UPair a_elt c_elt) :\/: {abc_set}.
Definition top_abc_8 : set := UPair Empty (UPair b_elt c_elt) :\/: {abc_set}.
Definition top_abc_9 : set := (UPair Empty {a_elt} :\/: {UPair a_elt b_elt}) :\/: {abc_set}.
Axiom topology_three_sets : forall X A : set , A c= X -> topology_on X (UPair Empty A :\/: {X}).
Axiom topology_chain_four_sets : forall X A B : set , A c= B -> B c= X -> topology_on X ((UPair Empty A :\/: {B}) :\/: {X}).
Axiom ex13_2_compare_nine_topologies : topology_on abc_set top_abc_1 /\ topology_on abc_set top_abc_2 /\ topology_on abc_set top_abc_3 /\ topology_on abc_set top_abc_4 /\ topology_on abc_set top_abc_5 /\ topology_on abc_set top_abc_6 /\ topology_on abc_set top_abc_7 /\ topology_on abc_set top_abc_8 /\ topology_on abc_set top_abc_9 /\ exists finer_pairs : set , finer_pairs = {p :e Power (Power (Power abc_set))|exists T1 T2 : set , p = setprod T1 T2 /\ (T1 = top_abc_1 \/ T1 = top_abc_2 \/ T1 = top_abc_3 \/ T1 = top_abc_4 \/ T1 = top_abc_5 \/ T1 = top_abc_6 \/ T1 = top_abc_7 \/ T1 = top_abc_8 \/ T1 = top_abc_9) /\ (T2 = top_abc_1 \/ T2 = top_abc_2 \/ T2 = top_abc_3 \/ T2 = top_abc_4 \/ T2 = top_abc_5 \/ T2 = top_abc_6 \/ T2 = top_abc_7 \/ T2 = top_abc_8 \/ T2 = top_abc_9) /\ T1 c= T2}.
Axiom top_abc_3_finer_than_top_abc_1 : finer_than top_abc_3 top_abc_1.
Axiom top_abc_2_finer_than_top_abc_3 : finer_than top_abc_2 top_abc_3.
Axiom top_abc_9_finer_than_top_abc_3 : finer_than top_abc_9 top_abc_3.
Axiom top_abc_9_finer_than_top_abc_6 : finer_than top_abc_9 top_abc_6.
Definition Intersection_Fam : set -> set -> set := fun X Fam => {U :e Power X|forall T : set , T :e Fam -> U :e T}.
Axiom Intersection_Fam_empty_eq : forall X Fam : set , ~ (exists T : set , T :e Fam) -> Intersection_Fam X Fam = Power X.
Axiom intersection_of_family_sub_X : forall X Fam : set , intersection_of_family X Fam c= X.
Axiom intersection_of_family_empty : forall Fam : set , (forall T : set , T :e Fam -> Empty :e T) -> forall X : set , Empty :e Intersection_Fam X Fam.
Definition infinite_complement_family : set -> set := fun X => {U :e Power X|infinite (X :\: U) \/ U = Empty \/ U = X}.
Axiom ex13_3a_Tc_topology : forall X : set , topology_on X (countable_complement_topology X).
Axiom ex13_3a_countable_complement_open : forall X : set , forall U :e countable_complement_topology X , U <> Empty -> countable (X :\: U).
Axiom ex13_3a_union_helper : forall X : set , forall UFam :e Power (countable_complement_topology X) , Union UFam :e countable_complement_topology X.
Axiom infinite_setminus_finite : forall X F : set , infinite X -> finite F -> infinite (X :\: F).
Axiom infinite_nonempty : forall X : set , infinite X -> exists x : set , x :e X.
Axiom finite_UPair : forall a b : set , finite (UPair a b).
Axiom infinite_remove2 : forall X a b : set , infinite X -> infinite (X :\: UPair a b).
Axiom infinite_two_distinct : forall X : set , infinite X -> exists a b : set , a :e X /\ b :e X /\ ~ (a = b).
Axiom infinite_setminus_finite_nonempty : forall X F : set , infinite X -> finite F -> exists x : set , x :e X :\: F.
Axiom infinite_remove1_top : forall X y : set , infinite X -> infinite (X :\: {y}).
Axiom ex13_3b_Tinfty_not_topology : forall X : set , infinite X -> ~ topology_on X (infinite_complement_family X).
Axiom ex13_3b_witness_outline : forall X : set , infinite X -> exists U V : set , U :e infinite_complement_family X /\ V :e infinite_complement_family X.
Axiom ex13_4a_intersection_topology : forall X Fam : set , (exists T : set , T :e Fam) -> (forall T :e Fam , topology_on X T) -> topology_on X (Intersection_Fam X Fam).
Axiom ex13_4b_smallest_largest : forall X Fam : set , (forall T :e Fam , topology_on X T) -> exists Tmin , topology_on X Tmin /\ (forall T :e Fam , T c= Tmin) /\ (forall T' , topology_on X T' /\ (forall T :e Fam , T c= T') -> Tmin c= T') /\ exists Tmax , topology_on X Tmax /\ (forall T :e Fam , Tmax c= T) /\ (forall T' , topology_on X T' /\ (forall T :e Fam , T' c= T) -> T' c= Tmax).
Axiom ex13_4c_specific_topologies : exists Tsmall Tall : set , topology_on abc_set Tsmall /\ topology_on abc_set Tall.
Axiom ex13_5_basis_intersection : forall X A : set , basis_on X A -> generated_topology X A = Intersection_Fam X {T :e Power (Power X)|topology_on X T /\ A c= T}.
Definition rational_numbers : set := Q.
Axiom rational_numbers_Subq_R : rational_numbers c= R.
Axiom rational_numbers_in_R : forall q :e rational_numbers , q :e R.
Definition open_interval : set -> set -> set := fun a b => {x :e R|Rlt a x /\ Rlt x b}.
Definition closed_interval : set -> set -> set := fun a b => {x :e R|~ (Rlt x a) /\ ~ (Rlt b x)}.
Axiom open_interval_left_in_R : forall a b x : set , x :e open_interval a b -> a :e R.
Axiom open_interval_right_in_R : forall a b x : set , x :e open_interval a b -> b :e R.
Definition halfopen_interval_left : set -> set -> set := fun a b => {x :e R|~ (Rlt x a) /\ Rlt x b}.
Axiom halfopen_interval_left_def : forall a b : set , halfopen_interval_left a b = {x :e R|~ (Rlt x a) /\ Rlt x b}.
Axiom halfopen_interval_leftI : forall a b x : set , x :e R -> ~ (Rlt x a) -> Rlt x b -> x :e halfopen_interval_left a b.
Axiom halfopen_interval_leftE1 : forall a b x : set , x :e halfopen_interval_left a b -> x :e R.
Axiom halfopen_interval_leftE2 : forall a b x : set , x :e halfopen_interval_left a b -> ~ (Rlt x a) /\ Rlt x b.
Definition halfopen_interval_right : set -> set -> set := fun a b => {x :e R|Rlt a x /\ ~ (Rlt b x)}.
Axiom halfopen_interval_right_Subq_R : forall a b : set , halfopen_interval_right a b c= R.
Axiom halfopen_interval_right_rightmem : forall a b : set , Rlt a b -> b :e halfopen_interval_right a b.
Axiom open_interval_Subq_R : forall a b : set , open_interval a b c= R.
Axiom real_in_open_interval_minus1_plus1 : forall x : set , x :e R -> x :e open_interval (add_SNo x (minus_SNo 1)) (add_SNo x 1).
Axiom halfopen_interval_left_Subq_R : forall a b : set , halfopen_interval_left a b c= R.
Axiom halfopen_interval_left_leftmem : forall a b : set , Rlt a b -> a :e halfopen_interval_left a b.
Axiom halfopen_interval_left_leftmonotone : forall a x b : set , a :e R -> x :e R -> b :e R -> Rle a x -> halfopen_interval_left x b c= halfopen_interval_left a b.
Axiom halfopen_interval_left_rightmonotone : forall a b c : set , a :e R -> b :e R -> c :e R -> Rle b c -> halfopen_interval_left a b c= halfopen_interval_left a c.
Definition R_standard_basis : set := \/_ a :e R , {open_interval a b|b :e R}.
Definition R_standard_topology : set := generated_topology R R_standard_basis.
Axiom R_standard_topology_def_eq : R_standard_topology = generated_topology R R_standard_basis.
Axiom R_standard_basis_is_basis_local : basis_on R R_standard_basis.
Axiom open_interval_in_R_standard_topology : forall a b : set , Rlt a b -> open_interval a b :e R_standard_topology.
Axiom R_standard_topology_is_topology_local : topology_on R R_standard_topology.
Axiom R_standard_open_refine_interval : forall U x : set , U :e R_standard_topology -> x :e U -> exists a b : set , a :e R /\ b :e R /\ x :e open_interval a b /\ open_interval a b c= U /\ Rlt a x /\ Rlt x b.
Definition R_lower_limit_basis : set := \/_ a :e R , {halfopen_interval_left a b|b :e R}.
Definition R_lower_limit_topology : set := generated_topology R R_lower_limit_basis.
Axiom R_lower_limit_basis_is_basis_local : basis_on R R_lower_limit_basis.
Axiom R_lower_limit_topology_is_topology : topology_on R R_lower_limit_topology.
Axiom halfopen_interval_left_in_R_lower_limit_topology : forall a b : set , a :e R -> b :e R -> halfopen_interval_left a b :e R_lower_limit_topology.
Axiom open_interval_in_R_lower_limit_topology : forall a b : set , a :e R -> b :e R -> open_interval a b :e R_lower_limit_topology.
Axiom R_lower_limit_finer_than_R_standard : finer_than R_lower_limit_topology R_standard_topology.
Definition R_upper_limit_basis : set := \/_ a :e R , {halfopen_interval_right a b|b :e R}.
Axiom R_upper_limit_basis_is_basis_local : basis_on R R_upper_limit_basis.
Definition R_upper_limit_topology : set := generated_topology R R_upper_limit_basis.
Axiom R_upper_limit_topology_is_topology_local : topology_on R R_upper_limit_topology.
Definition inv_nat : set -> set := recip_SNo.
Axiom inv_nat_real : forall n : set , n :e omega -> inv_nat n :e R.
Axiom inv_nat_in_rational_numbers : forall n : set , n :e omega :\: {0} -> inv_nat n :e rational_numbers.
Definition K_set : set := {inv_nat n|n :e omega :\: {0}}.
Axiom K_set_Subq_rational_numbers : K_set c= rational_numbers.
Axiom zero_not_in_K_set : 0 /:e K_set.
Axiom one_in_K_set : 1 :e K_set.
Axiom not_in_K_set_implies_neq1 : forall x : set , ~ (x :e K_set) -> x <> 1.
Axiom inv_nat_not_in_open_interval_of_empty_cap_K_set : forall a b : set , open_interval a b :/\: K_set = Empty -> forall n : set , n :e omega :\: {0} -> ~ (inv_nat n :e open_interval a b).
Axiom K_set_Subq_R : K_set c= R.
Axiom inv_nat_pos : forall n : set , n :e omega :\: {0} -> Rlt 0 (inv_nat n).
Definition R_K_basis : set := \/_ a :e R , {open_interval a b :\: K_set|b :e R}.
Definition R_K_topology : set := generated_topology R (R_standard_basis :\/: R_K_basis).
Axiom R_standard_plus_K_basis_is_basis_local : basis_on R (R_standard_basis :\/: R_K_basis).
Axiom R_K_topology_is_topology_local : topology_on R R_K_topology.
Axiom R_lower_limit_strictly_finer_than_R_standard : strictly_finer_than_topology R R_lower_limit_topology R_standard_topology.
Axiom R_K_strictly_finer_than_R_standard : strictly_finer_than_topology R R_K_topology R_standard_topology.
Axiom K_set_meets_lower_limit_neighborhood_0 : forall a b : set , a :e R -> b :e R -> ~ (Rlt 0 a) -> Rlt 0 b -> exists y : set , y :e halfopen_interval_left a b /\ y :e K_set.
Axiom ex13_6_Rl_RK_not_comparable : ~ finer_than R_lower_limit_topology R_K_topology /\ ~ finer_than R_K_topology R_lower_limit_topology.
Axiom Lemma13_4_Rl_RK_relation : strictly_finer_than_topology R R_lower_limit_topology R_standard_topology /\ strictly_finer_than_topology R R_K_topology R_standard_topology /\ ~ comparable_topologies R_lower_limit_topology R_K_topology.
Definition R_finite_complement_topology : set := finite_complement_topology R.
Definition R_ray_topology : set := {U :e Power R|U = Empty \/ U = R \/ (exists a :e R , U = {x :e R|Rlt x a})}.
Axiom open_ray_in_R_standard_topology : forall a : set , a :e R -> {x :e R|Rlt a x} :e R_standard_topology.
Axiom open_left_ray_in_R_standard_topology : forall b : set , b :e R -> {x :e R|Rlt x b} :e R_standard_topology.
Axiom binunion_in_R_standard_topology : forall U V : set , U :e R_standard_topology -> V :e R_standard_topology -> U :\/: V :e R_standard_topology.
Axiom R_minus_singleton_eq_rays_union : forall a : set , a :e R -> R :\: {a,a} = {x :e R|Rlt x a} :\/: {x :e R|Rlt a x}.
Axiom R_minus_singleton_in_R_standard_topology : forall a : set , a :e R -> R :\: {a,a} :e R_standard_topology.
Axiom setminus_binunion_eq_binintersect : forall X A B : set , X :\: (A :\/: B) = (X :\: A) :/\: (X :\: B).
Axiom setminus_binintersect_eq_binunion : forall X A B : set , X :\: (A :/\: B) = (X :\: A) :\/: (X :\: B).
Axiom setminus_setminus_eq : forall X U : set , U c= X -> X :\: (X :\: U) = U.
Axiom binintersect_closed : forall X T C D : set , closed_in X T C -> closed_in X T D -> closed_in X T (C :/\: D).
Axiom binunion_closed : forall X T C D : set , closed_in X T C -> closed_in X T D -> closed_in X T (C :\/: D).
Axiom Sing_eq_UPair : forall x : set , {x} = {x,x}.
Axiom finite_complement_open_in_R_standard_topology : forall F : set , finite F -> F c= R -> R :\: F :e R_standard_topology.
Axiom ex13_7_R_topology_containments : finer_than R_upper_limit_topology R_standard_topology /\ finer_than R_K_topology R_standard_topology /\ finer_than R_standard_topology R_finite_complement_topology /\ finer_than R_standard_topology R_ray_topology.
Definition rational_open_intervals_basis : set := \/_ q1 :e rational_numbers , {open_interval q1 q2|q2 :e rational_numbers}.
Axiom rational_open_intervals_basis_Subq_R_standard_basis : rational_open_intervals_basis c= R_standard_basis.
Axiom rational_dense_between_reals : forall a b : set , a :e R -> b :e R -> Rlt a b -> exists q :e rational_numbers , Rlt a q /\ Rlt q b.
Axiom rational_interval_refines_real_interval : forall a b x : set , a :e R -> b :e R -> x :e R -> x :e open_interval a b -> exists q1 :e rational_numbers , exists q2 :e rational_numbers , x :e open_interval q1 q2 /\ open_interval q1 q2 c= open_interval a b.
Axiom ex13_8a_rational_intervals_basis_standard : basis_on R rational_open_intervals_basis /\ generated_topology R rational_open_intervals_basis = R_standard_topology.
Definition rational_halfopen_intervals_basis : set := \/_ q1 :e rational_numbers , {halfopen_interval_left q1 q2|q2 :e rational_numbers}.
Axiom ex13_8b_halfopen_rational_basis_topology : basis_on R rational_halfopen_intervals_basis /\ generated_topology R rational_halfopen_intervals_basis <> R_lower_limit_topology.
Definition order_rel : set -> set -> set -> prop := fun X a b => (X = R /\ Rlt a b) \/ (X = rational_numbers /\ Rlt a b) \/ (X = omega /\ a :e b) \/ (X = omega :\: {0} /\ a :e b) \/ (X = setprod 2 omega /\ exists i m j n : set , (i :e 2 /\ m :e omega /\ j :e 2 /\ n :e omega /\ a = (i,m) /\ b = (j,n) /\ (i :e j \/ (i = j /\ m :e n)))) \/ (X = setprod R R /\ exists a1 a2 b1 b2 : set , a = (a1,a2) /\ b = (b1,b2) /\ (Rlt a1 b1 \/ (a1 = b1 /\ Rlt a2 b2))) \/ (ordinal X /\ X <> R /\ X <> rational_numbers /\ X <> setprod 2 omega /\ X <> setprod R R /\ a :e b).
Definition simply_ordered_set : set -> prop := fun X => X = R \/ X = rational_numbers \/ X = omega \/ X = omega :\: {0} \/ X = setprod 2 omega \/ X = setprod R R \/ ordinal X.
Axiom simply_ordered_set_R : simply_ordered_set R.
Axiom order_rel_setprod_2_omega_00_10 : order_rel (setprod 2 omega) (0,0) (1,0).
Axiom order_rel_setprod_2_omega_00_1n : forall n : set , n :e omega -> order_rel (setprod 2 omega) (0,0) (1,n).
Axiom order_rel_setprod_2_omega_0k_1n : forall k n : set , k :e omega -> n :e omega -> order_rel (setprod 2 omega) (0,k) (1,n).
Axiom order_rel_setprod_2_omega_0k_0succk : forall k : set , k :e omega -> order_rel (setprod 2 omega) (0,k) (0,ordsucc k).
Axiom eps_1_not_in_2 : eps_ 1 /:e 2.
Axiom setprod_R_R_neq_setprod_2_omega : setprod R R <> setprod 2 omega.
Definition tag_topology : set -> set := fun y => SetAdjoin y {1}.
Postfix ' 100 := tag_topology.
Axiom Sing1_not_SNo : ~ SNo {1}.
Axiom Inj1_0_eq_1 : Inj1 0 = 1.
Axiom tuple_0_1_eq_Sing1 : (0,1) = {1}.
Axiom setprod_R_R_neq_R : setprod R R <> R.
Axiom setprod_R_R_neq_rational_numbers : setprod R R <> rational_numbers.
Axiom R_neq_omega : R <> omega.
Axiom R_neq_omega_nonzero : R <> (omega :\: {0}).
Axiom R_neq_rational_numbers : R <> rational_numbers.
Axiom R_neq_setprod_2_omega : R <> setprod 2 omega.
Axiom Rlt_implies_order_rel_R : forall a b : set , Rlt a b -> order_rel R a b.
Axiom order_rel_R_implies_Rlt : forall a b : set , order_rel R a b -> Rlt a b.
Axiom Rlt_implies_order_rel_Q : forall a b : set , Rlt a b -> order_rel rational_numbers a b.
Axiom mem_implies_order_rel_omega : forall a b : set , a :e b -> order_rel omega a b.
Axiom order_rel_omega_implies_mem : forall a b : set , order_rel omega a b -> a :e b.
Axiom order_rel_omega_nonzero_implies_mem : forall a b : set , order_rel (omega :\: {0}) a b -> a :e b.
Axiom mem_implies_order_rel_omega_nonzero : forall a b : set , a :e b -> order_rel (omega :\: {0}) a b.
Axiom omega_nonzero_neq_omega : (omega :\: {0}) <> omega.
Axiom order_rel_setprod_2_omega_intro : forall i m j n : set , i :e 2 -> m :e omega -> j :e 2 -> n :e omega -> (i :e j \/ (i = j /\ m :e n)) -> order_rel (setprod 2 omega) (i,m) (j,n).
Axiom order_rel_trichotomy_or_impred : forall X a b : set , simply_ordered_set X -> a :e X -> b :e X -> forall p : prop , (order_rel X a b -> p) -> (a = b -> p) -> (order_rel X b a -> p) -> p.
Axiom order_rel_trans : forall X a b c : set , simply_ordered_set X -> a :e X -> b :e X -> c :e X -> order_rel X a b -> order_rel X b c -> order_rel X a c.
Axiom order_rel_irref : forall X x : set , ~ (order_rel X x x).
Definition order_topology_basis : set -> set := fun X => (({I :e Power X|exists a :e X , exists b :e X , I = {x :e X|order_rel X a x /\ order_rel X x b}} :\/: {I :e Power X|exists b :e X , I = {x :e X|order_rel X x b}} :\/: {I :e Power X|exists a :e X , I = {x :e X|order_rel X a x}}) :\/: {X}).
Axiom order_topology_basis_cases : forall X I : set , I :e order_topology_basis X -> (exists a :e X , exists b :e X , I = {x :e X|order_rel X a x /\ order_rel X x b}) \/ (exists b :e X , I = {x :e X|order_rel X x b}) \/ (exists a :e X , I = {x :e X|order_rel X a x}) \/ I = X.
Axiom order_topology_basis_between : forall X I y1 y2 z : set , simply_ordered_set X -> I :e order_topology_basis X -> y1 :e I -> y2 :e I -> z :e X -> order_rel X y1 z -> order_rel X z y2 -> z :e I.
Axiom order_topology_interval_refine : forall X a1 b1x a2 b2x b1 b2 x : set , simply_ordered_set X -> a1 :e X -> b1x :e X -> a2 :e X -> b2x :e X -> b1 = {x0 :e X|order_rel X a1 x0 /\ order_rel X x0 b1x} -> b2 = {x0 :e X|order_rel X a2 x0 /\ order_rel X x0 b2x} -> x :e b1 -> x :e b2 -> exists b3 :e (order_topology_basis X) , x :e b3 /\ b3 c= b1 :/\: b2.
Definition is_least_element : set -> set -> prop := fun X a0 => a0 :e X /\ forall x : set , x :e X -> ~ (order_rel X x a0).
Definition is_largest_element : set -> set -> prop := fun X b0 => b0 :e X /\ forall x : set , x :e X -> ~ (order_rel X b0 x).
Definition order_topology_basis_tex : set -> set := fun X => ({I :e Power X|exists a :e X , exists b :e X , order_rel X a b /\ I = {x :e X|order_rel X a x /\ order_rel X x b}} :\/: {I :e Power X|exists a0 b : set , is_least_element X a0 /\ b :e X /\ order_rel X a0 b /\ I = {x :e X|(x = a0 \/ order_rel X a0 x) /\ order_rel X x b}} :\/: {I :e Power X|exists b0 a : set , is_largest_element X b0 /\ a :e X /\ order_rel X a b0 /\ I = {x :e X|order_rel X a x /\ (x = b0 \/ order_rel X x b0)}}).
Definition order_topology : set -> set := fun X => generated_topology X (order_topology_basis X).
Axiom order_topology_basis_is_basis : forall X : set , simply_ordered_set X -> basis_on X (order_topology_basis X).
Axiom order_topology_is_topology : forall X : set , simply_ordered_set X -> topology_on X (order_topology X).
Definition open_ray_upper : set -> set -> set := fun X a => {x :e X|order_rel X a x}.
Definition open_ray_lower : set -> set -> set := fun X a => {x :e X|order_rel X x a}.
Definition open_rays_subbasis : set -> set := fun X => (({I :e Power X|exists a :e X , I = open_ray_upper X a} :\/: {I :e Power X|exists b :e X , I = open_ray_lower X b}) :\/: {X}).
Axiom open_rays_subbasis_sub_Power : forall X : set , open_rays_subbasis X c= Power X.
Axiom open_rays_subbasis_is_subbasis : forall X : set , subbasis_on X (open_rays_subbasis X).
Axiom open_ray_upper_in_order_topology_basis : forall X a : set , a :e X -> open_ray_upper X a :e order_topology_basis X.
Axiom open_ray_lower_in_order_topology_basis : forall X b : set , b :e X -> open_ray_lower X b :e order_topology_basis X.
Axiom order_topology_basis_covers_omega : forall x : set , x :e omega -> exists b :e (order_topology_basis omega) , x :e b.
Axiom open_ray_lower_omega_1_eq_Sing0 : open_ray_lower omega 1 = {0}.
Axiom singleton_in_order_topology_basis_omega : forall x : set , x :e omega -> {x} :e order_topology_basis omega.
Axiom order_topology_basis_omega_is_basis : basis_on omega (order_topology_basis omega).
Axiom order_topology_omega_is_topology : topology_on omega (order_topology omega).
Axiom open_rays_subbasis_sub_order_topology : forall X : set , simply_ordered_set X -> open_rays_subbasis X c= order_topology X.
Axiom subbasis_elem_open_in_generated_from_subbasis : forall X S s : set , subbasis_on X S -> s :e S -> s :e generated_topology_from_subbasis X S.
Axiom open_ray_upper_in_open_rays_subbasis : forall X a : set , a :e X -> open_ray_upper X a :e open_rays_subbasis X.
Axiom open_ray_lower_in_open_rays_subbasis : forall X b : set , b :e X -> open_ray_lower X b :e open_rays_subbasis X.
Axiom open_interval_eq_rays_intersection : forall X a b : set , {x :e X|order_rel X a x /\ order_rel X x b} = (open_ray_upper X a) :/\: (open_ray_lower X b).
Axiom order_topology_basis_sub_generated_from_open_rays : forall X : set , order_topology_basis X c= generated_topology_from_subbasis X (open_rays_subbasis X).
Axiom open_rays_subbasis_for_order_topology : forall X : set , simply_ordered_set X -> generated_topology_from_subbasis X (open_rays_subbasis X) = order_topology X.
Axiom R_standard_basis_is_basis : basis_on R R_standard_basis.
Axiom R_standard_topology_is_topology : topology_on R R_standard_topology.
Axiom open_interval_in_order_topology_basis_R : forall a b : set , a :e R -> b :e R -> open_interval a b :e order_topology_basis R.
Axiom order_topology_basis_R_refines_standard_basis : forall b :e order_topology_basis R , forall x : set , x :e b -> exists I :e R_standard_basis , x :e I /\ I c= b.
Axiom standard_topology_is_order_topology : order_topology R = R_standard_topology.
Axiom order_topology_R_is_topology : topology_on R (order_topology R).
Axiom order_topology_basis_R_is_basis : basis_on R (order_topology_basis R).
Axiom open_rays_subbasis_sub_order_topology_R : open_rays_subbasis R c= order_topology R.
Axiom open_rays_subbasis_for_order_topology_R : generated_topology_from_subbasis R (open_rays_subbasis R) = order_topology R.
Definition R2_dictionary_order_topology : set := generated_topology_from_subbasis (setprod R R) (open_rays_subbasis (setprod R R)).
Axiom dictionary_order_topology_is_topology : topology_on (setprod R R) R2_dictionary_order_topology.
Axiom rectangles_basis_for_R2 : exists B : set , basis_on (setprod R R) B /\ generated_topology (setprod R R) B = R2_dictionary_order_topology.
Definition Zplus : set := omega :\: {0}.
