            B Tb
            B' Tb'
            U U'
            HtopB
            HtopB'
            HUsubB
            HU'subB').
        }
        set fReq := graph (setprod (w 0) (w 1))
          (fun x:set => apply_fun (product_of_maps E E' p p') x).
        set f1 := compose_fun
          (setprod (w 0) (w 1))
          (projection_map1 (w 0) (w 1))
