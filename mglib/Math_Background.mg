      apply_fun xcoord y = apply_fun y i.
    {
      rewrite (compose_fun_apply
        dom
        inclNz
        (graph (euclidean_space (ordsucc n)) (fun y0:set => apply_fun y0 i))
        y
        Hy).
      rewrite (apply_fun_graph
        dom
        (fun y0:set => y0)
        y
        Hy).
      rewrite (apply_fun_graph
        (euclidean_space (ordsucc n))
        (fun y0:set => apply_fun y0 i)
