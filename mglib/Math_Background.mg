  apply_fun (reverse_path f) t = apply_fun f (add_SNo 1 (minus_SNo t)).
let f t.
assume Ht.
rewrite (reverse_path_apply f t Ht).
rewrite (flip_unit_interval_apply t Ht).
exact (fun P H => H).
Qed.

(** Proven Bob **)
