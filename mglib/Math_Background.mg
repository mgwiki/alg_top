	        Hp0S).
	      rewrite (mul_SNo_minus_minus
	        (p 1)
	        (p 1)
	        Hp1S
	        Hp1S).
	      reflexivity.
	    }
    rewrite HargEq.
    rewrite (apply_fun_graph
      R2_minus_origin
      (fun q:set =>
        (div_SNo (q 0)
          (sqrt_SNo_nonneg
            (add_SNo (mul_SNo (q 0) (q 0))
