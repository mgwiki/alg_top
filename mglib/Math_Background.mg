claim Hleft3 :
  ((apply_fun Ft q :e Vq /\ apply_fun Ft z :e Vz) /\ Vq :e slices).
{
  exact (andEL
    ((apply_fun Ft q :e Vq /\ apply_fun Ft z :e Vz) /\ Vq :e slices)
    (Vz :e slices)
    Hleft4).
}
claim Hpair :
  (apply_fun Ft q :e Vq /\ apply_fun Ft z :e Vz).
{
  exact (andEL
    (apply_fun Ft q :e Vq /\ apply_fun Ft z :e Vz)
    (Vq :e slices)
    Hleft3).
}
claim HFtqVq : apply_fun Ft q :e Vq.
{
  exact (andEL
    (apply_fun Ft q :e Vq)
    (apply_fun Ft z :e Vz)
