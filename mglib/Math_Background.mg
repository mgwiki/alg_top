    n
    (fun j:set => apply_fun v j)
    i
    Hi).
  reflexivity.
}
claim HnormDef :
  euclidean_norm_sq (ordsucc n) v =
  finite_real_sum
    (fun i:set => mul_SNo (apply_fun v i) (apply_fun v i))
    (ordsucc n).
{
  reflexivity.
}
rewrite HnormDef.
rewrite (finite_real_sum_S
  (fun i:set => mul_SNo (apply_fun v i) (apply_fun v i))
  n
  Hn).
rewrite <- HfirstNorm.
rewrite HlastEq.
