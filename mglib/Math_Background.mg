												              }
												              claim Hxe : apply_fun xs12 t = eG.
												              { exact (free_product_binary_factors_intersect_trivial G multG eG invG G1 G2 (apply_fun xs12 t) Hfp Hxs12tG1 Hx1G2). }
												              exact (FalseE (Hxs12t_ne' Hxe) (beta = 0)).
