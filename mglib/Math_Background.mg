      cls =
    apply_fun
      (graph (fundamental_group S1 S1_topology S1_basepoint)
        (fun c:set => group_power_nat (fundamental_group_mult S1 S1_topology S1_basepoint)
          (fundamental_group_id S1 S1_topology S1_basepoint) c n))
      cls.
admit.
