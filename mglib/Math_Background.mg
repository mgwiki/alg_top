      (UPairI2 0 1)).
    exact (If_i_0 (1 = 0) G1 G2 neq_1_0).
  }
  rewrite <- Heq1.
  exact (local_subgroup_group_structure
    G
    multG
    eG
    invG
    (apply_fun (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2)) 1)
    HgrpG
