  (winding_number f a, 0) =
  complex_mult_R2
    (complex_reciprocal (0, mul_SNo 2 pi_real))
    (complex_line_integral
      (graph (setprod R R)
        (fun z:set => complex_reciprocal (R2_sub z a)))
      f).
admit.
