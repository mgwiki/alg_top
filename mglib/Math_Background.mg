		                    claim Hhhifam_eval :
		                      apply_fun hhifam t = apply_fun h (apply_fun hifam t).
		                    { exact (compose_fun_apply int hifam h t HtInt). }
		                    claim Hhpow_t :
		                      apply_fun h (apply_fun hifam t) =
		                      group_power_nat multG eG (apply_fun h (apply_fun basis2 alpha)) t.
		                    {
