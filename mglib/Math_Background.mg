Lemma constant_path_lift_at_one : forall E Te B Tb p e0 b0 ft:set,
  covering_map E Te B Tb p ->
  e0 :e E ->
  b0 :e B ->
  apply_fun p e0 = b0 ->
  lifting_of unit_interval unit_interval_topology E Te B Tb p (constant_path b0) ft ->
  apply_fun ft 0 = e0 ->
