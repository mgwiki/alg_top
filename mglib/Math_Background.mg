{
  exact (andER
    (function_on r B2 B2 /\ continuous_map B2 B2_topology B2 B2_topology r)
    (forall x:set, x :e B2 -> apply_fun r x :e A)
    (andEL
      ((function_on r B2 B2 /\ continuous_map B2 B2_topology B2 B2_topology r) /\
        (forall x:set, x :e B2 -> apply_fun r x :e A))
      (forall x:set, x :e A -> apply_fun r x = x)
      HrPack)).
}
claim HrFixA : forall x:set, x :e A -> apply_fun r x = x.
{
  exact (andER
    ((function_on r B2 B2 /\ continuous_map B2 B2_topology B2 B2_topology r) /\
      (forall x:set, x :e B2 -> apply_fun r x :e A))
    (forall x:set, x :e A -> apply_fun r x = x)
    HrPack).
}
