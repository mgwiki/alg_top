                    claim Hei_in : apply_fun e_bij i :e supp f. { exact (Hei_supp i Hi). }
                    claim Hal_in : alpha :e supp f. { exact (eq_subst_mem alpha (apply_fun e_bij i) (supp f) Heq Hei_in). }
                    exact (Halpha_nsupp Hal_in). }
                  claim Hif_val : (if alpha = apply_fun e_bij i then f (apply_fun e_bij i) else ea alpha) = ea alpha.
                  { exact (If_i_0 (alpha = apply_fun e_bij i) (f (apply_fun e_bij i)) (ea alpha) Hei_ne). }
                  prove (apply_fun my_xs i) alpha = ea alpha.
                  rewrite Heq_coord. exact Hif_val. }
                claim Hprod_id : nat_primrec (ea alpha)
                  (fun i r => apply_fun (ma alpha) (r, (apply_fun my_xs i) alpha)) n = ea alpha.
                { exact (product_all_id n Hnat_n alpha Hal
                    (fun i => (apply_fun my_xs i) alpha) Hvals_all_id). }
                prove f alpha = (nat_primrec eG (fun i r => apply_fun multG (r, apply_fun my_xs i)) n) alpha.
                rewrite Hpw. rewrite Hprod_id. exact Hf_ea.
  + (** uniqueness: two representations have matching contributions at each alpha **)
    let x. assume Hx : x :e G.
    let n1 n2. assume Hn1O : n1 :e omega. assume Hn2O : n2 :e omega.
    let a1 a2. assume Ha1 : function_on a1 n1 J. assume Ha2 : function_on a2 n2 J.
    let x1 x2. assume Hx1fn : function_on x1 n1 G. assume Hx2fn : function_on x2 n2 G.
    assume Hx1Gi : forall i:set, i :e n1 -> apply_fun x1 i :e apply_fun Gimages (apply_fun a1 i).
    assume Hx2Gi : forall i:set, i :e n2 -> apply_fun x2 i :e apply_fun Gimages (apply_fun a2 i).
    assume Ha1inj : forall i j:set, i :e n1 -> j :e n1 -> i <> j -> apply_fun a1 i <> apply_fun a1 j.
    assume Ha2inj : forall i j:set, i :e n2 -> j :e n2 -> i <> j -> apply_fun a2 i <> apply_fun a2 j.
    assume Hx_eq1 : x = nat_primrec eG (fun i r => apply_fun multG (r, apply_fun x1 i)) n1.
    assume Hx_eq2 : x = nat_primrec eG (fun i r => apply_fun multG (r, apply_fun x2 i)) n2.
    claim Hnat1 : nat_p n1. { exact (omega_nat_p n1 Hn1O). }
    claim Hnat2 : nat_p n2. { exact (omega_nat_p n2 Hn2O). }
    (** Key: elements of Gimages(alpha) have coordinate structure from ifam **)
    claim Hx1_coord : forall i:set, i :e n1 -> forall gamma:set, gamma :e J ->
      (apply_fun x1 i) gamma = (if gamma = apply_fun a1 i then (apply_fun x1 i) (apply_fun a1 i) else ea gamma).
    { let i. assume Hi : i :e n1.
      claim Hai_J : apply_fun a1 i :e J. { exact (Ha1 i Hi). }
      claim Hx1_Gi : apply_fun x1 i :e apply_fun Gimages (apply_fun a1 i). { exact (Hx1Gi i Hi). }
      (** x1 i :e {apply_fun (apply_fun ifam (a1 i)) z | z :e Ga (a1 i)} **)
      claim HGim1_eq : apply_fun Gimages (apply_fun a1 i) = homomorphism_image (Ga (apply_fun a1 i)) (apply_fun ifam (apply_fun a1 i)).
      { exact (Gimages_eval (apply_fun a1 i) Hai_J). }
      claim Hx1_Repl : apply_fun x1 i :e homomorphism_image (Ga (apply_fun a1 i)) (apply_fun ifam (apply_fun a1 i)).
      { rewrite <- HGim1_eq. exact Hx1_Gi. }
      apply (ReplE_impred (Ga (apply_fun a1 i))
        (fun z => apply_fun (apply_fun ifam (apply_fun a1 i)) z) (apply_fun x1 i) Hx1_Repl).
      let z. assume Hz : z :e Ga (apply_fun a1 i).
      assume Hx1_eq : apply_fun x1 i = apply_fun (apply_fun ifam (apply_fun a1 i)) z.
      let gamma. assume Hg : gamma :e J.
      rewrite Hx1_eq.
      claim Hcoord : (apply_fun (apply_fun ifam (apply_fun a1 i)) z) gamma =
        (if gamma = apply_fun a1 i then z else ea gamma).
      { exact (ifam_x_coord (apply_fun a1 i) Hai_J z Hz gamma Hg). }
      rewrite Hcoord.
      (** Need: (if gamma = a1 i then z else ea gamma) =
               (if gamma = a1 i then (apply_fun (apply_fun ifam (a1 i)) z)(a1 i) else ea gamma) **)
      apply (xm (gamma = apply_fun a1 i)).
      - assume Heq : gamma = apply_fun a1 i.
        rewrite (If_i_1 (gamma = apply_fun a1 i) z (ea gamma) Heq).
        rewrite (If_i_1 (gamma = apply_fun a1 i)
          ((apply_fun (apply_fun ifam (apply_fun a1 i)) z) (apply_fun a1 i)) (ea gamma) Heq).
        (** z = (apply_fun (apply_fun ifam (a1 i)) z)(a1 i) **)
        claim Hval : (apply_fun (apply_fun ifam (apply_fun a1 i)) z) (apply_fun a1 i) = z.
        { claim Hc2 : (apply_fun (apply_fun ifam (apply_fun a1 i)) z) (apply_fun a1 i) =
            (if apply_fun a1 i = apply_fun a1 i then z else ea (apply_fun a1 i)).
          { exact (ifam_x_coord (apply_fun a1 i) Hai_J z Hz (apply_fun a1 i) Hai_J). }
          rewrite Hc2.
          claim Hrefl : apply_fun a1 i = apply_fun a1 i. { reflexivity. }
          exact (If_i_1 (apply_fun a1 i = apply_fun a1 i) z (ea (apply_fun a1 i)) Hrefl). }
        symmetry. exact Hval.
      - assume Hne : gamma <> apply_fun a1 i.
        rewrite (If_i_0 (gamma = apply_fun a1 i) z (ea gamma) Hne).
        rewrite (If_i_0 (gamma = apply_fun a1 i)
          ((apply_fun (apply_fun ifam (apply_fun a1 i)) z) (apply_fun a1 i)) (ea gamma) Hne).
        reflexivity.
    }
    claim Hx2_coord : forall i:set, i :e n2 -> forall gamma:set, gamma :e J ->
      (apply_fun x2 i) gamma = (if gamma = apply_fun a2 i then (apply_fun x2 i) (apply_fun a2 i) else ea gamma).
    { let i. assume Hi : i :e n2.
      claim Hai_J : apply_fun a2 i :e J. { exact (Ha2 i Hi). }
      claim Hx2_Gi : apply_fun x2 i :e apply_fun Gimages (apply_fun a2 i). { exact (Hx2Gi i Hi). }
      claim HGim2_eq : apply_fun Gimages (apply_fun a2 i) = homomorphism_image (Ga (apply_fun a2 i)) (apply_fun ifam (apply_fun a2 i)).
      { exact (Gimages_eval (apply_fun a2 i) Hai_J). }
      claim Hx2_Repl : apply_fun x2 i :e homomorphism_image (Ga (apply_fun a2 i)) (apply_fun ifam (apply_fun a2 i)).
      { rewrite <- HGim2_eq. exact Hx2_Gi. }
      apply (ReplE_impred (Ga (apply_fun a2 i))
        (fun z => apply_fun (apply_fun ifam (apply_fun a2 i)) z) (apply_fun x2 i) Hx2_Repl).
      let z. assume Hz : z :e Ga (apply_fun a2 i).
      assume Hx2_eq : apply_fun x2 i = apply_fun (apply_fun ifam (apply_fun a2 i)) z.
      let gamma. assume Hg : gamma :e J.
      rewrite Hx2_eq.
      claim Hcoord : (apply_fun (apply_fun ifam (apply_fun a2 i)) z) gamma =
        (if gamma = apply_fun a2 i then z else ea gamma).
      { exact (ifam_x_coord (apply_fun a2 i) Hai_J z Hz gamma Hg). }
      rewrite Hcoord.
      apply (xm (gamma = apply_fun a2 i)).
      - assume Heq : gamma = apply_fun a2 i.
        rewrite (If_i_1 (gamma = apply_fun a2 i) z (ea gamma) Heq).
        rewrite (If_i_1 (gamma = apply_fun a2 i)
          ((apply_fun (apply_fun ifam (apply_fun a2 i)) z) (apply_fun a2 i)) (ea gamma) Heq).
        claim Hval : (apply_fun (apply_fun ifam (apply_fun a2 i)) z) (apply_fun a2 i) = z.
        { claim Hc2 : (apply_fun (apply_fun ifam (apply_fun a2 i)) z) (apply_fun a2 i) =
            (if apply_fun a2 i = apply_fun a2 i then z else ea (apply_fun a2 i)).
          { exact (ifam_x_coord (apply_fun a2 i) Hai_J z Hz (apply_fun a2 i) Hai_J). }
          rewrite Hc2.
          claim Hrefl : apply_fun a2 i = apply_fun a2 i. { reflexivity. }
          exact (If_i_1 (apply_fun a2 i = apply_fun a2 i) z (ea (apply_fun a2 i)) Hrefl). }
        symmetry. exact Hval.
      - assume Hne : gamma <> apply_fun a2 i.
        rewrite (If_i_0 (gamma = apply_fun a2 i) z (ea gamma) Hne).
        rewrite (If_i_0 (gamma = apply_fun a2 i)
          ((apply_fun (apply_fun ifam (apply_fun a2 i)) z) (apply_fun a2 i)) (ea gamma) Hne).
        reflexivity.
    }
    (** Pointwise product at each alpha - using guarded If_i for unguarded membership **)
    claim Hpw1 : forall alpha:set, alpha :e J ->
      x alpha = nat_primrec (ea alpha) (fun i r => apply_fun (ma alpha) (r, (apply_fun x1 i) alpha)) n1.
    { let alpha. assume Hal : alpha :e J.
      set x1g := fun i:set => If_i (i :e n1) (apply_fun x1 i) eG.
      claim Hx1g_G : forall i:set, x1g i :e G.
      { let i. apply (xm (i :e n1)).
        - assume Hi : i :e n1.
          prove If_i (i :e n1) (apply_fun x1 i) eG :e G.
          rewrite (If_i_1 (i :e n1) (apply_fun x1 i) eG Hi). exact (Hx1fn i Hi).
        - assume Hni : i :e n1 -> False.
          prove If_i (i :e n1) (apply_fun x1 i) eG :e G.
          rewrite (If_i_0 (i :e n1) (apply_fun x1 i) eG Hni). exact HeG_G. }
      claim Heval_g : (nat_primrec eG (fun i r => apply_fun multG (r, x1g i)) n1) alpha =
        nat_primrec (ea alpha) (fun i r => apply_fun (ma alpha) (r, (x1g i) alpha)) n1.
      { exact (pointwise_nat_primrec n1 Hnat1 x1g Hx1g_G alpha Hal). }
      claim Hext_G : nat_primrec eG (fun i r => apply_fun multG (r, apply_fun x1 i)) n1 =
        nat_primrec eG (fun i r => apply_fun multG (r, x1g i)) n1.
      { apply (nat_primrec_ext eG
          (fun i r:set => apply_fun multG (r, apply_fun x1 i))
          (fun i r:set => apply_fun multG (r, x1g i)) n1 Hn1O).
        let i r. assume Hi : i :e n1.
        prove apply_fun multG (r, apply_fun x1 i) = apply_fun multG (r, x1g i).
        prove apply_fun multG (r, apply_fun x1 i) = apply_fun multG (r, If_i (i :e n1) (apply_fun x1 i) eG).
        rewrite (If_i_1 (i :e n1) (apply_fun x1 i) eG Hi). reflexivity. }
      claim Hext_a : nat_primrec (ea alpha) (fun i r => apply_fun (ma alpha) (r, (x1g i) alpha)) n1 =
        nat_primrec (ea alpha) (fun i r => apply_fun (ma alpha) (r, (apply_fun x1 i) alpha)) n1.
      { apply (nat_primrec_ext (ea alpha)
          (fun i r:set => apply_fun (ma alpha) (r, (x1g i) alpha))
          (fun i r:set => apply_fun (ma alpha) (r, (apply_fun x1 i) alpha)) n1 Hn1O).
        let i r. assume Hi : i :e n1.
        prove apply_fun (ma alpha) (r, (x1g i) alpha) = apply_fun (ma alpha) (r, (apply_fun x1 i) alpha).
        prove apply_fun (ma alpha) (r, (If_i (i :e n1) (apply_fun x1 i) eG) alpha) = apply_fun (ma alpha) (r, (apply_fun x1 i) alpha).
        rewrite (If_i_1 (i :e n1) (apply_fun x1 i) eG Hi). reflexivity. }
      prove x alpha = nat_primrec (ea alpha) (fun i r => apply_fun (ma alpha) (r, (apply_fun x1 i) alpha)) n1.
      rewrite Hx_eq1. rewrite Hext_G. rewrite Heval_g. exact Hext_a. }
    claim Hpw2 : forall alpha:set, alpha :e J ->
      x alpha = nat_primrec (ea alpha) (fun i r => apply_fun (ma alpha) (r, (apply_fun x2 i) alpha)) n2.
    { let alpha. assume Hal : alpha :e J.
      set x2g := fun i:set => If_i (i :e n2) (apply_fun x2 i) eG.
      claim Hx2g_G : forall i:set, x2g i :e G.
      { let i. apply (xm (i :e n2)).
        - assume Hi : i :e n2.
          prove If_i (i :e n2) (apply_fun x2 i) eG :e G.
          rewrite (If_i_1 (i :e n2) (apply_fun x2 i) eG Hi). exact (Hx2fn i Hi).
        - assume Hni : i :e n2 -> False.
          prove If_i (i :e n2) (apply_fun x2 i) eG :e G.
          rewrite (If_i_0 (i :e n2) (apply_fun x2 i) eG Hni). exact HeG_G. }
      claim Heval_g : (nat_primrec eG (fun i r => apply_fun multG (r, x2g i)) n2) alpha =
        nat_primrec (ea alpha) (fun i r => apply_fun (ma alpha) (r, (x2g i) alpha)) n2.
      { exact (pointwise_nat_primrec n2 Hnat2 x2g Hx2g_G alpha Hal). }
      claim Hext_G : nat_primrec eG (fun i r => apply_fun multG (r, apply_fun x2 i)) n2 =
        nat_primrec eG (fun i r => apply_fun multG (r, x2g i)) n2.
      { apply (nat_primrec_ext eG
          (fun i r:set => apply_fun multG (r, apply_fun x2 i))
          (fun i r:set => apply_fun multG (r, x2g i)) n2 Hn2O).
        let i r. assume Hi : i :e n2.
        prove apply_fun multG (r, apply_fun x2 i) = apply_fun multG (r, x2g i).
        prove apply_fun multG (r, apply_fun x2 i) = apply_fun multG (r, If_i (i :e n2) (apply_fun x2 i) eG).
        rewrite (If_i_1 (i :e n2) (apply_fun x2 i) eG Hi). reflexivity. }
      claim Hext_a : nat_primrec (ea alpha) (fun i r => apply_fun (ma alpha) (r, (x2g i) alpha)) n2 =
        nat_primrec (ea alpha) (fun i r => apply_fun (ma alpha) (r, (apply_fun x2 i) alpha)) n2.
      { apply (nat_primrec_ext (ea alpha)
          (fun i r:set => apply_fun (ma alpha) (r, (x2g i) alpha))
          (fun i r:set => apply_fun (ma alpha) (r, (apply_fun x2 i) alpha)) n2 Hn2O).
        let i r. assume Hi : i :e n2.
        prove apply_fun (ma alpha) (r, (x2g i) alpha) = apply_fun (ma alpha) (r, (apply_fun x2 i) alpha).
        prove apply_fun (ma alpha) (r, (If_i (i :e n2) (apply_fun x2 i) eG) alpha) = apply_fun (ma alpha) (r, (apply_fun x2 i) alpha).
        rewrite (If_i_1 (i :e n2) (apply_fun x2 i) eG Hi). reflexivity. }
      prove x alpha = nat_primrec (ea alpha) (fun i r => apply_fun (ma alpha) (r, (apply_fun x2 i) alpha)) n2.
      rewrite Hx_eq2. rewrite Hext_G. rewrite Heval_g. exact Hext_a. }
    let alpha. assume Hal : alpha :e J.
    (** Membership in component group at alpha **)
    claim Hx1_Ga : forall i:set, i :e n1 -> (apply_fun x1 i) alpha :e Ga alpha.
    { let i. assume Hi. exact (HG_ap (apply_fun x1 i) (Hx1fn i Hi) alpha Hal). }
    claim Hx2_Ga : forall i:set, i :e n2 -> (apply_fun x2 i) alpha :e Ga alpha.
    { let i. assume Hi. exact (HG_ap (apply_fun x2 i) (Hx2fn i Hi) alpha Hal). }
    (** The three conjuncts: ((C1 /\ C2) /\ C3) **)
    apply andI.
    - apply andI.
      + (** C1: matching indices give equal elements **)
        let i j. assume Hi : i :e n1. assume Hj : j :e n2.
        assume Ha1i : apply_fun a1 i = alpha. assume Ha2j : apply_fun a2 j = alpha.
        claim Hx1_G : apply_fun x1 i :e G. { exact (Hx1fn i Hi). }
        claim Hx2_G : apply_fun x2 j :e G. { exact (Hx2fn j Hj). }
        (** Off-alpha coordinates are ea gamma **)
        claim Hx1_off : forall gamma:set, gamma :e J -> gamma <> alpha -> (apply_fun x1 i) gamma = ea gamma.
        { let gamma. assume Hg : gamma :e J. assume Hne : gamma <> alpha.
          claim Hev : (apply_fun x1 i) gamma = (if gamma = apply_fun a1 i then (apply_fun x1 i) (apply_fun a1 i) else ea gamma).
          { exact (Hx1_coord i Hi gamma Hg). }
          claim Hne2 : gamma <> apply_fun a1 i. { rewrite Ha1i. exact Hne. }
          rewrite Hev. exact (If_i_0 (gamma = apply_fun a1 i) ((apply_fun x1 i) (apply_fun a1 i)) (ea gamma) Hne2). }
        claim Hx2_off : forall gamma:set, gamma :e J -> gamma <> alpha -> (apply_fun x2 j) gamma = ea gamma.
        { let gamma. assume Hg : gamma :e J. assume Hne : gamma <> alpha.
          claim Hev : (apply_fun x2 j) gamma = (if gamma = apply_fun a2 j then (apply_fun x2 j) (apply_fun a2 j) else ea gamma).
          { exact (Hx2_coord j Hj gamma Hg). }
          claim Hne2 : gamma <> apply_fun a2 j. { rewrite Ha2j. exact Hne. }
          rewrite Hev. exact (If_i_0 (gamma = apply_fun a2 j) ((apply_fun x2 j) (apply_fun a2 j)) (ea gamma) Hne2). }
        (** Product1 at alpha = (x1 i) alpha, Product2 at alpha = (x2 j) alpha **)
        claim Hvals1_ne : forall k:set, k :e n1 -> k <> i -> (apply_fun x1 k) alpha = ea alpha.
        { let k. assume Hk : k :e n1. assume Hne : k <> i.
          claim Hne_ik : i <> k.
          { assume Heq_ik : i = k.
            claim Heq_ki : k = i. { symmetry. exact Heq_ik. }
            exact (Hne Heq_ki). }
          claim Hev : (apply_fun x1 k) alpha = (if alpha = apply_fun a1 k then (apply_fun x1 k) (apply_fun a1 k) else ea alpha).
          { exact (Hx1_coord k Hk alpha Hal). }
          claim Ha1k_ne : alpha <> apply_fun a1 k.
          { assume Heq : alpha = apply_fun a1 k.
            claim Heq2 : apply_fun a1 i = apply_fun a1 k. { rewrite Ha1i. exact Heq. }
            exact (Ha1inj i k Hi Hk Hne_ik Heq2). }
          rewrite Hev. exact (If_i_0 (alpha = apply_fun a1 k) ((apply_fun x1 k) (apply_fun a1 k)) (ea alpha) Ha1k_ne). }
        claim Hprod1 : nat_primrec (ea alpha)
          (fun k r => apply_fun (ma alpha) (r, (apply_fun x1 k) alpha)) n1 = (apply_fun x1 i) alpha.
        { exact (product_single_nonid n1 Hnat1 alpha Hal (fun k => (apply_fun x1 k) alpha) Hx1_Ga i Hi Hvals1_ne). }
        claim Hvals2_ne : forall k:set, k :e n2 -> k <> j -> (apply_fun x2 k) alpha = ea alpha.
        { let k. assume Hk : k :e n2. assume Hne : k <> j.
          claim Hne_jk : j <> k.
          { assume Heq_jk : j = k.
            claim Heq_kj : k = j. { symmetry. exact Heq_jk. }
            exact (Hne Heq_kj). }
          claim Hev : (apply_fun x2 k) alpha = (if alpha = apply_fun a2 k then (apply_fun x2 k) (apply_fun a2 k) else ea alpha).
          { exact (Hx2_coord k Hk alpha Hal). }
          claim Ha2k_ne : alpha <> apply_fun a2 k.
          { assume Heq : alpha = apply_fun a2 k.
            claim Heq2 : apply_fun a2 j = apply_fun a2 k. { rewrite Ha2j. exact Heq. }
            exact (Ha2inj j k Hj Hk Hne_jk Heq2). }
          rewrite Hev. exact (If_i_0 (alpha = apply_fun a2 k) ((apply_fun x2 k) (apply_fun a2 k)) (ea alpha) Ha2k_ne). }
        claim Hprod2 : nat_primrec (ea alpha)
          (fun k r => apply_fun (ma alpha) (r, (apply_fun x2 k) alpha)) n2 = (apply_fun x2 j) alpha.
        { exact (product_single_nonid n2 Hnat2 alpha Hal (fun k => (apply_fun x2 k) alpha) Hx2_Ga j Hj Hvals2_ne). }
        claim Hx1i_eq : (apply_fun x1 i) alpha = x alpha.
        { claim H : x alpha = (apply_fun x1 i) alpha. { rewrite (Hpw1 alpha Hal). exact Hprod1. }
          symmetry. exact H. }
        claim Hx2j_eq : (apply_fun x2 j) alpha = x alpha.
        { claim H : x alpha = (apply_fun x2 j) alpha. { rewrite (Hpw2 alpha Hal). exact Hprod2. }
          symmetry. exact H. }
        (** x1 i = x2 j by G_ext **)
        apply (G_ext (apply_fun x1 i) (apply_fun x2 j) Hx1_G Hx2_G).
        let gamma. assume Hg : gamma :e J.
        apply (xm (gamma = alpha)).
        * assume Heq : gamma = alpha.
          rewrite Heq. rewrite Hx1i_eq. symmetry. exact Hx2j_eq.
        * assume Hne : gamma <> alpha.
          rewrite (Hx1_off gamma Hg Hne). symmetry. exact (Hx2_off gamma Hg Hne).
      + (** C2: rep1 has alpha, rep2 doesn't => x1 i = eG **)
        assume Hex1 : exists i:set, i :e n1 /\ apply_fun a1 i = alpha.
        assume Hnex2 : ~(exists j:set, j :e n2 /\ apply_fun a2 j = alpha).
        let i. assume Hi : i :e n1. assume Ha1i : apply_fun a1 i = alpha.
        claim Hvals2_all_id : forall k:set, k :e n2 -> (apply_fun x2 k) alpha = ea alpha.
        { let k. assume Hk : k :e n2.
          claim Hev : (apply_fun x2 k) alpha = (if alpha = apply_fun a2 k then (apply_fun x2 k) (apply_fun a2 k) else ea alpha).
          { exact (Hx2_coord k Hk alpha Hal). }
          claim Ha2k_ne : alpha <> apply_fun a2 k.
          { assume Heq : alpha = apply_fun a2 k.
            claim Ha2k_eq : apply_fun a2 k = alpha. { symmetry. exact Heq. }
            claim Hex : exists j:set, j :e n2 /\ apply_fun a2 j = alpha.
            { witness k. apply andI. * exact Hk. * exact Ha2k_eq. }
            exact (Hnex2 Hex). }
          rewrite Hev. exact (If_i_0 (alpha = apply_fun a2 k) ((apply_fun x2 k) (apply_fun a2 k)) (ea alpha) Ha2k_ne). }
        claim Hprod2_id : nat_primrec (ea alpha)
          (fun k r => apply_fun (ma alpha) (r, (apply_fun x2 k) alpha)) n2 = ea alpha.
        { exact (product_all_id n2 Hnat2 alpha Hal (fun k => (apply_fun x2 k) alpha) Hvals2_all_id). }
        claim Hx_ea : x alpha = ea alpha. { rewrite (Hpw2 alpha Hal). exact Hprod2_id. }
        claim Hvals1_ne : forall k:set, k :e n1 -> k <> i -> (apply_fun x1 k) alpha = ea alpha.
        { let k. assume Hk : k :e n1. assume Hne : k <> i.
          claim Hne_ik : i <> k.
          { assume Heq_ik : i = k.
            claim Heq_ki : k = i. { symmetry. exact Heq_ik. }
            exact (Hne Heq_ki). }
          claim Hev : (apply_fun x1 k) alpha = (if alpha = apply_fun a1 k then (apply_fun x1 k) (apply_fun a1 k) else ea alpha).
          { exact (Hx1_coord k Hk alpha Hal). }
          claim Ha1k_ne : alpha <> apply_fun a1 k.
          { assume Heq : alpha = apply_fun a1 k.
            claim Heq2 : apply_fun a1 i = apply_fun a1 k. { rewrite Ha1i. exact Heq. }
            exact (Ha1inj i k Hi Hk Hne_ik Heq2). }
          rewrite Hev. exact (If_i_0 (alpha = apply_fun a1 k) ((apply_fun x1 k) (apply_fun a1 k)) (ea alpha) Ha1k_ne). }
        claim Hprod1_val : nat_primrec (ea alpha)
          (fun k r => apply_fun (ma alpha) (r, (apply_fun x1 k) alpha)) n1 = (apply_fun x1 i) alpha.
        { exact (product_single_nonid n1 Hnat1 alpha Hal (fun k => (apply_fun x1 k) alpha) Hx1_Ga i Hi Hvals1_ne). }
        claim Hx1i_alpha_ea : (apply_fun x1 i) alpha = ea alpha.
        { claim H : x alpha = (apply_fun x1 i) alpha. { rewrite (Hpw1 alpha Hal). exact Hprod1_val. }
          claim H2 : (apply_fun x1 i) alpha = x alpha. { symmetry. exact H. }
          rewrite H2. exact Hx_ea. }
        apply (G_ext (apply_fun x1 i) eG (Hx1fn i Hi) HeG_G).
        let gamma. assume Hg : gamma :e J.
        apply (xm (gamma = alpha)).
        * assume Heq : gamma = alpha.
          rewrite Heq. rewrite Hx1i_alpha_ea.
          symmetry. exact (beta J (fun alpha => ea alpha) alpha Hal).
        * assume Hne : gamma <> alpha.
          claim Hev : (apply_fun x1 i) gamma = (if gamma = apply_fun a1 i then (apply_fun x1 i) (apply_fun a1 i) else ea gamma).
          { exact (Hx1_coord i Hi gamma Hg). }
          claim Hne2 : gamma <> apply_fun a1 i. { rewrite Ha1i. exact Hne. }
          rewrite Hev. rewrite (If_i_0 (gamma = apply_fun a1 i) ((apply_fun x1 i) (apply_fun a1 i)) (ea gamma) Hne2).
          symmetry. exact (beta J (fun alpha => ea alpha) gamma Hg).
    - (** C3: rep2 has alpha, rep1 doesn't => x2 j = eG **)
      assume Hnex1 : ~(exists i:set, i :e n1 /\ apply_fun a1 i = alpha).
      assume Hex2 : exists j:set, j :e n2 /\ apply_fun a2 j = alpha.
      let j. assume Hj : j :e n2. assume Ha2j : apply_fun a2 j = alpha.
      claim Hvals1_all_id : forall k:set, k :e n1 -> (apply_fun x1 k) alpha = ea alpha.
      { let k. assume Hk : k :e n1.
        claim Hev : (apply_fun x1 k) alpha = (if alpha = apply_fun a1 k then (apply_fun x1 k) (apply_fun a1 k) else ea alpha).
        { exact (Hx1_coord k Hk alpha Hal). }
        claim Ha1k_ne : alpha <> apply_fun a1 k.
        { assume Heq : alpha = apply_fun a1 k.
          claim Ha1k_eq : apply_fun a1 k = alpha. { symmetry. exact Heq. }
          claim Hex : exists i:set, i :e n1 /\ apply_fun a1 i = alpha.
          { witness k. apply andI. * exact Hk. * exact Ha1k_eq. }
          exact (Hnex1 Hex). }
        rewrite Hev. exact (If_i_0 (alpha = apply_fun a1 k) ((apply_fun x1 k) (apply_fun a1 k)) (ea alpha) Ha1k_ne). }
      claim Hprod1_id : nat_primrec (ea alpha)
        (fun k r => apply_fun (ma alpha) (r, (apply_fun x1 k) alpha)) n1 = ea alpha.
      { exact (product_all_id n1 Hnat1 alpha Hal (fun k => (apply_fun x1 k) alpha) Hvals1_all_id). }
      claim Hx_ea : x alpha = ea alpha. { rewrite (Hpw1 alpha Hal). exact Hprod1_id. }
      claim Hvals2_ne : forall k:set, k :e n2 -> k <> j -> (apply_fun x2 k) alpha = ea alpha.
      { let k. assume Hk : k :e n2. assume Hne : k <> j.
        claim Hne_jk : j <> k.
        { assume Heq_jk : j = k.
          claim Heq_kj : k = j. { symmetry. exact Heq_jk. }
          exact (Hne Heq_kj). }
        claim Hev : (apply_fun x2 k) alpha = (if alpha = apply_fun a2 k then (apply_fun x2 k) (apply_fun a2 k) else ea alpha).
        { exact (Hx2_coord k Hk alpha Hal). }
        claim Ha2k_ne : alpha <> apply_fun a2 k.
        { assume Heq : alpha = apply_fun a2 k.
          claim Heq2 : apply_fun a2 j = apply_fun a2 k. { rewrite Ha2j. exact Heq. }
          exact (Ha2inj j k Hj Hk Hne_jk Heq2). }
        rewrite Hev. exact (If_i_0 (alpha = apply_fun a2 k) ((apply_fun x2 k) (apply_fun a2 k)) (ea alpha) Ha2k_ne). }
      claim Hprod2_val : nat_primrec (ea alpha)
        (fun k r => apply_fun (ma alpha) (r, (apply_fun x2 k) alpha)) n2 = (apply_fun x2 j) alpha.
      { exact (product_single_nonid n2 Hnat2 alpha Hal (fun k => (apply_fun x2 k) alpha) Hx2_Ga j Hj Hvals2_ne). }
      claim Hx2j_alpha_ea : (apply_fun x2 j) alpha = ea alpha.
      { claim H : x alpha = (apply_fun x2 j) alpha. { rewrite (Hpw2 alpha Hal). exact Hprod2_val. }
        claim H2 : (apply_fun x2 j) alpha = x alpha. { symmetry. exact H. }
        rewrite H2. exact Hx_ea. }
      apply (G_ext (apply_fun x2 j) eG (Hx2fn j Hj) HeG_G).
      let gamma. assume Hg : gamma :e J.
      apply (xm (gamma = alpha)).
      * assume Heq : gamma = alpha.
        rewrite Heq. rewrite Hx2j_alpha_ea.
        symmetry. exact (beta J (fun alpha => ea alpha) alpha Hal).
      * assume Hne : gamma <> alpha.
        claim Hev : (apply_fun x2 j) gamma = (if gamma = apply_fun a2 j then (apply_fun x2 j) (apply_fun a2 j) else ea gamma).
        { exact (Hx2_coord j Hj gamma Hg). }
        claim Hne2 : gamma <> apply_fun a2 j. { rewrite Ha2j. exact Hne. }
        rewrite Hev. rewrite (If_i_0 (gamma = apply_fun a2 j) ((apply_fun x2 j) (apply_fun a2 j)) (ea gamma) Hne2).
        symmetry. exact (beta J (fun alpha => ea alpha) gamma Hg).
Qed.

(** from S67 Lem 67.5 (line 2660 in algtop.tex): extension condition for external direct sums **)
(** LATEX VERSION: If each i_alpha is a monomorphism and G is the direct sum of i_alpha(G_alpha), **)
(** then given any abelian group H and homomorphisms h_alpha: G_alpha -> H, there exists a unique **)
(** from S67 Lem 67.5 (line 2660 in algtop.tex): external extension condition **)
(** homomorphism h: G -> H such that h o i_alpha = h_alpha. Conversely, if the extension condition **)
(** holds, then each i_alpha is a monomorphism and G is the direct sum. **)
(** EFFORT: 10 lines textbook, difficulty 5/10, USD 100 **)
(** Collected Dave 134 **)
(** Proven Dave **)
Theorem lemma67_5_extension_external :
  forall G multG eG invG J Gfam multfam efam invfam ifam:set,
  abelian_group G multG eG invG ->
  (forall alpha:set, alpha :e J ->
    group_structure (apply_fun Gfam alpha) (apply_fun multfam alpha)
      (apply_fun efam alpha) (apply_fun invfam alpha)) ->
  (forall alpha:set, alpha :e J ->
    group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) G multG (apply_fun ifam alpha) /\
    (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
      apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) y -> x = y)) ->
  direct_sum_of_subgroups G multG eG invG J
    (graph J (fun alpha:set => homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha))) ->
  (forall H multH eH invH:set,
    abelian_group H multH eH invH ->
    forall hfam:set,
      (forall alpha:set, alpha :e J ->
        group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) H multH (apply_fun hfam alpha)) ->
      exists h:set,
        group_homomorphism G multG H multH h /\
        (forall alpha:set, alpha :e J ->
          forall x:set, x :e apply_fun Gfam alpha ->
            apply_fun h (apply_fun (apply_fun ifam alpha) x) =
              apply_fun (apply_fun hfam alpha) x) /\
        (forall h':set, group_homomorphism G multG H multH h' ->
          (forall alpha:set, alpha :e J ->
            forall x:set, x :e apply_fun Gfam alpha ->
              apply_fun h' (apply_fun (apply_fun ifam alpha) x) =
                apply_fun (apply_fun hfam alpha) x) ->
          forall x:set, x :e G -> apply_fun h' x = apply_fun h x)).
let G multG eG invG J Gfam multfam efam invfam ifam.
assume HabG : abelian_group G multG eG invG.
assume Hgfam_grp : (forall alpha:set, alpha :e J ->
    group_structure (apply_fun Gfam alpha) (apply_fun multfam alpha)
      (apply_fun efam alpha) (apply_fun invfam alpha)).
assume Hifam : (forall alpha:set, alpha :e J ->
    group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) G multG (apply_fun ifam alpha) /\
    (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
      apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) y -> x = y)).
assume HDS : direct_sum_of_subgroups G multG eG invG J
    (graph J (fun alpha:set => homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha))).
let H multH eH invH.
assume HabH : abelian_group H multH eH invH.
let hfam.
assume Hhfam : (forall alpha:set, alpha :e J ->
    group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) H multH (apply_fun hfam alpha)).
(** Extract group structures **)
claim HgrpG : group_structure G multG eG invG.
{
  exact (andEL
    (group_structure G multG eG invG)
    (forall x y:set, x :e G -> y :e G -> apply_fun multG (x, y) = apply_fun multG (y, x))
    HabG).
}
claim HgrpH : group_structure H multH eH invH.
{
  exact (andEL
    (group_structure H multH eH invH)
    (forall x y:set, x :e H -> y :e H -> apply_fun multH (x, y) = apply_fun multH (y, x))
    HabH).
}
(** Extract components from group_structure **)
claim HeGG : eG :e G.
{
  apply (and6E
    (function_on multG (setprod G G) G)
    (function_on invG G G)
    (eG :e G)
    (forall x y z:set, x :e G -> y :e G -> z :e G ->
      apply_fun multG (apply_fun multG (x, y), z) = apply_fun multG (x, apply_fun multG (y, z)))
    (forall x:set, x :e G -> apply_fun multG (eG, x) = x /\ apply_fun multG (x, eG) = x)
    (forall x:set, x :e G ->
      apply_fun multG (x, apply_fun invG x) = eG /\ apply_fun multG (apply_fun invG x, x) = eG)
    HgrpG).
  assume _ _ HeG _ _ _.
  exact HeG.
}
claim HeHH : eH :e H.
{
  apply (and6E
    (function_on multH (setprod H H) H)
    (function_on invH H H)
    (eH :e H)
    (forall x y z:set, x :e H -> y :e H -> z :e H ->
      apply_fun multH (apply_fun multH (x, y), z) = apply_fun multH (x, apply_fun multH (y, z)))
    (forall x:set, x :e H -> apply_fun multH (eH, x) = x /\ apply_fun multH (x, eH) = x)
    (forall x:set, x :e H ->
      apply_fun multH (x, apply_fun invH x) = eH /\ apply_fun multH (apply_fun invH x, x) = eH)
    HgrpH).
  assume _ _ HeH _ _ _.
  exact HeH.
}
(** Strategy: Use lemma67_1 via image subgroups to get h with all properties **)
set Gfam_img := graph J (fun alpha:set => homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha)).
(** Preimage function **)
set preim := fun alpha z:set =>
  Eps_i (fun y:set => y :e apply_fun Gfam alpha /\
    apply_fun (apply_fun ifam alpha) y = z).
(** Gfam_img evaluation **)
claim Hgfam_eval : forall alpha:set, alpha :e J ->
  apply_fun Gfam_img alpha = homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha).
{ let alpha. assume Hal.
  exact (apply_fun_graph J (fun a:set => homomorphism_image (apply_fun Gfam a) (apply_fun ifam a)) alpha Hal). }
(** Extract ifam homomorphism and injectivity **)
claim Hifam_hom_all : forall alpha:set, alpha :e J ->
  group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) G multG (apply_fun ifam alpha).
{ let alpha. assume Hal.
  exact (andEL
    (group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) G multG (apply_fun ifam alpha))
    (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
      apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) y -> x = y)
    (Hifam alpha Hal)). }
claim Hifam_inj_all : forall alpha:set, alpha :e J ->
  forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
    apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) y -> x = y.
{ let alpha. assume Hal.
  exact (andER
    (group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) G multG (apply_fun ifam alpha))
    (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
      apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) y -> x = y)
    (Hifam alpha Hal)). }
(** Preim properties: for z in Im(ifam_alpha), preim is in Gfam and maps to z **)
claim Hpreim_props : forall alpha:set, alpha :e J ->
  forall z:set, z :e apply_fun Gfam_img alpha ->
    preim alpha z :e apply_fun Gfam alpha /\
    apply_fun (apply_fun ifam alpha) (preim alpha z) = z.
{ let alpha. assume Hal.
  let z. assume Hz.
  claim Himg : z :e homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha).
  { rewrite <- (Hgfam_eval alpha Hal). exact Hz. }
  apply (ReplE_impred (apply_fun Gfam alpha) (fun y:set => apply_fun (apply_fun ifam alpha) y) z Himg).
  let y. assume Hy : y :e apply_fun Gfam alpha. assume Hzeq : z = apply_fun (apply_fun ifam alpha) y.
  claim Hex : exists w:set, w :e apply_fun Gfam alpha /\ apply_fun (apply_fun ifam alpha) w = z.
  { witness y. apply andI. - exact Hy. - symmetry. exact Hzeq. }
  exact (Eps_i_ex (fun w:set => w :e apply_fun Gfam alpha /\ apply_fun (apply_fun ifam alpha) w = z) Hex). }
(** Preim inversion: preim(alpha, ifam(alpha)(x)) = x by injectivity **)
claim Hpreim_inv : forall alpha:set, alpha :e J ->
  forall x:set, x :e apply_fun Gfam alpha ->
    preim alpha (apply_fun (apply_fun ifam alpha) x) = x.
{ let alpha. assume Hal.
  let x. assume Hx.
  set z := apply_fun (apply_fun ifam alpha) x.
  claim Hz_img : z :e apply_fun Gfam_img alpha.
  { rewrite (Hgfam_eval alpha Hal).
    exact (ReplI (apply_fun Gfam alpha) (fun y:set => apply_fun (apply_fun ifam alpha) y) x Hx). }
  claim Hpin : preim alpha z :e apply_fun Gfam alpha.
  { exact (andEL (preim alpha z :e apply_fun Gfam alpha)
      (apply_fun (apply_fun ifam alpha) (preim alpha z) = z)
      (Hpreim_props alpha Hal z Hz_img)). }
  claim Hpeq : apply_fun (apply_fun ifam alpha) (preim alpha z) = z.
  { exact (andER (preim alpha z :e apply_fun Gfam alpha)
      (apply_fun (apply_fun ifam alpha) (preim alpha z) = z)
      (Hpreim_props alpha Hal z Hz_img)). }
  exact (Hifam_inj_all alpha Hal (preim alpha z) x Hpin Hx Hpeq). }
(** Extract subgroup property: Gfam_img(alpha) c= G **)
claim Hsubgrp : forall alpha:set, alpha :e J ->
  subgroup_of (apply_fun Gfam_img alpha) G multG eG invG.
{ let alpha. assume Hal.
  claim Hsga : subgroups_generate_abelian G multG eG invG J Gfam_img.
  { exact (andEL
      (subgroups_generate_abelian G multG eG invG J Gfam_img)
      (forall x:set, x :e G ->
        forall n1 n2:set, n1 :e omega -> n2 :e omega -> 
        forall a1 a2:set, function_on a1 n1 J -> function_on a2 n2 J ->
        forall x1 x2:set, function_on x1 n1 G -> function_on x2 n2 G ->
          (forall i:set, i :e n1 -> apply_fun x1 i :e apply_fun Gfam_img (apply_fun a1 i)) ->
          (forall i:set, i :e n2 -> apply_fun x2 i :e apply_fun Gfam_img (apply_fun a2 i)) ->
          (forall i j:set, i :e n1 -> j :e n1 -> i <> j -> apply_fun a1 i <> apply_fun a1 j) ->
          (forall i j:set, i :e n2 -> j :e n2 -> i <> j -> apply_fun a2 i <> apply_fun a2 j) ->
          x = nat_primrec eG (fun i r => apply_fun multG (r, apply_fun x1 i)) n1 ->
          x = nat_primrec eG (fun i r => apply_fun multG (r, apply_fun x2 i)) n2 ->
          (forall al:set, al :e J ->
            (forall i j:set, i :e n1 -> j :e n2 ->
              apply_fun a1 i = al -> apply_fun a2 j = al -> apply_fun x1 i = apply_fun x2 j) /\
            ((exists i:set, i :e n1 /\ apply_fun a1 i = al) ->
             ~(exists j:set, j :e n2 /\ apply_fun a2 j = al) ->
             forall i:set, i :e n1 -> apply_fun a1 i = al -> apply_fun x1 i = eG) /\
            (~(exists i:set, i :e n1 /\ apply_fun a1 i = al) ->
             (exists j:set, j :e n2 /\ apply_fun a2 j = al) ->
             forall j:set, j :e n2 -> apply_fun a2 j = al -> apply_fun x2 j = eG)))
      HDS). }
  apply (and3E
    (abelian_group G multG eG invG)
    (forall a:set, a :e J -> subgroup_of (apply_fun Gfam_img a) G multG eG invG)
    (forall x:set, x :e G ->
      exists n:set, n :e omega /\
      exists alphas:set, function_on alphas n J /\
      exists xs:set, function_on xs n G /\
        (forall i:set, i :e n -> apply_fun xs i :e apply_fun Gfam_img (apply_fun alphas i)) /\
        (forall i j:set, i :e n -> j :e n -> i <> j -> apply_fun alphas i <> apply_fun alphas j) /\
        x = nat_primrec eG (fun i r => apply_fun multG (r, apply_fun xs i)) n)
    Hsga).
  assume _ Hsubfam _.
  exact (Hsubfam alpha Hal). }
claim Himg_sub_G : forall alpha:set, alpha :e J ->
  apply_fun Gfam_img alpha c= G.
{ let alpha. assume Hal.
  apply (and4E
    (apply_fun Gfam_img alpha c= G)
    (eG :e apply_fun Gfam_img alpha)
    (forall x y:set, x :e apply_fun Gfam_img alpha -> y :e apply_fun Gfam_img alpha ->
      apply_fun multG (x, y) :e apply_fun Gfam_img alpha)
    (forall x:set, x :e apply_fun Gfam_img alpha -> apply_fun invG x :e apply_fun Gfam_img alpha)
    (Hsubgrp alpha Hal)).
  assume Hsub _ _ _.
  exact Hsub. }
(** hfam function_on property **)
claim Hhfam_fn : forall alpha:set, alpha :e J ->
  function_on (apply_fun hfam alpha) (apply_fun Gfam alpha) H.
{ let alpha. assume Hal.
  exact (andEL
    (function_on (apply_fun hfam alpha) (apply_fun Gfam alpha) H)
    (forall u v:set, u :e apply_fun Gfam alpha -> v :e apply_fun Gfam alpha ->
      apply_fun (apply_fun hfam alpha) (apply_fun (apply_fun multfam alpha) (u, v)) =
        apply_fun multH (apply_fun (apply_fun hfam alpha) u, apply_fun (apply_fun hfam alpha) v))
    (Hhfam alpha Hal)). }
(** Construct hbar_fam: for each alpha, hbar(alpha) maps Im(ifam_alpha) -> H **)
set hbar_fam := graph J (fun alpha:set =>
  graph (apply_fun Gfam_img alpha)
    (fun z:set => apply_fun (apply_fun hfam alpha) (preim alpha z))).
(** hbar_fam evaluation **)
claim Hhbar_eval : forall alpha:set, alpha :e J ->
  apply_fun hbar_fam alpha = graph (apply_fun Gfam_img alpha)
    (fun z:set => apply_fun (apply_fun hfam alpha) (preim alpha z)).
{ let alpha. assume Hal.
  exact (apply_fun_graph J
    (fun a:set => graph (apply_fun Gfam_img a) (fun z:set => apply_fun (apply_fun hfam a) (preim a z)))
    alpha Hal). }
(** hbar_fam pointwise evaluation **)
claim Hhbar_pt : forall alpha:set, alpha :e J ->
  forall z:set, z :e apply_fun Gfam_img alpha ->
    apply_fun (apply_fun hbar_fam alpha) z = apply_fun (apply_fun hfam alpha) (preim alpha z).
{ let alpha. assume Hal.
  let z. assume Hz.
  claim Hev : apply_fun hbar_fam alpha = graph (apply_fun Gfam_img alpha) (fun w:set => apply_fun (apply_fun hfam alpha) (preim alpha w)).
  { exact (Hhbar_eval alpha Hal). }
  rewrite Hev.
  exact (apply_fun_graph (apply_fun Gfam_img alpha)
    (fun w:set => apply_fun (apply_fun hfam alpha) (preim alpha w)) z Hz). }
(** Each hbar(alpha) is a group_homomorphism from Gfam_img(alpha) with multG to H with multH **)
claim Hhbar_hom : forall alpha:set, alpha :e J ->
  group_homomorphism (apply_fun Gfam_img alpha) multG H multH (apply_fun hbar_fam alpha).
{ let alpha. assume Hal.
  prove function_on (apply_fun hbar_fam alpha) (apply_fun Gfam_img alpha) H /\
    (forall u v:set, u :e apply_fun Gfam_img alpha -> v :e apply_fun Gfam_img alpha ->
      apply_fun (apply_fun hbar_fam alpha) (apply_fun multG (u, v)) =
        apply_fun multH (apply_fun (apply_fun hbar_fam alpha) u, apply_fun (apply_fun hbar_fam alpha) v)).
  apply andI.
  - (** function_on: for z in Gfam_img(alpha), hbar(alpha)(z) :e H **)
    let z. assume Hz : z :e apply_fun Gfam_img alpha.
    claim Hpin : preim alpha z :e apply_fun Gfam alpha.
    { exact (andEL (preim alpha z :e apply_fun Gfam alpha)
        (apply_fun (apply_fun ifam alpha) (preim alpha z) = z)
        (Hpreim_props alpha Hal z Hz)). }
    claim Hval_H : apply_fun (apply_fun hfam alpha) (preim alpha z) :e H.
    { exact (Hhfam_fn alpha Hal (preim alpha z) Hpin). }
    claim Hev : apply_fun (apply_fun hbar_fam alpha) z = apply_fun (apply_fun hfam alpha) (preim alpha z).
    { exact (Hhbar_pt alpha Hal z Hz). }
    prove apply_fun (apply_fun hbar_fam alpha) z :e H.
    rewrite Hev.
    exact Hval_H.
  - (** mult preservation **)
    let u v. assume Hu : u :e apply_fun Gfam_img alpha. assume Hv : v :e apply_fun Gfam_img alpha.
    (** Decompose u, v as images under ifam(alpha) **)
    claim Himg_u : u :e homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha).
    { rewrite <- (Hgfam_eval alpha Hal). exact Hu. }
    claim Himg_v : v :e homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha).
    { rewrite <- (Hgfam_eval alpha Hal). exact Hv. }
    apply (ReplE_impred (apply_fun Gfam alpha) (fun y:set => apply_fun (apply_fun ifam alpha) y) u Himg_u).
    let y1. assume Hy1 : y1 :e apply_fun Gfam alpha. assume Hu_eq : u = apply_fun (apply_fun ifam alpha) y1.
    apply (ReplE_impred (apply_fun Gfam alpha) (fun y:set => apply_fun (apply_fun ifam alpha) y) v Himg_v).
    let y2. assume Hy2 : y2 :e apply_fun Gfam alpha. assume Hv_eq : v = apply_fun (apply_fun ifam alpha) y2.
    (** preim(alpha, u) = y1, preim(alpha, v) = y2 **)
    claim Hpu : preim alpha u = y1.
    { rewrite Hu_eq. exact (Hpreim_inv alpha Hal y1 Hy1). }
    claim Hpv : preim alpha v = y2.
    { rewrite Hv_eq. exact (Hpreim_inv alpha Hal y2 Hy2). }
    (** multG(u, v) = ifam(multfam(y1, y2)) **)
    claim Hmult_eq : apply_fun multG (u, v) =
      apply_fun (apply_fun ifam alpha) (apply_fun (apply_fun multfam alpha) (y1, y2)).
    { rewrite Hu_eq. rewrite Hv_eq.
      symmetry.
      exact (group_homomorphism_mult_rule (apply_fun Gfam alpha) (apply_fun multfam alpha) G multG
        (apply_fun ifam alpha) y1 y2 (Hifam_hom_all alpha Hal) Hy1 Hy2). }
    (** multfam(y1, y2) :e Gfam(alpha) - from subgroup mult closure of image **)
    claim Hmuv_img : apply_fun multG (u, v) :e apply_fun Gfam_img alpha.
    { apply (and4E
        (apply_fun Gfam_img alpha c= G)
        (eG :e apply_fun Gfam_img alpha)
        (forall x y:set, x :e apply_fun Gfam_img alpha -> y :e apply_fun Gfam_img alpha ->
          apply_fun multG (x, y) :e apply_fun Gfam_img alpha)
        (forall x:set, x :e apply_fun Gfam_img alpha -> apply_fun invG x :e apply_fun Gfam_img alpha)
        (Hsubgrp alpha Hal)).
      assume _ _ Hmcl _.
      exact (Hmcl u v Hu Hv). }
    (** preim(alpha, multG(u,v)) = multfam(y1, y2) **)
    claim Hm12 : apply_fun (apply_fun multfam alpha) (y1, y2) :e apply_fun Gfam alpha.
    { (** Since multG(u,v) = ifam(multfam(y1,y2)) and multG(u,v) is in Gfam_img, preim gives multfam(y1,y2) **)
      claim Hpmuv_props : preim alpha (apply_fun multG (u, v)) :e apply_fun Gfam alpha /\
        apply_fun (apply_fun ifam alpha) (preim alpha (apply_fun multG (u, v))) = apply_fun multG (u, v).
      { exact (Hpreim_props alpha Hal (apply_fun multG (u, v)) Hmuv_img). }
      claim Hpmuv_in : preim alpha (apply_fun multG (u, v)) :e apply_fun Gfam alpha.
      { exact (andEL
          (preim alpha (apply_fun multG (u, v)) :e apply_fun Gfam alpha)
          (apply_fun (apply_fun ifam alpha) (preim alpha (apply_fun multG (u, v))) = apply_fun multG (u, v))
          Hpmuv_props). }
      claim Hpmuv_eq : apply_fun (apply_fun ifam alpha) (preim alpha (apply_fun multG (u, v))) = apply_fun multG (u, v).
      { exact (andER
          (preim alpha (apply_fun multG (u, v)) :e apply_fun Gfam alpha)
          (apply_fun (apply_fun ifam alpha) (preim alpha (apply_fun multG (u, v))) = apply_fun multG (u, v))
          Hpmuv_props). }
      claim Hifam_m12 : apply_fun (apply_fun ifam alpha) (apply_fun (apply_fun multfam alpha) (y1, y2)) = apply_fun multG (u, v).
      { symmetry. exact Hmult_eq. }
      claim Hpmuv_is_m12 : preim alpha (apply_fun multG (u, v)) = apply_fun (apply_fun multfam alpha) (y1, y2).
      { claim Hifam_m12_sym : apply_fun multG (u, v) = apply_fun (apply_fun ifam alpha) (apply_fun (apply_fun multfam alpha) (y1, y2)).
        { symmetry. exact Hifam_m12. }
        claim Hm12_here : apply_fun (apply_fun multfam alpha) (y1, y2) :e apply_fun Gfam alpha.
        { claim Hsubgrp_hom_img : subgroup_of (homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha)) G multG eG invG.
          { rewrite <- (Hgfam_eval alpha Hal). exact (Hsubgrp alpha Hal). }
          exact (group_source_mult_closure
            (apply_fun Gfam alpha) (apply_fun multfam alpha)
            (apply_fun efam alpha) (apply_fun invfam alpha)
            (Hgfam_grp alpha Hal) y1 y2 Hy1 Hy2). }
        exact (Hifam_inj_all alpha Hal (preim alpha (apply_fun multG (u, v)))
          (apply_fun (apply_fun multfam alpha) (y1, y2)) Hpmuv_in
          Hm12_here
          (eq_i_tra
            (apply_fun (apply_fun ifam alpha) (preim alpha (apply_fun multG (u, v))))
            (apply_fun multG (u, v))
            (apply_fun (apply_fun ifam alpha) (apply_fun (apply_fun multfam alpha) (y1, y2)))
            Hpmuv_eq Hifam_m12_sym)). }
      rewrite <- Hpmuv_is_m12. exact Hpmuv_in. }
    claim Hpuv : preim alpha (apply_fun multG (u, v)) = apply_fun (apply_fun multfam alpha) (y1, y2).
    { rewrite Hmult_eq. exact (Hpreim_inv alpha Hal (apply_fun (apply_fun multfam alpha) (y1, y2)) Hm12). }
    (** LHS: hbar(multG(u,v)) = hfam(preim(multG(u,v))) = hfam(multfam(y1,y2)) **)
    claim HLHS : apply_fun (apply_fun hbar_fam alpha) (apply_fun multG (u, v)) =
      apply_fun (apply_fun hfam alpha) (apply_fun (apply_fun multfam alpha) (y1, y2)).
    { claim Hev_uv : apply_fun (apply_fun hbar_fam alpha) (apply_fun multG (u, v)) = apply_fun (apply_fun hfam alpha) (preim alpha (apply_fun multG (u, v))).
      { exact (Hhbar_pt alpha Hal (apply_fun multG (u, v)) Hmuv_img). }
      rewrite Hev_uv. rewrite Hpuv. reflexivity. }
    (** hfam mult preservation **)
    claim Hhfam_mult : apply_fun (apply_fun hfam alpha) (apply_fun (apply_fun multfam alpha) (y1, y2)) =
      apply_fun multH (apply_fun (apply_fun hfam alpha) y1, apply_fun (apply_fun hfam alpha) y2).
    { exact (group_homomorphism_mult_rule (apply_fun Gfam alpha) (apply_fun multfam alpha) H multH
        (apply_fun hfam alpha) y1 y2 (Hhfam alpha Hal) Hy1 Hy2). }
    (** RHS: multH(hbar(u), hbar(v)) = multH(hfam(y1), hfam(y2)) **)
    claim HRHS_u : apply_fun (apply_fun hbar_fam alpha) u = apply_fun (apply_fun hfam alpha) y1.
    { claim Hev_u : apply_fun (apply_fun hbar_fam alpha) u = apply_fun (apply_fun hfam alpha) (preim alpha u).
      { exact (Hhbar_pt alpha Hal u Hu). }
      rewrite Hev_u. rewrite Hpu. reflexivity. }
    claim HRHS_v : apply_fun (apply_fun hbar_fam alpha) v = apply_fun (apply_fun hfam alpha) y2.
    { claim Hev_v : apply_fun (apply_fun hbar_fam alpha) v = apply_fun (apply_fun hfam alpha) (preim alpha v).
      { exact (Hhbar_pt alpha Hal v Hv). }
      rewrite Hev_v. rewrite Hpv. reflexivity. }
    rewrite HLHS. rewrite Hhfam_mult. rewrite HRHS_u. rewrite HRHS_v. reflexivity. }
(** function_on hbar_fam J (Power (setprod G H)) **)
claim Hhbar_fn : function_on hbar_fam J (Power (setprod G H)).
{ let alpha. assume Hal : alpha :e J.
  claim Hev : apply_fun hbar_fam alpha = graph (apply_fun Gfam_img alpha) (fun z:set => apply_fun (apply_fun hfam alpha) (preim alpha z)).
  { exact (Hhbar_eval alpha Hal). }
  claim Hgr_in : graph (apply_fun Gfam_img alpha) (fun z:set => apply_fun (apply_fun hfam alpha) (preim alpha z)) :e Power (setprod G H).
  { apply PowerI.
    apply (Subq_tra
      (graph (apply_fun Gfam_img alpha) (fun z:set => apply_fun (apply_fun hfam alpha) (preim alpha z)))
      (setprod (apply_fun Gfam_img alpha) H)
      (setprod G H)).
    - apply graph_subset_setprod.
      let z. assume Hz : z :e apply_fun Gfam_img alpha.
      claim Hpin : preim alpha z :e apply_fun Gfam alpha.
      { exact (andEL (preim alpha z :e apply_fun Gfam alpha)
          (apply_fun (apply_fun ifam alpha) (preim alpha z) = z)
          (Hpreim_props alpha Hal z Hz)). }
      exact (Hhfam_fn alpha Hal (preim alpha z) Hpin).
    - exact (setprod_Subq (apply_fun Gfam_img alpha) H G H (Himg_sub_G alpha Hal) (Subq_ref H)). }
  exact (eq_subst_mem (apply_fun hbar_fam alpha)
    (graph (apply_fun Gfam_img alpha) (fun z:set => apply_fun (apply_fun hfam alpha) (preim alpha z)))
    (Power (setprod G H)) Hev Hgr_in). }
(** Apply lemma67_1 to get h with all properties **)
claim Hlem : exists h:set,
  group_homomorphism G multG H multH h /\
  (forall alpha:set, alpha :e J ->
    forall z:set, z :e apply_fun Gfam_img alpha ->
      apply_fun h z = apply_fun (apply_fun hbar_fam alpha) z) /\
  (forall h':set, group_homomorphism G multG H multH h' ->
    (forall alpha:set, alpha :e J ->
      forall z:set, z :e apply_fun Gfam_img alpha ->
        apply_fun h' z = apply_fun (apply_fun hbar_fam alpha) z) ->
    forall x:set, x :e G -> apply_fun h' x = apply_fun h x).
{ exact (lemma67_1_extension_condition_direct_sum G multG eG invG J Gfam_img HDS
    H multH eH invH HabH hbar_fam Hhbar_fn Hhbar_hom). }
apply Hlem.
let h. assume Hh_all.
apply (and3E
  (group_homomorphism G multG H multH h)
  (forall alpha:set, alpha :e J ->
    forall z:set, z :e apply_fun Gfam_img alpha ->
      apply_fun h z = apply_fun (apply_fun hbar_fam alpha) z)
  (forall h':set, group_homomorphism G multG H multH h' ->
    (forall alpha:set, alpha :e J ->
      forall z:set, z :e apply_fun Gfam_img alpha ->
        apply_fun h' z = apply_fun (apply_fun hbar_fam alpha) z) ->
    forall x:set, x :e G -> apply_fun h' x = apply_fun h x)
  Hh_all).
assume Hhom : group_homomorphism G multG H multH h.
assume Hext_img : forall alpha:set, alpha :e J ->
  forall z:set, z :e apply_fun Gfam_img alpha ->
    apply_fun h z = apply_fun (apply_fun hbar_fam alpha) z.
assume Huniq_img : forall h':set, group_homomorphism G multG H multH h' ->
  (forall alpha:set, alpha :e J ->
    forall z:set, z :e apply_fun Gfam_img alpha ->
      apply_fun h' z = apply_fun (apply_fun hbar_fam alpha) z) ->
  forall x:set, x :e G -> apply_fun h' x = apply_fun h x.
(** Part 2: Translate extension to external form **)
claim Hext : forall alpha:set, alpha :e J ->
  forall x:set, x :e apply_fun Gfam alpha ->
    apply_fun h (apply_fun (apply_fun ifam alpha) x) =
      apply_fun (apply_fun hfam alpha) x.
{ let alpha. assume Hal : alpha :e J.
  let x. assume Hx : x :e apply_fun Gfam alpha.
  set z := apply_fun (apply_fun ifam alpha) x.
  (** z is in Gfam_img(alpha) **)
  claim Hz_img : z :e apply_fun Gfam_img alpha.
  { rewrite (Hgfam_eval alpha Hal).
    exact (ReplI (apply_fun Gfam alpha) (fun y:set => apply_fun (apply_fun ifam alpha) y) x Hx). }
  (** h(z) = hbar(alpha)(z) = hfam(alpha)(preim(alpha, z)) **)
  claim Hh_z : apply_fun h z = apply_fun (apply_fun hfam alpha) (preim alpha z).
  { rewrite (Hext_img alpha Hal z Hz_img).
    exact (Hhbar_pt alpha Hal z Hz_img). }
  (** preim(alpha, z) = preim(alpha, ifam(alpha)(x)) = x **)
  claim Hpreim_x : preim alpha z = x.
  { exact (Hpreim_inv alpha Hal x Hx). }
  rewrite Hh_z. rewrite Hpreim_x. reflexivity. }
(** Part 3: Translate uniqueness to external form **)
claim Huniq : forall h':set, group_homomorphism G multG H multH h' ->
  (forall alpha:set, alpha :e J ->
    forall x:set, x :e apply_fun Gfam alpha ->
      apply_fun h' (apply_fun (apply_fun ifam alpha) x) =
        apply_fun (apply_fun hfam alpha) x) ->
  forall x:set, x :e G -> apply_fun h' x = apply_fun h x.
{ let h'. assume Hh'hom. assume Hh'ext.
  (** Show h' extends hbar_fam on image subgroups **)
  claim Hh'ext_img : forall alpha:set, alpha :e J ->
    forall z:set, z :e apply_fun Gfam_img alpha ->
      apply_fun h' z = apply_fun (apply_fun hbar_fam alpha) z.
  { let alpha. assume Hal : alpha :e J.
    let z. assume Hz : z :e apply_fun Gfam_img alpha.
    claim Himg : z :e homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha).
    { rewrite <- (Hgfam_eval alpha Hal). exact Hz. }
    apply (ReplE_impred (apply_fun Gfam alpha) (fun y:set => apply_fun (apply_fun ifam alpha) y) z Himg).
    let y. assume Hy : y :e apply_fun Gfam alpha. assume Hz_eq : z = apply_fun (apply_fun ifam alpha) y.
    (** h'(z) = h'(ifam(y)) = hfam(y) **)
    claim Hh'_val : apply_fun h' z = apply_fun (apply_fun hfam alpha) y.
    { rewrite Hz_eq. exact (Hh'ext alpha Hal y Hy). }
    (** hbar(alpha)(z) = hfam(preim(alpha, z)) = hfam(y) **)
    claim Hpreim_y : preim alpha z = y.
    { rewrite Hz_eq. exact (Hpreim_inv alpha Hal y Hy). }
    claim Hhbar_val : apply_fun (apply_fun hbar_fam alpha) z = apply_fun (apply_fun hfam alpha) y.
    { claim Hev_z : apply_fun (apply_fun hbar_fam alpha) z = apply_fun (apply_fun hfam alpha) (preim alpha z).
      { exact (Hhbar_pt alpha Hal z Hz). }
      rewrite Hev_z. rewrite Hpreim_y. reflexivity. }
    rewrite Hh'_val. rewrite Hhbar_val. reflexivity. }
  exact (Huniq_img h' Hh'hom Hh'ext_img). }
witness h.
apply and3I.
- exact Hhom.
- exact Hext.
- exact Huniq.
Qed.

(** from S67 Lem 67.5 converse (line 2665 in algtop.tex): extension condition implies direct sum **)
(** LATEX VERSION: If the groups i_alpha(G_alpha) generate G and the extension condition holds, **)
(** then each i_alpha is a monomorphism and G is the direct sum of the groups i_alpha(G_alpha). **)
(** EFFORT: 8 lines textbook, difficulty 5/10, USD 100 **)
(** Collected Dave 121 **)
(** Proven Dave **)
Theorem lemma67_5_extension_converse :
  forall G multG eG invG J Gfam multfam efam invfam ifam:set,
  abelian_group G multG eG invG ->
  (forall alpha:set, alpha :e J ->
    abelian_group (apply_fun Gfam alpha) (apply_fun multfam alpha) (apply_fun efam alpha) (apply_fun invfam alpha)) ->
  (forall alpha:set, alpha :e J ->
    group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) G multG (apply_fun ifam alpha)) ->
  subgroups_generate_abelian G multG eG invG J
    (graph J (fun alpha:set => homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha))) ->
  (forall H multH eH invH:set,
    abelian_group H multH eH invH ->
    forall hfam:set,
      (forall alpha:set, alpha :e J ->
        group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) H multH (apply_fun hfam alpha)) ->
      exists h:set,
        group_homomorphism G multG H multH h /\
        (forall alpha:set, alpha :e J ->
          forall x:set, x :e apply_fun Gfam alpha ->
            apply_fun h (apply_fun (apply_fun ifam alpha) x) =
              apply_fun (apply_fun hfam alpha) x)) ->
  (forall alpha:set, alpha :e J ->
    forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
      apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) y -> x = y) /\
  direct_sum_of_subgroups G multG eG invG J
    (graph J (fun alpha:set => homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha))).
let G multG eG invG J Gfam multfam efam invfam ifam.
assume HabG.
assume HabGfam : forall alpha:set, alpha :e J ->
  abelian_group (apply_fun Gfam alpha) (apply_fun multfam alpha) (apply_fun efam alpha) (apply_fun invfam alpha).
assume Hifam_hom : forall alpha:set, alpha :e J ->
  group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) G multG (apply_fun ifam alpha).
assume Hgen_img : subgroups_generate_abelian G multG eG invG J
  (graph J (fun alpha:set => homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha))).
assume Hext_cond : forall H multH eH invH:set,
  abelian_group H multH eH invH ->
  forall hfam:set,
    (forall alpha:set, alpha :e J ->
      group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) H multH (apply_fun hfam alpha)) ->
    exists h:set,
      group_homomorphism G multG H multH h /\
      (forall alpha:set, alpha :e J ->
        forall x:set, x :e apply_fun Gfam alpha ->
          apply_fun h (apply_fun (apply_fun ifam alpha) x) =
            apply_fun (apply_fun hfam alpha) x).
apply andI.
+ let alpha0. assume Halpha0J.
  let x y. assume HxGfam0. assume HyGfam0. assume HifamEq.
  claim HabGfam0 : abelian_group (apply_fun Gfam alpha0) (apply_fun multfam alpha0) (apply_fun efam alpha0) (apply_fun invfam alpha0).
  { exact (HabGfam alpha0 Halpha0J). }
  claim HgrpGfam0 : group_structure (apply_fun Gfam alpha0) (apply_fun multfam alpha0) (apply_fun efam alpha0) (apply_fun invfam alpha0).
  { exact (andEL
      (group_structure (apply_fun Gfam alpha0) (apply_fun multfam alpha0) (apply_fun efam alpha0) (apply_fun invfam alpha0))
      (forall u v:set, u :e apply_fun Gfam alpha0 -> v :e apply_fun Gfam alpha0 ->
        apply_fun (apply_fun multfam alpha0) (u, v) = apply_fun (apply_fun multfam alpha0) (v, u))
      HabGfam0). }
  apply (and6E
    (function_on (apply_fun multfam alpha0) (setprod (apply_fun Gfam alpha0) (apply_fun Gfam alpha0)) (apply_fun Gfam alpha0))
    (function_on (apply_fun invfam alpha0) (apply_fun Gfam alpha0) (apply_fun Gfam alpha0))
    (apply_fun efam alpha0 :e apply_fun Gfam alpha0)
    (forall u v w:set, u :e apply_fun Gfam alpha0 -> v :e apply_fun Gfam alpha0 -> w :e apply_fun Gfam alpha0 ->
      apply_fun (apply_fun multfam alpha0) (apply_fun (apply_fun multfam alpha0) (u, v), w) =
      apply_fun (apply_fun multfam alpha0) (u, apply_fun (apply_fun multfam alpha0) (v, w)))
    (forall u:set, u :e apply_fun Gfam alpha0 ->
      apply_fun (apply_fun multfam alpha0) (apply_fun efam alpha0, u) = u /\
      apply_fun (apply_fun multfam alpha0) (u, apply_fun efam alpha0) = u)
    (forall u:set, u :e apply_fun Gfam alpha0 ->
      apply_fun (apply_fun multfam alpha0) (u, apply_fun (apply_fun invfam alpha0) u) = apply_fun efam alpha0 /\
      apply_fun (apply_fun multfam alpha0) (apply_fun (apply_fun invfam alpha0) u, u) = apply_fun efam alpha0)
    HgrpGfam0).
  assume HmultFn0 HinvFn0 HeGfam0mem HassocGfam0 HidGfam0 HinvGfam0.
  claim Hhom_proj : forall alpha:set, alpha :e J ->
    group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha)
      (apply_fun Gfam alpha0) (apply_fun multfam alpha0)
      (apply_fun (graph J (fun al:set => graph (apply_fun Gfam al) (fun z:set =>
        if al = alpha0 then z else apply_fun efam alpha0))) alpha).
  {
    let alpha. assume HalphaJ.
    rewrite (apply_fun_graph J (fun al:set => graph (apply_fun Gfam al) (fun z:set =>
      if al = alpha0 then z else apply_fun efam alpha0)) alpha HalphaJ).
    claim HgrpGfam_alpha : group_structure (apply_fun Gfam alpha) (apply_fun multfam alpha) (apply_fun efam alpha) (apply_fun invfam alpha).
    { exact (andEL
        (group_structure (apply_fun Gfam alpha) (apply_fun multfam alpha) (apply_fun efam alpha) (apply_fun invfam alpha))
        (forall u v:set, u :e apply_fun Gfam alpha -> v :e apply_fun Gfam alpha ->
          apply_fun (apply_fun multfam alpha) (u, v) = apply_fun (apply_fun multfam alpha) (v, u))
        (HabGfam alpha HalphaJ)). }
    apply (and6E
      (function_on (apply_fun multfam alpha) (setprod (apply_fun Gfam alpha) (apply_fun Gfam alpha)) (apply_fun Gfam alpha))
      (function_on (apply_fun invfam alpha) (apply_fun Gfam alpha) (apply_fun Gfam alpha))
      (apply_fun efam alpha :e apply_fun Gfam alpha)
      (forall u v w:set, u :e apply_fun Gfam alpha -> v :e apply_fun Gfam alpha -> w :e apply_fun Gfam alpha ->
        apply_fun (apply_fun multfam alpha) (apply_fun (apply_fun multfam alpha) (u, v), w) =
        apply_fun (apply_fun multfam alpha) (u, apply_fun (apply_fun multfam alpha) (v, w)))
      (forall u:set, u :e apply_fun Gfam alpha ->
        apply_fun (apply_fun multfam alpha) (apply_fun efam alpha, u) = u /\
        apply_fun (apply_fun multfam alpha) (u, apply_fun efam alpha) = u)
      (forall u:set, u :e apply_fun Gfam alpha ->
        apply_fun (apply_fun multfam alpha) (u, apply_fun (apply_fun invfam alpha) u) = apply_fun efam alpha /\
        apply_fun (apply_fun multfam alpha) (apply_fun (apply_fun invfam alpha) u, u) = apply_fun efam alpha)
      HgrpGfam_alpha).
    assume HmultFn_alpha HinvFn_alpha HeGfam_alpha HassocGfam_alpha HidGfam_alpha HinvGfam_alpha.
    prove function_on (graph (apply_fun Gfam alpha) (fun z:set => if alpha = alpha0 then z else apply_fun efam alpha0))
        (apply_fun Gfam alpha) (apply_fun Gfam alpha0) /\
      (forall u v:set, u :e apply_fun Gfam alpha -> v :e apply_fun Gfam alpha ->
        apply_fun (graph (apply_fun Gfam alpha) (fun z:set => if alpha = alpha0 then z else apply_fun efam alpha0))
          (apply_fun (apply_fun multfam alpha) (u, v)) =
        apply_fun (apply_fun multfam alpha0)
          (apply_fun (graph (apply_fun Gfam alpha) (fun z:set => if alpha = alpha0 then z else apply_fun efam alpha0)) u,
           apply_fun (graph (apply_fun Gfam alpha) (fun z:set => if alpha = alpha0 then z else apply_fun efam alpha0)) v)).
    apply andI.
    - let z. assume HzGfam.
      rewrite (apply_fun_graph (apply_fun Gfam alpha) (fun z:set => if alpha = alpha0 then z else apply_fun efam alpha0) z HzGfam).
      apply (xm (alpha = alpha0)).
      * assume Heq. rewrite (If_i_1 (alpha = alpha0) z (apply_fun efam alpha0) Heq).
        rewrite <- Heq. exact HzGfam.
      * assume Hne. rewrite (If_i_0 (alpha = alpha0) z (apply_fun efam alpha0) Hne).
        exact HeGfam0mem.
    - let u v. assume HuGfam. assume HvGfam.
      claim Hmult_uv : apply_fun (apply_fun multfam alpha) (u, v) :e apply_fun Gfam alpha.
      { exact (HmultFn_alpha (u, v)
          (tuple_2_setprod_by_pair_Sigma (apply_fun Gfam alpha) (apply_fun Gfam alpha) u v HuGfam HvGfam)). }
      rewrite (apply_fun_graph (apply_fun Gfam alpha) (fun z:set => if alpha = alpha0 then z else apply_fun efam alpha0)
        (apply_fun (apply_fun multfam alpha) (u, v)) Hmult_uv).
      rewrite (apply_fun_graph (apply_fun Gfam alpha) (fun z:set => if alpha = alpha0 then z else apply_fun efam alpha0) u HuGfam).
      rewrite (apply_fun_graph (apply_fun Gfam alpha) (fun z:set => if alpha = alpha0 then z else apply_fun efam alpha0) v HvGfam).
      apply (xm (alpha = alpha0)).
      * assume Heq.
        rewrite (If_i_1 (alpha = alpha0) (apply_fun (apply_fun multfam alpha) (u, v)) (apply_fun efam alpha0) Heq).
        rewrite (If_i_1 (alpha = alpha0) u (apply_fun efam alpha0) Heq).
        rewrite (If_i_1 (alpha = alpha0) v (apply_fun efam alpha0) Heq).
        rewrite Heq. reflexivity.
      * assume Hne.
        rewrite (If_i_0 (alpha = alpha0) (apply_fun (apply_fun multfam alpha) (u, v)) (apply_fun efam alpha0) Hne).
        rewrite (If_i_0 (alpha = alpha0) u (apply_fun efam alpha0) Hne).
        rewrite (If_i_0 (alpha = alpha0) v (apply_fun efam alpha0) Hne).
        rewrite (andEL
          (apply_fun (apply_fun multfam alpha0) (apply_fun efam alpha0, apply_fun efam alpha0) = apply_fun efam alpha0)
          (apply_fun (apply_fun multfam alpha0) (apply_fun efam alpha0, apply_fun efam alpha0) = apply_fun efam alpha0)
          (HidGfam0 (apply_fun efam alpha0) HeGfam0mem)).
        reflexivity.
  }
  apply (Hext_cond (apply_fun Gfam alpha0) (apply_fun multfam alpha0) (apply_fun efam alpha0) (apply_fun invfam alpha0)
    HabGfam0
    (graph J (fun al:set => graph (apply_fun Gfam al) (fun z:set => if al = alpha0 then z else apply_fun efam alpha0)))
    Hhom_proj).
  let h. assume Hh_split.
  claim Hretract : forall z:set, z :e apply_fun Gfam alpha0 ->
    apply_fun h (apply_fun (apply_fun ifam alpha0) z) = z.
  {
    let z. assume HzGfam0.
    rewrite ((andER
      (group_homomorphism G multG (apply_fun Gfam alpha0) (apply_fun multfam alpha0) h)
      (forall al:set, al :e J -> forall z0:set, z0 :e apply_fun Gfam al ->
        apply_fun h (apply_fun (apply_fun ifam al) z0) =
        apply_fun (apply_fun (graph J (fun al0:set => graph (apply_fun Gfam al0) (fun z1:set =>
          if al0 = alpha0 then z1 else apply_fun efam alpha0))) al) z0)
      Hh_split) alpha0 Halpha0J z HzGfam0).
    rewrite (apply_fun_apply_fun_graph J
      (fun al0:set => graph (apply_fun Gfam al0) (fun z1:set => if al0 = alpha0 then z1 else apply_fun efam alpha0))
      alpha0 z Halpha0J).
    rewrite (apply_fun_graph (apply_fun Gfam alpha0)
      (fun z1:set => if alpha0 = alpha0 then z1 else apply_fun efam alpha0) z HzGfam0).
    claim Hself : alpha0 = alpha0. { reflexivity. }
    rewrite (If_i_1 (alpha0 = alpha0) z (apply_fun efam alpha0) Hself).
    reflexivity.
  }
  rewrite <- (Hretract x HxGfam0).
  rewrite HifamEq.
  exact (Hretract y HyGfam0).
+ apply (lemma67_1_converse G multG eG invG J
    (graph J (fun alpha:set => homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha)))
    Hgen_img).
  let H multH eH invH. assume HabH.
  let hfam'. assume Hhfam' : forall alpha:set, alpha :e J ->
    group_homomorphism
      (apply_fun (graph J (fun al:set => homomorphism_image (apply_fun Gfam al) (apply_fun ifam al))) alpha)
      multG H multH (apply_fun hfam' alpha).
  claim Hhfam_pre : forall alpha:set, alpha :e J ->
    group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) H multH
      (apply_fun (graph J (fun al:set => graph (apply_fun Gfam al) (fun z:set =>
        apply_fun (apply_fun hfam' al) (apply_fun (apply_fun ifam al) z)))) alpha).
  {
    let alpha. assume HalphaJ.
    rewrite (apply_fun_graph J (fun al:set => graph (apply_fun Gfam al) (fun z:set =>
      apply_fun (apply_fun hfam' al) (apply_fun (apply_fun ifam al) z))) alpha HalphaJ).
    claim Hhfam'_alpha : group_homomorphism (homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha))
      multG H multH (apply_fun hfam' alpha).
    { rewrite <- (apply_fun_graph J (fun al:set => homomorphism_image (apply_fun Gfam al) (apply_fun ifam al)) alpha HalphaJ).
      exact (Hhfam' alpha HalphaJ). }
    claim Hifam_alpha_hom : group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) G multG (apply_fun ifam alpha).
    { exact (Hifam_hom alpha HalphaJ). }
    claim HgrpGfam_alpha2 : group_structure (apply_fun Gfam alpha) (apply_fun multfam alpha) (apply_fun efam alpha) (apply_fun invfam alpha).
    { exact (andEL
        (group_structure (apply_fun Gfam alpha) (apply_fun multfam alpha) (apply_fun efam alpha) (apply_fun invfam alpha))
        (forall u v:set, u :e apply_fun Gfam alpha -> v :e apply_fun Gfam alpha ->
          apply_fun (apply_fun multfam alpha) (u, v) = apply_fun (apply_fun multfam alpha) (v, u))
        (HabGfam alpha HalphaJ)). }
    apply (and6E
      (function_on (apply_fun multfam alpha) (setprod (apply_fun Gfam alpha) (apply_fun Gfam alpha)) (apply_fun Gfam alpha))
      (function_on (apply_fun invfam alpha) (apply_fun Gfam alpha) (apply_fun Gfam alpha))
      (apply_fun efam alpha :e apply_fun Gfam alpha)
      (forall u v w:set, u :e apply_fun Gfam alpha -> v :e apply_fun Gfam alpha -> w :e apply_fun Gfam alpha ->
        apply_fun (apply_fun multfam alpha) (apply_fun (apply_fun multfam alpha) (u, v), w) =
        apply_fun (apply_fun multfam alpha) (u, apply_fun (apply_fun multfam alpha) (v, w)))
      (forall u:set, u :e apply_fun Gfam alpha ->
        apply_fun (apply_fun multfam alpha) (apply_fun efam alpha, u) = u /\
        apply_fun (apply_fun multfam alpha) (u, apply_fun efam alpha) = u)
      (forall u:set, u :e apply_fun Gfam alpha ->
        apply_fun (apply_fun multfam alpha) (u, apply_fun (apply_fun invfam alpha) u) = apply_fun efam alpha /\
        apply_fun (apply_fun multfam alpha) (apply_fun (apply_fun invfam alpha) u, u) = apply_fun efam alpha)
      HgrpGfam_alpha2).
    assume HmultFn_alpha2 HinvFn_alpha2 HeGfam_alpha2 HassocGfam_alpha2 HidGfam_alpha2 HinvGfam_alpha2.
    prove function_on (graph (apply_fun Gfam alpha) (fun z:set =>
          apply_fun (apply_fun hfam' alpha) (apply_fun (apply_fun ifam alpha) z)))
        (apply_fun Gfam alpha) H /\
      (forall u v:set, u :e apply_fun Gfam alpha -> v :e apply_fun Gfam alpha ->
        apply_fun (graph (apply_fun Gfam alpha) (fun z:set =>
            apply_fun (apply_fun hfam' alpha) (apply_fun (apply_fun ifam alpha) z)))
          (apply_fun (apply_fun multfam alpha) (u, v)) =
        apply_fun multH
          (apply_fun (graph (apply_fun Gfam alpha) (fun z:set =>
              apply_fun (apply_fun hfam' alpha) (apply_fun (apply_fun ifam alpha) z))) u,
           apply_fun (graph (apply_fun Gfam alpha) (fun z:set =>
              apply_fun (apply_fun hfam' alpha) (apply_fun (apply_fun ifam alpha) z))) v)).
    apply andI.
    - let z. assume HzGfam.
      rewrite (apply_fun_graph (apply_fun Gfam alpha) (fun z:set =>
        apply_fun (apply_fun hfam' alpha) (apply_fun (apply_fun ifam alpha) z)) z HzGfam).
      exact (group_homomorphism_function_on (homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha))
        multG H multH (apply_fun hfam' alpha) Hhfam'_alpha
        (apply_fun (apply_fun ifam alpha) z)
        (ReplI (apply_fun Gfam alpha) (apply_fun (apply_fun ifam alpha)) z HzGfam)).
    - let u v. assume HuGfam. assume HvGfam.
      claim Hmult_uv2 : apply_fun (apply_fun multfam alpha) (u, v) :e apply_fun Gfam alpha.
      { exact (HmultFn_alpha2 (u, v)
          (tuple_2_setprod_by_pair_Sigma (apply_fun Gfam alpha) (apply_fun Gfam alpha) u v HuGfam HvGfam)). }
      rewrite (apply_fun_graph (apply_fun Gfam alpha) (fun z:set =>
        apply_fun (apply_fun hfam' alpha) (apply_fun (apply_fun ifam alpha) z))
        (apply_fun (apply_fun multfam alpha) (u, v)) Hmult_uv2).
      rewrite (apply_fun_graph (apply_fun Gfam alpha) (fun z:set =>
        apply_fun (apply_fun hfam' alpha) (apply_fun (apply_fun ifam alpha) z)) u HuGfam).
      rewrite (apply_fun_graph (apply_fun Gfam alpha) (fun z:set =>
        apply_fun (apply_fun hfam' alpha) (apply_fun (apply_fun ifam alpha) z)) v HvGfam).
      rewrite (group_homomorphism_mult_rule (apply_fun Gfam alpha) (apply_fun multfam alpha) G multG
        (apply_fun ifam alpha) u v Hifam_alpha_hom HuGfam HvGfam).
      exact (group_homomorphism_mult_rule
        (homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha))
        multG H multH (apply_fun hfam' alpha)
        (apply_fun (apply_fun ifam alpha) u) (apply_fun (apply_fun ifam alpha) v)
        Hhfam'_alpha
        (ReplI (apply_fun Gfam alpha) (apply_fun (apply_fun ifam alpha)) u HuGfam)
        (ReplI (apply_fun Gfam alpha) (apply_fun (apply_fun ifam alpha)) v HvGfam)).
  }
  apply (Hext_cond H multH eH invH HabH
    (graph J (fun al:set => graph (apply_fun Gfam al) (fun z:set =>
      apply_fun (apply_fun hfam' al) (apply_fun (apply_fun ifam al) z))))
    Hhfam_pre).
  let h2. assume Hh2_split.
  witness h2. apply andI.
  - exact (andEL
      (group_homomorphism G multG H multH h2)
      (forall al:set, al :e J -> forall z0:set, z0 :e apply_fun Gfam al ->
        apply_fun h2 (apply_fun (apply_fun ifam al) z0) =
        apply_fun (apply_fun (graph J (fun al0:set => graph (apply_fun Gfam al0) (fun z1:set =>
          apply_fun (apply_fun hfam' al0) (apply_fun (apply_fun ifam al0) z1)))) al) z0)
      Hh2_split).
  - let alpha. assume HalphaJ. let x0. assume Hx0Img.
    claim Hx0Img2 : x0 :e homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha).
    { rewrite <- (apply_fun_graph J
        (fun al:set => homomorphism_image (apply_fun Gfam al) (apply_fun ifam al)) alpha HalphaJ).
      exact Hx0Img. }
    apply (ReplE_impred (apply_fun Gfam alpha) (apply_fun (apply_fun ifam alpha)) x0 Hx0Img2).
    let z'. assume Hz'Gfam. assume Hx0Eq.
    rewrite Hx0Eq.
    rewrite ((andER
      (group_homomorphism G multG H multH h2)
      (forall al:set, al :e J -> forall z0:set, z0 :e apply_fun Gfam al ->
        apply_fun h2 (apply_fun (apply_fun ifam al) z0) =
        apply_fun (apply_fun (graph J (fun al0:set => graph (apply_fun Gfam al0) (fun z1:set =>
          apply_fun (apply_fun hfam' al0) (apply_fun (apply_fun ifam al0) z1)))) al) z0)
      Hh2_split) alpha HalphaJ z' Hz'Gfam).
    rewrite (apply_fun_apply_fun_graph J
      (fun al0:set => graph (apply_fun Gfam al0) (fun z1:set =>
        apply_fun (apply_fun hfam' al0) (apply_fun (apply_fun ifam al0) z1)))
      alpha z' HalphaJ).
    exact (apply_fun_graph (apply_fun Gfam alpha) (fun z1:set =>
      apply_fun (apply_fun hfam' alpha) (apply_fun (apply_fun ifam alpha) z1)) z' Hz'Gfam).
Qed.

(** from S67 Thm 67.6 (line 2671 in algtop.tex): uniqueness of direct sums **)
(** LATEX VERSION: If G and G' are both external direct sums of {G_alpha} via **)
(** i_alpha and i'_alpha respectively, then there is a unique isomorphism **)
(** phi: G -> G' such that phi o i_alpha = i'_alpha. **)
(** EFFORT: 10 lines textbook, difficulty 4/10, USD 80 **)
(** Admin-approved-refactored per noticeboard proposal 1772540187 **)
(** Collected Alice 118 **)
(** Proven Alice **)
Theorem thm67_6_uniqueness_direct_sum :
  forall J Gfam multfam efam invfam G multG eG invG ifam G' multG' eG' invG' ifam':set,
  (forall alpha:set, alpha :e J ->
    abelian_group (apply_fun Gfam alpha) (apply_fun multfam alpha)
      (apply_fun efam alpha) (apply_fun invfam alpha)) ->
  abelian_group G multG eG invG ->
  abelian_group G' multG' eG' invG' ->
  (forall alpha:set, alpha :e J ->
    group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) G multG (apply_fun ifam alpha) /\
    (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
      apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) y -> x = y)) ->
  (forall alpha:set, alpha :e J ->
    group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) G' multG' (apply_fun ifam' alpha) /\
    (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
      apply_fun (apply_fun ifam' alpha) x = apply_fun (apply_fun ifam' alpha) y -> x = y)) ->
  direct_sum_of_subgroups G multG eG invG J
    (graph J (fun alpha:set => homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha))) ->
  direct_sum_of_subgroups G' multG' eG' invG' J
    (graph J (fun alpha:set => homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam' alpha))) ->
  exists phi:set,
    group_isomorphism G multG G' multG' phi /\
    (forall alpha:set, alpha :e J ->
      forall x:set, x :e apply_fun Gfam alpha ->
        apply_fun phi (apply_fun (apply_fun ifam alpha) x) =
          apply_fun (apply_fun ifam' alpha) x) /\
    (forall phi':set, group_isomorphism G multG G' multG' phi' ->
      (forall alpha:set, alpha :e J ->
        forall x:set, x :e apply_fun Gfam alpha ->
          apply_fun phi' (apply_fun (apply_fun ifam alpha) x) =
            apply_fun (apply_fun ifam' alpha) x) ->
      forall x:set, x :e G -> apply_fun phi' x = apply_fun phi x).
let J Gfam multfam efam invfam G multG eG invG ifam G' multG' eG' invG' ifam'.
assume HabFam HabG HabG' Hifam Hifam' HdsG HdsG'.
(** Universal property from direct sum of G **)
claim HupG : forall H multH eH invH:set,
    abelian_group H multH eH invH ->
    forall hfam:set, function_on hfam J (Power (setprod G H)) ->
      (forall alpha:set, alpha :e J ->
        group_homomorphism (apply_fun (graph J (fun alpha0:set => homomorphism_image (apply_fun Gfam alpha0) (apply_fun ifam alpha0))) alpha) multG H multH (apply_fun hfam alpha)) ->
      exists h:set,
        group_homomorphism G multG H multH h /\
        (forall alpha:set, alpha :e J ->
          forall x:set, x :e apply_fun (graph J (fun alpha0:set => homomorphism_image (apply_fun Gfam alpha0) (apply_fun ifam alpha0))) alpha ->
            apply_fun h x = apply_fun (apply_fun hfam alpha) x) /\
        (forall h':set, group_homomorphism G multG H multH h' ->
          (forall alpha:set, alpha :e J ->
            forall x:set, x :e apply_fun (graph J (fun alpha0:set => homomorphism_image (apply_fun Gfam alpha0) (apply_fun ifam alpha0))) alpha ->
              apply_fun h' x = apply_fun (apply_fun hfam alpha) x) ->
          forall x:set, x :e G -> apply_fun h' x = apply_fun h x).
{ exact (lemma67_1_extension_condition_direct_sum G multG eG invG J
    (graph J (fun alpha:set => homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha)))
    HdsG). }
(** Key Eps_i property: picking preimage under injective ifam_alpha **)
claim Heps_ifam : forall alpha x:set, alpha :e J -> x :e apply_fun Gfam alpha ->
  Eps_i (fun z:set => z :e apply_fun Gfam alpha /\ apply_fun (apply_fun ifam alpha) z = apply_fun (apply_fun ifam alpha) x) = x.
{
  let alpha x. assume Halpha Hx.
  claim Hwitness : x :e apply_fun Gfam alpha /\ apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) x.
  { apply andI. exact Hx. reflexivity. }
  claim Hz : (Eps_i (fun z:set => z :e apply_fun Gfam alpha /\ apply_fun (apply_fun ifam alpha) z = apply_fun (apply_fun ifam alpha) x)) :e apply_fun Gfam alpha /\ apply_fun (apply_fun ifam alpha) (Eps_i (fun z:set => z :e apply_fun Gfam alpha /\ apply_fun (apply_fun ifam alpha) z = apply_fun (apply_fun ifam alpha) x)) = apply_fun (apply_fun ifam alpha) x.
  { exact (Eps_i_ax (fun z:set => z :e apply_fun Gfam alpha /\ apply_fun (apply_fun ifam alpha) z = apply_fun (apply_fun ifam alpha) x) x Hwitness). }
  exact (andER
    (group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) G multG (apply_fun ifam alpha))
    (forall a b:set, a :e apply_fun Gfam alpha -> b :e apply_fun Gfam alpha ->
      apply_fun (apply_fun ifam alpha) a = apply_fun (apply_fun ifam alpha) b -> a = b)
    (Hifam alpha Halpha)
    (Eps_i (fun z:set => z :e apply_fun Gfam alpha /\ apply_fun (apply_fun ifam alpha) z = apply_fun (apply_fun ifam alpha) x))
    x
    (andEL
      ((Eps_i (fun z:set => z :e apply_fun Gfam alpha /\ apply_fun (apply_fun ifam alpha) z = apply_fun (apply_fun ifam alpha) x)) :e apply_fun Gfam alpha)
      (apply_fun (apply_fun ifam alpha) (Eps_i (fun z:set => z :e apply_fun Gfam alpha /\ apply_fun (apply_fun ifam alpha) z = apply_fun (apply_fun ifam alpha) x)) = apply_fun (apply_fun ifam alpha) x)
      Hz)
    Hx
    (andER
      ((Eps_i (fun z:set => z :e apply_fun Gfam alpha /\ apply_fun (apply_fun ifam alpha) z = apply_fun (apply_fun ifam alpha) x)) :e apply_fun Gfam alpha)
      (apply_fun (apply_fun ifam alpha) (Eps_i (fun z:set => z :e apply_fun Gfam alpha /\ apply_fun (apply_fun ifam alpha) z = apply_fun (apply_fun ifam alpha) x)) = apply_fun (apply_fun ifam alpha) x)
      Hz)).
}
(** Define transfer map: for each alpha, maps image(ifam_alpha) to G' **)
set hfam_fwd : set := graph J (fun alpha:set =>
  graph (homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha))
    (fun y:set => apply_fun (apply_fun ifam' alpha)
      (Eps_i (fun x:set => x :e apply_fun Gfam alpha /\ apply_fun (apply_fun ifam alpha) x = y)))).
(** Transfer map acts as ifam'_alpha o ifam_alpha^{-1} on image elements **)
claim Hfwd_apply : forall alpha x:set, alpha :e J -> x :e apply_fun Gfam alpha ->
  apply_fun (apply_fun hfam_fwd alpha)
    (apply_fun (apply_fun ifam alpha) x) =
  apply_fun (apply_fun ifam' alpha) x.
{
  let alpha x. assume Halpha Hx.
  claim Hrew : apply_fun (apply_fun hfam_fwd alpha)
    (apply_fun (apply_fun ifam alpha) x) =
    apply_fun (apply_fun ifam' alpha)
      (Eps_i (fun z:set => z :e apply_fun Gfam alpha /\ apply_fun (apply_fun ifam alpha) z = apply_fun (apply_fun ifam alpha) x)).
  { claim Hix_in_img : apply_fun (apply_fun ifam alpha) x :e homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha).
    { exact (ReplI (apply_fun Gfam alpha) (fun z:set => apply_fun (apply_fun ifam alpha) z) x Hx). }
    claim Hstep_outer : apply_fun (apply_fun hfam_fwd alpha)
      (apply_fun (apply_fun ifam alpha) x) =
      apply_fun (graph (homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha))
        (fun y:set => apply_fun (apply_fun ifam' alpha)
          (Eps_i (fun z:set => z :e apply_fun Gfam alpha /\ apply_fun (apply_fun ifam alpha) z = y))))
      (apply_fun (apply_fun ifam alpha) x).
    { exact (apply_fun_apply_fun_graph J
        (fun alpha0:set =>
          graph (homomorphism_image (apply_fun Gfam alpha0) (apply_fun ifam alpha0))
            (fun y:set => apply_fun (apply_fun ifam' alpha0)
              (Eps_i (fun z:set => z :e apply_fun Gfam alpha0 /\ apply_fun (apply_fun ifam alpha0) z = y))))
        alpha (apply_fun (apply_fun ifam alpha) x) Halpha). }
    rewrite Hstep_outer.
    exact (apply_fun_graph (homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha))
      (fun y:set => apply_fun (apply_fun ifam' alpha)
        (Eps_i (fun z:set => z :e apply_fun Gfam alpha /\ apply_fun (apply_fun ifam alpha) z = y)))
      (apply_fun (apply_fun ifam alpha) x) Hix_in_img). }
  rewrite Hrew.
  rewrite (Heps_ifam alpha x Halpha Hx).
  reflexivity.
}
(** The remaining parts are admitted for now while we test compilation **)
(** hfam_fwd satisfies function_on and homomorphism requirements **)
claim Hfwd_fn : function_on hfam_fwd J (Power (setprod G G')).
{ let alpha. assume Halpha.
  rewrite (apply_fun_graph J (fun alpha0:set =>
    graph (homomorphism_image (apply_fun Gfam alpha0) (apply_fun ifam alpha0))
      (fun y:set => apply_fun (apply_fun ifam' alpha0)
        (Eps_i (fun z:set => z :e apply_fun Gfam alpha0 /\ apply_fun (apply_fun ifam alpha0) z = y))))
    alpha Halpha).
  apply PowerI.
  claim Himg_sub_G : homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha) c= G.
  { let y. assume Hy.
    apply (ReplE_impred (apply_fun Gfam alpha) (fun z:set => apply_fun (apply_fun ifam alpha) z) y Hy).
    let z. assume Hz Hyz.
    rewrite Hyz.
    exact (andEL (function_on (apply_fun ifam alpha) (apply_fun Gfam alpha) G)
      (forall u v:set, u :e apply_fun Gfam alpha -> v :e apply_fun Gfam alpha ->
        apply_fun (apply_fun ifam alpha) (apply_fun (apply_fun multfam alpha) (u, v)) = apply_fun multG (apply_fun (apply_fun ifam alpha) u, apply_fun (apply_fun ifam alpha) v))
      (andEL
        (group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) G multG (apply_fun ifam alpha))
        (forall a b:set, a :e apply_fun Gfam alpha -> b :e apply_fun Gfam alpha ->
          apply_fun (apply_fun ifam alpha) a = apply_fun (apply_fun ifam alpha) b -> a = b)
        (Hifam alpha Halpha)))
      z Hz. }
  claim Hvals_in_G' : forall y:set, y :e homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha) ->
    apply_fun (apply_fun ifam' alpha)
      (Eps_i (fun z:set => z :e apply_fun Gfam alpha /\ apply_fun (apply_fun ifam alpha) z = y)) :e G'.
  { let y. assume Hy.
    apply (ReplE_impred (apply_fun Gfam alpha) (fun z:set => apply_fun (apply_fun ifam alpha) z) y Hy).
    let z. assume Hz Hyz.
    claim Hwitness : z :e apply_fun Gfam alpha /\ apply_fun (apply_fun ifam alpha) z = y.
    { apply andI. exact Hz. symmetry. exact Hyz. }
    claim Heps_mem : (Eps_i (fun w:set => w :e apply_fun Gfam alpha /\ apply_fun (apply_fun ifam alpha) w = y)) :e apply_fun Gfam alpha.
    { exact (andEL
        ((Eps_i (fun w:set => w :e apply_fun Gfam alpha /\ apply_fun (apply_fun ifam alpha) w = y)) :e apply_fun Gfam alpha)
        (apply_fun (apply_fun ifam alpha) (Eps_i (fun w:set => w :e apply_fun Gfam alpha /\ apply_fun (apply_fun ifam alpha) w = y)) = y)
        (Eps_i_ax (fun w:set => w :e apply_fun Gfam alpha /\ apply_fun (apply_fun ifam alpha) w = y) z Hwitness)). }
    exact (andEL (function_on (apply_fun ifam' alpha) (apply_fun Gfam alpha) G')
      (forall u v:set, u :e apply_fun Gfam alpha -> v :e apply_fun Gfam alpha ->
        apply_fun (apply_fun ifam' alpha) (apply_fun (apply_fun multfam alpha) (u, v)) = apply_fun multG' (apply_fun (apply_fun ifam' alpha) u, apply_fun (apply_fun ifam' alpha) v))
      (andEL
        (group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) G' multG' (apply_fun ifam' alpha))
        (forall a b:set, a :e apply_fun Gfam alpha -> b :e apply_fun Gfam alpha ->
          apply_fun (apply_fun ifam' alpha) a = apply_fun (apply_fun ifam' alpha) b -> a = b)
        (Hifam' alpha Halpha)))
      (Eps_i (fun w:set => w :e apply_fun Gfam alpha /\ apply_fun (apply_fun ifam alpha) w = y))
      Heps_mem. }
  exact (Subq_tra
    (graph (homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha))
      (fun y:set => apply_fun (apply_fun ifam' alpha)
        (Eps_i (fun z:set => z :e apply_fun Gfam alpha /\ apply_fun (apply_fun ifam alpha) z = y))))
    (setprod (homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha)) G')
    (setprod G G')
    (graph_subset_setprod (homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha)) G'
      (fun y:set => apply_fun (apply_fun ifam' alpha)
        (Eps_i (fun z:set => z :e apply_fun Gfam alpha /\ apply_fun (apply_fun ifam alpha) z = y)))
      Hvals_in_G')
    (setprod_Subq (homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha)) G' G G'
      Himg_sub_G (Subq_ref G'))). }
claim Hfwd_hom : forall alpha:set, alpha :e J ->
  group_homomorphism (apply_fun (graph J (fun alpha0:set => homomorphism_image (apply_fun Gfam alpha0) (apply_fun ifam alpha0))) alpha) multG G' multG' (apply_fun hfam_fwd alpha).
{ let alpha. assume Halpha.
  rewrite (apply_fun_graph J (fun alpha0:set => homomorphism_image (apply_fun Gfam alpha0) (apply_fun ifam alpha0)) alpha Halpha).
  claim Hfwd_fun : function_on (apply_fun hfam_fwd alpha)
    (homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha)) G'.
  { (** function_on: apply_fun hfam_fwd alpha maps hom_image to G' **)
    let y. assume Hy.
    apply (ReplE_impred (apply_fun Gfam alpha) (fun z:set => apply_fun (apply_fun ifam alpha) z) y Hy).
    let z. assume Hz Hyz.
    rewrite Hyz.
    rewrite (Hfwd_apply alpha z Halpha Hz).
    exact (andEL (function_on (apply_fun ifam' alpha) (apply_fun Gfam alpha) G')
      (forall u v:set, u :e apply_fun Gfam alpha -> v :e apply_fun Gfam alpha ->
        apply_fun (apply_fun ifam' alpha) (apply_fun (apply_fun multfam alpha) (u, v)) = apply_fun multG' (apply_fun (apply_fun ifam' alpha) u, apply_fun (apply_fun ifam' alpha) v))
      (andEL
        (group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) G' multG' (apply_fun ifam' alpha))
        (forall a b:set, a :e apply_fun Gfam alpha -> b :e apply_fun Gfam alpha ->
          apply_fun (apply_fun ifam' alpha) a = apply_fun (apply_fun ifam' alpha) b -> a = b)
        (Hifam' alpha Halpha)))
      z Hz. }
  claim Hfwd_mult : forall x y:set,
    x :e homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha) ->
    y :e homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha) ->
    apply_fun (apply_fun hfam_fwd alpha) (apply_fun multG (x, y)) =
      apply_fun multG' (apply_fun (apply_fun hfam_fwd alpha) x, apply_fun (apply_fun hfam_fwd alpha) y).
  { (** mult preservation **)
    let x y. assume Hx Hy.
    (** x = ifam(a), y = ifam(b) for some a, b in Gfam alpha **)
    apply (ReplE_impred (apply_fun Gfam alpha) (fun z:set => apply_fun (apply_fun ifam alpha) z) x Hx).
    let a. assume Ha Hxa.
    apply (ReplE_impred (apply_fun Gfam alpha) (fun z:set => apply_fun (apply_fun ifam alpha) z) y Hy).
    let b. assume Hb Hyb.
    (** Rewrite x and y **)
    rewrite Hxa. rewrite Hyb.
    (** LHS: hfam_fwd(multG(ifam(a), ifam(b))) **)
    (** Use homomorphism of ifam: multG(ifam(a), ifam(b)) = ifam(multfam(a,b)) **)
    claim Hifam_hom_ab : apply_fun (apply_fun ifam alpha) (apply_fun (apply_fun multfam alpha) (a, b)) =
      apply_fun multG (apply_fun (apply_fun ifam alpha) a, apply_fun (apply_fun ifam alpha) b).
    { exact (andER
        (function_on (apply_fun ifam alpha) (apply_fun Gfam alpha) G)
        (forall u v:set, u :e apply_fun Gfam alpha -> v :e apply_fun Gfam alpha ->
          apply_fun (apply_fun ifam alpha) (apply_fun (apply_fun multfam alpha) (u, v)) = apply_fun multG (apply_fun (apply_fun ifam alpha) u, apply_fun (apply_fun ifam alpha) v))
        (andEL
          (group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) G multG (apply_fun ifam alpha))
          (forall u v:set, u :e apply_fun Gfam alpha -> v :e apply_fun Gfam alpha ->
            apply_fun (apply_fun ifam alpha) u = apply_fun (apply_fun ifam alpha) v -> u = v)
          (Hifam alpha Halpha))
        a b Ha Hb). }
    claim Hifam_hom_sym : apply_fun multG (apply_fun (apply_fun ifam alpha) a, apply_fun (apply_fun ifam alpha) b) =
      apply_fun (apply_fun ifam alpha) (apply_fun (apply_fun multfam alpha) (a, b)).
    { symmetry. exact Hifam_hom_ab. }
    rewrite Hifam_hom_sym.
    (** LHS is now hfam_fwd(ifam(multfam(a,b))). We need multfam(a,b) :e Gfam alpha for Hfwd_apply. **)
    (** Use group_structure on Gfam alpha to obtain closure under multfam. **)
    claim Hmult_closed : apply_fun (apply_fun multfam alpha) (a, b) :e apply_fun Gfam alpha.
    {
      exact (group_source_mult_closure
        (apply_fun Gfam alpha) (apply_fun multfam alpha)
        (apply_fun efam alpha) (apply_fun invfam alpha)
        (abelian_group_implies_group_structure
          (apply_fun Gfam alpha) (apply_fun multfam alpha)
          (apply_fun efam alpha) (apply_fun invfam alpha)
          (HabFam alpha Halpha))
        a b Ha Hb).
    }
    rewrite (Hfwd_apply alpha (apply_fun (apply_fun multfam alpha) (a, b)) Halpha Hmult_closed).
    (** RHS: multG'(hfam_fwd(ifam(a)), hfam_fwd(ifam(b))) = multG'(ifam'(a), ifam'(b)) **)
    rewrite (Hfwd_apply alpha a Halpha Ha).
    rewrite (Hfwd_apply alpha b Halpha Hb).
    (** Need: ifam'(multfam(a,b)) = multG'(ifam'(a), ifam'(b)) **)
    exact (andER
      (function_on (apply_fun ifam' alpha) (apply_fun Gfam alpha) G')
      (forall u v:set, u :e apply_fun Gfam alpha -> v :e apply_fun Gfam alpha ->
        apply_fun (apply_fun ifam' alpha) (apply_fun (apply_fun multfam alpha) (u, v)) = apply_fun multG' (apply_fun (apply_fun ifam' alpha) u, apply_fun (apply_fun ifam' alpha) v))
      (andEL
        (group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) G' multG' (apply_fun ifam' alpha))
        (forall u v:set, u :e apply_fun Gfam alpha -> v :e apply_fun Gfam alpha ->
          apply_fun (apply_fun ifam' alpha) u = apply_fun (apply_fun ifam' alpha) v -> u = v)
        (Hifam' alpha Halpha))
      a b Ha Hb). }
  exact (andI
    (function_on (apply_fun hfam_fwd alpha)
      (homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha)) G')
    (forall x y:set,
      x :e homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha) ->
      y :e homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha) ->
      apply_fun (apply_fun hfam_fwd alpha) (apply_fun multG (x, y)) =
        apply_fun multG' (apply_fun (apply_fun hfam_fwd alpha) x, apply_fun (apply_fun hfam_fwd alpha) y))
    Hfwd_fun
    Hfwd_mult).
}
(** Get phi: G -> G' **)
claim Hphi_raw : exists h:set,
  group_homomorphism G multG G' multG' h /\
  (forall alpha:set, alpha :e J ->
    forall x:set, x :e apply_fun (graph J (fun alpha0:set => homomorphism_image (apply_fun Gfam alpha0) (apply_fun ifam alpha0))) alpha ->
      apply_fun h x = apply_fun (apply_fun hfam_fwd alpha) x) /\
  (forall h':set, group_homomorphism G multG G' multG' h' ->
    (forall alpha:set, alpha :e J ->
      forall x:set, x :e apply_fun (graph J (fun alpha0:set => homomorphism_image (apply_fun Gfam alpha0) (apply_fun ifam alpha0))) alpha ->
        apply_fun h' x = apply_fun (apply_fun hfam_fwd alpha) x) ->
    forall x:set, x :e G -> apply_fun h' x = apply_fun h x).
{ exact (HupG G' multG' eG' invG' HabG' hfam_fwd Hfwd_fn Hfwd_hom). }
apply Hphi_raw.
let phi. assume Hphi_all.
(** Extract components of Hphi_all **)
claim Hphi_hom : group_homomorphism G multG G' multG' phi.
{ apply (and3E
    (group_homomorphism G multG G' multG' phi)
    (forall alpha:set, alpha :e J ->
      forall x:set, x :e apply_fun (graph J (fun alpha0:set => homomorphism_image (apply_fun Gfam alpha0) (apply_fun ifam alpha0))) alpha ->
        apply_fun phi x = apply_fun (apply_fun hfam_fwd alpha) x)
    (forall h':set, group_homomorphism G multG G' multG' h' ->
      (forall alpha:set, alpha :e J ->
        forall x:set, x :e apply_fun (graph J (fun alpha0:set => homomorphism_image (apply_fun Gfam alpha0) (apply_fun ifam alpha0))) alpha ->
          apply_fun h' x = apply_fun (apply_fun hfam_fwd alpha) x) ->
      forall x:set, x :e G -> apply_fun h' x = apply_fun phi x)
    Hphi_all).
  assume H1 _ _. exact H1. }
claim Hphi_ext : forall alpha:set, alpha :e J ->
  forall x:set, x :e apply_fun (graph J (fun alpha0:set => homomorphism_image (apply_fun Gfam alpha0) (apply_fun ifam alpha0))) alpha ->
    apply_fun phi x = apply_fun (apply_fun hfam_fwd alpha) x.
{ apply (and3E
    (group_homomorphism G multG G' multG' phi)
    (forall alpha:set, alpha :e J ->
      forall x:set, x :e apply_fun (graph J (fun alpha0:set => homomorphism_image (apply_fun Gfam alpha0) (apply_fun ifam alpha0))) alpha ->
        apply_fun phi x = apply_fun (apply_fun hfam_fwd alpha) x)
    (forall h':set, group_homomorphism G multG G' multG' h' ->
      (forall alpha:set, alpha :e J ->
        forall x:set, x :e apply_fun (graph J (fun alpha0:set => homomorphism_image (apply_fun Gfam alpha0) (apply_fun ifam alpha0))) alpha ->
          apply_fun h' x = apply_fun (apply_fun hfam_fwd alpha) x) ->
      forall x:set, x :e G -> apply_fun h' x = apply_fun phi x)
    Hphi_all).
  assume _ H2 _. exact H2. }
claim Hphi_uniq : forall h':set, group_homomorphism G multG G' multG' h' ->
  (forall alpha:set, alpha :e J ->
    forall x:set, x :e apply_fun (graph J (fun alpha0:set => homomorphism_image (apply_fun Gfam alpha0) (apply_fun ifam alpha0))) alpha ->
      apply_fun h' x = apply_fun (apply_fun hfam_fwd alpha) x) ->
  forall x:set, x :e G -> apply_fun h' x = apply_fun phi x.
{ apply (and3E
    (group_homomorphism G multG G' multG' phi)
    (forall alpha:set, alpha :e J ->
      forall x:set, x :e apply_fun (graph J (fun alpha0:set => homomorphism_image (apply_fun Gfam alpha0) (apply_fun ifam alpha0))) alpha ->
        apply_fun phi x = apply_fun (apply_fun hfam_fwd alpha) x)
    (forall h':set, group_homomorphism G multG G' multG' h' ->
      (forall alpha:set, alpha :e J ->
        forall x:set, x :e apply_fun (graph J (fun alpha0:set => homomorphism_image (apply_fun Gfam alpha0) (apply_fun ifam alpha0))) alpha ->
          apply_fun h' x = apply_fun (apply_fun hfam_fwd alpha) x) ->
      forall x:set, x :e G -> apply_fun h' x = apply_fun phi x)
    Hphi_all).
  assume _ _ H3. exact H3. }
(** phi sends ifam_alpha(x) to ifam'_alpha(x) **)
claim Hphi_transfer : forall alpha:set, alpha :e J ->
  forall x:set, x :e apply_fun Gfam alpha ->
    apply_fun phi (apply_fun (apply_fun ifam alpha) x) =
    apply_fun (apply_fun ifam' alpha) x.
{
  let alpha. assume Halpha.
  let x. assume Hx.
  claim Hix_in_sub : apply_fun (apply_fun ifam alpha) x :e apply_fun (graph J (fun alpha0:set => homomorphism_image (apply_fun Gfam alpha0) (apply_fun ifam alpha0))) alpha.
  { rewrite (apply_fun_graph J (fun alpha0:set => homomorphism_image (apply_fun Gfam alpha0) (apply_fun ifam alpha0)) alpha Halpha).
    exact (ReplI (apply_fun Gfam alpha) (fun z:set => apply_fun (apply_fun ifam alpha) z) x Hx). }
  claim Hstep1 : apply_fun phi (apply_fun (apply_fun ifam alpha) x) =
    apply_fun (apply_fun hfam_fwd alpha) (apply_fun (apply_fun ifam alpha) x).
  { exact (Hphi_ext alpha Halpha (apply_fun (apply_fun ifam alpha) x) Hix_in_sub). }
  rewrite Hstep1.
  exact (Hfwd_apply alpha x Halpha Hx).
}
(** Witness phi and prove the three conjuncts **)
witness phi.
apply and3I.
- (** group_isomorphism G multG G' multG' phi **)
  claim Hphi_bij : bijection G G' phi.
  { (** bijection via inverse construction using lemma67_5 **)
    (** Extract group structures **)
    claim HgrpG : group_structure G multG eG invG.
    { exact (andEL
        (group_structure G multG eG invG)
        (forall x y:set, x :e G -> y :e G -> apply_fun multG (x, y) = apply_fun multG (y, x))
        HabG). }
    claim HgrpG' : group_structure G' multG' eG' invG'.
    { exact (andEL
        (group_structure G' multG' eG' invG')
        (forall x y:set, x :e G' -> y :e G' -> apply_fun multG' (x, y) = apply_fun multG' (y, x))
        HabG'). }
    (** Extract hom-only from Hifam, Hifam' **)
    claim Hifam_hom_only : forall alpha:set, alpha :e J ->
      group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) G multG (apply_fun ifam alpha).
    { let alpha. assume Hal.
      exact (andEL
        (group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) G multG (apply_fun ifam alpha))
        (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
          apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) y -> x = y)
        (Hifam alpha Hal)). }
    claim Hifam'_hom_only : forall alpha:set, alpha :e J ->
      group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) G' multG' (apply_fun ifam' alpha).
    { let alpha. assume Hal.
      exact (andEL
        (group_homomorphism (apply_fun Gfam alpha) (apply_fun multfam alpha) G' multG' (apply_fun ifam' alpha))
        (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
          apply_fun (apply_fun ifam' alpha) x = apply_fun (apply_fun ifam' alpha) y -> x = y)
        (Hifam' alpha Hal)). }
    (** Get psi: G' -> G via lemma67_5 applied symmetrically **)
    claim Hpsi_ex : exists h:set,
      group_homomorphism G' multG' G multG h /\
      (forall alpha:set, alpha :e J ->
        forall x:set, x :e apply_fun Gfam alpha ->
          apply_fun h (apply_fun (apply_fun ifam' alpha) x) =
            apply_fun (apply_fun ifam alpha) x) /\
      (forall h':set, group_homomorphism G' multG' G multG h' ->
        (forall alpha:set, alpha :e J ->
          forall x:set, x :e apply_fun Gfam alpha ->
            apply_fun h' (apply_fun (apply_fun ifam' alpha) x) =
              apply_fun (apply_fun ifam alpha) x) ->
        forall x:set, x :e G' -> apply_fun h' x = apply_fun h x).
    { claim Hgfam_grp : forall alpha:set, alpha :e J ->
        group_structure (apply_fun Gfam alpha) (apply_fun multfam alpha)
          (apply_fun efam alpha) (apply_fun invfam alpha).
      { let alpha. assume Hal.
        exact (abelian_group_implies_group_structure
          (apply_fun Gfam alpha) (apply_fun multfam alpha)
          (apply_fun efam alpha) (apply_fun invfam alpha)
          (HabFam alpha Hal)). }
      exact (lemma67_5_extension_external
        G' multG' eG' invG' J Gfam multfam efam invfam ifam'
        HabG'
        Hgfam_grp
        Hifam'
        HdsG'
        G multG eG invG
        HabG
        ifam
        Hifam_hom_only). }
    apply Hpsi_ex. let psi. assume Hpsi_all.
    apply (and3E
      (group_homomorphism G' multG' G multG psi)
      (forall alpha:set, alpha :e J ->
        forall x:set, x :e apply_fun Gfam alpha ->
          apply_fun psi (apply_fun (apply_fun ifam' alpha) x) =
            apply_fun (apply_fun ifam alpha) x)
      (forall h':set, group_homomorphism G' multG' G multG h' ->
        (forall alpha:set, alpha :e J ->
          forall x:set, x :e apply_fun Gfam alpha ->
            apply_fun h' (apply_fun (apply_fun ifam' alpha) x) =
              apply_fun (apply_fun ifam alpha) x) ->
        forall x:set, x :e G' -> apply_fun h' x = apply_fun psi x)
      Hpsi_all).
    assume Hpsi_hom : group_homomorphism G' multG' G multG psi.
    assume Hpsi_ext : forall alpha:set, alpha :e J ->
      forall x:set, x :e apply_fun Gfam alpha ->
        apply_fun psi (apply_fun (apply_fun ifam' alpha) x) =
          apply_fun (apply_fun ifam alpha) x.
    assume Hpsi_uniq : forall h':set, group_homomorphism G' multG' G multG h' ->
      (forall alpha:set, alpha :e J ->
        forall x:set, x :e apply_fun Gfam alpha ->
          apply_fun h' (apply_fun (apply_fun ifam' alpha) x) =
            apply_fun (apply_fun ifam alpha) x) ->
      forall x:set, x :e G' -> apply_fun h' x = apply_fun psi x.
    claim Hphi_fo : function_on phi G G'.
    { exact (group_homomorphism_function_on G multG G' multG' phi Hphi_hom). }
    claim Hpsi_fo : function_on psi G' G.
    { exact (group_homomorphism_function_on G' multG' G multG psi Hpsi_hom). }
    (** h_id: G -> G extending identity on generators, with uniqueness **)
    claim Hid_ex : exists h:set,
      group_homomorphism G multG G multG h /\
      (forall alpha:set, alpha :e J ->
        forall x:set, x :e apply_fun Gfam alpha ->
          apply_fun h (apply_fun (apply_fun ifam alpha) x) =
            apply_fun (apply_fun ifam alpha) x) /\
      (forall h':set, group_homomorphism G multG G multG h' ->
        (forall alpha:set, alpha :e J ->
          forall x:set, x :e apply_fun Gfam alpha ->
            apply_fun h' (apply_fun (apply_fun ifam alpha) x) =
              apply_fun (apply_fun ifam alpha) x) ->
        forall x:set, x :e G -> apply_fun h' x = apply_fun h x).
    { claim Hgfam_grp2 : forall alpha:set, alpha :e J ->
        group_structure (apply_fun Gfam alpha) (apply_fun multfam alpha)
          (apply_fun efam alpha) (apply_fun invfam alpha).
      { let alpha. assume Hal.
        exact (abelian_group_implies_group_structure
          (apply_fun Gfam alpha) (apply_fun multfam alpha)
          (apply_fun efam alpha) (apply_fun invfam alpha)
          (HabFam alpha Hal)). }
      exact (lemma67_5_extension_external
        G multG eG invG J Gfam multfam efam invfam ifam
        HabG
        Hgfam_grp2
        Hifam
        HdsG
        G multG eG invG
        HabG
        ifam
        Hifam_hom_only). }
    apply Hid_ex. let h_id. assume Hid_all.
    apply (and3E
      (group_homomorphism G multG G multG h_id)
      (forall alpha:set, alpha :e J ->
        forall x:set, x :e apply_fun Gfam alpha ->
          apply_fun h_id (apply_fun (apply_fun ifam alpha) x) =
            apply_fun (apply_fun ifam alpha) x)
      (forall h':set, group_homomorphism G multG G multG h' ->
        (forall alpha:set, alpha :e J ->
          forall x:set, x :e apply_fun Gfam alpha ->
            apply_fun h' (apply_fun (apply_fun ifam alpha) x) =
              apply_fun (apply_fun ifam alpha) x) ->
        forall x:set, x :e G -> apply_fun h' x = apply_fun h_id x)
      Hid_all).
    assume Hid_hom : group_homomorphism G multG G multG h_id.
    assume Hid_ext : forall alpha:set, alpha :e J ->
      forall x:set, x :e apply_fun Gfam alpha ->
        apply_fun h_id (apply_fun (apply_fun ifam alpha) x) =
          apply_fun (apply_fun ifam alpha) x.
    assume Hid_uniq : forall h':set, group_homomorphism G multG G multG h' ->
      (forall alpha:set, alpha :e J ->
        forall x:set, x :e apply_fun Gfam alpha ->
          apply_fun h' (apply_fun (apply_fun ifam alpha) x) =
            apply_fun (apply_fun ifam alpha) x) ->
      forall x:set, x :e G -> apply_fun h' x = apply_fun h_id x.
    (** id_G: identity function on G is a group homomorphism **)
    set id_G := graph G (fun x:set => x).
    claim Hid_G_hom : group_homomorphism G multG G multG id_G.
    { prove function_on id_G G G /\
        (forall x y:set, x :e G -> y :e G ->
          apply_fun id_G (apply_fun multG (x, y)) = apply_fun multG (apply_fun id_G x, apply_fun id_G y)).
      apply andI.
      - let x. assume Hx : x :e G.
        rewrite (apply_fun_graph G (fun z:set => z) x Hx). exact Hx.
      - let x y. assume Hx : x :e G. assume Hy : y :e G.
        claim HxyG : apply_fun multG (x, y) :e G.
        { apply (and6E
            (function_on multG (setprod G G) G) (function_on invG G G) (eG :e G)
            (forall x0 y0 z:set, x0 :e G -> y0 :e G -> z :e G ->
              apply_fun multG (apply_fun multG (x0, y0), z) = apply_fun multG (x0, apply_fun multG (y0, z)))
            (forall x0:set, x0 :e G -> apply_fun multG (eG, x0) = x0 /\ apply_fun multG (x0, eG) = x0)
            (forall x0:set, x0 :e G ->
              apply_fun multG (x0, apply_fun invG x0) = eG /\ apply_fun multG (apply_fun invG x0, x0) = eG)
            HgrpG).
          assume Hmult_fo _ _ _ _ _.
          exact (Hmult_fo (x, y) (tuple_2_setprod_by_pair_Sigma G G x y Hx Hy)). }
        rewrite (apply_fun_graph G (fun z:set => z) (apply_fun multG (x, y)) HxyG).
        rewrite (apply_fun_graph G (fun z:set => z) x Hx).
        rewrite (apply_fun_graph G (fun z:set => z) y Hy).
        reflexivity. }
    claim Hid_G_ext : forall alpha:set, alpha :e J ->
      forall x:set, x :e apply_fun Gfam alpha ->
        apply_fun id_G (apply_fun (apply_fun ifam alpha) x) =
          apply_fun (apply_fun ifam alpha) x.
    { let alpha. assume Hal. let x. assume Hx.
      claim Hifx_G : apply_fun (apply_fun ifam alpha) x :e G.
      { exact (group_homomorphism_function_on (apply_fun Gfam alpha) (apply_fun multfam alpha) G multG
          (apply_fun ifam alpha) (Hifam_hom_only alpha Hal) x Hx). }
      exact (apply_fun_graph G (fun z:set => z) (apply_fun (apply_fun ifam alpha) x) Hifx_G). }
    (** h_id agrees with identity on G **)
    claim Hid_G_agrees : forall x:set, x :e G -> apply_fun h_id x = x.
    { let x. assume Hx.
      claim Hid_eq : apply_fun id_G x = apply_fun h_id x.
      { exact (Hid_uniq id_G Hid_G_hom Hid_G_ext x Hx). }
      claim Hid_eq_sym : apply_fun h_id x = apply_fun id_G x.
      { symmetry. exact Hid_eq. }
      claim Hid_val : apply_fun id_G x = x.
      { exact (apply_fun_graph G (fun z:set => z) x Hx). }
      exact (eq_i_tra (apply_fun h_id x) (apply_fun id_G x) x Hid_eq_sym Hid_val). }
    (** comp_psi_phi: composition psi o phi as group homomorphism G -> G **)
    set comp_psi_phi := compose_fun G phi psi.
    claim Hcomp_hom : group_homomorphism G multG G multG comp_psi_phi.
    { exact (group_homomorphism_compose_cyclic_helper G multG eG invG G' multG' G multG
        phi psi HgrpG Hphi_hom Hpsi_hom). }
    claim Hcomp_ext : forall alpha:set, alpha :e J ->
      forall x:set, x :e apply_fun Gfam alpha ->
        apply_fun comp_psi_phi (apply_fun (apply_fun ifam alpha) x) =
          apply_fun (apply_fun ifam alpha) x.
    { let alpha. assume Hal. let x. assume Hx.
      claim Hifx_G : apply_fun (apply_fun ifam alpha) x :e G.
      { exact (group_homomorphism_function_on (apply_fun Gfam alpha) (apply_fun multfam alpha) G multG
          (apply_fun ifam alpha) (Hifam_hom_only alpha Hal) x Hx). }
      rewrite (compose_fun_apply G phi psi (apply_fun (apply_fun ifam alpha) x) Hifx_G).
      rewrite (Hphi_transfer alpha Hal x Hx).
      exact (Hpsi_ext alpha Hal x Hx). }
    (** psi o phi = identity on G **)
    claim Hpsi_phi_id : forall x:set, x :e G -> apply_fun psi (apply_fun phi x) = x.
    { let x. assume Hx.
      claim Hcomp_hid : apply_fun comp_psi_phi x = apply_fun h_id x.
      { exact (Hid_uniq comp_psi_phi Hcomp_hom Hcomp_ext x Hx). }
      claim Hcomp_val : apply_fun comp_psi_phi x = apply_fun psi (apply_fun phi x).
      { exact (compose_fun_apply G phi psi x Hx). }
      claim Hcomp_val_sym : apply_fun psi (apply_fun phi x) = apply_fun comp_psi_phi x.
      { symmetry. exact Hcomp_val. }
      claim Hpsi_phi_eq_hid : apply_fun psi (apply_fun phi x) = apply_fun h_id x.
      { exact (eq_i_tra
          (apply_fun psi (apply_fun phi x))
          (apply_fun comp_psi_phi x)
          (apply_fun h_id x)
          Hcomp_val_sym Hcomp_hid). }
      exact (eq_i_tra
        (apply_fun psi (apply_fun phi x))
        (apply_fun h_id x) x
        Hpsi_phi_eq_hid (Hid_G_agrees x Hx)). }
    (** G' direction: h_id2 and comp_phi_psi **)
    claim Hid2_ex : exists h:set,
      group_homomorphism G' multG' G' multG' h /\
      (forall alpha:set, alpha :e J ->
        forall x:set, x :e apply_fun Gfam alpha ->
          apply_fun h (apply_fun (apply_fun ifam' alpha) x) =
            apply_fun (apply_fun ifam' alpha) x) /\
      (forall h':set, group_homomorphism G' multG' G' multG' h' ->
        (forall alpha:set, alpha :e J ->
          forall x:set, x :e apply_fun Gfam alpha ->
            apply_fun h' (apply_fun (apply_fun ifam' alpha) x) =
              apply_fun (apply_fun ifam' alpha) x) ->
        forall x:set, x :e G' -> apply_fun h' x = apply_fun h x).
    { claim Hgfam_grp3 : forall alpha:set, alpha :e J ->
        group_structure (apply_fun Gfam alpha) (apply_fun multfam alpha)
          (apply_fun efam alpha) (apply_fun invfam alpha).
      { let alpha. assume Hal.
        exact (abelian_group_implies_group_structure
          (apply_fun Gfam alpha) (apply_fun multfam alpha)
          (apply_fun efam alpha) (apply_fun invfam alpha)
          (HabFam alpha Hal)). }
      exact (lemma67_5_extension_external
        G' multG' eG' invG' J Gfam multfam efam invfam ifam'
        HabG'
        Hgfam_grp3
        Hifam'
        HdsG'
        G' multG' eG' invG'
        HabG'
        ifam'
        Hifam'_hom_only). }
    apply Hid2_ex. let h_id2. assume Hid2_all.
    apply (and3E
      (group_homomorphism G' multG' G' multG' h_id2)
      (forall alpha:set, alpha :e J ->
        forall x:set, x :e apply_fun Gfam alpha ->
          apply_fun h_id2 (apply_fun (apply_fun ifam' alpha) x) =
            apply_fun (apply_fun ifam' alpha) x)
      (forall h':set, group_homomorphism G' multG' G' multG' h' ->
        (forall alpha:set, alpha :e J ->
          forall x:set, x :e apply_fun Gfam alpha ->
            apply_fun h' (apply_fun (apply_fun ifam' alpha) x) =
              apply_fun (apply_fun ifam' alpha) x) ->
        forall x:set, x :e G' -> apply_fun h' x = apply_fun h_id2 x)
      Hid2_all).
    assume Hid2_hom : group_homomorphism G' multG' G' multG' h_id2.
    assume Hid2_ext : forall alpha:set, alpha :e J ->
      forall x:set, x :e apply_fun Gfam alpha ->
        apply_fun h_id2 (apply_fun (apply_fun ifam' alpha) x) =
          apply_fun (apply_fun ifam' alpha) x.
    assume Hid2_uniq : forall h':set, group_homomorphism G' multG' G' multG' h' ->
      (forall alpha:set, alpha :e J ->
        forall x:set, x :e apply_fun Gfam alpha ->
          apply_fun h' (apply_fun (apply_fun ifam' alpha) x) =
            apply_fun (apply_fun ifam' alpha) x) ->
      forall x:set, x :e G' -> apply_fun h' x = apply_fun h_id2 x.
    set id_G' := graph G' (fun x:set => x).
    claim Hid_G'_hom : group_homomorphism G' multG' G' multG' id_G'.
    { prove function_on id_G' G' G' /\
        (forall x y:set, x :e G' -> y :e G' ->
          apply_fun id_G' (apply_fun multG' (x, y)) = apply_fun multG' (apply_fun id_G' x, apply_fun id_G' y)).
      apply andI.
      - let x. assume Hx : x :e G'.
        rewrite (apply_fun_graph G' (fun z:set => z) x Hx). exact Hx.
      - let x y. assume Hx : x :e G'. assume Hy : y :e G'.
        claim HxyG' : apply_fun multG' (x, y) :e G'.
        { apply (and6E
            (function_on multG' (setprod G' G') G') (function_on invG' G' G') (eG' :e G')
            (forall x0 y0 z:set, x0 :e G' -> y0 :e G' -> z :e G' ->
              apply_fun multG' (apply_fun multG' (x0, y0), z) = apply_fun multG' (x0, apply_fun multG' (y0, z)))
            (forall x0:set, x0 :e G' -> apply_fun multG' (eG', x0) = x0 /\ apply_fun multG' (x0, eG') = x0)
            (forall x0:set, x0 :e G' ->
              apply_fun multG' (x0, apply_fun invG' x0) = eG' /\ apply_fun multG' (apply_fun invG' x0, x0) = eG')
            HgrpG').
          assume Hmult_fo' _ _ _ _ _.
          exact (Hmult_fo' (x, y) (tuple_2_setprod_by_pair_Sigma G' G' x y Hx Hy)). }
        rewrite (apply_fun_graph G' (fun z:set => z) (apply_fun multG' (x, y)) HxyG').
        rewrite (apply_fun_graph G' (fun z:set => z) x Hx).
        rewrite (apply_fun_graph G' (fun z:set => z) y Hy).
        reflexivity. }
    claim Hid_G'_ext : forall alpha:set, alpha :e J ->
      forall x:set, x :e apply_fun Gfam alpha ->
        apply_fun id_G' (apply_fun (apply_fun ifam' alpha) x) =
          apply_fun (apply_fun ifam' alpha) x.
    { let alpha. assume Hal. let x. assume Hx.
      claim Hifx_G' : apply_fun (apply_fun ifam' alpha) x :e G'.
      { exact (group_homomorphism_function_on (apply_fun Gfam alpha) (apply_fun multfam alpha) G' multG'
          (apply_fun ifam' alpha) (Hifam'_hom_only alpha Hal) x Hx). }
      exact (apply_fun_graph G' (fun z:set => z) (apply_fun (apply_fun ifam' alpha) x) Hifx_G'). }
    (** h_id2 agrees with identity on G' **)
    claim Hid2_G'_agrees : forall x:set, x :e G' -> apply_fun h_id2 x = x.
    { let x. assume Hx.
      claim Hid2_eq : apply_fun id_G' x = apply_fun h_id2 x.
      { exact (Hid2_uniq id_G' Hid_G'_hom Hid_G'_ext x Hx). }
      claim Hid2_eq_sym : apply_fun h_id2 x = apply_fun id_G' x.
      { symmetry. exact Hid2_eq. }
      claim Hid2_val : apply_fun id_G' x = x.
      { exact (apply_fun_graph G' (fun z:set => z) x Hx). }
      exact (eq_i_tra (apply_fun h_id2 x) (apply_fun id_G' x) x Hid2_eq_sym Hid2_val). }
    (** comp_phi_psi: composition phi o psi as group homomorphism G' -> G' **)
    set comp_phi_psi := compose_fun G' psi phi.
    claim Hcomp2_hom : group_homomorphism G' multG' G' multG' comp_phi_psi.
    { exact (group_homomorphism_compose_cyclic_helper G' multG' eG' invG' G multG G' multG'
        psi phi HgrpG' Hpsi_hom Hphi_hom). }
    claim Hcomp2_ext : forall alpha:set, alpha :e J ->
      forall x:set, x :e apply_fun Gfam alpha ->
        apply_fun comp_phi_psi (apply_fun (apply_fun ifam' alpha) x) =
          apply_fun (apply_fun ifam' alpha) x.
    { let alpha. assume Hal. let x. assume Hx.
      claim Hifx_G' : apply_fun (apply_fun ifam' alpha) x :e G'.
      { exact (group_homomorphism_function_on (apply_fun Gfam alpha) (apply_fun multfam alpha) G' multG'
          (apply_fun ifam' alpha) (Hifam'_hom_only alpha Hal) x Hx). }
      rewrite (compose_fun_apply G' psi phi (apply_fun (apply_fun ifam' alpha) x) Hifx_G').
      rewrite (Hpsi_ext alpha Hal x Hx).
      exact (Hphi_transfer alpha Hal x Hx). }
    (** phi o psi = identity on G' **)
    claim Hphi_psi_id : forall y:set, y :e G' -> apply_fun phi (apply_fun psi y) = y.
    { let y. assume Hy.
      claim Hcomp2_hid2 : apply_fun comp_phi_psi y = apply_fun h_id2 y.
      { exact (Hid2_uniq comp_phi_psi Hcomp2_hom Hcomp2_ext y Hy). }
      claim Hcomp2_val : apply_fun comp_phi_psi y = apply_fun phi (apply_fun psi y).
      { exact (compose_fun_apply G' psi phi y Hy). }
      claim Hcomp2_val_sym : apply_fun phi (apply_fun psi y) = apply_fun comp_phi_psi y.
      { symmetry. exact Hcomp2_val. }
      claim Hphi_psi_eq_hid2 : apply_fun phi (apply_fun psi y) = apply_fun h_id2 y.
      { exact (eq_i_tra
          (apply_fun phi (apply_fun psi y))
          (apply_fun comp_phi_psi y)
          (apply_fun h_id2 y)
          Hcomp2_val_sym Hcomp2_hid2). }
      exact (eq_i_tra
        (apply_fun phi (apply_fun psi y))
        (apply_fun h_id2 y) y
        Hphi_psi_eq_hid2 (Hid2_G'_agrees y Hy)). }
    (** Conclude bijection using psi as explicit inverse **)
    prove function_on phi G G' /\
      (forall y:set, y :e G' ->
        exists x:set, x :e G /\ apply_fun phi x = y /\
          (forall x':set, x' :e G -> apply_fun phi x' = y -> x' = x)).
    apply andI.
    - exact Hphi_fo.
    - let y. assume Hy : y :e G'.
      set x := apply_fun psi y.
      claim HxG : x :e G. { exact (Hpsi_fo y Hy). }
      witness x. apply and3I.
      + exact HxG.
      + prove apply_fun phi x = y. exact (Hphi_psi_id y Hy).
      + let x'. assume Hx'G : x' :e G. assume Heq : apply_fun phi x' = y.
        prove x' = x.
        claim Hstep : apply_fun psi (apply_fun phi x') = apply_fun psi y.
        { rewrite Heq. reflexivity. }
        claim Hx'_eq : x' = apply_fun psi (apply_fun phi x').
        { symmetry. exact (Hpsi_phi_id x' Hx'G). }
        exact (eq_i_tra x' (apply_fun psi (apply_fun phi x')) x Hx'_eq Hstep). }
  exact (andI
    (group_homomorphism G multG G' multG' phi)
    (bijection G G' phi)
    Hphi_hom
    Hphi_bij).
- (** extension property **)
  exact Hphi_transfer.
- (** uniqueness **)
  let phi'. assume Hphi'_iso Hphi'_ext.
  claim Hphi'_hom : group_homomorphism G multG G' multG' phi'.
  { exact (andEL
      (group_homomorphism G multG G' multG' phi')
      (bijection G G' phi')
      Hphi'_iso). }
  claim Hphi'_ext_sub : forall alpha:set, alpha :e J ->
    forall x:set, x :e apply_fun (graph J (fun alpha0:set => homomorphism_image (apply_fun Gfam alpha0) (apply_fun ifam alpha0))) alpha ->
      apply_fun phi' x = apply_fun (apply_fun hfam_fwd alpha) x.
  { let alpha. assume Halpha.
    let y. assume Hy_in.
    claim Hy_in_img : y :e homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha).
    { rewrite <- (apply_fun_graph J (fun alpha0:set => homomorphism_image (apply_fun Gfam alpha0) (apply_fun ifam alpha0)) alpha Halpha).
      exact Hy_in. }
    apply (ReplE_impred (apply_fun Gfam alpha) (fun z:set => apply_fun (apply_fun ifam alpha) z) y Hy_in_img).
    let z. assume Hz Hyz.
    claim Hphi'y : apply_fun phi' y = apply_fun (apply_fun ifam' alpha) z.
    { rewrite Hyz. exact (Hphi'_ext alpha Halpha z Hz). }
    claim Hfwdy : apply_fun (apply_fun hfam_fwd alpha) y = apply_fun (apply_fun ifam' alpha) z.
    { rewrite Hyz. exact (Hfwd_apply alpha z Halpha Hz). }
    claim Hfwdy_sym : apply_fun (apply_fun ifam' alpha) z = apply_fun (apply_fun hfam_fwd alpha) y.
    { symmetry. exact Hfwdy. }
    exact (eq_i_tra (apply_fun phi' y) (apply_fun (apply_fun ifam' alpha) z) (apply_fun (apply_fun hfam_fwd alpha) y) Hphi'y Hfwdy_sym). }
  exact (Hphi_uniq phi' Hphi'_hom Hphi'_ext_sub).
Qed.

(** Infrastructure: infinite cyclic subgroup generated by an element **)
Definition infinite_cyclic_subgroup : set -> set -> set -> set -> set -> prop :=
  fun G mult e inv a =>
    a :e G /\
    (forall n:set, n :e omega -> group_power_nat mult e a n :e G) /\
    (forall m:set, m :e omega -> group_power_nat mult e (apply_fun inv a) (ordsucc m) :e G) /\
    ~(exists n:set, n :e omega /\ n <> 0 /\ group_power_nat mult e a n = e).

(** from S67 Definition (line 2679 in algtop.tex): free abelian group with basis **)
(** LATEX VERSION: If each G_alpha (generated by a_alpha) is infinite cyclic, and **)
(** G is the direct sum of the G_alpha, then G is a free abelian group with **)
(** basis {a_alpha}. **)
Definition free_abelian_group_with_basis : set -> set -> set -> set -> set -> set -> prop :=
  fun G mult e inv J basis =>
    abelian_group G mult e inv /\
    function_on basis J G /\
    (forall alpha:set, alpha :e J ->
      infinite_cyclic_subgroup G mult e inv (apply_fun basis alpha)) /\
    direct_sum_of_subgroups G mult e inv J
      (graph J (fun alpha:set =>
        {g :e G | exists n:set, n :e int /\
          ((n :e omega /\ g = group_power_nat mult e (apply_fun basis alpha) n) \/
           (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
            g = group_power_nat mult e (apply_fun inv (apply_fun basis alpha)) (ordsucc m)))})).

(** Helper: generator_of for Gfam(alpha) factor family **)
Lemma factor_family_generator_of_helper :
  forall G mult e inv J gens alpha:set,
  group_structure G mult e inv ->
  function_on gens J G ->
  alpha :e J ->
  generator_of
    (apply_fun
      (graph J (fun beta:set =>
        {g :e G | exists n:set, n :e int /\
          ((n :e omega /\ g = group_power_nat mult e (apply_fun gens beta) n) \/
           (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
            g = group_power_nat mult e (apply_fun inv (apply_fun gens beta)) (ordsucc m)))}))
      alpha)
    mult e inv (apply_fun gens alpha).
let G mult e inv J gens alpha.
assume Hgrp : group_structure G mult e inv.
assume Hgens : function_on gens J G.
assume Hal : alpha :e J.
set GfamL := graph J (fun beta:set =>
  {g :e G | exists n:set, n :e int /\
    ((n :e omega /\ g = group_power_nat mult e (apply_fun gens beta) n) \/
     (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
      g = group_power_nat mult e (apply_fun inv (apply_fun gens beta)) (ordsucc m)))}).
set a := apply_fun gens alpha.
claim HaG : a :e G.
{ exact (Hgens alpha Hal). }
claim HGfamL_def : GfamL = graph J (fun beta:set =>
  {g :e G | exists n:set, n :e int /\
    ((n :e omega /\ g = group_power_nat mult e (apply_fun gens beta) n) \/
     (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
      g = group_power_nat mult e (apply_fun inv (apply_fun gens beta)) (ordsucc m)))}).
{ reflexivity. }
claim HGfamL_val : apply_fun GfamL alpha =
  {g :e G | exists n:set, n :e int /\
    ((n :e omega /\ g = group_power_nat mult e a n) \/
     (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
      g = group_power_nat mult e (apply_fun inv a) (ordsucc m)))}.
{ exact (apply_fun_of_graph_eq GfamL J
    (fun beta:set =>
      {g :e G | exists n:set, n :e int /\
        ((n :e omega /\ g = group_power_nat mult e (apply_fun gens beta) n) \/
         (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
          g = group_power_nat mult e (apply_fun inv (apply_fun gens beta)) (ordsucc m)))})
    alpha HGfamL_def Hal). }
apply (andI
  (a :e apply_fun GfamL alpha)
  (forall g:set, g :e apply_fun GfamL alpha ->
    exists n:set, n :e int /\
      ((n :e omega /\ g = group_power_nat mult e a n) \/
       (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
        g = group_power_nat mult e (apply_fun inv a) (ordsucc m))))).
- (** a :e GfamL(alpha) **)
  rewrite HGfamL_val.
  apply (SepI G
    (fun g:set => exists n:set, n :e int /\
      ((n :e omega /\ g = group_power_nat mult e a n) \/
       (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
        g = group_power_nat mult e (apply_fun inv a) (ordsucc m))))
    a HaG).
  claim H1omega : ordsucc 0 :e omega.
  { exact (omega_ordsucc 0 (nat_p_omega 0 nat_0)). }
  witness (ordsucc 0). apply andI.
  + exact (Subq_omega_int (ordsucc 0) H1omega).
  + apply orIL.
    claim Hpow1_eq : a = group_power_nat mult e a (ordsucc 0).
    { claim HS1 : group_power_nat mult e a (ordsucc 0) =
        apply_fun mult (a, group_power_nat mult e a 0).
      { exact (nat_primrec_S e (fun _ r => apply_fun mult (a, r)) 0 nat_0). }
      claim H0e : group_power_nat mult e a 0 = e.
      { exact (nat_primrec_0 e (fun _ r => apply_fun mult (a, r))). }
      apply (and6E
        (function_on mult (setprod G G) G)
        (function_on inv G G)
        (e :e G)
        (forall u v w:set, u :e G -> v :e G -> w :e G ->
          apply_fun mult (apply_fun mult (u, v), w) = apply_fun mult (u, apply_fun mult (v, w)))
        (forall u:set, u :e G -> apply_fun mult (e, u) = u /\ apply_fun mult (u, e) = u)
        (forall u:set, u :e G ->
          apply_fun mult (u, apply_fun inv u) = e /\ apply_fun mult (apply_fun inv u, u) = e)
        Hgrp).
      assume HmultFn HinvFn HeG Hassoc Hid HinvLaw.
      claim Hright_id : apply_fun mult (a, e) = a.
      { exact (andER (apply_fun mult (e, a) = a) (apply_fun mult (a, e) = a) (Hid a HaG)). }
      claim Hpow1 : group_power_nat mult e a (ordsucc 0) = a.
      { claim Hstep : group_power_nat mult e a (ordsucc 0) = apply_fun mult (a, e).
        { claim Hstep2 : apply_fun mult (a, group_power_nat mult e a 0) = apply_fun mult (a, e).
          { rewrite H0e. reflexivity. }
          exact (eq_i_tra
            (group_power_nat mult e a (ordsucc 0))
            (apply_fun mult (a, group_power_nat mult e a 0))
            (apply_fun mult (a, e)) HS1 Hstep2). }
        exact (eq_i_tra
          (group_power_nat mult e a (ordsucc 0))
          (apply_fun mult (a, e)) a Hstep Hright_id). }
      exact (eq_symm (group_power_nat mult e a (ordsucc 0)) a Hpow1). }
    exact (andI (ordsucc 0 :e omega) (a = group_power_nat mult e a (ordsucc 0))
      H1omega Hpow1_eq).
- (** forall g :e GfamL(alpha), g is a power of a **)
  let g. assume Hg : g :e apply_fun GfamL alpha.
  claim Hg2 : g :e {g :e G | exists n:set, n :e int /\
    ((n :e omega /\ g = group_power_nat mult e a n) \/
     (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
      g = group_power_nat mult e (apply_fun inv a) (ordsucc m)))}.
  { rewrite <- HGfamL_val. exact Hg. }
  apply (SepE G
    (fun g:set => exists n:set, n :e int /\
      ((n :e omega /\ g = group_power_nat mult e a n) \/
       (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
        g = group_power_nat mult e (apply_fun inv a) (ordsucc m))))
    g Hg2).
  assume HgG : g :e G.
  assume Hpow : exists n:set, n :e int /\
    ((n :e omega /\ g = group_power_nat mult e a n) \/
     (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
      g = group_power_nat mult e (apply_fun inv a) (ordsucc m))).
  exact Hpow.
Qed.

(** Helper: cyclic_group for factor family from generator_of **)
Lemma factor_family_cyclic_group_helper :
  forall G mult e inv x:set,
  group_structure G mult e inv ->
  generator_of G mult e inv x ->
  cyclic_group G mult e inv.
let G mult e inv x.
assume Hgrp : group_structure G mult e inv.
assume Hgen : generator_of G mult e inv x.
apply (andI
  (group_structure G mult e inv)
  (exists x:set, x :e G /\
    forall g:set, g :e G ->
      exists n:set, n :e int /\
        ((n :e omega /\ g = group_power_nat mult e x n) \/
         (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
          g = group_power_nat mult e (apply_fun inv x) (ordsucc m))))).
- exact Hgrp.
- witness x.
  exact Hgen.
Qed.

(** Helper: infinite cyclic subgroup of factor family implies not finite **)
Lemma factor_family_infinite_cyclic_helper :
  forall G mult e inv J gens alpha:set,
  group_structure G mult e inv ->
  function_on gens J G ->
  (forall beta:set, beta :e J ->
    infinite_cyclic_subgroup G mult e inv (apply_fun gens beta)) ->
  alpha :e J ->
  infinite_cyclic_subgroup
    (apply_fun
      (graph J (fun beta:set =>
        {g :e G | exists n:set, n :e int /\
          ((n :e omega /\ g = group_power_nat mult e (apply_fun gens beta) n) \/
           (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
            g = group_power_nat mult e (apply_fun inv (apply_fun gens beta)) (ordsucc m)))}))
      alpha)
    mult e inv (apply_fun gens alpha).
let G mult e inv J gens alpha.
assume Hgrp : group_structure G mult e inv.
assume Hfn : function_on gens J G.
assume Hinfcyc : forall beta:set, beta :e J ->
  infinite_cyclic_subgroup G mult e inv (apply_fun gens beta).
assume Hal : alpha :e J.
(** Extract group structure **)
apply (and6E
  (function_on mult (setprod G G) G)
  (function_on inv G G)
  (e :e G)
  (forall x y z:set, x :e G -> y :e G -> z :e G ->
    apply_fun mult (apply_fun mult (x, y), z) = apply_fun mult (x, apply_fun mult (y, z)))
  (forall x:set, x :e G -> apply_fun mult (e, x) = x /\ apply_fun mult (x, e) = x)
  (forall x:set, x :e G ->
    apply_fun mult (x, apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x, x) = e)
  Hgrp).
assume HmultFn HinvFn HeG HassocG HidG HinvG.
(** Extract infinite_cyclic_subgroup for gens(alpha) in G **)
claim Hinf : infinite_cyclic_subgroup G mult e inv (apply_fun gens alpha).
{ exact (Hinfcyc alpha Hal). }
apply (and4E
  (apply_fun gens alpha :e G)
  (forall n:set, n :e omega -> group_power_nat mult e (apply_fun gens alpha) n :e G)
  (forall m:set, m :e omega ->
    group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m) :e G)
  (~(exists n:set, n :e omega /\ n <> 0 /\ group_power_nat mult e (apply_fun gens alpha) n = e))
  Hinf).
assume HaG HpowG HipowG Hnontriv.
(** Evaluate graph application **)
claim HGeval : apply_fun
  (graph J (fun beta:set =>
    {g :e G | exists n:set, n :e int /\
      ((n :e omega /\ g = group_power_nat mult e (apply_fun gens beta) n) \/
       (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
        g = group_power_nat mult e (apply_fun inv (apply_fun gens beta)) (ordsucc m)))}))
  alpha =
  {g :e G | exists n:set, n :e int /\
    ((n :e omega /\ g = group_power_nat mult e (apply_fun gens alpha) n) \/
     (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
      g = group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m)))}.
{ exact (apply_fun_graph J (fun beta:set =>
    {g :e G | exists n:set, n :e int /\
      ((n :e omega /\ g = group_power_nat mult e (apply_fun gens beta) n) \/
       (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
        g = group_power_nat mult e (apply_fun inv (apply_fun gens beta)) (ordsucc m)))})
    alpha Hal). }
rewrite HGeval.
set GfamA := {g :e G | exists n:set, n :e int /\
  ((n :e omega /\ g = group_power_nat mult e (apply_fun gens alpha) n) \/
   (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
    g = group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m)))}.
set P := fun g:set => exists n:set, n :e int /\
  ((n :e omega /\ g = group_power_nat mult e (apply_fun gens alpha) n) \/
   (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
    g = group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m))).
(** Helper: 0 :e omega **)
claim H0O : 0 :e omega. { exact (nat_p_omega 0 nat_0). }
(** Helper: ordsucc 0 :e omega **)
claim H1O : ordsucc 0 :e omega. { exact (omega_ordsucc 0 H0O). }
(** Conjunct 1: gens(alpha) :e GfamA **)
claim H1 : apply_fun gens alpha :e GfamA.
{ apply (SepI G P (apply_fun gens alpha) HaG).
  witness (ordsucc 0).
  apply (andI (ordsucc 0 :e int)
    ((ordsucc 0 :e omega /\ apply_fun gens alpha = group_power_nat mult e (apply_fun gens alpha) (ordsucc 0)) \/
     (exists m:set, m :e omega /\ ordsucc 0 = minus_SNo (ordsucc m) /\
      apply_fun gens alpha = group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m)))).
  - exact (Subq_omega_int (ordsucc 0) H1O).
  - apply (orIL
      (ordsucc 0 :e omega /\ apply_fun gens alpha = group_power_nat mult e (apply_fun gens alpha) (ordsucc 0))
      (exists m:set, m :e omega /\ ordsucc 0 = minus_SNo (ordsucc m) /\
       apply_fun gens alpha = group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m))).
    apply (andI (ordsucc 0 :e omega)
      (apply_fun gens alpha = group_power_nat mult e (apply_fun gens alpha) (ordsucc 0))).
    + exact H1O.
    + claim HpowS1 : group_power_nat mult e (apply_fun gens alpha) (ordsucc 0) =
        apply_fun mult (apply_fun gens alpha, group_power_nat mult e (apply_fun gens alpha) 0).
      { exact (nat_primrec_S e (fun _ r:set => apply_fun mult (apply_fun gens alpha, r)) 0 nat_0). }
      claim Hpow0 : group_power_nat mult e (apply_fun gens alpha) 0 = e.
      { exact (nat_primrec_0 e (fun _ r:set => apply_fun mult (apply_fun gens alpha, r))). }
      claim HidR : apply_fun mult (apply_fun gens alpha, e) = apply_fun gens alpha.
      { exact (andER (apply_fun mult (e, apply_fun gens alpha) = apply_fun gens alpha)
          (apply_fun mult (apply_fun gens alpha, e) = apply_fun gens alpha)
          (HidG (apply_fun gens alpha) HaG)). }
      claim Hchain : group_power_nat mult e (apply_fun gens alpha) (ordsucc 0) = apply_fun gens alpha.
      { claim Hmult_ae : apply_fun mult (apply_fun gens alpha,
            group_power_nat mult e (apply_fun gens alpha) 0) =
          apply_fun mult (apply_fun gens alpha, e).
        { claim Hrew : group_power_nat mult e (apply_fun gens alpha) 0 = e. { exact Hpow0. }
          rewrite Hrew. reflexivity. }
        exact (eq_i_tra (group_power_nat mult e (apply_fun gens alpha) (ordsucc 0))
          (apply_fun mult (apply_fun gens alpha, group_power_nat mult e (apply_fun gens alpha) 0))
          (apply_fun gens alpha)
          HpowS1
          (eq_i_tra
            (apply_fun mult (apply_fun gens alpha, group_power_nat mult e (apply_fun gens alpha) 0))
            (apply_fun mult (apply_fun gens alpha, e))
            (apply_fun gens alpha)
            Hmult_ae HidR)). }
      exact (eq_symm (group_power_nat mult e (apply_fun gens alpha) (ordsucc 0))
        (apply_fun gens alpha) Hchain). }
(** Conjunct 2: positive powers in GfamA **)
claim H2 : forall n:set, n :e omega ->
  group_power_nat mult e (apply_fun gens alpha) n :e GfamA.
{ let n. assume Hn : n :e omega.
  apply (SepI G P (group_power_nat mult e (apply_fun gens alpha) n) (HpowG n Hn)).
  witness n.
  apply (andI (n :e int)
    ((n :e omega /\ group_power_nat mult e (apply_fun gens alpha) n =
       group_power_nat mult e (apply_fun gens alpha) n) \/
     (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
      group_power_nat mult e (apply_fun gens alpha) n =
        group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m)))).
  - exact (Subq_omega_int n Hn).
  - apply (orIL
      (n :e omega /\ group_power_nat mult e (apply_fun gens alpha) n =
        group_power_nat mult e (apply_fun gens alpha) n)
      (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
       group_power_nat mult e (apply_fun gens alpha) n =
         group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m))).
    exact (andI (n :e omega)
      (group_power_nat mult e (apply_fun gens alpha) n =
        group_power_nat mult e (apply_fun gens alpha) n)
      Hn (eq_refl (group_power_nat mult e (apply_fun gens alpha) n))). }
(** Conjunct 3: negative powers in GfamA **)
claim H3 : forall m:set, m :e omega ->
  group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m) :e GfamA.
{ let m. assume Hm : m :e omega.
  apply (SepI G P
    (group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m))
    (HipowG m Hm)).
  witness (minus_SNo (ordsucc m)).
  claim HsmO : ordsucc m :e omega. { exact (omega_ordsucc m Hm). }
  claim HintN : minus_SNo (ordsucc m) :e int.
  { exact (int_minus_SNo_omega (ordsucc m) HsmO). }
  apply (andI (minus_SNo (ordsucc m) :e int)
    ((minus_SNo (ordsucc m) :e omega /\
      group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m) =
        group_power_nat mult e (apply_fun gens alpha) (minus_SNo (ordsucc m))) \/
     (exists m0:set, m0 :e omega /\ minus_SNo (ordsucc m) = minus_SNo (ordsucc m0) /\
      group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m) =
        group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m0)))).
  - exact HintN.
  - apply (orIR
      (minus_SNo (ordsucc m) :e omega /\
       group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m) =
         group_power_nat mult e (apply_fun gens alpha) (minus_SNo (ordsucc m)))
      (exists m0:set, m0 :e omega /\ minus_SNo (ordsucc m) = minus_SNo (ordsucc m0) /\
       group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m) =
         group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m0))).
    witness m.
    claim H3a : m :e omega. { exact Hm. }
    claim H3b : minus_SNo (ordsucc m) = minus_SNo (ordsucc m). { reflexivity. }
    claim H3c : group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m) =
      group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m).
    { reflexivity. }
    exact (and3I (m :e omega) (minus_SNo (ordsucc m) = minus_SNo (ordsucc m))
      (group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m) =
        group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m))
      H3a H3b H3c). }
(** Combine all 4 conjuncts **)
exact (and4I
  (apply_fun gens alpha :e GfamA)
  (forall n:set, n :e omega -> group_power_nat mult e (apply_fun gens alpha) n :e GfamA)
  (forall m:set, m :e omega ->
    group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m) :e GfamA)
  (~(exists n:set, n :e omega /\ n <> 0 /\ group_power_nat mult e (apply_fun gens alpha) n = e))
  H1 H2 H3 Hnontriv).
Qed.

(** Helper: not finite from infinite cyclic subgroup **)
Lemma factor_family_nonfinite_helper :
  forall G mult e inv a:set,
  group_structure G mult e inv ->
  infinite_cyclic_subgroup G mult e inv a ->
  ~ finite G.
let G mult e inv a.
assume Hgrp : group_structure G mult e inv.
assume Hinf : infinite_cyclic_subgroup G mult e inv a.
apply (and6E
  (function_on mult (setprod G G) G)
  (function_on inv G G)
  (e :e G)
  (forall x y z:set, x :e G -> y :e G -> z :e G ->
    apply_fun mult (apply_fun mult (x, y), z) = apply_fun mult (x, apply_fun mult (y, z)))
  (forall x:set, x :e G -> apply_fun mult (e, x) = x /\ apply_fun mult (x, e) = x)
  (forall x:set, x :e G ->
    apply_fun mult (x, apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x, x) = e)
  Hgrp).
assume HmultFn HinvFn HeG HassocG HidG HinvG.
apply (and4E
  (a :e G)
  (forall n:set, n :e omega -> group_power_nat mult e a n :e G)
  (forall m:set, m :e omega -> group_power_nat mult e (apply_fun inv a) (ordsucc m) :e G)
  (~(exists n:set, n :e omega /\ n <> 0 /\ group_power_nat mult e a n = e))
  Hinf).
assume HaG HpowInG HpowInvInG Hnontriv.
(** Left cancellation for a **)
claim Hleft_cancel : forall u v:set, u :e G -> v :e G ->
  apply_fun mult (a, u) = apply_fun mult (a, v) -> u = v.
{ let u v. assume HuG : u :e G. assume HvG : v :e G.
  assume Haeq : apply_fun mult (a, u) = apply_fun mult (a, v).
  claim HaInvG : apply_fun inv a :e G. { exact (HinvFn a HaG). }
  claim HinvAA : apply_fun mult (apply_fun inv a, a) = e.
  { exact (andER (apply_fun mult (a, apply_fun inv a) = e)
      (apply_fun mult (apply_fun inv a, a) = e) (HinvG a HaG)). }
  claim HauG : apply_fun mult (a, u) :e G.
  { exact (HmultFn (a, u) (tuple_2_setprod_by_pair_Sigma G G a u HaG HuG)). }
  claim Heu : apply_fun mult (e, u) = u.
  { exact (andEL (apply_fun mult (e, u) = u) (apply_fun mult (u, e) = u) (HidG u HuG)). }
  claim Hev : apply_fun mult (e, v) = v.
  { exact (andEL (apply_fun mult (e, v) = v) (apply_fun mult (v, e) = v) (HidG v HvG)). }
  claim Hstep_u : apply_fun mult (apply_fun inv a, apply_fun mult (a, u)) = u.
  { claim Hassoc_u : apply_fun mult (apply_fun mult (apply_fun inv a, a), u) =
      apply_fun mult (apply_fun inv a, apply_fun mult (a, u)).
    { exact (HassocG (apply_fun inv a) a u HaInvG HaG HuG). }
    claim Hmid_u : apply_fun mult (apply_fun mult (apply_fun inv a, a), u) = apply_fun mult (e, u).
    { rewrite HinvAA. reflexivity. }
    exact (eq_i_tra
      (apply_fun mult (apply_fun inv a, apply_fun mult (a, u)))
      (apply_fun mult (apply_fun mult (apply_fun inv a, a), u))
      u
      (eq_symm
        (apply_fun mult (apply_fun mult (apply_fun inv a, a), u))
        (apply_fun mult (apply_fun inv a, apply_fun mult (a, u)))
        Hassoc_u)
      (eq_i_tra
        (apply_fun mult (apply_fun mult (apply_fun inv a, a), u))
        (apply_fun mult (e, u))
        u Hmid_u Heu)). }
  claim Hstep_v : apply_fun mult (apply_fun inv a, apply_fun mult (a, v)) = v.
  { claim Hassoc_v : apply_fun mult (apply_fun mult (apply_fun inv a, a), v) =
      apply_fun mult (apply_fun inv a, apply_fun mult (a, v)).
    { exact (HassocG (apply_fun inv a) a v HaInvG HaG HvG). }
    claim Hmid_v : apply_fun mult (apply_fun mult (apply_fun inv a, a), v) = apply_fun mult (e, v).
    { rewrite HinvAA. reflexivity. }
    exact (eq_i_tra
      (apply_fun mult (apply_fun inv a, apply_fun mult (a, v)))
      (apply_fun mult (apply_fun mult (apply_fun inv a, a), v))
      v
      (eq_symm
        (apply_fun mult (apply_fun mult (apply_fun inv a, a), v))
        (apply_fun mult (apply_fun inv a, apply_fun mult (a, v)))
        Hassoc_v)
      (eq_i_tra
        (apply_fun mult (apply_fun mult (apply_fun inv a, a), v))
        (apply_fun mult (e, v))
        v Hmid_v Hev)). }
  claim Hstep_eq : apply_fun mult (apply_fun inv a, apply_fun mult (a, u)) =
    apply_fun mult (apply_fun inv a, apply_fun mult (a, v)).
  { claim Hrew : apply_fun mult (a, u) = apply_fun mult (a, v). { exact Haeq. }
    rewrite Hrew. reflexivity. }
  exact (eq_i_tra u
    (apply_fun mult (apply_fun inv a, apply_fun mult (a, u)))
    v
    (eq_symm (apply_fun mult (apply_fun inv a, apply_fun mult (a, u))) u Hstep_u)
    (eq_i_tra
      (apply_fun mult (apply_fun inv a, apply_fun mult (a, u)))
      (apply_fun mult (apply_fun inv a, apply_fun mult (a, v)))
      v Hstep_eq Hstep_v)). }
(** Power succession and base **)
claim HpowS : forall k:set, nat_p k ->
  group_power_nat mult e a (ordsucc k) = apply_fun mult (a, group_power_nat mult e a k).
{ let k. assume Hk. exact (nat_primrec_S e (fun _ r:set => apply_fun mult (a, r)) k Hk). }
claim Hpow0 : group_power_nat mult e a 0 = e.
{ exact (nat_primrec_0 e (fun _ r:set => apply_fun mult (a, r))). }
(** Power injectivity by nat_ind on m **)
claim Hpow_inj : forall m:set, nat_p m -> forall n:set, nat_p n ->
  group_power_nat mult e a m = group_power_nat mult e a n -> m = n.
{ apply nat_ind.
  - (** Base: m = 0 **)
    let n. assume Hn : nat_p n.
    assume Heq : group_power_nat mult e a 0 = group_power_nat mult e a n.
    apply (nat_inv n Hn).
    + assume Hn0 : n = 0. exact (eq_symm n 0 Hn0).
    + assume HnS : exists n':set, nat_p n' /\ n = ordsucc n'.
      apply HnS. let n'. assume Hn'p : nat_p n' /\ n = ordsucc n'.
      claim Hn'nat : nat_p n'. { exact (andEL (nat_p n') (n = ordsucc n') Hn'p). }
      claim Hneq : n = ordsucc n'. { exact (andER (nat_p n') (n = ordsucc n') Hn'p). }
      claim Hpow_n_e : group_power_nat mult e a n = e.
      { exact (eq_i_tra (group_power_nat mult e a n) (group_power_nat mult e a 0) e
          (eq_symm (group_power_nat mult e a 0) (group_power_nat mult e a n) Heq) Hpow0). }
      claim HnO : n :e omega. { exact (nat_p_omega n Hn). }
      claim Hn_ne0 : n <> 0. { rewrite Hneq. assume Habs : ordsucc n' = 0.
        exact (EmptyE n' (mem_eqR n' (ordsucc n') 0 Habs (ordsuccI2 n'))). }
      prove False. apply Hnontriv.
      witness n. exact (and3I (n :e omega) (n <> 0)
        (group_power_nat mult e a n = e) HnO Hn_ne0 Hpow_n_e).
  - (** Step: m = ordsucc m' **)
    let m'. assume Hm'nat : nat_p m'.
    assume IH : forall n:set, nat_p n ->
      group_power_nat mult e a m' = group_power_nat mult e a n -> m' = n.
    let n. assume Hn : nat_p n.
    assume Heq : group_power_nat mult e a (ordsucc m') = group_power_nat mult e a n.
    apply (nat_inv n Hn).
    + (** n = 0 **)
      assume Hn0 : n = 0.
      claim Hpow_sm_e : group_power_nat mult e a (ordsucc m') = e.
      { claim Heq2 : group_power_nat mult e a (ordsucc m') = group_power_nat mult e a 0.
        { rewrite <- Hn0. exact Heq. }
        exact (eq_i_tra (group_power_nat mult e a (ordsucc m'))
          (group_power_nat mult e a 0) e Heq2 Hpow0). }
      claim HsmO : ordsucc m' :e omega.
      { exact (omega_ordsucc m' (nat_p_omega m' Hm'nat)). }
      claim Hsm_ne0 : ordsucc m' <> 0.
      { assume Habs : ordsucc m' = 0.
        exact (EmptyE m' (mem_eqR m' (ordsucc m') 0 Habs (ordsuccI2 m'))). }
      prove False. apply Hnontriv.
      witness (ordsucc m'). exact (and3I (ordsucc m' :e omega) (ordsucc m' <> 0)
        (group_power_nat mult e a (ordsucc m') = e) HsmO Hsm_ne0 Hpow_sm_e).
    + (** n = ordsucc n' **)
      assume HnS : exists n':set, nat_p n' /\ n = ordsucc n'.
      apply HnS. let n'. assume Hn'p : nat_p n' /\ n = ordsucc n'.
      claim Hn'nat : nat_p n'. { exact (andEL (nat_p n') (n = ordsucc n') Hn'p). }
      claim Hneq : n = ordsucc n'. { exact (andER (nat_p n') (n = ordsucc n') Hn'p). }
      (** a mult a^m' = a mult a^n' **)
      claim Heq2 : apply_fun mult (a, group_power_nat mult e a m') =
        apply_fun mult (a, group_power_nat mult e a n').
      { claim Hlhs : group_power_nat mult e a (ordsucc m') =
          apply_fun mult (a, group_power_nat mult e a m').
        { exact (HpowS m' Hm'nat). }
        claim Hrhs : group_power_nat mult e a (ordsucc n') =
          apply_fun mult (a, group_power_nat mult e a n').
        { exact (HpowS n' Hn'nat). }
        claim Heq_sn : group_power_nat mult e a (ordsucc m') =
          group_power_nat mult e a (ordsucc n').
        { rewrite <- Hneq. exact Heq. }
        exact (eq_i_tra
          (apply_fun mult (a, group_power_nat mult e a m'))
          (group_power_nat mult e a (ordsucc m'))
          (apply_fun mult (a, group_power_nat mult e a n'))
          (eq_symm (group_power_nat mult e a (ordsucc m'))
            (apply_fun mult (a, group_power_nat mult e a m')) Hlhs)
          (eq_i_tra
            (group_power_nat mult e a (ordsucc m'))
            (group_power_nat mult e a (ordsucc n'))
            (apply_fun mult (a, group_power_nat mult e a n'))
            Heq_sn Hrhs)). }
      (** By left cancellation, a^m' = a^n' **)
      claim Hm'O : m' :e omega. { exact (nat_p_omega m' Hm'nat). }
      claim Hn'O : n' :e omega. { exact (nat_p_omega n' Hn'nat). }
      claim Heq3 : group_power_nat mult e a m' = group_power_nat mult e a n'.
      { exact (Hleft_cancel
          (group_power_nat mult e a m') (group_power_nat mult e a n')
          (HpowInG m' Hm'O) (HpowInG n' Hn'O) Heq2). }
      claim Hm'n' : m' = n'. { exact (IH n' Hn'nat Heq3). }
      rewrite Hneq. rewrite Hm'n'. reflexivity. }
(** Build injection from omega to G **)
claim HinjPow : inj omega G (fun n:set => group_power_nat mult e a n).
{ apply (andI
    (forall u:set, u :e omega -> group_power_nat mult e a u :e G)
    (forall u:set, u :e omega -> forall v:set, v :e omega ->
      group_power_nat mult e a u = group_power_nat mult e a v -> u = v)).
  - exact HpowInG.
  - let u. assume Hu : u :e omega. let v. assume Hv : v :e omega.
    exact (Hpow_inj u (omega_nat_p u Hu) v (omega_nat_p v Hv)). }
(** G is infinite **)
claim Hatleast : exists f : set -> set, inj omega G f.
{ witness (fun n:set => group_power_nat mult e a n). exact HinjPow. }
claim Hinfinite : infinite G.
{ exact (atleastp_omega_infinite G Hatleast). }
exact Hinfinite.
Qed.

(** Proven Bob **)
(** Infrastructure: constant graph is a function_on **)
Theorem function_on_graph_const : forall A Y c:set,
  c :e Y ->
  function_on (graph A (fun _ : set => c)) A Y.
let A Y c.
assume Hc.
let x. assume Hx : x :e A.
rewrite (apply_fun_graph A (fun _ : set => c) x Hx).
exact Hc.
Qed.

(** from S67 Lem 67.7 (line 2683 in algtop.tex): extension condition for free abelian groups **)
(** LATEX VERSION: G is a free abelian group with basis {a_alpha} iff for any abelian **)
(** group H and any family {y_alpha} of elements of H, there is a unique homomorphism **)
(** h: G -> H with h(a_alpha) = y_alpha. **)
(** EFFORT: 8 lines textbook, difficulty 4/10, USD 80 **)
(** Collected Alice 118 **)
(** Proven Alice **)
Theorem lemma67_7_extension_free_abelian :
  forall G mult e inv J basis:set,
  abelian_group G mult e inv ->
  function_on basis J G ->
  (forall alpha:set, alpha :e J ->
    generator_of G mult e inv (apply_fun basis alpha)) ->
  (free_abelian_group_with_basis G mult e inv J basis <->
   (forall H multH eH invH:set,
     abelian_group H multH eH invH ->
     forall ys:set, function_on ys J H ->
       exists h:set,
         group_homomorphism G mult H multH h /\
         (forall alpha:set, alpha :e J ->
           apply_fun h (apply_fun basis alpha) = apply_fun ys alpha) /\
         (forall h':set, group_homomorphism G mult H multH h' ->
           (forall alpha:set, alpha :e J ->
             apply_fun h' (apply_fun basis alpha) = apply_fun ys alpha) ->
           forall x:set, x :e G -> apply_fun h' x = apply_fun h x))).
let G mult e inv J basis.
assume HabG : abelian_group G mult e inv.
assume Hbasis_fn : function_on basis J G.
assume Hgen : forall alpha:set, alpha :e J ->
  generator_of G mult e inv (apply_fun basis alpha).
apply iffI.
- (** Forward: free_abelian_group_with_basis -> universal property **)
  assume Hfree : free_abelian_group_with_basis G mult e inv J basis.
  let H multH eH invH.
  assume HabH : abelian_group H multH eH invH.
  let ys.
  assume Hys : function_on ys J H.
  (** Extract direct_sum from free_abelian_group_with_basis **)
  (** free_abelian is ((abelian /\ fn_on) /\ infcyc) /\ direct_sum **)
  set Gfam := graph J (fun alpha:set =>
    {g :e G | exists n:set, n :e int /\
      ((n :e omega /\ g = group_power_nat mult e (apply_fun basis alpha) n) \/
       (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
        g = group_power_nat mult e (apply_fun inv (apply_fun basis alpha)) (ordsucc m)))}).
  claim HdsG : direct_sum_of_subgroups G mult e inv J Gfam.
  { exact (andER
      ((abelian_group G mult e inv /\ function_on basis J G) /\
       (forall alpha:set, alpha :e J ->
         infinite_cyclic_subgroup G mult e inv (apply_fun basis alpha)))
      (direct_sum_of_subgroups G mult e inv J Gfam)
      Hfree). }
  claim Hinfcyc : forall alpha:set, alpha :e J ->
    infinite_cyclic_subgroup G mult e inv (apply_fun basis alpha).
  { exact (andER
      (abelian_group G mult e inv /\ function_on basis J G)
      (forall alpha:set, alpha :e J ->
        infinite_cyclic_subgroup G mult e inv (apply_fun basis alpha))
      (andEL
        ((abelian_group G mult e inv /\ function_on basis J G) /\
         (forall alpha:set, alpha :e J ->
           infinite_cyclic_subgroup G mult e inv (apply_fun basis alpha)))
        (direct_sum_of_subgroups G mult e inv J Gfam)
        Hfree)). }
  claim HgrpG : group_structure G mult e inv.
  { exact (andEL (group_structure G mult e inv)
      (forall x y:set, x :e G -> y :e G -> apply_fun mult (x, y) = apply_fun mult (y, x)) HabG). }
  claim HgrpH : group_structure H multH eH invH.
  { exact (andEL (group_structure H multH eH invH)
      (forall x y:set, x :e H -> y :e H -> apply_fun multH (x, y) = apply_fun multH (y, x)) HabH). }
  (** Extract subgroup info from direct_sum **)
  claim HsgaG : subgroups_generate_abelian G mult e inv J Gfam.
  { exact (andEL (subgroups_generate_abelian G mult e inv J Gfam)
      (forall x:set, x :e G ->
        forall n1 n2:set, n1 :e omega -> n2 :e omega -> 
        forall a1 a2:set, function_on a1 n1 J -> function_on a2 n2 J ->
        forall x1 x2:set, function_on x1 n1 G -> function_on x2 n2 G ->
          (forall i:set, i :e n1 -> apply_fun x1 i :e apply_fun Gfam (apply_fun a1 i)) ->
          (forall i:set, i :e n2 -> apply_fun x2 i :e apply_fun Gfam (apply_fun a2 i)) ->
          (forall i j:set, i :e n1 -> j :e n1 -> i <> j -> apply_fun a1 i <> apply_fun a1 j) ->
          (forall i j:set, i :e n2 -> j :e n2 -> i <> j -> apply_fun a2 i <> apply_fun a2 j) ->
          x = nat_primrec e (fun i r => apply_fun mult (r, apply_fun x1 i)) n1 ->
          x = nat_primrec e (fun i r => apply_fun mult (r, apply_fun x2 i)) n2 ->
          (forall alpha:set, alpha :e J ->
            (forall i j:set, i :e n1 -> j :e n2 ->
              apply_fun a1 i = alpha -> apply_fun a2 j = alpha ->
              apply_fun x1 i = apply_fun x2 j) /\
            ((exists i:set, i :e n1 /\ apply_fun a1 i = alpha) ->
             ~(exists j:set, j :e n2 /\ apply_fun a2 j = alpha) ->
             forall i:set, i :e n1 -> apply_fun a1 i = alpha -> apply_fun x1 i = e) /\
            (~(exists i:set, i :e n1 /\ apply_fun a1 i = alpha) ->
             (exists j:set, j :e n2 /\ apply_fun a2 j = alpha) ->
             forall j:set, j :e n2 -> apply_fun a2 j = alpha -> apply_fun x2 j = e)))
      HdsG). }
  claim Hsub_alpha : forall alpha:set, alpha :e J ->
    subgroup_of (apply_fun Gfam alpha) G mult e inv.
  { claim HsgaE : abelian_group G mult e inv /\
      (forall alpha:set, alpha :e J -> subgroup_of (apply_fun Gfam alpha) G mult e inv) /\
      (forall x:set, x :e G ->
        exists n:set, n :e omega /\
        exists alphas:set, function_on alphas n J /\
        exists xs:set, function_on xs n G /\
          (forall i:set, i :e n -> apply_fun xs i :e apply_fun Gfam (apply_fun alphas i)) /\
          (forall i j:set, i :e n -> j :e n -> i <> j ->
            apply_fun alphas i <> apply_fun alphas j) /\
          x = nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) n).
    { exact HsgaG. }
    exact (andER
      (abelian_group G mult e inv)
      (forall alpha:set, alpha :e J -> subgroup_of (apply_fun Gfam alpha) G mult e inv)
      (andEL
        (abelian_group G mult e inv /\
         (forall alpha:set, alpha :e J -> subgroup_of (apply_fun Gfam alpha) G mult e inv))
        (forall x:set, x :e G ->
          exists n:set, n :e omega /\
          exists alphas:set, function_on alphas n J /\
          exists xs:set, function_on xs n G /\
            (forall i:set, i :e n -> apply_fun xs i :e apply_fun Gfam (apply_fun alphas i)) /\
            (forall i j:set, i :e n -> j :e n -> i <> j ->
              apply_fun alphas i <> apply_fun alphas j) /\
            x = nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) n)
        HsgaE)). }
  (** For each alpha, get a group_homomorphism from Gfam(alpha) to H **)
  (** using infinite_cyclic_universal_property **)
  claim Hhalpha_exists : forall alpha:set, alpha :e J ->
    exists halpha:set,
      group_homomorphism (apply_fun Gfam alpha) mult H multH halpha /\
      apply_fun halpha (apply_fun basis alpha) = apply_fun ys alpha.
  { let alpha. assume Hal2 : alpha :e J.
    (** Step 1: group_structure for Gfam(alpha) **)
    claim Hgrp_sub : group_structure (apply_fun Gfam alpha) mult e inv.
    { exact (local_subgroup_group_structure G mult e inv (apply_fun Gfam alpha)
        HgrpG (Hsub_alpha alpha Hal2)). }
    (** Step 2: generator_of for basis(alpha) in Gfam(alpha) **)
    claim Hgen_sub : generator_of (apply_fun Gfam alpha) mult e inv (apply_fun basis alpha).
    { exact (factor_family_generator_of_helper G mult e inv J basis alpha
        HgrpG Hbasis_fn Hal2). }
    (** Step 3: cyclic_group for Gfam(alpha) **)
    claim Hcyc_sub : cyclic_group (apply_fun Gfam alpha) mult e inv.
    { exact (factor_family_cyclic_group_helper
        (apply_fun Gfam alpha) mult e inv (apply_fun basis alpha) Hgrp_sub Hgen_sub). }
    (** Step 4: infinite_cyclic_subgroup for Gfam(alpha) **)
    claim Hinfcyc_sub : infinite_cyclic_subgroup (apply_fun Gfam alpha) mult e inv (apply_fun basis alpha).
    { exact (factor_family_infinite_cyclic_helper G mult e inv J basis alpha
        HgrpG Hbasis_fn Hinfcyc Hal2). }
    (** Step 5: ~ finite Gfam(alpha) **)
    claim Hnotfin : ~ finite (apply_fun Gfam alpha).
    { exact (factor_family_nonfinite_helper (apply_fun Gfam alpha) mult e inv
        (apply_fun basis alpha) Hgrp_sub Hinfcyc_sub). }
    (** Step 6: ys(alpha) :e H **)
    claim Hys_al : apply_fun ys alpha :e H.
    { exact (Hys alpha Hal2). }
    (** Step 7: Apply infinite_cyclic_universal_property **)
    claim Hicup : exists halpha:set,
      group_homomorphism (apply_fun Gfam alpha) mult H multH halpha /\
      apply_fun halpha (apply_fun basis alpha) = apply_fun ys alpha /\
      (forall h':set, group_homomorphism (apply_fun Gfam alpha) mult H multH h' ->
        apply_fun h' (apply_fun basis alpha) = apply_fun ys alpha ->
        forall g:set, g :e (apply_fun Gfam alpha) -> apply_fun h' g = apply_fun halpha g).
    { exact (infinite_cyclic_universal_property
        (apply_fun Gfam alpha) mult e inv (apply_fun basis alpha)
        H multH eH invH (apply_fun ys alpha)
        Hgrp_sub Hcyc_sub Hnotfin Hgen_sub HgrpH Hys_al). }
    (** Extract just hom /\ basis_eq from the 3-fold conjunction **)
    apply Hicup. let halpha. assume Hprop.
    witness halpha.
    exact (andEL
      (group_homomorphism (apply_fun Gfam alpha) mult H multH halpha /\
       apply_fun halpha (apply_fun basis alpha) = apply_fun ys alpha)
      (forall h':set, group_homomorphism (apply_fun Gfam alpha) mult H multH h' ->
        apply_fun h' (apply_fun basis alpha) = apply_fun ys alpha ->
        forall g:set, g :e (apply_fun Gfam alpha) -> apply_fun h' g = apply_fun halpha g)
      Hprop). }
  (** Abbreviation for the Eps_i selection **)
  set phi_raw := fun alpha:set =>
    Eps_i (fun halpha:set =>
      group_homomorphism (apply_fun Gfam alpha) mult H multH halpha /\
      apply_fun halpha (apply_fun basis alpha) = apply_fun ys alpha).
  (** Build hfam as graph-wrapped Eps_i for Power membership **)
  set hfam := graph J (fun alpha:set =>
    graph (apply_fun Gfam alpha) (fun x:set => apply_fun (phi_raw alpha) x)).
  (** Raw Eps_i properties **)
  claim Hhfam_raw : forall alpha:set, alpha :e J ->
    group_homomorphism (apply_fun Gfam alpha) mult H multH (phi_raw alpha) /\
    apply_fun (phi_raw alpha) (apply_fun basis alpha) = apply_fun ys alpha.
  { let alpha. assume Hal2 : alpha :e J.
    exact (Eps_i_ex
      (fun halpha:set =>
        group_homomorphism (apply_fun Gfam alpha) mult H multH halpha /\
        apply_fun halpha (apply_fun basis alpha) = apply_fun ys alpha)
      (Hhalpha_exists alpha Hal2)). }
  (** Double graph evaluation **)
  claim Hhfam_eval : forall alpha:set, alpha :e J ->
    forall x:set, x :e apply_fun Gfam alpha ->
      apply_fun (apply_fun hfam alpha) x = apply_fun (phi_raw alpha) x.
  { let alpha. assume Hal2 : alpha :e J.
    let x. assume Hx : x :e apply_fun Gfam alpha.
    claim Hhfam_def : hfam = graph J (fun alpha':set =>
      graph (apply_fun Gfam alpha') (fun z:set => apply_fun (phi_raw alpha') z)).
    { reflexivity. }
    claim Houter : apply_fun hfam alpha =
      graph (apply_fun Gfam alpha) (fun z:set => apply_fun (phi_raw alpha) z).
    { exact (apply_fun_of_graph_eq hfam J
        (fun alpha':set => graph (apply_fun Gfam alpha') (fun z:set => apply_fun (phi_raw alpha') z))
        alpha Hhfam_def Hal2). }
    rewrite Houter.
    exact (apply_fun_graph (apply_fun Gfam alpha)
      (fun z:set => apply_fun (phi_raw alpha) z) x Hx). }
  (** Subgroup inclusion **)
  claim HGfam_sub_G : forall alpha:set, alpha :e J -> apply_fun Gfam alpha c= G.
  { let alpha. assume Hal2 : alpha :e J.
    exact (andEL
      (apply_fun Gfam alpha c= G)
      (e :e apply_fun Gfam alpha)
      (andEL
        (apply_fun Gfam alpha c= G /\ e :e apply_fun Gfam alpha)
        (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
          apply_fun mult (x, y) :e apply_fun Gfam alpha)
        (andEL
          ((apply_fun Gfam alpha c= G /\ e :e apply_fun Gfam alpha) /\
           (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
             apply_fun mult (x, y) :e apply_fun Gfam alpha))
          (forall x:set, x :e apply_fun Gfam alpha -> apply_fun inv x :e apply_fun Gfam alpha)
          (Hsub_alpha alpha Hal2)))). }
  (** Basis element is in Gfam **)
  claim Hba_in_Gfam : forall alpha:set, alpha :e J ->
    apply_fun basis alpha :e apply_fun Gfam alpha.
  { let alpha. assume Hal2 : alpha :e J.
    claim HGfam_def : Gfam = graph J (fun alpha':set =>
      {g :e G | exists n:set, n :e int /\
        ((n :e omega /\ g = group_power_nat mult e (apply_fun basis alpha') n) \/
         (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
          g = group_power_nat mult e (apply_fun inv (apply_fun basis alpha')) (ordsucc m)))}).
    { reflexivity. }
    claim HGfam_val : apply_fun Gfam alpha =
      {g :e G | exists n:set, n :e int /\
        ((n :e omega /\ g = group_power_nat mult e (apply_fun basis alpha) n) \/
         (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
          g = group_power_nat mult e (apply_fun inv (apply_fun basis alpha)) (ordsucc m)))}.
    { exact (apply_fun_of_graph_eq Gfam J
        (fun alpha':set =>
          {g :e G | exists n:set, n :e int /\
            ((n :e omega /\ g = group_power_nat mult e (apply_fun basis alpha') n) \/
             (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
              g = group_power_nat mult e (apply_fun inv (apply_fun basis alpha')) (ordsucc m)))})
        alpha HGfam_def Hal2). }
    rewrite HGfam_val.
    set ba := apply_fun basis alpha.
    claim Hba_G : ba :e G.
    { exact (Hbasis_fn alpha Hal2). }
    apply (SepI G
      (fun g:set => exists n:set, n :e int /\
        ((n :e omega /\ g = group_power_nat mult e ba n) \/
         (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
          g = group_power_nat mult e (apply_fun inv ba) (ordsucc m))))
      ba Hba_G).
    claim H1omega : ordsucc 0 :e omega.
    { exact (omega_ordsucc 0 (nat_p_omega 0 nat_0)). }
    witness (ordsucc 0).
    apply andI.
    - exact (Subq_omega_int (ordsucc 0) H1omega).
    - apply orIL.
      apply andI.
      + exact H1omega.
      + claim HS1 : group_power_nat mult e ba (ordsucc 0) =
          apply_fun mult (ba, group_power_nat mult e ba 0).
        { exact (nat_primrec_S e (fun _ r => apply_fun mult (ba, r)) 0 nat_0). }
        claim H0e : group_power_nat mult e ba 0 = e.
        { exact (nat_primrec_0 e (fun _ r => apply_fun mult (ba, r))). }
        apply (and6E
          (function_on mult (setprod G G) G)
          (function_on inv G G)
          (e :e G)
          (forall u v w:set, u :e G -> v :e G -> w :e G ->
            apply_fun mult (apply_fun mult (u, v), w) = apply_fun mult (u, apply_fun mult (v, w)))
          (forall u:set, u :e G -> apply_fun mult (e, u) = u /\ apply_fun mult (u, e) = u)
          (forall u:set, u :e G ->
            apply_fun mult (u, apply_fun inv u) = e /\ apply_fun mult (apply_fun inv u, u) = e)
          HgrpG).
        assume HmultFn HinvFn HeG Hassoc Hid HinvLaw.
        claim Hright_id : apply_fun mult (ba, e) = ba.
        { exact (andER (apply_fun mult (e, ba) = ba) (apply_fun mult (ba, e) = ba) (Hid ba Hba_G)). }
        claim Hpow1 : group_power_nat mult e ba (ordsucc 0) = ba.
        { claim Hstep : group_power_nat mult e ba (ordsucc 0) = apply_fun mult (ba, e).
          { claim Hstep2 : apply_fun mult (ba, group_power_nat mult e ba 0) = apply_fun mult (ba, e).
            { rewrite H0e. reflexivity. }
            exact (eq_i_tra
              (group_power_nat mult e ba (ordsucc 0))
              (apply_fun mult (ba, group_power_nat mult e ba 0))
              (apply_fun mult (ba, e))
              HS1 Hstep2). }
          exact (eq_i_tra
            (group_power_nat mult e ba (ordsucc 0))
            (apply_fun mult (ba, e))
            ba Hstep Hright_id). }
        exact (eq_symm (group_power_nat mult e ba (ordsucc 0)) ba Hpow1). }
  (** function_on hfam for Power membership **)
  claim Hhfam_fn : function_on hfam J (Power (setprod G H)).
  { let alpha. assume Hal2 : alpha :e J.
    claim Houter2 : apply_fun hfam alpha =
      graph (apply_fun Gfam alpha) (fun z:set => apply_fun (phi_raw alpha) z).
    { claim Hhfam_def : hfam = graph J (fun alpha':set =>
        graph (apply_fun Gfam alpha') (fun z:set => apply_fun (phi_raw alpha') z)).
      { reflexivity. }
      exact (apply_fun_of_graph_eq hfam J
        (fun alpha':set => graph (apply_fun Gfam alpha') (fun z:set => apply_fun (phi_raw alpha') z))
        alpha Hhfam_def Hal2). }
    claim Hfn_raw : function_on (phi_raw alpha) (apply_fun Gfam alpha) H.
    { exact (andEL
        (function_on (phi_raw alpha) (apply_fun Gfam alpha) H)
        (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
          apply_fun (phi_raw alpha) (apply_fun mult (x, y)) =
          apply_fun multH (apply_fun (phi_raw alpha) x, apply_fun (phi_raw alpha) y))
        (andEL
          (group_homomorphism (apply_fun Gfam alpha) mult H multH (phi_raw alpha))
          (apply_fun (phi_raw alpha) (apply_fun basis alpha) = apply_fun ys alpha)
          (Hhfam_raw alpha Hal2))). }
    rewrite Houter2.
    apply PowerI.
    apply (Subq_tra
      (graph (apply_fun Gfam alpha) (fun z:set => apply_fun (phi_raw alpha) z))
      (setprod (apply_fun Gfam alpha) H)
      (setprod G H)).
    - apply graph_subset_setprod.
      let z. assume Hz : z :e apply_fun Gfam alpha.
      exact (Hfn_raw z Hz).
    - exact (setprod_Subq (apply_fun Gfam alpha) H G H
        (HGfam_sub_G alpha Hal2) (Subq_ref H)). }
  (** Subgroup multiplication closure **)
  claim HGfam_mult_cl : forall alpha:set, alpha :e J ->
    forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
      apply_fun mult (x, y) :e apply_fun Gfam alpha.
  { let alpha. assume Hal2 : alpha :e J.
    exact (andER
      (apply_fun Gfam alpha c= G /\ e :e apply_fun Gfam alpha)
      (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
        apply_fun mult (x, y) :e apply_fun Gfam alpha)
      (andEL
        ((apply_fun Gfam alpha c= G /\ e :e apply_fun Gfam alpha) /\
         (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
           apply_fun mult (x, y) :e apply_fun Gfam alpha))
        (forall x:set, x :e apply_fun Gfam alpha -> apply_fun inv x :e apply_fun Gfam alpha)
        (Hsub_alpha alpha Hal2))). }
  (** group_homomorphism for wrapped hfam **)
  claim Hhfam_hom : forall alpha:set, alpha :e J ->
    group_homomorphism (apply_fun Gfam alpha) mult H multH (apply_fun hfam alpha).
  { let alpha. assume Hal2 : alpha :e J.
    claim Hphi_hom : group_homomorphism (apply_fun Gfam alpha) mult H multH (phi_raw alpha).
    { exact (andEL
        (group_homomorphism (apply_fun Gfam alpha) mult H multH (phi_raw alpha))
        (apply_fun (phi_raw alpha) (apply_fun basis alpha) = apply_fun ys alpha)
        (Hhfam_raw alpha Hal2)). }
    claim Hphi_fn : function_on (phi_raw alpha) (apply_fun Gfam alpha) H.
    { exact (andEL
        (function_on (phi_raw alpha) (apply_fun Gfam alpha) H)
        (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
          apply_fun (phi_raw alpha) (apply_fun mult (x, y)) =
          apply_fun multH (apply_fun (phi_raw alpha) x, apply_fun (phi_raw alpha) y))
        Hphi_hom). }
    claim Hphi_mult : forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
      apply_fun (phi_raw alpha) (apply_fun mult (x, y)) =
      apply_fun multH (apply_fun (phi_raw alpha) x, apply_fun (phi_raw alpha) y).
    { exact (andER
        (function_on (phi_raw alpha) (apply_fun Gfam alpha) H)
        (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
          apply_fun (phi_raw alpha) (apply_fun mult (x, y)) =
          apply_fun multH (apply_fun (phi_raw alpha) x, apply_fun (phi_raw alpha) y))
        Hphi_hom). }
    apply (andI
      (function_on (apply_fun hfam alpha) (apply_fun Gfam alpha) H)
      (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
        apply_fun (apply_fun hfam alpha) (apply_fun mult (x, y)) =
        apply_fun multH (apply_fun (apply_fun hfam alpha) x, apply_fun (apply_fun hfam alpha) y))).
    - let x. assume Hx : x :e apply_fun Gfam alpha.
      rewrite (Hhfam_eval alpha Hal2 x Hx).
      exact (Hphi_fn x Hx).
    - let x y. assume Hx : x :e apply_fun Gfam alpha. assume Hy : y :e apply_fun Gfam alpha.
      rewrite (Hhfam_eval alpha Hal2 (apply_fun mult (x, y)) (HGfam_mult_cl alpha Hal2 x y Hx Hy)).
      rewrite (Hhfam_eval alpha Hal2 x Hx).
      rewrite (Hhfam_eval alpha Hal2 y Hy).
      exact (Hphi_mult x y Hx Hy). }
  (** Basis equation for wrapped hfam **)
  claim Hhfam_basis : forall alpha:set, alpha :e J ->
    apply_fun (apply_fun hfam alpha) (apply_fun basis alpha) = apply_fun ys alpha.
  { let alpha. assume Hal2 : alpha :e J.
    rewrite (Hhfam_eval alpha Hal2 (apply_fun basis alpha) (Hba_in_Gfam alpha Hal2)).
    exact (andER
      (group_homomorphism (apply_fun Gfam alpha) mult H multH (phi_raw alpha))
      (apply_fun (phi_raw alpha) (apply_fun basis alpha) = apply_fun ys alpha)
      (Hhfam_raw alpha Hal2)). }
  (** Apply lemma67_1 to get h **)
  claim Hlem67_1 : exists h:set,
    group_homomorphism G mult H multH h /\
    (forall alpha:set, alpha :e J ->
      forall x:set, x :e apply_fun Gfam alpha ->
        apply_fun h x = apply_fun (apply_fun hfam alpha) x) /\
    (forall h':set, group_homomorphism G mult H multH h' ->
      (forall alpha:set, alpha :e J ->
        forall x:set, x :e apply_fun Gfam alpha ->
          apply_fun h' x = apply_fun (apply_fun hfam alpha) x) ->
      forall x:set, x :e G -> apply_fun h' x = apply_fun h x).
  { exact (lemma67_1_extension_condition_direct_sum G mult e inv J Gfam HdsG H multH eH invH HabH hfam Hhfam_fn Hhfam_hom). }
  apply Hlem67_1. let h. assume Hh.
  claim Hh_hom : group_homomorphism G mult H multH h.
  { exact (andEL
      (group_homomorphism G mult H multH h)
      (forall alpha:set, alpha :e J ->
        forall x:set, x :e apply_fun Gfam alpha ->
          apply_fun h x = apply_fun (apply_fun hfam alpha) x)
      (andEL
        (group_homomorphism G mult H multH h /\
         (forall alpha:set, alpha :e J ->
           forall x:set, x :e apply_fun Gfam alpha ->
             apply_fun h x = apply_fun (apply_fun hfam alpha) x))
        (forall h':set, group_homomorphism G mult H multH h' ->
          (forall alpha:set, alpha :e J ->
            forall x:set, x :e apply_fun Gfam alpha ->
              apply_fun h' x = apply_fun (apply_fun hfam alpha) x) ->
          forall x:set, x :e G -> apply_fun h' x = apply_fun h x)
        Hh)). }
  claim Hh_ext : forall alpha:set, alpha :e J ->
    forall x:set, x :e apply_fun Gfam alpha ->
      apply_fun h x = apply_fun (apply_fun hfam alpha) x.
  { exact (andER
      (group_homomorphism G mult H multH h)
      (forall alpha:set, alpha :e J ->
        forall x:set, x :e apply_fun Gfam alpha ->
          apply_fun h x = apply_fun (apply_fun hfam alpha) x)
      (andEL
        (group_homomorphism G mult H multH h /\
         (forall alpha:set, alpha :e J ->
           forall x:set, x :e apply_fun Gfam alpha ->
             apply_fun h x = apply_fun (apply_fun hfam alpha) x))
        (forall h':set, group_homomorphism G mult H multH h' ->
          (forall alpha:set, alpha :e J ->
            forall x:set, x :e apply_fun Gfam alpha ->
              apply_fun h' x = apply_fun (apply_fun hfam alpha) x) ->
          forall x:set, x :e G -> apply_fun h' x = apply_fun h x)
        Hh)). }
  claim Hh_uniq : forall h':set, group_homomorphism G mult H multH h' ->
    (forall alpha:set, alpha :e J ->
      forall x:set, x :e apply_fun Gfam alpha ->
        apply_fun h' x = apply_fun (apply_fun hfam alpha) x) ->
    forall x:set, x :e G -> apply_fun h' x = apply_fun h x.
  { exact (andER
      (group_homomorphism G mult H multH h /\
       (forall alpha:set, alpha :e J ->
         forall x:set, x :e apply_fun Gfam alpha ->
           apply_fun h x = apply_fun (apply_fun hfam alpha) x))
      (forall h':set, group_homomorphism G mult H multH h' ->
        (forall alpha:set, alpha :e J ->
          forall x:set, x :e apply_fun Gfam alpha ->
            apply_fun h' x = apply_fun (apply_fun hfam alpha) x) ->
        forall x:set, x :e G -> apply_fun h' x = apply_fun h x)
      Hh). }
  (** Witness h and prove the three conjuncts **)
  witness h.
  apply and3I.
  - exact Hh_hom.
  - (** h(basis(alpha)) = ys(alpha) **)
    let alpha. assume Hal : alpha :e J.
    (** basis(alpha) is in Gfam(alpha), so h(basis(alpha)) = hfam(alpha)(basis(alpha)) = ys(alpha) **)
    claim Hstep1 : apply_fun h (apply_fun basis alpha) = apply_fun (apply_fun hfam alpha) (apply_fun basis alpha).
    { exact (Hh_ext alpha Hal (apply_fun basis alpha) (Hba_in_Gfam alpha Hal)). }
