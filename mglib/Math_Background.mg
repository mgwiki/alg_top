  set P0 := fun h0:set =>
    h0 :e H /\
      ((0 :e omega /\ h0 = group_power_nat multH eH y 0) \/
       (exists m:set, m :e omega /\ 0 = minus_SNo (ordsucc m) /\
         h0 = group_power_nat multH eH (apply_fun invH y) (ordsucc m))).
  claim HP0e : P0 eH.
