    (arc X Tx)
    (r :e X)
    (q :e X)
    (r <> q)
    (connected_space (X :\: (Sing r))
      (subspace_topology X Tx (X :\: (Sing r))))
    (connected_space (X :\: (Sing q))
      (subspace_topology X Tx (X :\: (Sing q))))
    Hendrq).
  assume Harc HrX0 HqX Hneq Hconnr Hconnq.
  exact HrX0.
}
claim HrNeQ : r <> q.
{
  apply (and6E
    (arc X Tx)
    (r :e X)
    (q :e X)
    (r <> q)
    (connected_space (X :\: (Sing r))
      (subspace_topology X Tx (X :\: (Sing r))))
    (connected_space (X :\: (Sing q))
      (subspace_topology X Tx (X :\: (Sing q))))
    Hendrq).
  assume Harc HrX0 HqX Hneq Hconnr Hconnq.
