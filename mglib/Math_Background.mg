		                        (apply_fun hifam (group_power_nat integers_group_mult 0 1 t))
		                        (group_power_nat multG eG (apply_fun basis2 alpha) t)
		                        Hlhs
		                        (eq_i_tra
		                          (apply_fun hifam (group_power_nat integers_group_mult 0 1 t))
		                          (group_power_nat multG eG (apply_fun hifam 1) t)
		                          (group_power_nat multG eG (apply_fun basis2 alpha) t)
