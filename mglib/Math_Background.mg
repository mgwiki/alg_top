      { claim Hce : apply_fun (path_lift E Te B Tb p e0 as_f) 1
          = apply_fun (path_lift E Te B Tb p (apply_fun (path_lift E Te B Tb p e0 alpha_s) 1) f_rep) 1.
        { exact (path_lift_concat_endpoint E Te B Tb p e0 alpha_s f_rep
            Hcov He0E Halpha_s_cont Hf_rep_cont Hmatch_as1
            (eq_symm (apply_fun alpha_s 0) b0 Halpha_s0)). }
        rewrite Hce. rewrite Hlift_alpha_s_end. exact (fun P h => h). }
      set e2 := apply_fun (path_lift E Te B Tb p e1 f_rep) 1.
      claim Hlift_full_decomp : apply_fun (path_lift E Te B Tb p e0 full_fwd) 1
        = apply_fun (path_lift E Te B Tb p e2 rev_alpha_s) 1.
      { claim Hce2 : apply_fun (path_lift E Te B Tb p e0 full_fwd) 1
          = apply_fun (path_lift E Te B Tb p (apply_fun (path_lift E Te B Tb p e0 as_f) 1) rev_alpha_s) 1.
        { exact (path_lift_concat_endpoint E Te B Tb p e0 as_f rev_alpha_s
            Hcov He0E Has_f_cont Hrev_as_cont Hmatch_asf_rev
            (eq_symm (apply_fun as_f 0) b0 Has_f_0)). }
        rewrite Hce2. rewrite Hlift_as_f_end. exact (fun P h => h). }
      (** So lift(rev_alpha_s, e2)(1) = e0 **)
      claim Hlift_rev_e2 : apply_fun (path_lift E Te B Tb p e2 rev_alpha_s) 1 = e0.
      { claim Htmp : apply_fun (path_lift E Te B Tb p e2 rev_alpha_s) 1
          = apply_fun (path_lift E Te B Tb p e0 full_fwd) 1.
        { exact (eq_symm (apply_fun (path_lift E Te B Tb p e0 full_fwd) 1)
            (apply_fun (path_lift E Te B Tb p e2 rev_alpha_s) 1) Hlift_full_decomp). }
        rewrite Htmp. exact Hlift_full_fwd. }
      (** e2 in E and p(e2) = b0 **)
      claim Hpe1_frep0 : apply_fun p e1 = apply_fun f_rep 0.
      { rewrite Hpe1. rewrite Hf_rep_0. exact (eq_refl b0). }
      claim Hlift_frep_e1_pack : (continuous_map unit_interval unit_interval_topology E Te (path_lift E Te B Tb p e1 f_rep) /\
        apply_fun (path_lift E Te B Tb p e1 f_rep) 0 = e1) /\
        (forall t:set, t :e unit_interval -> apply_fun p (apply_fun (path_lift E Te B Tb p e1 f_rep) t) = apply_fun f_rep t).
      { exact (lemma54_1_path_lifting E Te B Tb p e1 f_rep Hcov He1E Hpe1_frep0 Hf_rep_cont). }
      claim Hlift_frep_e1_cont : continuous_map unit_interval unit_interval_topology E Te (path_lift E Te B Tb p e1 f_rep).
      { exact (andEL (continuous_map unit_interval unit_interval_topology E Te (path_lift E Te B Tb p e1 f_rep))
          (apply_fun (path_lift E Te B Tb p e1 f_rep) 0 = e1)
          (andEL (continuous_map unit_interval unit_interval_topology E Te (path_lift E Te B Tb p e1 f_rep) /\
            apply_fun (path_lift E Te B Tb p e1 f_rep) 0 = e1)
            (forall t:set, t :e unit_interval -> apply_fun p (apply_fun (path_lift E Te B Tb p e1 f_rep) t) = apply_fun f_rep t)
            Hlift_frep_e1_pack)). }
      claim Hlift_frep_e1_fun : function_on (path_lift E Te B Tb p e1 f_rep) unit_interval E.
      { exact (continuous_map_function_on unit_interval unit_interval_topology E Te (path_lift E Te B Tb p e1 f_rep) Hlift_frep_e1_cont). }
      claim He2E : e2 :e E.
      { exact (Hlift_frep_e1_fun 1 one_in_unit_interval). }
      claim Hpe2_frep1 : apply_fun p e2 = apply_fun f_rep 1.
      { exact (andER (continuous_map unit_interval unit_interval_topology E Te (path_lift E Te B Tb p e1 f_rep) /\
          apply_fun (path_lift E Te B Tb p e1 f_rep) 0 = e1)
          (forall t:set, t :e unit_interval -> apply_fun p (apply_fun (path_lift E Te B Tb p e1 f_rep) t) = apply_fun f_rep t)
          Hlift_frep_e1_pack 1 one_in_unit_interval). }
      claim Hpe2b0 : apply_fun p e2 = b0.
      { rewrite Hpe2_frep1. exact Hf_rep_1. }
      (** Apply path_lift_reverse_endpoint to rev_alpha_s at e2: **)
      (** lift(reverse_path(rev_alpha_s), e0)(1) = e2 **)
      claim Hpe2_rev_as : apply_fun p e2 = apply_fun rev_alpha_s 0.
      { rewrite Hpe2b0. rewrite Hrev_as_0. exact (eq_refl b0). }
      claim Hlift_rr_e2 : apply_fun (path_lift E Te B Tb p
        (apply_fun (path_lift E Te B Tb p e2 rev_alpha_s) 1)
        (reverse_path rev_alpha_s)) 1 = e2.
      { exact (path_lift_reverse_endpoint E Te B Tb p e2 rev_alpha_s
          Hcov He2E Hrev_as_cont Hpe2_rev_as). }
      claim Hlift_rr_at_e0 : apply_fun (path_lift E Te B Tb p e0 (reverse_path rev_alpha_s)) 1 = e2.
      { rewrite <- Hlift_rev_e2. exact Hlift_rr_e2. }
      (** Also lift(alpha_s, e0)(1) = e1. Show both lifts agree by uniqueness. **)
      (** reverse_path(rev_alpha_s) agrees pointwise with alpha_s **)
      (** So lift(reverse_path(rev_alpha_s), e0) is a lifting_of alpha_s **)
      (** By uniqueness with path_lift(alpha_s, e0), they agree at 1 **)
      claim He2_eq_e1 : e2 = e1.
      { (** Show lift(reverse_path(rev_alpha_s), e0) agrees with lift(alpha_s, e0) **)
        claim Hrr_0 : apply_fun (reverse_path rev_alpha_s) 0 = b0.
        { claim Ht3 : apply_fun (reverse_path rev_alpha_s) 0 = apply_fun rev_alpha_s 1.
          { exact (reverse_path_at_zero rev_alpha_s). }
          rewrite Ht3. exact Hrev_as_1. }
        claim Hpe0_rr : apply_fun p e0 = apply_fun (reverse_path rev_alpha_s) 0.
        { rewrite Hrr_0. exact (fun P h => h). }
        claim Hrr_cont : continuous_map unit_interval unit_interval_topology B Tb (reverse_path rev_alpha_s).
        { exact (reverse_path_continuous B Tb rev_alpha_s Hrev_as_cont). }
        claim Hrr_pack : (continuous_map unit_interval unit_interval_topology E Te
            (path_lift E Te B Tb p e0 (reverse_path rev_alpha_s)) /\
          apply_fun (path_lift E Te B Tb p e0 (reverse_path rev_alpha_s)) 0 = e0) /\
          (forall t:set, t :e unit_interval ->
            apply_fun p (apply_fun (path_lift E Te B Tb p e0 (reverse_path rev_alpha_s)) t)
            = apply_fun (reverse_path rev_alpha_s) t).
        { exact (lemma54_1_path_lifting E Te B Tb p e0 (reverse_path rev_alpha_s)
            Hcov He0E Hpe0_rr Hrr_cont). }
        claim Hrr_left : continuous_map unit_interval unit_interval_topology E Te
          (path_lift E Te B Tb p e0 (reverse_path rev_alpha_s)) /\
          apply_fun (path_lift E Te B Tb p e0 (reverse_path rev_alpha_s)) 0 = e0.
        { exact (andEL
            (continuous_map unit_interval unit_interval_topology E Te
              (path_lift E Te B Tb p e0 (reverse_path rev_alpha_s)) /\
            apply_fun (path_lift E Te B Tb p e0 (reverse_path rev_alpha_s)) 0 = e0)
            (forall t:set, t :e unit_interval ->
              apply_fun p (apply_fun (path_lift E Te B Tb p e0 (reverse_path rev_alpha_s)) t)
              = apply_fun (reverse_path rev_alpha_s) t)
            Hrr_pack). }
        claim Hrr_lift_cont : continuous_map unit_interval unit_interval_topology E Te
          (path_lift E Te B Tb p e0 (reverse_path rev_alpha_s)).
        { exact (andEL (continuous_map unit_interval unit_interval_topology E Te
            (path_lift E Te B Tb p e0 (reverse_path rev_alpha_s)))
            (apply_fun (path_lift E Te B Tb p e0 (reverse_path rev_alpha_s)) 0 = e0)
            Hrr_left). }
        claim Hrr_start : apply_fun (path_lift E Te B Tb p e0 (reverse_path rev_alpha_s)) 0 = e0.
        { exact (andER (continuous_map unit_interval unit_interval_topology E Te
            (path_lift E Te B Tb p e0 (reverse_path rev_alpha_s)))
            (apply_fun (path_lift E Te B Tb p e0 (reverse_path rev_alpha_s)) 0 = e0)
            Hrr_left). }
        claim Hrr_proj : forall t:set, t :e unit_interval ->
          apply_fun p (apply_fun (path_lift E Te B Tb p e0 (reverse_path rev_alpha_s)) t)
          = apply_fun (reverse_path rev_alpha_s) t.
        { exact (andER
            (continuous_map unit_interval unit_interval_topology E Te
              (path_lift E Te B Tb p e0 (reverse_path rev_alpha_s)) /\
            apply_fun (path_lift E Te B Tb p e0 (reverse_path rev_alpha_s)) 0 = e0)
            (forall t:set, t :e unit_interval ->
              apply_fun p (apply_fun (path_lift E Te B Tb p e0 (reverse_path rev_alpha_s)) t)
              = apply_fun (reverse_path rev_alpha_s) t)
            Hrr_pack). }
        (** Build lifting_of alpha_s from this lift **)
        claim Hrr_is_lifting : lifting_of unit_interval unit_interval_topology E Te B Tb p alpha_s
          (path_lift E Te B Tb p e0 (reverse_path rev_alpha_s)).
        { prove continuous_map unit_interval unit_interval_topology E Te
            (path_lift E Te B Tb p e0 (reverse_path rev_alpha_s)) /\
          (forall t:set, t :e unit_interval ->
            apply_fun p (apply_fun (path_lift E Te B Tb p e0 (reverse_path rev_alpha_s)) t)
            = apply_fun alpha_s t).
          apply andI.
          - exact Hrr_lift_cont.
          - let t. assume Ht.
            claim Hlift_rr_proj_t : apply_fun p
              (apply_fun (path_lift E Te B Tb p e0 (reverse_path rev_alpha_s)) t)
              = apply_fun (reverse_path rev_alpha_s) t.
            { exact (Hrr_proj t Ht). }
            rewrite Hlift_rr_proj_t.
            exact (reverse_path_involutive_pointwise alpha_s t Ht). }
        claim Has_lifting : lifting_of unit_interval unit_interval_topology E Te B Tb p alpha_s
          (path_lift E Te B Tb p e0 alpha_s).
        { exact (path_lift_is_lifting_of E Te B Tb p e0 alpha_s Hcov He0E
            (eq_symm (apply_fun alpha_s 0) b0 Halpha_s0) Halpha_s_cont). }
        claim Has_start : apply_fun (path_lift E Te B Tb p e0 alpha_s) 0 = e0.
        { exact (andER (continuous_map unit_interval unit_interval_topology E Te (path_lift E Te B Tb p e0 alpha_s))
            (apply_fun (path_lift E Te B Tb p e0 alpha_s) 0 = e0)
            (andEL (continuous_map unit_interval unit_interval_topology E Te (path_lift E Te B Tb p e0 alpha_s) /\
              apply_fun (path_lift E Te B Tb p e0 alpha_s) 0 = e0)
              (forall t:set, t :e unit_interval -> apply_fun p (apply_fun (path_lift E Te B Tb p e0 alpha_s) t) = apply_fun alpha_s t)
              (lemma54_1_path_lifting E Te B Tb p e0 alpha_s Hcov He0E
                (eq_symm (apply_fun alpha_s 0) b0 Halpha_s0) Halpha_s_cont))). }
        claim Hagree_at_1 : apply_fun (path_lift E Te B Tb p e0 (reverse_path rev_alpha_s)) 1
          = apply_fun (path_lift E Te B Tb p e0 alpha_s) 1.
        { exact (lemma54_1_path_lifting_unique E Te B Tb p e0 alpha_s
            (path_lift E Te B Tb p e0 (reverse_path rev_alpha_s))
            (path_lift E Te B Tb p e0 alpha_s)
            Hcov He0E Halpha_s_cont
            Hrr_is_lifting Hrr_start
            Has_lifting Has_start
            1 one_in_unit_interval). }
        rewrite <- Hlift_rr_at_e0.
        rewrite Hagree_at_1.
        exact Hlift_alpha_s_end. }
      (** Now e2 = e1, so lift(f_rep, e1)(1) = e1 **)
      (** Use thm54_6c_backward at e1 **)
      claim Hlift_frep_e1 : apply_fun (path_lift E Te B Tb p e1 f_rep) 1 = e1.
      { exact (eq_symm e1 e2 (eq_symm e2 e1 He2_eq_e1)). }
      claim Hf_rep_la_pe1 : loop_at B Tb (apply_fun p e1) f_rep.
      { rewrite Hpe1. exact Hf_rep_la. }
      claim Hf_rep_in_H1 : path_homotopy_class_loop B Tb (apply_fun p e1) f_rep :e H1.
      { exact (thm54_6c_loop_characterization_backward E Te B Tb p e1 f_rep
          Hcov He1E Hf_rep_la_pe1 Hlift_frep_e1). }
      (** Rewrite to show hh in H1 **)
      claim Htmp_eq : path_homotopy_class_loop B Tb (apply_fun p e1) f_rep = hh.
      { claim Htmp2 : path_homotopy_class_loop B Tb (apply_fun p e1) f_rep
          = path_homotopy_class_loop B Tb b0 f_rep.
        { rewrite Hpe1. exact (eq_refl (path_homotopy_class_loop B Tb b0 f_rep)). }
        rewrite Htmp2. exact (eq_symm hh (path_homotopy_class_loop B Tb b0 f_rep) Hhh_eq). }
      rewrite <- Htmp_eq. exact Hf_rep_in_H1.
    - (** H1 c= H0: take hh in H1, show hh in H0 **)
      (** Use lifting + normalizer cond 2 to unconjugate **)
      let hh. assume HhhH1.
      (** Rewrite H1 to use b0 **)
      claim HhhH1_b0 : hh :e homomorphism_image (fundamental_group E Te e1)
        (induced_homomorphism E Te e1 B Tb b0 p).
      { claim Htmp : homomorphism_image (fundamental_group E Te e1) (induced_homomorphism E Te e1 B Tb (apply_fun p e1) p)
          = homomorphism_image (fundamental_group E Te e1) (induced_homomorphism E Te e1 B Tb b0 p).
        { rewrite Hpe1. exact (eq_refl (homomorphism_image (fundamental_group E Te e1) (induced_homomorphism E Te e1 B Tb b0 p))). }
        rewrite <- Htmp. exact HhhH1. }
      (** Get subgroup for H1 **)
      claim HgrpE1 : group_structure (fundamental_group E Te e1) (fundamental_group_mult E Te e1)
        (fundamental_group_id E Te e1) (fundamental_group_inv E Te e1).
      { exact (fundamental_group_is_group E Te e1 HtopE He1E). }
      claim Hphi1_hom : group_homomorphism
        (fundamental_group E Te e1) (fundamental_group_mult E Te e1)
        G multG (induced_homomorphism E Te e1 B Tb b0 p).
      { exact (induced_homomorphism_is_homomorphism E Te e1 B Tb b0 p Hp_cont Hpe1 He1E). }
      claim HH1_sub_b0 : subgroup_of (homomorphism_image (fundamental_group E Te e1) (induced_homomorphism E Te e1 B Tb b0 p)) G multG eG invG.
      { exact (homomorphism_image_subgroup_of
          (fundamental_group E Te e1) (fundamental_group_mult E Te e1)
          (fundamental_group_id E Te e1) (fundamental_group_inv E Te e1)
          G multG eG invG
          (induced_homomorphism E Te e1 B Tb b0 p)
          HgrpE1 HgrpG Hphi1_hom). }
      claim HhhG : hh :e G.
      { exact (subgroup_of_subset (homomorphism_image (fundamental_group E Te e1) (induced_homomorphism E Te e1 B Tb b0 p))
          G multG eG invG HH1_sub_b0 hh HhhH1_b0). }
      claim Hnn_rep : exists f_rep:set, f_rep :e loop_space B Tb b0 /\
        hh = path_homotopy_class_loop B Tb b0 f_rep.
      { exact (fundamental_group_member_has_representative B Tb b0 hh HhhG). }
      apply Hnn_rep. let f_rep. assume Hf_repPack.
      claim Hf_rep_ls : f_rep :e loop_space B Tb b0.
      { exact (andEL (f_rep :e loop_space B Tb b0)
          (hh = path_homotopy_class_loop B Tb b0 f_rep) Hf_repPack). }
      claim Hhh_eq : hh = path_homotopy_class_loop B Tb b0 f_rep.
      { exact (andER (f_rep :e loop_space B Tb b0)
          (hh = path_homotopy_class_loop B Tb b0 f_rep) Hf_repPack). }
      claim Hf_rep_la : loop_at B Tb b0 f_rep.
      { exact (loop_space_has_loop_at B Tb b0 f_rep Hf_rep_ls). }
      claim Hf_rep_cont : continuous_map unit_interval unit_interval_topology B Tb f_rep.
      { exact (andEL (continuous_map unit_interval unit_interval_topology B Tb f_rep)
          (apply_fun f_rep 0 = b0)
          (andEL (continuous_map unit_interval unit_interval_topology B Tb f_rep /\ apply_fun f_rep 0 = b0)
            (apply_fun f_rep 1 = b0) Hf_rep_la)). }
      claim Hf_rep_0 : apply_fun f_rep 0 = b0.
      { exact (andER (continuous_map unit_interval unit_interval_topology B Tb f_rep)
          (apply_fun f_rep 0 = b0)
          (andEL (continuous_map unit_interval unit_interval_topology B Tb f_rep /\ apply_fun f_rep 0 = b0)
            (apply_fun f_rep 1 = b0) Hf_rep_la)). }
      claim Hf_rep_1 : apply_fun f_rep 1 = b0.
      { exact (andER (continuous_map unit_interval unit_interval_topology B Tb f_rep /\ apply_fun f_rep 0 = b0)
          (apply_fun f_rep 1 = b0) Hf_rep_la). }
      (** hh in H1 means lift(f_rep, e1)(1) = e1 **)
      claim Hf_rep_la_pe1 : loop_at B Tb (apply_fun p e1) f_rep.
      { rewrite Hpe1. exact Hf_rep_la. }
      claim HhhH1_class : path_homotopy_class_loop B Tb (apply_fun p e1) f_rep :e H1.
      { claim Htmp : path_homotopy_class_loop B Tb (apply_fun p e1) f_rep
          = path_homotopy_class_loop B Tb b0 f_rep.
        { rewrite Hpe1. exact (eq_refl (path_homotopy_class_loop B Tb b0 f_rep)). }
        rewrite Htmp. claim Htmp2 : path_homotopy_class_loop B Tb b0 f_rep = hh.
        { exact (eq_symm hh (path_homotopy_class_loop B Tb b0 f_rep) Hhh_eq). }
        rewrite Htmp2. exact HhhH1. }
      claim Hlift_frep_e1 : apply_fun (path_lift E Te B Tb p e1 f_rep) 1 = e1.
      { exact (thm54_6c_loop_characterization_forward E Te B Tb p e1 f_rep
          Hcov He1E Hf_rep_la_pe1 HhhH1_class). }
      (** Build full = concat(alpha_s, concat(f_rep, rev_alpha_s)) **)
      claim Hmatch1 : apply_fun alpha_s 1 = apply_fun f_rep 0.
      { rewrite Halpha_s1. rewrite Hf_rep_0. exact (eq_refl b0). }
      set as_f := path_concat alpha_s f_rep.
      claim Has_f_cont : continuous_map unit_interval unit_interval_topology B Tb as_f.
      { exact (path_concat_continuous B Tb b0 b0 b0 alpha_s f_rep
          Halpha_s_cont Hf_rep_cont Halpha_s0 Halpha_s1 Hf_rep_0 Hf_rep_1). }
      claim Has_f_0 : apply_fun as_f 0 = b0.
      { claim Ht : apply_fun (path_concat alpha_s f_rep) 0 = apply_fun alpha_s 0.
        { exact (path_concat_at_zero alpha_s f_rep). }
        rewrite Ht. exact Halpha_s0. }
      claim Has_f_1 : apply_fun as_f 1 = b0.
      { claim Ht : apply_fun (path_concat alpha_s f_rep) 1 = apply_fun f_rep 1.
        { exact (path_concat_at_one alpha_s f_rep). }
        rewrite Ht. exact Hf_rep_1. }
      claim Hmatch2 : apply_fun as_f 1 = apply_fun rev_alpha_s 0.
      { rewrite Has_f_1. rewrite Hrev_as_0. exact (eq_refl b0). }
      set full_h1 := path_concat as_f rev_alpha_s.
      claim Hfull_h1_cont : continuous_map unit_interval unit_interval_topology B Tb full_h1.
      { exact (path_concat_continuous B Tb b0 b0 b0 as_f rev_alpha_s
          Has_f_cont Hrev_as_cont Has_f_0 Has_f_1 Hrev_as_0 Hrev_as_1). }
      claim Hfull_h1_0 : apply_fun full_h1 0 = b0.
      { claim Ht : apply_fun (path_concat as_f rev_alpha_s) 0 = apply_fun as_f 0.
        { exact (path_concat_at_zero as_f rev_alpha_s). }
        rewrite Ht. exact Has_f_0. }
      claim Hfull_h1_1 : apply_fun full_h1 1 = b0.
      { claim Ht : apply_fun (path_concat as_f rev_alpha_s) 1 = apply_fun rev_alpha_s 1.
        { exact (path_concat_at_one as_f rev_alpha_s). }
        rewrite Ht. exact Hrev_as_1. }
      claim Hfull_h1_la : loop_at B Tb b0 full_h1.
      { prove (continuous_map unit_interval unit_interval_topology B Tb full_h1 /\ apply_fun full_h1 0 = b0) /\ apply_fun full_h1 1 = b0.
        apply andI. apply andI. exact Hfull_h1_cont. exact Hfull_h1_0. exact Hfull_h1_1. }
      (** lift(full_h1, e0)(1) = e0 **)
      claim Hlift_as_f_end : apply_fun (path_lift E Te B Tb p e0 as_f) 1 = e1.
      { claim Hce : apply_fun (path_lift E Te B Tb p e0 as_f) 1
          = apply_fun (path_lift E Te B Tb p (apply_fun (path_lift E Te B Tb p e0 alpha_s) 1) f_rep) 1.
        { exact (path_lift_concat_endpoint E Te B Tb p e0 alpha_s f_rep
            Hcov He0E Halpha_s_cont Hf_rep_cont Hmatch1
            (eq_symm (apply_fun alpha_s 0) b0 Halpha_s0)). }
        rewrite Hce. rewrite Hlift_alpha_s_end. exact Hlift_frep_e1. }
      claim Hlift_full_h1_end : apply_fun (path_lift E Te B Tb p e0 full_h1) 1 = e0.
      { claim Hce2 : apply_fun (path_lift E Te B Tb p e0 full_h1) 1
          = apply_fun (path_lift E Te B Tb p (apply_fun (path_lift E Te B Tb p e0 as_f) 1) rev_alpha_s) 1.
        { exact (path_lift_concat_endpoint E Te B Tb p e0 as_f rev_alpha_s
            Hcov He0E Has_f_cont Hrev_as_cont Hmatch2
            (eq_symm (apply_fun as_f 0) b0 Has_f_0)). }
        rewrite Hce2. rewrite Hlift_as_f_end. rewrite <- Hlift_alpha_s_end.
        exact (path_lift_reverse_endpoint E Te B Tb p e0 alpha_s
          Hcov He0E Halpha_s_cont (eq_symm (apply_fun alpha_s 0) b0 Halpha_s0)). }
      (** [full_h1] in H0 by thm54_6c_backward **)
      claim Hfull_h1_in_H0 : path_homotopy_class_loop B Tb b0 full_h1 :e H0.
      { exact (thm54_6c_loop_characterization_backward E Te B Tb p e0 full_h1
          Hcov He0E Hfull_h1_la Hlift_full_h1_end). }
      (** [full_h1] = alpha_s . hh . inv(alpha_s) **)
      claim Hfull_h1_eq : path_homotopy_class_loop B Tb b0 full_h1
        = apply_fun multG (apply_fun multG (alpha_s_class, hh), apply_fun invG alpha_s_class).
      { claim Has_f_la : loop_at B Tb b0 as_f.
        { prove (continuous_map unit_interval unit_interval_topology B Tb as_f /\ apply_fun as_f 0 = b0) /\ apply_fun as_f 1 = b0.
          apply andI. apply andI. exact Has_f_cont. exact Has_f_0. exact Has_f_1. }
        claim Hclass_as_f : path_homotopy_class_loop B Tb b0 as_f
          = apply_fun multG (alpha_s_class, path_homotopy_class_loop B Tb b0 f_rep).
        { exact (loop_at_concat_eq_mult B Tb b0 alpha_s f_rep
            HtopB Hb0B Halpha_s_loop Hf_rep_la). }
        claim Hclass_full_h1 : path_homotopy_class_loop B Tb b0 full_h1
          = apply_fun multG (path_homotopy_class_loop B Tb b0 as_f, rev_as_class).
        { exact (loop_at_concat_eq_mult B Tb b0 as_f rev_alpha_s
            HtopB Hb0B Has_f_la Hrev_as_la). }
        rewrite Hclass_full_h1. rewrite Hclass_as_f.
        rewrite <- Hinv_eq_rev_s. rewrite Hhh_eq. reflexivity. }
      (** So alpha_s . hh . inv(alpha_s) in H0 **)
      claim Hconj_in_H0 : apply_fun multG (apply_fun multG (alpha_s_class, hh), apply_fun invG alpha_s_class) :e H0.
      { rewrite <- Hfull_h1_eq. exact Hfull_h1_in_H0. }
      (** By normalizer cond 2: inv(alpha_s) . (alpha_s . hh . inv(alpha_s)) . alpha_s in H0 **)
      claim Hunconj : apply_fun multG (apply_fun multG (apply_fun invG alpha_s_class,
        apply_fun multG (apply_fun multG (alpha_s_class, hh), apply_fun invG alpha_s_class)),
        alpha_s_class) :e H0.
      { exact (Hnorm2
          (apply_fun multG (apply_fun multG (alpha_s_class, hh), apply_fun invG alpha_s_class))
          Hconj_in_H0). }
      (** Simplify: inv(a) . (a . h . inv(a)) . a = h by group laws **)
      (** This requires associativity and cancellation **)
      claim Hsimplify : apply_fun multG (apply_fun multG (apply_fun invG alpha_s_class,
        apply_fun multG (apply_fun multG (alpha_s_class, hh), apply_fun invG alpha_s_class)),
        alpha_s_class) = hh.
      { (** Extract group axioms **)
        apply (and6E
          (function_on multG (setprod G G) G) (function_on invG G G) (eG :e G)
          (forall a b c:set, a :e G -> b :e G -> c :e G ->
            apply_fun multG (apply_fun multG (a, b), c) = apply_fun multG (a, apply_fun multG (b, c)))
          (forall a:set, a :e G -> apply_fun multG (eG, a) = a /\ apply_fun multG (a, eG) = a)
          (forall a:set, a :e G ->
            apply_fun multG (a, apply_fun invG a) = eG /\ apply_fun multG (apply_fun invG a, a) = eG)
          HgrpG).
        assume HmultFn HinvFn HeGmem HassocG HidG HinvAxG.
        set a := alpha_s_class.
        set ia := apply_fun invG alpha_s_class.
        claim HaG : a :e G. { exact Halpha_s_G. }
        claim HiaG : ia :e G. { exact Hinv_alpha_s_G. }
        claim HahG : apply_fun multG (a, hh) :e G.
        { exact (group_source_mult_closure G multG eG invG HgrpG a hh HaG HhhG). }
        claim Hah_iaG : apply_fun multG (apply_fun multG (a, hh), ia) :e G.
        { exact (group_source_mult_closure G multG eG invG HgrpG (apply_fun multG (a, hh)) ia HahG HiaG). }
        claim Hh_iaG : apply_fun multG (hh, ia) :e G.
        { exact (group_source_mult_closure G multG eG invG HgrpG hh ia HhhG HiaG). }
        (** Step 1: assoc on multG(multG(a,hh), ia) -> multG(a, multG(hh, ia)) **)
        claim Hstep1 : apply_fun multG (apply_fun multG (a, hh), ia)
          = apply_fun multG (a, apply_fun multG (hh, ia)).
        { exact (HassocG a hh ia HaG HhhG HiaG). }
        (** Step 2: assoc on multG(ia, multG(a, multG(hh, ia))) -> multG(multG(ia, a), multG(hh, ia)) **)
        claim Ha_h_iaG : apply_fun multG (a, apply_fun multG (hh, ia)) :e G.
        { exact (group_source_mult_closure G multG eG invG HgrpG a (apply_fun multG (hh, ia)) HaG Hh_iaG). }
        claim Hstep2a : apply_fun multG (ia, apply_fun multG (a, apply_fun multG (hh, ia)))
          = apply_fun multG (apply_fun multG (ia, a), apply_fun multG (hh, ia)).
        { exact (eq_symm
            (apply_fun multG (apply_fun multG (ia, a), apply_fun multG (hh, ia)))
            (apply_fun multG (ia, apply_fun multG (a, apply_fun multG (hh, ia))))
            (HassocG ia a (apply_fun multG (hh, ia)) HiaG HaG Hh_iaG)). }
        (** Step 3: ia . a = e **)
        claim Hia_a_eG : apply_fun multG (ia, a) = eG.
        { exact (andER (apply_fun multG (a, ia) = eG) (apply_fun multG (ia, a) = eG)
            (HinvAxG a HaG)). }
        (** Step 4: e . x = x **)
        claim He_h_ia : apply_fun multG (eG, apply_fun multG (hh, ia)) = apply_fun multG (hh, ia).
        { exact (andEL (apply_fun multG (eG, apply_fun multG (hh, ia)) = apply_fun multG (hh, ia))
            (apply_fun multG (apply_fun multG (hh, ia), eG) = apply_fun multG (hh, ia))
            (HidG (apply_fun multG (hh, ia)) Hh_iaG)). }
        (** Step 5: assoc on multG(multG(hh, ia), a) -> multG(hh, multG(ia, a)) **)
        claim Hstep5 : apply_fun multG (apply_fun multG (hh, ia), a)
          = apply_fun multG (hh, apply_fun multG (ia, a)).
        { exact (HassocG hh ia a HhhG HiaG HaG). }
        (** Step 6: multG(hh, e) = hh **)
        claim Hh_e : apply_fun multG (hh, eG) = hh.
        { exact (andER (apply_fun multG (eG, hh) = hh) (apply_fun multG (hh, eG) = hh)
            (HidG hh HhhG)). }
        (** Now chain the rewrites **)
        (** Original: multG(multG(ia, multG(multG(a,hh), ia)), a) **)
        (** Rewrite step1 in the inner part **)
        claim Hchain1 : apply_fun multG (apply_fun multG (ia, apply_fun multG (apply_fun multG (a, hh), ia)), a)
          = apply_fun multG (apply_fun multG (ia, apply_fun multG (a, apply_fun multG (hh, ia))), a).
        { rewrite Hstep1. exact (fun P h => h). }
        (** Rewrite step2a **)
        claim Hchain2 : apply_fun multG (apply_fun multG (ia, apply_fun multG (a, apply_fun multG (hh, ia))), a)
          = apply_fun multG (apply_fun multG (apply_fun multG (ia, a), apply_fun multG (hh, ia)), a).
        { rewrite Hstep2a. exact (fun P h => h). }
        (** Rewrite ia.a = e **)
        claim Hchain3 : apply_fun multG (apply_fun multG (apply_fun multG (ia, a), apply_fun multG (hh, ia)), a)
          = apply_fun multG (apply_fun multG (eG, apply_fun multG (hh, ia)), a).
        { rewrite Hia_a_eG. exact (fun P h => h). }
        (** Rewrite e.x = x **)
        claim Hchain4 : apply_fun multG (apply_fun multG (eG, apply_fun multG (hh, ia)), a)
          = apply_fun multG (apply_fun multG (hh, ia), a).
        { rewrite He_h_ia. exact (fun P h => h). }
        (** Rewrite step5 **)
        claim Hchain5 : apply_fun multG (apply_fun multG (hh, ia), a)
          = apply_fun multG (hh, apply_fun multG (ia, a)).
        { exact Hstep5. }
        (** Rewrite ia.a = e **)
        claim Hchain6 : apply_fun multG (hh, apply_fun multG (ia, a))
          = apply_fun multG (hh, eG).
        { rewrite Hia_a_eG. exact (fun P h => h). }
        (** Final **)
        rewrite Hchain1. rewrite Hchain2. rewrite Hchain3. rewrite Hchain4.
        rewrite Hchain5. rewrite Hchain6. exact Hh_e. }
      rewrite <- Hsimplify. exact Hunconj.
  }
  (** Apply thm79_2 backward to get homeomorphism **)
  claim Hh_ex : exists h:set, homeomorphism E Te E Te h /\ apply_fun h e0 = e1 /\
    (forall x:set, x :e E -> apply_fun p x = apply_fun p (apply_fun h x)).
  { exact (iffER
      (exists h:set, homeomorphism E Te E Te h /\ apply_fun h e0 = e1 /\
        (forall x:set, x :e E -> apply_fun p x = apply_fun p (apply_fun h x)))
      (H0 = H1)
      (thm79_2_equivalence_iff_same_subgroup E Te E Te B Tb p p e0 e1
        Hcov Hcov He0E He1E Hpe0pe1 HpcE HlpE HpcE HlpE)
      HH0eqH1). }
  apply Hh_ex. let h. assume HhPack.
  (** Extract components **)
  claim Hh_left : homeomorphism E Te E Te h /\ apply_fun h e0 = e1.
  { exact (andEL (homeomorphism E Te E Te h /\ apply_fun h e0 = e1)
      (forall x:set, x :e E -> apply_fun p x = apply_fun p (apply_fun h x))
      HhPack). }
  claim Hh_homeo : homeomorphism E Te E Te h.
  { exact (andEL (homeomorphism E Te E Te h) (apply_fun h e0 = e1) Hh_left). }
  claim Hh_e0 : apply_fun h e0 = e1.
  { exact (andER (homeomorphism E Te E Te h) (apply_fun h e0 = e1) Hh_left). }
  claim Hh_p : forall x:set, x :e E -> apply_fun p x = apply_fun p (apply_fun h x).
  { exact (andER (homeomorphism E Te E Te h /\ apply_fun h e0 = e1)
      (forall x:set, x :e E -> apply_fun p x = apply_fun p (apply_fun h x))
      HhPack). }
  (** Build covering_transformation **)
  witness h. apply andI.
  + prove homeomorphism E Te E Te h /\
      (forall x:set, x :e E -> apply_fun p (apply_fun h x) = apply_fun p x).
    apply andI.
    * exact Hh_homeo.
    * let x. assume HxE.
      exact (eq_symm (apply_fun p x) (apply_fun p (apply_fun h x)) (Hh_p x HxE)).
  + exact Hh_e0.
Qed.

(** Helper: instantiate a forall-set with two preconditions at a specific set value **)
(** Proven Alice **)
Theorem set_forall_imp2_instantiate : forall x:set,
  forall A:set -> prop, forall B:set -> prop, forall C:set -> prop,
  (forall y:set, A y -> B y -> C y) -> A x -> B x -> C x.
let x A B C. assume H Ha Hb. apply (H x). exact Ha. exact Hb.
Qed.

(** Helper: forward direction of lemma81_1 with clean argument structure **)
(** Proven Alice **)
Theorem lemma81_1_forward : forall E Te B Tb p e0 e1:set,
  covering_map E Te B Tb p -> e0 :e E ->
  path_connected_space E Te -> locally_path_connected E Te ->
  e1 :e E -> apply_fun p e1 = apply_fun p e0 ->
  (exists h:set, covering_transformation E Te B Tb p h /\ apply_fun h e0 = e1) ->
  forall alpha:set,
    loop_at B Tb (apply_fun p e0) alpha ->
    apply_fun (path_lift E Te B Tb p e0 alpha) 1 = e1 ->
    path_homotopy_class_loop B Tb (apply_fun p e0) alpha :e
      normalizer
        (homomorphism_image
          (fundamental_group E Te e0)
          (induced_homomorphism E Te e0 B Tb (apply_fun p e0) p))
        (fundamental_group B Tb (apply_fun p e0))
        (fundamental_group_mult B Tb (apply_fun p e0))
        (fundamental_group_id B Tb (apply_fun p e0))
        (fundamental_group_inv B Tb (apply_fun p e0)).
let E Te B Tb p e0 e1.
assume Hcov He0E HpcE HlpE He1E Hpe1 Hexists.
let alpha. assume HalphaLoop HliftEnd.
(** iff has lower precedence than -> so lemma81_1 with 11 args gives:
    iff (e1 :e E -> pe1=pe0 -> exists h, ...) (forall alpha0, ...)
    The left side includes the membership/equality conditions. **)
claim Hleft : e1 :e E -> apply_fun p e1 = apply_fun p e0 ->
  exists h:set, covering_transformation E Te B Tb p h /\ apply_fun h e0 = e1.
{ assume He1E2 Hpe12. exact Hexists. }
exact (iffEL
  (e1 :e E -> apply_fun p e1 = apply_fun p e0 ->
    exists h:set, covering_transformation E Te B Tb p h /\ apply_fun h e0 = e1)
  (forall alpha0:set,
    loop_at B Tb (apply_fun p e0) alpha0 ->
    apply_fun (path_lift E Te B Tb p e0 alpha0) 1 = e1 ->
    path_homotopy_class_loop B Tb (apply_fun p e0) alpha0 :e
      normalizer
        (homomorphism_image
          (fundamental_group E Te e0)
          (induced_homomorphism E Te e0 B Tb (apply_fun p e0) p))
        (fundamental_group B Tb (apply_fun p e0))
        (fundamental_group_mult B Tb (apply_fun p e0))
        (fundamental_group_id B Tb (apply_fun p e0))
        (fundamental_group_inv B Tb (apply_fun p e0)))
  (lemma81_1_image_of_psi E Te B Tb p e0 Hcov He0E HpcE HlpE e1)
  Hleft alpha HalphaLoop HliftEnd).
Qed.

(** Infrastructure: bridge from continuous_map to total_function_space **)
(** This captures the semantic fact that a continuous map between topological **)
(** spaces is a well-behaved set of ordered pairs in the total function space. **)
(** NOTE: the statement below is currently admitted; use the graphified lemma **)
(** here as a provable substitute when needed. **)
(** Infrastructure: graphify_on of a continuous map lies in total_function_space **)
(** Proven Bob **)
Lemma continuous_map_graphify_in_total_function_space : forall X Tx Y Ty f:set,
  continuous_map X Tx Y Ty f ->
  graphify_on X f :e total_function_space X Y.
let X Tx Y Ty f.
assume Hcont.
claim Hfun : function_on f X Y.
{ exact (continuous_map_function_on X Tx Y Ty f Hcont). }
exact (graph_in_total_function_space
  X
  Y
  (fun x:set => apply_fun f x)
  (fun x Hx => Hfun x Hx)).
Qed.

(** Admin-approved-refactored per noticeboard proposal 1773037094 **)
(** Proven Alice **)
Theorem continuous_map_in_total_function_space : forall X Tx Y Ty f:set,
  continuous_map X Tx Y Ty f -> graphify_on X f :e total_function_space X Y.
let X Tx Y Ty f.
assume Hcont : continuous_map X Tx Y Ty f.
claim Hfun : function_on f X Y.
{ exact (continuous_map_function_on X Tx Y Ty f Hcont). }
set gf := graphify_on X f.
claim Hgf_sub : gf c= setprod X Y.
{ exact (graph_subset_setprod X Y (fun x:set => apply_fun f x) Hfun). }
claim Hgf_total : total_function_on gf X Y.
{ prove function_on gf X Y /\ (forall x:set, x :e X -> exists y:set, y :e Y /\ (x, y) :e gf).
  apply andI.
  - let x. assume Hx : x :e X.
    claim Heq : apply_fun gf x = apply_fun f x.
    { exact (graphify_on_apply X f x Hx). }
    rewrite Heq. exact (Hfun x Hx).
  - let x. assume Hx : x :e X.
    witness (apply_fun f x). apply andI.
    + exact (Hfun x Hx).
    + exact (ReplI X (fun x0:set => (x0, apply_fun f x0)) x Hx). }
claim Hgf_func : functional_graph gf.
{ let x y1 y2.
  assume Hxy1 : (x, y1) :e gf.
  assume Hxy2 : (x, y2) :e gf.
  apply (ReplE_impred X (fun x0:set => (x0, apply_fun f x0)) (x, y1) Hxy1).
  let a1. assume Ha1X : a1 :e X. assume Ha1eq : (x, y1) = (a1, apply_fun f a1).
  apply (ReplE_impred X (fun x0:set => (x0, apply_fun f x0)) (x, y2) Hxy2).
  let a2. assume Ha2X : a2 :e X. assume Ha2eq : (x, y2) = (a2, apply_fun f a2).
  claim Hy1eq : y1 = apply_fun f a1.
  { exact (pair_eq_snd x y1 a1 (apply_fun f a1) Ha1eq). }
  claim Hy2eq : y2 = apply_fun f a2.
  { exact (pair_eq_snd x y2 a2 (apply_fun f a2) Ha2eq). }
  claim Ha1x : x = a1. { exact (pair_eq_fst x y1 a1 (apply_fun f a1) Ha1eq). }
  claim Ha2x : x = a2. { exact (pair_eq_fst x y2 a2 (apply_fun f a2) Ha2eq). }
  claim Ha1a2 : a1 = a2. { exact (eq_i_tra a1 x a2 (eq_symm x a1 Ha1x) Ha2x). }
  rewrite Hy1eq. rewrite Hy2eq. rewrite Ha1a2. reflexivity. }
exact (SepI (Power (setprod X Y))
  (fun g:set => total_function_on g X Y /\ functional_graph g)
  gf
  (PowerI (setprod X Y) gf Hgf_sub)
  (andI (total_function_on gf X Y) (functional_graph gf)
    Hgf_total Hgf_func)).
Qed.

(** Helper: graphify of continuous map is in function_space **)
(** Proven Alice **)
Lemma continuous_map_graphify_in_function_space : forall X Tx Y Ty f:set,
  continuous_map X Tx Y Ty f ->
  graphify_on X f :e function_space X Y.
let X Tx Y Ty f. assume Hcont.
exact (total_function_space_sub_function_space X Y (graphify_on X f)
  (continuous_map_graphify_in_total_function_space X Tx Y Ty f Hcont)).
Qed.

(** Helper: graphify of a loop is in loop_space **)
(** Proven Alice **)
Lemma loop_at_graphify_in_loop_space : forall X Tx x0 f:set,
  loop_at X Tx x0 f ->
  graphify_on unit_interval f :e loop_space X Tx x0.
let X Tx x0 f. assume Hla.
set gf := graphify_on unit_interval f.
claim Hcont : continuous_map unit_interval unit_interval_topology X Tx f.
{ exact (loop_at_continuous X Tx x0 f Hla). }
claim Hgf_fs : gf :e function_space unit_interval X.
{ exact (continuous_map_graphify_in_function_space unit_interval unit_interval_topology X Tx f Hcont). }
claim Hgf_la : loop_at X Tx x0 gf.
{ prove (continuous_map unit_interval unit_interval_topology X Tx gf /\
    apply_fun gf 0 = x0) /\ apply_fun gf 1 = x0.
  apply andI. apply andI.
  - claim Hagree : forall t:set, t :e unit_interval -> apply_fun f t = apply_fun gf t.
    { let t. assume Ht. symmetry. exact (graphify_on_apply unit_interval f t Ht). }
    claim Hgf_fn : function_on gf unit_interval X.
    { let t. assume Ht. rewrite (graphify_on_apply unit_interval f t Ht).
      exact (continuous_map_function_on unit_interval unit_interval_topology X Tx f Hcont t Ht). }
    exact (continuous_map_congr_on unit_interval unit_interval_topology X Tx f gf Hcont
      Hgf_fn Hagree).
  - rewrite (graphify_on_apply unit_interval f 0 zero_in_unit_interval).
    exact (loop_at_at_zero X Tx x0 f Hla).
  - rewrite (graphify_on_apply unit_interval f 1 one_in_unit_interval).
    exact (loop_at_at_one X Tx x0 f Hla). }
exact (SepI (function_space unit_interval X)
  (fun g:set => loop_at X Tx x0 g) gf Hgf_fs Hgf_la).
Qed.

(** Helper: graphify preserves loop_at **)
(** Proven Alice **)
Lemma graphify_on_preserves_loop_at : forall X Tx x0 f:set,
  loop_at X Tx x0 f -> loop_at X Tx x0 (graphify_on unit_interval f).
let X Tx x0 f. assume Hla.
exact (loop_space_has_loop_at X Tx x0 (graphify_on unit_interval f)
  (loop_at_graphify_in_loop_space X Tx x0 f Hla)).
Qed.

(** Helper: graphify version is path-homotopic to original **)
(** Proven Alice **)
Lemma path_homotopic_to_graphify : forall X Tx x0 x1 f:set,
  continuous_map unit_interval unit_interval_topology X Tx f ->
  apply_fun f 0 = x0 -> apply_fun f 1 = x1 ->
  path_homotopic X Tx x0 x1 f (graphify_on unit_interval f).
let X Tx x0 x1 f. assume Hcont Hf0 Hf1.
set gf := graphify_on unit_interval f.
claim Hgf_fn : function_on gf unit_interval X.
{ let t. assume Ht. rewrite (graphify_on_apply unit_interval f t Ht).
  exact (continuous_map_function_on unit_interval unit_interval_topology X Tx f Hcont t Ht). }
claim Hagree : forall t:set, t :e unit_interval -> apply_fun f t = apply_fun gf t.
{ let t. assume Ht. symmetry. exact (graphify_on_apply unit_interval f t Ht). }
claim Hgf_cont : continuous_map unit_interval unit_interval_topology X Tx gf.
{ exact (continuous_map_congr_on unit_interval unit_interval_topology X Tx f gf Hcont Hgf_fn Hagree). }
claim Hgf0 : apply_fun gf 0 = x0.
{ rewrite (graphify_on_apply unit_interval f 0 zero_in_unit_interval). exact Hf0. }
claim Hgf1 : apply_fun gf 1 = x1.
{ rewrite (graphify_on_apply unit_interval f 1 one_in_unit_interval). exact Hf1. }
exact (path_homotopic_of_pointwise_equal X Tx x0 x1 f gf Hcont Hgf_cont Hf0 Hf1 Hgf0 Hgf1 Hagree).
Qed.

(** Helper: graphify preserves homotopy class of loop **)
(** Proven Alice **)
Lemma path_homotopy_class_loop_graphify_eq : forall X Tx x0 f:set,
  continuous_map unit_interval unit_interval_topology X Tx f ->
  apply_fun f 0 = x0 -> apply_fun f 1 = x0 ->
  path_homotopy_class_loop X Tx x0 f = path_homotopy_class_loop X Tx x0 (graphify_on unit_interval f).
let X Tx x0 f. assume Hcont Hf0 Hf1.
exact (path_homotopy_class_loop_eq_of_path_homotopic X Tx x0 f (graphify_on unit_interval f)
  (path_homotopic_to_graphify X Tx x0 x0 f Hcont Hf0 Hf1)).
Qed.

(** Helper: graphify of continuous map is continuous **)
(** Proven Alice **)
Lemma graphify_on_continuous : forall X Tx Y Ty f:set,
  continuous_map X Tx Y Ty f ->
  continuous_map X Tx Y Ty (graphify_on X f).
let X Tx Y Ty f. assume Hcont.
claim Hfn : function_on (graphify_on X f) X Y.
{ let x. assume Hx. rewrite (graphify_on_apply X f x Hx).
  exact (continuous_map_function_on X Tx Y Ty f Hcont x Hx). }
claim Hagree : forall x:set, x :e X -> apply_fun f x = apply_fun (graphify_on X f) x.
{ let x. assume Hx. symmetry. exact (graphify_on_apply X f x Hx). }
exact (continuous_map_congr_on X Tx Y Ty f (graphify_on X f) Hcont Hfn Hagree).
Qed.

(** Helper: CTG inverse closure using graphify workaround **)
(** The inverse of h :e CTG gives graphify(h_inv) :e CTG with left-inverse property **)
Lemma ctg_inverse_closure : forall E Te B Tb p h:set,
  covering_map E Te B Tb p ->
  h :e covering_transformation_group E Te B Tb p ->
  exists hinv:set, hinv :e covering_transformation_group E Te B Tb p /\
    forall x:set, x :e E -> apply_fun hinv (apply_fun h x) = x.
let E Te B Tb p h. assume Hcov HhG.
claim Hct : covering_transformation E Te B Tb p h.
{ exact (SepE2 (function_space E E) (fun g:set => covering_transformation E Te B Tb p g) h HhG). }
claim Hhomeo : homeomorphism E Te E Te h.
{ exact (andEL (homeomorphism E Te E Te h)
    (forall x:set, x :e E -> apply_fun p (apply_fun h x) = apply_fun p x) Hct). }
claim Hcomm : forall x:set, x :e E -> apply_fun p (apply_fun h x) = apply_fun p x.
{ exact (andER (homeomorphism E Te E Te h)
    (forall x:set, x :e E -> apply_fun p (apply_fun h x) = apply_fun p x) Hct). }
apply (homeomorphism_inverse_package E Te E Te h Hhomeo).
let g. assume Hgpack.
set g_cont_type := continuous_map E Te E Te g.
set g_left_type := forall x:set, x :e E -> apply_fun g (apply_fun h x) = x.
set g_right_type := forall x:set, x :e E -> apply_fun h (apply_fun g x) = x.
claim Hg_right : g_right_type.
{ exact (andER (g_cont_type /\ g_left_type) g_right_type Hgpack). }
claim Hg_left2 : g_cont_type /\ g_left_type.
{ exact (andEL (g_cont_type /\ g_left_type) g_right_type Hgpack). }
claim Hg_cont : g_cont_type.
{ exact (andEL g_cont_type g_left_type Hg_left2). }
claim Hg_left : g_left_type.
{ exact (andER g_cont_type g_left_type Hg_left2). }
set ginv := graphify_on E g.
claim Hginv_cont : continuous_map E Te E Te ginv.
{ exact (graphify_on_continuous E Te E Te g Hg_cont). }
claim Hginv_left : forall x:set, x :e E -> apply_fun ginv (apply_fun h x) = x.
{ let x. assume Hx.
  rewrite (graphify_on_apply E g (apply_fun h x) (homeomorphism_function_on E Te E Te h Hhomeo x Hx)).
  exact (Hg_left x Hx). }
claim Hginv_fs : ginv :e function_space E E.
{ exact (continuous_map_graphify_in_function_space E Te E Te g Hg_cont). }
claim Hginv_right : forall x:set, x :e E -> apply_fun h (apply_fun ginv x) = x.
{ let x. assume Hx.
  rewrite (graphify_on_apply E g x Hx). exact (Hg_right x Hx). }
claim Hh_cont : continuous_map E Te E Te h.
{ exact (homeomorphism_continuous E Te E Te h Hhomeo). }
claim Hginv_homeo : homeomorphism E Te E Te ginv.
{ prove continuous_map E Te E Te ginv /\
    exists g':set, continuous_map E Te E Te g' /\
      (forall x:set, x :e E -> apply_fun g' (apply_fun ginv x) = x) /\
      (forall y:set, y :e E -> apply_fun ginv (apply_fun g' y) = y).
  apply andI.
  - exact Hginv_cont.
  - witness h. apply and3I. exact Hh_cont. exact Hginv_right.
    let y. assume Hy.
    rewrite (graphify_on_apply E g (apply_fun h y) (homeomorphism_function_on E Te E Te h Hhomeo y Hy)).
    exact (Hg_left y Hy). }
claim Hginv_comm : forall x:set, x :e E -> apply_fun p (apply_fun ginv x) = apply_fun p x.
{ exact (homeomorphism_inverse_commutes_with_p E Te B Tb p h ginv Hcov Hhomeo Hcomm Hginv_cont Hginv_right). }
claim Hginv_ct : covering_transformation E Te B Tb p ginv.
{ prove homeomorphism E Te E Te ginv /\
    (forall x:set, x :e E -> apply_fun p (apply_fun ginv x) = apply_fun p x).
  apply andI. exact Hginv_homeo. exact Hginv_comm. }
claim Hginv_in_G : ginv :e covering_transformation_group E Te B Tb p.
{ exact (SepI (function_space E E) (fun k:set => covering_transformation E Te B Tb p k) ginv Hginv_fs Hginv_ct). }
witness ginv. apply andI. exact Hginv_in_G. exact Hginv_left.
Qed.

(** Helper: CTG inverse with both left and right inverse properties **)
(** Proven Alice **)
Lemma ctg_inverse_closure_full : forall E Te B Tb p h:set,
  covering_map E Te B Tb p ->
  h :e covering_transformation_group E Te B Tb p ->
  exists hinv:set, hinv :e covering_transformation_group E Te B Tb p /\
    (forall x:set, x :e E -> apply_fun hinv (apply_fun h x) = x) /\
    (forall x:set, x :e E -> apply_fun h (apply_fun hinv x) = x).
let E Te B Tb p h. assume Hcov HhG.
apply (ctg_inverse_closure E Te B Tb p h Hcov HhG).
let hinv. assume Hpack.
claim Hinv_G : hinv :e covering_transformation_group E Te B Tb p.
{ exact (andEL (hinv :e covering_transformation_group E Te B Tb p)
    (forall x:set, x :e E -> apply_fun hinv (apply_fun h x) = x) Hpack). }
claim Hinv_left : forall x:set, x :e E -> apply_fun hinv (apply_fun h x) = x.
{ exact (andER (hinv :e covering_transformation_group E Te B Tb p)
    (forall x:set, x :e E -> apply_fun hinv (apply_fun h x) = x) Hpack). }
(** For the right inverse: hinv is a CT (hence homeomorphism), apply ctg_inverse_closure to hinv **)
apply (ctg_inverse_closure E Te B Tb p hinv Hcov Hinv_G).
let hinv2. assume Hpack2.
claim Hinv2_left : forall x:set, x :e E -> apply_fun hinv2 (apply_fun hinv x) = x.
{ exact (andER (hinv2 :e covering_transformation_group E Te B Tb p)
    (forall x:set, x :e E -> apply_fun hinv2 (apply_fun hinv x) = x) Hpack2). }
claim Hh_fn : function_on h E E.
{ exact (covering_transformation_group_function_on E Te B Tb p h HhG). }
claim Hinv_fn : function_on hinv E E.
{ exact (covering_transformation_group_function_on E Te B Tb p hinv Hinv_G). }
claim Hright : forall x:set, x :e E -> apply_fun h (apply_fun hinv x) = x.
{ let x. assume HxE.
  claim HhinvxE : apply_fun hinv x :e E. { exact (Hinv_fn x HxE). }
  (** h(hinv(x)) = hinv2(hinv(h(hinv(x)))) = hinv2(hinv(x)) ... no **)
  (** Simpler: hinv(h(hinv(x))) = hinv(x) (from left inverse) **)
  (** Apply hinv2 to both sides: hinv2(hinv(h(hinv(x)))) = hinv2(hinv(x)) **)
  (** LHS = h(hinv(x)) (by hinv2 left-inverse of hinv) **)
  (** RHS = x (by hinv2 left-inverse of hinv) **)
  prove apply_fun h (apply_fun hinv x) = x.
  rewrite <- (Hinv2_left (apply_fun h (apply_fun hinv x)) (Hh_fn (apply_fun hinv x) HhinvxE)).
  rewrite (Hinv_left (apply_fun hinv x) HhinvxE).
  exact (Hinv2_left x HxE). }
witness hinv. apply and3I. exact Hinv_G. exact Hinv_left. exact Hright.
Qed.
Theorem continuous_map_in_total_function_space_plain : forall X Tx Y Ty f:set,
  continuous_map X Tx Y Ty f -> f :e total_function_space X Y.
let X Tx Y Ty f.
assume Hcont.
admit.
Admitted.

(** Bridge: CTG members that agree pointwise are set-equal **)
(** Uses compose_fun bridge to total_function_space; final graphify step admitted **)
Theorem ctg_pointwise_eq_implies_set_eq_early :
  forall E Te B Tb p h1 h2:set,
  covering_map E Te B Tb p ->
  h1 :e covering_transformation_group E Te B Tb p ->
  h2 :e covering_transformation_group E Te B Tb p ->
  (forall x:set, x :e E -> apply_fun h1 x = apply_fun h2 x) ->
  h1 = h2.
let E Te B Tb p h1 h2.
assume Hcov Hh1G Hh2G Hpw.
admit.
Admitted.

(** Infrastructure: covering transformation transport property **)
(** If h is a covering transformation and gamma lifts f from e0, **)
(** then h compose gamma lifts f from h(e0), so by uniqueness **)
(** path_lift(h(e0), f)(t) = h(path_lift(e0, f)(t)) for all t. **)
(** Proven Alice **)
Theorem covering_transformation_path_lift_transport :
  forall E Te B Tb p e0 f h:set,
  covering_map E Te B Tb p -> e0 :e E ->
  continuous_map unit_interval unit_interval_topology B Tb f ->
  covering_transformation E Te B Tb p h ->
  apply_fun p e0 = apply_fun f 0 ->
  forall t:set, t :e unit_interval ->
    apply_fun (path_lift E Te B Tb p (apply_fun h e0) f) t =
    apply_fun h (apply_fun (path_lift E Te B Tb p e0 f) t).
let E Te B Tb p e0 f h.
assume Hcov He0E Hf_cont Hct Hpe0.
(** Extract covering transformation properties **)
claim Hhomeo : homeomorphism E Te E Te h.
{ exact (andEL (homeomorphism E Te E Te h) (forall x:set, x :e E -> apply_fun p (apply_fun h x) = apply_fun p x) Hct). }
claim Hpcomm : forall x:set, x :e E -> apply_fun p (apply_fun h x) = apply_fun p x.
{ exact (andER (homeomorphism E Te E Te h) (forall x:set, x :e E -> apply_fun p (apply_fun h x) = apply_fun p x) Hct). }
claim Hh_cont : continuous_map E Te E Te h.
{ exact (homeomorphism_continuous E Te E Te h Hhomeo). }
claim Hh_fun : function_on h E E.
{ exact (continuous_map_function_on E Te E Te h Hh_cont). }
(** Topology infrastructure **)
claim HtopE : topology_on E Te. { exact (covering_map_topology_on_domain E Te B Tb p Hcov). }
claim HtopB : topology_on B Tb. { exact (covering_map_topology_on_codomain E Te B Tb p Hcov). }
claim Hp_cont : continuous_map E Te B Tb p. { exact (covering_map_continuous E Te B Tb p Hcov). }
(** Lift of f from e0 **)
claim Hlift_data :
  (continuous_map unit_interval unit_interval_topology E Te (path_lift E Te B Tb p e0 f) /\
   apply_fun (path_lift E Te B Tb p e0 f) 0 = e0) /\
  (forall t:set, t :e unit_interval ->
    apply_fun p (apply_fun (path_lift E Te B Tb p e0 f) t) = apply_fun f t).
{ exact (lemma54_1_path_lifting E Te B Tb p e0 f Hcov He0E Hpe0 Hf_cont). }
claim Hgamma_cont : continuous_map unit_interval unit_interval_topology E Te (path_lift E Te B Tb p e0 f).
{ exact (andEL (continuous_map unit_interval unit_interval_topology E Te (path_lift E Te B Tb p e0 f))
    (apply_fun (path_lift E Te B Tb p e0 f) 0 = e0)
    (andEL
      (continuous_map unit_interval unit_interval_topology E Te (path_lift E Te B Tb p e0 f) /\
       apply_fun (path_lift E Te B Tb p e0 f) 0 = e0)
      (forall t:set, t :e unit_interval ->
        apply_fun p (apply_fun (path_lift E Te B Tb p e0 f) t) = apply_fun f t)
      Hlift_data)). }
claim Hgamma_start : apply_fun (path_lift E Te B Tb p e0 f) 0 = e0.
{ exact (andER (continuous_map unit_interval unit_interval_topology E Te (path_lift E Te B Tb p e0 f))
    (apply_fun (path_lift E Te B Tb p e0 f) 0 = e0)
    (andEL
      (continuous_map unit_interval unit_interval_topology E Te (path_lift E Te B Tb p e0 f) /\
       apply_fun (path_lift E Te B Tb p e0 f) 0 = e0)
      (forall t:set, t :e unit_interval ->
        apply_fun p (apply_fun (path_lift E Te B Tb p e0 f) t) = apply_fun f t)
      Hlift_data)). }
claim Hgamma_covers : forall t:set, t :e unit_interval ->
  apply_fun p (apply_fun (path_lift E Te B Tb p e0 f) t) = apply_fun f t.
{ exact (andER
    (continuous_map unit_interval unit_interval_topology E Te (path_lift E Te B Tb p e0 f) /\
     apply_fun (path_lift E Te B Tb p e0 f) 0 = e0)
    (forall t:set, t :e unit_interval ->
      apply_fun p (apply_fun (path_lift E Te B Tb p e0 f) t) = apply_fun f t)
    Hlift_data). }
(** h(e0) is in E **)
claim Hhe0E : apply_fun h e0 :e E.
{ exact (Hh_fun e0 He0E). }
(** Build h compose gamma as a function **)
set hgamma := compose_fun unit_interval (path_lift E Te B Tb p e0 f) h.
(** hgamma is continuous: composition of continuous maps **)
claim Hhgamma_cont : continuous_map unit_interval unit_interval_topology E Te hgamma.
{ exact (composition_continuous unit_interval unit_interval_topology E Te E Te
    (path_lift E Te B Tb p e0 f) h Hgamma_cont Hh_cont). }
(** hgamma covers f: p(hgamma(t)) = p(h(gamma(t))) = p(gamma(t)) = f(t) **)
claim Hhgamma_covers : forall t:set, t :e unit_interval ->
  apply_fun p (apply_fun hgamma t) = apply_fun f t.
{ let t. assume HtI.
  claim Hcfa : apply_fun hgamma t = apply_fun h (apply_fun (path_lift E Te B Tb p e0 f) t).
  { exact (compose_fun_apply unit_interval (path_lift E Te B Tb p e0 f) h t HtI). }
  claim Hgt_in_E : apply_fun (path_lift E Te B Tb p e0 f) t :e E.
  { exact (continuous_map_function_on unit_interval unit_interval_topology E Te
      (path_lift E Te B Tb p e0 f) Hgamma_cont t HtI). }
  rewrite Hcfa.
  rewrite (Hpcomm (apply_fun (path_lift E Te B Tb p e0 f) t) Hgt_in_E).
  exact (Hgamma_covers t HtI). }
(** hgamma is a lifting_of f **)
claim Hhgamma_lift : lifting_of unit_interval unit_interval_topology E Te B Tb p f hgamma.
{ prove continuous_map unit_interval unit_interval_topology E Te hgamma /\
    (forall x:set, x :e unit_interval -> apply_fun p (apply_fun hgamma x) = apply_fun f x).
  exact (andI
    (continuous_map unit_interval unit_interval_topology E Te hgamma)
    (forall x:set, x :e unit_interval -> apply_fun p (apply_fun hgamma x) = apply_fun f x)
    Hhgamma_cont Hhgamma_covers). }
(** hgamma(0) = h(e0) **)
claim Hhgamma_start : apply_fun hgamma 0 = apply_fun h e0.
{ claim Hcfa0 : apply_fun hgamma 0 = apply_fun h (apply_fun (path_lift E Te B Tb p e0 f) 0).
  { exact (compose_fun_apply unit_interval (path_lift E Te B Tb p e0 f) h 0 zero_in_unit_interval). }
  rewrite Hcfa0. rewrite Hgamma_start. reflexivity. }
(** p(h(e0)) = f(0) **)
claim Hphe0 : apply_fun p (apply_fun h e0) = apply_fun f 0.
{ rewrite (Hpcomm e0 He0E). exact Hpe0. }
(** path_lift from h(e0) is also a lifting of f **)
claim Hlift2_data :
  (continuous_map unit_interval unit_interval_topology E Te (path_lift E Te B Tb p (apply_fun h e0) f) /\
   apply_fun (path_lift E Te B Tb p (apply_fun h e0) f) 0 = apply_fun h e0) /\
  (forall t:set, t :e unit_interval ->
    apply_fun p (apply_fun (path_lift E Te B Tb p (apply_fun h e0) f) t) = apply_fun f t).
{ exact (lemma54_1_path_lifting E Te B Tb p (apply_fun h e0) f Hcov Hhe0E Hphe0 Hf_cont). }
claim Hlift2_cont : continuous_map unit_interval unit_interval_topology E Te (path_lift E Te B Tb p (apply_fun h e0) f).
{ exact (andEL (continuous_map unit_interval unit_interval_topology E Te (path_lift E Te B Tb p (apply_fun h e0) f))
    (apply_fun (path_lift E Te B Tb p (apply_fun h e0) f) 0 = apply_fun h e0)
    (andEL
      (continuous_map unit_interval unit_interval_topology E Te (path_lift E Te B Tb p (apply_fun h e0) f) /\
       apply_fun (path_lift E Te B Tb p (apply_fun h e0) f) 0 = apply_fun h e0)
      (forall t:set, t :e unit_interval ->
        apply_fun p (apply_fun (path_lift E Te B Tb p (apply_fun h e0) f) t) = apply_fun f t)
      Hlift2_data)). }
claim Hlift2_start : apply_fun (path_lift E Te B Tb p (apply_fun h e0) f) 0 = apply_fun h e0.
{ exact (andER (continuous_map unit_interval unit_interval_topology E Te (path_lift E Te B Tb p (apply_fun h e0) f))
    (apply_fun (path_lift E Te B Tb p (apply_fun h e0) f) 0 = apply_fun h e0)
    (andEL
      (continuous_map unit_interval unit_interval_topology E Te (path_lift E Te B Tb p (apply_fun h e0) f) /\
       apply_fun (path_lift E Te B Tb p (apply_fun h e0) f) 0 = apply_fun h e0)
      (forall t:set, t :e unit_interval ->
        apply_fun p (apply_fun (path_lift E Te B Tb p (apply_fun h e0) f) t) = apply_fun f t)
      Hlift2_data)). }
claim Hlift2_covers : forall t:set, t :e unit_interval ->
  apply_fun p (apply_fun (path_lift E Te B Tb p (apply_fun h e0) f) t) = apply_fun f t.
{ exact (andER
    (continuous_map unit_interval unit_interval_topology E Te (path_lift E Te B Tb p (apply_fun h e0) f) /\
     apply_fun (path_lift E Te B Tb p (apply_fun h e0) f) 0 = apply_fun h e0)
    (forall t:set, t :e unit_interval ->
      apply_fun p (apply_fun (path_lift E Te B Tb p (apply_fun h e0) f) t) = apply_fun f t)
    Hlift2_data). }
claim Hlift2_liftof : lifting_of unit_interval unit_interval_topology E Te B Tb p f (path_lift E Te B Tb p (apply_fun h e0) f).
{ prove continuous_map unit_interval unit_interval_topology E Te (path_lift E Te B Tb p (apply_fun h e0) f) /\
    (forall x:set, x :e unit_interval -> apply_fun p (apply_fun (path_lift E Te B Tb p (apply_fun h e0) f) x) = apply_fun f x).
  exact (andI
    (continuous_map unit_interval unit_interval_topology E Te (path_lift E Te B Tb p (apply_fun h e0) f))
    (forall x:set, x :e unit_interval -> apply_fun p (apply_fun (path_lift E Te B Tb p (apply_fun h e0) f) x) = apply_fun f x)
    Hlift2_cont Hlift2_covers). }
(** Apply uniqueness: both lift f from h(e0), so they agree **)
(** uniqueness gives hgamma(t) = path_lift(h(e0),f)(t), then use compose_fun_apply **)
let t. assume HtI.
claim Huniq : apply_fun (path_lift E Te B Tb p (apply_fun h e0) f) t = apply_fun hgamma t.
{ exact (eq_symm
    (apply_fun hgamma t)
    (apply_fun (path_lift E Te B Tb p (apply_fun h e0) f) t)
    (lemma54_1_path_lifting_unique E Te B Tb p (apply_fun h e0) f
      hgamma (path_lift E Te B Tb p (apply_fun h e0) f)
      Hcov Hhe0E Hf_cont Hhgamma_lift Hhgamma_start Hlift2_liftof Hlift2_start t HtI)). }
claim Hcfa : apply_fun hgamma t = apply_fun h (apply_fun (path_lift E Te B Tb p e0 f) t).
{ exact (compose_fun_apply unit_interval (path_lift E Te B Tb p e0 f) h t HtI). }
rewrite Huniq. exact Hcfa.
Qed.

(** from S81 Thm 81.2 (line 5055 in algtop.tex) **)
(** LATEX VERSION: The bijection Phi^{-1} o Psi : C(E,p,B) -> N(H0)/H0 **)
(** is an isomorphism of groups. **)
(** EFFORT: 15 lines textbook, difficulty 6/10, USD 200 **)
(** Bounty 242 **)
Theorem thm81_2_covering_trans_isomorphism :
  forall E Te B Tb p e0:set,
  covering_map E Te B Tb p -> e0 :e E ->
  path_connected_space E Te -> locally_path_connected E Te ->
  exists phi:set,
    group_isomorphism
      (covering_transformation_group E Te B Tb p)
      (covering_transformation_mult E Te B Tb p)
      (quotient_group_set
        (normalizer
          (homomorphism_image
            (fundamental_group E Te e0)
            (induced_homomorphism E Te e0 B Tb (apply_fun p e0) p))
          (fundamental_group B Tb (apply_fun p e0))
          (fundamental_group_mult B Tb (apply_fun p e0))
          (fundamental_group_id B Tb (apply_fun p e0))
          (fundamental_group_inv B Tb (apply_fun p e0)))
        (fundamental_group_mult B Tb (apply_fun p e0))
        (homomorphism_image
          (fundamental_group E Te e0)
          (induced_homomorphism E Te e0 B Tb (apply_fun p e0) p)))
      (quotient_group_mult
        (normalizer
          (homomorphism_image
            (fundamental_group E Te e0)
            (induced_homomorphism E Te e0 B Tb (apply_fun p e0) p))
          (fundamental_group B Tb (apply_fun p e0))
          (fundamental_group_mult B Tb (apply_fun p e0))
          (fundamental_group_id B Tb (apply_fun p e0))
          (fundamental_group_inv B Tb (apply_fun p e0)))
        (fundamental_group_mult B Tb (apply_fun p e0))
        (homomorphism_image
          (fundamental_group E Te e0)
          (induced_homomorphism E Te e0 B Tb (apply_fun p e0) p)))
      phi.
let E Te B Tb p e0.
assume Hcov He0E HpcE HlpE.
set b0 := apply_fun p e0.
set H0 := homomorphism_image (fundamental_group E Te e0) (induced_homomorphism E Te e0 B Tb b0 p).
set G := fundamental_group B Tb b0.
set multG := fundamental_group_mult B Tb b0.
set eG := fundamental_group_id B Tb b0.
set invG := fundamental_group_inv B Tb b0.
set N := normalizer H0 G multG eG invG.
set CTG := covering_transformation_group E Te B Tb p.
set multCTG := covering_transformation_mult E Te B Tb p.
set lc := lifting_correspondence E Te B Tb p e0.
set QGset := quotient_group_set N multG H0.
set QGmult := quotient_group_mult N multG H0.
(** Infrastructure **)
claim HtopE : topology_on E Te. { exact (covering_map_topology_on_domain E Te B Tb p Hcov). }
claim HtopB : topology_on B Tb. { exact (covering_map_topology_on_codomain E Te B Tb p Hcov). }
claim Hp_cont : continuous_map E Te B Tb p. { exact (covering_map_continuous E Te B Tb p Hcov). }
claim Hp_fun : function_on p E B. { exact (continuous_map_function_on E Te B Tb p Hp_cont). }
claim Hb0B : b0 :e B. { exact (Hp_fun e0 He0E). }
claim HgrpG : group_structure G multG eG invG.
{ exact (fundamental_group_is_group B Tb b0 HtopB Hb0B). }
(** pi_1(E,e0) is a group **)
claim HgrpE : group_structure (fundamental_group E Te e0) (fundamental_group_mult E Te e0) (fundamental_group_id E Te e0) (fundamental_group_inv E Te e0).
{ exact (fundamental_group_is_group E Te e0 HtopE He0E). }
(** p_star is a group homomorphism **)
claim Hpstar_hom : group_homomorphism (fundamental_group E Te e0) (fundamental_group_mult E Te e0) G multG (induced_homomorphism E Te e0 B Tb b0 p).
{ exact (induced_homomorphism_is_homomorphism E Te e0 B Tb b0 p Hp_cont (eq_refl b0) He0E). }
(** H0 is a subgroup of G **)
claim HH0sub : subgroup_of H0 G multG eG invG.
{ exact (homomorphism_image_subgroup_of (fundamental_group E Te e0) (fundamental_group_mult E Te e0) (fundamental_group_id E Te e0) (fundamental_group_inv E Te e0) G multG eG invG (induced_homomorphism E Te e0 B Tb b0 p) HgrpE HgrpG Hpstar_hom). }
(** Extract group axioms from HgrpG **)
(** group_structure is (((((fn_mult /\ fn_inv) /\ e_mem) /\ assoc) /\ id) /\ inv_ax) **)
apply (and6E
  (function_on multG (setprod G G) G)
  (function_on invG G G)
  (eG :e G)
  (forall a b c:set, a :e G -> b :e G -> c :e G ->
    apply_fun multG (apply_fun multG (a, b), c) = apply_fun multG (a, apply_fun multG (b, c)))
  (forall a:set, a :e G -> apply_fun multG (eG, a) = a /\ apply_fun multG (a, eG) = a)
  (forall a:set, a :e G ->
    apply_fun multG (a, apply_fun invG a) = eG /\ apply_fun multG (apply_fun invG a, a) = eG)
  HgrpG).
assume HmultFn HinvFn HeGmem HassocG HidG HinvAxG.
claim HmultG_cl : forall x y:set, x :e G -> y :e G -> apply_fun multG (x, y) :e G.
{ let x y. assume Hx Hy.
  exact (HmultFn (x, y) (tuple_2_setprod_by_pair_Sigma G G x y Hx Hy)). }
claim HinvG_cl : forall x:set, x :e G -> apply_fun invG x :e G.
{ let x. assume Hx. exact (HinvFn x Hx). }
(** H0 subset G and closure under mult/inv **)
(** subgroup_of is ((H0 c= G /\ eG :e H0) /\ mult_closed) /\ inv_closed **)
claim HH0_inv_cl : forall x:set, x :e H0 -> apply_fun invG x :e H0.
{ exact (andER
    ((H0 c= G /\ eG :e H0) /\ (forall x y:set, x :e H0 -> y :e H0 -> apply_fun multG (x, y) :e H0))
    (forall x:set, x :e H0 -> apply_fun invG x :e H0)
    HH0sub). }
claim HH0_mult_cl : forall x y:set, x :e H0 -> y :e H0 -> apply_fun multG (x, y) :e H0.
{ exact (andER
    (H0 c= G /\ eG :e H0)
    (forall x y:set, x :e H0 -> y :e H0 -> apply_fun multG (x, y) :e H0)
    (andEL
      ((H0 c= G /\ eG :e H0) /\ (forall x y:set, x :e H0 -> y :e H0 -> apply_fun multG (x, y) :e H0))
      (forall x:set, x :e H0 -> apply_fun invG x :e H0)
      HH0sub)). }
claim HH0subG : H0 c= G.
{ exact (andEL (H0 c= G) (eG :e H0)
    (andEL
      (H0 c= G /\ eG :e H0)
      (forall x y:set, x :e H0 -> y :e H0 -> apply_fun multG (x, y) :e H0)
      (andEL
        ((H0 c= G /\ eG :e H0) /\ (forall x y:set, x :e H0 -> y :e H0 -> apply_fun multG (x, y) :e H0))
        (forall x:set, x :e H0 -> apply_fun invG x :e H0)
        HH0sub))). }
claim HeG_H0 : eG :e H0.
{ exact (andER (H0 c= G) (eG :e H0)
    (andEL
      (H0 c= G /\ eG :e H0)
      (forall x y:set, x :e H0 -> y :e H0 -> apply_fun multG (x, y) :e H0)
      (andEL
        ((H0 c= G /\ eG :e H0) /\ (forall x y:set, x :e H0 -> y :e H0 -> apply_fun multG (x, y) :e H0))
        (forall x:set, x :e H0 -> apply_fun invG x :e H0)
        HH0sub))). }
(** N is a subgroup of G **)
claim HNsubG : N c= G.
{ let g. assume HgN. exact (SepE1 G (fun g:set => (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (g, h), apply_fun invG g) :e H0) /\ (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (apply_fun invG g, h), g) :e H0)) g HgN). }
claim HNsub : subgroup_of N G multG eG invG.
{ prove ((N c= G /\ eG :e N) /\ (forall x y:set, x :e N -> y :e N -> apply_fun multG (x, y) :e N)) /\ (forall x:set, x :e N -> apply_fun invG x :e N).
  apply andI.
  apply andI.
  apply andI.
  - (** N c= G **)
    exact HNsubG.
  - (** eG :e N **)
    (** inv(eG) = eG **)
    claim HeG_inv_is_eG : apply_fun invG eG = eG.
    { claim H1 : apply_fun multG (eG, apply_fun invG eG) = eG.
      { exact (andEL (apply_fun multG (eG, apply_fun invG eG) = eG) (apply_fun multG (apply_fun invG eG, eG) = eG) (HinvAxG eG HeGmem)). }
      claim H2 : apply_fun multG (eG, apply_fun invG eG) = apply_fun invG eG.
      { exact (andEL (apply_fun multG (eG, apply_fun invG eG) = apply_fun invG eG) (apply_fun multG (apply_fun invG eG, eG) = apply_fun invG eG) (HidG (apply_fun invG eG) (HinvG_cl eG HeGmem))). }
      rewrite <- H2. exact H1. }
    claim HeN_pred : (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (eG, h), apply_fun invG eG) :e H0) /\ (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (apply_fun invG eG, h), eG) :e H0).
    { apply andI.
      - let h. assume HhH0.
        claim HhG : h :e G. { exact (HH0subG h HhH0). }
        (** Goal: multG(multG(eG, h), invG(eG)) :e H0 **)
        (** Step 1: invG(eG) = eG **)
        rewrite HeG_inv_is_eG.
        (** Goal: multG(multG(eG, h), eG) :e H0 **)
        (** Step 2: multG(eG, h) = h **)
        rewrite (andEL (apply_fun multG (eG, h) = h) (apply_fun multG (h, eG) = h) (HidG h HhG)).
        (** Goal: multG(h, eG) :e H0 **)
        (** Step 3: multG(h, eG) = h **)
        rewrite (andER (apply_fun multG (eG, h) = h) (apply_fun multG (h, eG) = h) (HidG h HhG)).
        exact HhH0.
      - let h. assume HhH0.
        claim HhG : h :e G. { exact (HH0subG h HhH0). }
        (** Goal: multG(multG(invG(eG), h), eG) :e H0 **)
        rewrite HeG_inv_is_eG.
        (** Goal: multG(multG(eG, h), eG) :e H0 **)
        rewrite (andEL (apply_fun multG (eG, h) = h) (apply_fun multG (h, eG) = h) (HidG h HhG)).
        rewrite (andER (apply_fun multG (eG, h) = h) (apply_fun multG (h, eG) = h) (HidG h HhG)).
        exact HhH0. }
    exact (SepI G (fun g:set => (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (g, h), apply_fun invG g) :e H0) /\ (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (apply_fun invG g, h), g) :e H0)) eG HeGmem HeN_pred).
  - (** N closed under mult **)
    let g1 g2. assume Hg1N Hg2N.
    claim Hg1G : g1 :e G. { exact (HNsubG g1 Hg1N). }
    claim Hg2G : g2 :e G. { exact (HNsubG g2 Hg2N). }
    claim Hg12G : apply_fun multG (g1, g2) :e G. { exact (HmultG_cl g1 g2 Hg1G Hg2G). }
    claim Hg1_norm : (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (g1, h), apply_fun invG g1) :e H0) /\ (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (apply_fun invG g1, h), g1) :e H0).
    { exact (SepE2 G (fun g:set => (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (g, h), apply_fun invG g) :e H0) /\ (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (apply_fun invG g, h), g) :e H0)) g1 Hg1N). }
    claim Hg2_norm : (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (g2, h), apply_fun invG g2) :e H0) /\ (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (apply_fun invG g2, h), g2) :e H0).
    { exact (SepE2 G (fun g:set => (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (g, h), apply_fun invG g) :e H0) /\ (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (apply_fun invG g, h), g) :e H0)) g2 Hg2N). }
    claim Hg1_conj : forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (g1, h), apply_fun invG g1) :e H0.
    { exact (andEL (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (g1, h), apply_fun invG g1) :e H0) (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (apply_fun invG g1, h), g1) :e H0) Hg1_norm). }
    claim Hg2_conj : forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (g2, h), apply_fun invG g2) :e H0.
    { exact (andEL (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (g2, h), apply_fun invG g2) :e H0) (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (apply_fun invG g2, h), g2) :e H0) Hg2_norm). }
    claim Hg1_conj2 : forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (apply_fun invG g1, h), g1) :e H0.
    { exact (andER (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (g1, h), apply_fun invG g1) :e H0) (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (apply_fun invG g1, h), g1) :e H0) Hg1_norm). }
    claim Hg2_conj2 : forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (apply_fun invG g2, h), g2) :e H0.
    { exact (andER (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (g2, h), apply_fun invG g2) :e H0) (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (apply_fun invG g2, h), g2) :e H0) Hg2_norm). }
    claim Hig1G : apply_fun invG g1 :e G. { exact (HinvG_cl g1 Hg1G). }
    claim Hig2G : apply_fun invG g2 :e G. { exact (HinvG_cl g2 Hg2G). }
    claim Hig12 : apply_fun invG (apply_fun multG (g1, g2)) = apply_fun multG (apply_fun invG g2, apply_fun invG g1).
    { exact (group_inv_of_prod G multG eG invG HgrpG g1 g2 Hg1G Hg2G). }
    claim Hg12_pred : (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (apply_fun multG (g1, g2), h), apply_fun invG (apply_fun multG (g1, g2))) :e H0) /\ (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (apply_fun invG (apply_fun multG (g1, g2)), h), apply_fun multG (g1, g2)) :e H0).
    { apply andI.
      - let h0. assume Hh0H0.
        claim Hh0G : h0 :e G. { exact (HH0subG h0 Hh0H0). }
        claim Hg2h0G : apply_fun multG (g2, h0) :e G.
        { exact (HmultG_cl g2 h0 Hg2G Hh0G). }
        claim Hig2ig1G : apply_fun multG (apply_fun invG g2, apply_fun invG g1) :e G.
        { exact (HmultG_cl (apply_fun invG g2) (apply_fun invG g1) Hig2G Hig1G). }
        rewrite (HassocG g1 g2 h0 Hg1G Hg2G Hh0G).
        rewrite Hig12.
        rewrite (HassocG g1 (apply_fun multG (g2, h0)) (apply_fun multG (apply_fun invG g2, apply_fun invG g1)) Hg1G Hg2h0G Hig2ig1G).
        rewrite <- (HassocG (apply_fun multG (g2, h0)) (apply_fun invG g2) (apply_fun invG g1) Hg2h0G Hig2G Hig1G).
        claim Hconj2 : apply_fun multG (apply_fun multG (g2, h0), apply_fun invG g2) :e H0. { exact (Hg2_conj h0 Hh0H0). }
        claim Hconj2G : apply_fun multG (apply_fun multG (g2, h0), apply_fun invG g2) :e G. { exact (HH0subG (apply_fun multG (apply_fun multG (g2, h0), apply_fun invG g2)) Hconj2). }
        rewrite <- (HassocG g1 (apply_fun multG (apply_fun multG (g2, h0), apply_fun invG g2)) (apply_fun invG g1) Hg1G Hconj2G Hig1G).
        exact (Hg1_conj (apply_fun multG (apply_fun multG (g2, h0), apply_fun invG g2)) Hconj2).
      - let h0. assume Hh0H0.
        claim Hh0G : h0 :e G. { exact (HH0subG h0 Hh0H0). }
        rewrite Hig12.
        claim Hig2ig1G2 : apply_fun multG (apply_fun invG g2, apply_fun invG g1) :e G.
        { exact (HmultG_cl (apply_fun invG g2) (apply_fun invG g1) Hig2G Hig1G). }
        rewrite (HassocG (apply_fun invG g2) (apply_fun invG g1) h0 Hig2G Hig1G Hh0G).
        claim Hig1h0G : apply_fun multG (apply_fun invG g1, h0) :e G. { exact (HmultG_cl (apply_fun invG g1) h0 Hig1G Hh0G). }
        rewrite (HassocG (apply_fun invG g2) (apply_fun multG (apply_fun invG g1, h0)) (apply_fun multG (g1, g2)) Hig2G Hig1h0G Hg12G).
        rewrite <- (HassocG (apply_fun multG (apply_fun invG g1, h0)) g1 g2 Hig1h0G Hg1G Hg2G).
        claim Hconj1 : apply_fun multG (apply_fun multG (apply_fun invG g1, h0), g1) :e H0. { exact (Hg1_conj2 h0 Hh0H0). }
        claim Hconj1G : apply_fun multG (apply_fun multG (apply_fun invG g1, h0), g1) :e G. { exact (HH0subG (apply_fun multG (apply_fun multG (apply_fun invG g1, h0), g1)) Hconj1). }
        rewrite <- (HassocG (apply_fun invG g2) (apply_fun multG (apply_fun multG (apply_fun invG g1, h0), g1)) g2 Hig2G Hconj1G Hg2G).
        exact (Hg2_conj2 (apply_fun multG (apply_fun multG (apply_fun invG g1, h0), g1)) Hconj1). }
    exact (SepI G (fun g:set => (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (g, h), apply_fun invG g) :e H0) /\ (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (apply_fun invG g, h), g) :e H0)) (apply_fun multG (g1, g2)) Hg12G Hg12_pred).
  - (** N closed under inv **)
    let g. assume HgN.
    claim HgG : g :e G. { exact (HNsubG g HgN). }
    claim HigG : apply_fun invG g :e G. { exact (HinvG_cl g HgG). }
    claim Hg_norm : (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (g, h), apply_fun invG g) :e H0) /\ (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (apply_fun invG g, h), g) :e H0).
    { exact (SepE2 G (fun g:set => (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (g, h), apply_fun invG g) :e H0) /\ (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (apply_fun invG g, h), g) :e H0)) g HgN). }
    claim Hiig : apply_fun invG (apply_fun invG g) = g.
    { exact (group_inv_inv G multG invG eG g HmultFn HinvFn HeGmem HassocG HidG HinvAxG HgG). }
    claim Hg_conj : forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (g, h), apply_fun invG g) :e H0.
    { exact (andEL (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (g, h), apply_fun invG g) :e H0) (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (apply_fun invG g, h), g) :e H0) Hg_norm). }
    claim Hg_conj2 : forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (apply_fun invG g, h), g) :e H0.
    { exact (andER (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (g, h), apply_fun invG g) :e H0) (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (apply_fun invG g, h), g) :e H0) Hg_norm). }
    claim Hinv_pred : (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (apply_fun invG g, h), apply_fun invG (apply_fun invG g)) :e H0) /\ (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (apply_fun invG (apply_fun invG g), h), apply_fun invG g) :e H0).
    { apply andI.
      - let h0. assume Hh0H0. rewrite Hiig. exact (Hg_conj2 h0 Hh0H0).
      - let h0. assume Hh0H0. rewrite Hiig. exact (Hg_conj h0 Hh0H0). }
    exact (SepI G (fun g:set => (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (g, h), apply_fun invG g) :e H0) /\ (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (apply_fun invG g, h), g) :e H0)) (apply_fun invG g) HigG Hinv_pred).
}
(** N inherits group structure **)
claim HgrpN : group_structure N multG eG invG.
{ exact (subgroup_inherits_group_structure G multG eG invG N HgrpG HNsub). }
(** H0 c= N: elements of H0 normalize H0 since H0 is a subgroup **)
claim HH0subN : H0 c= N.
{ let g0. assume Hg0H0.
  claim Hg0G : g0 :e G. { exact (HH0subG g0 Hg0H0). }
  claim Hg0_pred : (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (g0, h), apply_fun invG g0) :e H0) /\ (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (apply_fun invG g0, h), g0) :e H0).
  { apply andI.
    - let h. assume HhH0. exact (HH0_mult_cl (apply_fun multG (g0, h)) (apply_fun invG g0) (HH0_mult_cl g0 h Hg0H0 HhH0) (HH0_inv_cl g0 Hg0H0)).
    - let h. assume HhH0. exact (HH0_mult_cl (apply_fun multG (apply_fun invG g0, h)) g0 (HH0_mult_cl (apply_fun invG g0) h (HH0_inv_cl g0 Hg0H0) HhH0) Hg0H0). }
  exact (SepI G (fun g:set => (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (g, h), apply_fun invG g) :e H0) /\ (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (apply_fun invG g, h), g) :e H0)) g0 Hg0G Hg0_pred). }
(** H0 is a subgroup of N **)
claim HH0subN_sub : subgroup_of H0 N multG eG invG.
{ prove ((H0 c= N /\ eG :e H0) /\ (forall x y:set, x :e H0 -> y :e H0 -> apply_fun multG (x, y) :e H0)) /\ (forall x:set, x :e H0 -> apply_fun invG x :e H0).
  claim Hab : H0 c= N /\ eG :e H0. { exact (andI (H0 c= N) (eG :e H0) HH0subN HeG_H0). }
  claim Habc : (H0 c= N /\ eG :e H0) /\ (forall x y:set, x :e H0 -> y :e H0 -> apply_fun multG (x, y) :e H0).
  { exact (andI (H0 c= N /\ eG :e H0) (forall x y:set, x :e H0 -> y :e H0 -> apply_fun multG (x, y) :e H0) Hab HH0_mult_cl). }
  exact (andI
    ((H0 c= N /\ eG :e H0) /\ (forall x y:set, x :e H0 -> y :e H0 -> apply_fun multG (x, y) :e H0))
    (forall x:set, x :e H0 -> apply_fun invG x :e H0)
    Habc HH0_inv_cl).
}
(** H0 is normal in N **)
claim HH0normalN : normal_subgroup H0 N multG eG invG.
{ prove (subgroup_of H0 N multG eG invG) /\ (forall n g:set, n :e H0 -> g :e N -> apply_fun multG (apply_fun multG (g, n), apply_fun invG g) :e H0).
  exact (andI
    (subgroup_of H0 N multG eG invG)
    (forall n g:set, n :e H0 -> g :e N -> apply_fun multG (apply_fun multG (g, n), apply_fun invG g) :e H0)
    HH0subN_sub
    (fun n g HnH0 HgN =>
      andEL
        (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (g, h), apply_fun invG g) :e H0)
        (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (apply_fun invG g, h), g) :e H0)
        (SepE2 G (fun g:set => (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (g, h), apply_fun invG g) :e H0) /\ (forall h:set, h :e H0 -> apply_fun multG (apply_fun multG (apply_fun invG g, h), g) :e H0)) g HgN)
        n HnH0)).
}
(** Lifting correspondence lands in fiber and is surjective **)
claim Hlc_surj : forall e1:set, e1 :e E -> apply_fun p e1 = b0 ->
  exists cls:set, cls :e G /\ apply_fun lc cls = e1.
{ let e1. assume He1E Hpe1.
  claim Hsurj : surjective_map G (Sep E (fun x:set => apply_fun p x = apply_fun p e0)) lc.
  { exact (thm54_4_lifting_correspondence_surjective E Te B Tb p e0 Hcov He0E HpcE). }
  claim Hfib : e1 :e Sep E (fun x:set => apply_fun p x = apply_fun p e0).
  { exact (SepI E (fun x:set => apply_fun p x = apply_fun p e0) e1 He1E Hpe1). }
  claim Hsurj2 : forall y:set, y :e Sep E (fun x:set => apply_fun p x = apply_fun p e0) ->
    exists x:set, x :e G /\ apply_fun lc x = y.
  { exact (andER (function_on lc G (Sep E (fun x:set => apply_fun p x = apply_fun p e0)))
      (forall y:set, y :e Sep E (fun x:set => apply_fun p x = apply_fun p e0) -> exists x:set, x :e G /\ apply_fun lc x = y)
      Hsurj). }
  exact (Hsurj2 e1 Hfib). }
(** For any h in CTG, h(e0) is in the fiber **)
claim Hhe0_fiber : forall h:set, h :e CTG ->
  apply_fun h e0 :e E /\ apply_fun p (apply_fun h e0) = b0.
{ let h. assume HhCTG.
  claim Hct : covering_transformation E Te B Tb p h.
  { exact (SepE2 (function_space E E) (fun h:set => covering_transformation E Te B Tb p h) h HhCTG). }
  claim Hhomeo : homeomorphism E Te E Te h.
  { exact (andEL (homeomorphism E Te E Te h) (forall x:set, x :e E -> apply_fun p (apply_fun h x) = apply_fun p x) Hct). }
  claim Hpcomm : forall x:set, x :e E -> apply_fun p (apply_fun h x) = apply_fun p x.
  { exact (andER (homeomorphism E Te E Te h) (forall x:set, x :e E -> apply_fun p (apply_fun h x) = apply_fun p x) Hct). }
  claim Hcont : continuous_map E Te E Te h.
  { exact (andEL (continuous_map E Te E Te h) (exists g:set, continuous_map E Te E Te g /\ (forall x:set, x :e E -> apply_fun g (apply_fun h x) = x) /\ (forall y:set, y :e E -> apply_fun h (apply_fun g y) = y)) Hhomeo). }
  claim Hfon : function_on h E E.
  { exact (continuous_map_function_on E Te E Te h Hcont). }
  claim Hhe0E : apply_fun h e0 :e E.
  { exact (Hfon e0 He0E). }
  claim Hphe0 : apply_fun p (apply_fun h e0) = apply_fun p e0.
  { exact (Hpcomm e0 He0E). }
  claim Hphe0_b0 : apply_fun p (apply_fun h e0) = b0.
  { rewrite Hphe0. exact (eq_refl b0). }
  exact (andI (apply_fun h e0 :e E) (apply_fun p (apply_fun h e0) = b0) Hhe0E Hphe0_b0). }
(** For any h in CTG, the Eps_i chosen class is in N **)
claim Hcls_in_N : forall h:set, h :e CTG ->
  Eps_i (fun cls:set => cls :e G /\ apply_fun lc cls = apply_fun h e0) :e N.
{ let h. assume HhCTG.
  claim Hfib : apply_fun h e0 :e E /\ apply_fun p (apply_fun h e0) = b0.
  { exact (Hhe0_fiber h HhCTG). }
  claim HhE_in_E : apply_fun h e0 :e E.
  { exact (andEL (apply_fun h e0 :e E) (apply_fun p (apply_fun h e0) = b0) Hfib). }
  claim HphE_eq : apply_fun p (apply_fun h e0) = b0.
  { exact (andER (apply_fun h e0 :e E) (apply_fun p (apply_fun h e0) = b0) Hfib). }
  (** Covering transformation for h **)
  claim Hct2 : covering_transformation E Te B Tb p h.
  { exact (SepE2 (function_space E E) (fun h0:set => covering_transformation E Te B Tb p h0) h HhCTG). }
  claim Hexists_ct : exists h0:set, covering_transformation E Te B Tb p h0 /\ apply_fun h0 e0 = apply_fun h e0.
  { witness h. exact (andI (covering_transformation E Te B Tb p h) (apply_fun h e0 = apply_fun h e0) Hct2 (eq_refl (apply_fun h e0))). }
  (** Forward direction via lemma81_1_forward helper (avoids parser bug with 13-arg lemma81_1) **)
  claim Hfwd : forall alpha:set,
    loop_at B Tb b0 alpha ->
    apply_fun (path_lift E Te B Tb p e0 alpha) 1 = apply_fun h e0 ->
    path_homotopy_class_loop B Tb b0 alpha :e N.
  { exact (lemma81_1_forward E Te B Tb p e0 (apply_fun h e0) Hcov He0E HpcE HlpE HhE_in_E HphE_eq Hexists_ct). }
  (** Now define cls0 and eps **)
  set cls0 := Eps_i (fun cls:set => cls :e G /\ apply_fun lc cls = apply_fun h e0).
  claim Hcls0_pred : cls0 :e G /\ apply_fun lc cls0 = apply_fun h e0.
  { apply (Hlc_surj (apply_fun h e0) HhE_in_E HphE_eq).
    let w. assume Hw.
    exact (Eps_i_ax (fun cls:set => cls :e G /\ apply_fun lc cls = apply_fun h e0) w Hw). }
  claim Hcls0G : cls0 :e G.
  { exact (andEL (cls0 :e G) (apply_fun lc cls0 = apply_fun h e0) Hcls0_pred). }
  claim Hlc_cls0 : apply_fun lc cls0 = apply_fun h e0.
  { exact (andER (cls0 :e G) (apply_fun lc cls0 = apply_fun h e0) Hcls0_pred). }
  set eps := Eps_i (fun f:set => f :e cls0).
  claim HepsLoop : eps :e loop_space B Tb b0.
  { exact (eps_of_fundamental_group_member_in_loop_space B Tb b0 cls0 Hcls0G). }
  claim HepsLoopAt : loop_at B Tb b0 eps.
  { exact (loop_space_has_loop_at B Tb b0 eps HepsLoop). }
  claim Hlc_unfold : apply_fun lc cls0 = apply_fun (path_lift E Te B Tb p e0 eps) 1.
  { exact (apply_fun_graph G
    (fun clsX:set => apply_fun (path_lift E Te B Tb p e0 (Eps_i (fun f0:set => f0 :e clsX))) 1)
    cls0 Hcls0G). }
  claim Hlift_end : apply_fun (path_lift E Te B Tb p e0 eps) 1 = apply_fun h e0.
  { rewrite <- Hlc_unfold. exact Hlc_cls0. }
  (** Apply forward direction to eps to get [eps] in N **)
  claim Heps_in_N : path_homotopy_class_loop B Tb b0 eps :e N.
  { apply Hfwd.
    - exact HepsLoopAt.
    - exact Hlift_end. }
  (** Show cls0 = [eps] via representative chain **)
  claim Heps_class : cls0 = path_homotopy_class_loop B Tb b0 eps.
  { claim Hrep : exists f:set, f :e loop_space B Tb b0 /\ cls0 = path_homotopy_class_loop B Tb b0 f.
    { exact (fundamental_group_member_has_representative B Tb b0 cls0 Hcls0G). }
    apply Hrep. let f. assume HfPack.
    claim HfLoop : f :e loop_space B Tb b0.
    { exact (andEL (f :e loop_space B Tb b0) (cls0 = path_homotopy_class_loop B Tb b0 f) HfPack). }
    claim Hcls0_eq_f : cls0 = path_homotopy_class_loop B Tb b0 f.
    { exact (andER (f :e loop_space B Tb b0) (cls0 = path_homotopy_class_loop B Tb b0 f) HfPack). }
    claim HfInCls0 : f :e cls0.
    { exact (mem_eqL f cls0 (path_homotopy_class_loop B Tb b0 f) Hcls0_eq_f
        (loop_in_own_class_early B Tb b0 f HtopB HfLoop)). }
    claim HepsInCls0 : eps :e cls0.
    { exact (Eps_i_ax (fun g:set => g :e cls0) f HfInCls0). }
    claim HepsInClassf : eps :e path_homotopy_class_loop B Tb b0 f.
    { exact (mem_eqR eps cls0 (path_homotopy_class_loop B Tb b0 f) Hcls0_eq_f HepsInCls0). }
    claim Hph_f_eps : path_homotopic B Tb b0 b0 f eps.
    { exact (SepE2 (loop_space B Tb b0) (fun g:set => path_homotopic B Tb b0 b0 f g) eps HepsInClassf). }
    claim Hclass_eq : path_homotopy_class_loop B Tb b0 f = path_homotopy_class_loop B Tb b0 eps.
    { exact (path_homotopy_class_loop_eq_of_path_homotopic B Tb b0 f eps Hph_f_eps). }
    transitivity (path_homotopy_class_loop B Tb b0 f).
    - exact Hcls0_eq_f.
    - exact Hclass_eq. }
  (** Conclude cls0 :e N from cls0 = [eps] and [eps] :e N **)
  exact (eq_subst_mem cls0 (path_homotopy_class_loop B Tb b0 eps) N Heps_class Heps_in_N). }
(** Covering transformations determined by value at one point **)
claim Hct_unique : forall h1 h2:set, h1 :e CTG -> h2 :e CTG ->
  apply_fun h1 e0 = apply_fun h2 e0 -> h1 = h2.
{ let h1 h2. assume Hh1CTG Hh2CTG Heq_e0.
  claim Hh1_ct : covering_transformation E Te B Tb p h1.
  { exact (SepE2 (function_space E E) (fun h:set => covering_transformation E Te B Tb p h) h1 Hh1CTG). }
  claim Hh2_ct : covering_transformation E Te B Tb p h2.
  { exact (SepE2 (function_space E E) (fun h:set => covering_transformation E Te B Tb p h) h2 Hh2CTG). }
  claim Hh1_homeo : homeomorphism E Te E Te h1.
  { exact (andEL (homeomorphism E Te E Te h1) (forall x:set, x :e E -> apply_fun p (apply_fun h1 x) = apply_fun p x) Hh1_ct). }
  claim Hh2_homeo : homeomorphism E Te E Te h2.
  { exact (andEL (homeomorphism E Te E Te h2) (forall x:set, x :e E -> apply_fun p (apply_fun h2 x) = apply_fun p x) Hh2_ct). }
  claim Hh1_comm : forall x:set, x :e E -> apply_fun p (apply_fun h1 x) = apply_fun p x.
  { exact (andER (homeomorphism E Te E Te h1) (forall x:set, x :e E -> apply_fun p (apply_fun h1 x) = apply_fun p x) Hh1_ct). }
  claim Hh2_comm : forall x:set, x :e E -> apply_fun p (apply_fun h2 x) = apply_fun p x.
  { exact (andER (homeomorphism E Te E Te h2) (forall x:set, x :e E -> apply_fun p (apply_fun h2 x) = apply_fun p x) Hh2_ct). }
  claim Hh1_cont : continuous_map E Te E Te h1.
  { exact (homeomorphism_continuous E Te E Te h1 Hh1_homeo). }
  claim Hh2_cont : continuous_map E Te E Te h2.
  { exact (homeomorphism_continuous E Te E Te h2 Hh2_homeo). }
  (** Build lifting_of E Te E Te B Tb p p h_i **)
  claim Hh1_lift : lifting_of E Te E Te B Tb p p h1.
  { prove continuous_map E Te E Te h1 /\ (forall x:set, x :e E -> apply_fun p (apply_fun h1 x) = apply_fun p x).
    apply andI. exact Hh1_cont. exact Hh1_comm. }
  claim Hh2_lift : lifting_of E Te E Te B Tb p p h2.
  { prove continuous_map E Te E Te h2 /\ (forall x:set, x :e E -> apply_fun p (apply_fun h2 x) = apply_fun p x).
    apply andI. exact Hh2_cont. exact Hh2_comm. }
  claim HconnE : connected_space E Te.
  { exact (path_connected_implies_connected E Te HpcE). }
  (** Pointwise equality from lift uniqueness on connected domain **)
  claim Hpointwise : forall x:set, x :e E -> apply_fun h1 x = apply_fun h2 x.
  { exact (covering_map_lifts_agree_on_connected_domain E Te B Tb p E Te p h1 h2 e0 Hcov HconnE Hh1_lift Hh2_lift He0E Heq_e0). }
  (** CTG extensionality via bridge **)
  exact (ctg_pointwise_eq_implies_set_eq_early E Te B Tb p h1 h2 Hcov Hh1CTG Hh2CTG Hpointwise). }
(** Same lc value implies same left coset in N **)
claim Hsame_lc_same_coset : forall c1 c2:set, c1 :e N -> c2 :e N ->
  apply_fun lc c1 = apply_fun lc c2 ->
  left_coset multG c1 H0 = left_coset multG c2 H0.
{ let c1 c2. assume Hc1N Hc2N Hlc_eq.
  claim Hc1G : c1 :e G. { exact (HNsubG c1 Hc1N). }
  claim Hc2G : c2 :e G. { exact (HNsubG c2 Hc2N). }
  claim HinvC2_N : apply_fun invG c2 :e N.
  { exact (andER
      ((N c= G /\ eG :e N) /\ (forall x y:set, x :e N -> y :e N -> apply_fun multG (x, y) :e N))
      (forall x:set, x :e N -> apply_fun invG x :e N)
      HNsub c2 Hc2N). }
  claim HinvC2_G : apply_fun invG c2 :e G.
  { exact (HNsubG (apply_fun invG c2) HinvC2_N). }
  claim Hprod_H0 : apply_fun multG (c1, apply_fun invG c2) :e H0.
  { set eps1 := Eps_i (fun f:set => f :e c1).
    set eps2 := Eps_i (fun f:set => f :e c2).
    claim Heps1_ls : eps1 :e loop_space B Tb b0.
    { exact (eps_of_fundamental_group_member_in_loop_space B Tb b0 c1 Hc1G). }
    claim Heps2_ls : eps2 :e loop_space B Tb b0.
    { exact (eps_of_fundamental_group_member_in_loop_space B Tb b0 c2 Hc2G). }
    claim Hrev_ls : reverse_path eps2 :e loop_space B Tb b0.
    { exact (reverse_path_preserves_loop_space_early B Tb b0 eps2 Heps2_ls). }
    set delta := path_concat eps1 (reverse_path eps2).
    claim Hdelta_ls : delta :e loop_space B Tb b0.
    { exact (path_concat_preserves_loop_space_early B Tb b0 eps1 (reverse_path eps2)
        Heps1_ls Hrev_ls). }
    claim Hdelta_H0 : path_homotopy_class_loop B Tb b0 delta :e H0.
    { claim Heps1_la : loop_at B Tb b0 eps1.
      { exact (loop_space_has_loop_at B Tb b0 eps1 Heps1_ls). }
      claim Heps2_la : loop_at B Tb b0 eps2.
      { exact (loop_space_has_loop_at B Tb b0 eps2 Heps2_ls). }
      claim Heps1_cont : continuous_map unit_interval unit_interval_topology B Tb eps1.
      { exact (loop_at_continuous B Tb b0 eps1 Heps1_la). }
      claim Heps2_cont : continuous_map unit_interval unit_interval_topology B Tb eps2.
      { exact (loop_at_continuous B Tb b0 eps2 Heps2_la). }
      claim Heps1_0 : apply_fun eps1 0 = b0. { exact (loop_at_at_zero B Tb b0 eps1 Heps1_la). }
      claim Heps2_0 : apply_fun eps2 0 = b0. { exact (loop_at_at_zero B Tb b0 eps2 Heps2_la). }
      claim Heps1_1 : apply_fun eps1 1 = b0. { exact (loop_at_at_one B Tb b0 eps1 Heps1_la). }
      claim Heps2_1 : apply_fun eps2 1 = b0. { exact (loop_at_at_one B Tb b0 eps2 Heps2_la). }
      claim Hrev_cont : continuous_map unit_interval unit_interval_topology B Tb (reverse_path eps2).
      { exact (reverse_path_continuous B Tb eps2 Heps2_cont). }
      claim Hdelta_la : loop_at B Tb b0 delta.
      { exact (loop_space_has_loop_at B Tb b0 delta Hdelta_ls). }
      claim Hdelta_cont : continuous_map unit_interval unit_interval_topology B Tb delta.
      { exact (loop_at_continuous B Tb b0 delta Hdelta_la). }
      claim Hpe0d : apply_fun p e0 = apply_fun delta 0.
      { claim Hd0 : apply_fun delta 0 = b0.
        { exact (loop_at_at_zero B Tb b0 delta Hdelta_la). }
        rewrite Hd0. exact (eq_refl b0). }
      claim Hlift_data : (continuous_map unit_interval unit_interval_topology E Te
          (path_lift E Te B Tb p e0 delta) /\
        apply_fun (path_lift E Te B Tb p e0 delta) 0 = e0) /\
        (forall t:set, t :e unit_interval ->
          apply_fun p (apply_fun (path_lift E Te B Tb p e0 delta) t) = apply_fun delta t).
      { exact (lemma54_1_path_lifting E Te B Tb p e0 delta Hcov He0E Hpe0d Hdelta_cont). }
      set gamma := path_lift E Te B Tb p e0 delta.
      claim Hlift_AB :
        continuous_map unit_interval unit_interval_topology E Te gamma /\
        apply_fun gamma 0 = e0.
      { exact (andEL
          (continuous_map unit_interval unit_interval_topology E Te gamma /\
            apply_fun gamma 0 = e0)
          (forall t:set, t :e unit_interval ->
            apply_fun p (apply_fun gamma t) = apply_fun delta t)
          Hlift_data). }
      claim Hgamma_cont : continuous_map unit_interval unit_interval_topology E Te gamma.
      { exact (andEL
          (continuous_map unit_interval unit_interval_topology E Te gamma)
          (apply_fun gamma 0 = e0) Hlift_AB). }
      claim Hgamma_0 : apply_fun gamma 0 = e0.
      { exact (andER
          (continuous_map unit_interval unit_interval_topology E Te gamma)
          (apply_fun gamma 0 = e0) Hlift_AB). }
      claim Hgamma_comm : forall t:set, t :e unit_interval ->
        apply_fun p (apply_fun gamma t) = apply_fun delta t.
      { exact (andER
          (continuous_map unit_interval unit_interval_topology E Te gamma /\
            apply_fun gamma 0 = e0)
          (forall t:set, t :e unit_interval ->
            apply_fun p (apply_fun gamma t) = apply_fun delta t)
          Hlift_data). }
      claim Hgamma_1_e0 : apply_fun gamma 1 = e0.
      { (** gamma = path_lift(e0, delta), delta = concat(eps1, rev(eps2)) **)
        (** Step 1: lc unfolds to path_lift endpoint **)
        claim Hlc1_unfold : apply_fun lc c1 = apply_fun (path_lift E Te B Tb p e0 (Eps_i (fun f0:set => f0 :e c1))) 1.
        { exact (apply_fun_graph G
            (fun clsX:set => apply_fun (path_lift E Te B Tb p e0 (Eps_i (fun f0:set => f0 :e clsX))) 1)
            c1 Hc1G). }
        claim Hlc2_unfold : apply_fun lc c2 = apply_fun (path_lift E Te B Tb p e0 (Eps_i (fun f0:set => f0 :e c2))) 1.
        { exact (apply_fun_graph G
            (fun clsX:set => apply_fun (path_lift E Te B Tb p e0 (Eps_i (fun f0:set => f0 :e clsX))) 1)
            c2 Hc2G). }
        (** eps1 = Eps_i(f :e c1) and eps2 = Eps_i(f :e c2), so lc(ci) = path_lift(e0, epsi)(1) **)
        claim Hlift1_end : apply_fun (path_lift E Te B Tb p e0 eps1) 1 = apply_fun lc c1.
        { exact (eq_symm (apply_fun lc c1) (apply_fun (path_lift E Te B Tb p e0 eps1) 1) Hlc1_unfold). }
        claim Hlift2_end : apply_fun (path_lift E Te B Tb p e0 eps2) 1 = apply_fun lc c2.
        { exact (eq_symm (apply_fun lc c2) (apply_fun (path_lift E Te B Tb p e0 eps2) 1) Hlc2_unfold). }
        (** From Hlc_eq: lift endpoints are equal **)
        claim Hlift_ends_eq : apply_fun (path_lift E Te B Tb p e0 eps1) 1
          = apply_fun (path_lift E Te B Tb p e0 eps2) 1.
        { transitivity (apply_fun lc c1).
          - exact Hlift1_end.
          - transitivity (apply_fun lc c2).
            + exact Hlc_eq.
            + exact Hlc2_unfold. }
        (** Step 2: concat endpoint via path_lift_concat_endpoint **)
        claim Heps1_match_rev : apply_fun eps1 1 = apply_fun (reverse_path eps2) 0.
        { rewrite Heps1_1. rewrite (reverse_path_at_zero eps2). rewrite Heps2_1.
          reflexivity. }
        claim Hpe0_eps1 : apply_fun p e0 = apply_fun eps1 0.
        { rewrite Heps1_0. exact (eq_refl b0). }
        claim Hconcat_end :
          apply_fun (path_lift E Te B Tb p e0 (path_concat eps1 (reverse_path eps2))) 1
          = apply_fun (path_lift E Te B Tb p (apply_fun (path_lift E Te B Tb p e0 eps1) 1) (reverse_path eps2)) 1.
        { exact (path_lift_concat_endpoint E Te B Tb p e0 eps1 (reverse_path eps2)
            Hcov He0E Heps1_cont Hrev_cont Heps1_match_rev Hpe0_eps1). }
        (** Step 3: substitute equal endpoints **)
        claim Hconcat_end2 :
          apply_fun (path_lift E Te B Tb p (apply_fun (path_lift E Te B Tb p e0 eps1) 1) (reverse_path eps2)) 1
          = apply_fun (path_lift E Te B Tb p (apply_fun (path_lift E Te B Tb p e0 eps2) 1) (reverse_path eps2)) 1.
        { rewrite Hlift_ends_eq. reflexivity. }
        (** Step 4: path_lift_reverse_endpoint gives e0 **)
        claim Hpe0_eps2 : apply_fun p e0 = apply_fun eps2 0.
        { rewrite Heps2_0. exact (eq_refl b0). }
        claim Hrev_end :
          apply_fun (path_lift E Te B Tb p (apply_fun (path_lift E Te B Tb p e0 eps2) 1) (reverse_path eps2)) 1 = e0.
        { exact (path_lift_reverse_endpoint E Te B Tb p e0 eps2
            Hcov He0E Heps2_cont Hpe0_eps2). }
        (** Chain: gamma(1) = concat_end = concat_end2 = rev_end = e0 **)
        transitivity (apply_fun (path_lift E Te B Tb p (apply_fun (path_lift E Te B Tb p e0 eps1) 1) (reverse_path eps2)) 1).
        - exact Hconcat_end.
        - transitivity (apply_fun (path_lift E Te B Tb p (apply_fun (path_lift E Te B Tb p e0 eps2) 1) (reverse_path eps2)) 1).
          + exact Hconcat_end2.
          + exact Hrev_end. }
      claim Hgamma_la : loop_at E Te e0 gamma.
      { exact (loop_at_pack_right E Te e0 gamma
          (andI (continuous_map unit_interval unit_interval_topology E Te gamma)
            (apply_fun gamma 0 = e0 /\ apply_fun gamma 1 = e0)
            Hgamma_cont
            (andI (apply_fun gamma 0 = e0) (apply_fun gamma 1 = e0)
              Hgamma_0 Hgamma_1_e0))). }
      claim Hgamma_ls : gamma :e loop_space E Te e0.
      { claim Hgamma_fs : gamma :e function_space unit_interval E.
        { exact (total_function_space_sub_function_space unit_interval E gamma
            (continuous_map_in_total_function_space_plain unit_interval unit_interval_topology E Te gamma Hgamma_cont)). }
        exact (SepI (function_space unit_interval E) (fun f:set => loop_at E Te e0 f) gamma Hgamma_fs Hgamma_la). }
      claim Hgamma_FG : path_homotopy_class_loop E Te e0 gamma :e fundamental_group E Te e0.
      { exact (loop_at_implies_fundamental_group_member E Te e0 gamma HtopE He0E Hgamma_la). }
      set pof := compose_fun unit_interval gamma p.
      claim Hpof_cont : continuous_map unit_interval unit_interval_topology B Tb pof.
      { exact (composition_continuous unit_interval unit_interval_topology E Te B Tb
          gamma p Hgamma_cont Hp_cont). }
      claim Hpof_0 : apply_fun pof 0 = b0.
      { claim H : apply_fun pof 0 = apply_fun p (apply_fun gamma 0).
        { exact (compose_fun_apply unit_interval gamma p 0 zero_in_unit_interval). }
        rewrite H. rewrite Hgamma_0. exact (eq_refl b0). }
      claim Hpof_1 : apply_fun pof 1 = b0.
      { claim H : apply_fun pof 1 = apply_fun p (apply_fun gamma 1).
        { exact (compose_fun_apply unit_interval gamma p 1 one_in_unit_interval). }
        rewrite H. rewrite Hgamma_1_e0. exact (eq_refl b0). }
      claim Hpof_delta_htpy : path_homotopic B Tb b0 b0 pof delta.
      { claim Hpointwise : forall s:set, s :e unit_interval -> apply_fun pof s = apply_fun delta s.
        { let s. assume Hs.
          claim Hcomp : apply_fun pof s = apply_fun p (apply_fun gamma s).
          { exact (compose_fun_apply unit_interval gamma p s Hs). }
          rewrite Hcomp. exact (Hgamma_comm s Hs). }
        claim Hdelta_0 : apply_fun delta 0 = b0.
        { exact (loop_at_at_zero B Tb b0 delta Hdelta_la). }
        claim Hdelta_1 : apply_fun delta 1 = b0.
        { exact (loop_at_at_one B Tb b0 delta Hdelta_la). }
        exact (path_homotopic_of_pointwise_equal B Tb b0 b0 pof delta
          Hpof_cont Hdelta_cont Hpof_0 Hpof_1 Hdelta_0 Hdelta_1 Hpointwise). }
      claim Hpof_delta_cls : path_homotopy_class_loop B Tb b0 pof = path_homotopy_class_loop B Tb b0 delta.
      { exact (path_homotopy_class_loop_eq_of_path_homotopic B Tb b0 pof delta Hpof_delta_htpy). }
      claim Hpof_H0 : path_homotopy_class_loop B Tb b0 pof :e H0.
      { claim Hphi0_eq : apply_fun (induced_homomorphism E Te e0 B Tb b0 p)
            (path_homotopy_class_loop E Te e0 gamma)
            = path_homotopy_class_loop B Tb b0 pof.
        { claim Hih : apply_fun (induced_homomorphism E Te e0 B Tb b0 p)
              (path_homotopy_class_loop E Te e0 gamma)
              = path_homotopy_class_loop B Tb b0
                (compose_fun unit_interval (Eps_i (fun w:set => w :e path_homotopy_class_loop E Te e0 gamma)) p).
          { exact (induced_homomorphism_apply_on_loop_class E Te e0 B Tb b0 p gamma Hgamma_ls). }
          rewrite Hih.
          set eps_g := Eps_i (fun w:set => w :e path_homotopy_class_loop E Te e0 gamma).
          claim Heps_in : eps_g :e path_homotopy_class_loop E Te e0 gamma.
          { exact (Eps_i_ax (fun w:set => w :e path_homotopy_class_loop E Te e0 gamma) gamma
              (loop_in_own_path_homotopy_class E Te e0 gamma Hgamma_ls)). }
          claim Heps_htpy : path_homotopic E Te e0 e0 gamma eps_g.
          { exact (path_homotopy_class_loop_has_homotopy E Te e0 gamma eps_g Heps_in). }
          claim Hpost : path_homotopic B Tb b0 b0
            (compose_fun unit_interval gamma p) (compose_fun unit_interval eps_g p).
          { exact (path_homotopic_postcompose E Te B Tb e0 e0 b0 b0 gamma eps_g p
              Heps_htpy Hp_cont (eq_refl b0) (eq_refl b0)). }
          exact (eq_symm
            (path_homotopy_class_loop B Tb b0 pof)
            (path_homotopy_class_loop B Tb b0 (compose_fun unit_interval eps_g p))
            (path_homotopy_class_loop_eq_of_path_homotopic B Tb b0
              pof (compose_fun unit_interval eps_g p) Hpost)). }
        exact (eq_subst_mem
          (path_homotopy_class_loop B Tb b0 pof)
          (apply_fun (induced_homomorphism E Te e0 B Tb b0 p) (path_homotopy_class_loop E Te e0 gamma))
          H0
          (eq_symm (apply_fun (induced_homomorphism E Te e0 B Tb b0 p)
            (path_homotopy_class_loop E Te e0 gamma))
            (path_homotopy_class_loop B Tb b0 pof) Hphi0_eq)
          (ReplI (fundamental_group E Te e0)
            (fun cls:set => apply_fun (induced_homomorphism E Te e0 B Tb b0 p) cls)
            (path_homotopy_class_loop E Te e0 gamma) Hgamma_FG)). }
      exact (eq_subst_mem
        (path_homotopy_class_loop B Tb b0 delta)
        (path_homotopy_class_loop B Tb b0 pof)
        H0
        (eq_symm (path_homotopy_class_loop B Tb b0 pof)
          (path_homotopy_class_loop B Tb b0 delta) Hpof_delta_cls)
        Hpof_H0). }
    claim Hconcat_class_eq_mult : path_homotopy_class_loop B Tb b0 delta
      = apply_fun multG (path_homotopy_class_loop B Tb b0 eps1,
          path_homotopy_class_loop B Tb b0 (reverse_path eps2)).
    { exact (path_homotopy_class_loop_concat_eq_mult B Tb b0 eps1 (reverse_path eps2)
        Heps1_ls Hrev_ls). }
    claim Heps1_class_eq : c1 = path_homotopy_class_loop B Tb b0 eps1.
    { claim Hrep : exists f:set, f :e loop_space B Tb b0 /\ c1 = path_homotopy_class_loop B Tb b0 f.
      { exact (fundamental_group_member_has_representative B Tb b0 c1 Hc1G). }
      apply Hrep. let f1. assume Hf1Pack.
      claim Hf1Loop : f1 :e loop_space B Tb b0.
      { exact (andEL (f1 :e loop_space B Tb b0) (c1 = path_homotopy_class_loop B Tb b0 f1) Hf1Pack). }
      claim Hc1_eq_f1 : c1 = path_homotopy_class_loop B Tb b0 f1.
      { exact (andER (f1 :e loop_space B Tb b0) (c1 = path_homotopy_class_loop B Tb b0 f1) Hf1Pack). }
      claim Hf1_in_c1 : f1 :e c1.
      { rewrite Hc1_eq_f1. exact (loop_in_own_class_early B Tb b0 f1 HtopB Hf1Loop). }
      claim Heps1_in_c1 : eps1 :e c1.
      { exact (Eps_i_ax (fun f:set => f :e c1) f1 Hf1_in_c1). }
      claim Heps1_in_class_f1 : eps1 :e path_homotopy_class_loop B Tb b0 f1.
      { rewrite <- Hc1_eq_f1. exact Heps1_in_c1. }
      claim Hph : path_homotopic B Tb b0 b0 f1 eps1.
      { exact (path_homotopy_class_loop_has_homotopy B Tb b0 f1 eps1 Heps1_in_class_f1). }
      claim Hclass_eq : path_homotopy_class_loop B Tb b0 f1 = path_homotopy_class_loop B Tb b0 eps1.
      { exact (path_homotopy_class_loop_eq_of_path_homotopic B Tb b0 f1 eps1 Hph). }
      transitivity (path_homotopy_class_loop B Tb b0 f1).
      - exact Hc1_eq_f1.
      - exact Hclass_eq. }
    claim Hinv_c2_eq : apply_fun invG c2 = path_homotopy_class_loop B Tb b0 (reverse_path eps2).
    { exact (fundamental_group_inv_apply B Tb b0 c2 Hc2G). }
    claim Hsym_eps1 : path_homotopy_class_loop B Tb b0 eps1 = c1.
    { exact (eq_symm c1 (path_homotopy_class_loop B Tb b0 eps1) Heps1_class_eq). }
    claim Hsym_rev : path_homotopy_class_loop B Tb b0 (reverse_path eps2) = apply_fun invG c2.
    { exact (eq_symm (apply_fun invG c2) (path_homotopy_class_loop B Tb b0 (reverse_path eps2)) Hinv_c2_eq). }
    claim Hdelta_eq_prod : path_homotopy_class_loop B Tb b0 delta
      = apply_fun multG (c1, apply_fun invG c2).
    { rewrite Hconcat_class_eq_mult. rewrite Hsym_eps1. rewrite Hsym_rev. reflexivity. }
    exact (eq_subst_mem
      (apply_fun multG (c1, apply_fun invG c2))
      (path_homotopy_class_loop B Tb b0 delta)
      H0
      (eq_symm (path_homotopy_class_loop B Tb b0 delta)
        (apply_fun multG (c1, apply_fun invG c2)) Hdelta_eq_prod)
      Hdelta_H0). }
  claim Hnormal_conj :
    apply_fun multG (apply_fun multG (apply_fun invG c2, apply_fun multG (c1, apply_fun invG c2)),
      apply_fun invG (apply_fun invG c2)) :e H0.
  { exact (andER (subgroup_of H0 N multG eG invG)
      (forall n g:set, n :e H0 -> g :e N ->
        apply_fun multG (apply_fun multG (g, n), apply_fun invG g) :e H0)
      HH0normalN
      (apply_fun multG (c1, apply_fun invG c2)) (apply_fun invG c2)
      Hprod_H0 HinvC2_N). }
  claim HinvInvC2 : apply_fun invG (apply_fun invG c2) = c2.
  { exact (group_inv_inv G multG invG eG c2 HmultFn HinvFn HeGmem HassocG HidG HinvAxG Hc2G). }
  claim HinvC2_c1_G : apply_fun multG (apply_fun invG c2, c1) :e G.
  { exact (HmultG_cl (apply_fun invG c2) c1 HinvC2_G Hc1G). }
  claim Hassoc1 :
    apply_fun multG (apply_fun invG c2, apply_fun multG (c1, apply_fun invG c2))
    = apply_fun multG (apply_fun multG (apply_fun invG c2, c1), apply_fun invG c2).
  { exact (eq_symm
      (apply_fun multG (apply_fun multG (apply_fun invG c2, c1), apply_fun invG c2))
      (apply_fun multG (apply_fun invG c2, apply_fun multG (c1, apply_fun invG c2)))
      (HassocG (apply_fun invG c2) c1 (apply_fun invG c2) HinvC2_G Hc1G HinvC2_G)). }
  claim Hassoc2 :
    apply_fun multG (apply_fun multG (apply_fun multG (apply_fun invG c2, c1), apply_fun invG c2), c2)
    = apply_fun multG (apply_fun multG (apply_fun invG c2, c1), apply_fun multG (apply_fun invG c2, c2)).
  { exact (HassocG (apply_fun multG (apply_fun invG c2, c1)) (apply_fun invG c2) c2
      HinvC2_c1_G HinvC2_G Hc2G). }
  claim HinvAxC2 : apply_fun multG (apply_fun invG c2, c2) = eG.
  { exact (andER (apply_fun multG (c2, apply_fun invG c2) = eG)
      (apply_fun multG (apply_fun invG c2, c2) = eG)
      (HinvAxG c2 Hc2G)). }
  claim HidRight : apply_fun multG (apply_fun multG (apply_fun invG c2, c1), eG) =
    apply_fun multG (apply_fun invG c2, c1).
  { exact (andER
      (apply_fun multG (eG, apply_fun multG (apply_fun invG c2, c1)) = apply_fun multG (apply_fun invG c2, c1))
      (apply_fun multG (apply_fun multG (apply_fun invG c2, c1), eG) = apply_fun multG (apply_fun invG c2, c1))
      (HidG (apply_fun multG (apply_fun invG c2, c1)) HinvC2_c1_G)). }
  claim Hfull_simplify :
    apply_fun multG (apply_fun multG (apply_fun invG c2, apply_fun multG (c1, apply_fun invG c2)),
      apply_fun invG (apply_fun invG c2))
    = apply_fun multG (apply_fun invG c2, c1).
  { rewrite HinvInvC2.
    rewrite Hassoc1.
    rewrite Hassoc2.
    rewrite HinvAxC2.
    exact HidRight. }
  claim HinvC2_c1_H0 : apply_fun multG (apply_fun invG c2, c1) :e H0.
  { exact (eq_subst_mem
      (apply_fun multG (apply_fun invG c2, c1))
      (apply_fun multG (apply_fun multG (apply_fun invG c2, apply_fun multG (c1, apply_fun invG c2)),
        apply_fun invG (apply_fun invG c2)))
      H0
      (eq_symm
        (apply_fun multG (apply_fun multG (apply_fun invG c2, apply_fun multG (c1, apply_fun invG c2)),
          apply_fun invG (apply_fun invG c2)))
        (apply_fun multG (apply_fun invG c2, c1))
        Hfull_simplify)
      Hnormal_conj). }
  exact (left_coset_eq_from_N_mem G multG eG invG H0 HgrpG HH0sub c1 c2 Hc1G Hc2G HinvC2_c1_H0). }
(** Define phi **)
set phiFun := fun h:set =>
  left_coset multG
    (Eps_i (fun cls:set => cls :e G /\ apply_fun lc cls = apply_fun h e0))
    H0.
set phi := graph CTG phiFun.
(** Key property: for any CT h, there exists a class in G mapping to h(e0) via lc **)
claim Hphi_cls_exists : forall h:set, h :e CTG ->
  exists cls:set, cls :e G /\ apply_fun lc cls = apply_fun h e0.
{ let h. assume HhCTG.
  claim Hct : covering_transformation E Te B Tb p h.
  { exact (SepE2 (function_space E E) (fun h0:set => covering_transformation E Te B Tb p h0) h HhCTG). }
  claim Hh_fun : function_on h E E.
  { exact (continuous_map_function_on E Te E Te h
      (homeomorphism_continuous E Te E Te h
        (andEL (homeomorphism E Te E Te h) (forall x:set, x :e E -> apply_fun p (apply_fun h x) = apply_fun p x) Hct))). }
  claim HhE_in_E : apply_fun h e0 :e E.
  { exact (Hh_fun e0 He0E). }
  claim HphE : apply_fun p (apply_fun h e0) = apply_fun p e0.
  { exact (andER (homeomorphism E Te E Te h) (forall x:set, x :e E -> apply_fun p (apply_fun h x) = apply_fun p x) Hct e0 He0E). }
  claim HhE_fib : apply_fun h e0 :e {x :e E | apply_fun p x = apply_fun p e0}.
  { exact (SepI E (fun x:set => apply_fun p x = apply_fun p e0) (apply_fun h e0) HhE_in_E HphE). }
  claim Hlc_surj : surjective_map G {x :e E | apply_fun p x = apply_fun p e0} lc.
  { exact (thm54_4_lifting_correspondence_surjective E Te B Tb p e0 Hcov He0E HpcE). }
  exact (andER (function_on lc G {x :e E | apply_fun p x = apply_fun p e0})
    (forall y:set, y :e {x :e E | apply_fun p x = apply_fun p e0} -> exists x:set, x :e G /\ apply_fun lc x = y)
    Hlc_surj (apply_fun h e0) HhE_fib). }
(** Eps_i-selected class is in G with correct lc value **)
claim Hphi_cls_prop : forall h:set, h :e CTG ->
  Eps_i (fun cls:set => cls :e G /\ apply_fun lc cls = apply_fun h e0) :e G /\
  apply_fun lc (Eps_i (fun cls:set => cls :e G /\ apply_fun lc cls = apply_fun h e0)) = apply_fun h e0.
{ let h. assume HhCTG.
  apply (Hphi_cls_exists h HhCTG).
  let cls0. assume Hcls0Pack.
  exact (Eps_i_ax (fun cls:set => cls :e G /\ apply_fun lc cls = apply_fun h e0) cls0 Hcls0Pack). }
(** Eps_i-selected class is in N **)
claim Hphi_cls_in_N : forall h:set, h :e CTG ->
  Eps_i (fun cls:set => cls :e G /\ apply_fun lc cls = apply_fun h e0) :e N.
{ let h. assume HhCTG. exact (Hcls_in_N h HhCTG). }
(** phi maps CTG to QGset **)
claim Hphi_fun : function_on phi CTG QGset.
{ let h. assume HhCTG.
  claim Hphi_h_eq : apply_fun phi h = phiFun h.
  { exact (apply_fun_graph CTG phiFun h HhCTG). }
  claim HclsN : Eps_i (fun cls:set => cls :e G /\ apply_fun lc cls = apply_fun h e0) :e N.
  { exact (Hphi_cls_in_N h HhCTG). }
  rewrite Hphi_h_eq.
  exact (ReplI N (fun g:set => left_coset multG g H0) (Eps_i (fun cls:set => cls :e G /\ apply_fun lc cls = apply_fun h e0)) HclsN). }
witness phi.
apply (group_isomorphism_intro CTG multCTG QGset QGmult phi).
(** Part 1: group_homomorphism **)
- prove group_homomorphism CTG multCTG QGset QGmult phi.
  prove function_on phi CTG QGset /\
    (forall x y:set, x :e CTG -> y :e CTG ->
      apply_fun phi (apply_fun multCTG (x, y)) =
      apply_fun QGmult (apply_fun phi x, apply_fun phi y)).
  apply andI.
  + exact Hphi_fun.
  + (** Homomorphism property **)
    let h1 h2. assume Hh1CTG Hh2CTG.
    (** Extract CT properties for h1 **)
    claim Hh1_ct : covering_transformation E Te B Tb p h1.
    { exact (SepE2 (function_space E E) (fun h:set => covering_transformation E Te B Tb p h) h1 Hh1CTG). }
    claim Hh1_homeo : homeomorphism E Te E Te h1.
    { exact (andEL (homeomorphism E Te E Te h1) (forall x:set, x :e E -> apply_fun p (apply_fun h1 x) = apply_fun p x) Hh1_ct). }
    claim Hh1_pcomm : forall x:set, x :e E -> apply_fun p (apply_fun h1 x) = apply_fun p x.
    { exact (andER (homeomorphism E Te E Te h1) (forall x:set, x :e E -> apply_fun p (apply_fun h1 x) = apply_fun p x) Hh1_ct). }
    claim Hh1_cont : continuous_map E Te E Te h1.
    { exact (homeomorphism_continuous E Te E Te h1 Hh1_homeo). }
    claim Hh1_fun : function_on h1 E E.
    { exact (continuous_map_function_on E Te E Te h1 Hh1_cont). }
    (** Extract CT properties for h2 **)
    claim Hh2_ct : covering_transformation E Te B Tb p h2.
    { exact (SepE2 (function_space E E) (fun h:set => covering_transformation E Te B Tb p h) h2 Hh2CTG). }
    claim Hh2_homeo : homeomorphism E Te E Te h2.
    { exact (andEL (homeomorphism E Te E Te h2) (forall x:set, x :e E -> apply_fun p (apply_fun h2 x) = apply_fun p x) Hh2_ct). }
    claim Hh2_pcomm : forall x:set, x :e E -> apply_fun p (apply_fun h2 x) = apply_fun p x.
    { exact (andER (homeomorphism E Te E Te h2) (forall x:set, x :e E -> apply_fun p (apply_fun h2 x) = apply_fun p x) Hh2_ct). }
    claim Hh2_cont : continuous_map E Te E Te h2.
    { exact (homeomorphism_continuous E Te E Te h2 Hh2_homeo). }
    claim Hh2_fun : function_on h2 E E.
    { exact (continuous_map_function_on E Te E Te h2 Hh2_cont). }
    (** h1(e0), h2(e0) in E **)
    claim Hh1e0E : apply_fun h1 e0 :e E. { exact (Hh1_fun e0 He0E). }
    claim Hh2e0E : apply_fun h2 e0 :e E. { exact (Hh2_fun e0 He0E). }
    (** h1(h2(e0)) in E **)
    claim Hh1h2e0E : apply_fun h1 (apply_fun h2 e0) :e E.
    { exact (Hh1_fun (apply_fun h2 e0) Hh2e0E). }
    (** Composition h12 = compose_fun E h2 h1 is a covering transformation **)
    set h12 := compose_fun E h2 h1.
    claim Hh12_homeo : homeomorphism E Te E Te h12.
    { exact (homeomorphism_compose E Te E Te E Te h2 h1 Hh2_homeo Hh1_homeo). }
    claim Hh12_pcomm : forall x:set, x :e E -> apply_fun p (apply_fun h12 x) = apply_fun p x.
    { let x. assume HxE.
      claim Hcfa : apply_fun h12 x = apply_fun h1 (apply_fun h2 x).
      { exact (compose_fun_apply E h2 h1 x HxE). }
      claim Hh2xE : apply_fun h2 x :e E.
      { exact (Hh2_fun x HxE). }
      rewrite Hcfa.
      rewrite (Hh1_pcomm (apply_fun h2 x) Hh2xE).
      exact (Hh2_pcomm x HxE). }
    claim Hh12_ct : covering_transformation E Te B Tb p h12.
    { prove homeomorphism E Te E Te h12 /\ (forall x:set, x :e E -> apply_fun p (apply_fun h12 x) = apply_fun p x).
      exact (andI (homeomorphism E Te E Te h12) (forall x:set, x :e E -> apply_fun p (apply_fun h12 x) = apply_fun p x) Hh12_homeo Hh12_pcomm). }
    (** h12 is in function_space E E **)
    claim Hh12_fs : h12 :e function_space E E.
    { exact (compose_fun_in_function_space E E E h2 h1 Hh2_fun Hh1_fun). }
    (** h12 is in CTG **)
    claim Hh12CTG : h12 :e CTG.
    { exact (SepI (function_space E E) (fun h:set => covering_transformation E Te B Tb p h) h12 Hh12_fs Hh12_ct). }
    (** multCTG(h1, h2) = h12 **)
    claim Hpair : (h1, h2) :e setprod CTG CTG.
    { exact (tuple_2_setprod_by_pair_Sigma CTG CTG h1 h2 Hh1CTG Hh2CTG). }
    claim HmultCTG_unfold : apply_fun multCTG (h1, h2) = compose_fun E ((h1, h2) 1) ((h1, h2) 0).
    { exact (apply_fun_graph (setprod CTG CTG) (fun pr:set => compose_fun E (pr 1) (pr 0)) (h1, h2) Hpair). }
    (** pr 0 of (h1,h2) = h1, pr 1 of (h1,h2) = h2 **)
    claim Hpr0 : (h1, h2) 0 = h1.
    { exact (tuple_2_0_eq h1 h2). }
    claim Hpr1 : (h1, h2) 1 = h2.
    { exact (tuple_2_1_eq h1 h2). }
    claim HmultCTG_eq : apply_fun multCTG (h1, h2) = h12.
    { rewrite HmultCTG_unfold. rewrite Hpr0. rewrite Hpr1. reflexivity. }
    (** h12(e0) = h1(h2(e0)) **)
    claim Hh12e0 : apply_fun h12 e0 = apply_fun h1 (apply_fun h2 e0).
    { exact (compose_fun_apply E h2 h1 e0 He0E). }
    (** Eps_i classes for h1, h2, h12 **)
    set cls1 := Eps_i (fun cls:set => cls :e G /\ apply_fun lc cls = apply_fun h1 e0).
    set cls2 := Eps_i (fun cls:set => cls :e G /\ apply_fun lc cls = apply_fun h2 e0).
    set cls12 := Eps_i (fun cls:set => cls :e G /\ apply_fun lc cls = apply_fun h12 e0).
    claim Hcls1_prop : cls1 :e G /\ apply_fun lc cls1 = apply_fun h1 e0.
    { exact (Hphi_cls_prop h1 Hh1CTG). }
    claim Hcls2_prop : cls2 :e G /\ apply_fun lc cls2 = apply_fun h2 e0.
    { exact (Hphi_cls_prop h2 Hh2CTG). }
    claim Hcls12_prop : cls12 :e G /\ apply_fun lc cls12 = apply_fun h12 e0.
    { exact (Hphi_cls_prop h12 Hh12CTG). }
    claim Hcls1G : cls1 :e G. { exact (andEL (cls1 :e G) (apply_fun lc cls1 = apply_fun h1 e0) Hcls1_prop). }
    claim Hcls2G : cls2 :e G. { exact (andEL (cls2 :e G) (apply_fun lc cls2 = apply_fun h2 e0) Hcls2_prop). }
    claim Hcls12G : cls12 :e G. { exact (andEL (cls12 :e G) (apply_fun lc cls12 = apply_fun h12 e0) Hcls12_prop). }
    claim Hlc1 : apply_fun lc cls1 = apply_fun h1 e0.
    { exact (andER (cls1 :e G) (apply_fun lc cls1 = apply_fun h1 e0) Hcls1_prop). }
    claim Hlc2 : apply_fun lc cls2 = apply_fun h2 e0.
    { exact (andER (cls2 :e G) (apply_fun lc cls2 = apply_fun h2 e0) Hcls2_prop). }
    claim Hlc12 : apply_fun lc cls12 = apply_fun h12 e0.
    { exact (andER (cls12 :e G) (apply_fun lc cls12 = apply_fun h12 e0) Hcls12_prop). }
    (** cls1, cls2, cls12 in N **)
    claim Hcls1N : cls1 :e N. { exact (Hphi_cls_in_N h1 Hh1CTG). }
    claim Hcls2N : cls2 :e N. { exact (Hphi_cls_in_N h2 Hh2CTG). }
    claim Hcls12N : cls12 :e N. { exact (Hphi_cls_in_N h12 Hh12CTG). }
    (** Unfold phi on both sides **)
    claim Hphi_h1_eq : apply_fun phi h1 = left_coset multG cls1 H0.
    { exact (apply_fun_graph CTG phiFun h1 Hh1CTG). }
    claim Hphi_h2_eq : apply_fun phi h2 = left_coset multG cls2 H0.
    { exact (apply_fun_graph CTG phiFun h2 Hh2CTG). }
    (** phi(multCTG(h1,h2)) = phi(h12) = left_coset cls12 H0 **)
    claim Hphi_h12_eq : apply_fun phi h12 = left_coset multG cls12 H0.
    { exact (apply_fun_graph CTG phiFun h12 Hh12CTG). }
    claim Hphi_mult_eq : apply_fun phi (apply_fun multCTG (h1, h2)) = left_coset multG cls12 H0.
    { rewrite HmultCTG_eq. exact Hphi_h12_eq. }
    (** RHS: QGmult(phi(h1), phi(h2)) = left_coset(multG(cls1, cls2), H0) **)
    claim Hcls1NG : cls1 :e G. { exact (HNsubG cls1 Hcls1N). }
    claim Hcls2NG : cls2 :e G. { exact (HNsubG cls2 Hcls2N). }
    claim HQGmult_eq : apply_fun QGmult (left_coset multG cls1 H0, left_coset multG cls2 H0)
      = left_coset multG (apply_fun multG (cls1, cls2)) H0.
    { exact (quotient_group_mult_on_left_coset_representatives N multG eG invG H0 cls1 cls2 HgrpN HH0normalN Hcls1N Hcls2N). }
    claim HRHS : apply_fun QGmult (apply_fun phi h1, apply_fun phi h2) =
      left_coset multG (apply_fun multG (cls1, cls2)) H0.
    { rewrite Hphi_h1_eq. rewrite Hphi_h2_eq. exact HQGmult_eq. }
    (** multG(cls1, cls2) is in N (since N is a subgroup) **)
    claim Hcls12_prod_N : apply_fun multG (cls1, cls2) :e N.
    { exact (andER
        (N c= G /\ eG :e N)
        (forall x y:set, x :e N -> y :e N -> apply_fun multG (x, y) :e N)
        (andEL
          ((N c= G /\ eG :e N) /\ (forall x y:set, x :e N -> y :e N -> apply_fun multG (x, y) :e N))
          (forall x:set, x :e N -> apply_fun invG x :e N)
          HNsub)
        cls1 cls2 Hcls1N Hcls2N). }
    (** Need: lc(cls12) = lc(multG(cls1, cls2)) **)
    (** lc(cls12) = h12(e0) = h1(h2(e0)) **)
    claim Hlc12_val : apply_fun lc cls12 = apply_fun h1 (apply_fun h2 e0).
    { rewrite Hlc12. exact Hh12e0. }
    (** Now show lc(multG(cls1, cls2)) = h1(h2(e0)) **)
    (** multG(cls1, cls2) = [concat(rep1, rep2)] **)
    set rep1 := Eps_i (fun f:set => f :e cls1).
    set rep2 := Eps_i (fun f:set => f :e cls2).
    claim Hrep1_ls : rep1 :e loop_space B Tb b0.
    { exact (eps_of_fundamental_group_member_in_loop_space B Tb b0 cls1 Hcls1G). }
    claim Hrep2_ls : rep2 :e loop_space B Tb b0.
    { exact (eps_of_fundamental_group_member_in_loop_space B Tb b0 cls2 Hcls2G). }
    claim Hrep1_la : loop_at B Tb b0 rep1.
    { exact (loop_space_has_loop_at B Tb b0 rep1 Hrep1_ls). }
    claim Hrep2_la : loop_at B Tb b0 rep2.
    { exact (loop_space_has_loop_at B Tb b0 rep2 Hrep2_ls). }
    claim Hrep1_cont : continuous_map unit_interval unit_interval_topology B Tb rep1.
    { exact (loop_at_continuous B Tb b0 rep1 Hrep1_la). }
    claim Hrep2_cont : continuous_map unit_interval unit_interval_topology B Tb rep2.
    { exact (loop_at_continuous B Tb b0 rep2 Hrep2_la). }
    claim Hrep1_0 : apply_fun rep1 0 = b0. { exact (loop_at_at_zero B Tb b0 rep1 Hrep1_la). }
    claim Hrep2_0 : apply_fun rep2 0 = b0. { exact (loop_at_at_zero B Tb b0 rep2 Hrep2_la). }
    claim Hrep1_1 : apply_fun rep1 1 = b0. { exact (loop_at_at_one B Tb b0 rep1 Hrep1_la). }
    claim Hrep2_1 : apply_fun rep2 1 = b0. { exact (loop_at_at_one B Tb b0 rep2 Hrep2_la). }
    (** lc unfolds to lift of representative **)
    claim Hlc1_unfold : apply_fun lc cls1 = apply_fun (path_lift E Te B Tb p e0 rep1) 1.
    { exact (apply_fun_graph G
        (fun clsX:set => apply_fun (path_lift E Te B Tb p e0 (Eps_i (fun f:set => f :e clsX))) 1)
        cls1 Hcls1G). }
    claim Hlc2_unfold : apply_fun lc cls2 = apply_fun (path_lift E Te B Tb p e0 rep2) 1.
    { exact (apply_fun_graph G
        (fun clsX:set => apply_fun (path_lift E Te B Tb p e0 (Eps_i (fun f:set => f :e clsX))) 1)
        cls2 Hcls2G). }
    (** lift(e0, rep1)(1) = h1(e0) **)
    claim Hlift1_end : apply_fun (path_lift E Te B Tb p e0 rep1) 1 = apply_fun h1 e0.
    { rewrite <- Hlc1_unfold. exact Hlc1. }
    (** lift(e0, rep2)(1) = h2(e0) **)
    claim Hlift2_end : apply_fun (path_lift E Te B Tb p e0 rep2) 1 = apply_fun h2 e0.
    { rewrite <- Hlc2_unfold. exact Hlc2. }
    (** concat(rep1, rep2) **)
    set gamma := path_concat rep1 rep2.
    claim Hmatch : apply_fun rep1 1 = apply_fun rep2 0.
    { rewrite Hrep1_1. rewrite Hrep2_0. reflexivity. }
    claim Hpe0_rep1 : apply_fun p e0 = apply_fun rep1 0.
    { rewrite Hrep1_0. exact (eq_refl b0). }
    (** path_lift_concat_endpoint: lift(e0, concat(rep1,rep2))(1) = lift(lift(e0,rep1)(1), rep2)(1) **)
    claim Hconcat_lift_eq : apply_fun (path_lift E Te B Tb p e0 gamma) 1
      = apply_fun (path_lift E Te B Tb p (apply_fun (path_lift E Te B Tb p e0 rep1) 1) rep2) 1.
    { exact (path_lift_concat_endpoint E Te B Tb p e0 rep1 rep2 Hcov He0E Hrep1_cont Hrep2_cont Hmatch Hpe0_rep1). }
    (** lift(h1(e0), rep2)(1) = h1(lift(e0, rep2)(1)) by CT transport **)
    claim Hpe0_rep2 : apply_fun p e0 = apply_fun rep2 0.
    { rewrite Hrep2_0. exact (eq_refl b0). }
    claim Htransport : apply_fun (path_lift E Te B Tb p (apply_fun h1 e0) rep2) 1 =
      apply_fun h1 (apply_fun (path_lift E Te B Tb p e0 rep2) 1).
    { exact (covering_transformation_path_lift_transport E Te B Tb p e0 rep2 h1
        Hcov He0E Hrep2_cont Hh1_ct Hpe0_rep2 1 one_in_unit_interval). }
    (** Combine: lift(e0, gamma)(1) = h1(h2(e0)) **)
    claim Hconcat_lift_val : apply_fun (path_lift E Te B Tb p e0 gamma) 1 = apply_fun h1 (apply_fun h2 e0).
    { rewrite Hconcat_lift_eq. rewrite Hlift1_end. rewrite Htransport. rewrite Hlift2_end. reflexivity. }
    (** lc of product class = lift(e0, gamma)(1) via monodromy **)
    (** multG(cls1, cls2) = [concat(Eps_i(f in (cls1,cls2) 0), Eps_i(g in (cls1,cls2) 1))] **)
    claim Hcls_pair : (cls1, cls2) :e setprod G G.
    { exact (tuple_2_setprod_by_pair_Sigma G G cls1 cls2 Hcls1G Hcls2G). }
    claim HmultG_raw : apply_fun multG (cls1, cls2) =
      path_homotopy_class_loop B Tb b0
        (path_concat (Eps_i (fun f:set => f :e (cls1, cls2) 0))
                     (Eps_i (fun g:set => g :e (cls1, cls2) 1))).
    { exact (fundamental_group_mult_apply B Tb b0 (cls1, cls2) Hcls_pair). }
    (** (cls1,cls2) 0 = cls1, (cls1,cls2) 1 = cls2 **)
    claim Hcls_pr0 : (cls1, cls2) 0 = cls1.
    { exact (tuple_2_0_eq cls1 cls2). }
    claim Hcls_pr1 : (cls1, cls2) 1 = cls2.
    { exact (tuple_2_1_eq cls1 cls2). }
    claim HmultG_class : apply_fun multG (cls1, cls2) =
      path_homotopy_class_loop B Tb b0 gamma.
    { rewrite HmultG_raw. rewrite Hcls_pr0. rewrite Hcls_pr1. reflexivity. }
    (** Now lc(multG(cls1, cls2)) = lc([gamma]) **)
    claim HprodG : apply_fun multG (cls1, cls2) :e G.
    { exact (HNsubG (apply_fun multG (cls1, cls2)) Hcls12_prod_N). }
    claim Hlc_prod_unfold : apply_fun lc (apply_fun multG (cls1, cls2)) =
      apply_fun (path_lift E Te B Tb p e0
        (Eps_i (fun f:set => f :e apply_fun multG (cls1, cls2)))) 1.
    { exact (apply_fun_graph G
        (fun clsX:set => apply_fun (path_lift E Te B Tb p e0 (Eps_i (fun f:set => f :e clsX))) 1)
        (apply_fun multG (cls1, cls2)) HprodG). }
    (** The Eps_i-selected representative of [gamma] is homotopic to gamma **)
    set rep_prod := Eps_i (fun f:set => f :e apply_fun multG (cls1, cls2)).
    claim Hgamma_ls : gamma :e loop_space B Tb b0.
    { exact (path_concat_preserves_loop_space_early B Tb b0 rep1 rep2 Hrep1_ls Hrep2_ls). }
    claim Hgamma_in_class : gamma :e path_homotopy_class_loop B Tb b0 gamma.
    { exact (loop_in_own_class_early B Tb b0 gamma HtopB Hgamma_ls). }
    claim Hgamma_in_prod : gamma :e apply_fun multG (cls1, cls2).
    { exact (mem_eqL gamma (apply_fun multG (cls1, cls2)) (path_homotopy_class_loop B Tb b0 gamma) HmultG_class Hgamma_in_class). }
    claim Hrep_prod_in_class : rep_prod :e apply_fun multG (cls1, cls2).
    { exact (Eps_i_ax (fun f:set => f :e apply_fun multG (cls1, cls2)) gamma Hgamma_in_prod). }
    claim Hrep_prod_in_phcl : rep_prod :e path_homotopy_class_loop B Tb b0 gamma.
    { exact (mem_eqR rep_prod (apply_fun multG (cls1, cls2)) (path_homotopy_class_loop B Tb b0 gamma) HmultG_class Hrep_prod_in_class). }
    claim Hph_gamma_rep : path_homotopic B Tb b0 b0 gamma rep_prod.
    { exact (SepE2 (loop_space B Tb b0) (fun g:set => path_homotopic B Tb b0 b0 gamma g) rep_prod Hrep_prod_in_phcl). }
    (** By monodromy: lift(e0, gamma)(1) = lift(e0, rep_prod)(1) **)
    claim Hmonodromy : apply_fun (path_lift E Te B Tb p e0 gamma) 1 =
      apply_fun (path_lift E Te B Tb p e0 rep_prod) 1.
    { exact (andEL
        (apply_fun (path_lift E Te B Tb p e0 gamma) 1 = apply_fun (path_lift E Te B Tb p e0 rep_prod) 1)
        (path_homotopic E Te e0 (apply_fun (path_lift E Te B Tb p e0 gamma) 1)
          (path_lift E Te B Tb p e0 gamma) (path_lift E Te B Tb p e0 rep_prod))
        (thm54_3_homotopic_lifts E Te B Tb p e0 b0 b0 gamma rep_prod Hcov He0E (eq_refl b0) Hph_gamma_rep)). }
    (** lc(multG(cls1,cls2)) = lift(e0, rep_prod)(1) = lift(e0, gamma)(1) = h1(h2(e0)) **)
    claim Hlc_prod_val : apply_fun lc (apply_fun multG (cls1, cls2)) = apply_fun h1 (apply_fun h2 e0).
    { rewrite Hlc_prod_unfold.
      rewrite <- Hmonodromy.
      exact Hconcat_lift_val. }
    (** Now both coset representatives have the same lc value **)
    (** lc(cls12) = h1(h2(e0)) and lc(multG(cls1,cls2)) = h1(h2(e0)) **)
    claim Hlc_eq : apply_fun lc cls12 = apply_fun lc (apply_fun multG (cls1, cls2)).
    { rewrite Hlc12_val. rewrite Hlc_prod_val. reflexivity. }
    claim Hcoset_eq : left_coset multG cls12 H0 = left_coset multG (apply_fun multG (cls1, cls2)) H0.
    { exact (Hsame_lc_same_coset cls12 (apply_fun multG (cls1, cls2)) Hcls12N Hcls12_prod_N Hlc_eq). }
    rewrite Hphi_mult_eq. rewrite HRHS. exact Hcoset_eq.
(** Part 2: bijection **)
- prove bijection CTG QGset phi.
  prove function_on phi CTG QGset /\
    (forall y:set, y :e QGset ->
      exists x:set, x :e CTG /\ apply_fun phi x = y /\
        (forall x':set, x' :e CTG -> apply_fun phi x' = y -> x' = x)).
  apply andI.
  + exact Hphi_fun.
  + let c. assume HcQG.
    (** c = left_coset multG g H0 for some g :e N **)
    (** Extract g :e N with c = left_coset g H0 **)
    claim HcRepl : c :e {left_coset multG g H0 | g :e N}.
    { exact HcQG. }
    apply (ReplE_impred N (fun g:set => left_coset multG g H0) c HcRepl).
    let g. assume HgN.
    assume Hc_eq : c = left_coset multG g H0.
    claim HgG : g :e G. { exact (HNsubG g HgN). }
    (** lc(g) is in fiber **)
    claim Hlcg_fib : apply_fun lc g :e {x :e E | apply_fun p x = apply_fun p e0}.
    { exact (lifting_correspondence_in_fiber E Te B Tb p e0 g Hcov He0E HgG). }
    claim Hlcg_E : apply_fun lc g :e E.
    { exact (SepE1 E (fun x:set => apply_fun p x = apply_fun p e0) (apply_fun lc g) Hlcg_fib). }
    claim Hlcg_fib_eq : apply_fun p (apply_fun lc g) = apply_fun p e0.
    { exact (SepE2 E (fun x:set => apply_fun p x = apply_fun p e0) (apply_fun lc g) Hlcg_fib). }
    (** Existence of CT h with h(e0) = lc(g) **)
    claim Hct_ex : exists h:set, covering_transformation E Te B Tb p h /\ apply_fun h e0 = apply_fun lc g.
    { (** Use backward direction of lemma81_1_image_of_psi **)
      (** The iff has low precedence: left side includes e1 :e E -> p(e1) = p(e0) -> exists h, ... **)
      set e1_tgt := apply_fun lc g.
      claim Hright : forall alpha:set,
        loop_at B Tb b0 alpha ->
        apply_fun (path_lift E Te B Tb p e0 alpha) 1 = e1_tgt ->
        path_homotopy_class_loop B Tb b0 alpha :e N.
      { let alpha. assume HalphaLoop Hlift_end_alpha.
        set cls_alpha := path_homotopy_class_loop B Tb b0 alpha.
        claim HalphaG : cls_alpha :e G.
        { exact (loop_at_implies_fundamental_group_member B Tb b0 alpha HtopB Hb0B HalphaLoop). }
        (** Get a loop_space representative f1 of [alpha] **)
        claim Hf1_ex : exists f1:set, f1 :e loop_space B Tb b0 /\ cls_alpha = path_homotopy_class_loop B Tb b0 f1.
        { exact (fundamental_group_member_has_representative B Tb b0 cls_alpha HalphaG). }
        apply Hf1_ex. let f1. assume Hf1Pack.
        claim Hf1_ls : f1 :e loop_space B Tb b0.
        { exact (andEL (f1 :e loop_space B Tb b0) (cls_alpha = path_homotopy_class_loop B Tb b0 f1) Hf1Pack). }
        claim Hcls_eq_f1 : cls_alpha = path_homotopy_class_loop B Tb b0 f1.
        { exact (andER (f1 :e loop_space B Tb b0) (cls_alpha = path_homotopy_class_loop B Tb b0 f1) Hf1Pack). }
        (** f1 :e [alpha], so alpha and f1 are path-homotopic **)
        claim Hf1_in_cls : f1 :e cls_alpha.
        { rewrite Hcls_eq_f1. exact (loop_in_own_class_early B Tb b0 f1 HtopB Hf1_ls). }
        claim Hph_alpha_f1 : path_homotopic B Tb b0 b0 alpha f1.
        { exact (path_homotopy_class_loop_has_homotopy B Tb b0 alpha f1 Hf1_in_cls). }
        (** By monodromy: lift(e0, alpha)(1) = lift(e0, f1)(1) **)
        claim Hlift_eq_f1 : apply_fun (path_lift E Te B Tb p e0 alpha) 1
          = apply_fun (path_lift E Te B Tb p e0 f1) 1.
        { exact (andEL
            (apply_fun (path_lift E Te B Tb p e0 alpha) 1 = apply_fun (path_lift E Te B Tb p e0 f1) 1)
            (path_homotopic E Te e0 (apply_fun (path_lift E Te B Tb p e0 alpha) 1)
              (path_lift E Te B Tb p e0 alpha) (path_lift E Te B Tb p e0 f1))
            (thm54_3_homotopic_lifts E Te B Tb p e0 b0 b0 alpha f1
              Hcov He0E (eq_refl b0) Hph_alpha_f1)). }
        claim Hlift_f1_end : apply_fun (path_lift E Te B Tb p e0 f1) 1 = e1_tgt.
        { claim H : e1_tgt = apply_fun (path_lift E Te B Tb p e0 f1) 1.
          { transitivity (apply_fun (path_lift E Te B Tb p e0 alpha) 1).
            - exact (eq_symm (apply_fun (path_lift E Te B Tb p e0 alpha) 1) e1_tgt Hlift_end_alpha).
            - exact Hlift_eq_f1. }
          exact (eq_symm e1_tgt (apply_fun (path_lift E Te B Tb p e0 f1) 1) H). }
        (** Get eps_g = Eps_i(f :e g), representative of g **)
        set eps_g := Eps_i (fun f0:set => f0 :e g).
        claim Heps_g_ls : eps_g :e loop_space B Tb b0.
        { exact (eps_of_fundamental_group_member_in_loop_space B Tb b0 g HgG). }
        claim Hf1_la : loop_at B Tb b0 f1.
        { exact (loop_space_has_loop_at B Tb b0 f1 Hf1_ls). }
        claim Heps_g_la : loop_at B Tb b0 eps_g.
        { exact (loop_space_has_loop_at B Tb b0 eps_g Heps_g_ls). }
        claim Hf1_cont : continuous_map unit_interval unit_interval_topology B Tb f1.
        { exact (loop_at_continuous B Tb b0 f1 Hf1_la). }
        claim Heps_g_cont : continuous_map unit_interval unit_interval_topology B Tb eps_g.
        { exact (loop_at_continuous B Tb b0 eps_g Heps_g_la). }
        claim Hf1_0 : apply_fun f1 0 = b0. { exact (loop_at_at_zero B Tb b0 f1 Hf1_la). }
        claim Hf1_1 : apply_fun f1 1 = b0. { exact (loop_at_at_one B Tb b0 f1 Hf1_la). }
        claim Heps_g_0 : apply_fun eps_g 0 = b0. { exact (loop_at_at_zero B Tb b0 eps_g Heps_g_la). }
        claim Heps_g_1 : apply_fun eps_g 1 = b0. { exact (loop_at_at_one B Tb b0 eps_g Heps_g_la). }
        (** Reverse path and delta2 **)
        claim Hrev_g_cont : continuous_map unit_interval unit_interval_topology B Tb (reverse_path eps_g).
        { exact (reverse_path_continuous B Tb eps_g Heps_g_cont). }
        claim Hrev_g_ls : reverse_path eps_g :e loop_space B Tb b0.
        { exact (reverse_path_preserves_loop_space_early B Tb b0 eps_g Heps_g_ls). }
        set delta2 := path_concat f1 (reverse_path eps_g).
        claim Hdelta2_ls : delta2 :e loop_space B Tb b0.
        { exact (path_concat_preserves_loop_space_early B Tb b0 f1 (reverse_path eps_g)
            Hf1_ls Hrev_g_ls). }
        claim Hdelta2_la : loop_at B Tb b0 delta2.
        { exact (loop_space_has_loop_at B Tb b0 delta2 Hdelta2_ls). }
        claim Hdelta2_cont : continuous_map unit_interval unit_interval_topology B Tb delta2.
        { exact (loop_at_continuous B Tb b0 delta2 Hdelta2_la). }
        (** Lift delta2 **)
        claim Hpe0d2 : apply_fun p e0 = apply_fun delta2 0.
        { claim Hd0 : apply_fun delta2 0 = b0.
          { exact (loop_at_at_zero B Tb b0 delta2 Hdelta2_la). }
          rewrite Hd0. exact (eq_refl b0). }
        set gamma2 := path_lift E Te B Tb p e0 delta2.
        claim Hlift_data2 : (continuous_map unit_interval unit_interval_topology E Te gamma2 /\
          apply_fun gamma2 0 = e0) /\
          (forall t:set, t :e unit_interval ->
            apply_fun p (apply_fun gamma2 t) = apply_fun delta2 t).
        { exact (lemma54_1_path_lifting E Te B Tb p e0 delta2 Hcov He0E Hpe0d2 Hdelta2_cont). }
        claim Hgamma2_cont : continuous_map unit_interval unit_interval_topology E Te gamma2.
        { exact (andEL (continuous_map unit_interval unit_interval_topology E Te gamma2)
            (apply_fun gamma2 0 = e0)
            (andEL (continuous_map unit_interval unit_interval_topology E Te gamma2 /\ apply_fun gamma2 0 = e0)
              (forall t:set, t :e unit_interval -> apply_fun p (apply_fun gamma2 t) = apply_fun delta2 t)
              Hlift_data2)). }
        claim Hgamma2_0 : apply_fun gamma2 0 = e0.
        { exact (andER (continuous_map unit_interval unit_interval_topology E Te gamma2)
            (apply_fun gamma2 0 = e0)
            (andEL (continuous_map unit_interval unit_interval_topology E Te gamma2 /\ apply_fun gamma2 0 = e0)
              (forall t:set, t :e unit_interval -> apply_fun p (apply_fun gamma2 t) = apply_fun delta2 t)
              Hlift_data2)). }
        claim Hgamma2_comm : forall t:set, t :e unit_interval ->
          apply_fun p (apply_fun gamma2 t) = apply_fun delta2 t.
        { exact (andER
            (continuous_map unit_interval unit_interval_topology E Te gamma2 /\ apply_fun gamma2 0 = e0)
            (forall t:set, t :e unit_interval -> apply_fun p (apply_fun gamma2 t) = apply_fun delta2 t)
            Hlift_data2). }
        (** Show gamma2(1) = e0 **)
        claim Hlcg_unfold : apply_fun lc g = apply_fun (path_lift E Te B Tb p e0 eps_g) 1.
        { exact (apply_fun_graph G
            (fun clsX:set => apply_fun (path_lift E Te B Tb p e0 (Eps_i (fun f0:set => f0 :e clsX))) 1)
            g HgG). }
        claim Hlift_f1_epsg_eq : apply_fun (path_lift E Te B Tb p e0 f1) 1
          = apply_fun (path_lift E Te B Tb p e0 eps_g) 1.
        { transitivity e1_tgt.
          - exact Hlift_f1_end.
          - exact Hlcg_unfold. }
        claim Hf1_match_rev : apply_fun f1 1 = apply_fun (reverse_path eps_g) 0.
        { rewrite Hf1_1. rewrite (reverse_path_at_zero eps_g). rewrite Heps_g_1.
          reflexivity. }
        claim Hpe0_f1 : apply_fun p e0 = apply_fun f1 0.
        { rewrite Hf1_0. exact (eq_refl b0). }
        claim Hconcat_end2 :
          apply_fun gamma2 1
          = apply_fun (path_lift E Te B Tb p (apply_fun (path_lift E Te B Tb p e0 f1) 1) (reverse_path eps_g)) 1.
        { exact (path_lift_concat_endpoint E Te B Tb p e0 f1 (reverse_path eps_g)
            Hcov He0E Hf1_cont Hrev_g_cont Hf1_match_rev Hpe0_f1). }
        claim Hconcat_sub2 :
          apply_fun (path_lift E Te B Tb p (apply_fun (path_lift E Te B Tb p e0 f1) 1) (reverse_path eps_g)) 1
          = apply_fun (path_lift E Te B Tb p (apply_fun (path_lift E Te B Tb p e0 eps_g) 1) (reverse_path eps_g)) 1.
        { rewrite Hlift_f1_epsg_eq. reflexivity. }
        claim Hpe0_epsg : apply_fun p e0 = apply_fun eps_g 0.
        { rewrite Heps_g_0. exact (eq_refl b0). }
        claim Hrev_end2 :
          apply_fun (path_lift E Te B Tb p (apply_fun (path_lift E Te B Tb p e0 eps_g) 1) (reverse_path eps_g)) 1 = e0.
        { exact (path_lift_reverse_endpoint E Te B Tb p e0 eps_g
            Hcov He0E Heps_g_cont Hpe0_epsg). }
        claim Hgamma2_1_e0 : apply_fun gamma2 1 = e0.
        { transitivity (apply_fun (path_lift E Te B Tb p (apply_fun (path_lift E Te B Tb p e0 f1) 1) (reverse_path eps_g)) 1).
          - exact Hconcat_end2.
          - transitivity (apply_fun (path_lift E Te B Tb p (apply_fun (path_lift E Te B Tb p e0 eps_g) 1) (reverse_path eps_g)) 1).
            + exact Hconcat_sub2.
            + exact Hrev_end2. }
        (** gamma2 is a loop at e0 **)
        claim Hgamma2_la : loop_at E Te e0 gamma2.
        { exact (loop_at_pack_right E Te e0 gamma2
            (andI (continuous_map unit_interval unit_interval_topology E Te gamma2)
              (apply_fun gamma2 0 = e0 /\ apply_fun gamma2 1 = e0)
              Hgamma2_cont
              (andI (apply_fun gamma2 0 = e0) (apply_fun gamma2 1 = e0)
                Hgamma2_0 Hgamma2_1_e0))). }
        claim Hgamma2_ls : gamma2 :e loop_space E Te e0.
        { claim Hgamma2_fs : gamma2 :e function_space unit_interval E.
          { exact (total_function_space_sub_function_space unit_interval E gamma2
              (continuous_map_in_total_function_space_plain unit_interval unit_interval_topology E Te gamma2 Hgamma2_cont)). }
          exact (SepI (function_space unit_interval E) (fun f:set => loop_at E Te e0 f) gamma2 Hgamma2_fs Hgamma2_la). }
        claim Hgamma2_FG : path_homotopy_class_loop E Te e0 gamma2 :e fundamental_group E Te e0.
        { exact (loop_at_implies_fundamental_group_member E Te e0 gamma2 HtopE He0E Hgamma2_la). }
        (** [delta2] :e H0 via induced_homomorphism **)
        set pof2 := compose_fun unit_interval gamma2 p.
        claim Hpof2_cont : continuous_map unit_interval unit_interval_topology B Tb pof2.
        { exact (composition_continuous unit_interval unit_interval_topology E Te B Tb
            gamma2 p Hgamma2_cont Hp_cont). }
        claim Hpof2_0 : apply_fun pof2 0 = b0.
        { claim H : apply_fun pof2 0 = apply_fun p (apply_fun gamma2 0).
          { exact (compose_fun_apply unit_interval gamma2 p 0 zero_in_unit_interval). }
          rewrite H. rewrite Hgamma2_0. exact (eq_refl b0). }
        claim Hpof2_1 : apply_fun pof2 1 = b0.
        { claim H : apply_fun pof2 1 = apply_fun p (apply_fun gamma2 1).
          { exact (compose_fun_apply unit_interval gamma2 p 1 one_in_unit_interval). }
          rewrite H. rewrite Hgamma2_1_e0. exact (eq_refl b0). }
        claim Hpof2_delta2_htpy : path_homotopic B Tb b0 b0 pof2 delta2.
        { claim Hpointwise : forall s:set, s :e unit_interval -> apply_fun pof2 s = apply_fun delta2 s.
          { let s. assume Hs.
            claim Hcomp : apply_fun pof2 s = apply_fun p (apply_fun gamma2 s).
            { exact (compose_fun_apply unit_interval gamma2 p s Hs). }
            rewrite Hcomp. exact (Hgamma2_comm s Hs). }
          claim Hdelta2_0 : apply_fun delta2 0 = b0.
          { exact (loop_at_at_zero B Tb b0 delta2 Hdelta2_la). }
          claim Hdelta2_1 : apply_fun delta2 1 = b0.
          { exact (loop_at_at_one B Tb b0 delta2 Hdelta2_la). }
          exact (path_homotopic_of_pointwise_equal B Tb b0 b0 pof2 delta2
            Hpof2_cont Hdelta2_cont Hpof2_0 Hpof2_1 Hdelta2_0 Hdelta2_1 Hpointwise). }
        claim Hpof2_delta2_cls : path_homotopy_class_loop B Tb b0 pof2 = path_homotopy_class_loop B Tb b0 delta2.
        { exact (path_homotopy_class_loop_eq_of_path_homotopic B Tb b0 pof2 delta2 Hpof2_delta2_htpy). }
        claim Hpof2_H0 : path_homotopy_class_loop B Tb b0 pof2 :e H0.
        { claim Hphi0_eq : apply_fun (induced_homomorphism E Te e0 B Tb b0 p)
              (path_homotopy_class_loop E Te e0 gamma2)
              = path_homotopy_class_loop B Tb b0 pof2.
          { claim Hih : apply_fun (induced_homomorphism E Te e0 B Tb b0 p)
                (path_homotopy_class_loop E Te e0 gamma2)
                = path_homotopy_class_loop B Tb b0
                  (compose_fun unit_interval (Eps_i (fun w:set => w :e path_homotopy_class_loop E Te e0 gamma2)) p).
            { exact (induced_homomorphism_apply_on_loop_class E Te e0 B Tb b0 p gamma2 Hgamma2_ls). }
            rewrite Hih.
            set eps_g2 := Eps_i (fun w:set => w :e path_homotopy_class_loop E Te e0 gamma2).
            claim Heps_in : eps_g2 :e path_homotopy_class_loop E Te e0 gamma2.
            { exact (Eps_i_ax (fun w:set => w :e path_homotopy_class_loop E Te e0 gamma2) gamma2
                (loop_in_own_path_homotopy_class E Te e0 gamma2 Hgamma2_ls)). }
            claim Heps_htpy : path_homotopic E Te e0 e0 gamma2 eps_g2.
            { exact (path_homotopy_class_loop_has_homotopy E Te e0 gamma2 eps_g2 Heps_in). }
            claim Hpost : path_homotopic B Tb b0 b0
              (compose_fun unit_interval gamma2 p) (compose_fun unit_interval eps_g2 p).
            { exact (path_homotopic_postcompose E Te B Tb e0 e0 b0 b0 gamma2 eps_g2 p
                Heps_htpy Hp_cont (eq_refl b0) (eq_refl b0)). }
            exact (eq_symm
              (path_homotopy_class_loop B Tb b0 pof2)
              (path_homotopy_class_loop B Tb b0 (compose_fun unit_interval eps_g2 p))
              (path_homotopy_class_loop_eq_of_path_homotopic B Tb b0
                pof2 (compose_fun unit_interval eps_g2 p) Hpost)). }
          exact (eq_subst_mem
            (path_homotopy_class_loop B Tb b0 pof2)
            (apply_fun (induced_homomorphism E Te e0 B Tb b0 p) (path_homotopy_class_loop E Te e0 gamma2))
            H0
            (eq_symm (apply_fun (induced_homomorphism E Te e0 B Tb b0 p)
              (path_homotopy_class_loop E Te e0 gamma2))
              (path_homotopy_class_loop B Tb b0 pof2) Hphi0_eq)
            (ReplI (fundamental_group E Te e0)
              (fun cls:set => apply_fun (induced_homomorphism E Te e0 B Tb b0 p) cls)
              (path_homotopy_class_loop E Te e0 gamma2) Hgamma2_FG)). }
        claim Hdelta2_H0 : path_homotopy_class_loop B Tb b0 delta2 :e H0.
        { exact (eq_subst_mem
            (path_homotopy_class_loop B Tb b0 delta2)
            (path_homotopy_class_loop B Tb b0 pof2)
            H0
            (eq_symm (path_homotopy_class_loop B Tb b0 pof2)
              (path_homotopy_class_loop B Tb b0 delta2) Hpof2_delta2_cls)
            Hpof2_H0). }
        (** [delta2] = [f1] mult inv(g) = [alpha] mult inv(g) **)
        claim Hconcat_class : path_homotopy_class_loop B Tb b0 delta2
          = apply_fun multG (path_homotopy_class_loop B Tb b0 f1,
              path_homotopy_class_loop B Tb b0 (reverse_path eps_g)).
        { exact (path_homotopy_class_loop_concat_eq_mult B Tb b0 f1 (reverse_path eps_g)
            Hf1_ls Hrev_g_ls). }
        claim Hf1_class_eq : cls_alpha = path_homotopy_class_loop B Tb b0 f1.
        { exact Hcls_eq_f1. }
        claim Hsym_f1 : path_homotopy_class_loop B Tb b0 f1 = cls_alpha.
        { exact (eq_symm cls_alpha (path_homotopy_class_loop B Tb b0 f1) Hcls_eq_f1). }
        claim Hinv_g_eq : apply_fun invG g = path_homotopy_class_loop B Tb b0 (reverse_path eps_g).
        { exact (fundamental_group_inv_apply B Tb b0 g HgG). }
        claim Hsym_inv : path_homotopy_class_loop B Tb b0 (reverse_path eps_g) = apply_fun invG g.
        { exact (eq_symm (apply_fun invG g) (path_homotopy_class_loop B Tb b0 (reverse_path eps_g)) Hinv_g_eq). }
        claim Hdelta2_eq_prod : path_homotopy_class_loop B Tb b0 delta2
          = apply_fun multG (cls_alpha, apply_fun invG g).
        { rewrite Hconcat_class. rewrite Hsym_f1. rewrite Hsym_inv. reflexivity. }
        claim Hprod_H0 : apply_fun multG (cls_alpha, apply_fun invG g) :e H0.
        { exact (eq_subst_mem
            (apply_fun multG (cls_alpha, apply_fun invG g))
            (path_homotopy_class_loop B Tb b0 delta2)
            H0
            (eq_symm (path_homotopy_class_loop B Tb b0 delta2)
              (apply_fun multG (cls_alpha, apply_fun invG g)) Hdelta2_eq_prod)
            Hdelta2_H0). }
        (** [alpha] mult inv(g) :e N via H0 c= N **)
        claim Hprod_N : apply_fun multG (cls_alpha, apply_fun invG g) :e N.
        { exact (HH0subN (apply_fun multG (cls_alpha, apply_fun invG g)) Hprod_H0). }
        (** N is closed under multiplication **)
        claim HNmult_cl : forall x y:set, x :e N -> y :e N -> apply_fun multG (x, y) :e N.
        { exact (andER
            (N c= G /\ eG :e N)
            (forall x y:set, x :e N -> y :e N -> apply_fun multG (x, y) :e N)
            (andEL
              ((N c= G /\ eG :e N) /\ (forall x y:set, x :e N -> y :e N -> apply_fun multG (x, y) :e N))
              (forall x:set, x :e N -> apply_fun invG x :e N)
              HNsub)). }
        (** [alpha] = ([alpha] mult inv(g)) mult g :e N **)
        claim HinvgG : apply_fun invG g :e G. { exact (HinvG_cl g HgG). }
        claim Hprod_g_N : apply_fun multG (apply_fun multG (cls_alpha, apply_fun invG g), g) :e N.
        { exact (HNmult_cl (apply_fun multG (cls_alpha, apply_fun invG g)) g Hprod_N HgN). }
        claim Hassoc_eq : apply_fun multG (apply_fun multG (cls_alpha, apply_fun invG g), g)
          = apply_fun multG (cls_alpha, apply_fun multG (apply_fun invG g, g)).
        { exact (HassocG cls_alpha (apply_fun invG g) g HalphaG HinvgG HgG). }
        claim HinvAxg : apply_fun multG (apply_fun invG g, g) = eG.
        { exact (andER (apply_fun multG (g, apply_fun invG g) = eG)
            (apply_fun multG (apply_fun invG g, g) = eG)
            (HinvAxG g HgG)). }
        claim HidRight_alpha : apply_fun multG (cls_alpha, eG) = cls_alpha.
        { exact (andER
            (apply_fun multG (eG, cls_alpha) = cls_alpha)
            (apply_fun multG (cls_alpha, eG) = cls_alpha)
            (HidG cls_alpha HalphaG)). }
        claim Halpha_eq_prod : cls_alpha = apply_fun multG (apply_fun multG (cls_alpha, apply_fun invG g), g).
        { rewrite Hassoc_eq. rewrite HinvAxg.
          exact (eq_symm (apply_fun multG (cls_alpha, eG)) cls_alpha HidRight_alpha). }
        exact (eq_subst_mem cls_alpha
          (apply_fun multG (apply_fun multG (cls_alpha, apply_fun invG g), g))
          N Halpha_eq_prod Hprod_g_N). }
      claim Hleft_full : e1_tgt :e E -> apply_fun p e1_tgt = apply_fun p e0 ->
        exists h:set, covering_transformation E Te B Tb p h /\ apply_fun h e0 = e1_tgt.
      { exact (iffER
          (e1_tgt :e E -> apply_fun p e1_tgt = apply_fun p e0 ->
            exists h:set, covering_transformation E Te B Tb p h /\ apply_fun h e0 = e1_tgt)
          (forall alpha:set,
            loop_at B Tb (apply_fun p e0) alpha ->
            apply_fun (path_lift E Te B Tb p e0 alpha) 1 = e1_tgt ->
            path_homotopy_class_loop B Tb (apply_fun p e0) alpha :e
              normalizer H0 G multG eG invG)
          (lemma81_1_image_of_psi E Te B Tb p e0 Hcov He0E HpcE HlpE e1_tgt)
          Hright). }
      exact (Hleft_full Hlcg_E Hlcg_fib_eq). }
    apply Hct_ex. let h. assume HhPack.
    claim Hh_ct : covering_transformation E Te B Tb p h.
    { exact (andEL (covering_transformation E Te B Tb p h) (apply_fun h e0 = apply_fun lc g) HhPack). }
    claim Hh_e0 : apply_fun h e0 = apply_fun lc g.
    { exact (andER (covering_transformation E Te B Tb p h) (apply_fun h e0 = apply_fun lc g) HhPack). }
    (** h is in CTG **)
    claim Hh_homeo : homeomorphism E Te E Te h.
    { exact (andEL (homeomorphism E Te E Te h) (forall x:set, x :e E -> apply_fun p (apply_fun h x) = apply_fun p x) Hh_ct). }
    claim Hh_cont : continuous_map E Te E Te h.
    { exact (homeomorphism_continuous E Te E Te h Hh_homeo). }
    claim Hh_fun_on : function_on h E E.
    { exact (continuous_map_function_on E Te E Te h Hh_cont). }
    claim HhCTG : h :e CTG.
    { claim Hh_fs : h :e function_space E E.
      { exact (total_function_space_sub_function_space E E h
          (continuous_map_in_total_function_space_plain E Te E Te h Hh_cont)). }
      exact (SepI (function_space E E) (fun h0:set => covering_transformation E Te B Tb p h0) h Hh_fs Hh_ct). }
    (** phi(h) = left_coset cls_h H0 where lc(cls_h) = h(e0) = lc(g) **)
    claim Hphi_h_eq : apply_fun phi h = phiFun h.
    { exact (apply_fun_graph CTG phiFun h HhCTG). }
    set cls_h := Eps_i (fun cls:set => cls :e G /\ apply_fun lc cls = apply_fun h e0).
    claim Hcls_h_prop : cls_h :e G /\ apply_fun lc cls_h = apply_fun h e0.
    { exact (Hphi_cls_prop h HhCTG). }
    claim Hcls_hG : cls_h :e G. { exact (andEL (cls_h :e G) (apply_fun lc cls_h = apply_fun h e0) Hcls_h_prop). }
    claim Hlc_cls_h : apply_fun lc cls_h = apply_fun h e0.
    { exact (andER (cls_h :e G) (apply_fun lc cls_h = apply_fun h e0) Hcls_h_prop). }
    claim Hcls_hN : cls_h :e N. { exact (Hphi_cls_in_N h HhCTG). }
    (** lc(cls_h) = h(e0) = lc(g), so same coset **)
    claim Hlc_eq_cls_g : apply_fun lc cls_h = apply_fun lc g.
    { rewrite Hlc_cls_h. exact Hh_e0. }
    claim Hcoset_eq : left_coset multG cls_h H0 = left_coset multG g H0.
    { exact (Hsame_lc_same_coset cls_h g Hcls_hN HgN Hlc_eq_cls_g). }
    claim Hphi_h_val : apply_fun phi h = left_coset multG cls_h H0.
    { exact Hphi_h_eq. }
    claim Hphi_h_c : apply_fun phi h = c.
    { rewrite Hphi_h_val. rewrite Hcoset_eq. exact (eq_symm c (left_coset multG g H0) Hc_eq). }
    witness h.
    apply andI.
    * (** h :e CTG /\ phi(h) = c **)
      exact (andI (h :e CTG) (apply_fun phi h = c) HhCTG Hphi_h_c).
    * (** Uniqueness: any h' with phi(h') = c must equal h **)
      let h'. assume Hh'CTG Hphi_h'_c.
      (** Show h'(e0) = h(e0), then conclude h' = h by Hct_unique **)
      set cls_h'u := Eps_i (fun cls:set => cls :e G /\ apply_fun lc cls = apply_fun h' e0).
      claim Hcls_h'uP : cls_h'u :e G /\ apply_fun lc cls_h'u = apply_fun h' e0.
      { exact (Hphi_cls_prop h' Hh'CTG). }
      claim Hcls_h'uG : cls_h'u :e G.
      { exact (andEL (cls_h'u :e G) (apply_fun lc cls_h'u = apply_fun h' e0) Hcls_h'uP). }
      claim Hlc_h'u : apply_fun lc cls_h'u = apply_fun h' e0.
      { exact (andER (cls_h'u :e G) (apply_fun lc cls_h'u = apply_fun h' e0) Hcls_h'uP). }
      claim Hcls_h'uN : cls_h'u :e N. { exact (Hphi_cls_in_N h' Hh'CTG). }
      (** Same coset **)
      claim Hcoset_eq_u : left_coset multG cls_h'u H0 = left_coset multG g H0.
      { claim Hv : apply_fun phi h' = left_coset multG cls_h'u H0.
        { exact (apply_fun_graph CTG phiFun h' Hh'CTG). }
        rewrite <- Hv. rewrite Hphi_h'_c. exact Hc_eq. }
      (** cls_h'u :e left_coset g H0, extract h0 :e H0 with cls_h'u = mult(g, h0) **)
      claim Hcls_in_gc : cls_h'u :e left_coset multG g H0.
      { exact (eq_subst_mem_set cls_h'u (left_coset multG cls_h'u H0) (left_coset multG g H0)
          (self_in_left_coset multG eG H0 cls_h'u HeG_H0
            (andER (apply_fun multG (eG, cls_h'u) = cls_h'u) (apply_fun multG (cls_h'u, eG) = cls_h'u)
              (HidG cls_h'u Hcls_h'uG)))
          Hcoset_eq_u). }
      apply (ReplE_impred H0 (fun n:set => apply_fun multG (g, n)) cls_h'u Hcls_in_gc).
      let h0. assume Hh0H0. assume Hcls_prod : cls_h'u = apply_fun multG (g, h0).
      claim Hh0G : h0 :e G. { exact (HH0subG h0 Hh0H0). }
      (** Get representative loops for g and h0 **)
      apply (fundamental_group_member_has_representative B Tb b0 g HgG).
      let fg. assume HfgP.
      claim Hfg_ls : fg :e loop_space B Tb b0.
      { exact (andEL (fg :e loop_space B Tb b0) (g = path_homotopy_class_loop B Tb b0 fg) HfgP). }
      claim Hg_eq_fg : g = path_homotopy_class_loop B Tb b0 fg.
      { exact (andER (fg :e loop_space B Tb b0) (g = path_homotopy_class_loop B Tb b0 fg) HfgP). }
      apply (fundamental_group_member_has_representative B Tb b0 h0 Hh0G).
      let fh0. assume Hfh0P.
      claim Hfh0_ls : fh0 :e loop_space B Tb b0.
      { exact (andEL (fh0 :e loop_space B Tb b0) (h0 = path_homotopy_class_loop B Tb b0 fh0) Hfh0P). }
      claim Hh0_eq_fh0 : h0 = path_homotopy_class_loop B Tb b0 fh0.
      { exact (andER (fh0 :e loop_space B Tb b0) (h0 = path_homotopy_class_loop B Tb b0 fh0) Hfh0P). }
      claim Hfg_cont : continuous_map unit_interval unit_interval_topology B Tb fg.
      { exact (loop_space_continuous B Tb b0 fg Hfg_ls). }
      claim Hfh0_cont : continuous_map unit_interval unit_interval_topology B Tb fh0.
      { exact (loop_space_continuous B Tb b0 fh0 Hfh0_ls). }
      (** cls_h'u = [concat(fg, fh0)] **)
      claim Hcls_eq_cc : cls_h'u = path_homotopy_class_loop B Tb b0 (path_concat fg fh0).
      { rewrite Hcls_prod. rewrite Hg_eq_fg. rewrite Hh0_eq_fh0.
        exact (fundamental_group_mult_apply_on_representatives B Tb b0 fg fh0 Hfg_ls Hfh0_ls). }
      (** CLAIM A: lift(e0, fh0)(1) = e0 from h0 :e H0 **)
      claim Hlift_fh0_e0 : apply_fun (path_lift E Te B Tb p e0 fh0) 1 = e0.
      { (** h0 :e H0 means h0 = p_star(cls_E) for some cls_E **)
        claim Hh0_mem : exists cls_E:set, cls_E :e fundamental_group E Te e0 /\
          h0 = apply_fun (induced_homomorphism E Te e0 B Tb b0 p) cls_E.
        { exact (iffEL
            (h0 :e homomorphism_image (fundamental_group E Te e0) (induced_homomorphism E Te e0 B Tb b0 p))
            (exists cls_E:set, cls_E :e fundamental_group E Te e0 /\
              h0 = apply_fun (induced_homomorphism E Te e0 B Tb b0 p) cls_E)
            (homomorphism_image_mem (fundamental_group E Te e0) (induced_homomorphism E Te e0 B Tb b0 p) h0)
            Hh0H0). }
        apply Hh0_mem. let cls_E. assume Hcls_E_Pack.
        claim Hcls_E_FG : cls_E :e fundamental_group E Te e0.
        { exact (andEL (cls_E :e fundamental_group E Te e0)
            (h0 = apply_fun (induced_homomorphism E Te e0 B Tb b0 p) cls_E) Hcls_E_Pack). }
        claim Hh0_eq_pstar : h0 = apply_fun (induced_homomorphism E Te e0 B Tb b0 p) cls_E.
        { exact (andER (cls_E :e fundamental_group E Te e0)
            (h0 = apply_fun (induced_homomorphism E Te e0 B Tb b0 p) cls_E) Hcls_E_Pack). }
        apply (fundamental_group_member_has_representative E Te e0 cls_E Hcls_E_FG).
        let gamma_E. assume Hgamma_E_Pack.
        claim Hgamma_E_ls : gamma_E :e loop_space E Te e0.
        { exact (andEL (gamma_E :e loop_space E Te e0)
            (cls_E = path_homotopy_class_loop E Te e0 gamma_E) Hgamma_E_Pack). }
        claim Hcls_E_eq : cls_E = path_homotopy_class_loop E Te e0 gamma_E.
        { exact (andER (gamma_E :e loop_space E Te e0)
            (cls_E = path_homotopy_class_loop E Te e0 gamma_E) Hgamma_E_Pack). }
        claim Hgamma_E_cont : continuous_map unit_interval unit_interval_topology E Te gamma_E.
        { exact (loop_space_continuous E Te e0 gamma_E Hgamma_E_ls). }
        claim Hgamma_E_0 : apply_fun gamma_E 0 = e0.
        { exact (loop_space_start E Te e0 gamma_E Hgamma_E_ls). }
        claim Hgamma_E_1 : apply_fun gamma_E 1 = e0.
        { exact (loop_space_end E Te e0 gamma_E Hgamma_E_ls). }
        (** p_star(cls_E) = [compose(Eps_i(cls_E), p)] **)
        set pof_gE := compose_fun unit_interval gamma_E p.
        claim Hpof_gE_cont : continuous_map unit_interval unit_interval_topology B Tb pof_gE.
        { exact (composition_continuous unit_interval unit_interval_topology E Te B Tb
            gamma_E p Hgamma_E_cont Hp_cont). }
        claim Hpstar_eq : apply_fun (induced_homomorphism E Te e0 B Tb b0 p) cls_E
          = path_homotopy_class_loop B Tb b0
            (compose_fun unit_interval (Eps_i (fun w:set => w :e path_homotopy_class_loop E Te e0 gamma_E)) p).
        { rewrite Hcls_E_eq.
          exact (induced_homomorphism_apply_on_loop_class E Te e0 B Tb b0 p gamma_E Hgamma_E_ls). }
        set eps_gE := Eps_i (fun w:set => w :e path_homotopy_class_loop E Te e0 gamma_E).
        claim Heps_gE_in : eps_gE :e path_homotopy_class_loop E Te e0 gamma_E.
        { exact (Eps_i_ax (fun w:set => w :e path_homotopy_class_loop E Te e0 gamma_E) gamma_E
            (loop_in_own_path_homotopy_class E Te e0 gamma_E Hgamma_E_ls)). }
        claim Heps_gE_htpy : path_homotopic E Te e0 e0 gamma_E eps_gE.
        { exact (path_homotopy_class_loop_has_homotopy E Te e0 gamma_E eps_gE Heps_gE_in). }
        claim Hpost_htpy : path_homotopic B Tb b0 b0 pof_gE (compose_fun unit_interval eps_gE p).
        { exact (path_homotopic_postcompose E Te B Tb e0 e0 b0 b0 gamma_E eps_gE p
            Heps_gE_htpy Hp_cont (eq_refl b0) (eq_refl b0)). }
        claim Hpstar_cls : path_homotopy_class_loop B Tb b0 pof_gE
          = path_homotopy_class_loop B Tb b0 (compose_fun unit_interval eps_gE p).
        { exact (path_homotopy_class_loop_eq_of_path_homotopic B Tb b0
            pof_gE (compose_fun unit_interval eps_gE p) Hpost_htpy). }
        (** h0 = [pof_gE] **)
        claim Hh0_eq_pofgE : h0 = path_homotopy_class_loop B Tb b0 pof_gE.
        { rewrite Hh0_eq_pstar. rewrite Hpstar_eq.
          exact (eq_symm
            (path_homotopy_class_loop B Tb b0 pof_gE)
            (path_homotopy_class_loop B Tb b0 (compose_fun unit_interval eps_gE p))
            Hpstar_cls). }
        (** fh0 ~ pof_gE since both represent h0 **)
        claim Hfh0_in_pofgE : fh0 :e path_homotopy_class_loop B Tb b0 pof_gE.
        { exact (eq_subst_mem_set fh0 h0 (path_homotopy_class_loop B Tb b0 pof_gE)
            (eq_subst_mem_set fh0 (path_homotopy_class_loop B Tb b0 fh0) h0
              (loop_in_own_path_homotopy_class B Tb b0 fh0 Hfh0_ls)
              (eq_symm h0 (path_homotopy_class_loop B Tb b0 fh0) Hh0_eq_fh0))
            Hh0_eq_pofgE). }
        claim Hph_pofgE_fh0 : path_homotopic B Tb b0 b0 pof_gE fh0.
        { exact (path_homotopy_class_loop_has_homotopy B Tb b0 pof_gE fh0 Hfh0_in_pofgE). }
        (** By monodromy: lift(e0, pof_gE)(1) = lift(e0, fh0)(1) **)
        claim Hlift_mono : apply_fun (path_lift E Te B Tb p e0 pof_gE) 1
          = apply_fun (path_lift E Te B Tb p e0 fh0) 1.
        { exact (andEL
            (apply_fun (path_lift E Te B Tb p e0 pof_gE) 1
              = apply_fun (path_lift E Te B Tb p e0 fh0) 1)
            (path_homotopic E Te e0 (apply_fun (path_lift E Te B Tb p e0 pof_gE) 1)
              (path_lift E Te B Tb p e0 pof_gE) (path_lift E Te B Tb p e0 fh0))
            (thm54_3_homotopic_lifts E Te B Tb p e0 b0 b0 pof_gE fh0
              Hcov He0E (eq_refl b0) Hph_pofgE_fh0)). }
        (** lift(e0, pof_gE)(1) = gamma_E(1) = e0 by uniqueness of lifts **)
        (** gamma_E is a lift of pof_gE starting at e0 **)
        claim Hlift_gamma : lifting_of unit_interval unit_interval_topology E Te B Tb p pof_gE gamma_E.
        { prove continuous_map unit_interval unit_interval_topology E Te gamma_E /\
            (forall t:set, t :e unit_interval -> apply_fun p (apply_fun gamma_E t) = apply_fun pof_gE t).
          apply andI.
          - exact Hgamma_E_cont.
          - let t. assume Ht.
            exact (eq_symm (apply_fun pof_gE t) (apply_fun p (apply_fun gamma_E t))
              (compose_fun_apply unit_interval gamma_E p t Ht)). }
        claim Hpof_start : apply_fun p e0 = apply_fun pof_gE 0.
        { claim Hcomp : apply_fun pof_gE 0 = apply_fun p (apply_fun gamma_E 0).
          { exact (compose_fun_apply unit_interval gamma_E p 0 zero_in_unit_interval). }
          rewrite Hcomp. rewrite Hgamma_E_0. exact (eq_refl (apply_fun p e0)). }
        claim Hlift_pl : lifting_of unit_interval unit_interval_topology E Te B Tb p pof_gE
          (path_lift E Te B Tb p e0 pof_gE).
        { exact (path_lift_is_lifting_of E Te B Tb p e0 pof_gE Hcov He0E Hpof_start Hpof_gE_cont). }
        claim Hpl_start : apply_fun (path_lift E Te B Tb p e0 pof_gE) 0 = e0.
        { exact (andER
            (continuous_map unit_interval unit_interval_topology E Te (path_lift E Te B Tb p e0 pof_gE))
            (apply_fun (path_lift E Te B Tb p e0 pof_gE) 0 = e0)
            (andEL
              (continuous_map unit_interval unit_interval_topology E Te (path_lift E Te B Tb p e0 pof_gE) /\
                apply_fun (path_lift E Te B Tb p e0 pof_gE) 0 = e0)
              (forall t:set, t :e unit_interval ->
                apply_fun p (apply_fun (path_lift E Te B Tb p e0 pof_gE) t) = apply_fun pof_gE t)
              (lemma54_1_path_lifting E Te B Tb p e0 pof_gE Hcov He0E Hpof_start Hpof_gE_cont))). }
        claim Hstart_agree : apply_fun (path_lift E Te B Tb p e0 pof_gE) 0 = apply_fun gamma_E 0.
        { rewrite Hpl_start. rewrite Hgamma_E_0. exact (eq_refl e0). }
        claim Hpointwise_eq : forall t:set, t :e unit_interval ->
          apply_fun (path_lift E Te B Tb p e0 pof_gE) t = apply_fun gamma_E t.
        { exact (covering_map_lifts_agree_on_connected_domain E Te B Tb p
            unit_interval unit_interval_topology pof_gE
            (path_lift E Te B Tb p e0 pof_gE) gamma_E 0
            Hcov unit_interval_connected Hlift_pl Hlift_gamma zero_in_unit_interval Hstart_agree). }
        (** At t=1: lift(e0, pof_gE)(1) = gamma_E(1) = e0 **)
        claim Hpl_1_e0 : apply_fun (path_lift E Te B Tb p e0 pof_gE) 1 = e0.
        { rewrite (Hpointwise_eq 1 one_in_unit_interval). exact Hgamma_E_1. }
        rewrite <- Hlift_mono. exact Hpl_1_e0. }
      (** CLAIM B: lc(cls_h'u) = lift(lc(g), fh0)(1) **)
      (** Step B1: lc(cls_h'u) = lift(e0, concat(fg, fh0))(1) via monodromy **)
      set eps_u := Eps_i (fun f:set => f :e cls_h'u).
      claim Heps_u_in : eps_u :e cls_h'u.
      { apply (fundamental_group_member_has_representative B Tb b0 cls_h'u Hcls_h'uG).
        let frep. assume HfrepPack.
        claim Hfrep_ls : frep :e loop_space B Tb b0.
        { exact (andEL (frep :e loop_space B Tb b0) (cls_h'u = path_homotopy_class_loop B Tb b0 frep) HfrepPack). }
        claim Hcls_eq_frep : cls_h'u = path_homotopy_class_loop B Tb b0 frep.
        { exact (andER (frep :e loop_space B Tb b0) (cls_h'u = path_homotopy_class_loop B Tb b0 frep) HfrepPack). }
        exact (Eps_i_ax (fun f:set => f :e cls_h'u) frep
          (eq_subst_mem_set frep (path_homotopy_class_loop B Tb b0 frep) cls_h'u
            (loop_in_own_path_homotopy_class B Tb b0 frep Hfrep_ls)
            (eq_symm cls_h'u (path_homotopy_class_loop B Tb b0 frep) Hcls_eq_frep))). }
      claim Heps_u_in_cc : eps_u :e path_homotopy_class_loop B Tb b0 (path_concat fg fh0).
      { exact (eq_subst_mem_set eps_u cls_h'u
          (path_homotopy_class_loop B Tb b0 (path_concat fg fh0)) Heps_u_in Hcls_eq_cc). }
      claim Hph_cc_eps : path_homotopic B Tb b0 b0 (path_concat fg fh0) eps_u.
      { exact (path_homotopy_class_loop_has_homotopy B Tb b0 (path_concat fg fh0) eps_u Heps_u_in_cc). }
      claim Hlift_cc_eq_eps : apply_fun (path_lift E Te B Tb p e0 (path_concat fg fh0)) 1
        = apply_fun (path_lift E Te B Tb p e0 eps_u) 1.
      { exact (andEL
          (apply_fun (path_lift E Te B Tb p e0 (path_concat fg fh0)) 1
            = apply_fun (path_lift E Te B Tb p e0 eps_u) 1)
          (path_homotopic E Te e0 (apply_fun (path_lift E Te B Tb p e0 (path_concat fg fh0)) 1)
            (path_lift E Te B Tb p e0 (path_concat fg fh0)) (path_lift E Te B Tb p e0 eps_u))
          (thm54_3_homotopic_lifts E Te B Tb p e0 b0 b0 (path_concat fg fh0) eps_u
            Hcov He0E (eq_refl b0) Hph_cc_eps)). }
      (** lc(cls_h'u) = lift(e0, eps_u)(1) by unfolding lc **)
      claim Hlc_unfold : apply_fun lc cls_h'u
        = apply_fun (path_lift E Te B Tb p e0 (Eps_i (fun f:set => f :e cls_h'u))) 1.
      { exact (apply_fun_graph G
          (fun cls:set => apply_fun (path_lift E Te B Tb p e0 (Eps_i (fun f:set => f :e cls))) 1)
          cls_h'u Hcls_h'uG). }
      (** Step B2: lift(e0, concat)(1) = lift(lift(e0, fg)(1), fh0)(1) by concat endpoint **)
      claim Hconcat_ep : apply_fun (path_lift E Te B Tb p e0 (path_concat fg fh0)) 1
        = apply_fun (path_lift E Te B Tb p (apply_fun (path_lift E Te B Tb p e0 fg) 1) fh0) 1.
      { claim Hfg1_fh00 : apply_fun fg 1 = apply_fun fh0 0.
        { rewrite (loop_space_end B Tb b0 fg Hfg_ls).
          exact (eq_symm (apply_fun fh0 0) b0 (loop_space_start B Tb b0 fh0 Hfh0_ls)). }
        exact (path_lift_concat_endpoint E Te B Tb p e0 fg fh0 Hcov He0E
          Hfg_cont Hfh0_cont Hfg1_fh00
          (eq_symm (apply_fun fg 0) b0 (loop_space_start B Tb b0 fg Hfg_ls))). }
      (** Step B3: lift(e0, fg)(1) = lc(g) by monodromy **)
      set eps_g_u := Eps_i (fun f:set => f :e g).
      claim Heps_g_u_in : eps_g_u :e g.
      { apply (fundamental_group_member_has_representative B Tb b0 g HgG).
        let frep_g. assume Hfrep_g_Pack.
        exact (Eps_i_ax (fun f:set => f :e g) frep_g
          (eq_subst_mem_set frep_g (path_homotopy_class_loop B Tb b0 frep_g) g
            (loop_in_own_path_homotopy_class B Tb b0 frep_g
              (andEL (frep_g :e loop_space B Tb b0) (g = path_homotopy_class_loop B Tb b0 frep_g) Hfrep_g_Pack))
            (eq_symm g (path_homotopy_class_loop B Tb b0 frep_g)
              (andER (frep_g :e loop_space B Tb b0) (g = path_homotopy_class_loop B Tb b0 frep_g) Hfrep_g_Pack)))). }
      claim Hfg_in_g : fg :e g.
      { rewrite Hg_eq_fg.
        exact (loop_in_own_path_homotopy_class B Tb b0 fg Hfg_ls). }
      claim Hph_fg_epsg : path_homotopic B Tb b0 b0 fg eps_g_u.
      { exact (path_homotopy_class_loop_has_homotopy B Tb b0 fg eps_g_u
          (eq_subst_mem_set eps_g_u g (path_homotopy_class_loop B Tb b0 fg) Heps_g_u_in Hg_eq_fg)). }
      claim Hlift_fg_eq_epsg : apply_fun (path_lift E Te B Tb p e0 fg) 1
        = apply_fun (path_lift E Te B Tb p e0 eps_g_u) 1.
      { exact (andEL
          (apply_fun (path_lift E Te B Tb p e0 fg) 1
            = apply_fun (path_lift E Te B Tb p e0 eps_g_u) 1)
          (path_homotopic E Te e0 (apply_fun (path_lift E Te B Tb p e0 fg) 1)
            (path_lift E Te B Tb p e0 fg) (path_lift E Te B Tb p e0 eps_g_u))
          (thm54_3_homotopic_lifts E Te B Tb p e0 b0 b0 fg eps_g_u
            Hcov He0E (eq_refl b0) Hph_fg_epsg)). }
      claim Hlcg_unfold : apply_fun lc g
        = apply_fun (path_lift E Te B Tb p e0 (Eps_i (fun f:set => f :e g))) 1.
      { exact (apply_fun_graph G
          (fun cls:set => apply_fun (path_lift E Te B Tb p e0 (Eps_i (fun f:set => f :e cls))) 1)
          g HgG). }
      claim Hlift_fg_eq_lcg : apply_fun (path_lift E Te B Tb p e0 fg) 1 = apply_fun lc g.
      { rewrite Hlcg_unfold. exact Hlift_fg_eq_epsg. }
      (** CLAIM C: lift(lc(g), fh0)(1) = lc(g) via CT transport **)
      claim Hlift_lcg_fh0 : apply_fun (path_lift E Te B Tb p (apply_fun lc g) fh0) 1 = apply_fun lc g.
      { (** h compose lift(e0, fh0) is a lift of fh0 starting at h(e0) = lc(g) **)
        set lift_fh0 := path_lift E Te B Tb p e0 fh0.
        claim Hlift_fh0_props :
          continuous_map unit_interval unit_interval_topology E Te lift_fh0 /\
          apply_fun lift_fh0 0 = e0 /\
          (forall t:set, t :e unit_interval ->
            apply_fun p (apply_fun lift_fh0 t) = apply_fun fh0 t).
        { exact (lemma54_1_path_lifting E Te B Tb p e0 fh0 Hcov He0E
            (eq_symm (apply_fun fh0 0) b0 (loop_space_start B Tb b0 fh0 Hfh0_ls)) Hfh0_cont). }
        claim Hlift_fh0_cont : continuous_map unit_interval unit_interval_topology E Te lift_fh0.
        { exact (andEL
            (continuous_map unit_interval unit_interval_topology E Te lift_fh0)
            (apply_fun lift_fh0 0 = e0)
            (andEL
              (continuous_map unit_interval unit_interval_topology E Te lift_fh0 /\
                apply_fun lift_fh0 0 = e0)
              (forall t:set, t :e unit_interval ->
                apply_fun p (apply_fun lift_fh0 t) = apply_fun fh0 t)
              Hlift_fh0_props)). }
        claim Hlift_fh0_start : apply_fun lift_fh0 0 = e0.
        { exact (andER
            (continuous_map unit_interval unit_interval_topology E Te lift_fh0)
            (apply_fun lift_fh0 0 = e0)
            (andEL
              (continuous_map unit_interval unit_interval_topology E Te lift_fh0 /\
                apply_fun lift_fh0 0 = e0)
              (forall t:set, t :e unit_interval ->
                apply_fun p (apply_fun lift_fh0 t) = apply_fun fh0 t)
              Hlift_fh0_props)). }
        claim Hlift_fh0_comm : forall t:set, t :e unit_interval ->
          apply_fun p (apply_fun lift_fh0 t) = apply_fun fh0 t.
        { exact (andER
            (continuous_map unit_interval unit_interval_topology E Te lift_fh0 /\
              apply_fun lift_fh0 0 = e0)
            (forall t:set, t :e unit_interval ->
              apply_fun p (apply_fun lift_fh0 t) = apply_fun fh0 t)
            Hlift_fh0_props). }
        (** Compose h with lift_fh0 **)
        set comp_h := compose_fun unit_interval lift_fh0 h.
        claim Hcomp_h_cont : continuous_map unit_interval unit_interval_topology E Te comp_h.
        { exact (composition_continuous unit_interval unit_interval_topology E Te E Te
            lift_fh0 h Hlift_fh0_cont Hh_cont). }
        claim Hcomp_h_comm : forall t:set, t :e unit_interval ->
          apply_fun p (apply_fun comp_h t) = apply_fun fh0 t.
        { let t. assume Ht.
          claim Hcomp_eq : apply_fun comp_h t = apply_fun h (apply_fun lift_fh0 t).
          { exact (compose_fun_apply unit_interval lift_fh0 h t Ht). }
          rewrite Hcomp_eq.
          claim Hlift_t_E : apply_fun lift_fh0 t :e E.
          { exact (continuous_map_function_on unit_interval unit_interval_topology E Te lift_fh0
              Hlift_fh0_cont t Ht). }
          claim Hph_eq : apply_fun p (apply_fun h (apply_fun lift_fh0 t)) = apply_fun p (apply_fun lift_fh0 t).
          { exact (andER (homeomorphism E Te E Te h) (forall x:set, x :e E -> apply_fun p (apply_fun h x) = apply_fun p x) Hh_ct (apply_fun lift_fh0 t) Hlift_t_E). }
          rewrite Hph_eq. exact (Hlift_fh0_comm t Ht). }
        (** comp_h is a lifting_of of fh0 **)
        claim Hcomp_lifting : lifting_of unit_interval unit_interval_topology E Te B Tb p fh0 comp_h.
        { prove continuous_map unit_interval unit_interval_topology E Te comp_h /\
            (forall t:set, t :e unit_interval -> apply_fun p (apply_fun comp_h t) = apply_fun fh0 t).
          exact (andI
            (continuous_map unit_interval unit_interval_topology E Te comp_h)
            (forall t:set, t :e unit_interval -> apply_fun p (apply_fun comp_h t) = apply_fun fh0 t)
            Hcomp_h_cont Hcomp_h_comm). }
        (** path_lift(lc(g), fh0) is also a lifting_of of fh0 **)
        claim Hstart_lcg : apply_fun p (apply_fun lc g) = apply_fun fh0 0.
        { rewrite Hlcg_fib_eq.
          exact (eq_symm (apply_fun fh0 0) b0 (loop_space_start B Tb b0 fh0 Hfh0_ls)). }
        claim Hlift_lcg_lifting : lifting_of unit_interval unit_interval_topology E Te B Tb p fh0
          (path_lift E Te B Tb p (apply_fun lc g) fh0).
        { exact (path_lift_is_lifting_of E Te B Tb p (apply_fun lc g) fh0 Hcov Hlcg_E
            Hstart_lcg Hfh0_cont). }
        (** Starting points agree: both start at lc(g) **)
        claim Hcomp_start : apply_fun comp_h 0 = apply_fun lc g.
        { claim Hcomp_0 : apply_fun comp_h 0 = apply_fun h (apply_fun lift_fh0 0).
          { exact (compose_fun_apply unit_interval lift_fh0 h 0 zero_in_unit_interval). }
          rewrite Hcomp_0. rewrite Hlift_fh0_start. exact Hh_e0. }
        claim lcg_lift_props :
          continuous_map unit_interval unit_interval_topology E Te (path_lift E Te B Tb p (apply_fun lc g) fh0) /\
          apply_fun (path_lift E Te B Tb p (apply_fun lc g) fh0) 0 = apply_fun lc g /\
          (forall t:set, t :e unit_interval ->
            apply_fun p (apply_fun (path_lift E Te B Tb p (apply_fun lc g) fh0) t) = apply_fun fh0 t).
        { exact (lemma54_1_path_lifting E Te B Tb p (apply_fun lc g) fh0 Hcov Hlcg_E
            Hstart_lcg Hfh0_cont). }
        claim Hlift_lcg_start : apply_fun (path_lift E Te B Tb p (apply_fun lc g) fh0) 0 = apply_fun lc g.
        { exact (andER
            (continuous_map unit_interval unit_interval_topology E Te (path_lift E Te B Tb p (apply_fun lc g) fh0))
            (apply_fun (path_lift E Te B Tb p (apply_fun lc g) fh0) 0 = apply_fun lc g)
            (andEL
              (continuous_map unit_interval unit_interval_topology E Te (path_lift E Te B Tb p (apply_fun lc g) fh0) /\
                apply_fun (path_lift E Te B Tb p (apply_fun lc g) fh0) 0 = apply_fun lc g)
              (forall t:set, t :e unit_interval ->
                apply_fun p (apply_fun (path_lift E Te B Tb p (apply_fun lc g) fh0) t) = apply_fun fh0 t)
              lcg_lift_props)). }
        claim Hstart_eq_lcg : apply_fun (path_lift E Te B Tb p (apply_fun lc g) fh0) 0 = apply_fun comp_h 0.
        { rewrite Hlift_lcg_start. rewrite Hcomp_start. exact (eq_refl (apply_fun lc g)). }
        (** By uniqueness of lifts: they agree pointwise **)
        claim Hpw_lcg : forall t:set, t :e unit_interval ->
          apply_fun (path_lift E Te B Tb p (apply_fun lc g) fh0) t = apply_fun comp_h t.
        { exact (covering_map_lifts_agree_on_connected_domain E Te B Tb p
            unit_interval unit_interval_topology fh0
            (path_lift E Te B Tb p (apply_fun lc g) fh0) comp_h 0
            Hcov unit_interval_connected Hlift_lcg_lifting Hcomp_lifting zero_in_unit_interval Hstart_eq_lcg). }
        (** At t=1 **)
        claim Hpw_1 : apply_fun (path_lift E Te B Tb p (apply_fun lc g) fh0) 1 = apply_fun comp_h 1.
        { exact (Hpw_lcg 1 one_in_unit_interval). }
        claim Hcomp_1 : apply_fun comp_h 1 = apply_fun h (apply_fun lift_fh0 1).
        { exact (compose_fun_apply unit_interval lift_fh0 h 1 one_in_unit_interval). }
        rewrite Hpw_1. rewrite Hcomp_1. rewrite Hlift_fh0_e0. exact Hh_e0. }
      (** Final chain: h'(e0) = lc(cls_h'u) = lift(lc(g), fh0)(1) = lc(g) = h(e0) **)
      claim Hlc_eq_lcg : apply_fun lc cls_h'u = apply_fun lc g.
      { rewrite Hlc_unfold. rewrite <- Hlift_cc_eq_eps. rewrite Hconcat_ep.
        rewrite Hlift_fg_eq_lcg. exact Hlift_lcg_fh0. }
      claim He0_eq : apply_fun h' e0 = apply_fun h e0.
      { rewrite <- Hlc_h'u. rewrite Hlc_eq_lcg. exact (eq_symm (apply_fun h e0) (apply_fun lc g) Hh_e0). }
      exact (Hct_unique h' h Hh'CTG HhCTG He0_eq).
Admitted. (** all internal admits eliminated; blocked only by admitted bridge continuous_map_in_total_function_space **)

(** from S81 Definition (line 5103 in algtop.tex): regular covering map **)
(** LATEX VERSION: If H0 is a normal subgroup of pi1(B,b0), then p: E -> B **)
(** is called a regular covering map. **)
Definition regular_covering_map : set -> set -> set -> set -> set -> set -> prop :=
  fun E Te B Tb p e0 =>
    covering_map E Te B Tb p /\ e0 :e E /\
    normal_subgroup
      (homomorphism_image
        (fundamental_group E Te e0)
        (induced_homomorphism E Te e0 B Tb (apply_fun p e0) p))
      (fundamental_group B Tb (apply_fun p e0))
      (fundamental_group_mult B Tb (apply_fun p e0))
      (fundamental_group_id B Tb (apply_fun p e0))
      (fundamental_group_inv B Tb (apply_fun p e0)).

(** from S81 Cor 81.3 (line 5091 in algtop.tex) **)
(** LATEX VERSION: H0 is normal in pi1(B,b0) iff for every pair e1,e2 in p^{-1}(b0) **)
(** there is a covering transformation h with h(e1)=e2. In this case, **)
(** C(E,p,B) is isomorphic to pi1(B,b0)/H0. **)
(** EFFORT: 5 lines textbook, difficulty 3/10, USD 50 **)
(** Collected Alice 61 **)
(** Proven Alice **)
Theorem cor81_3_normal_iff_transitive :
  forall E Te B Tb p e0:set,
  covering_map E Te B Tb p -> e0 :e E ->
  path_connected_space E Te -> locally_path_connected E Te ->
  (regular_covering_map E Te B Tb p e0
   <->
   (forall e1 e2:set, e1 :e E -> e2 :e E ->
     apply_fun p e1 = apply_fun p e0 ->
     apply_fun p e2 = apply_fun p e0 ->
     exists h:set, covering_transformation E Te B Tb p h /\ apply_fun h e1 = e2)).
let E Te B Tb p e0.
assume Hcov He0E HpcE HlpE.
set b0 := apply_fun p e0.
claim HtopE : topology_on E Te.
{ exact (covering_map_topology_on_domain E Te B Tb p Hcov). }
claim HtopB : topology_on B Tb.
{ exact (covering_map_topology_on_codomain E Te B Tb p Hcov). }
claim Hp_cont : continuous_map E Te B Tb p.
{ exact (covering_map_continuous E Te B Tb p Hcov). }
claim Hp_fun : function_on p E B.
{ exact (continuous_map_function_on E Te B Tb p Hp_cont). }
claim Hb0B : b0 :e B.
{ exact (Hp_fun e0 He0E). }
set G := fundamental_group B Tb b0.
set multG := fundamental_group_mult B Tb b0.
set eG := fundamental_group_id B Tb b0.
set invG := fundamental_group_inv B Tb b0.
set H0 := homomorphism_image
  (fundamental_group E Te e0)
  (induced_homomorphism E Te e0 B Tb b0 p).
claim HgrpG : group_structure G multG eG invG.
{ exact (fundamental_group_is_group B Tb b0 HtopB Hb0B). }
claim HgrpE0 : group_structure (fundamental_group E Te e0) (fundamental_group_mult E Te e0)
  (fundamental_group_id E Te e0) (fundamental_group_inv E Te e0).
{ exact (fundamental_group_is_group E Te e0 HtopE He0E). }
claim Hphi0_hom : group_homomorphism
  (fundamental_group E Te e0) (fundamental_group_mult E Te e0)
  G multG (induced_homomorphism E Te e0 B Tb b0 p).
{ exact (induced_homomorphism_is_homomorphism E Te e0 B Tb b0 p Hp_cont (eq_refl b0) He0E). }
claim HH0_sub : subgroup_of H0 G multG eG invG.
{ exact (homomorphism_image_subgroup_of
    (fundamental_group E Te e0) (fundamental_group_mult E Te e0)
    (fundamental_group_id E Te e0) (fundamental_group_inv E Te e0)
    G multG eG invG
    (induced_homomorphism E Te e0 B Tb b0 p)
    HgrpE0 HgrpG Hphi0_hom). }
claim Hfn_mult : function_on multG (setprod G G) G.
{ apply (and6E (function_on multG (setprod G G) G) (function_on invG G G) (eG :e G)
    (forall x0 y0 z0:set, x0 :e G -> y0 :e G -> z0 :e G ->
      apply_fun multG (apply_fun multG (x0, y0), z0) = apply_fun multG (x0, apply_fun multG (y0, z0)))
    (forall x0:set, x0 :e G -> apply_fun multG (eG, x0) = x0 /\ apply_fun multG (x0, eG) = x0)
    (forall x0:set, x0 :e G ->
      apply_fun multG (x0, apply_fun invG x0) = eG /\ apply_fun multG (apply_fun invG x0, x0) = eG)
    HgrpG). assume Hf _ _ _ _ _. exact Hf. }
claim Hfn_inv : function_on invG G G.
{ apply (and6E (function_on multG (setprod G G) G) (function_on invG G G) (eG :e G)
    (forall x0 y0 z0:set, x0 :e G -> y0 :e G -> z0 :e G ->
      apply_fun multG (apply_fun multG (x0, y0), z0) = apply_fun multG (x0, apply_fun multG (y0, z0)))
    (forall x0:set, x0 :e G -> apply_fun multG (eG, x0) = x0 /\ apply_fun multG (x0, eG) = x0)
    (forall x0:set, x0 :e G ->
      apply_fun multG (x0, apply_fun invG x0) = eG /\ apply_fun multG (apply_fun invG x0, x0) = eG)
    HgrpG). assume _ Hi _ _ _ _. exact Hi. }
claim HeGG : eG :e G.
{ apply (and6E (function_on multG (setprod G G) G) (function_on invG G G) (eG :e G)
    (forall x0 y0 z0:set, x0 :e G -> y0 :e G -> z0 :e G ->
      apply_fun multG (apply_fun multG (x0, y0), z0) = apply_fun multG (x0, apply_fun multG (y0, z0)))
    (forall x0:set, x0 :e G -> apply_fun multG (eG, x0) = x0 /\ apply_fun multG (x0, eG) = x0)
    (forall x0:set, x0 :e G ->
      apply_fun multG (x0, apply_fun invG x0) = eG /\ apply_fun multG (apply_fun invG x0, x0) = eG)
    HgrpG). assume _ _ He _ _ _. exact He. }
claim Hassoc : forall a b c:set, a :e G -> b :e G -> c :e G ->
  apply_fun multG (apply_fun multG (a, b), c) = apply_fun multG (a, apply_fun multG (b, c)).
{ apply (and6E (function_on multG (setprod G G) G) (function_on invG G G) (eG :e G)
    (forall x0 y0 z0:set, x0 :e G -> y0 :e G -> z0 :e G ->
      apply_fun multG (apply_fun multG (x0, y0), z0) = apply_fun multG (x0, apply_fun multG (y0, z0)))
    (forall x0:set, x0 :e G -> apply_fun multG (eG, x0) = x0 /\ apply_fun multG (x0, eG) = x0)
    (forall x0:set, x0 :e G ->
      apply_fun multG (x0, apply_fun invG x0) = eG /\ apply_fun multG (apply_fun invG x0, x0) = eG)
    HgrpG). assume _ _ _ Ha _ _. exact Ha. }
claim Hident : forall a:set, a :e G -> apply_fun multG (eG, a) = a /\ apply_fun multG (a, eG) = a.
{ apply (and6E (function_on multG (setprod G G) G) (function_on invG G G) (eG :e G)
    (forall x0 y0 z0:set, x0 :e G -> y0 :e G -> z0 :e G ->
      apply_fun multG (apply_fun multG (x0, y0), z0) = apply_fun multG (x0, apply_fun multG (y0, z0)))
    (forall x0:set, x0 :e G -> apply_fun multG (eG, x0) = x0 /\ apply_fun multG (x0, eG) = x0)
    (forall x0:set, x0 :e G ->
      apply_fun multG (x0, apply_fun invG x0) = eG /\ apply_fun multG (apply_fun invG x0, x0) = eG)
    HgrpG). assume _ _ _ _ Hi _. exact Hi. }
claim Hinverse : forall a:set, a :e G ->
  apply_fun multG (a, apply_fun invG a) = eG /\ apply_fun multG (apply_fun invG a, a) = eG.
{ apply (and6E (function_on multG (setprod G G) G) (function_on invG G G) (eG :e G)
    (forall x0 y0 z0:set, x0 :e G -> y0 :e G -> z0 :e G ->
      apply_fun multG (apply_fun multG (x0, y0), z0) = apply_fun multG (x0, apply_fun multG (y0, z0)))
    (forall x0:set, x0 :e G -> apply_fun multG (eG, x0) = x0 /\ apply_fun multG (x0, eG) = x0)
    (forall x0:set, x0 :e G ->
      apply_fun multG (x0, apply_fun invG x0) = eG /\ apply_fun multG (apply_fun invG x0, x0) = eG)
    HgrpG). assume _ _ _ _ _ Hinv. exact Hinv. }
apply iffI.
- (** Forward: regular_covering_map => transitive **)
  assume Hreg.
  claim Hreg_unf : (covering_map E Te B Tb p /\ e0 :e E) /\ normal_subgroup H0 G multG eG invG.
  { exact Hreg. }
  claim Hnormal : normal_subgroup H0 G multG eG invG.
  { exact (andER (covering_map E Te B Tb p /\ e0 :e E) (normal_subgroup H0 G multG eG invG) Hreg_unf). }
  claim Hnormal_unf : subgroup_of H0 G multG eG invG /\
    (forall n g:set, n :e H0 -> g :e G ->
      apply_fun multG (apply_fun multG (g, n), apply_fun invG g) :e H0).
  { exact Hnormal. }
  claim Hconj_closed : forall n g:set, n :e H0 -> g :e G ->
    apply_fun multG (apply_fun multG (g, n), apply_fun invG g) :e H0.
  { exact (andER (subgroup_of H0 G multG eG invG)
      (forall n g:set, n :e H0 -> g :e G ->
        apply_fun multG (apply_fun multG (g, n), apply_fun invG g) :e H0)
      Hnormal_unf). }
  let e1 e2.
  assume He1E He2E Hpe1 Hpe2.
  claim Hpe0pe1 : apply_fun p e0 = apply_fun p e1.
  { claim Htmp : b0 = apply_fun p e1.
    { exact (eq_symm (apply_fun p e1) b0 Hpe1). }
    exact Htmp. }
  claim Hconj_01 : conjugate_subgroups
    (homomorphism_image (fundamental_group E Te e1) (induced_homomorphism E Te e1 B Tb (apply_fun p e1) p))
    H0 G multG eG invG.
  { exact (lemma79_3a_conjugacy_of_subgroups E Te B Tb p e0 e1 Hcov He0E He1E Hpe0pe1 HpcE). }
  set H1 := homomorphism_image (fundamental_group E Te e1) (induced_homomorphism E Te e1 B Tb (apply_fun p e1) p).
  claim HH1_sub_G : H1 c= G.
  { exact (subgroup_of_subset H1 G multG eG invG
      (andEL (subgroup_of H1 G multG eG invG) (subgroup_of H0 G multG eG invG)
        (andEL (subgroup_of H1 G multG eG invG /\ subgroup_of H0 G multG eG invG)
          (exists alpha':set, alpha' :e G /\ H0 = {apply_fun multG (apply_fun multG (alpha', h), apply_fun invG alpha') | h :e H1})
          Hconj_01))). }
  claim Hconj_ex : exists alpha:set, alpha :e G /\
    H0 = {apply_fun multG (apply_fun multG (alpha, h), apply_fun invG alpha) | h :e H1}.
  { exact (andER (subgroup_of H1 G multG eG invG /\ subgroup_of H0 G multG eG invG)
      (exists alpha:set, alpha :e G /\ H0 = {apply_fun multG (apply_fun multG (alpha, h), apply_fun invG alpha) | h :e H1})
      Hconj_01). }
  apply Hconj_ex. let alpha. assume HalphaPack.
  claim HalphaG : alpha :e G.
  { exact (andEL (alpha :e G)
      (H0 = {apply_fun multG (apply_fun multG (alpha, h), apply_fun invG alpha) | h :e H1})
      HalphaPack). }
  claim HH0eq : H0 = {apply_fun multG (apply_fun multG (alpha, h), apply_fun invG alpha) | h :e H1}.
  { exact (andER (alpha :e G)
      (H0 = {apply_fun multG (apply_fun multG (alpha, h), apply_fun invG alpha) | h :e H1})
      HalphaPack). }
  claim HinvalphaG : apply_fun invG alpha :e G. { exact (Hfn_inv alpha HalphaG). }
  claim Hinv_inv_alpha : apply_fun invG (apply_fun invG alpha) = alpha.
  { exact (group_inv_inv G multG invG eG alpha Hfn_mult Hfn_inv HeGG Hassoc Hident Hinverse HalphaG). }
  (** H1 c= H0: take h1 in H1, show alpha.h1.inv(alpha) in H0, then normalize back **)
  claim HH1_sub_H0 : H1 c= H0.
  { let h1. assume Hh1H1.
    claim Hh1G : h1 :e G. { exact (HH1_sub_G h1 Hh1H1). }
    claim Hcv : apply_fun multG (apply_fun multG (alpha, h1), apply_fun invG alpha) :e H0.
    { rewrite HH0eq. exact (ReplI H1 (fun h:set => apply_fun multG (apply_fun multG (alpha, h), apply_fun invG alpha)) h1 Hh1H1). }
    claim HcvG : apply_fun multG (apply_fun multG (alpha, h1), apply_fun invG alpha) :e G.
    { exact (subgroup_of_subset H0 G multG eG invG HH0_sub (apply_fun multG (apply_fun multG (alpha, h1), apply_fun invG alpha)) Hcv). }
    claim Hah1G : apply_fun multG (alpha, h1) :e G.
    { exact (Hfn_mult (alpha, h1) (tuple_2_setprod_by_pair_Sigma G G alpha h1 HalphaG Hh1G)). }
    claim Hnorm : apply_fun multG (apply_fun multG (apply_fun invG alpha, apply_fun multG (apply_fun multG (alpha, h1), apply_fun invG alpha)), apply_fun invG (apply_fun invG alpha)) :e H0.
    { exact (Hconj_closed (apply_fun multG (apply_fun multG (alpha, h1), apply_fun invG alpha)) (apply_fun invG alpha) Hcv HinvalphaG). }
    claim Hc1 : apply_fun multG (apply_fun invG alpha, alpha) = eG.
    { exact (andER (apply_fun multG (alpha, apply_fun invG alpha) = eG)
        (apply_fun multG (apply_fun invG alpha, alpha) = eG) (Hinverse alpha HalphaG)). }
    claim Hl1 : apply_fun multG (eG, h1) = h1.
    { exact (andEL (apply_fun multG (eG, h1) = h1) (apply_fun multG (h1, eG) = h1) (Hident h1 Hh1G)). }
    claim Hchain : apply_fun multG (apply_fun multG (apply_fun invG alpha, apply_fun multG (apply_fun multG (alpha, h1), apply_fun invG alpha)), apply_fun invG (apply_fun invG alpha)) = h1.
    { rewrite Hinv_inv_alpha.
      rewrite (Hassoc (apply_fun invG alpha) (apply_fun multG (apply_fun multG (alpha, h1), apply_fun invG alpha)) alpha HinvalphaG HcvG HalphaG).
      rewrite (Hassoc (apply_fun multG (alpha, h1)) (apply_fun invG alpha) alpha Hah1G HinvalphaG HalphaG).
      rewrite Hc1.
      rewrite (andER (apply_fun multG (eG, apply_fun multG (alpha, h1)) = apply_fun multG (alpha, h1))
        (apply_fun multG (apply_fun multG (alpha, h1), eG) = apply_fun multG (alpha, h1))
        (Hident (apply_fun multG (alpha, h1)) Hah1G)).
      rewrite (eq_symm
        (apply_fun multG (apply_fun multG (apply_fun invG alpha, alpha), h1))
        (apply_fun multG (apply_fun invG alpha, apply_fun multG (alpha, h1)))
        (Hassoc (apply_fun invG alpha) alpha h1 HinvalphaG HalphaG Hh1G)).
      rewrite Hc1. rewrite Hl1. reflexivity. }
    rewrite <- Hchain. exact Hnorm. }
  (** H0 c= H1 **)
  claim HH0_sub_H1 : H0 c= H1.
  { let h0. assume Hh0H0.
    claim Hh0G : h0 :e G. { exact (subgroup_of_subset H0 G multG eG invG HH0_sub h0 Hh0H0). }
    claim Hch0 : apply_fun multG (apply_fun multG (alpha, h0), apply_fun invG alpha) :e H0.
    { exact (Hconj_closed h0 alpha Hh0H0 HalphaG). }
    claim Hch0_repl : apply_fun multG (apply_fun multG (alpha, h0), apply_fun invG alpha) :e
      {apply_fun multG (apply_fun multG (alpha, h), apply_fun invG alpha) | h :e H1}.
    { rewrite <- HH0eq. exact Hch0. }
    apply (ReplE_impred H1 (fun h:set => apply_fun multG (apply_fun multG (alpha, h), apply_fun invG alpha))
      (apply_fun multG (apply_fun multG (alpha, h0), apply_fun invG alpha)) Hch0_repl).
    let h'. assume Hh'H1 Heq.
    claim Hh'G : h' :e G. { exact (HH1_sub_G h' Hh'H1). }
    claim Hah0G : apply_fun multG (alpha, h0) :e G.
    { exact (Hfn_mult (alpha, h0) (tuple_2_setprod_by_pair_Sigma G G alpha h0 HalphaG Hh0G)). }
    claim Hah'G : apply_fun multG (alpha, h') :e G.
    { exact (Hfn_mult (alpha, h') (tuple_2_setprod_by_pair_Sigma G G alpha h' HalphaG Hh'G)). }
    claim Hrc : apply_fun multG (alpha, h0) = apply_fun multG (alpha, h').
    { exact (group_right_cancel G multG eG invG (apply_fun invG alpha) (apply_fun multG (alpha, h0)) (apply_fun multG (alpha, h'))
        HgrpG HinvalphaG Hah0G Hah'G Heq). }
    claim Hlc : h0 = h'.
    { exact (group_left_cancel G multG eG invG alpha h0 h' HgrpG HalphaG Hh0G Hh'G Hrc). }
    rewrite Hlc. exact Hh'H1. }
  claim HH0eqH1 : H0 = H1.
  { exact (set_ext H0 H1 HH0_sub_H1 HH1_sub_H0). }
  (** Apply thm79_2 backward for e0->e1 and e0->e2 **)
  claim Hpe0pe2 : apply_fun p e0 = apply_fun p e2.
  { claim Htmp2 : b0 = apply_fun p e2.
    { exact (eq_symm (apply_fun p e2) b0 Hpe2). }
    exact Htmp2. }
  (** Similarly get H0 = H2 for e2 **)
  claim Hconj_02 : conjugate_subgroups
    (homomorphism_image (fundamental_group E Te e2) (induced_homomorphism E Te e2 B Tb (apply_fun p e2) p))
    H0 G multG eG invG.
  { exact (lemma79_3a_conjugacy_of_subgroups E Te B Tb p e0 e2 Hcov He0E He2E Hpe0pe2 HpcE). }
  set H2 := homomorphism_image (fundamental_group E Te e2) (induced_homomorphism E Te e2 B Tb (apply_fun p e2) p).
  claim HH2_sub_G : H2 c= G.
  { exact (subgroup_of_subset H2 G multG eG invG
      (andEL (subgroup_of H2 G multG eG invG) (subgroup_of H0 G multG eG invG)
        (andEL (subgroup_of H2 G multG eG invG /\ subgroup_of H0 G multG eG invG)
          (exists a:set, a :e G /\ H0 = {apply_fun multG (apply_fun multG (a, h), apply_fun invG a) | h :e H2})
          Hconj_02))). }
  claim Hconj_ex2 : exists alpha2:set, alpha2 :e G /\
    H0 = {apply_fun multG (apply_fun multG (alpha2, h), apply_fun invG alpha2) | h :e H2}.
  { exact (andER (subgroup_of H2 G multG eG invG /\ subgroup_of H0 G multG eG invG)
      (exists a:set, a :e G /\ H0 = {apply_fun multG (apply_fun multG (a, h), apply_fun invG a) | h :e H2})
      Hconj_02). }
  apply Hconj_ex2. let alpha2. assume Halpha2Pack.
  claim Halpha2G : alpha2 :e G.
  { exact (andEL (alpha2 :e G)
      (H0 = {apply_fun multG (apply_fun multG (alpha2, h), apply_fun invG alpha2) | h :e H2})
      Halpha2Pack). }
  claim HH0eq2 : H0 = {apply_fun multG (apply_fun multG (alpha2, h), apply_fun invG alpha2) | h :e H2}.
  { exact (andER (alpha2 :e G)
      (H0 = {apply_fun multG (apply_fun multG (alpha2, h), apply_fun invG alpha2) | h :e H2})
      Halpha2Pack). }
  claim Hinvalpha2G : apply_fun invG alpha2 :e G. { exact (Hfn_inv alpha2 Halpha2G). }
  claim Hinv_inv_alpha2 : apply_fun invG (apply_fun invG alpha2) = alpha2.
  { exact (group_inv_inv G multG invG eG alpha2 Hfn_mult Hfn_inv HeGG Hassoc Hident Hinverse Halpha2G). }
  claim HH2_sub_H0 : H2 c= H0.
  { let h2. assume Hh2H2.
    claim Hh2G : h2 :e G. { exact (HH2_sub_G h2 Hh2H2). }
    claim Hcv2 : apply_fun multG (apply_fun multG (alpha2, h2), apply_fun invG alpha2) :e H0.
    { rewrite HH0eq2. exact (ReplI H2 (fun h:set => apply_fun multG (apply_fun multG (alpha2, h), apply_fun invG alpha2)) h2 Hh2H2). }
    claim HcvG2 : apply_fun multG (apply_fun multG (alpha2, h2), apply_fun invG alpha2) :e G.
    { exact (subgroup_of_subset H0 G multG eG invG HH0_sub (apply_fun multG (apply_fun multG (alpha2, h2), apply_fun invG alpha2)) Hcv2). }
    claim Ha2h2G : apply_fun multG (alpha2, h2) :e G.
    { exact (Hfn_mult (alpha2, h2) (tuple_2_setprod_by_pair_Sigma G G alpha2 h2 Halpha2G Hh2G)). }
    claim Hnorm2 : apply_fun multG (apply_fun multG (apply_fun invG alpha2, apply_fun multG (apply_fun multG (alpha2, h2), apply_fun invG alpha2)), apply_fun invG (apply_fun invG alpha2)) :e H0.
    { exact (Hconj_closed (apply_fun multG (apply_fun multG (alpha2, h2), apply_fun invG alpha2)) (apply_fun invG alpha2) Hcv2 Hinvalpha2G). }
    claim Hc1' : apply_fun multG (apply_fun invG alpha2, alpha2) = eG.
    { exact (andER (apply_fun multG (alpha2, apply_fun invG alpha2) = eG)
        (apply_fun multG (apply_fun invG alpha2, alpha2) = eG) (Hinverse alpha2 Halpha2G)). }
    claim Hl1' : apply_fun multG (eG, h2) = h2.
    { exact (andEL (apply_fun multG (eG, h2) = h2) (apply_fun multG (h2, eG) = h2) (Hident h2 Hh2G)). }
    claim Hchain2 : apply_fun multG (apply_fun multG (apply_fun invG alpha2, apply_fun multG (apply_fun multG (alpha2, h2), apply_fun invG alpha2)), apply_fun invG (apply_fun invG alpha2)) = h2.
    { rewrite Hinv_inv_alpha2.
      rewrite (Hassoc (apply_fun invG alpha2) (apply_fun multG (apply_fun multG (alpha2, h2), apply_fun invG alpha2)) alpha2 Hinvalpha2G HcvG2 Halpha2G).
      rewrite (Hassoc (apply_fun multG (alpha2, h2)) (apply_fun invG alpha2) alpha2 Ha2h2G Hinvalpha2G Halpha2G).
      rewrite Hc1'.
      rewrite (andER (apply_fun multG (eG, apply_fun multG (alpha2, h2)) = apply_fun multG (alpha2, h2))
        (apply_fun multG (apply_fun multG (alpha2, h2), eG) = apply_fun multG (alpha2, h2))
        (Hident (apply_fun multG (alpha2, h2)) Ha2h2G)).
      rewrite (eq_symm
        (apply_fun multG (apply_fun multG (apply_fun invG alpha2, alpha2), h2))
        (apply_fun multG (apply_fun invG alpha2, apply_fun multG (alpha2, h2)))
        (Hassoc (apply_fun invG alpha2) alpha2 h2 Hinvalpha2G Halpha2G Hh2G)).
      rewrite Hc1'. rewrite Hl1'. reflexivity. }
    rewrite <- Hchain2. exact Hnorm2. }
  claim HH0_sub_H2 : H0 c= H2.
  { let h0. assume Hh0H0.
    claim Hh0G : h0 :e G. { exact (subgroup_of_subset H0 G multG eG invG HH0_sub h0 Hh0H0). }
    claim Hch0' : apply_fun multG (apply_fun multG (alpha2, h0), apply_fun invG alpha2) :e H0.
    { exact (Hconj_closed h0 alpha2 Hh0H0 Halpha2G). }
    claim Hch0_repl' : apply_fun multG (apply_fun multG (alpha2, h0), apply_fun invG alpha2) :e
      {apply_fun multG (apply_fun multG (alpha2, h), apply_fun invG alpha2) | h :e H2}.
    { rewrite <- HH0eq2. exact Hch0'. }
    apply (ReplE_impred H2 (fun h:set => apply_fun multG (apply_fun multG (alpha2, h), apply_fun invG alpha2))
      (apply_fun multG (apply_fun multG (alpha2, h0), apply_fun invG alpha2)) Hch0_repl').
    let h'. assume Hh'H2 Heq'.
    claim Hh'G : h' :e G. { exact (HH2_sub_G h' Hh'H2). }
    claim Hah0G' : apply_fun multG (alpha2, h0) :e G.
    { exact (Hfn_mult (alpha2, h0) (tuple_2_setprod_by_pair_Sigma G G alpha2 h0 Halpha2G Hh0G)). }
    claim Hah'G' : apply_fun multG (alpha2, h') :e G.
    { exact (Hfn_mult (alpha2, h') (tuple_2_setprod_by_pair_Sigma G G alpha2 h' Halpha2G Hh'G)). }
    claim Hrc' : apply_fun multG (alpha2, h0) = apply_fun multG (alpha2, h').
    { exact (group_right_cancel G multG eG invG (apply_fun invG alpha2) (apply_fun multG (alpha2, h0)) (apply_fun multG (alpha2, h'))
        HgrpG Hinvalpha2G Hah0G' Hah'G' Heq'). }
    claim Hlc' : h0 = h'.
    { exact (group_left_cancel G multG eG invG alpha2 h0 h' HgrpG Halpha2G Hh0G Hh'G Hrc'). }
    rewrite Hlc'. exact Hh'H2. }
  claim HH0eqH2 : H0 = H2.
  { exact (set_ext H0 H2 HH0_sub_H2 HH2_sub_H0). }
  (** Apply thm79_2 backward **)
  claim Hthm79_2_e1 : exists h01:set,
    homeomorphism E Te E Te h01 /\ apply_fun h01 e0 = e1 /\
    (forall x:set, x :e E -> apply_fun p x = apply_fun p (apply_fun h01 x)).
  { exact (iffER
      (exists h01:set, homeomorphism E Te E Te h01 /\ apply_fun h01 e0 = e1 /\
        (forall x:set, x :e E -> apply_fun p x = apply_fun p (apply_fun h01 x)))
      (H0 = H1)
      (thm79_2_equivalence_iff_same_subgroup E Te E Te B Tb p p e0 e1
        Hcov Hcov He0E He1E Hpe0pe1 HpcE HlpE HpcE HlpE)
      HH0eqH1). }
  claim Hthm79_2_e2 : exists h02:set,
    homeomorphism E Te E Te h02 /\ apply_fun h02 e0 = e2 /\
    (forall x:set, x :e E -> apply_fun p x = apply_fun p (apply_fun h02 x)).
  { exact (iffER
      (exists h02:set, homeomorphism E Te E Te h02 /\ apply_fun h02 e0 = e2 /\
        (forall x:set, x :e E -> apply_fun p x = apply_fun p (apply_fun h02 x)))
      (H0 = H2)
      (thm79_2_equivalence_iff_same_subgroup E Te E Te B Tb p p e0 e2
        Hcov Hcov He0E He2E Hpe0pe2 HpcE HlpE HpcE HlpE)
      HH0eqH2). }
  apply Hthm79_2_e1. let h01. assume Hh01Pack.
  apply Hthm79_2_e2. let h02. assume Hh02Pack.
  claim Hh01_p : forall x:set, x :e E -> apply_fun p x = apply_fun p (apply_fun h01 x).
  { exact (andER (homeomorphism E Te E Te h01 /\ apply_fun h01 e0 = e1)
      (forall x:set, x :e E -> apply_fun p x = apply_fun p (apply_fun h01 x))
      Hh01Pack). }
  claim Hh01_left : homeomorphism E Te E Te h01 /\ apply_fun h01 e0 = e1.
  { exact (andEL (homeomorphism E Te E Te h01 /\ apply_fun h01 e0 = e1)
      (forall x:set, x :e E -> apply_fun p x = apply_fun p (apply_fun h01 x))
      Hh01Pack). }
  claim Hh01_homeo : homeomorphism E Te E Te h01.
  { exact (andEL (homeomorphism E Te E Te h01) (apply_fun h01 e0 = e1) Hh01_left). }
  claim Hh01_e0 : apply_fun h01 e0 = e1.
  { exact (andER (homeomorphism E Te E Te h01) (apply_fun h01 e0 = e1) Hh01_left). }
  claim Hh02_p : forall x:set, x :e E -> apply_fun p x = apply_fun p (apply_fun h02 x).
  { exact (andER (homeomorphism E Te E Te h02 /\ apply_fun h02 e0 = e2)
      (forall x:set, x :e E -> apply_fun p x = apply_fun p (apply_fun h02 x))
      Hh02Pack). }
  claim Hh02_left : homeomorphism E Te E Te h02 /\ apply_fun h02 e0 = e2.
  { exact (andEL (homeomorphism E Te E Te h02 /\ apply_fun h02 e0 = e2)
      (forall x:set, x :e E -> apply_fun p x = apply_fun p (apply_fun h02 x))
      Hh02Pack). }
  claim Hh02_homeo : homeomorphism E Te E Te h02.
  { exact (andEL (homeomorphism E Te E Te h02) (apply_fun h02 e0 = e2) Hh02_left). }
  claim Hh02_e0 : apply_fun h02 e0 = e2.
  { exact (andER (homeomorphism E Te E Te h02) (apply_fun h02 e0 = e2) Hh02_left). }
  (** Get inverse of h01 **)
  claim Hg01_ex : exists g01:set, continuous_map E Te E Te g01 /\
    (forall x:set, x :e E -> apply_fun g01 (apply_fun h01 x) = x) /\
    (forall y:set, y :e E -> apply_fun h01 (apply_fun g01 y) = y).
  { exact (homeomorphism_inverse_package E Te E Te h01 Hh01_homeo). }
  apply Hg01_ex. let g01. assume Hg01Pack.
  claim Hg01_AB : continuous_map E Te E Te g01 /\ (forall x:set, x :e E -> apply_fun g01 (apply_fun h01 x) = x).
  { exact (andEL (continuous_map E Te E Te g01 /\ (forall x:set, x :e E -> apply_fun g01 (apply_fun h01 x) = x))
      (forall y:set, y :e E -> apply_fun h01 (apply_fun g01 y) = y) Hg01Pack). }
  claim Hg01_cont : continuous_map E Te E Te g01.
  { exact (andEL (continuous_map E Te E Te g01)
      (forall x:set, x :e E -> apply_fun g01 (apply_fun h01 x) = x) Hg01_AB). }
  claim Hg01_left : forall x:set, x :e E -> apply_fun g01 (apply_fun h01 x) = x.
  { exact (andER (continuous_map E Te E Te g01)
      (forall x:set, x :e E -> apply_fun g01 (apply_fun h01 x) = x) Hg01_AB). }
  claim Hg01_right : forall y:set, y :e E -> apply_fun h01 (apply_fun g01 y) = y.
  { exact (andER (continuous_map E Te E Te g01 /\ (forall x:set, x :e E -> apply_fun g01 (apply_fun h01 x) = x))
      (forall y:set, y :e E -> apply_fun h01 (apply_fun g01 y) = y) Hg01Pack). }
  claim Hg01_e1 : apply_fun g01 e1 = e0.
  { rewrite <- Hh01_e0. exact (Hg01_left e0 He0E). }
  claim Hg01_p : forall y:set, y :e E -> apply_fun p (apply_fun g01 y) = apply_fun p y.
  { let y. assume HyE.
    claim Ht : apply_fun p (apply_fun g01 y) = apply_fun p (apply_fun h01 (apply_fun g01 y)).
    { exact (Hh01_p (apply_fun g01 y) (continuous_map_value_in_space E Te E Te g01 y Hg01_cont HyE)). }
    claim Hsub : apply_fun p (apply_fun h01 (apply_fun g01 y)) = apply_fun p y.
    { rewrite (Hg01_right y HyE). reflexivity. }
    rewrite Ht. exact Hsub. }
  claim Hg01_homeo : homeomorphism E Te E Te g01.
  { exact (homeomorphism_inverse_is_homeomorphism E Te E Te h01 g01
      Hh01_homeo Hg01_cont Hg01_left Hg01_right). }
  set h := compose_fun E g01 h02.
  claim Hh_homeo : homeomorphism E Te E Te h.
  { exact (homeomorphism_compose E Te E Te E Te g01 h02 Hg01_homeo Hh02_homeo). }
  claim Hh_e1 : apply_fun h e1 = e2.
  { claim Ht : apply_fun h e1 = apply_fun h02 (apply_fun g01 e1).
    { exact (compose_fun_apply E g01 h02 e1 He1E). }
    claim Hsub : apply_fun h02 (apply_fun g01 e1) = e2.
    { rewrite Hg01_e1. exact Hh02_e0. }
    rewrite Ht. exact Hsub. }
  claim Hh_p : forall x:set, x :e E -> apply_fun p (apply_fun h x) = apply_fun p x.
  { let x. assume HxE.
    claim Ht : apply_fun h x = apply_fun h02 (apply_fun g01 x).
    { exact (compose_fun_apply E g01 h02 x HxE). }
    rewrite Ht.
    claim Hg01xE : apply_fun g01 x :e E.
    { exact (continuous_map_value_in_space E Te E Te g01 x Hg01_cont HxE). }
    claim Ht2 : apply_fun p (apply_fun g01 x) = apply_fun p (apply_fun h02 (apply_fun g01 x)).
    { exact (Hh02_p (apply_fun g01 x) Hg01xE). }
    claim Ht3 : apply_fun p (apply_fun g01 x) = apply_fun p x.
    { exact (Hg01_p x HxE). }
    rewrite <- Ht2. exact Ht3. }
  witness h.
  apply andI.
  - prove covering_transformation E Te B Tb p h.
    prove homeomorphism E Te E Te h /\ (forall x:set, x :e E -> apply_fun p (apply_fun h x) = apply_fun p x).
    apply andI. exact Hh_homeo. exact Hh_p.
  - exact Hh_e1.
- (** Backward: transitive => regular_covering_map **)
  assume Htrans.
  prove (covering_map E Te B Tb p /\ e0 :e E) /\ normal_subgroup H0 G multG eG invG.
  apply andI.
  + apply andI. exact Hcov. exact He0E.
  + prove subgroup_of H0 G multG eG invG /\
      (forall n g:set, n :e H0 -> g :e G ->
        apply_fun multG (apply_fun multG (g, n), apply_fun invG g) :e H0).
    apply andI. exact HH0_sub.
    let n g. assume HnH0 HgG.
    (** Get representative of n from H0(e0) **)
    claim HnH0_mem : exists cls0:set, cls0 :e fundamental_group E Te e0 /\
      n = apply_fun (induced_homomorphism E Te e0 B Tb b0 p) cls0.
    { exact (iffEL
        (n :e homomorphism_image (fundamental_group E Te e0) (induced_homomorphism E Te e0 B Tb b0 p))
        (exists cls0:set, cls0 :e fundamental_group E Te e0 /\ n = apply_fun (induced_homomorphism E Te e0 B Tb b0 p) cls0)
        (homomorphism_image_mem (fundamental_group E Te e0) (induced_homomorphism E Te e0 B Tb b0 p) n) HnH0). }
    apply HnH0_mem. let cls0. assume Hcls0Pack.
    claim Hcls0FG : cls0 :e fundamental_group E Te e0.
    { exact (andEL (cls0 :e fundamental_group E Te e0) (n = apply_fun (induced_homomorphism E Te e0 B Tb b0 p) cls0) Hcls0Pack). }
    claim Hn_eq : n = apply_fun (induced_homomorphism E Te e0 B Tb b0 p) cls0.
    { exact (andER (cls0 :e fundamental_group E Te e0) (n = apply_fun (induced_homomorphism E Te e0 B Tb b0 p) cls0) Hcls0Pack). }
    claim Hcls0_rep : exists f0:set, f0 :e loop_space E Te e0 /\ cls0 = path_homotopy_class_loop E Te e0 f0.
    { exact (fundamental_group_member_has_representative E Te e0 cls0 Hcls0FG). }
    apply Hcls0_rep. let f0. assume Hf0Pack.
    claim Hf0_ls : f0 :e loop_space E Te e0.
    { exact (andEL (f0 :e loop_space E Te e0) (cls0 = path_homotopy_class_loop E Te e0 f0) Hf0Pack). }
    claim Hcls0_eq : cls0 = path_homotopy_class_loop E Te e0 f0.
    { exact (andER (f0 :e loop_space E Te e0) (cls0 = path_homotopy_class_loop E Te e0 f0) Hf0Pack). }
    claim Hf0_la : loop_at E Te e0 f0. { exact (loop_space_has_loop_at E Te e0 f0 Hf0_ls). }
    claim Hf0_la_left : continuous_map unit_interval unit_interval_topology E Te f0 /\ apply_fun f0 0 = e0.
    { exact (andEL (continuous_map unit_interval unit_interval_topology E Te f0 /\ apply_fun f0 0 = e0) (apply_fun f0 1 = e0) Hf0_la). }
    claim Hf0_cont : continuous_map unit_interval unit_interval_topology E Te f0.
    { exact (andEL (continuous_map unit_interval unit_interval_topology E Te f0) (apply_fun f0 0 = e0) Hf0_la_left). }
    claim Hf0_0 : apply_fun f0 0 = e0.
    { exact (andER (continuous_map unit_interval unit_interval_topology E Te f0) (apply_fun f0 0 = e0) Hf0_la_left). }
    claim Hf0_1 : apply_fun f0 1 = e0.
    { exact (andER (continuous_map unit_interval unit_interval_topology E Te f0 /\ apply_fun f0 0 = e0) (apply_fun f0 1 = e0) Hf0_la). }
    (** Get representative of g **)
    claim Hg_rep : exists alpha_loop:set, alpha_loop :e loop_space B Tb b0 /\ g = path_homotopy_class_loop B Tb b0 alpha_loop.
    { exact (fundamental_group_member_has_representative B Tb b0 g HgG). }
    apply Hg_rep. let al. assume HalPack.
    claim Hal_ls : al :e loop_space B Tb b0.
    { exact (andEL (al :e loop_space B Tb b0) (g = path_homotopy_class_loop B Tb b0 al) HalPack). }
    claim Hg_eq : g = path_homotopy_class_loop B Tb b0 al.
    { exact (andER (al :e loop_space B Tb b0) (g = path_homotopy_class_loop B Tb b0 al) HalPack). }
    claim Hal_la : loop_at B Tb b0 al. { exact (loop_space_has_loop_at B Tb b0 al Hal_ls). }
    claim Hal_la_left : continuous_map unit_interval unit_interval_topology B Tb al /\ apply_fun al 0 = b0.
    { exact (andEL (continuous_map unit_interval unit_interval_topology B Tb al /\ apply_fun al 0 = b0) (apply_fun al 1 = b0) Hal_la). }
    claim Hal_cont : continuous_map unit_interval unit_interval_topology B Tb al.
    { exact (andEL (continuous_map unit_interval unit_interval_topology B Tb al) (apply_fun al 0 = b0) Hal_la_left). }
    claim Hal_0 : apply_fun al 0 = b0.
    { exact (andER (continuous_map unit_interval unit_interval_topology B Tb al) (apply_fun al 0 = b0) Hal_la_left). }
    claim Hal_1 : apply_fun al 1 = b0.
    { exact (andER (continuous_map unit_interval unit_interval_topology B Tb al /\ apply_fun al 0 = b0) (apply_fun al 1 = b0) Hal_la). }
    (** Lift al from e0 **)
    set sigma := path_lift E Te B Tb p e0 al.
    set e1' := apply_fun sigma 1.
    claim Hlift_props : (continuous_map unit_interval unit_interval_topology E Te sigma /\ apply_fun sigma 0 = e0) /\
      (forall t:set, t :e unit_interval -> apply_fun p (apply_fun sigma t) = apply_fun al t).
    { exact (lemma54_1_path_lifting E Te B Tb p e0 al Hcov He0E (eq_symm (apply_fun al 0) b0 Hal_0) Hal_cont). }
    claim Hlift_left : continuous_map unit_interval unit_interval_topology E Te sigma /\ apply_fun sigma 0 = e0.
    { exact (andEL (continuous_map unit_interval unit_interval_topology E Te sigma /\ apply_fun sigma 0 = e0)
        (forall t:set, t :e unit_interval -> apply_fun p (apply_fun sigma t) = apply_fun al t)
        Hlift_props). }
    claim Hsigma_cont : continuous_map unit_interval unit_interval_topology E Te sigma.
    { exact (andEL (continuous_map unit_interval unit_interval_topology E Te sigma) (apply_fun sigma 0 = e0) Hlift_left). }
    claim Hsigma_0 : apply_fun sigma 0 = e0.
    { exact (andER (continuous_map unit_interval unit_interval_topology E Te sigma) (apply_fun sigma 0 = e0) Hlift_left). }
    claim Hsigma_proj : forall t:set, t :e unit_interval -> apply_fun p (apply_fun sigma t) = apply_fun al t.
    { exact (andER (continuous_map unit_interval unit_interval_topology E Te sigma /\ apply_fun sigma 0 = e0)
        (forall t:set, t :e unit_interval -> apply_fun p (apply_fun sigma t) = apply_fun al t)
        Hlift_props). }
    claim Hpe1' : apply_fun p e1' = b0.
    { claim Ht : apply_fun p (apply_fun sigma 1) = apply_fun al 1.
      { exact (Hsigma_proj 1 one_in_unit_interval). }
      rewrite Ht. exact Hal_1. }
    claim He1'E : e1' :e E.
    { exact (continuous_map_value_in_space unit_interval unit_interval_topology E Te sigma 1 Hsigma_cont one_in_unit_interval). }
    (** By transitivity, exists h_ct with h_ct(e0) = e1' **)
    claim Htrans_e1' : exists hct:set, covering_transformation E Te B Tb p hct /\ apply_fun hct e0 = e1'.
    { exact (Htrans e0 e1' He0E He1'E (eq_refl b0) Hpe1'). }
    apply Htrans_e1'. let hct. assume HhctPack.
    claim Hhct_ct : covering_transformation E Te B Tb p hct.
    { exact (andEL (covering_transformation E Te B Tb p hct) (apply_fun hct e0 = e1') HhctPack). }
    claim Hhct_e0 : apply_fun hct e0 = e1'.
    { exact (andER (covering_transformation E Te B Tb p hct) (apply_fun hct e0 = e1') HhctPack). }
    claim Hhct_homeo : homeomorphism E Te E Te hct.
    { exact (andEL (homeomorphism E Te E Te hct) (forall x:set, x :e E -> apply_fun p (apply_fun hct x) = apply_fun p x) Hhct_ct). }
    claim Hhct_p : forall x:set, x :e E -> apply_fun p (apply_fun hct x) = apply_fun p x.
    { exact (andER (homeomorphism E Te E Te hct) (forall x:set, x :e E -> apply_fun p (apply_fun hct x) = apply_fun p x) Hhct_ct). }
    (** H0(e0) = H0(e1') via thm79_2 forward **)
    claim Hpe0pe1' : apply_fun p e0 = apply_fun p e1'.
    { claim Htmp3 : b0 = apply_fun p e1'.
      { exact (eq_symm (apply_fun p e1') b0 Hpe1'). }
      exact Htmp3. }
    set H1' := homomorphism_image (fundamental_group E Te e1') (induced_homomorphism E Te e1' B Tb (apply_fun p e1') p).
    claim Hhct_witness : exists h':set, homeomorphism E Te E Te h' /\ apply_fun h' e0 = e1' /\
        (forall x:set, x :e E -> apply_fun p x = apply_fun p (apply_fun h' x)).
    { witness hct.
      prove (homeomorphism E Te E Te hct /\ apply_fun hct e0 = e1') /\
        (forall x:set, x :e E -> apply_fun p x = apply_fun p (apply_fun hct x)).
      apply andI.
      - apply andI. exact Hhct_homeo. exact Hhct_e0.
      - let x. assume HxE.
        exact (eq_symm (apply_fun p (apply_fun hct x)) (apply_fun p x) (Hhct_p x HxE)). }
    claim HH0_eq_H1' : H0 = H1'.
    { exact (iffEL
        (exists h':set, homeomorphism E Te E Te h' /\ apply_fun h' e0 = e1' /\
            (forall x:set, x :e E -> apply_fun p x = apply_fun p (apply_fun h' x)))
        (H0 = H1')
        (thm79_2_equivalence_iff_same_subgroup E Te E Te B Tb p p e0 e1'
          Hcov Hcov He0E He1'E Hpe0pe1' HpcE HlpE HpcE HlpE)
        Hhct_witness). }
    (** n :e H1' **)
    claim HnH1' : n :e H1'.
    { rewrite <- HH0_eq_H1'. exact HnH0. }
    (** Get representative of n in H1' **)
    claim HnH1'_mem : exists cls1':set, cls1' :e fundamental_group E Te e1' /\
      n = apply_fun (induced_homomorphism E Te e1' B Tb (apply_fun p e1') p) cls1'.
    { exact (iffEL
        (n :e homomorphism_image (fundamental_group E Te e1') (induced_homomorphism E Te e1' B Tb (apply_fun p e1') p))
        (exists cls1':set, cls1' :e fundamental_group E Te e1' /\ n = apply_fun (induced_homomorphism E Te e1' B Tb (apply_fun p e1') p) cls1')
        (homomorphism_image_mem (fundamental_group E Te e1') (induced_homomorphism E Te e1' B Tb (apply_fun p e1') p) n) HnH1'). }
    apply HnH1'_mem. let cls1'. assume Hcls1'Pack.
    claim Hcls1'FG : cls1' :e fundamental_group E Te e1'.
    { exact (andEL (cls1' :e fundamental_group E Te e1') (n = apply_fun (induced_homomorphism E Te e1' B Tb (apply_fun p e1') p) cls1') Hcls1'Pack). }
    claim Hn_eq1' : n = apply_fun (induced_homomorphism E Te e1' B Tb (apply_fun p e1') p) cls1'.
    { exact (andER (cls1' :e fundamental_group E Te e1') (n = apply_fun (induced_homomorphism E Te e1' B Tb (apply_fun p e1') p) cls1') Hcls1'Pack). }
    claim Hcls1'_rep : exists f1:set, f1 :e loop_space E Te e1' /\ cls1' = path_homotopy_class_loop E Te e1' f1.
    { exact (fundamental_group_member_has_representative E Te e1' cls1' Hcls1'FG). }
    apply Hcls1'_rep. let f1. assume Hf1Pack.
    claim Hf1_ls : f1 :e loop_space E Te e1'.
    { exact (andEL (f1 :e loop_space E Te e1') (cls1' = path_homotopy_class_loop E Te e1' f1) Hf1Pack). }
    claim Hcls1'_eq : cls1' = path_homotopy_class_loop E Te e1' f1.
    { exact (andER (f1 :e loop_space E Te e1') (cls1' = path_homotopy_class_loop E Te e1' f1) Hf1Pack). }
    claim Hf1_la : loop_at E Te e1' f1. { exact (loop_space_has_loop_at E Te e1' f1 Hf1_ls). }
    claim Hf1_la_left : continuous_map unit_interval unit_interval_topology E Te f1 /\ apply_fun f1 0 = e1'.
    { exact (andEL (continuous_map unit_interval unit_interval_topology E Te f1 /\ apply_fun f1 0 = e1') (apply_fun f1 1 = e1') Hf1_la). }
    claim Hf1_cont : continuous_map unit_interval unit_interval_topology E Te f1.
    { exact (andEL (continuous_map unit_interval unit_interval_topology E Te f1) (apply_fun f1 0 = e1') Hf1_la_left). }
    claim Hf1_0 : apply_fun f1 0 = e1'.
    { exact (andER (continuous_map unit_interval unit_interval_topology E Te f1) (apply_fun f1 0 = e1') Hf1_la_left). }
    claim Hf1_1 : apply_fun f1 1 = e1'.
    { exact (andER (continuous_map unit_interval unit_interval_topology E Te f1 /\ apply_fun f1 0 = e1') (apply_fun f1 1 = e1') Hf1_la). }
    set pf1 := compose_fun unit_interval f1 p.
    claim Hpf1_cont : continuous_map unit_interval unit_interval_topology B Tb pf1.
    { exact (composition_continuous unit_interval unit_interval_topology E Te B Tb f1 p Hf1_cont Hp_cont). }
    claim Hpf1_0 : apply_fun pf1 0 = b0.
    { claim Ht : apply_fun pf1 0 = apply_fun p (apply_fun f1 0). { exact (compose_fun_apply unit_interval f1 p 0 zero_in_unit_interval). }
      claim Hsub : apply_fun p (apply_fun f1 0) = b0. { rewrite Hf1_0. exact Hpe1'. }
      rewrite Ht. exact Hsub. }
    claim Hpf1_1 : apply_fun pf1 1 = b0.
    { claim Ht : apply_fun pf1 1 = apply_fun p (apply_fun f1 1). { exact (compose_fun_apply unit_interval f1 p 1 one_in_unit_interval). }
      claim Hsub : apply_fun p (apply_fun f1 1) = b0. { rewrite Hf1_1. exact Hpe1'. }
      rewrite Ht. exact Hsub. }
    claim Hpf1_la : loop_at B Tb b0 pf1.
    { prove (continuous_map unit_interval unit_interval_topology B Tb pf1 /\ apply_fun pf1 0 = b0) /\ apply_fun pf1 1 = b0.
      apply andI. apply andI. exact Hpf1_cont. exact Hpf1_0. exact Hpf1_1. }
    (** n = [pf1] via Eps_i chain **)
    claim Hih_eq : apply_fun (induced_homomorphism E Te e1' B Tb (apply_fun p e1') p)
        (path_homotopy_class_loop E Te e1' f1)
        = path_homotopy_class_loop B Tb (apply_fun p e1')
          (compose_fun unit_interval
            (Eps_i (fun w:set => w :e path_homotopy_class_loop E Te e1' f1)) p).
    { exact (induced_homomorphism_apply_on_loop_class E Te e1' B Tb (apply_fun p e1') p f1 Hf1_ls). }
    set eps_f1 := Eps_i (fun w:set => w :e path_homotopy_class_loop E Te e1' f1).
    claim Heps_in : eps_f1 :e path_homotopy_class_loop E Te e1' f1.
    { exact (Eps_i_ax (fun w:set => w :e path_homotopy_class_loop E Te e1' f1) f1
        (loop_in_own_path_homotopy_class E Te e1' f1 Hf1_ls)). }
    claim Heps_htpy : path_homotopic E Te e1' e1' f1 eps_f1.
    { exact (path_homotopy_class_loop_has_homotopy E Te e1' f1 eps_f1 Heps_in). }
    claim Hpost : path_homotopic B Tb (apply_fun p e1') (apply_fun p e1')
      (compose_fun unit_interval f1 p) (compose_fun unit_interval eps_f1 p).
    { exact (path_homotopic_postcompose E Te B Tb e1' e1' (apply_fun p e1') (apply_fun p e1') f1 eps_f1 p
        Heps_htpy Hp_cont (eq_refl (apply_fun p e1')) (eq_refl (apply_fun p e1'))). }
    claim Hclass_eq : path_homotopy_class_loop B Tb (apply_fun p e1') (compose_fun unit_interval f1 p)
      = path_homotopy_class_loop B Tb (apply_fun p e1') (compose_fun unit_interval eps_f1 p).
    { exact (path_homotopy_class_loop_eq_of_path_homotopic B Tb (apply_fun p e1')
        (compose_fun unit_interval f1 p) (compose_fun unit_interval eps_f1 p) Hpost). }
    claim Hn_pf1 : n = path_homotopy_class_loop B Tb b0 pf1.
    { rewrite Hn_eq1'. rewrite Hcls1'_eq. rewrite Hih_eq.
      rewrite <- Hclass_eq. rewrite Hpe1'. reflexivity. }
    (** lift(pf1, e1')(1) = e1' by thm54_6c_forward at e1' **)
    claim Hpf1_loop_at_pe1' : loop_at B Tb (apply_fun p e1') pf1.
    { rewrite Hpe1'. exact Hpf1_la. }
    claim HnH1'_pe1' : path_homotopy_class_loop B Tb (apply_fun p e1') pf1 :e H1'.
    { claim Htmp : path_homotopy_class_loop B Tb (apply_fun p e1') pf1 = n.
      { rewrite Hpe1'. exact (eq_symm n (path_homotopy_class_loop B Tb b0 pf1) Hn_pf1). }
      rewrite Htmp. exact HnH1'. }
    claim Hlift_pf1_closes : apply_fun (path_lift E Te B Tb p e1' pf1) 1 = e1'.
    { exact (thm54_6c_loop_characterization_forward E Te B Tb p e1' pf1 Hcov He1'E Hpf1_loop_at_pe1' HnH1'_pe1'). }
    (** Build concatenation: al . pf1 . rev_al **)
    claim Hmatch1 : apply_fun al 1 = apply_fun pf1 0. { rewrite Hal_1. rewrite Hpf1_0. exact (eq_refl b0). }
    set al_pf1 := path_concat al pf1.
    claim Hal_pf1_cont : continuous_map unit_interval unit_interval_topology B Tb al_pf1.
    { exact (path_concat_continuous B Tb b0 b0 b0 al pf1 Hal_cont Hpf1_cont Hal_0 Hal_1 Hpf1_0 Hpf1_1). }
    claim Hlift_al_pf1_end : apply_fun (path_lift E Te B Tb p e0 al_pf1) 1 = e1'.
    { claim Hce : apply_fun (path_lift E Te B Tb p e0 al_pf1) 1
        = apply_fun (path_lift E Te B Tb p (apply_fun (path_lift E Te B Tb p e0 al) 1) pf1) 1.
      { exact (path_lift_concat_endpoint E Te B Tb p e0 al pf1 Hcov He0E Hal_cont Hpf1_cont Hmatch1 (eq_symm (apply_fun al 0) b0 Hal_0)). }
      rewrite Hce. exact Hlift_pf1_closes. }
    set rev_al := reverse_path al.
    claim Hrev_al_cont : continuous_map unit_interval unit_interval_topology B Tb rev_al.
    { exact (reverse_path_continuous B Tb al Hal_cont). }
    claim Hrev_al_0 : apply_fun rev_al 0 = b0.
    { claim Ht : apply_fun (reverse_path al) 0 = apply_fun al 1. { exact (reverse_path_at_zero al). }
      rewrite Ht. exact Hal_1. }
    claim Hrev_al_1 : apply_fun rev_al 1 = b0.
    { claim Ht : apply_fun (reverse_path al) 1 = apply_fun al 0. { exact (reverse_path_at_one al). }
      rewrite Ht. exact Hal_0. }
    claim Hmatch2 : apply_fun al_pf1 1 = apply_fun rev_al 0.
    { claim Hap1 : apply_fun al_pf1 1 = apply_fun pf1 1. { exact (path_concat_at_one al pf1). }
      rewrite Hap1. rewrite Hpf1_1. rewrite Hrev_al_0. exact (eq_refl b0). }
    set full_path := path_concat al_pf1 rev_al.
    claim Hal_pf1_0 : apply_fun al_pf1 0 = b0.
    { claim Ht : apply_fun (path_concat al pf1) 0 = apply_fun al 0. { exact (path_concat_at_zero al pf1). }
      rewrite Ht. exact Hal_0. }
    claim Hal_pf1_1 : apply_fun al_pf1 1 = b0.
    { claim Ht : apply_fun (path_concat al pf1) 1 = apply_fun pf1 1. { exact (path_concat_at_one al pf1). }
      rewrite Ht. exact Hpf1_1. }
    (** lift(full_path, e0)(1) = e0 **)
    claim Hfull_lift_end : apply_fun (path_lift E Te B Tb p e0 full_path) 1 = e0.
    { claim Hce2 : apply_fun (path_lift E Te B Tb p e0 full_path) 1
        = apply_fun (path_lift E Te B Tb p (apply_fun (path_lift E Te B Tb p e0 al_pf1) 1) rev_al) 1.
      { exact (path_lift_concat_endpoint E Te B Tb p e0 al_pf1 rev_al Hcov He0E Hal_pf1_cont Hrev_al_cont Hmatch2 (eq_symm (apply_fun al_pf1 0) b0 Hal_pf1_0)). }
      rewrite Hce2. rewrite Hlift_al_pf1_end.
      exact (path_lift_reverse_endpoint E Te B Tb p e0 al Hcov He0E Hal_cont (eq_symm (apply_fun al 0) b0 Hal_0)). }
    (** full_path is a loop at b0 **)
    claim Hfull_cont : continuous_map unit_interval unit_interval_topology B Tb full_path.
    { exact (path_concat_continuous B Tb b0 b0 b0 al_pf1 rev_al
        Hal_pf1_cont Hrev_al_cont Hal_pf1_0 Hal_pf1_1 Hrev_al_0 Hrev_al_1). }
    claim Hfull_0 : apply_fun full_path 0 = b0.
    { claim Ht : apply_fun (path_concat al_pf1 rev_al) 0 = apply_fun al_pf1 0. { exact (path_concat_at_zero al_pf1 rev_al). }
      rewrite Ht. exact Hal_pf1_0. }
    claim Hfull_1 : apply_fun full_path 1 = b0.
    { claim Ht : apply_fun (path_concat al_pf1 rev_al) 1 = apply_fun rev_al 1. { exact (path_concat_at_one al_pf1 rev_al). }
      rewrite Ht. exact Hrev_al_1. }
    claim Hfull_la : loop_at B Tb b0 full_path.
    { prove (continuous_map unit_interval unit_interval_topology B Tb full_path /\ apply_fun full_path 0 = b0) /\ apply_fun full_path 1 = b0.
      apply andI. apply andI. exact Hfull_cont. exact Hfull_0. exact Hfull_1. }
    (** [full_path] :e H0 **)
    claim Hfull_in_H0 : path_homotopy_class_loop B Tb b0 full_path :e H0.
    { exact (thm54_6c_loop_characterization_backward E Te B Tb p e0 full_path Hcov He0E Hfull_la Hfull_lift_end). }
    (** Now show [full_path] = g . n . inv(g) **)
    (** [full_path] = [al_pf1 . rev_al] = mult([al_pf1], [rev_al]) **)
    (** [al_pf1] = [al . pf1] = mult([al], [pf1]) = mult(g, n) **)
    (** [rev_al] = inv([al]) = inv(g) **)
    (** So [full_path] = mult(mult(g, n), inv(g)) = g.n.inv(g) **)
    claim Hfull_eq : path_homotopy_class_loop B Tb b0 full_path
      = apply_fun multG (apply_fun multG (g, n), apply_fun invG g).
    { (** Step 1: [al . pf1] = mult([al], [pf1]) **)
      claim Hclass_al_pf1 : path_homotopy_class_loop B Tb b0 al_pf1
        = apply_fun multG (path_homotopy_class_loop B Tb b0 al, path_homotopy_class_loop B Tb b0 pf1).
      { claim Hpf1_ls : pf1 :e loop_space B Tb b0.
        { exact (loop_space_postcompose E Te e1' B Tb b0 f1 p Hf1_ls Hp_cont Hpe1'). }
        exact (path_homotopy_class_loop_concat_eq_mult B Tb b0 al pf1 Hal_ls Hpf1_ls). }
      (** Step 2: [full_path] = mult([al_pf1], [rev_al]) **)
      claim Hclass_full : path_homotopy_class_loop B Tb b0 full_path
        = apply_fun multG (path_homotopy_class_loop B Tb b0 al_pf1, path_homotopy_class_loop B Tb b0 rev_al).
      { claim Hpf1_ls : pf1 :e loop_space B Tb b0.
        { exact (loop_space_postcompose E Te e1' B Tb b0 f1 p Hf1_ls Hp_cont Hpe1'). }
        claim Hal_pf1_ls : al_pf1 :e loop_space B Tb b0.
        { exact (path_concat_preserves_loop_space B Tb b0 al pf1 Hal_ls Hpf1_ls). }
        claim Hrev_al_ls : rev_al :e loop_space B Tb b0.
        { exact (reverse_path_preserves_loop_space_early B Tb b0 al Hal_ls). }
        exact (path_homotopy_class_loop_concat_eq_mult B Tb b0 al_pf1 rev_al Hal_pf1_ls Hrev_al_ls). }
      (** Step 3: [rev_al] = inv([al]) via Thm 51.2 chain **)
      set al_class := path_homotopy_class_loop B Tb b0 al.
      set rev_al_class := path_homotopy_class_loop B Tb b0 rev_al.
      claim Hrev_al_ls : rev_al :e loop_space B Tb b0.
      { exact (reverse_path_preserves_loop_space_early B Tb b0 al Hal_ls). }
      claim Hhtpy : path_homotopic B Tb b0 b0
        (path_concat rev_al al) (constant_path b0).
      { exact (Theorem_51_2_left_inverse B Tb b0 b0 al Hal_cont Hal_0 Hal_1). }
      claim Hconcat_eG : path_homotopy_class_loop B Tb b0 (path_concat rev_al al) = eG.
      { exact (path_homotopy_class_loop_eq_of_path_homotopic B Tb b0
          (path_concat rev_al al) (constant_path b0) Hhtpy). }
      claim Hmult_rev_al : apply_fun multG (rev_al_class, al_class) = eG.
      { rewrite (eq_symm
          (path_homotopy_class_loop B Tb b0 (path_concat rev_al al))
          (apply_fun multG (rev_al_class, al_class))
          (path_homotopy_class_loop_concat_eq_mult B Tb b0 rev_al al Hrev_al_ls Hal_ls)).
        exact Hconcat_eG. }
      claim Hrev_FG : rev_al_class :e G.
      { exact (path_homotopy_class_in_fundamental_group B Tb b0 rev_al Hrev_al_ls). }
      claim Hal_FG : al_class :e G.
      { exact (path_homotopy_class_in_fundamental_group B Tb b0 al Hal_ls). }
      claim Hinv_al_G : apply_fun invG al_class :e G.
      { exact (Hfn_inv al_class Hal_FG). }
      claim Hmult_inv_eG : apply_fun multG (apply_fun invG al_class, al_class) = eG.
      { exact (andER
          (apply_fun multG (al_class, apply_fun invG al_class) = eG)
          (apply_fun multG (apply_fun invG al_class, al_class) = eG)
          (Hinverse al_class Hal_FG)). }
      claim Hboth : apply_fun multG (rev_al_class, al_class)
        = apply_fun multG (apply_fun invG al_class, al_class).
      { rewrite Hmult_rev_al. exact (eq_symm
          (apply_fun multG (apply_fun invG al_class, al_class)) eG Hmult_inv_eG). }
      claim Hclass_rev : rev_al_class = apply_fun invG al_class.
      { exact (group_right_cancel G multG eG invG al_class
            rev_al_class (apply_fun invG al_class)
            HgrpG Hal_FG Hrev_FG Hinv_al_G Hboth). }
      (** Substitute: g = [al], n = [pf1] **)
      rewrite Hclass_full.
      rewrite Hclass_al_pf1.
      rewrite Hclass_rev.
      rewrite Hg_eq.
      rewrite Hn_pf1.
      reflexivity. }
    rewrite <- Hfull_eq. exact Hfull_in_H0.
Qed.

(** from S81 Cor 81.4 (line 5097 in algtop.tex) **)
(** LATEX VERSION: If E is simply connected, then C(E,p,B) is isomorphic to pi1(B,b0). **)
(** EFFORT: 3 lines textbook, difficulty 2/10, USD 30 **)
(** Bounty 33 **)
Theorem cor81_4_simply_connected_covering_trans :
  forall E Te B Tb p e0:set,
  covering_map E Te B Tb p -> e0 :e E ->
  simply_connected E Te ->
  locally_path_connected E Te ->
  exists phi:set,
    group_isomorphism
      (covering_transformation_group E Te B Tb p)
      (covering_transformation_mult E Te B Tb p)
      (fundamental_group B Tb (apply_fun p e0))
      (fundamental_group_mult B Tb (apply_fun p e0))
      phi.
let E Te B Tb p e0.
assume Hcov : covering_map E Te B Tb p.
assume He0E : e0 :e E.
assume Hsc : simply_connected E Te.
assume Hlpc : locally_path_connected E Te.
set b0 := apply_fun p e0.
set CTG := covering_transformation_group E Te B Tb p.
set CTmult := covering_transformation_mult E Te B Tb p.
set piB := fundamental_group B Tb b0.
set multB := fundamental_group_mult B Tb b0.
claim HtopE : topology_on E Te.
{ exact (covering_map_topology_on_domain E Te B Tb p Hcov). }
claim HtopB : topology_on B Tb.
{ exact (covering_map_topology_on_codomain E Te B Tb p Hcov). }
claim HpcE : path_connected_space E Te.
{ exact (simply_connected_path_connected E Te Hsc). }
claim HconnE : connected_space E Te.
{ exact (path_connected_implies_connected E Te HpcE). }
claim Hcont_p : continuous_map E Te B Tb p.
{ exact (covering_map_continuous E Te B Tb p Hcov). }
claim Hfn_p : function_on p E B.
{ exact (continuous_map_function_on E Te B Tb p Hcont_p). }
claim Hb0B : b0 :e B. { exact (Hfn_p e0 He0E). }
(** The isomorphism phi is constructed via the lifting correspondence: **)
(** For h in CTG, phi(h) = [class of the path from b0 to b0 that lifts to a **)
(** path from e0 to h(e0)]. This is the inverse of the lifting correspondence. **)
(** The lifting correspondence (Thm 54.4) gives a bijection pi1(B,b0) -> fiber(b0). **)
(** Since E is simply connected, this bijection is 1-1 and onto. **)
(** Each covering transformation h is determined by h(e0), and h(e0) is in fiber(b0). **)
(** So the composition: CTG -> fiber(b0) -> pi1(B,b0) is a bijection. **)
(** Showing it is a group homomorphism uses covering_transformation_path_lift_transport. **)
(** Full construction requires building the inverse map and showing multiplicativity. **)
admit.
Admitted.

(** from S81 Definition (line 5121 in algtop.tex): orbit space **)
(** LATEX VERSION: Let G be a subgroup of homeomorphisms of X. The orbit space X/G **)
(** is the quotient space by the relation x ~ g(x) for all g in G. **)
Definition orbit_equiv : set -> set -> set -> set -> prop :=
  fun X G x y =>
    x :e X /\ y :e X /\
    exists g:set, g :e G /\ apply_fun g x = y.

Definition orbit_space : set -> set -> set :=
  fun X G =>
    {cls :e Power X | exists x:set, x :e X /\ cls = {y :e X | orbit_equiv X G x y}}.

Definition orbit_map : set -> set -> set :=
  fun X G =>
    graph X (fun x:set => {y :e X | orbit_equiv X G x y}).

Definition orbit_topology : set -> set -> set -> set :=
  fun X Tx G =>
    quotient_topology X Tx (orbit_space X G) (orbit_map X G).

(** from S81 Definition (line 5123 in algtop.tex): properly discontinuous action **)
(** LATEX VERSION: The action of G on X is properly discontinuous if for every x in X **)
(** there is a neighborhood U of x such that g(U) is disjoint from U whenever g /= e. **)
Definition properly_discontinuous : set -> set -> set -> set -> prop :=
  fun X Tx G idG =>
    (forall x:set, x :e X ->
      exists U:set, U :e Tx /\ x :e U /\
        (forall g:set, g :e G -> g <> idG ->
          apply_fun g x :e X /\
          (forall y:set, y :e U -> apply_fun g y /:e U))).

(** from S81 Thm 81.5 (line 5125 in algtop.tex) **)
(** LATEX VERSION: Let X be path connected and locally path connected; let G be a **)
(** group of homeomorphisms of X. The quotient map pi: X -> X/G is a covering map **)
(** from S81 Thm 81.5 (line 5125 in algtop.tex): properly discontinuous covering **)
(** iff the action of G is properly discontinuous. In this case, pi is regular **)
(** and G is its group of covering transformations. **)
(** Helper: orbit_map sends x to its orbit class **)
Theorem orbit_map_apply : forall X G x:set,
  x :e X ->
  apply_fun (orbit_map X G) x = {y :e X | orbit_equiv X G x y}.
let X G x. assume HxX.
exact (apply_fun_graph X (fun z:set => {y :e X | orbit_equiv X G z y}) x HxX).
Qed.

(** Helper: g(y) is in the orbit class of y (one direction of orbit_map_invariant) **)
(** Proven Alice **)
Theorem orbit_map_g_image_in_orbit_class :
  forall X G g y:set,
  g :e G ->
  (forall h:set, h :e G -> function_on h X X) ->
  y :e X ->
  apply_fun g y :e apply_fun (orbit_map X G) y.
let X G g y. assume HgG Hfn HyX.
claim HgyX : apply_fun g y :e X. { exact (Hfn g HgG y HyX). }
rewrite (orbit_map_apply X G y HyX).
prove apply_fun g y :e {z :e X | orbit_equiv X G y z}.
apply (SepI X (fun z:set => orbit_equiv X G y z) (apply_fun g y) HgyX).
prove orbit_equiv X G y (apply_fun g y).
prove y :e X /\ apply_fun g y :e X /\ exists h0:set, h0 :e G /\ apply_fun h0 y = apply_fun g y.
apply and3I.
- exact HyX.
- exact HgyX.
- witness g. apply andI. exact HgG. reflexivity.
Qed.

(** Helper: each orbit_map value is in orbit_space (no action-closure assumptions needed) **)
(** Proven Bob **)
Theorem orbit_map_value_in_orbit_space : forall X G x:set,
  x :e X ->
  apply_fun (orbit_map X G) x :e orbit_space X G.
let X G x.
assume HxX.
rewrite (orbit_map_apply X G x HxX).
prove {y :e X | orbit_equiv X G x y} :e orbit_space X G.
prove {y :e X | orbit_equiv X G x y} :e
  {cls :e Power X | exists z:set, z :e X /\ cls = {y :e X | orbit_equiv X G z y}}.
apply SepI.
- prove {y :e X | orbit_equiv X G x y} :e Power X.
  apply PowerI.
  let y. assume Hy.
  exact (SepE1 X (fun z:set => orbit_equiv X G x z) y Hy).
- prove exists z:set, z :e X /\ {y :e X | orbit_equiv X G x y} = {y :e X | orbit_equiv X G z y}.
  witness x.
  apply andI.
  + exact HxX.
  + reflexivity.
Qed.

(** Helper: orbit_space membership is equivalent to having an orbit_map representative **)
(** Proven Bob **)
Theorem orbit_space_member_iff_orbit_map_value : forall X G cls:set,
  (cls :e orbit_space X G <->
   exists x:set, x :e X /\ apply_fun (orbit_map X G) x = cls).
let X G cls.
apply iffI.
- assume HclsOS.
  claim Hpack : exists z:set, z :e X /\ cls = {y :e X | orbit_equiv X G z y}.
  {
    exact (SepE2
      (Power X)
      (fun c:set => exists z:set, z :e X /\ c = {y :e X | orbit_equiv X G z y})
      cls
      HclsOS).
  }
  apply Hpack.
  let z. assume HzPack.
  claim HzX : z :e X.
  { exact (andEL (z :e X) (cls = {y :e X | orbit_equiv X G z y}) HzPack). }
  claim HclsEq : cls = {y :e X | orbit_equiv X G z y}.
  { exact (andER (z :e X) (cls = {y :e X | orbit_equiv X G z y}) HzPack). }
  witness z.
  apply andI.
  * exact HzX.
  * transitivity ({y :e X | orbit_equiv X G z y}).
    { exact (orbit_map_apply X G z HzX). }
    { exact (eq_symm cls {y :e X | orbit_equiv X G z y} HclsEq). }
- assume Hrep.
  apply Hrep.
  let x. assume HxPack.
  claim HxX : x :e X.
  { exact (andEL (x :e X) (apply_fun (orbit_map X G) x = cls) HxPack). }
  claim HmapEq : apply_fun (orbit_map X G) x = cls.
  { exact (andER (x :e X) (apply_fun (orbit_map X G) x = cls) HxPack). }
  rewrite <- HmapEq.
  exact (orbit_map_value_in_orbit_space X G x HxX).
Qed.

(** Helper: with identity action, every orbit-space class is nonempty **)
(** Proven Bob **)
Theorem orbit_space_class_nonempty_with_identity : forall X G idG cls:set,
  idG :e G ->
  (forall z:set, z :e X -> apply_fun idG z = z) ->
  cls :e orbit_space X G ->
  exists x:set, x :e cls.
let X G idG cls.
assume HidG HidAct HclsOS.
claim Hrep : exists x:set, x :e X /\ apply_fun (orbit_map X G) x = cls.
{
  exact ((iffEL
    (cls :e orbit_space X G)
    (exists x:set, x :e X /\ apply_fun (orbit_map X G) x = cls)
    (orbit_space_member_iff_orbit_map_value X G cls))
    HclsOS).
}
apply Hrep.
let x. assume HxPack.
claim HxX : x :e X.
{ exact (andEL (x :e X) (apply_fun (orbit_map X G) x = cls) HxPack). }
claim HmapEq : apply_fun (orbit_map X G) x = cls.
{ exact (andER (x :e X) (apply_fun (orbit_map X G) x = cls) HxPack). }
claim HxInMap : x :e apply_fun (orbit_map X G) x.
{
  rewrite (orbit_map_apply X G x HxX).
  apply SepI.
  - exact HxX.
  - prove orbit_equiv X G x x.
    prove x :e X /\ x :e X /\ exists g:set, g :e G /\ apply_fun g x = x.
    apply and3I.
    + exact HxX.
    + exact HxX.
    + witness idG.
      apply andI.
      * exact HidG.
      * exact (HidAct x HxX).
}
witness x.
exact (mem_eqR x (apply_fun (orbit_map X G) x) cls HmapEq HxInMap).
Qed.

(** Helper: with identity action, orbit_space is nonempty whenever X has a point **)
(** Proven Bob **)
Theorem orbit_space_nonempty_from_point_with_identity : forall X G idG x:set,
  idG :e G ->
  (forall z:set, z :e X -> apply_fun idG z = z) ->
  x :e X ->
  orbit_space X G <> Empty.
let X G idG x.
assume HidG HidAct HxX.
assume Hempty : orbit_space X G = Empty.
claim HclsOS : apply_fun (orbit_map X G) x :e orbit_space X G.
{ exact (orbit_map_value_in_orbit_space X G x HxX). }
claim HclsEmpty : apply_fun (orbit_map X G) x :e Empty.
{
  exact (mem_eqR
    (apply_fun (orbit_map X G) x)
    (orbit_space X G)
    Empty
    Hempty
    HclsOS).
}
exact (EmptyE (apply_fun (orbit_map X G) x) HclsEmpty False).
Qed.

(** Helper: if X is empty then orbit_space is empty **)
(** Proven Bob **)
Theorem orbit_space_empty_of_X_empty : forall X G:set,
  X = Empty ->
  orbit_space X G = Empty.
let X G.
assume HXEmpty.
apply set_ext.
- let cls. assume HclsOS.
  claim Hpack : exists x:set, x :e X /\ cls = {y :e X | orbit_equiv X G x y}.
  {
    exact (SepE2
      (Power X)
      (fun c:set => exists x:set, x :e X /\ c = {y :e X | orbit_equiv X G x y})
      cls
      HclsOS).
  }
  apply Hpack.
  let x. assume HxPack.
  claim HxX : x :e X.
  { exact (andEL (x :e X) (cls = {y :e X | orbit_equiv X G x y}) HxPack). }
  claim HxE : x :e Empty.
  { exact (mem_eqR x X Empty HXEmpty HxX). }
  exact (EmptyE x HxE (cls :e Empty)).
- let cls. assume HclsE.
  exact (EmptyE cls HclsE (cls :e orbit_space X G)).
Qed.

(** Helper: with identity action, empty orbit_space forces empty X **)
(** Proven Bob **)
Theorem orbit_space_empty_implies_X_empty_with_identity : forall X G idG:set,
  idG :e G ->
  (forall z:set, z :e X -> apply_fun idG z = z) ->
  orbit_space X G = Empty ->
  X = Empty.
let X G idG.
assume HidG HidAct HOSempty.
apply set_ext.
- let x. assume HxX.
  claim Hcontra : False.
  {
    exact ((orbit_space_nonempty_from_point_with_identity
      X G idG x HidG HidAct HxX)
      HOSempty).
  }
  exact (FalseE Hcontra (x :e Empty)).
- let x. assume HxE.
  exact (EmptyE x HxE (x :e X)).
Qed.

(** Helper: with identity action, orbit_space is empty iff X is empty **)
(** Proven Bob **)
Theorem orbit_space_empty_iff_X_empty_with_identity : forall X G idG:set,
  idG :e G ->
  (forall z:set, z :e X -> apply_fun idG z = z) ->
  (orbit_space X G = Empty <-> X = Empty).
let X G idG.
assume HidG HidAct.
apply iffI.
- assume HOSempty.
  exact (orbit_space_empty_implies_X_empty_with_identity
    X G idG HidG HidAct HOSempty).
- assume HXEmpty.
  exact (orbit_space_empty_of_X_empty X G HXEmpty).
Qed.

(** Helper: nonempty X gives nonempty orbit_space (no extra assumptions) **)
(** Proven Bob **)
Theorem orbit_space_nonempty_of_X_nonempty : forall X G:set,
  X <> Empty ->
  orbit_space X G <> Empty.
let X G.
assume HXne.
apply (nonempty_has_element X HXne).
let x. assume HxX.
exact (elem_implies_nonempty
  (orbit_space X G)
  (apply_fun (orbit_map X G) x)
  (orbit_map_value_in_orbit_space X G x HxX)).
Qed.

(** Helper: with identity action, nonempty orbit_space implies nonempty X **)
(** Proven Bob **)
Theorem X_nonempty_of_orbit_space_nonempty_with_identity : forall X G idG:set,
  idG :e G ->
  (forall z:set, z :e X -> apply_fun idG z = z) ->
  orbit_space X G <> Empty ->
  X <> Empty.
let X G idG.
assume HidG HidAct HOSne.
assume HXempty.
exact (HOSne (orbit_space_empty_of_X_empty X G HXempty)).
Qed.

(** Helper: with identity action, orbit_space is nonempty iff X is nonempty **)
(** Proven Bob **)
Theorem orbit_space_nonempty_iff_X_nonempty_with_identity : forall X G idG:set,
  idG :e G ->
  (forall z:set, z :e X -> apply_fun idG z = z) ->
  (orbit_space X G <> Empty <-> X <> Empty).
let X G idG.
assume HidG HidAct.
apply iffI.
- assume HOSne.
  exact (X_nonempty_of_orbit_space_nonempty_with_identity
    X G idG HidG HidAct HOSne).
- assume HXne.
  exact (orbit_space_nonempty_of_X_nonempty X G HXne).
Qed.

(** Helper: with identity action, every orbit-space class is nonempty as a set **)
(** Proven Bob **)
Theorem orbit_space_class_ne_empty_with_identity : forall X G idG cls:set,
  idG :e G ->
  (forall z:set, z :e X -> apply_fun idG z = z) ->
  cls :e orbit_space X G ->
  cls <> Empty.
let X G idG cls.
assume HidG HidAct HclsOS.
claim Hex : exists x:set, x :e cls.
{ exact (orbit_space_class_nonempty_with_identity X G idG cls HidG HidAct HclsOS). }
apply Hex.
let x. assume Hxcls.
exact (elem_implies_nonempty cls x Hxcls).
Qed.

(** Helper: every orbit-space class is a subset of X **)
(** Proven Bob **)
Theorem orbit_space_member_subset_X : forall X G cls:set,
  cls :e orbit_space X G ->
  cls c= X.
let X G cls.
assume HclsOS.
claim HclsPow : cls :e Power X.
{
  exact (SepE1
    (Power X)
    (fun c:set => exists z:set, z :e X /\ c = {y :e X | orbit_equiv X G z y})
    cls
    HclsOS).
}
exact (PowerE X cls HclsPow).
Qed.

(** Helper: orbit_space has a class exactly when X is nonempty **)
(** Proven Bob **)
Theorem orbit_space_exists_class_iff_X_nonempty : forall X G:set,
  (exists cls:set, cls :e orbit_space X G) <-> X <> Empty.
let X G.
apply iffI.
- assume HexCls.
  apply HexCls.
  let cls. assume HclsOS.
  claim Hrep : exists x:set, x :e X /\ apply_fun (orbit_map X G) x = cls.
  {
    exact ((iffEL
      (cls :e orbit_space X G)
      (exists x:set, x :e X /\ apply_fun (orbit_map X G) x = cls)
      (orbit_space_member_iff_orbit_map_value X G cls))
      HclsOS).
  }
  apply Hrep.
  let x. assume HxPack.
  claim HxX : x :e X.
  { exact (andEL (x :e X) (apply_fun (orbit_map X G) x = cls) HxPack). }
  exact (elem_implies_nonempty X x HxX).
- assume HXne.
  apply (nonempty_has_element X HXne).
  let x. assume HxX.
  witness apply_fun (orbit_map X G) x.
  exact (orbit_map_value_in_orbit_space X G x HxX).
Qed.

(** Helper: orbit_map is function_on without extra assumptions on G **)
(** Proven Bob **)
Theorem orbit_map_function_on_plain : forall X G:set,
  function_on (orbit_map X G) X (orbit_space X G).
let X G.
apply (graph_function_on X (orbit_space X G) (fun x:set => {y :e X | orbit_equiv X G x y})).
let x. assume HxX.
exact ((orbit_map_apply X G x HxX)
  (fun v _ => v :e orbit_space X G)
  (orbit_map_value_in_orbit_space X G x HxX)).
Qed.

(** Helper: orbit_map is surjective onto orbit_space without extra assumptions on G **)
(** Proven Bob **)
Theorem orbit_map_surjective_plain : forall X G:set,
  surjective_map X (orbit_space X G) (orbit_map X G).
let X G.
prove function_on (orbit_map X G) X (orbit_space X G) /\
  (forall cls:set, cls :e orbit_space X G -> exists x:set, x :e X /\ apply_fun (orbit_map X G) x = cls).
apply andI.
- exact (orbit_map_function_on_plain X G).
- let cls. assume HclsOS.
  exact ((iffEL
    (cls :e orbit_space X G)
    (exists x:set, x :e X /\ apply_fun (orbit_map X G) x = cls)
      (orbit_space_member_iff_orbit_map_value X G cls))
    HclsOS).
Qed.

(** Helper: orbit_map image on X is exactly orbit_space **)
(** Proven Bob **)
Theorem orbit_map_image_of_whole : forall X G:set,
  image_of (orbit_map X G) X = orbit_space X G.
let X G.
exact (surjective_map_image_of_whole
  X
  (orbit_space X G)
  (orbit_map X G)
  (orbit_map_surjective_plain X G)).
Qed.

(** Helper: orbit map is function_on **)
Theorem orbit_map_function_on : forall X G:set,
  (forall g:set, g :e G -> function_on g X X) ->
  function_on (orbit_map X G) X (orbit_space X G).
let X G. assume Hfn.
apply (graph_function_on X (orbit_space X G) (fun x:set => {y :e X | orbit_equiv X G x y})).
let x. assume HxX.
prove {y :e X | orbit_equiv X G x y} :e orbit_space X G.
prove {y :e X | orbit_equiv X G x y} :e {cls :e Power X | exists z:set, z :e X /\ cls = {y :e X | orbit_equiv X G z y}}.
apply SepI.
- prove {y :e X | orbit_equiv X G x y} :e Power X.
  apply PowerI.
  let y. assume Hy. exact (SepE1 X (fun y => orbit_equiv X G x y) y Hy).
- prove exists z:set, z :e X /\ {y :e X | orbit_equiv X G x y} = {y :e X | orbit_equiv X G z y}.
  witness x. apply andI.
  + exact HxX.
  + reflexivity.
Qed.

(** Helper: orbit map is surjective onto orbit_space **)
(** Proven Bob **)
Theorem orbit_map_surjective : forall X G:set,
  (forall g:set, g :e G -> function_on g X X) ->
  surjective_map X (orbit_space X G) (orbit_map X G).
let X G. assume Hfn.
prove function_on (orbit_map X G) X (orbit_space X G) /\
  (forall b:set, b :e orbit_space X G -> exists x:set, x :e X /\ apply_fun (orbit_map X G) x = b).
apply andI.
- exact (orbit_map_function_on X G Hfn).
- let b. assume HbB.
  claim HbPack : exists z:set, z :e X /\ b = {y :e X | orbit_equiv X G z y}.
  {
    exact (SepE2
      (Power X)
      (fun cls:set => exists z:set, z :e X /\ cls = {y :e X | orbit_equiv X G z y})
      b
      HbB).
  }
  apply HbPack.
  let z. assume HzPack.
  claim HzX : z :e X.
  { exact (andEL (z :e X) (b = {y :e X | orbit_equiv X G z y}) HzPack). }
  claim Hbeq : b = {y :e X | orbit_equiv X G z y}.
  { exact (andER (z :e X) (b = {y :e X | orbit_equiv X G z y}) HzPack). }
  witness z. apply andI.
  + exact HzX.
  + transitivity ({y :e X | orbit_equiv X G z y}).
    * exact (orbit_map_apply X G z HzX).
    * exact (eq_symm
        b
        ({y :e X | orbit_equiv X G z y})
        Hbeq).
Qed.

(** Helper: orbit map is a quotient map onto the orbit space **)
(** Proven Bob **)
Theorem orbit_map_quotient_map : forall X Tx G:set,
  topology_on X Tx ->
  (forall g:set, g :e G -> function_on g X X) ->
  quotient_map X Tx (orbit_space X G) (orbit_map X G).
let X Tx G.
assume HtopX Hfn.
exact (topology_on_and_surjective_map_implies_quotient_map
  X
  Tx
  (orbit_space X G)
  (orbit_map X G)
  (andI
    (topology_on X Tx)
    (surjective_map X (orbit_space X G) (orbit_map X G))
    HtopX
    (orbit_map_surjective X G Hfn))).
Qed.

(** Helper: orbit topology is a topology **)
(** Proven Bob **)
Theorem orbit_topology_is_topology : forall X Tx G:set,
  topology_on X Tx ->
  (forall g:set, g :e G -> function_on g X X) ->
  topology_on (orbit_space X G) (orbit_topology X Tx G).
let X Tx G.
assume HtopX Hfn.
exact (quotient_topology_is_topology
  X
  Tx
  (orbit_space X G)
  (orbit_map X G)
  HtopX
  (orbit_map_quotient_map X Tx G HtopX Hfn)).
Qed.

(** Helper: orbit map is continuous into orbit_topology **)
(** Proven Bob **)
Theorem orbit_map_continuous : forall X Tx G:set,
  topology_on X Tx ->
  (forall g:set, g :e G -> function_on g X X) ->
  continuous_map X Tx (orbit_space X G) (orbit_topology X Tx G) (orbit_map X G).
let X Tx G.
assume HtopX Hfn.
exact (quotient_universal_property
  X
  Tx
  (orbit_space X G)
  (orbit_topology X Tx G)
  (orbit_map X G)
  (orbit_map_quotient_map X Tx G HtopX Hfn)
  (orbit_topology_is_topology X Tx G HtopX Hfn)
  (Subq_ref (orbit_topology X Tx G))).
Qed.

(** Helper: orbit map is a quotient map with no extra assumptions on G **)
(** Proven Bob **)
Theorem orbit_map_quotient_map_plain : forall X Tx G:set,
  topology_on X Tx ->
  quotient_map X Tx (orbit_space X G) (orbit_map X G).
let X Tx G.
assume HtopX.
exact (topology_on_and_surjective_map_implies_quotient_map
  X
  Tx
  (orbit_space X G)
  (orbit_map X G)
  (andI
    (topology_on X Tx)
    (surjective_map X (orbit_space X G) (orbit_map X G))
    HtopX
    (orbit_map_surjective_plain X G))).
Qed.

(** Helper: orbit topology is a topology with no extra assumptions on G **)
(** Proven Bob **)
Theorem orbit_topology_is_topology_plain : forall X Tx G:set,
  topology_on X Tx ->
  topology_on (orbit_space X G) (orbit_topology X Tx G).
let X Tx G.
assume HtopX.
exact (quotient_topology_is_topology
  X
  Tx
  (orbit_space X G)
  (orbit_map X G)
  HtopX
  (orbit_map_quotient_map_plain X Tx G HtopX)).
