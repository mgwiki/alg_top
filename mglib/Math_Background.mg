(** Infrastructure: removing a singleton removes exactly that point from the set **)
(** Proven Bob **)
Theorem setminus_singleton_eq_setminus_point : forall A x:set,
  A :\: {x} = Sep A (fun y:set => y <> x).
let A x.
apply set_ext.
- let y.
  assume HyRest.
  claim HyA : y :e A.
  {
    exact (setminusE1
      A
      {x}
      y
      HyRest).
  }
  claim Hyneq : y <> x.
  {
    assume Hyx.
    claim HySing : y :e {x}.
    {
      rewrite Hyx.
      exact (SingI x).
    }
    exact ((setminusE2
      A
      {x}
      y
      HyRest)
      HySing).
  }
  exact (SepI
    A
    (fun z:set => z <> x)
    y
    HyA
    Hyneq).
- let y.
  assume HySep.
  claim HyA : y :e A.
  {
    exact (SepE1
      A
      (fun z:set => z <> x)
      y
      HySep).
  }
  claim Hyneq : y <> x.
  {
    exact (SepE2
      A
      (fun z:set => z <> x)
      y
      HySep).
  }
  claim HyNotSing : y /:e {x}.
  {
    assume HySing.
    claim Hyx : y = x.
    {
      exact (SingE
        x
        y
        HySing).
    }
    exact (Hyneq Hyx).
  }
  exact (setminusI
    A
    {x}
    y
    HyA
    HyNotSing).
Qed.

(** Infrastructure: if removing a singleton leaves the set unchanged, then the point is not in it **)
(** Proven Bob **)
Theorem setminus_singleton_eq_set_implies_not_mem : forall A x:set,
  A :\: {x} = A ->
  x /:e A.
let A x.
assume Hdiff.
assume HxA.
