(** Proven Bob **)
Theorem lemma54_2_sheet_eq_data_implies_common_sheet :
  forall Ft q z slices Vq Vz:set,
  apply_fun Ft q :e Vq ->
  apply_fun Ft z :e Vz ->
  Vq :e slices ->
  Vz :e slices ->
  Vz = Vq ->
  exists V:set,
    apply_fun Ft q :e V /\ apply_fun Ft z :e V /\ V :e slices.
let Ft q z slices Vq Vz.
assume HFtqVq HFtzVz HVqSlice HVzSlice HVzEqVq.
witness Vq.
apply andI.
- apply andI.
  + exact HFtqVq.
  + rewrite <- HVzEqVq.
    exact HFtzVz.
- exact HVqSlice.
Qed.

(** Proven Bob **)
Theorem lemma54_2_sheet_non_switching_from_common_sheet_and_pairwise :
  forall Ft q z slices Vq Vz:set,
  pairwise_disjoint slices ->
  apply_fun Ft q :e Vq ->
  apply_fun Ft z :e Vz ->
  Vq :e slices ->
  Vz :e slices ->
  (exists V:set,
    apply_fun Ft q :e V /\ apply_fun Ft z :e V /\ V :e slices) ->
  Vz = Vq.
let Ft q z slices Vq Vz.
assume Hpd HFtqVq HFtzVz HVqSlice HVzSlice Hcommon.
apply Hcommon.
let V.
assume HVPack.
claim Hleft :
  apply_fun Ft q :e V /\ apply_fun Ft z :e V.
{
  exact (andEL
    (apply_fun Ft q :e V /\ apply_fun Ft z :e V)
    (V :e slices)
    HVPack).
}
claim HFtqV : apply_fun Ft q :e V.
{
  exact (andEL
    (apply_fun Ft q :e V)
    (apply_fun Ft z :e V)
    Hleft).
}
claim HFtzV : apply_fun Ft z :e V.
{
  exact (andER
    (apply_fun Ft q :e V)
    (apply_fun Ft z :e V)
    Hleft).
}
claim HVSlice : V :e slices.
{
  exact (andER
    (apply_fun Ft q :e V /\ apply_fun Ft z :e V)
    (V :e slices)
    HVPack).
}
claim HVqEqV : Vq = V.
{
  exact (pairwise_disjoint_point_unique_member
    slices
    Vq
    V
    (apply_fun Ft q)
    Hpd
    HVqSlice
    HVSlice
    HFtqVq
    HFtqV).
}
claim HVzEqV : Vz = V.
{
  exact (pairwise_disjoint_point_unique_member
    slices
    Vz
    V
    (apply_fun Ft z)
    Hpd
    HVzSlice
    HVSlice
    HFtzVz
    HFtzV).
}
rewrite HVzEqV.
rewrite <- HVqEqV.
reflexivity.
Qed.

