apply HeqData.
let Vq.
assume HVqPack.
apply HVqPack.
let Vz.
assume HVzPack.
claim Hleft4 :
  (((apply_fun Ft q :e Vq /\ apply_fun Ft z :e Vz) /\ Vq :e slices) /\ Vz :e slices).
{
  exact (andEL
    (((apply_fun Ft q :e Vq /\ apply_fun Ft z :e Vz) /\ Vq :e slices) /\ Vz :e slices)
    (Vz = Vq)
    HVzPack).
