      assume HuclsVMem Hphi_uclsV HuniqV.
      claim HuclsVSing : uclsV :e {fundamental_group_id V (subspace_topology X Tx V) x0_V}.
      { exact (mem_eqR uclsV
          (fundamental_group V (subspace_topology X Tx V) x0_V)
