(** Infrastructure: coordinate functions on S^n are continuous. **)
(** Proven Charlie **)
Lemma Sn_coord_continuous : forall n i:set,
  n :e omega ->
  i :e ordsucc n ->
  continuous_map
    (Sn n)
    (Sn_topology n)
    R
    R_standard_topology
    (graph (Sn n) (fun x:set => apply_fun x i)).
let n i.
assume Hn_om Hi.
claim Hn_nat : nat_p n.
{
  exact (omega_nat_p
    n
    Hn_om).
}
claim HincCont :
  continuous_map
    (Sn n)
    (Sn_topology n)
    (euclidean_space (ordsucc n))
    (euclidean_topology (ordsucc n))
    (graph (Sn n) (fun x:set => x)).
{
  exact (Sn_inclusion_euclidean_continuous
    n).
}
claim HcoordCont :
  continuous_map
    (euclidean_space (ordsucc n))
    (euclidean_topology (ordsucc n))
    R
    R_standard_topology
    (graph (euclidean_space (ordsucc n)) (fun x:set => apply_fun x i)).
{
  exact (euclidean_coord_continuous
    (ordsucc n)
    i
    (nat_ordsucc
      n
      Hn_nat)
    Hi).
}
claim HcompCont :
  continuous_map
    (Sn n)
    (Sn_topology n)
    R
    R_standard_topology
    (compose_fun
      (Sn n)
      (graph (Sn n) (fun x:set => x))
      (graph (euclidean_space (ordsucc n)) (fun x:set => apply_fun x i))).
{
  exact (composition_continuous
    (Sn n)
    (Sn_topology n)
    (euclidean_space (ordsucc n))
    (euclidean_topology (ordsucc n))
    R
    R_standard_topology
    (graph (Sn n) (fun x:set => x))
    (graph (euclidean_space (ordsucc n)) (fun x:set => apply_fun x i))
    HincCont
    HcoordCont).
}
claim HcoordFun :
  function_on
    (graph (Sn n) (fun x:set => apply_fun x i))
    (Sn n)
    R.
{
  exact (function_on_of_function_space
    (graph (Sn n) (fun x:set => apply_fun x i))
    (Sn n)
    R
    (graph_in_function_space
      (Sn n)
      R
      (fun x:set => apply_fun x i)
      (fun x Hx =>
        euclidean_space_coord_in_R
          (ordsucc n)
          x
          i
          (SepE1
            (euclidean_space (ordsucc n))
            (fun v:set => euclidean_norm_sq (ordsucc n) v = 1)
            x
            Hx)
          Hi))).
}
claim HcoordEqOn :
  forall x:set, x :e Sn n ->
    apply_fun
      (compose_fun
        (Sn n)
        (graph (Sn n) (fun z:set => z))
        (graph (euclidean_space (ordsucc n)) (fun z:set => apply_fun z i)))
      x
    =
    apply_fun
      (graph (Sn n) (fun z:set => apply_fun z i))
      x.
{
  let x.
  assume Hx.
  rewrite (compose_fun_apply
    (Sn n)
    (graph (Sn n) (fun z:set => z))
    (graph (euclidean_space (ordsucc n)) (fun z:set => apply_fun z i))
    x
    Hx).
  rewrite (apply_fun_graph
    (Sn n)
    (fun z:set => z)
    x
    Hx).
  exact (eq_i_tra
    (apply_fun
      (graph (euclidean_space (ordsucc n)) (fun z:set => apply_fun z i))
      x)
    (apply_fun x i)
    (apply_fun
      (graph (Sn n) (fun z:set => apply_fun z i))
      x)
    (apply_fun_graph
      (euclidean_space (ordsucc n))
      (fun z:set => apply_fun z i)
      x
      (SepE1
        (euclidean_space (ordsucc n))
        (fun v:set => euclidean_norm_sq (ordsucc n) v = 1)
        x
        Hx))
    (eq_symm
      (apply_fun (graph (Sn n) (fun z:set => apply_fun z i)) x)
      (apply_fun x i)
      (apply_fun_graph
        (Sn n)
        (fun z:set => apply_fun z i)
        x
        Hx))).
}
exact (continuous_map_congr_on
  (Sn n)
  (Sn_topology n)
  R
  R_standard_topology
  (compose_fun
    (Sn n)
    (graph (Sn n) (fun x:set => x))
    (graph (euclidean_space (ordsucc n)) (fun x:set => apply_fun x i)))
  (graph (Sn n) (fun x:set => apply_fun x i))
  HcompCont
  HcoordFun
  HcoordEqOn).
Qed.

(** Infrastructure: coordinatewise negation is continuous on Euclidean space. **)
(** Proven Charlie **)
Lemma Rn_negate_ordsucc_euclidean_continuous : forall n:set,
  n :e omega ->
  continuous_map
    (euclidean_space (ordsucc n))
    (euclidean_topology (ordsucc n))
    (euclidean_space (ordsucc n))
    (euclidean_topology (ordsucc n))
    (graph (euclidean_space (ordsucc n)) (fun v:set => Rn_negate (ordsucc n) v)).
let n.
assume Hn_om.
set E := euclidean_space (ordsucc n).
set Etop := euclidean_topology (ordsucc n).
set F := graph (ordsucc n) (fun j:set =>
  graph E (fun v:set => minus_SNo (apply_fun v j))).
claim Hn_nat :
  nat_p n.
{
  exact (omega_nat_p
    n
    Hn_om).
}
claim HEtop :
  topology_on E Etop.
{
  exact (euclidean_topology_is_topology
    (ordsucc n)).
}
claim HordsuccNe :
  ordsucc n <> Empty.
{
  assume Hempty.
  claim H0in :
    0 :e ordsucc n.
  {
    exact (nat_0_in_ordsucc
      n
      Hn_nat).
  }
  exact (EmptyE
    0
    (mem_eqR
      0
      (ordsucc n)
      Empty
      Hempty
      H0in)).
}
claim HF_tfn :
  total_function_on
    F
    (ordsucc n)
    (function_space E R).
{
  apply (total_function_on_graph
    (ordsucc n)
    (function_space E R)).
  let j.
  assume Hj.
  exact (graph_in_function_space
    E
    R
    (fun v:set => minus_SNo (apply_fun v j))
    (fun v Hv =>
      real_minus_SNo
        (apply_fun v j)
        (euclidean_space_coord_in_R
          (ordsucc n)
          v
          j
          Hv
          Hj))).
}
claim HF_cond :
  forall j:set, j :e ordsucc n ->
    continuous_map
      E
      Etop
      R
      R_standard_topology
      (apply_fun F j).
{
  let j.
  assume Hj.
  set coordj := graph E (fun v:set => apply_fun v j).
  claim HcoordCont :
    continuous_map
      E
      Etop
      R
      R_standard_topology
      coordj.
  {
    exact (euclidean_coord_continuous
      (ordsucc n)
      j
      (nat_ordsucc
        n
        Hn_nat)
      Hj).
  }
  claim HcoordNegFun :
    function_on
      (graph E (fun v:set => minus_SNo (apply_fun v j)))
      E
      R.
  {
    exact (function_on_of_function_space
      (graph E (fun v:set => minus_SNo (apply_fun v j)))
      E
      R
      (graph_in_function_space
        E
        R
        (fun v:set => minus_SNo (apply_fun v j))
        (fun v Hv =>
          real_minus_SNo
            (apply_fun v j)
            (euclidean_space_coord_in_R
              (ordsucc n)
              v
              j
              Hv
              Hj)))).
  }
  claim HcoordNegEqOn :
    forall v:set, v :e E ->
      apply_fun
        (compose_fun
          E
          coordj
          neg_fun)
        v
      =
      apply_fun
        (graph E (fun v0:set => minus_SNo (apply_fun v0 j)))
        v.
  {
    let v.
    assume Hv.
    rewrite (compose_fun_apply
      E
      coordj
      neg_fun
      v
      Hv).
    rewrite (apply_fun_graph
      E
      (fun v0:set => apply_fun v0 j)
      v
      Hv).
    rewrite (neg_fun_apply
      (apply_fun v j)
      (euclidean_space_coord_in_R
        (ordsucc n)
        v
        j
        Hv
        Hj)).
    symmetry.
    exact (apply_fun_graph
      E
      (fun v0:set => minus_SNo (apply_fun v0 j))
      v
      Hv).
  }
  rewrite (apply_fun_graph
    (ordsucc n)
    (fun j0:set =>
      graph E (fun v:set => minus_SNo (apply_fun v j0)))
    j
    Hj).
  exact (continuous_map_congr_on
    E
    Etop
    R
    R_standard_topology
    (compose_fun
      E
      coordj
      neg_fun)
    (graph E (fun v:set => minus_SNo (apply_fun v j)))
    (composition_continuous
      E
      Etop
      R
      R_standard_topology
      R
      R_standard_topology
      coordj
      neg_fun
      HcoordCont
      neg_fun_continuous)
    HcoordNegFun
    HcoordNegEqOn).
}
claim HdiagCont :
  continuous_map
    E
    Etop
    E
    Etop
    (diagonal_map E F (ordsucc n)).
{
