    word_product multG eG xs2 n2 = wp /\
    n2 <> 0 /\ n2 <> 1.
{
  exact (cor68_6_collapse_mixed_union_to_binary_reduced_word
    G multG eG invG G1 G2 J K Hfam efamH n ys
    Hgrp Hsub1 Hsub2 Hfp HJKdisj Hfp1 Hfp2
    Hred HallNe Hwpne HexG1 HexG2).
