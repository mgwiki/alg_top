Definition Stone_ex32_9_U : set -> set -> set -> set := fun J x B => {y :e Stone_ex32_9_space J|forall i : set , i :e B -> apply_fun y i = apply_fun x i}.
Axiom Stone_ex32_9_self_mem_U : forall J x B : set , x :e Stone_ex32_9_space J -> x :e Stone_ex32_9_U J x B.
Axiom Stone_ex32_9_U_antimonotone : forall J x B C : set , C c= B -> Stone_ex32_9_U J x B c= Stone_ex32_9_U J x C.
Definition Stone_ex32_9_fiber : set -> set -> set -> set := fun J x n => {i :e J|apply_fun x i = n}.
Definition Stone_ex32_9_Pn : set -> set -> set := fun J n => {x :e Stone_ex32_9_space J|forall i j : set , i :e (J :\: Stone_ex32_9_fiber J x n) -> j :e (J :\: Stone_ex32_9_fiber J x n) -> apply_fun x i = apply_fun x j -> i = j}.
Axiom Stone_ex32_9_const1_in_P1 : forall J : set , graph J (fun _ : set => 1) :e Stone_ex32_9_Pn J 1.
Axiom Stone_ex32_9_const2_in_P2 : forall J : set , graph J (fun _ : set => 2) :e Stone_ex32_9_Pn J 2.
Axiom Stone_ex32_9_exists_P2_point_from_code : forall J A : set , forall code : set -> set , A c= J -> (forall a : set , a :e A -> code a :e omega) -> (forall a b : set , a :e A -> b :e A -> code a = code b -> a = b) -> exists y : set , y = graph J (fun a : set => If_i (a :e A) (ordsucc (code a)) 2) /\ y :e Stone_ex32_9_space J /\ y :e Stone_ex32_9_Pn J 2.
Axiom Stone_ex32_9_exists_P1_point_from_code : forall J A : set , forall code : set -> set , A c= J -> (forall a : set , a :e A -> code a :e omega) -> (forall a b : set , a :e A -> b :e A -> code a = code b -> a = b) -> exists x : set , x = graph J (fun a : set => If_i (a :e A) (ordsucc (code a)) 1) /\ x :e Stone_ex32_9_space J /\ x :e Stone_ex32_9_Pn J 1.
