    apply (SepI
      X
      (fun q:set => Rle (q 0) (q 1))
      p
      HpX).
    rewrite <- (projection1_apply
      R
      R
      p
      HpX).
    rewrite <- (projection2_apply
      R
      R
      p
      HpX).
    exact (SepE2
      X
      (fun q:set => Rle (apply_fun fB q) (apply_fun fA q))
      p
      HpA).
