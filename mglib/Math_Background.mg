    assume Hbeta0JH0 HxsiH0 HxsiNeEfam0.
    claim HxiNeE : apply_fun xs i <> eF.
    {
      rewrite <- (HefamH0Val alpha0 Halpha0JH0).
      exact HxiNeEfam0.
    }
    claim HxsiNeE : apply_fun xs (ordsucc i) <> eF.
    {
      rewrite <- (HefamH0Val beta0 Hbeta0JH0).
      exact HxsiNeEfam0.
