claim HambientGeneratorWordUniqueSingleton :
  forall alpha n xs:set, alpha :e JH0 ->
    reduced_word J GfamF (graph J (fun _:set => eF)) n xs -> n <> 0 ->
    word_product multF eF xs n = apply_fun gensH0 alpha ->
