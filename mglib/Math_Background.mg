    (open_ball unit_interval R_bounded_metric (q 0) r0 c= U0)
    Hr0Core).
}
claim Hr0R : r0 :e R.
{
  exact (andEL
    (r0 :e R)
    (Rlt 0 r0)
    Hr0Rpos).
}
claim Hr0pos : Rlt 0 r0.
{
  exact (andER
    (r0 :e R)
    (Rlt 0 r0)
    Hr0Rpos).
}
claim Hball0SubU0 : open_ball unit_interval R_bounded_metric (q 0) r0 c= U0.
{
  exact (andER
    (r0 :e R /\ Rlt 0 r0)
    (open_ball unit_interval R_bounded_metric (q 0) r0 c= U0)
    Hr0Core).
}
claim Hr0LtEps : Rlt r0 (eps_ 1).
{
  exact (andER
