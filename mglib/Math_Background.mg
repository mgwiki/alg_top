  let V.
  assume HVpack.
  exact (union_member_nonempty_implies_union_nonempty
    Fam
    V
    (andEL (V :e Fam) (V <> Empty) HVpack)
    (andER (V :e Fam) (V <> Empty) HVpack)).
Qed.

(** Infrastructure: a member is a subset of the union **)
(** Proven Bob **)
Theorem union_member_sub_union : forall Fam V:set,
  V :e Fam ->
  V c= Union Fam.
