	                    claim HbInter : b :e A0 :/\: A.
	                    { exact (binintersectI A0 A b HbA0 HbA). }
	                    claim HbSing : b :e Sing p.
	                    { exact (mem_eqR b (A0 :/\: A) (Sing p) HinterEq HbInter). }
	                    claim HbEqP : b = p.
