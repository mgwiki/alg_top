      s
      0
      HsS
      SNo_0
      HsLe0
      HsNonneg).
  }
  claim Ht0 : t = 0.
  {
    rewrite <- HsSq.
    rewrite Hs0 at 1.
    rewrite Hs0 at 1.
    exact (mul_SNo_zeroL
      0
      SNo_0).
  }
  exact (FalseE
    (SNoLt_irref
      0
      (Ht0
        (fun z _ => 0 < z)
        (RltE_lt
          0
          t
          HtPos)))
    (Rlt 0 s)).
Qed.

(** Infrastructure: on the positive ray, sqrt(t) < b iff t < b^2. **)
