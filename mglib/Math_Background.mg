    rewrite HlamfVal.
    rewrite Hlamf_01Val.
    rewrite (Hrow0Eq
      p
      HpT).
    rewrite (Hrow1Eq
      p
      HpT).
    rewrite (Hrow2Eq
      p
      HpT).
    rewrite (finite_real_sum_S
      (fun k:set => apply_fun Av k)
      2
      H2nat).
    rewrite (finite_real_sum_S
      (fun k:set => apply_fun Av k)
      1
      H1nat).
    rewrite (finite_real_sum_S
