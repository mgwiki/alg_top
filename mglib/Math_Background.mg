(** S55 helper: antipode map is not the identity graph on S1. **)
(** Proven Bob **)
Theorem s55_S1_antipode_map_ne_id_graph :
  s55_S1_antipode_map <> graph S1 (fun x:set => x).
assume HfEq.
claim HbaseEq :
  apply_fun s55_S1_antipode_map S1_basepoint = S1_basepoint.
{
  rewrite HfEq.
