apply Hdoubling_scaffold.
let G.
assume HGpack.
apply HGpack.
let multG.
assume HmPack.
apply HmPack.
let eG.
assume HePack.
apply HePack.
let invG.
assume HinvPack.
apply HinvPack.
let ifam.
assume HifamPack.
apply HifamPack.
let basis1.
assume HbasisPack.
apply HbasisPack.
let h.
assume HhPack.
apply HhPack.
let H.
assume Hmain.
set A := abelian_group G multG eG invG.
set B := function_on basis1 J G.
set C := direct_sum_of_subgroups G multG eG invG J
  (graph J (fun alpha:set => homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha))).
set D := group_homomorphism G multG G multG h.
set E := H = homomorphism_image G h.
set F := subgroup_of H G multG eG invG.
set K := forall alpha:set, alpha :e J ->
  apply_fun h (apply_fun basis1 alpha) = apply_fun (apply_fun ifam alpha) 2.
set L := forall alpha:set, alpha :e J ->
  apply_fun h (apply_fun basis1 alpha) =
  apply_fun multG (apply_fun basis1 alpha, apply_fun basis1 alpha).
set M := forall alpha:set, alpha :e J ->
  group_homomorphism (apply_fun Gfam alpha)
    (apply_fun multfam alpha) G multG (apply_fun ifam alpha) /\
  (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
    apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) y -> x = y).
set N := forall alpha:set, alpha :e J ->
  apply_fun basis1 alpha = apply_fun (apply_fun ifam alpha) 1.
set P := ((((((A /\ B) /\ C) /\ D) /\ E) /\ F) /\ K) /\ L.
claim Hleft9 : (P /\ M) /\ N.
{ exact Hmain. }
claim Hleft8 : P /\ M.
{ exact (andEL
    (P /\ M)
    N
    Hleft9). }
claim Hbasis1_eq_ifam1 : N.
{ exact (andER
    (P /\ M)
    N
    Hleft9). }
claim Hleft7 : P.
{ exact (andEL
    P
    M
    Hleft8). }
claim Hifam_data : M.
{ exact (andER
    P
    M
    Hleft8). }
claim Hleft6 : ((((((A /\ B) /\ C) /\ D) /\ E) /\ F) /\ K).
{ exact (andEL
    ((((((A /\ B) /\ C) /\ D) /\ E) /\ F) /\ K)
    L
    Hleft7). }
claim Hleft5 : (((((A /\ B) /\ C) /\ D) /\ E) /\ F).
{ exact (andEL
    (((((A /\ B) /\ C) /\ D) /\ E) /\ F)
    K
    Hleft6). }
claim Hleft4 : ((((A /\ B) /\ C) /\ D) /\ E).
{ exact (andEL
    ((((A /\ B) /\ C) /\ D) /\ E)
    F
    Hleft5). }
claim Hleft3 : (((A /\ B) /\ C) /\ D).
{ exact (andEL
    (((A /\ B) /\ C) /\ D)
    E
    Hleft4). }
claim Hleft2 : ((A /\ B) /\ C).
{ exact (andEL
    ((A /\ B) /\ C)
    D
    Hleft3). }
claim HabG : A.
{ exact (andEL
    A
    B
    (andEL
      (A /\ B)
      C
      Hleft2)). }
claim Hbasis1_fn : B.
{ exact (andER
    A
    B
    (andEL
      (A /\ B)
      C
      Hleft2)). }
claim Hh_hom : D.
{ exact (andER
    ((A /\ B) /\ C)
    D
    Hleft3). }
claim HimgEq : E.
{ exact (andER
    (((A /\ B) /\ C) /\ D)
    E
    Hleft4). }
claim HsubH : F.
{ exact (andER
    ((((A /\ B) /\ C) /\ D) /\ E)
    F
    Hleft5). }
claim Hbasis_square : L.
{ exact (andER
    ((((((A /\ B) /\ C) /\ D) /\ E) /\ F) /\ K)
    L
    Hleft7). }
set basis2 := graph J (fun alpha:set => apply_fun h (apply_fun basis1 alpha)).
claim Hh_fn : function_on h G G.
{ exact (andEL
    (function_on h G G)
    (forall x y:set, x :e G -> y :e G ->
      apply_fun h (apply_fun multG (x, y)) = apply_fun multG (apply_fun h x, apply_fun h y))
    Hh_hom). }
claim Hbasis2_fn : function_on basis2 J H.
{
  let alpha.
  assume Halpha : alpha :e J.
  rewrite (apply_fun_graph J (fun alpha0:set => apply_fun h (apply_fun basis1 alpha0)) alpha Halpha).
  claim Hb1G : apply_fun basis1 alpha :e G.
  { exact (Hbasis1_fn alpha Halpha). }
  rewrite HimgEq.
  exact (homomorphism_image_intro G h (apply_fun basis1 alpha) Hb1G).
}
claim HeqJ : J = n.
{ reflexivity. }
claim HequipJ : equip J n.
{ rewrite HeqJ.
  exact (equip_ref n). }
claim HfreeG :
  free_abelian_group_with_basis G multG eG invG J basis1.
{
  set Gfam_basis := graph J (fun alpha:set =>
    {g :e G | exists m:set, m :e int /\
      ((m :e omega /\ g = group_power_nat multG eG (apply_fun basis1 alpha) m) \/
       (exists k:set, k :e omega /\ m = minus_SNo (ordsucc k) /\
        g = group_power_nat multG eG (apply_fun invG (apply_fun basis1 alpha)) (ordsucc k)))}).
  claim Hrest :
    (forall alpha:set, alpha :e J ->
      infinite_cyclic_subgroup G multG eG invG (apply_fun basis1 alpha)) /\
    direct_sum_of_subgroups G multG eG invG J Gfam_basis.
  {
    apply andI.
    - let alpha.
      assume Halpha : alpha :e J.
      claim HgrpG : group_structure G multG eG invG.
      { exact (andEL
          (group_structure G multG eG invG)
          (forall x y:set, x :e G -> y :e G ->
            apply_fun multG (x, y) = apply_fun multG (y, x))
          HabG). }
      claim HgrpZ : group_structure int integers_group_mult 0 integers_group_inv.
      { exact integers_group_is_group_cyclic_helper. }
      claim Hifam_pack :
        group_homomorphism (apply_fun Gfam alpha)
          (apply_fun multfam alpha) G multG (apply_fun ifam alpha) /\
        (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
          apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) y -> x = y).
      { exact (Hifam_data alpha Halpha). }
      claim Hifam_hom_raw :
        group_homomorphism (apply_fun Gfam alpha)
          (apply_fun multfam alpha) G multG (apply_fun ifam alpha).
      { exact (andEL
          (group_homomorphism (apply_fun Gfam alpha)
            (apply_fun multfam alpha) G multG (apply_fun ifam alpha))
          (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
            apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) y -> x = y)
          Hifam_pack). }
      claim Hifam_inj :
        forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
          apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) y -> x = y.
      { exact (andER
          (group_homomorphism (apply_fun Gfam alpha)
            (apply_fun multfam alpha) G multG (apply_fun ifam alpha))
          (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
            apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) y -> x = y)
          Hifam_pack). }
      claim Hifam_hom :
        group_homomorphism int integers_group_mult G multG (apply_fun ifam alpha).
      {
        rewrite <- (apply_fun_graph J (fun _ : set => int) alpha Halpha).
        rewrite <- (apply_fun_graph J (fun _ : set => integers_group_mult) alpha Halpha).
        exact Hifam_hom_raw.
      }
      claim Hbasis_eq :
        apply_fun basis1 alpha = apply_fun (apply_fun ifam alpha) 1.
      { exact (Hbasis1_eq_ifam1 alpha Halpha). }
      claim Hpow_cl_gen : forall a:set, a :e G -> forall n:set, n :e omega ->
        group_power_nat multG eG a n :e G.
      {
        let a.
        assume HaG : a :e G.
        apply (and6E
          (function_on multG (setprod G G) G)
          (function_on invG G G)
          (eG :e G)
          (forall u v w:set, u :e G -> v :e G -> w :e G ->
            apply_fun multG (apply_fun multG (u, v), w) = apply_fun multG (u, apply_fun multG (v, w)))
          (forall u:set, u :e G -> apply_fun multG (eG, u) = u /\ apply_fun multG (u, eG) = u)
          (forall u:set, u :e G ->
            apply_fun multG (u, apply_fun invG u) = eG /\ apply_fun multG (apply_fun invG u, u) = eG)
          HgrpG).
        assume HmultFn HinvFn HeGG Hassoc Hid HinvLaw.
        let n.
        assume Hn : n :e omega.
        apply (nat_ind (fun k:set => group_power_nat multG eG a k :e G)).
        - exact (eq_subst_mem
            (group_power_nat multG eG a 0)
            eG
            G
            (nat_primrec_0 eG (fun _ r => apply_fun multG (a, r)))
            HeGG).
        - let k.
          assume Hk : nat_p k.
          assume IH : group_power_nat multG eG a k :e G.
          exact (eq_subst_mem
            (group_power_nat multG eG a (ordsucc k))
            (apply_fun multG (a, group_power_nat multG eG a k))
            G
            (nat_primrec_S eG (fun _ r => apply_fun multG (a, r)) k Hk)
            (HmultFn
              (a, group_power_nat multG eG a k)
              (tuple_2_setprod_by_pair_Sigma G G a (group_power_nat multG eG a k) HaG IH))).
        - exact (omega_nat_p n Hn).
      }
      apply (and4I
        (apply_fun basis1 alpha :e G)
        (forall n:set, n :e omega ->
          group_power_nat multG eG (apply_fun basis1 alpha) n :e G)
        (forall m:set, m :e omega ->
          group_power_nat multG eG (apply_fun invG (apply_fun basis1 alpha)) (ordsucc m) :e G)
        (~(exists n:set, n :e omega /\ n <> 0 /\
          group_power_nat multG eG (apply_fun basis1 alpha) n = eG))).
      + exact (Hbasis1_fn alpha Halpha).
      + exact (Hpow_cl_gen (apply_fun basis1 alpha) (Hbasis1_fn alpha Halpha)).
      + let m.
        assume Hm : m :e omega.
        claim Hinv_b : apply_fun invG (apply_fun basis1 alpha) :e G.
        {
          apply (and6E
            (function_on multG (setprod G G) G)
            (function_on invG G G)
            (eG :e G)
            (forall u v w:set, u :e G -> v :e G -> w :e G ->
              apply_fun multG (apply_fun multG (u, v), w) = apply_fun multG (u, apply_fun multG (v, w)))
            (forall u:set, u :e G -> apply_fun multG (eG, u) = u /\ apply_fun multG (u, eG) = u)
            (forall u:set, u :e G ->
              apply_fun multG (u, apply_fun invG u) = eG /\ apply_fun multG (apply_fun invG u, u) = eG)
            HgrpG).
          assume HmultFn HinvFn HeGG Hassoc Hid HinvLaw.
          exact (HinvFn (apply_fun basis1 alpha) (Hbasis1_fn alpha Halpha)).
        }
        exact (Hpow_cl_gen (apply_fun invG (apply_fun basis1 alpha)) Hinv_b
          (ordsucc m) (omega_ordsucc m Hm)).
      + assume Htors.
        apply Htors.
        let n.
        assume Hnpack.
        claim Hnleft : n :e omega /\ n <> 0.
        { exact (andEL
            (n :e omega /\ n <> 0)
            (group_power_nat multG eG (apply_fun basis1 alpha) n = eG)
            Hnpack). }
        claim HnO : n :e omega.
        { exact (andEL (n :e omega) (n <> 0) Hnleft). }
        claim HnNe0 : n <> 0.
        { exact (andER (n :e omega) (n <> 0) Hnleft). }
        claim HpowEq :
          group_power_nat multG eG (apply_fun basis1 alpha) n = eG.
        { exact (andER
            (n :e omega /\ n <> 0)
            (group_power_nat multG eG (apply_fun basis1 alpha) n = eG)
            Hnpack). }
        claim HoneInt : 1 :e int.
        { exact (Subq_omega_int 1 (nat_p_omega 1 nat_1)). }
        claim HnInt : n :e int.
        { exact (Subq_omega_int n HnO). }
        claim HnS : SNo n.
        { exact (int_SNo n HnInt). }
        claim HpowInt1 : group_power_nat integers_group_mult 0 1 n = n.
        {
          rewrite (integers_group_power_nat_mul_right_cyclic_helper 1 n HoneInt HnO).
          exact (mul_SNo_oneL n HnS).
        }
        claim Hifam_pow :
          apply_fun (apply_fun ifam alpha) n =
          group_power_nat multG eG (apply_fun basis1 alpha) n.
        {
          claim Hpow_pres :
            apply_fun (apply_fun ifam alpha) (group_power_nat integers_group_mult 0 1 n) =
            group_power_nat multG eG (apply_fun basis1 alpha) n.
          {
            rewrite Hbasis_eq.
            exact (group_homomorphism_preserves_power_nat_cyclic_helper
              int
              integers_group_mult
              0
              integers_group_inv
              G
              multG
              eG
              invG
              (apply_fun ifam alpha)
              1
              n
              HgrpZ
              HgrpG
              Hifam_hom
              HoneInt
              HnO).
          }
          claim Hlhs :
            apply_fun (apply_fun ifam alpha) n =
            apply_fun (apply_fun ifam alpha) (group_power_nat integers_group_mult 0 1 n).
          { rewrite HpowInt1.
            reflexivity. }
          exact (eq_i_tra
            (apply_fun (apply_fun ifam alpha) n)
            (apply_fun (apply_fun ifam alpha) (group_power_nat integers_group_mult 0 1 n))
            (group_power_nat multG eG (apply_fun basis1 alpha) n)
            Hlhs
            Hpow_pres).
        }
        claim Hifam_n_e : apply_fun (apply_fun ifam alpha) n = eG.
        { rewrite Hifam_pow.
          exact HpowEq. }
        claim Hifam_0_e : apply_fun (apply_fun ifam alpha) 0 = eG.
        {
          exact (group_hom_sends_identity_cyclic_helper
            int
            integers_group_mult
            0
            integers_group_inv
            G
            multG
            eG
            invG
            (apply_fun ifam alpha)
            HgrpZ
            HgrpG
            Hifam_hom).
        }
        claim HnGfam : n :e apply_fun Gfam alpha.
        { rewrite (apply_fun_graph J (fun _ : set => int) alpha Halpha).
          exact HnInt. }
        claim H0Gfam : 0 :e apply_fun Gfam alpha.
        { rewrite (apply_fun_graph J (fun _ : set => int) alpha Halpha).
          exact (Subq_omega_int 0 (nat_p_omega 0 nat_0)). }
        claim Hn0 : n = 0.
        { exact (Hifam_inj n 0 HnGfam H0Gfam
            (eq_i_tra
              (apply_fun (apply_fun ifam alpha) n)
              eG
              (apply_fun (apply_fun ifam alpha) 0)
              Hifam_n_e
              (eq_symm
                (apply_fun (apply_fun ifam alpha) 0)
                eG
                Hifam_0_e))). }
        exact (HnNe0 Hn0).
    - set ImgFam := graph J (fun alpha:set =>
        homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha)).
      claim Hfam_eq : Gfam_basis = ImgFam.
      {
        apply (graph_extensional J
          (fun alpha:set =>
            {g :e G | exists m:set, m :e int /\
              ((m :e omega /\ g = group_power_nat multG eG (apply_fun basis1 alpha) m) \/
               (exists k:set, k :e omega /\ m = minus_SNo (ordsucc k) /\
                g = group_power_nat multG eG (apply_fun invG (apply_fun basis1 alpha)) (ordsucc k)))})
          (fun alpha:set => homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha))).
        let alpha.
        assume Halpha : alpha :e J.
        claim HgrpG : group_structure G multG eG invG.
        { exact (andEL
            (group_structure G multG eG invG)
            (forall x y:set, x :e G -> y :e G ->
              apply_fun multG (x, y) = apply_fun multG (y, x))
            HabG). }
        claim HgrpZ : group_structure int integers_group_mult 0 integers_group_inv.
        { exact integers_group_is_group_cyclic_helper. }
        claim Hifam_pack :
          group_homomorphism (apply_fun Gfam alpha)
            (apply_fun multfam alpha) G multG (apply_fun ifam alpha) /\
          (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
            apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) y -> x = y).
        { exact (Hifam_data alpha Halpha). }
        claim Hifam_hom_raw :
          group_homomorphism (apply_fun Gfam alpha)
            (apply_fun multfam alpha) G multG (apply_fun ifam alpha).
        { exact (andEL
            (group_homomorphism (apply_fun Gfam alpha)
              (apply_fun multfam alpha) G multG (apply_fun ifam alpha))
            (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
              apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) y -> x = y)
            Hifam_pack). }
        claim Hifam_hom_int :
          group_homomorphism int integers_group_mult G multG (apply_fun ifam alpha).
        {
          rewrite <- (apply_fun_graph J (fun _ : set => int) alpha Halpha).
          rewrite <- (apply_fun_graph J (fun _ : set => integers_group_mult) alpha Halpha).
          exact Hifam_hom_raw.
        }
        claim Hifam_fn : function_on (apply_fun ifam alpha) int G.
        { exact (andEL
            (function_on (apply_fun ifam alpha) int G)
            (forall x y:set, x :e int -> y :e int ->
              apply_fun (apply_fun ifam alpha) (apply_fun integers_group_mult (x, y)) =
              apply_fun multG (apply_fun (apply_fun ifam alpha) x, apply_fun (apply_fun ifam alpha) y))
            Hifam_hom_int). }
        claim Hbasis_eq :
          apply_fun basis1 alpha = apply_fun (apply_fun ifam alpha) 1.
        { exact (Hbasis1_eq_ifam1 alpha Halpha). }
        claim HoneInt : 1 :e int.
        { exact (Subq_omega_int 1 (nat_p_omega 1 nat_1)). }
        claim Hifam_pos_pow : forall n:set, n :e omega ->
          apply_fun (apply_fun ifam alpha) n =
          group_power_nat multG eG (apply_fun basis1 alpha) n.
        {
          let n.
          assume HnO : n :e omega.
          claim HnInt : n :e int.
          { exact (Subq_omega_int n HnO). }
          claim HnS : SNo n.
          { exact (int_SNo n HnInt). }
          claim HpowInt1 : group_power_nat integers_group_mult 0 1 n = n.
          {
            rewrite (integers_group_power_nat_mul_right_cyclic_helper 1 n HoneInt HnO).
            exact (mul_SNo_oneL n HnS).
          }
          claim Hpow_pres :
            apply_fun (apply_fun ifam alpha) (group_power_nat integers_group_mult 0 1 n) =
            group_power_nat multG eG (apply_fun basis1 alpha) n.
          {
            rewrite Hbasis_eq.
            exact (group_homomorphism_preserves_power_nat_cyclic_helper
              int
              integers_group_mult
              0
              integers_group_inv
              G
              multG
              eG
              invG
              (apply_fun ifam alpha)
              1
              n
              HgrpZ
              HgrpG
              Hifam_hom_int
              HoneInt
              HnO).
          }
          claim Hlhs :
            apply_fun (apply_fun ifam alpha) n =
            apply_fun (apply_fun ifam alpha) (group_power_nat integers_group_mult 0 1 n).
          { rewrite HpowInt1.
            reflexivity. }
          exact (eq_i_tra
            (apply_fun (apply_fun ifam alpha) n)
            (apply_fun (apply_fun ifam alpha) (group_power_nat integers_group_mult 0 1 n))
            (group_power_nat multG eG (apply_fun basis1 alpha) n)
            Hlhs
            Hpow_pres).
        }
        claim Hifam_neg_pow : forall k:set, k :e omega ->
          apply_fun (apply_fun ifam alpha) (minus_SNo (ordsucc k)) =
          group_power_nat multG eG (apply_fun invG (apply_fun basis1 alpha)) (ordsucc k).
        {
          let k.
          assume HkO : k :e omega.
          claim HskO : ordsucc k :e omega.
          { exact (omega_ordsucc k HkO). }
          claim HskInt : ordsucc k :e int.
          { exact (Subq_omega_int (ordsucc k) HskO). }
          claim HskS : SNo (ordsucc k).
          { exact (int_SNo (ordsucc k) HskInt). }
          claim Hm1Int : minus_SNo 1 :e int.
          { exact (int_minus_SNo 1 HoneInt). }
          claim HpowIntMinusOne :
            group_power_nat integers_group_mult 0 (minus_SNo 1) (ordsucc k) =
            minus_SNo (ordsucc k).
          {
            rewrite (integers_group_power_nat_mul_right_cyclic_helper
              (minus_SNo 1)
              (ordsucc k)
              Hm1Int
              HskO).
            rewrite (mul_SNo_minus_distrL 1 (ordsucc k) SNo_1 HskS).
            rewrite (mul_SNo_oneL (ordsucc k) HskS).
            reflexivity.
          }
          claim Hinv1 : apply_fun integers_group_inv 1 = minus_SNo 1.
          {
            rewrite (apply_fun_graph int (fun n:set => minus_SNo n) 1 HoneInt).
            reflexivity.
          }
          claim Hpow_pres :
            apply_fun (apply_fun ifam alpha)
              (group_power_nat integers_group_mult 0 (apply_fun integers_group_inv 1) (ordsucc k)) =
            group_power_nat multG eG (apply_fun invG (apply_fun basis1 alpha)) (ordsucc k).
          {
            rewrite Hbasis_eq.
            exact (group_homomorphism_preserves_inverse_power_nat_cyclic_helper
              int
              integers_group_mult
              0
              integers_group_inv
              G
              multG
              eG
              invG
              (apply_fun ifam alpha)
              1
              (ordsucc k)
              HgrpZ
              HgrpG
              Hifam_hom_int
              HoneInt
              HskO).
          }
          claim Hlhs :
            apply_fun (apply_fun ifam alpha) (minus_SNo (ordsucc k)) =
            apply_fun (apply_fun ifam alpha)
              (group_power_nat integers_group_mult 0 (apply_fun integers_group_inv 1) (ordsucc k)).
          {
            rewrite Hinv1.
            rewrite HpowIntMinusOne.
            reflexivity.
          }
          exact (eq_i_tra
            (apply_fun (apply_fun ifam alpha) (minus_SNo (ordsucc k)))
            (apply_fun (apply_fun ifam alpha)
              (group_power_nat integers_group_mult 0 (apply_fun integers_group_inv 1) (ordsucc k)))
            (group_power_nat multG eG (apply_fun invG (apply_fun basis1 alpha)) (ordsucc k))
            Hlhs
            Hpow_pres).
        }
        apply set_ext.
        - let g.
          assume HgL : g :e {g :e G | exists m:set, m :e int /\
            ((m :e omega /\ g = group_power_nat multG eG (apply_fun basis1 alpha) m) \/
             (exists k:set, k :e omega /\ m = minus_SNo (ordsucc k) /\
              g = group_power_nat multG eG (apply_fun invG (apply_fun basis1 alpha)) (ordsucc k)))}.
          claim HmEx : exists m:set, m :e int /\
            ((m :e omega /\ g = group_power_nat multG eG (apply_fun basis1 alpha) m) \/
             (exists k:set, k :e omega /\ m = minus_SNo (ordsucc k) /\
              g = group_power_nat multG eG (apply_fun invG (apply_fun basis1 alpha)) (ordsucc k))).
          { exact (SepE2
              G
              (fun g0:set => exists m:set, m :e int /\
                ((m :e omega /\ g0 = group_power_nat multG eG (apply_fun basis1 alpha) m) \/
                 (exists k:set, k :e omega /\ m = minus_SNo (ordsucc k) /\
                  g0 = group_power_nat multG eG (apply_fun invG (apply_fun basis1 alpha)) (ordsucc k))))
              g
              HgL). }
          apply HmEx.
          let m.
          assume HmPack.
          claim HmInt : m :e int.
          { exact (andEL
              (m :e int)
              ((m :e omega /\ g = group_power_nat multG eG (apply_fun basis1 alpha) m) \/
               (exists k:set, k :e omega /\ m = minus_SNo (ordsucc k) /\
                g = group_power_nat multG eG (apply_fun invG (apply_fun basis1 alpha)) (ordsucc k)))
              HmPack). }
          claim HmInGa : m :e apply_fun Gfam alpha.
          { rewrite (apply_fun_graph J (fun _ : set => int) alpha Halpha).
            exact HmInt. }
          claim Hcases :
            (m :e omega /\ g = group_power_nat multG eG (apply_fun basis1 alpha) m) \/
            (exists k:set, k :e omega /\ m = minus_SNo (ordsucc k) /\
              g = group_power_nat multG eG (apply_fun invG (apply_fun basis1 alpha)) (ordsucc k)).
          { exact (andER
              (m :e int)
              ((m :e omega /\ g = group_power_nat multG eG (apply_fun basis1 alpha) m) \/
               (exists k:set, k :e omega /\ m = minus_SNo (ordsucc k) /\
                g = group_power_nat multG eG (apply_fun invG (apply_fun basis1 alpha)) (ordsucc k)))
              HmPack). }
          apply Hcases.
          + assume Hpos.
            claim HmO : m :e omega.
            { exact (andEL
                (m :e omega)
                (g = group_power_nat multG eG (apply_fun basis1 alpha) m)
                Hpos). }
            claim HgPow :
              g = group_power_nat multG eG (apply_fun basis1 alpha) m.
            { exact (andER
                (m :e omega)
                (g = group_power_nat multG eG (apply_fun basis1 alpha) m)
                Hpos). }
            claim HifamMg :
              apply_fun (apply_fun ifam alpha) m = g.
            {
              exact (eq_i_tra
                (apply_fun (apply_fun ifam alpha) m)
                (group_power_nat multG eG (apply_fun basis1 alpha) m)
                g
                (Hifam_pos_pow m HmO)
                (eq_symm
                  g
                  (group_power_nat multG eG (apply_fun basis1 alpha) m)
                  HgPow)).
            }
            claim HimgM :
              apply_fun (apply_fun ifam alpha) m :e homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha).
            { exact (homomorphism_image_intro (apply_fun Gfam alpha) (apply_fun ifam alpha) m HmInGa). }
            rewrite <- HifamMg.
            exact HimgM.
          + assume Hneg.
            apply Hneg.
            let k.
            assume HkPack.
            claim HkO : k :e omega.
            { exact (andEL
                (k :e omega)
                (m = minus_SNo (ordsucc k))
                (andEL
                  (k :e omega /\ m = minus_SNo (ordsucc k))
                  (g = group_power_nat multG eG (apply_fun invG (apply_fun basis1 alpha)) (ordsucc k))
                  HkPack)). }
            claim HmNeg : m = minus_SNo (ordsucc k).
            { exact (andER
                (k :e omega)
                (m = minus_SNo (ordsucc k))
                (andEL
                  (k :e omega /\ m = minus_SNo (ordsucc k))
                  (g = group_power_nat multG eG (apply_fun invG (apply_fun basis1 alpha)) (ordsucc k))
                  HkPack)). }
            claim HgNeg :
              g = group_power_nat multG eG (apply_fun invG (apply_fun basis1 alpha)) (ordsucc k).
            { exact (andER
                (k :e omega /\ m = minus_SNo (ordsucc k))
                (g = group_power_nat multG eG (apply_fun invG (apply_fun basis1 alpha)) (ordsucc k))
                HkPack). }
            claim HifamMg :
              apply_fun (apply_fun ifam alpha) m = g.
            {
              claim Hstep0 :
                apply_fun (apply_fun ifam alpha) m =
                apply_fun (apply_fun ifam alpha) (minus_SNo (ordsucc k)).
              { rewrite HmNeg.
                reflexivity. }
              exact (eq_i_tra
                (apply_fun (apply_fun ifam alpha) m)
                (apply_fun (apply_fun ifam alpha) (minus_SNo (ordsucc k)))
                g
                Hstep0
                (eq_i_tra
                  (apply_fun (apply_fun ifam alpha) (minus_SNo (ordsucc k)))
                  (group_power_nat multG eG (apply_fun invG (apply_fun basis1 alpha)) (ordsucc k))
                  g
                  (Hifam_neg_pow k HkO)
                  (eq_symm
                    g
                    (group_power_nat multG eG (apply_fun invG (apply_fun basis1 alpha)) (ordsucc k))
                    HgNeg))).
            }
            claim HimgM :
              apply_fun (apply_fun ifam alpha) m :e homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha).
            { exact (homomorphism_image_intro (apply_fun Gfam alpha) (apply_fun ifam alpha) m HmInGa). }
            rewrite <- HifamMg.
            exact HimgM.
        - let g.
          assume HgImg : g :e homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha).
          claim Hexm : exists m:set, m :e apply_fun Gfam alpha /\ g = apply_fun (apply_fun ifam alpha) m.
          { exact (iffEL
              (g :e homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha))
              (exists m:set, m :e apply_fun Gfam alpha /\ g = apply_fun (apply_fun ifam alpha) m)
              (homomorphism_image_mem (apply_fun Gfam alpha) (apply_fun ifam alpha) g)
              HgImg). }
          apply Hexm.
          let m.
          assume HmPack.
          claim HmInGa : m :e apply_fun Gfam alpha.
          { exact (andEL
              (m :e apply_fun Gfam alpha)
              (g = apply_fun (apply_fun ifam alpha) m)
              HmPack). }
          claim HgEq : g = apply_fun (apply_fun ifam alpha) m.
          { exact (andER
              (m :e apply_fun Gfam alpha)
              (g = apply_fun (apply_fun ifam alpha) m)
              HmPack). }
          claim HmInt : m :e int.
          { rewrite <- (apply_fun_graph J (fun _ : set => int) alpha Halpha).
            exact HmInGa. }
          claim HgG : g :e G.
          {
            rewrite HgEq.
            exact (Hifam_fn m HmInt).
          }
          apply (SepI
            G
            (fun g0:set => exists m0:set, m0 :e int /\
              ((m0 :e omega /\ g0 = group_power_nat multG eG (apply_fun basis1 alpha) m0) \/
               (exists k:set, k :e omega /\ m0 = minus_SNo (ordsucc k) /\
                g0 = group_power_nat multG eG (apply_fun invG (apply_fun basis1 alpha)) (ordsucc k))))
            g
            HgG).
          witness m.
          apply andI.
          + exact HmInt.
          + apply (xm (m :e omega)).
            * assume HmO : m :e omega.
              apply orIL.
              apply andI.
              { exact HmO. }
              { exact (eq_i_tra
                  g
                  (apply_fun (apply_fun ifam alpha) m)
                  (group_power_nat multG eG (apply_fun basis1 alpha) m)
                  HgEq
                  (Hifam_pos_pow m HmO)). }
            * assume HmNotO : ~(m :e omega).
              claim HmNe0 : m <> 0.
              {
                assume Hm0.
                apply HmNotO.
                rewrite Hm0.
                exact (nat_p_omega 0 nat_0).
              }
              claim HmCases :
                (exists p:set, p :e omega /\ m = ordsucc p) \/
                (exists p:set, p :e omega /\ m = minus_SNo (ordsucc p)).
              { exact (int_nonzero_cases_cyclic_helper m HmInt HmNe0). }
              apply HmCases.
              { assume HmPos.
                apply HmPos.
                let p.
                assume HpPack.
                claim HpO : p :e omega.
                { exact (andEL
                    (p :e omega)
                    (m = ordsucc p)
                    HpPack). }
                claim HmPosEq : m = ordsucc p.
                { exact (andER
                    (p :e omega)
                    (m = ordsucc p)
                    HpPack). }
                claim HmO2 : m :e omega.
                { rewrite HmPosEq.
                  exact (omega_ordsucc p HpO). }
                exact (FalseE
                  (HmNotO HmO2)
                  ((m :e omega /\ g = group_power_nat multG eG (apply_fun basis1 alpha) m) \/
                   (exists k:set, k :e omega /\ m = minus_SNo (ordsucc k) /\
                    g = group_power_nat multG eG (apply_fun invG (apply_fun basis1 alpha)) (ordsucc k)))).
              }
              { assume HmNeg.
                apply HmNeg.
                let k.
                assume HkPack.
                claim HkO : k :e omega.
                { exact (andEL
                    (k :e omega)
                    (m = minus_SNo (ordsucc k))
                    HkPack). }
                claim HmNegEq : m = minus_SNo (ordsucc k).
                { exact (andER
                    (k :e omega)
                    (m = minus_SNo (ordsucc k))
                    HkPack). }
                apply orIR.
                witness k.
                apply and3I.
                - exact HkO.
                - exact HmNegEq.
                - claim HgNeg :
                    g = apply_fun (apply_fun ifam alpha) (minus_SNo (ordsucc k)).
                  {
                    claim Hstepm :
                      apply_fun (apply_fun ifam alpha) m =
                      apply_fun (apply_fun ifam alpha) (minus_SNo (ordsucc k)).
                    { rewrite HmNegEq.
                      reflexivity. }
                    exact (eq_i_tra
                      g
                      (apply_fun (apply_fun ifam alpha) m)
                      (apply_fun (apply_fun ifam alpha) (minus_SNo (ordsucc k)))
                      HgEq
                      Hstepm).
                  }
                  exact (eq_i_tra
                    g
                    (apply_fun (apply_fun ifam alpha) (minus_SNo (ordsucc k)))
                    (group_power_nat multG eG (apply_fun invG (apply_fun basis1 alpha)) (ordsucc k))
                    HgNeg
                    (Hifam_neg_pow k HkO)).
              }
      }
      claim HdsImg : direct_sum_of_subgroups G multG eG invG J ImgFam.
      { exact (andER
          (A /\ B)
          C
          Hleft2). }
      rewrite Hfam_eq.
      exact HdsImg.
  }
  apply (and4I
    (abelian_group G multG eG invG)
    (function_on basis1 J G)
    (forall alpha:set, alpha :e J ->
      infinite_cyclic_subgroup G multG eG invG (apply_fun basis1 alpha))
    (direct_sum_of_subgroups G multG eG invG J Gfam_basis)).
  - exact HabG.
  - exact Hbasis1_fn.
  - exact (andEL
      (forall alpha:set, alpha :e J ->
        infinite_cyclic_subgroup G multG eG invG (apply_fun basis1 alpha))
      (direct_sum_of_subgroups G multG eG invG J Gfam_basis)
      Hrest).
  - exact (andER
      (forall alpha:set, alpha :e J ->
        infinite_cyclic_subgroup G multG eG invG (apply_fun basis1 alpha))
      (direct_sum_of_subgroups G multG eG invG J Gfam_basis)
      Hrest).
}
claim Hproper : H <> G.
{
  assume Habs : H = G.
  claim HgrpG : group_structure G multG eG invG.
  { exact (andEL
      (group_structure G multG eG invG)
      (forall x y:set, x :e G -> y :e G ->
        apply_fun multG (x, y) = apply_fun multG (y, x))
      HabG). }
  claim Hgrp2 : group_structure 2 Z2_mult 0 Z2_inv.
  { exact (andEL
      (group_structure 2 Z2_mult 0 Z2_inv)
      (forall x y:set, x :e 2 -> y :e 2 ->
        apply_fun Z2_mult (x, y) = apply_fun Z2_mult (y, x))
      Z2_abelian_group). }
  claim HJne : J <> 0.
  { rewrite HeqJ.
    exact HnNZ. }
  apply (nonempty_has_element J HJne).
  let alpha.
  assume Halpha : alpha :e J.
  set S := {alpha}.
  claim HSJ : S c= J.
  { exact (singleton_subset alpha J Halpha). }
  claim Hk_exists : exists k:set,
    group_homomorphism G multG 2 Z2_mult k /\
    (forall beta:set, beta :e S -> apply_fun k (apply_fun basis1 beta) = 1) /\
    (forall beta:set, beta :e J -> ~(beta :e S) -> apply_fun k (apply_fun basis1 beta) = 0).
  { exact (free_abelian_hom_from_subset
      G multG eG invG J basis1 S
      HfreeG
      HSJ). }
  apply Hk_exists.
  let k.
  assume Hkpack.
  claim Hk_left :
    group_homomorphism G multG 2 Z2_mult k /\
    (forall beta:set, beta :e S -> apply_fun k (apply_fun basis1 beta) = 1).
  { exact (andEL
      (group_homomorphism G multG 2 Z2_mult k /\
        (forall beta:set, beta :e S -> apply_fun k (apply_fun basis1 beta) = 1))
      (forall beta:set, beta :e J -> ~(beta :e S) -> apply_fun k (apply_fun basis1 beta) = 0)
      Hkpack). }
  claim Hk_hom : group_homomorphism G multG 2 Z2_mult k.
  { exact (andEL
      (group_homomorphism G multG 2 Z2_mult k)
      (forall beta:set, beta :e S -> apply_fun k (apply_fun basis1 beta) = 1)
      Hk_left). }
  claim Hk_onS : forall beta:set, beta :e S -> apply_fun k (apply_fun basis1 beta) = 1.
  { exact (andER
      (group_homomorphism G multG 2 Z2_mult k)
      (forall beta:set, beta :e S -> apply_fun k (apply_fun basis1 beta) = 1)
      Hk_left). }
  set hz := graph G (fun _ : set => 0).
  claim HmultG_fn : function_on multG (setprod G G) G.
  {
    apply (and6E
      (function_on multG (setprod G G) G)
      (function_on invG G G)
      (eG :e G)
      (forall x y z:set, x :e G -> y :e G -> z :e G ->
        apply_fun multG (apply_fun multG (x, y), z) = apply_fun multG (x, apply_fun multG (y, z)))
      (forall x:set, x :e G -> apply_fun multG (eG, x) = x /\ apply_fun multG (x, eG) = x)
      (forall x:set, x :e G ->
        apply_fun multG (x, apply_fun invG x) = eG /\ apply_fun multG (apply_fun invG x, x) = eG)
      HgrpG).
    assume Hmult Hinv He Hassoc Hid Hinvlaw.
    exact Hmult.
  }
  claim Hhz_hom : group_homomorphism G multG 2 Z2_mult hz.
  {
    prove function_on hz G 2 /\
      (forall x y:set, x :e G -> y :e G ->
        apply_fun hz (apply_fun multG (x, y)) =
        apply_fun Z2_mult (apply_fun hz x, apply_fun hz y)).
    apply andI.
    - exact (function_on_graph_const G 2 0 In_0_2).
    - let x.
      let y.
      assume Hx : x :e G.
      assume Hy : y :e G.
      claim Hxy : apply_fun multG (x, y) :e G.
      { exact (HmultG_fn (x, y) (tuple_2_setprod_by_pair_Sigma G G x y Hx Hy)). }
      rewrite (apply_fun_graph G (fun _ : set => 0) (apply_fun multG (x, y)) Hxy).
      rewrite (apply_fun_graph G (fun _ : set => 0) x Hx).
      rewrite (apply_fun_graph G (fun _ : set => 0) y Hy).
      exact (eq_symm
        (apply_fun Z2_mult (0, 0))
        0
        Z2_mult_0_0).
  }
  claim Hkh_hom : group_homomorphism G multG 2 Z2_mult (compose_fun G h k).
  { exact (group_homomorphism_compose_cyclic_helper
      G multG eG invG
      G multG
      2 Z2_mult
      h
      k
      HgrpG
      Hh_hom
      Hk_hom). }
  claim Hkh_basis :
    forall beta:set, beta :e J ->
      apply_fun (compose_fun G h k) (apply_fun basis1 beta) =
      apply_fun hz (apply_fun basis1 beta).
  {
    let beta.
    assume Hbeta : beta :e J.
    claim HbG : apply_fun basis1 beta :e G.
    { exact (Hbasis1_fn beta Hbeta). }
    rewrite (compose_fun_apply G h k (apply_fun basis1 beta) HbG).
    rewrite (Hbasis_square beta Hbeta).
    claim Hk_mult : forall x y:set, x :e G -> y :e G ->
      apply_fun k (apply_fun multG (x, y)) =
      apply_fun Z2_mult (apply_fun k x, apply_fun k y).
    { exact (andER
        (function_on k G 2)
        (forall x y:set, x :e G -> y :e G ->
          apply_fun k (apply_fun multG (x, y)) =
          apply_fun Z2_mult (apply_fun k x, apply_fun k y))
        Hk_hom). }
    rewrite (Hk_mult (apply_fun basis1 beta) (apply_fun basis1 beta) HbG HbG).
    claim Hk_fn : function_on k G 2.
    { exact (andEL
        (function_on k G 2)
        (forall x y:set, x :e G -> y :e G ->
          apply_fun k (apply_fun multG (x, y)) =
          apply_fun Z2_mult (apply_fun k x, apply_fun k y))
        Hk_hom). }
    claim Hkb2 : apply_fun k (apply_fun basis1 beta) :e 2.
    { exact (Hk_fn (apply_fun basis1 beta) HbG). }
    rewrite (Z2_mult_eval
      (apply_fun k (apply_fun basis1 beta))
      (apply_fun k (apply_fun basis1 beta))
      Hkb2
      Hkb2).
    claim Hrefl :
      apply_fun k (apply_fun basis1 beta) = apply_fun k (apply_fun basis1 beta).
    { reflexivity. }
    rewrite (If_i_1
      (apply_fun k (apply_fun basis1 beta) = apply_fun k (apply_fun basis1 beta))
      0
      1
      Hrefl).
    rewrite (apply_fun_graph G (fun _ : set => 0) (apply_fun basis1 beta) HbG).
    reflexivity.
  }
  claim Hkh_eq_hz :
    forall x:set, x :e G ->
      apply_fun (compose_fun G h k) x = apply_fun hz x.
  {
    let x.
    assume Hx : x :e G.
    exact (hom_Z2_determined_by_basis
      G multG eG invG J basis1
      (compose_fun G h k)
      hz
      HfreeG
      Hkh_hom
      Hhz_hom
      Hkh_basis
      x
      Hx).
  }
  claim Hb1G : apply_fun basis1 alpha :e G.
  { exact (Hbasis1_fn alpha Halpha). }
  claim Hb1H : apply_fun basis1 alpha :e H.
  { rewrite Habs.
    exact Hb1G. }
  claim Hb1Img : apply_fun basis1 alpha :e homomorphism_image G h.
  { rewrite <- HimgEq.
    exact Hb1H. }
  apply (ReplE_impred G (fun z:set => apply_fun h z) (apply_fun basis1 alpha) Hb1Img).
  let x.
  assume HxG : x :e G.
  assume Hhx : apply_fun basis1 alpha = apply_fun h x.
  claim Hk_alpha_1 : apply_fun k (apply_fun basis1 alpha) = 1.
  { exact (Hk_onS alpha (SingI alpha)). }
  claim Hk_alpha_comp : apply_fun k (apply_fun basis1 alpha) = apply_fun (compose_fun G h k) x.
  {
    rewrite Hhx.
    exact (eq_symm
      (apply_fun (compose_fun G h k) x)
      (apply_fun k (apply_fun h x))
      (compose_fun_apply G h k x HxG)).
  }
  claim Hk_alpha_0 : apply_fun k (apply_fun basis1 alpha) = 0.
  {
    exact (eq_i_tra
      (apply_fun k (apply_fun basis1 alpha))
      (apply_fun (compose_fun G h k) x)
      0
      Hk_alpha_comp
      (eq_i_tra
        (apply_fun (compose_fun G h k) x)
        (apply_fun hz x)
        0
        (Hkh_eq_hz x HxG)
        (apply_fun_graph G (fun _ : set => 0) x HxG))).
  }
  exact (neq_1_0
    (eq_i_tra
      1
      (apply_fun k (apply_fun basis1 alpha))
      0
      (eq_symm
        (apply_fun k (apply_fun basis1 alpha))
        1
        Hk_alpha_1)
      Hk_alpha_0)).
}
claim HabH : abelian_group H multG eG invG.
{ exact (subgroup_of_abelian_is_abelian
    G multG eG invG H
    HabG
    HsubH). }
claim HfreeH :
  free_abelian_group_with_basis H multG eG invG J basis2.
{
  set GfamH := graph J (fun alpha:set =>
    {g :e H | exists m:set, m :e int /\
      ((m :e omega /\ g = group_power_nat multG eG (apply_fun basis2 alpha) m) \/
       (exists k:set, k :e omega /\ m = minus_SNo (ordsucc k) /\
        g = group_power_nat multG eG (apply_fun invG (apply_fun basis2 alpha)) (ordsucc k)))}).
  claim HrestH :
    (forall alpha:set, alpha :e J ->
      infinite_cyclic_subgroup H multG eG invG (apply_fun basis2 alpha)) /\
    direct_sum_of_subgroups H multG eG invG J GfamH.
  {
    apply andI.
    - let alpha.
      assume Halpha : alpha :e J.
      claim HgrpH : group_structure H multG eG invG.
      { exact (andEL
          (group_structure H multG eG invG)
          (forall x y:set, x :e H -> y :e H ->
            apply_fun multG (x, y) = apply_fun multG (y, x))
          HabH). }
      claim HgrpG : group_structure G multG eG invG.
      { exact (andEL
          (group_structure G multG eG invG)
          (forall x y:set, x :e G -> y :e G ->
            apply_fun multG (x, y) = apply_fun multG (y, x))
          HabG). }
      claim HgrpZ : group_structure int integers_group_mult 0 integers_group_inv.
      { exact integers_group_is_group_cyclic_helper. }
      claim Hifam_pack :
        group_homomorphism (apply_fun Gfam alpha)
          (apply_fun multfam alpha) G multG (apply_fun ifam alpha) /\
        (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
          apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) y -> x = y).
      { exact (Hifam_data alpha Halpha). }
      claim Hifam_hom_raw :
        group_homomorphism (apply_fun Gfam alpha)
          (apply_fun multfam alpha) G multG (apply_fun ifam alpha).
      { exact (andEL
          (group_homomorphism (apply_fun Gfam alpha)
            (apply_fun multfam alpha) G multG (apply_fun ifam alpha))
          (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
            apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) y -> x = y)
          Hifam_pack). }
      claim Hifam_inj :
        forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
          apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) y -> x = y.
      { exact (andER
          (group_homomorphism (apply_fun Gfam alpha)
            (apply_fun multfam alpha) G multG (apply_fun ifam alpha))
          (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
            apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) y -> x = y)
          Hifam_pack). }
      claim Hifam_hom :
        group_homomorphism int integers_group_mult G multG (apply_fun ifam alpha).
      {
        rewrite <- (apply_fun_graph J (fun _ : set => int) alpha Halpha).
        rewrite <- (apply_fun_graph J (fun _ : set => integers_group_mult) alpha Halpha).
        exact Hifam_hom_raw.
      }
      claim Hh_basis2 : K.
      { exact (andER
          (((((A /\ B) /\ C) /\ D) /\ E) /\ F)
          K
          Hleft6). }
      claim Hbasis2_eq_ifam2 :
        apply_fun basis2 alpha = apply_fun (apply_fun ifam alpha) 2.
      {
        rewrite (apply_fun_graph J (fun alpha0:set => apply_fun h (apply_fun basis1 alpha0)) alpha Halpha).
        exact (Hh_basis2 alpha Halpha).
      }
      claim Hpow_cl_H : forall a:set, a :e H -> forall n:set, n :e omega ->
        group_power_nat multG eG a n :e H.
      {
        let a.
        assume HaH : a :e H.
        apply (and6E
          (function_on multG (setprod H H) H)
          (function_on invG H H)
