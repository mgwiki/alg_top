Definition diffquot_forward_abs : set -> set -> set -> set := fun f x h => Abs (div_SNo (add_SNo (apply_fun f (add_SNo x h)) (minus_SNo (apply_fun f x))) h).
Definition diffquot_backward_abs : set -> set -> set -> set := fun f x h => Abs (div_SNo (add_SNo (apply_fun f (add_SNo x (minus_SNo h))) (minus_SNo (apply_fun f x))) (minus_SNo h)).
Axiom ex49_diffquot_forward_abs_num_lower : forall f x h n : set , function_on f unit_interval R -> x :e unit_interval -> add_SNo x h :e unit_interval -> h :e R -> 0 < h -> n :e R -> Rlt n (diffquot_forward_abs f x h) -> Rlt (mul_SNo n h) (Abs (add_SNo (apply_fun f (add_SNo x h)) (minus_SNo (apply_fun f x)))).
Axiom ex49_diffquot_backward_abs_num_lower : forall f x h n : set , function_on f unit_interval R -> x :e unit_interval -> add_SNo x (minus_SNo h) :e unit_interval -> h :e R -> 0 < h -> n :e R -> Rlt n (diffquot_backward_abs f x h) -> Rlt (mul_SNo n h) (Abs (add_SNo (apply_fun f (add_SNo x (minus_SNo h))) (minus_SNo (apply_fun f x)))).
Axiom ex49_forward_increment_add_on_I_mul_const : forall f z c x h : set , c :e R -> function_on f unit_interval R -> function_on z unit_interval R -> x :e unit_interval -> add_SNo x h :e unit_interval -> h :e R -> add_SNo (apply_fun (ex49_add_on_I f (ex49_mul_const_on_I c z)) (add_SNo x h)) (minus_SNo (apply_fun (ex49_add_on_I f (ex49_mul_const_on_I c z)) x)) = add_SNo (add_SNo (apply_fun f (add_SNo x h)) (minus_SNo (apply_fun f x))) (mul_SNo (add_SNo (apply_fun z (add_SNo x h)) (minus_SNo (apply_fun z x))) c).
Axiom ex49_backward_increment_add_on_I_mul_const : forall f z c x h : set , c :e R -> function_on f unit_interval R -> function_on z unit_interval R -> x :e unit_interval -> add_SNo x (minus_SNo h) :e unit_interval -> h :e R -> add_SNo (apply_fun (ex49_add_on_I f (ex49_mul_const_on_I c z)) (add_SNo x (minus_SNo h))) (minus_SNo (apply_fun (ex49_add_on_I f (ex49_mul_const_on_I c z)) x)) = add_SNo (add_SNo (apply_fun f (add_SNo x (minus_SNo h))) (minus_SNo (apply_fun f x))) (mul_SNo (add_SNo (apply_fun z (add_SNo x (minus_SNo h))) (minus_SNo (apply_fun z x))) c).
Axiom ex49_pow2_mul_eps_add_nat_eq_eps2 : forall k : set , nat_p k -> mul_SNo (exp_SNo_nat 2 k) (eps_ (add_nat k 2)) = eps_ 2.
Axiom ex49_diffquot_forward_abs_add_on_I_cancel : forall f g x h : set , function_on f unit_interval R -> function_on g unit_interval R -> x :e unit_interval -> add_SNo x h :e unit_interval -> h :e R -> apply_fun g (add_SNo x h) = apply_fun g x -> diffquot_forward_abs (ex49_add_on_I f g) x h = diffquot_forward_abs f x h.
