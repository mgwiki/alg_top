witness lam.
apply andI.
- exact Hlampos.
- claim Hvexists :
    exists w:set,
      function_on w (ordsucc n) R /\
      ~(forall i:set, i :e ordsucc n -> apply_fun w i = 0) /\
      (forall i:set, i :e ordsucc n ->
