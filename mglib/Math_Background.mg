Theorem supp_ex_1b_compact_Hausdorff_star_refinement :
  forall X Tx:set,
  compact_space X Tx -> Hausdorff_space X Tx ->
  forall A:set, open_cover_of X Tx A ->
  exists B:set, star_refinement_cover X Tx B A /\ finite B.
admit.
Admitted.

