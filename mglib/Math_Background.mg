		                    claim Hrhs :
		                      group_power_nat multG eG (apply_fun invG (apply_fun hifam 1)) (ordsucc k) =
		                      group_power_nat multG eG (apply_fun invG (apply_fun basis2 alpha)) (ordsucc k).
		                    { rewrite Hhifam1_basis2.
