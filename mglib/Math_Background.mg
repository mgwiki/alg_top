(** Bounty 30 **)
Theorem cyclic_infinite_order_iff_Z : forall G mult e inv:set,
  group_structure G mult e inv ->
  cyclic_group G mult e inv ->
  ~ finite G ->
  exists phi:set, group_isomorphism G mult int integers_group_mult phi.
