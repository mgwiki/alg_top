      (fun _ : set => R)
      z
      HzR2).
  }
  claim Hz1R : z 1 :e R.
  {
    exact (ap1_Sigma
      R
      (fun _ : set => R)
      z
      HzR2).
  }
  claim Hz0S : SNo (z 0).
  {
    exact (real_SNo
      (z 0)
      Hz0R).
  }
  claim Hz1S : SNo (z 1).
  {
    exact (real_SNo
      (z 1)
      Hz1R).
  }
  claim Hrecip1 : recip_SNo_pos 1 = 1.
  {
    claim Hinv1 : mul_SNo 1 (recip_SNo_pos 1) = 1.
    {
      exact (recip_SNo_pos_invR
        1
        SNo_1
        (RltE_lt 0 1 Rlt_0_1)).
    }
    exact (eq_i_tra
      (recip_SNo_pos 1)
      (mul_SNo 1 (recip_SNo_pos 1))
      1
      (eq_symm
        (mul_SNo 1 (recip_SNo_pos 1))
        (recip_SNo_pos 1)
        (mul_SNo_oneL
          (recip_SNo_pos 1)
          (SNo_recip_SNo_pos
            1
            SNo_1
            (RltE_lt 0 1 Rlt_0_1))))
      Hinv1).
