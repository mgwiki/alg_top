    {
      exact ((andEL
        (preimage_of E pi (Sing y) <> Empty -> (exists x0:set, x0 :e E /\ apply_fun pi x0 = y))
        ((exists x0:set, x0 :e E /\ apply_fun pi x0 = y) -> preimage_of E pi (Sing y) <> Empty)
        (preimage_singleton_nonempty_iff_exists_preimage_point E pi y))
        HpreNe).
    }
    claim Hfalse : False.
