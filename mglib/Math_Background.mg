    HincR2Cont)
    (continuous_map_function_on
      (setprod R R)
      R2_topology
      R
      R_standard_topology
      (projection_map1 R R)
      Hproj1Cont)).
}
claim Hx1FS : x1 :e function_space S1 R.
{
  exact (compose_fun_in_function_space
    S1
    (setprod R R)
    R
    (graph S1 (fun z:set => z))
    (projection_map2 R R)
    (continuous_map_function_on
      S1
      S1_topology
      (setprod R R)
      R2_topology
      (graph S1 (fun z:set => z))
    HincR2Cont)
    (continuous_map_function_on
      (setprod R R)
      R2_topology
      R
      R_standard_topology
      (projection_map2 R R)
      Hproj2Cont)).
