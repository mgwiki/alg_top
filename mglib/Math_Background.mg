          HtCompU).
      }
      exact (HnotPreU_implies_preV t HtI HtNotPreU).
    }
    claim HcompPreV_sub_preU :
      unit_interval :\: (preimage_of unit_interval fcls V) c= preimage_of unit_interval fcls U.
    {
      let t.
