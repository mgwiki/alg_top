        HpT).
      rewrite Hx0Val.
      rewrite (mul_const_fun_apply
        (apply_fun A (2, 0))
        (p 0)
        HA20R
        Hp0R).
      exact (mul_SNo_com
        (p 0)
        (apply_fun A (2, 0))
        Hp0S
        (real_SNo (apply_fun A (2, 0)) HA20R)).
