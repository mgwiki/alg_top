        apply_fun
          (compose_fun
            (fundamental_group (U :/\: V) (subspace_topology X Tx (U :/\: V)) x0)
            (induced_homomorphism
              (U :/\: V) (subspace_topology X Tx (U :/\: V)) x0
              U (subspace_topology X Tx U) x0
              (graph (U :/\: V) (fun x:set => x)))
            (induced_homomorphism
              U (subspace_topology X Tx U) x0
              X Tx x0
              (graph U (fun x:set => x)))) g
        =
        apply_fun
          (induced_homomorphism
            (U :/\: V) (subspace_topology X Tx (U :/\: V)) x0
            X Tx x0
            (graph (U :/\: V) (fun x:set => x))) g.
