    X
    Tx
    Arcs
    E
    Hglg
    HEArcs).
}
claim HEsubX : E c= X.
{
  exact (andEL
    (E c= X)
    (arc E (subspace_topology X Tx E))
    HEdata).
}
claim HarcE : arc E (subspace_topology X Tx E).
{
  exact (andER
    (E c= X)
    (arc E (subspace_topology X Tx E))
    HEdata).
}
