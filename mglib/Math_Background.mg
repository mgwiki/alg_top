claim HphiInv :
  apply_fun phi (apply_fun inv x) = apply_fun invH (apply_fun phi x).
{
  exact (group_hom_sends_inverse_cyclic_helper
    G
    mult
    e
    inv
    H
    multH
    eH
    invH
    phi
    HgrpG
    HgrpH
    Hhom
    x
