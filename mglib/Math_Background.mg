        apply_fun (pair_map pi_XY phi1 phi2) x = y /\
        (forall x':set, x' :e pi_XY ->
          apply_fun (pair_map pi_XY phi1 phi2) x' = y -> x' = x))).
  apply andI.
  - exact HphiFunOn.
  - let y.
    assume Hy.
    set cls_X := y 0.
