  {
    exact (setminusI
      A
      B
      x
      HxA
      HxNotB).
  }
  claim HxE : x :e Empty.
  {
    exact (mem_eqR
      x
      (A :\: B)
      Empty
      HdiffE
      HxRest).
  }
  exact (FalseE
    (EmptyE
      x
      HxE
      False)
    (x :e B)).
Qed.

(** Infrastructure: setminus empty iff subset **)
