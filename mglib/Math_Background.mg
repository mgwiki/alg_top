  (forall s:set, s :e unit_interval -> apply_fun Ff (s, 1) = apply_fun fp s) /\
  (forall t:set, t :e unit_interval -> apply_fun Ff (0, t) = e) /\
  (forall t:set, t :e unit_interval -> apply_fun Ff (1, t) = e).
