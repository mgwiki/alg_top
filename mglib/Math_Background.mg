          claim HpzU : apply_fun p z :e U.
          {
            exact (SepE2
              E
              (fun t:set => apply_fun p t :e U)
              z
              HzPreU).
          }
          apply HFibNonempty.
          let x0.
          assume Hx0Fib.
          claim Hx0WFam : PickW x0 :e WFam.
          {
            exact (ReplI
              FibB
              (fun x:set => PickW x)
              x0
              Hx0Fib).
          }
          claim HpzPick0 : apply_fun p z :e PickW x0.
