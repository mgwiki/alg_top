Axiom compact_Hausdorff_normal : forall X Tx : set , compact_space X Tx -> Hausdorff_space X Tx -> normal_space X Tx.
Definition Stone_ex32_9_family : set -> set := fun J : set => const_space_family J Zplus (subspace_topology R R_standard_topology Zplus).
Definition Stone_ex32_9_space : set -> set := fun J : set => product_space J (Stone_ex32_9_family J).
