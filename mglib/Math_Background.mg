    t
    HtR
    HtNonneg).
}
claim HsS : SNo s.
{
  exact (real_SNo
    s
    HsR).
}
claim HsNonneg : 0 <= s.
{
  exact (sqrt_SNo_nonneg_nonneg
    t
    HtS
    HtNonneg).
}
claim HsSq : mul_SNo s s = t.
{
  exact (sqrt_SNo_nonneg_sqr
    t
    HtS
    HtNonneg).
}
apply (SNoLtLe_or
  0
  s
  SNo_0
  HsS).
- assume HsPos.
  exact (RltI
    0
    s
    real_0
    HsR
    HsPos).
- assume HsLe0.
