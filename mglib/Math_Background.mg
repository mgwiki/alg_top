				          exact Hcontr_remaining.
			  - assume Hx0NeW.
			    apply HuseA.
			    let i0.
			    assume Hi0pack.
		    claim Hi0 : i0 :e n.
		    { exact (andEL (i0 :e n) ((apply_fun path_seq i0) 1 = A) Hi0pack). }
		    claim Hi0E : (apply_fun path_seq i0) 1 = A.
