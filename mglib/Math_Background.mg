  }
  rewrite HavkEq.
  apply (finite_real_sum_nonneg
    (fun j:set => mul_SNo (apply_fun A (k, j)) (apply_fun v j)) 3 H3nat).
  - let j. assume Hj3.
    claim HakjR : apply_fun A (k, j) :e R.
    {
      exact (HAfun
        (k, j)
        (tuple_2_setprod_by_pair_Sigma 3 3 k j Hk3 Hj3)).
