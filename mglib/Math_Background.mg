(** Infrastructure: setminus plus intersection recovers the set **)
(** Proven Bob **)
Theorem binunion_setminus_binintersect_eq : forall A B:set,
  (A :\: B) :\/: (A :/\: B) = A.
let A B.
apply set_ext.
- let x.
  assume HxUnion.
  apply (binunionE
    (A :\: B)
    (A :/\: B)
    x
    HxUnion).
  + assume HxRest.
    exact (setminusE1
      A
      B
      x
      HxRest).
  + assume HxInt.
    exact (binintersectE1
      A
      B
      x
      HxInt).
- let x.
