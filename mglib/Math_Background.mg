exact (union_empty_family_eq_empty_or_singleton
  Fam
  HUnionE).
Qed.

(** Infrastructure: union empty iff family is subset of {Empty} **)
(** Proven Bob **)
Theorem union_empty_iff_family_sub_singleton_empty : forall Fam:set,
  (Union Fam = Empty <-> Fam c= {Empty}).
