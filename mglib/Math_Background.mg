      n
      xs
      Hred
      HnNe0
      Hwp).
  }
  claim Hnw1 : nw = 1.
  {
    exact (andEL
      (nw = 1)
      (forall i:set, i :e nw ->
        apply_fun xsw i =
        apply_fun (graph 1 (fun _:set => apply_fun gensH0 alpha)) i)
      HuniqSingleton).
  }
  claim HxswSingleton :
