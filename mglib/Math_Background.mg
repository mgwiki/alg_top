apply andI.
- exact Hff1EqHgg1.
- prove continuous_map unit_interval unit_interval_topology E Te ff /\
    continuous_map unit_interval unit_interval_topology E Te gg /\
    apply_fun ff 0 = e0 /\ apply_fun ff 1 = apply_fun ff 1 /\
    apply_fun gg 0 = e0 /\ apply_fun gg 1 = apply_fun ff 1 /\
    exists F:set,
      continuous_map unit_square unit_square_topology E Te F /\
      (forall s:set, s :e unit_interval ->
        apply_fun F (s, 0) = apply_fun ff s) /\
      (forall s:set, s :e unit_interval ->
        apply_fun F (s, 1) = apply_fun gg s) /\
      (forall t:set, t :e unit_interval ->
        apply_fun F (0, t) = e0) /\
      (forall t:set, t :e unit_interval ->
        apply_fun F (1, t) = apply_fun ff 1).
  apply andI.
  + exact (and6I
      (continuous_map unit_interval unit_interval_topology E Te ff)
      (continuous_map unit_interval unit_interval_topology E Te gg)
      (apply_fun ff 0 = e0)
      (apply_fun ff 1 = apply_fun ff 1)
      (apply_fun gg 0 = e0)
      (apply_fun gg 1 = apply_fun ff 1)
      HffCont
      HggCont
      Hff0
      (fun P H => H)
      Hgg0
      Hgg1EqHff1).
  + witness (homotopy_lift E Te B Tb p e0 Fh).
    apply and5I.
    * exact HliftSquareCont.
    * let s.
      assume Hs.
      rewrite <- (HffEqFt0 s Hs).
      reflexivity.
    * let s.
      assume Hs.
      rewrite <- (HggEqFt1 s Hs).
      reflexivity.
    * exact HleftEdgeE0.
    * exact HrightEdgeFF1.
Qed.

(** from S54 Definition (line 791 in algtop.tex) **)
(** LATEX VERSION: The lifting correspondence phi: pi_1(B,b0) -> p^{-1}(b0) maps **)
(** [f] to the endpoint f_tilde(1) of the lift of f starting at e0. **)
Definition lifting_correspondence : set -> set -> set -> set -> set -> set -> set :=
  fun E Te B Tb p e0 =>
    graph (fundamental_group B Tb (apply_fun p e0))
      (fun cls:set =>
        apply_fun (path_lift E Te B Tb p e0 (Eps_i (fun f:set => f :e cls))) 1).

(** Infrastructure: lifting correspondence lands in the fiber over p(e0) **)
(** Proven Bob **)
Lemma lifting_correspondence_in_fiber : forall E Te B Tb p e0 cls:set,
  covering_map E Te B Tb p -> e0 :e E ->
  cls :e fundamental_group B Tb (apply_fun p e0) ->
  apply_fun (lifting_correspondence E Te B Tb p e0) cls :e
    {x :e E | apply_fun p x = apply_fun p e0}.
let E Te B Tb p e0 cls.
assume Hcov He0 Hcls.
set b0 := apply_fun p e0.
set f := Eps_i (fun f:set => f :e cls).
