  rewrite (pair_map_apply
    dom
    R
    R
    x_term
    y_term
    (x, 0)
    Hx0Dom).
  rewrite (mul_of_pair_map_apply
    dom
    one_minus_t
    x_coord
    (x, 0)
    Hx0Dom
    (unit_interval_sub_R
      (apply_fun one_minus_t (x, 0))
      (HoneMinusFunI (x, 0) Hx0Dom))
    (HxCoordFunR (x, 0) Hx0Dom)).
  rewrite (mul_of_pair_map_apply
    dom
    one_minus_t
    y_coord
    (x, 0)
    Hx0Dom
    (unit_interval_sub_R
      (apply_fun one_minus_t (x, 0))
      (HoneMinusFunI (x, 0) Hx0Dom))
    (HyCoordFunR (x, 0) Hx0Dom)).
  rewrite (compose_fun_apply
    dom
    tproj
    flip_unit_interval
    (x, 0)
    Hx0Dom).
  rewrite (projection2_apply
    B2
    unit_interval
    (x, 0)
    Hx0Dom).
  rewrite tuple_2_1_eq.
  rewrite flip_unit_interval_at_0.
  rewrite (compose_fun_apply
    dom
    xproj
    (projection1 R R)
    (x, 0)
    Hx0Dom).
  rewrite (compose_fun_apply
    dom
    xproj
    (projection2 R R)
    (x, 0)
    Hx0Dom).
  rewrite (projection1_apply
    B2
    unit_interval
    (x, 0)
    Hx0Dom).
  rewrite tuple_2_0_eq.
  rewrite (projection1_apply
    R
    R
    x
    HxR2).
  rewrite (projection2_apply
    R
    R
    x
    HxR2).
  rewrite (mul_SNo_oneL
    (x 0)
    Hx0S).
  rewrite (mul_SNo_oneL
    (x 1)
    Hx1S).
  rewrite (apply_fun_graph
    B2
    (fun z:set => z)
    x
    Hx).
  exact (EuclidPlane_eta
    x
    HxR2).
}
