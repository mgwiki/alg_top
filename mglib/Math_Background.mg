          apply (UnionE slices z HzUnionSlices).
          let V.
          assume HVPack.
          claim HzV : z :e V.
          {
            exact (andEL
              (z :e V)
              (V :e slices)
              HVPack).
          }
          claim HVslice : V :e slices.
          {
            exact (andER
              (z :e V)
              (V :e slices)
              HVPack).
          }
          claim HexxV :
            exists xV:set, xV :e V /\ apply_fun p xV = b /\
