		                    claim Hpow_pres :
		                      apply_fun hifam
		                        (group_power_nat integers_group_mult 0 (apply_fun integers_group_inv 1) (ordsucc k)) =
		                      group_power_nat multG eG (apply_fun invG (apply_fun hifam 1)) (ordsucc k).
