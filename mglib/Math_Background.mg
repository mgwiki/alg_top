      R
      (fun _ : set => R)
      p
      HpX).
  }
  rewrite (apply_fun_graph
    X
    (fun q:set => Rmax (q 0) (q 1))
    p
    HpX).
  rewrite (Rmax_unfold
    (p 0)
    (p 1)).
