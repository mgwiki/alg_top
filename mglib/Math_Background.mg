        (s, 1)
        Hs1).
      rewrite (projection2_apply
        unit_interval
        unit_interval
        (s, 1)
        Hs1).
      rewrite tuple_2_1_eq.
      rewrite Hp1.
      rewrite (const_fun_apply
        unit_interval
        (apply_fun g 0)
        s
        Hs).
      reflexivity.
}
