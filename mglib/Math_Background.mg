            (fun k r => apply_fun (fundamental_group_mult X Tx z0) (r, apply_fun gs k)) n.
      claim HnO : n :e omega.
      {
        exact (andEL
          (n :e omega)
          (exists gs:set, function_on gs n (fundamental_group X Tx z0) /\
