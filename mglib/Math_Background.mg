{
  let t.
  assume HtR.
  rewrite (compose_fun_apply
    R
    pairR
    (graph (setprod R R) (fun p:set => Rmax (p 0) (p 1)))
    t
    HtR).
  rewrite (pair_map_apply
    R
    R
    R
    idR
    (const_fun R c)
    t
    HtR).
  rewrite (apply_fun_graph
    R
    (fun x:set => x)
    t
    HtR).
  rewrite (const_fun_apply
    R
    c
    t
    HtR).
  rewrite (apply_fun_graph
    (setprod R R)
