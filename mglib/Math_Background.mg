        (mul_SNo (x 1) (x 1)))),
   div_SNo (x 1)
    (sqrt_SNo_nonneg
      (add_SNo (mul_SNo (x 0) (x 0))
        (mul_SNo (x 1) (x 1)))))).
- exact (tuple_2_setprod_by_pair_Sigma
    R
    R
    (div_SNo (x 0) d)
    (div_SNo (x 1) d)
