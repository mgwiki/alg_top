claim HsepE :
  forall C D:set,
  closed_in E (subspace_topology X Tx E) C ->
  closed_in E (subspace_topology X Tx E) D ->
  C :/\: D = Empty ->
  exists U V:set,
    U :e (subspace_topology X Tx E) /\
    V :e (subspace_topology X Tx E) /\
    C c= U /\
    D c= V /\
    U :/\: V = Empty.
{
  exact (andER
    (one_point_sets_closed E (subspace_topology X Tx E))
    (forall C D : set,
      closed_in E (subspace_topology X Tx E) C ->
      closed_in E (subspace_topology X Tx E) D ->
      C :/\: D = Empty ->
      exists U V : set,
        U :e (subspace_topology X Tx E) /\
        V :e (subspace_topology X Tx E) /\
        C c= U /\
        D c= V /\
