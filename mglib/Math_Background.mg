  rewrite (apply_fun_graph
    (ordsucc n)
    (fun i0:set =>
      graph dom (fun y:set =>
        mul_SNo (apply_fun lam y) (apply_fun y i0)))
    i
    Hi).
  exact (continuous_map_congr_on
    dom
    Tdom
    R
    R_standard_topology
    prodcoord
    (graph dom (fun y:set =>
      mul_SNo (apply_fun lam y) (apply_fun y i)))
    HprodCont
    HcoordGraphFun
    HprodEqOn).
}
