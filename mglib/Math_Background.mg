}
claim HhB :
  forall p:set, p :e B -> apply_fun h p = apply_fun fB p.
{
  exact (andER
    (forall p:set, p :e A -> apply_fun h p = apply_fun fA p)
    (forall p:set, p :e B -> apply_fun h p = apply_fun fB p)
