  apply (finite_real_sum_congr
    (fun i:set =>
      mul_SNo
        (apply_fun (graph n (fun j:set => apply_fun v j)) i)
        (apply_fun (graph n (fun j:set => apply_fun v j)) i))
    (fun i:set => mul_SNo (apply_fun v i) (apply_fun v i))
    n
    Hn).
  let i.
