  let y.
  assume Hy.
  reflexivity.
}
claim HdiagEq : forall y:set, y :e dom ->
  apply_fun (diagonal_map dom Fcoord (ordsucc n)) y =
  apply_fun (Rn_normalize_raw_map n) y.
{
  let y.
  assume Hy.
  claim HdiagyPR :
    apply_fun (diagonal_map dom Fcoord (ordsucc n)) y :e power_real (ordsucc n).
  {
    exact (HdiagFun
      y
      Hy).
  }
  claim HrawyPR :
