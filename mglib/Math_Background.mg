      X
      (fun q:set => Rmax (q 0) (q 1))
      p
      HpX).
    rewrite (Rmax_unfold
      (p 0)
      (p 1)).
    rewrite (If_i_1
      (Rlt (p 0) (p 1))
      (p 1)
      (p 0)
