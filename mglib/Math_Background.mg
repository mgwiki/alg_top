(** Proven Bob **)
Theorem cyclic_infinite_order_iff_Z : forall G mult e inv:set,
  group_structure G mult e inv ->
  cyclic_group G mult e inv ->
  ~ finite G ->
  exists phi:set, group_isomorphism G mult int integers_group_mult phi.
let G mult e inv.
assume Hgrp Hcyc Hnfin.
claim HgenXEx : exists x:set, generator_of G mult e inv x.
{
  exact (cyclic_group_has_generator_helper
    G
    mult
    e
    inv
    Hcyc).
}
apply HgenXEx.
let x.
assume HgenX.
claim HxG : x :e G.
{
  exact (andEL
    (x :e G)
    (forall g:set, g :e G ->
      exists n:set, n :e int /\
        ((n :e omega /\ g = group_power_nat mult e x n) \/
         (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
          g = group_power_nat mult e (apply_fun inv x) (ordsucc m))))
    HgenX).
}
claim HgenRep :
  forall g:set, g :e G ->
    exists n:set, n :e int /\
      ((n :e omega /\ g = group_power_nat mult e x n) \/
       (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
        g = group_power_nat mult e (apply_fun inv x) (ordsucc m))).
{
  exact (andER
    (x :e G)
    (forall g:set, g :e G ->
      exists n:set, n :e int /\
        ((n :e omega /\ g = group_power_nat mult e x n) \/
         (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
          g = group_power_nat mult e (apply_fun inv x) (ordsucc m))))
    HgenX).
}
claim HxNeE : x <> e.
{
  assume Hxe.
  claim HfinG : finite G.
  {
    exact (generator_identity_implies_finite_cyclic_helper
      G
      mult
      e
      inv
      x
      Hgrp
      HgenX
      Hxe).
  }
  exact (Hnfin HfinG).
}
claim HgrpZ : group_structure int integers_group_mult 0 integers_group_inv.
{
  exact integers_group_is_group_cyclic_helper.
}
set phi_sel := graph G (fun g:set =>
  Eps_i (fun n:set =>
    n :e int /\
      ((n :e omega /\ g = group_power_nat mult e x n) \/
       (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
         g = group_power_nat mult e (apply_fun inv x) (ordsucc m))))).
