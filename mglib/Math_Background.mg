    (A :e Arcs)
    (x :e A)
    HAwit).
}
witness A.
apply andI.
- apply andI.
  + exact HAArcs.
  + assume HAsubT.
    exact (HxNotT
      (HAsubT x HxA)).
- exact HxA.
Qed.

