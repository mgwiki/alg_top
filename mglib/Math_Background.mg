Theorem ex75_1_P2_sharp_T_is_P3 :
  forall D1 D2 h:set,
  (** D1 is a closed disc in P_1 homeomorphic to B2 **)
  D1 c= m_fold_projective_plane_space (ordsucc 0) ->
