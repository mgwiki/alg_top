    set Ufam := {U :e Tb | exists G:set, G c= Fam /\ finite G /\ preimage_of E p U c= Union G}.
    witness Ufam.
    apply andI.
    - apply andI.
      + let U.
        assume HUUfam.
        exact (SepE1
          Tb
          (fun U0:set => exists G:set, G c= Fam /\ finite G /\ preimage_of E p U0 c= Union G)
          U
          HUUfam).
      + let b.
