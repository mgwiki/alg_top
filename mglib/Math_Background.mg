    claim Hp1Eq0 : p 1 = 0.
    {
      claim Hp1Cases : p 1 = 0 \/ 0 < mul_SNo (p 1) (p 1).
      {
        exact (SNo_zero_or_sqr_pos
          (p 1)
          Hp1S).
      }
      apply Hp1Cases.
      - assume H.
        exact H.
      - assume Hp1sqPos.
        claim H00lt : 0 < 0.
        {
          exact (SNoLtLe_tra
            0
            (mul_SNo (p 1) (p 1))
            0
            SNo_0
            (SNo_mul_SNo
              (p 1)
              (p 1)
              Hp1S
              Hp1S)
            SNo_0
            Hp1sqPos
            Hp1sqLe0).
        }
        exact (FalseE
          (not_Rlt_refl
            0
            real_0
            (RltI
              0
              0
              real_0
              real_0
              H00lt))
          (p 1 = 0)).
    }
    exact (HpNot00
      (andI
        (p 0 = 0)
        (p 1 = 0)
        Hp0Eq0
        Hp1Eq0)).
  }
  set dnorm := sqrt_SNo_nonneg s.
