          (continuous_map unit_interval unit_interval_topology
            (apply_fun seq (ordsucc k))
            (subspace_topology R R_standard_topology (apply_fun seq (ordsucc k))) seg)
          (apply_fun seg 0 = apply_fun t_seq k)
          (andEL
            (continuous_map unit_interval unit_interval_topology
              (apply_fun seq (ordsucc k))
