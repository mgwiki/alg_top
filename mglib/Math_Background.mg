      HuniqGiven).
  }
  claim HxswEqXs :
    forall i:set, i :e nw -> apply_fun xsw i = apply_fun xs i.
  {
    exact (andER
      (nw = n)
      (forall i:set, i :e nw -> apply_fun xsw i = apply_fun xs i)
      HuniqGiven).
  }
  claim HnEqNw : n = nw.
  {
    symmetry.
    exact HnwEqN.
  }
  claim Hn1 : n = 1.
  {
    exact (eq_i_tra
      n
      nw
      1
      HnEqNw
      Hnw1).
  }
  apply andI.
  - exact Hn1.
  - let i.
    assume Hi1.
    claim HiNw : i :e nw.
    {
      rewrite Hnw1.
      exact Hi1.
    }
    claim HxswIxs : apply_fun xsw i = apply_fun xs i.
    {
      exact (HxswEqXs i HiNw).
    }
    claim HxswIsingle :
