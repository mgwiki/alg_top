(** Proven Bob **)
Theorem ex58_6_retract_of_contractible : forall X Tx A:set,
  topology_on X Tx ->
  contractible_space X Tx ->
  retraction_of X Tx A ->
  contractible_space A (subspace_topology X Tx A).
