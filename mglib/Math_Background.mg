let X Tx Arcs.
assume Hglg.
apply (and5E
  (topology_on X Tx)
  (forall A:set, A :e Arcs -> A c= X /\ arc A (subspace_topology X Tx A))
  (X = Union Arcs)
  (forall A B:set, A :e Arcs -> B :e Arcs -> A <> B ->
    A :/\: B = Empty \/
    (exists p:set, A :/\: B = Sing p /\
      (exists q:set, end_points_of_arc A (subspace_topology X Tx A) p q \/
