claim HsomePos :
  Rlt 0 (apply_fun v 0) \/
  (Rlt 0 (apply_fun v 1) \/ Rlt 0 (apply_fun v 2)).
{
  apply (xm (apply_fun v 0 = 0)).
  - assume Hv0eq0.
    apply (xm (apply_fun v 1 = 0)).
    + assume Hv1eq0.
      claim Hv2ne0 : ~(apply_fun v 2 = 0).
