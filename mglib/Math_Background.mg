assume Hf.
exact (andEL
  (total_function_on f X Y)
  (functional_graph f)
  (SepE2
    (Power (setprod X Y))
    (fun g:set => total_function_on g X Y /\ functional_graph g)
    f
    Hf)).
Qed.

