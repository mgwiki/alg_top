(** Infrastructure: binunion is idempotent **)
(** Proven Bob **)
Theorem binunion_idem : forall A:set,
  A :\/: A = A.
let A.
apply set_ext.
- let x.
  assume HxUnion.
  apply (binunionE
    A
    A
    x
    HxUnion).
  + assume HxA.
    exact HxA.
  + assume HxA.
    exact HxA.
- let x.
  assume HxA.
  exact (binunionI1
    A
    A
    x
    HxA).
Qed.

(** Infrastructure: binunion absorbs binintersect (left) **)
(** Proven Bob **)
Theorem binunion_absorb_left : forall A B:set,
  A :\/: (A :/\: B) = A.
let A B.
