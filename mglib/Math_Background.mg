    exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
      x = group_power_nat mult e (apply_fun inv gen) (ordsucc m).
  apply Hneg.
  let m.
  assume HmPack :
    m :e omega /\ n = minus_SNo (ordsucc m) /\
      x = group_power_nat mult e (apply_fun inv gen) (ordsucc m).
  claim HmO : m :e omega.
  {
    exact (andEL
      (m :e omega)
      (n = minus_SNo (ordsucc m))
      (andEL
        (m :e omega /\ n = minus_SNo (ordsucc m))
        (x = group_power_nat mult e (apply_fun inv gen) (ordsucc m))
        HmPack)).
  }
  claim HxEq : x = group_power_nat mult e (apply_fun inv gen) (ordsucc m).
  {
    exact (andER
      (m :e omega /\ n = minus_SNo (ordsucc m))
      (x = group_power_nat mult e (apply_fun inv gen) (ordsucc m))
      HmPack).
  }
  claim HsmO : ordsucc m :e omega.
  {
    exact (omega_ordsucc m HmO).
  }
  rewrite HxEq.
  claim Hstep1 :
    apply_fun h (group_power_nat mult e (apply_fun inv gen) (ordsucc m)) =
    group_power_nat integers_group_mult 0 (apply_fun integers_group_inv (apply_fun h gen)) (ordsucc m).
  {
    exact (group_homomorphism_preserves_inverse_power_nat_cyclic_helper
      G mult e inv int integers_group_mult 0 integers_group_inv
      h gen (ordsucc m) Hgrp HgrpZ Hhom HgenG HsmO).
  }
  rewrite Hstep1.
  rewrite HhGen0.
  claim HintInvZero : apply_fun integers_group_inv 0 = 0.
  {
    claim HinvDef :
      integers_group_inv = graph int (fun n0:set => minus_SNo n0).
    {
      reflexivity.
    }
    claim H0Int : 0 :e int.
    {
      exact (Subq_omega_int 0 (nat_p_omega 0 nat_0)).
    }
    rewrite HinvDef.
    rewrite (apply_fun_graph int (fun n0:set => minus_SNo n0) 0 H0Int).
    exact minus_SNo_0.
  }
  rewrite HintInvZero.
  exact (group_power_nat_identity_cyclic_helper
    int integers_group_mult 0 integers_group_inv (ordsucc m) HgrpZ HsmO).
Qed.

(** Helper: if h: G -> Z is a group hom with h(gen) = 1,
    then h(x) <> 0 for any x <> e in the cyclic subgroup of gen. **)
(** Proven Alice **)
Theorem hom_to_Z_nonzero_on_nontrivial_cyclic_element :
  forall G mult e inv h x gen:set,
  group_structure G mult e inv ->
  group_structure int integers_group_mult 0 integers_group_inv ->
  group_homomorphism G mult int integers_group_mult h ->
  gen :e G ->
  apply_fun h gen = 1 ->
  x :e G ->
  x <> e ->
  (exists n:set, n :e int /\
    ((n :e omega /\ x = group_power_nat mult e gen n) \/
     (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
      x = group_power_nat mult e (apply_fun inv gen) (ordsucc m)))) ->
  apply_fun h x <> 0.
let G mult e inv h x gen.
assume Hgrp : group_structure G mult e inv.
assume HgrpZ : group_structure int integers_group_mult 0 integers_group_inv.
assume Hhom : group_homomorphism G mult int integers_group_mult h.
assume HgenG : gen :e G.
assume HhGen1 : apply_fun h gen = 1.
assume HxG : x :e G.
assume Hxne : x <> e.
assume HxCyc :
  exists n:set, n :e int /\
    ((n :e omega /\ x = group_power_nat mult e gen n) \/
     (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
      x = group_power_nat mult e (apply_fun inv gen) (ordsucc m))).
assume Habs : apply_fun h x = 0.
apply HxCyc.
let n.
assume HnPack :
  n :e int /\
    ((n :e omega /\ x = group_power_nat mult e gen n) \/
     (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
      x = group_power_nat mult e (apply_fun inv gen) (ordsucc m))).
claim Hcases :
  (n :e omega /\ x = group_power_nat mult e gen n) \/
  (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
    x = group_power_nat mult e (apply_fun inv gen) (ordsucc m)).
{
  exact (andER
    (n :e int)
    ((n :e omega /\ x = group_power_nat mult e gen n) \/
     (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
      x = group_power_nat mult e (apply_fun inv gen) (ordsucc m)))
    HnPack).
}
apply Hcases.
- assume Hpos : n :e omega /\ x = group_power_nat mult e gen n.
  claim HnO : n :e omega.
  {
    exact (andEL (n :e omega) (x = group_power_nat mult e gen n) Hpos).
  }
  claim HxEq : x = group_power_nat mult e gen n.
  {
    exact (andER (n :e omega) (x = group_power_nat mult e gen n) Hpos).
  }
  claim Hhx :
    apply_fun h x =
    group_power_nat integers_group_mult 0 (apply_fun h gen) n.
  {
    rewrite HxEq.
    exact (group_homomorphism_preserves_power_nat_cyclic_helper
      G mult e inv int integers_group_mult 0 integers_group_inv
      h gen n Hgrp HgrpZ Hhom HgenG HnO).
  }
  claim Hhxn : apply_fun h x = n.
  {
    rewrite Hhx.
    rewrite HhGen1.
    exact (integers_group_power_nat_one_eq_nat n HnO).
  }
  claim HnEq0 : n = 0.
  {
    rewrite <- Hhxn.
    exact Habs.
  }
  claim HxEqE : x = e.
  {
    rewrite HxEq.
    rewrite HnEq0.
    exact (nat_primrec_0 e (fun _ r => apply_fun mult (gen, r))).
  }
  exact (Hxne HxEqE).
- assume Hneg :
    exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
      x = group_power_nat mult e (apply_fun inv gen) (ordsucc m).
  apply Hneg.
  let m.
  assume HmPack :
    m :e omega /\ n = minus_SNo (ordsucc m) /\
      x = group_power_nat mult e (apply_fun inv gen) (ordsucc m).
  claim HmO : m :e omega.
  {
    exact (andEL
      (m :e omega)
      (n = minus_SNo (ordsucc m))
      (andEL
        (m :e omega /\ n = minus_SNo (ordsucc m))
        (x = group_power_nat mult e (apply_fun inv gen) (ordsucc m))
        HmPack)).
  }
  claim HxEq : x = group_power_nat mult e (apply_fun inv gen) (ordsucc m).
  {
    exact (andER
      (m :e omega /\ n = minus_SNo (ordsucc m))
      (x = group_power_nat mult e (apply_fun inv gen) (ordsucc m))
      HmPack).
  }
  claim HsmO : ordsucc m :e omega.
  {
    exact (omega_ordsucc m HmO).
  }
  claim Hhx :
    apply_fun h x =
    group_power_nat integers_group_mult 0
      (apply_fun integers_group_inv (apply_fun h gen))
      (ordsucc m).
  {
    rewrite HxEq.
    exact (group_homomorphism_preserves_inverse_power_nat_cyclic_helper
      G mult e inv int integers_group_mult 0 integers_group_inv
      h gen (ordsucc m) Hgrp HgrpZ Hhom HgenG HsmO).
  }
  claim HintInv1 : apply_fun integers_group_inv 1 = minus_SNo 1.
  {
    claim HinvDef :
      integers_group_inv = graph int (fun n0:set => minus_SNo n0).
    {
      reflexivity.
    }
    claim H1Int : 1 :e int.
    {
      exact (Subq_omega_int 1 (nat_p_omega 1 nat_1)).
    }
    rewrite HinvDef.
    rewrite (apply_fun_graph int (fun n0:set => minus_SNo n0) 1 H1Int).
    reflexivity.
  }
  claim Hhx2 :
    apply_fun h x =
    group_power_nat integers_group_mult 0 (minus_SNo 1) (ordsucc m).
  {
    rewrite Hhx.
    rewrite HhGen1.
    rewrite HintInv1.
    reflexivity.
  }
  claim Hhx3 :
    apply_fun h x = mul_SNo (minus_SNo 1) (ordsucc m).
  {
    rewrite Hhx2.
    claim Hm1Int : minus_SNo 1 :e int.
    {
      exact (int_minus_SNo 1 (Subq_omega_int 1 (nat_p_omega 1 nat_1))).
    }
    exact (integers_group_power_nat_mul_right_cyclic_helper
      (minus_SNo 1) (ordsucc m) Hm1Int HsmO).
  }
  claim HmulEq0 : mul_SNo (minus_SNo 1) (ordsucc m) = 0.
  {
    rewrite <- Hhx3.
    exact Habs.
  }
  claim Hm1SNo : SNo (minus_SNo 1).
  {
    exact (SNo_minus_SNo 1 SNo_1).
  }
  claim Hm1ne0 : minus_SNo 1 <> 0.
  {
    assume Habsurd : minus_SNo 1 = 0.
    claim Hmm1 : minus_SNo (minus_SNo 1) = minus_SNo 0.
    {
      rewrite Habsurd.
      reflexivity.
    }
    claim H1eq0 : 1 = 0.
    {
      rewrite <- (minus_SNo_invol 1 SNo_1).
      rewrite Hmm1.
      exact minus_SNo_0.
    }
    exact (neq_1_0 H1eq0).
  }
  claim HsmSNo : SNo (ordsucc m).
  {
    exact (omega_SNo (ordsucc m) HsmO).
  }
  claim Hm1mul0 : mul_SNo (minus_SNo 1) 0 = 0.
  {
    exact (mul_SNo_zeroR (minus_SNo 1) Hm1SNo).
  }
  claim HmulSame : mul_SNo (minus_SNo 1) (ordsucc m) = mul_SNo (minus_SNo 1) 0.
  {
    rewrite Hm1mul0.
    exact HmulEq0.
  }
  claim HsmEq0 : ordsucc m = 0.
  {
    exact (mul_SNo_nonzero_cancel
      (minus_SNo 1) (ordsucc m) 0 Hm1SNo Hm1ne0 HsmSNo SNo_0 HmulSame).
  }
  exact (neq_ordsucc_0 m HsmEq0).
Qed.

(** Helper: extension property forces disjointness of cyclic generator subgroups. **)
(** Proven Alice **)
Theorem extension_property_forces_disjointness :
  forall G mult e inv J gens alpha beta x:set,
  group_structure G mult e inv ->
  function_on gens J G ->
  (forall H multH eH invH:set,
    group_structure H multH eH invH ->
    forall ys:set, function_on ys J H ->
      exists h:set,
        group_homomorphism G mult H multH h /\
        (forall gamma:set, gamma :e J ->
          apply_fun h (apply_fun gens gamma) = apply_fun ys gamma) /\
        (forall h':set, group_homomorphism G mult H multH h' ->
          (forall gamma:set, gamma :e J ->
            apply_fun h' (apply_fun gens gamma) = apply_fun ys gamma) ->
          forall y:set, y :e G -> apply_fun h' y = apply_fun h y)) ->
  alpha :e J -> beta :e J -> alpha <> beta ->
  x :e apply_fun
    (graph J (fun a:set =>
      {g :e G | exists n:set, n :e int /\
        ((n :e omega /\ g = group_power_nat mult e (apply_fun gens a) n) \/
         (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
          g = group_power_nat mult e (apply_fun inv (apply_fun gens a)) (ordsucc m)))}))
    alpha ->
  x :e apply_fun
    (graph J (fun a:set =>
      {g :e G | exists n:set, n :e int /\
        ((n :e omega /\ g = group_power_nat mult e (apply_fun gens a) n) \/
         (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
          g = group_power_nat mult e (apply_fun inv (apply_fun gens a)) (ordsucc m)))}))
    beta ->
  x = e.
let G mult e inv J gens alpha beta x.
assume Hgrp : group_structure G mult e inv.
assume Hgens : function_on gens J G.
assume Hext :
  forall H multH eH invH:set,
    group_structure H multH eH invH ->
    forall ys:set, function_on ys J H ->
      exists h:set,
        group_homomorphism G mult H multH h /\
        (forall gamma:set, gamma :e J ->
          apply_fun h (apply_fun gens gamma) = apply_fun ys gamma) /\
        (forall h':set, group_homomorphism G mult H multH h' ->
          (forall gamma:set, gamma :e J ->
            apply_fun h' (apply_fun gens gamma) = apply_fun ys gamma) ->
          forall y:set, y :e G -> apply_fun h' y = apply_fun h y).
assume Halpha : alpha :e J.
assume Hbeta : beta :e J.
assume Hne : alpha <> beta.
assume HxGa :
  x :e apply_fun
    (graph J (fun a:set =>
      {g :e G | exists n:set, n :e int /\
        ((n :e omega /\ g = group_power_nat mult e (apply_fun gens a) n) \/
         (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
          g = group_power_nat mult e (apply_fun inv (apply_fun gens a)) (ordsucc m)))}))
    alpha.
assume HxGb :
  x :e apply_fun
    (graph J (fun a:set =>
      {g :e G | exists n:set, n :e int /\
        ((n :e omega /\ g = group_power_nat mult e (apply_fun gens a) n) \/
         (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
          g = group_power_nat mult e (apply_fun inv (apply_fun gens a)) (ordsucc m)))}))
    beta.
apply (xm (x = e)).
- assume Hxe : x = e.
  exact Hxe.
- assume Hxne : x <> e.
  set Gfam_body := fun a:set =>
    {g :e G | exists n:set, n :e int /\
      ((n :e omega /\ g = group_power_nat mult e (apply_fun gens a) n) \/
       (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
        g = group_power_nat mult e (apply_fun inv (apply_fun gens a)) (ordsucc m)))}.
  claim HGfamAlphaEq :
    apply_fun (graph J Gfam_body) alpha = Gfam_body alpha.
  {
    exact (apply_fun_graph J Gfam_body alpha Halpha).
  }
  claim HxGaUnfold :
    x :e Gfam_body alpha.
  {
    exact (eq_subst_mem_set x
      (apply_fun (graph J Gfam_body) alpha)
      (Gfam_body alpha) HxGa HGfamAlphaEq).
  }
  claim HGfamBetaEq :
    apply_fun (graph J Gfam_body) beta = Gfam_body beta.
  {
    exact (apply_fun_graph J Gfam_body beta Hbeta).
  }
  claim HxGbUnfold :
    x :e Gfam_body beta.
  {
    exact (eq_subst_mem_set x
      (apply_fun (graph J Gfam_body) beta)
      (Gfam_body beta) HxGb HGfamBetaEq).
  }
  claim HxG : x :e G.
  {
    exact (SepE1 G
      (fun g => exists n:set, n :e int /\
        ((n :e omega /\ g = group_power_nat mult e (apply_fun gens alpha) n) \/
         (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
          g = group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m))))
      x HxGaUnfold).
  }
  claim HxCycAlpha :
    exists n:set, n :e int /\
      ((n :e omega /\ x = group_power_nat mult e (apply_fun gens alpha) n) \/
       (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
        x = group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m))).
  {
    exact (SepE2 G
      (fun g => exists n:set, n :e int /\
        ((n :e omega /\ g = group_power_nat mult e (apply_fun gens alpha) n) \/
         (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
          g = group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m))))
      x HxGaUnfold).
  }
  claim HxCycBeta :
    exists n:set, n :e int /\
      ((n :e omega /\ x = group_power_nat mult e (apply_fun gens beta) n) \/
       (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
        x = group_power_nat mult e (apply_fun inv (apply_fun gens beta)) (ordsucc m))).
  {
    exact (SepE2 G
      (fun g => exists n:set, n :e int /\
        ((n :e omega /\ g = group_power_nat mult e (apply_fun gens beta) n) \/
         (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
          g = group_power_nat mult e (apply_fun inv (apply_fun gens beta)) (ordsucc m))))
      x HxGbUnfold).
  }
  claim HgrpZ : group_structure int integers_group_mult 0 integers_group_inv.
  {
    exact integers_group_is_group.
  }
  claim H0Int : 0 :e int.
  {
    exact (Subq_omega_int 0 (nat_p_omega 0 nat_0)).
  }
  claim H1Int : 1 :e int.
  {
    exact (Subq_omega_int 1 (nat_p_omega 1 nat_1)).
  }
  set ys0 := graph J (fun gamma:set => If_i (gamma = alpha) 1 0).
  claim Hys0Fn : function_on ys0 J int.
  {
    claim Hys0Def : ys0 = graph J (fun gamma:set => If_i (gamma = alpha) 1 0).
    {
      reflexivity.
    }
    rewrite Hys0Def.
    claim Hys0Total : total_function_on (graph J (fun gamma:set => If_i (gamma = alpha) 1 0)) J int.
    {
      apply (total_function_on_graph J int (fun gamma:set => If_i (gamma = alpha) 1 0)).
      let gamma.
      assume HgammaJ : gamma :e J.
      apply (xm (gamma = alpha)).
      + assume Hgeq : gamma = alpha.
        claim HfAt :
          (fun g:set => If_i (g = alpha) 1 0) gamma = If_i (gamma = alpha) 1 0.
        {
          reflexivity.
        }
        rewrite HfAt.
        rewrite (If_i_1 (gamma = alpha) 1 0 Hgeq).
        exact H1Int.
      + assume Hgneq : ~(gamma = alpha).
        claim HfAt :
          (fun g:set => If_i (g = alpha) 1 0) gamma = If_i (gamma = alpha) 1 0.
        {
          reflexivity.
        }
        rewrite HfAt.
        rewrite (If_i_0 (gamma = alpha) 1 0 Hgneq).
        exact H0Int.
    }
    exact (total_function_on_function_on
      (graph J (fun gamma:set => If_i (gamma = alpha) 1 0)) J int Hys0Total).
  }
  claim Hexth :
    exists h:set,
      group_homomorphism G mult int integers_group_mult h /\
      (forall gamma:set, gamma :e J ->
        apply_fun h (apply_fun gens gamma) = apply_fun ys0 gamma) /\
      (forall h':set, group_homomorphism G mult int integers_group_mult h' ->
        (forall gamma:set, gamma :e J ->
          apply_fun h' (apply_fun gens gamma) = apply_fun ys0 gamma) ->
        forall y:set, y :e G -> apply_fun h' y = apply_fun h y).
  {
    exact (Hext int integers_group_mult 0 integers_group_inv HgrpZ ys0 Hys0Fn).
  }
  apply Hexth.
  let h.
  assume HhPack :
    group_homomorphism G mult int integers_group_mult h /\
    (forall gamma:set, gamma :e J ->
      apply_fun h (apply_fun gens gamma) = apply_fun ys0 gamma) /\
    (forall h':set, group_homomorphism G mult int integers_group_mult h' ->
      (forall gamma:set, gamma :e J ->
        apply_fun h' (apply_fun gens gamma) = apply_fun ys0 gamma) ->
      forall y:set, y :e G -> apply_fun h' y = apply_fun h y).
  apply (and3E
    (group_homomorphism G mult int integers_group_mult h)
    (forall gamma:set, gamma :e J ->
      apply_fun h (apply_fun gens gamma) = apply_fun ys0 gamma)
    (forall h':set, group_homomorphism G mult int integers_group_mult h' ->
      (forall gamma:set, gamma :e J ->
        apply_fun h' (apply_fun gens gamma) = apply_fun ys0 gamma) ->
      forall y:set, y :e G -> apply_fun h' y = apply_fun h y)
    HhPack).
  assume HhHom HhOnGens HhUniq.
  claim HhGenAlpha : apply_fun h (apply_fun gens alpha) = 1.
  {
    claim Hys0Alpha : apply_fun ys0 alpha = 1.
    {
      rewrite (apply_fun_graph J (fun gamma:set => If_i (gamma = alpha) 1 0) alpha Halpha).
      claim Haeq : alpha = alpha.
      {
        reflexivity.
      }
      rewrite (If_i_1 (alpha = alpha) 1 0 Haeq).
      reflexivity.
    }
    rewrite <- Hys0Alpha.
    exact (HhOnGens alpha Halpha).
  }
  claim HhGenBeta : apply_fun h (apply_fun gens beta) = 0.
  {
    claim Hys0Beta : apply_fun ys0 beta = 0.
    {
      rewrite (apply_fun_graph J (fun gamma:set => If_i (gamma = alpha) 1 0) beta Hbeta).
      claim Hbneq : ~(beta = alpha).
      {
        assume Hbeq : beta = alpha.
        claim Haneqb : alpha <> beta.
        {
          exact Hne.
        }
        exact (Haneqb (eq_symm beta alpha Hbeq)).
      }
      rewrite (If_i_0 (beta = alpha) 1 0 Hbneq).
      reflexivity.
    }
    rewrite <- Hys0Beta.
    exact (HhOnGens beta Hbeta).
  }
  claim HgenAlphaG : apply_fun gens alpha :e G.
  {
    exact (Hgens alpha Halpha).
  }
  claim HgenBetaG : apply_fun gens beta :e G.
  {
    exact (Hgens beta Hbeta).
  }
  claim Hhx0 : apply_fun h x = 0.
  {
    exact (hom_to_Z_zero_on_cyclic_subgroup
      G mult e inv h x (apply_fun gens beta)
      Hgrp HgrpZ HhHom HgenBetaG HhGenBeta HxG HxCycBeta).
  }
  claim Hhxne0 : apply_fun h x <> 0.
  {
    exact (hom_to_Z_nonzero_on_nontrivial_cyclic_element
      G mult e inv h x (apply_fun gens alpha)
      Hgrp HgrpZ HhHom HgenAlphaG HhGenAlpha HxG Hxne HxCycAlpha).
  }
  exact (FalseE (Hhxne0 Hhx0) (x = e)).
Qed.
(** Infrastructure helper for S69 backward direction:
    extension property forces each generator to have no nontrivial positive power equal to e. **)


(** Helper: the cyclic subgroup generated by an element a is a subgroup **)
(** Proven Alice **)
(** Proven Bob **)
Theorem cyclic_generator_subgroup_is_subgroup :
  forall G mult e inv a:set,
  group_structure G mult e inv ->
  a :e G ->
  subgroup_of
    {g :e G | exists n:set, n :e int /\
      ((n :e omega /\ g = group_power_nat mult e a n) \/
       (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
        g = group_power_nat mult e (apply_fun inv a) (ordsucc m)))}
    G mult e inv.
let G mult e inv a.
assume Hgrp : group_structure G mult e inv.
assume HaG : a :e G.
apply (and6E
  (function_on mult (setprod G G) G)
  (function_on inv G G)
  (e :e G)
  (forall x y z:set, x :e G -> y :e G -> z :e G ->
    apply_fun mult (apply_fun mult (x, y), z) = apply_fun mult (x, apply_fun mult (y, z)))
  (forall x:set, x :e G -> apply_fun mult (e, x) = x /\ apply_fun mult (x, e) = x)
  (forall x:set, x :e G ->
    apply_fun mult (x, apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x, x) = e)
  Hgrp).
assume HmultFn HinvFn HeG Hassoc Hid HinvLaw.
set Csub := {g :e G | exists n:set, n :e int /\
  ((n :e omega /\ g = group_power_nat mult e a n) \/
   (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
    g = group_power_nat mult e (apply_fun inv a) (ordsucc m)))}.
claim HinvaG : apply_fun inv a :e G. { exact (HinvFn a HaG). }
claim HpowG : forall k:set, k :e omega -> group_power_nat mult e a k :e G.
{ exact (fun k Hk => group_power_nat_closed_in_group G mult e inv a k Hgrp HaG Hk). }
claim HpowInvG : forall k:set, k :e omega -> group_power_nat mult e (apply_fun inv a) k :e G.
{ exact (fun k Hk => group_power_nat_closed_in_group G mult e inv (apply_fun inv a) k Hgrp HinvaG Hk). }
prove Csub c= G /\ e :e Csub /\
  (forall x y:set, x :e Csub -> y :e Csub -> apply_fun mult (x, y) :e Csub) /\
  (forall x:set, x :e Csub -> apply_fun inv x :e Csub).
apply andI.
- apply andI.
  + apply andI.
    * (** Part 1: Csub c= G **)
      exact (Sep_Subq G (fun g:set => exists n:set, n :e int /\
        ((n :e omega /\ g = group_power_nat mult e a n) \/
         (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
          g = group_power_nat mult e (apply_fun inv a) (ordsucc m))))).
    * (** Part 2: e :e Csub **)
      claim Hpow0 : group_power_nat mult e a 0 = e.
      { exact (nat_primrec_0 e (fun _ r => apply_fun mult (a, r))). }
      claim H0omega : 0 :e omega. { exact (nat_p_omega 0 nat_0). }
      claim H0int : 0 :e int. { exact (Subq_omega_int 0 H0omega). }
      apply (SepI G (fun g:set => exists n:set, n :e int /\
        ((n :e omega /\ g = group_power_nat mult e a n) \/
         (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
          g = group_power_nat mult e (apply_fun inv a) (ordsucc m)))) e HeG).
      witness 0. apply andI.
      { exact H0int. }
      { apply orIL. apply andI.
        { exact H0omega. }
        { symmetry. exact Hpow0. }
      }
  + (** Part 3: mult closure **)
    set Pred := (fun g:set => exists n:set, n :e int /\
      ((n :e omega /\ g = group_power_nat mult e a n) \/
       (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
        g = group_power_nat mult e (apply_fun inv a) (ordsucc m)))).
    (** Helper: positive powers are in Csub **)
    claim HmkPosCsub : forall k:set, k :e omega -> group_power_nat mult e a k :e Csub.
    {
      let k. assume HkO : k :e omega.
      apply (SepI G Pred (group_power_nat mult e a k) (HpowG k HkO)).
      witness k. apply andI. { exact (Subq_omega_int k HkO). }
      { apply orIL. apply andI. { exact HkO. } { reflexivity. } }
    }
    (** Helper: negative powers are in Csub **)
    claim HmkNegCsub : forall m:set, m :e omega ->
      group_power_nat mult e (apply_fun inv a) (ordsucc m) :e Csub.
    {
      let m. assume HmO : m :e omega.
      claim HsmO : ordsucc m :e omega. { exact (omega_ordsucc m HmO). }
      apply (SepI G Pred (group_power_nat mult e (apply_fun inv a) (ordsucc m)) (HpowInvG (ordsucc m) HsmO)).
      witness (minus_SNo (ordsucc m)). apply andI.
      { exact (int_minus_SNo_omega (ordsucc m) HsmO). }
      { apply orIR. witness m. apply andI.
        { apply andI. { exact HmO. } { reflexivity. } }
        { reflexivity. } }
    }
    (** Helper: left multiply by a preserves Csub membership **)
    claim H_a_csub : forall z:set, z :e Csub -> apply_fun mult (a, z) :e Csub.
    {
      let z. assume HzC : z :e Csub.
      claim HzG : z :e G. { exact (SepE1 G Pred z HzC). }
      claim HzP : Pred z. { exact (SepE2 G Pred z HzC). }
      apply (HzP (apply_fun mult (a, z) :e Csub)).
      let nn. assume Hnn : nn :e int /\
        ((nn :e omega /\ z = group_power_nat mult e a nn) \/
         (exists m:set, m :e omega /\ nn = minus_SNo (ordsucc m) /\
          z = group_power_nat mult e (apply_fun inv a) (ordsucc m))).
      claim Hdisj : (nn :e omega /\ z = group_power_nat mult e a nn) \/
        (exists m:set, m :e omega /\ nn = minus_SNo (ordsucc m) /\
         z = group_power_nat mult e (apply_fun inv a) (ordsucc m)).
      { apply (Hnn ((nn :e omega /\ z = group_power_nat mult e a nn) \/
          (exists m:set, m :e omega /\ nn = minus_SNo (ordsucc m) /\
           z = group_power_nat mult e (apply_fun inv a) (ordsucc m)))).
        assume H1 H2. exact H2. }
      apply (Hdisj (apply_fun mult (a, z) :e Csub)).
      { (** z = pow(a, k) **)
        assume Hpos : nn :e omega /\ z = group_power_nat mult e a nn.
        claim HnnO : nn :e omega.
        { apply (Hpos (nn :e omega)). assume H1 H2. exact H1. }
        claim Hzeq : z = group_power_nat mult e a nn.
        { apply (Hpos (z = group_power_nat mult e a nn)). assume H1 H2. exact H2. }
        claim HpowS : group_power_nat mult e a (ordsucc nn) =
          apply_fun mult (a, group_power_nat mult e a nn).
        { exact (nat_primrec_S e (fun v r => apply_fun mult (a, r)) nn (omega_nat_p nn HnnO)). }
        claim Heq : apply_fun mult (a, z) = group_power_nat mult e a (ordsucc nn).
        { rewrite Hzeq. symmetry. exact HpowS. }
        rewrite Heq. exact (HmkPosCsub (ordsucc nn) (omega_ordsucc nn HnnO)).
      }
      { (** z = pow(inv(a), ordsucc(m)) **)
        assume Hneg : exists m:set, m :e omega /\ nn = minus_SNo (ordsucc m) /\
          z = group_power_nat mult e (apply_fun inv a) (ordsucc m).
        apply (Hneg (apply_fun mult (a, z) :e Csub)).
        let mm. assume Hmm : mm :e omega /\ nn = minus_SNo (ordsucc mm) /\
          z = group_power_nat mult e (apply_fun inv a) (ordsucc mm).
        claim HmmO : mm :e omega.
        { apply (Hmm (mm :e omega)). assume Hab Hc. apply (Hab (mm :e omega)). assume Ha Hb. exact Ha. }
        claim Hzeq : z = group_power_nat mult e (apply_fun inv a) (ordsucc mm).
        { apply (Hmm (z = group_power_nat mult e (apply_fun inv a) (ordsucc mm))).
          assume Hab Hc. exact Hc. }
        claim HmmNat : nat_p mm. { exact (omega_nat_p mm HmmO). }
        claim HpowInvS : group_power_nat mult e (apply_fun inv a) (ordsucc mm) =
          apply_fun mult (apply_fun inv a, group_power_nat mult e (apply_fun inv a) mm).
        { exact (nat_primrec_S e (fun v r => apply_fun mult (apply_fun inv a, r)) mm HmmNat). }
        claim HpowInvmmG : group_power_nat mult e (apply_fun inv a) mm :e G.
        { exact (HpowInvG mm HmmO). }
        claim Hassocstep :
          apply_fun mult (a, apply_fun mult (apply_fun inv a, group_power_nat mult e (apply_fun inv a) mm)) =
          apply_fun mult (apply_fun mult (a, apply_fun inv a), group_power_nat mult e (apply_fun inv a) mm).
        { symmetry. exact (Hassoc a (apply_fun inv a) (group_power_nat mult e (apply_fun inv a) mm)
            HaG HinvaG HpowInvmmG). }
        claim Hcanc : apply_fun mult (a, apply_fun inv a) = e.
        { apply (HinvLaw a HaG (apply_fun mult (a, apply_fun inv a) = e)). assume H1 H2. exact H1. }
        claim Hlid : apply_fun mult (e, group_power_nat mult e (apply_fun inv a) mm) =
          group_power_nat mult e (apply_fun inv a) mm.
        { apply (Hid (group_power_nat mult e (apply_fun inv a) mm) HpowInvmmG
            (apply_fun mult (e, group_power_nat mult e (apply_fun inv a) mm) =
             group_power_nat mult e (apply_fun inv a) mm)).
          assume H1 H2. exact H1. }
        claim Hfinal : apply_fun mult (a, z) = group_power_nat mult e (apply_fun inv a) mm.
        { rewrite Hzeq. rewrite HpowInvS. rewrite Hassocstep. rewrite Hcanc. exact Hlid. }
        rewrite Hfinal.
        (** Case split: mm = 0 or mm = ordsucc(mm') **)
        apply (nat_inv mm HmmNat (group_power_nat mult e (apply_fun inv a) mm :e Csub)).
        { assume Hmm0 : mm = 0.
          claim HpowInv0 : group_power_nat mult e (apply_fun inv a) 0 = e.
          { exact (nat_primrec_0 e (fun v r => apply_fun mult (apply_fun inv a, r))). }
          rewrite Hmm0.
          claim HpowInv0eq : group_power_nat mult e (apply_fun inv a) 0 = group_power_nat mult e a 0.
          { rewrite HpowInv0.
            symmetry. exact (nat_primrec_0 e (fun v r => apply_fun mult (a, r))). }
          rewrite HpowInv0eq.
          exact (HmkPosCsub 0 (nat_p_omega 0 nat_0)). }
        { assume HmmSucc : exists mm':set, nat_p mm' /\ mm = ordsucc mm'.
          apply (HmmSucc (group_power_nat mult e (apply_fun inv a) mm :e Csub)).
          let mm'. assume Hmm' : nat_p mm' /\ mm = ordsucc mm'.
          claim Hmm'Nat : nat_p mm'.
          { apply (Hmm' (nat_p mm')). assume H1 H2. exact H1. }
          claim HmmEqS : mm = ordsucc mm'.
          { apply (Hmm' (mm = ordsucc mm')). assume H1 H2. exact H2. }
          rewrite HmmEqS.
          exact (HmkNegCsub mm' (nat_p_omega mm' Hmm'Nat)). }
      }
    }
    (** Helper: left multiply by inv(a) preserves Csub membership **)
    claim H_inva_csub : forall z:set, z :e Csub -> apply_fun mult (apply_fun inv a, z) :e Csub.
    {
      let z. assume HzC : z :e Csub.
      claim HzG : z :e G. { exact (SepE1 G Pred z HzC). }
      claim HzP : Pred z. { exact (SepE2 G Pred z HzC). }
      apply (HzP (apply_fun mult (apply_fun inv a, z) :e Csub)).
      let nn. assume Hnn : nn :e int /\
        ((nn :e omega /\ z = group_power_nat mult e a nn) \/
         (exists m:set, m :e omega /\ nn = minus_SNo (ordsucc m) /\
          z = group_power_nat mult e (apply_fun inv a) (ordsucc m))).
      claim Hdisj : (nn :e omega /\ z = group_power_nat mult e a nn) \/
        (exists m:set, m :e omega /\ nn = minus_SNo (ordsucc m) /\
         z = group_power_nat mult e (apply_fun inv a) (ordsucc m)).
      { apply (Hnn ((nn :e omega /\ z = group_power_nat mult e a nn) \/
          (exists m:set, m :e omega /\ nn = minus_SNo (ordsucc m) /\
           z = group_power_nat mult e (apply_fun inv a) (ordsucc m)))).
        assume H1 H2. exact H2. }
      apply (Hdisj (apply_fun mult (apply_fun inv a, z) :e Csub)).
      { (** z = pow(a, nn) **)
        assume Hpos : nn :e omega /\ z = group_power_nat mult e a nn.
        claim HnnO : nn :e omega.
        { apply (Hpos (nn :e omega)). assume H1 H2. exact H1. }
        claim Hzeq : z = group_power_nat mult e a nn.
        { apply (Hpos (z = group_power_nat mult e a nn)). assume H1 H2. exact H2. }
        claim HnnNat : nat_p nn. { exact (omega_nat_p nn HnnO). }
        (** Case split: nn = 0 or nn = ordsucc(nn') **)
        apply (nat_inv nn HnnNat (apply_fun mult (apply_fun inv a, z) :e Csub)).
        { assume Hnn0 : nn = 0.
          claim Hpow0 : group_power_nat mult e a 0 = e.
          { exact (nat_primrec_0 e (fun v r => apply_fun mult (a, r))). }
          claim HzeqE : z = e. { rewrite Hzeq. rewrite Hnn0. exact Hpow0. }
          claim Hrid : apply_fun mult (apply_fun inv a, e) = apply_fun inv a.
          { apply (Hid (apply_fun inv a) HinvaG (apply_fun mult (apply_fun inv a, e) = apply_fun inv a)).
            assume H1 H2. exact H2. }
          claim HpowInv1 : group_power_nat mult e (apply_fun inv a) (ordsucc 0) =
            apply_fun mult (apply_fun inv a, group_power_nat mult e (apply_fun inv a) 0).
          { exact (nat_primrec_S e (fun v r => apply_fun mult (apply_fun inv a, r)) 0 nat_0). }
          claim HpowInv0 : group_power_nat mult e (apply_fun inv a) 0 = e.
          { exact (nat_primrec_0 e (fun v r => apply_fun mult (apply_fun inv a, r))). }
          claim HpowInv1eq : group_power_nat mult e (apply_fun inv a) (ordsucc 0) = apply_fun inv a.
          { rewrite HpowInv1. rewrite HpowInv0. exact Hrid. }
          claim Heq : apply_fun mult (apply_fun inv a, z) =
            group_power_nat mult e (apply_fun inv a) (ordsucc 0).
          { rewrite HzeqE. rewrite Hrid. symmetry. exact HpowInv1eq. }
          rewrite Heq. exact (HmkNegCsub 0 (nat_p_omega 0 nat_0)). }
        { assume HnnSucc : exists nn':set, nat_p nn' /\ nn = ordsucc nn'.
          apply (HnnSucc (apply_fun mult (apply_fun inv a, z) :e Csub)).
          let nn'. assume Hnn' : nat_p nn' /\ nn = ordsucc nn'.
          claim Hnn'Nat : nat_p nn'.
          { apply (Hnn' (nat_p nn')). assume H1 H2. exact H1. }
          claim HnnEqS : nn = ordsucc nn'.
          { apply (Hnn' (nn = ordsucc nn')). assume H1 H2. exact H2. }
          claim Hnn'O : nn' :e omega. { exact (nat_p_omega nn' Hnn'Nat). }
          claim HpowS : group_power_nat mult e a (ordsucc nn') =
            apply_fun mult (a, group_power_nat mult e a nn').
          { exact (nat_primrec_S e (fun v r => apply_fun mult (a, r)) nn' Hnn'Nat). }
          claim HpowNn'G : group_power_nat mult e a nn' :e G. { exact (HpowG nn' Hnn'O). }
          claim Hassocstep :
            apply_fun mult (apply_fun inv a, apply_fun mult (a, group_power_nat mult e a nn')) =
            apply_fun mult (apply_fun mult (apply_fun inv a, a), group_power_nat mult e a nn').
          { symmetry. exact (Hassoc (apply_fun inv a) a (group_power_nat mult e a nn')
              HinvaG HaG HpowNn'G). }
          claim Hcanc : apply_fun mult (apply_fun inv a, a) = e.
          { apply (HinvLaw a HaG (apply_fun mult (apply_fun inv a, a) = e)). assume H1 H2. exact H2. }
          claim Hlid : apply_fun mult (e, group_power_nat mult e a nn') = group_power_nat mult e a nn'.
          { apply (Hid (group_power_nat mult e a nn') HpowNn'G
              (apply_fun mult (e, group_power_nat mult e a nn') = group_power_nat mult e a nn')).
            assume H1 H2. exact H1. }
          claim Hfinal : apply_fun mult (apply_fun inv a, z) = group_power_nat mult e a nn'.
          { rewrite Hzeq. rewrite HnnEqS. rewrite HpowS. rewrite Hassocstep. rewrite Hcanc. exact Hlid. }
          rewrite Hfinal. exact (HmkPosCsub nn' Hnn'O). }
      }
      { (** z = pow(inv(a), ordsucc(m)) **)
        assume Hneg : exists m:set, m :e omega /\ nn = minus_SNo (ordsucc m) /\
          z = group_power_nat mult e (apply_fun inv a) (ordsucc m).
        apply (Hneg (apply_fun mult (apply_fun inv a, z) :e Csub)).
        let mm. assume Hmm : mm :e omega /\ nn = minus_SNo (ordsucc mm) /\
          z = group_power_nat mult e (apply_fun inv a) (ordsucc mm).
        claim HmmO : mm :e omega.
        { apply (Hmm (mm :e omega)). assume Hab Hc. apply (Hab (mm :e omega)). assume Ha Hb. exact Ha. }
        claim Hzeq : z = group_power_nat mult e (apply_fun inv a) (ordsucc mm).
        { apply (Hmm (z = group_power_nat mult e (apply_fun inv a) (ordsucc mm))).
          assume Hab Hc. exact Hc. }
        claim HmmNat : nat_p mm. { exact (omega_nat_p mm HmmO). }
        claim HpowInvSS : group_power_nat mult e (apply_fun inv a) (ordsucc (ordsucc mm)) =
          apply_fun mult (apply_fun inv a, group_power_nat mult e (apply_fun inv a) (ordsucc mm)).
        { exact (nat_primrec_S e (fun v r => apply_fun mult (apply_fun inv a, r)) (ordsucc mm) (nat_ordsucc mm HmmNat)). }
        claim HsmO : ordsucc mm :e omega. { exact (omega_ordsucc mm HmmO). }
        claim Heq : apply_fun mult (apply_fun inv a, z) =
          group_power_nat mult e (apply_fun inv a) (ordsucc (ordsucc mm)).
        { rewrite Hzeq. symmetry. exact HpowInvSS. }
        rewrite Heq. exact (HmkNegCsub (ordsucc mm) HsmO).
      }
    }
    (** Main mult closure using induction **)
    let x y. assume HxC : x :e Csub. assume HyC : y :e Csub.
    claim HxG : x :e G. { exact (SepE1 G Pred x HxC). }
    claim HyG : y :e G. { exact (SepE1 G Pred y HyC). }
    claim HxP : Pred x. { exact (SepE2 G Pred x HxC). }
    apply (HxP (apply_fun mult (x, y) :e Csub)).
    let nn. assume Hnn : nn :e int /\
      ((nn :e omega /\ x = group_power_nat mult e a nn) \/
       (exists m:set, m :e omega /\ nn = minus_SNo (ordsucc m) /\
        x = group_power_nat mult e (apply_fun inv a) (ordsucc m))).
    claim Hdisj : (nn :e omega /\ x = group_power_nat mult e a nn) \/
      (exists m:set, m :e omega /\ nn = minus_SNo (ordsucc m) /\
       x = group_power_nat mult e (apply_fun inv a) (ordsucc m)).
    { apply (Hnn ((nn :e omega /\ x = group_power_nat mult e a nn) \/
        (exists m:set, m :e omega /\ nn = minus_SNo (ordsucc m) /\
         x = group_power_nat mult e (apply_fun inv a) (ordsucc m)))).
      assume H1 H2. exact H2. }
    apply (Hdisj (apply_fun mult (x, y) :e Csub)).
    { (** x = pow(a, nn) **)
      assume Hpos : nn :e omega /\ x = group_power_nat mult e a nn.
      claim HnnO : nn :e omega.
      { apply (Hpos (nn :e omega)). assume H1 H2. exact H1. }
      claim Hxeq : x = group_power_nat mult e a nn.
      { apply (Hpos (x = group_power_nat mult e a nn)). assume H1 H2. exact H2. }
      claim HnnNat : nat_p nn. { exact (omega_nat_p nn HnnO). }
      rewrite Hxeq.
      claim HInd : forall p:set, nat_p p ->
        apply_fun mult (group_power_nat mult e a p, y) :e Csub.
      {
        apply nat_ind.
        - (** Base: pow(a, 0) mult y = e mult y = y **)
          claim Hpow0 : group_power_nat mult e a 0 = e.
          { exact (nat_primrec_0 e (fun v r => apply_fun mult (a, r))). }
          claim Hlid : apply_fun mult (e, y) = y.
          { apply (Hid y HyG (apply_fun mult (e, y) = y)). assume H1 H2. exact H1. }
          claim Heq : apply_fun mult (group_power_nat mult e a 0, y) = y.
          { rewrite Hpow0. exact Hlid. }
          rewrite Heq. exact HyC.
        - (** Step: pow(a, succ(p')) mult y = a mult (pow(a, p') mult y) **)
          let p'. assume Hp'Nat : nat_p p'.
          assume IH : apply_fun mult (group_power_nat mult e a p', y) :e Csub.
          claim Hp'O : p' :e omega. { exact (nat_p_omega p' Hp'Nat). }
          claim HpowP'G : group_power_nat mult e a p' :e G. { exact (HpowG p' Hp'O). }
          claim HprodG : apply_fun mult (group_power_nat mult e a p', y) :e G.
          { exact (SepE1 G Pred (apply_fun mult (group_power_nat mult e a p', y)) IH). }
          claim HpowS : group_power_nat mult e a (ordsucc p') =
            apply_fun mult (a, group_power_nat mult e a p').
          { exact (nat_primrec_S e (fun v r => apply_fun mult (a, r)) p' Hp'Nat). }
          claim Hassocstep :
            apply_fun mult (apply_fun mult (a, group_power_nat mult e a p'), y) =
            apply_fun mult (a, apply_fun mult (group_power_nat mult e a p', y)).
          { exact (Hassoc a (group_power_nat mult e a p') y HaG HpowP'G HyG). }
          claim Heq : apply_fun mult (group_power_nat mult e a (ordsucc p'), y) =
            apply_fun mult (a, apply_fun mult (group_power_nat mult e a p', y)).
          { rewrite HpowS. exact Hassocstep. }
          rewrite Heq. exact (H_a_csub (apply_fun mult (group_power_nat mult e a p', y)) IH).
      }
      exact (HInd nn HnnNat).
    }
    { (** x = pow(inv(a), ordsucc(m)) **)
      assume Hneg : exists m:set, m :e omega /\ nn = minus_SNo (ordsucc m) /\
        x = group_power_nat mult e (apply_fun inv a) (ordsucc m).
      apply (Hneg (apply_fun mult (x, y) :e Csub)).
      let mm. assume Hmm : mm :e omega /\ nn = minus_SNo (ordsucc mm) /\
        x = group_power_nat mult e (apply_fun inv a) (ordsucc mm).
      claim HmmO : mm :e omega.
      { apply (Hmm (mm :e omega)). assume Hab Hc. apply (Hab (mm :e omega)). assume Ha Hb. exact Ha. }
      claim Hxeq : x = group_power_nat mult e (apply_fun inv a) (ordsucc mm).
      { apply (Hmm (x = group_power_nat mult e (apply_fun inv a) (ordsucc mm))).
        assume Hab Hc. exact Hc. }
      claim HmmNat : nat_p mm. { exact (omega_nat_p mm HmmO). }
      rewrite Hxeq.
      claim HInd : forall q:set, nat_p q ->
        apply_fun mult (group_power_nat mult e (apply_fun inv a) (ordsucc q), y) :e Csub.
      {
        apply nat_ind.
        - (** Base: pow(inv(a), 1) mult y = inv(a) mult y **)
          claim HpowInv1 : group_power_nat mult e (apply_fun inv a) (ordsucc 0) =
            apply_fun mult (apply_fun inv a, group_power_nat mult e (apply_fun inv a) 0).
          { exact (nat_primrec_S e (fun v r => apply_fun mult (apply_fun inv a, r)) 0 nat_0). }
          claim HpowInv0 : group_power_nat mult e (apply_fun inv a) 0 = e.
          { exact (nat_primrec_0 e (fun v r => apply_fun mult (apply_fun inv a, r))). }
          claim Hrid : apply_fun mult (apply_fun inv a, e) = apply_fun inv a.
          { apply (Hid (apply_fun inv a) HinvaG (apply_fun mult (apply_fun inv a, e) = apply_fun inv a)).
            assume H1 H2. exact H2. }
          claim HpowInv1eq : group_power_nat mult e (apply_fun inv a) (ordsucc 0) = apply_fun inv a.
          { rewrite HpowInv1. rewrite HpowInv0. exact Hrid. }
          claim Hassocstep :
            apply_fun mult (group_power_nat mult e (apply_fun inv a) (ordsucc 0), y) =
            apply_fun mult (apply_fun inv a, y).
          { rewrite HpowInv1eq. reflexivity. }
          rewrite Hassocstep. exact (H_inva_csub y HyC).
        - (** Step: pow(inv(a), succ(succ(q'))) mult y = inv(a) mult (pow(inv(a), succ(q')) mult y) **)
          let q'. assume Hq'Nat : nat_p q'.
          assume IH : apply_fun mult (group_power_nat mult e (apply_fun inv a) (ordsucc q'), y) :e Csub.
          claim Hq'O : q' :e omega. { exact (nat_p_omega q' Hq'Nat). }
          claim HsqO : ordsucc q' :e omega. { exact (omega_ordsucc q' Hq'O). }
          claim HpowInvSqG : group_power_nat mult e (apply_fun inv a) (ordsucc q') :e G.
          { exact (HpowInvG (ordsucc q') HsqO). }
          claim HprodG : apply_fun mult (group_power_nat mult e (apply_fun inv a) (ordsucc q'), y) :e G.
          { exact (SepE1 G Pred (apply_fun mult (group_power_nat mult e (apply_fun inv a) (ordsucc q'), y)) IH). }
          claim HpowInvSS : group_power_nat mult e (apply_fun inv a) (ordsucc (ordsucc q')) =
            apply_fun mult (apply_fun inv a, group_power_nat mult e (apply_fun inv a) (ordsucc q')).
          { exact (nat_primrec_S e (fun v r => apply_fun mult (apply_fun inv a, r)) (ordsucc q') (nat_ordsucc q' Hq'Nat)). }
          claim Hassocstep :
            apply_fun mult (apply_fun mult (apply_fun inv a, group_power_nat mult e (apply_fun inv a) (ordsucc q')), y) =
            apply_fun mult (apply_fun inv a, apply_fun mult (group_power_nat mult e (apply_fun inv a) (ordsucc q'), y)).
          { exact (Hassoc (apply_fun inv a) (group_power_nat mult e (apply_fun inv a) (ordsucc q')) y
              HinvaG HpowInvSqG HyG). }
          claim Heq : apply_fun mult (group_power_nat mult e (apply_fun inv a) (ordsucc (ordsucc q')), y) =
            apply_fun mult (apply_fun inv a, apply_fun mult (group_power_nat mult e (apply_fun inv a) (ordsucc q'), y)).
          { rewrite HpowInvSS. exact Hassocstep. }
          rewrite Heq. exact (H_inva_csub (apply_fun mult (group_power_nat mult e (apply_fun inv a) (ordsucc q'), y)) IH).
      }
      exact (HInd mm HmmNat).
    }
- (** Part 4: inverse closure **)
  let x. assume HxC : x :e Csub.
  claim HxG : x :e G. { exact (SepE1 G (fun g:set => exists n:set, n :e int /\
    ((n :e omega /\ g = group_power_nat mult e a n) \/
     (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
      g = group_power_nat mult e (apply_fun inv a) (ordsucc m)))) x HxC). }
  claim HinvxG : apply_fun inv x :e G. { exact (HinvFn x HxG). }
  claim HxP : exists n:set, n :e int /\
    ((n :e omega /\ x = group_power_nat mult e a n) \/
     (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
      x = group_power_nat mult e (apply_fun inv a) (ordsucc m))).
  { exact (SepE2 G (fun g:set => exists n:set, n :e int /\
      ((n :e omega /\ g = group_power_nat mult e a n) \/
       (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
        g = group_power_nat mult e (apply_fun inv a) (ordsucc m)))) x HxC). }
  apply (HxP (apply_fun inv x :e Csub)).
  let nn. assume Hnn : nn :e int /\
    ((nn :e omega /\ x = group_power_nat mult e a nn) \/
     (exists m:set, m :e omega /\ nn = minus_SNo (ordsucc m) /\
      x = group_power_nat mult e (apply_fun inv a) (ordsucc m))).
  claim HnnInt : nn :e int.
  { exact (andEL (nn :e int) ((nn :e omega /\ x = group_power_nat mult e a nn) \/
     (exists m:set, m :e omega /\ nn = minus_SNo (ordsucc m) /\
      x = group_power_nat mult e (apply_fun inv a) (ordsucc m))) Hnn). }
  claim Hdisj : (nn :e omega /\ x = group_power_nat mult e a nn) \/
     (exists m:set, m :e omega /\ nn = minus_SNo (ordsucc m) /\
      x = group_power_nat mult e (apply_fun inv a) (ordsucc m)).
  { exact (andER (nn :e int) ((nn :e omega /\ x = group_power_nat mult e a nn) \/
     (exists m:set, m :e omega /\ nn = minus_SNo (ordsucc m) /\
      x = group_power_nat mult e (apply_fun inv a) (ordsucc m))) Hnn). }
  apply (Hdisj (apply_fun inv x :e Csub)).
  { (** Case A: x = pow(a, nn), nn :e omega **)
    assume HposCase : nn :e omega /\ x = group_power_nat mult e a nn.
    claim HnnOmega : nn :e omega.
    { exact (andEL (nn :e omega) (x = group_power_nat mult e a nn) HposCase). }
    claim Hxeq : x = group_power_nat mult e a nn.
    { exact (andER (nn :e omega) (x = group_power_nat mult e a nn) HposCase). }
    claim HnnNat : nat_p nn. { exact (omega_nat_p nn HnnOmega). }
    claim HinvPow : apply_fun inv (group_power_nat mult e a nn) =
      group_power_nat mult e (apply_fun inv a) nn.
    { exact (inv_of_power_nat_eq_power_inv G mult e inv a nn Hgrp HaG HnnOmega). }
    claim HinvxEq : apply_fun inv x = group_power_nat mult e (apply_fun inv a) nn.
    { rewrite Hxeq. exact HinvPow. }
    (** Case split on nn = 0 or nn = ordsucc(nn') **)
    apply (nat_inv nn HnnNat (apply_fun inv x :e Csub)).
    { (** Sub-case nn = 0 **)
      assume Hnn0 : nn = 0.
      claim HinvPow0 : group_power_nat mult e (apply_fun inv a) 0 = e.
      { exact (nat_primrec_0 e (fun _ r => apply_fun mult (apply_fun inv a, r))). }
      claim HinvxE : apply_fun inv x = e.
      { rewrite HinvxEq. rewrite Hnn0. exact HinvPow0. }
      rewrite HinvxE.
      claim H0omega : 0 :e omega. { exact (nat_p_omega 0 nat_0). }
      claim H0int : 0 :e int. { exact (Subq_omega_int 0 H0omega). }
      claim Hpow0 : group_power_nat mult e a 0 = e.
      { exact (nat_primrec_0 e (fun _ r => apply_fun mult (a, r))). }
      apply (SepI G (fun g:set => exists n:set, n :e int /\
        ((n :e omega /\ g = group_power_nat mult e a n) \/
         (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
          g = group_power_nat mult e (apply_fun inv a) (ordsucc m)))) e HeG).
      witness 0. apply andI.
      { exact H0int. }
      { apply orIL. apply andI. { exact H0omega. } { symmetry. exact Hpow0. } }
    }
    { (** Sub-case nn = ordsucc(nn') **)
      assume Hsucc : exists nn':set, nat_p nn' /\ nn = ordsucc nn'.
      apply (Hsucc (apply_fun inv x :e Csub)).
      let nn'. assume Hnn' : nat_p nn' /\ nn = ordsucc nn'.
      claim Hnn'Nat : nat_p nn'. { exact (andEL (nat_p nn') (nn = ordsucc nn') Hnn'). }
      claim HnnSucc : nn = ordsucc nn'. { exact (andER (nat_p nn') (nn = ordsucc nn') Hnn'). }
      claim Hnn'Omega : nn' :e omega. { exact (nat_p_omega nn' Hnn'Nat). }
      claim HinvxSucc : apply_fun inv x = group_power_nat mult e (apply_fun inv a) (ordsucc nn').
      { rewrite HinvxEq. rewrite HnnSucc. reflexivity. }
      claim HsuccOmega : ordsucc nn' :e omega. { exact (omega_ordsucc nn' Hnn'Omega). }
      claim HinvxGmem : group_power_nat mult e (apply_fun inv a) (ordsucc nn') :e G.
      { exact (HpowInvG (ordsucc nn') HsuccOmega). }
      claim HmsInt : minus_SNo (ordsucc nn') :e int.
      { exact (int_minus_SNo_omega (ordsucc nn') HsuccOmega). }
      rewrite HinvxSucc.
      apply (SepI G (fun g:set => exists n:set, n :e int /\
        ((n :e omega /\ g = group_power_nat mult e a n) \/
         (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
          g = group_power_nat mult e (apply_fun inv a) (ordsucc m)))) (group_power_nat mult e (apply_fun inv a) (ordsucc nn')) HinvxGmem).
      witness (minus_SNo (ordsucc nn')). apply andI.
      { exact HmsInt. }
      { apply orIR. witness nn'. apply andI.
        { apply andI. { exact Hnn'Omega. } { reflexivity. } }
        { reflexivity. }
      }
    }
  }
  { (** Case B: x = pow(inv(a), ordsucc(m)), m :e omega **)
    assume HnegCase : exists m:set, m :e omega /\ nn = minus_SNo (ordsucc m) /\
      x = group_power_nat mult e (apply_fun inv a) (ordsucc m).
    apply (HnegCase (apply_fun inv x :e Csub)).
    let mm. assume Hmm : mm :e omega /\ nn = minus_SNo (ordsucc mm) /\
      x = group_power_nat mult e (apply_fun inv a) (ordsucc mm).
    claim HmmOmegaAndNn : mm :e omega /\ nn = minus_SNo (ordsucc mm).
    { exact (andEL (mm :e omega /\ nn = minus_SNo (ordsucc mm))
        (x = group_power_nat mult e (apply_fun inv a) (ordsucc mm)) Hmm). }
    claim HmmOmega : mm :e omega.
    { exact (andEL (mm :e omega) (nn = minus_SNo (ordsucc mm)) HmmOmegaAndNn). }
    claim Hxeq2 : x = group_power_nat mult e (apply_fun inv a) (ordsucc mm).
    { exact (andER (mm :e omega /\ nn = minus_SNo (ordsucc mm))
        (x = group_power_nat mult e (apply_fun inv a) (ordsucc mm)) Hmm). }
    claim HsuccmmOmega : ordsucc mm :e omega. { exact (omega_ordsucc mm HmmOmega). }
    claim HinvPow2 : apply_fun inv (group_power_nat mult e (apply_fun inv a) (ordsucc mm)) =
      group_power_nat mult e (apply_fun inv (apply_fun inv a)) (ordsucc mm).
    { exact (inv_of_power_nat_eq_power_inv G mult e inv (apply_fun inv a) (ordsucc mm) Hgrp HinvaG HsuccmmOmega). }
    claim HinvInvA : apply_fun inv (apply_fun inv a) = a.
    { exact (group_inv_inv G mult inv e a HmultFn HinvFn HeG Hassoc Hid HinvLaw HaG). }
    claim HinvxEq2 : apply_fun inv x =
      group_power_nat mult e a (ordsucc mm).
    { rewrite Hxeq2. rewrite HinvPow2.
      rewrite HinvInvA. reflexivity. }
    claim HpowSuccG : group_power_nat mult e a (ordsucc mm) :e G.
    { exact (HpowG (ordsucc mm) HsuccmmOmega). }
    rewrite HinvxEq2.
    apply (SepI G (fun g:set => exists n:set, n :e int /\
      ((n :e omega /\ g = group_power_nat mult e a n) \/
       (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
        g = group_power_nat mult e (apply_fun inv a) (ordsucc m)))) (group_power_nat mult e a (ordsucc mm)) HpowSuccG).
    witness (ordsucc mm). apply andI.
    { exact (Subq_omega_int (ordsucc mm) HsuccmmOmega). }
    { apply orIL. apply andI.
      { exact HsuccmmOmega. }
      { reflexivity. }
    }
  }
Qed.

(** Infrastructure: appending one generator-family element to a word product gives a longer word product **)
(** Proven Alice **)
Theorem word_product_right_append_in_generated :
  forall G mult e inv J Gfam n xs g alpha:set,
  group_structure G mult e inv ->
  n :e omega ->
  function_on xs n G ->
  (forall i:set, i :e n -> exists a:set, a :e J /\ apply_fun xs i :e apply_fun Gfam a) ->
  alpha :e J ->
  g :e apply_fun Gfam alpha ->
  g :e G ->
  exists n' xs':set, n' :e omega /\ n' <> 0 /\
    function_on xs' n' G /\
    (forall i:set, i :e n' -> exists a:set, a :e J /\ apply_fun xs' i :e apply_fun Gfam a) /\
    apply_fun mult (word_product mult e xs n, g) = word_product mult e xs' n'.
let G mult e inv J Gfam n xs g alpha.
assume Hgrp : group_structure G mult e inv.
assume HnO : n :e omega.
assume HxsFn : function_on xs n G.
assume HxsGfam : forall i:set, i :e n -> exists a:set, a :e J /\ apply_fun xs i :e apply_fun Gfam a.
assume HalphaJ : alpha :e J.
assume HgGfam : g :e apply_fun Gfam alpha.
assume HgG : g :e G.
claim HnNat : nat_p n. { exact (omega_nat_p n HnO). }
claim HsnO : ordsucc n :e omega. { exact (omega_ordsucc n HnO). }
set xs_ext := graph (ordsucc n) (fun i:set => if i :e n then apply_fun xs i else g).
(** Key equation from word_product_append_one **)
claim Happend : word_product mult e xs_ext (ordsucc n) =
  apply_fun mult (word_product mult e xs n, g).
{ exact (word_product_append_one mult e xs g n HnO). }
witness (ordsucc n). witness xs_ext.
apply andI.
{ apply andI.
  { apply andI.
    { apply andI.
      { exact HsnO. }
      { exact (neq_ordsucc_0 n). } }
    { (** function_on xs_ext (ordsucc n) G **)
      let i. assume Hisn : i :e ordsucc n.
      claim Hap : apply_fun xs_ext i =
        (if i :e n then apply_fun xs i else g).
      { exact (apply_fun_graph (ordsucc n) (fun i:set => if i :e n then apply_fun xs i else g) i Hisn). }
      rewrite Hap.
      apply (If_i_correct (i :e n) (apply_fun xs i) g).
      { assume Htrue : (i :e n) /\ (if i :e n then apply_fun xs i else g) = apply_fun xs i.
        claim Hin : i :e n.
        { apply (Htrue (i :e n)). assume H1 H2. exact H1. }
        claim Hif : (if i :e n then apply_fun xs i else g) = apply_fun xs i.
        { apply (Htrue ((if i :e n then apply_fun xs i else g) = apply_fun xs i)). assume H1 H2. exact H2. }
        rewrite Hif. exact (HxsFn i Hin). }
      { assume Hfalse : ~(i :e n) /\ (if i :e n then apply_fun xs i else g) = g.
        claim Hif : (if i :e n then apply_fun xs i else g) = g.
        { apply (Hfalse ((if i :e n then apply_fun xs i else g) = g)). assume H1 H2. exact H2. }
        rewrite Hif. exact HgG. } } }
  { (** forall i :e ordsucc n, exists alpha, ... **)
    let i. assume Hisn : i :e ordsucc n.
    claim Hap : apply_fun xs_ext i =
      (if i :e n then apply_fun xs i else g).
    { exact (apply_fun_graph (ordsucc n) (fun i:set => if i :e n then apply_fun xs i else g) i Hisn). }
    rewrite Hap.
    apply (If_i_correct (i :e n) (apply_fun xs i) g).
    { assume Htrue : (i :e n) /\ (if i :e n then apply_fun xs i else g) = apply_fun xs i.
      claim Hin : i :e n.
      { apply (Htrue (i :e n)). assume H1 H2. exact H1. }
      claim Hif : (if i :e n then apply_fun xs i else g) = apply_fun xs i.
      { apply (Htrue ((if i :e n then apply_fun xs i else g) = apply_fun xs i)). assume H1 H2. exact H2. }
      rewrite Hif. exact (HxsGfam i Hin). }
    { assume Hfalse : ~(i :e n) /\ (if i :e n then apply_fun xs i else g) = g.
      claim Hif : (if i :e n then apply_fun xs i else g) = g.
      { apply (Hfalse ((if i :e n then apply_fun xs i else g) = g)). assume H1 H2. exact H2. }
      rewrite Hif. witness alpha. apply andI. { exact HalphaJ. } { exact HgGfam. } } } }
{ symmetry. exact Happend. }
Qed.

(** Infrastructure helper for S69 backward direction:
    extension property forces the free-product decomposition by cyclic generator subgroups. **)
Theorem extension_property_forces_free_product_generated_subgroups :
  forall G mult e inv J gens:set,
  group_structure G mult e inv ->
  function_on gens J G ->
  (forall H multH eH invH:set,
    group_structure H multH eH invH ->
    forall ys:set, function_on ys J H ->
      exists h:set,
        group_homomorphism G mult H multH h /\
        (forall alpha:set, alpha :e J ->
          apply_fun h (apply_fun gens alpha) = apply_fun ys alpha) /\
        (forall h':set, group_homomorphism G mult H multH h' ->
          (forall alpha:set, alpha :e J ->
            apply_fun h' (apply_fun gens alpha) = apply_fun ys alpha) ->
          forall x:set, x :e G -> apply_fun h' x = apply_fun h x)) ->
  free_product_of_subgroups G mult e inv J
    (graph J (fun alpha:set =>
      {g :e G | exists n:set, n :e int /\
        ((n :e omega /\ g = group_power_nat mult e (apply_fun gens alpha) n) \/
         (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
          g = group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m)))}))
    (graph J (fun alpha:set => e)).
let G mult e inv J gens.
assume Hgrp : group_structure G mult e inv.
assume Hgens : function_on gens J G.
assume Hext :
  forall H multH eH invH:set,
    group_structure H multH eH invH ->
    forall ys:set, function_on ys J H ->
      exists h:set,
        group_homomorphism G mult H multH h /\
        (forall alpha:set, alpha :e J ->
          apply_fun h (apply_fun gens alpha) = apply_fun ys alpha) /\
        (forall h':set, group_homomorphism G mult H multH h' ->
          (forall alpha:set, alpha :e J ->
            apply_fun h' (apply_fun gens alpha) = apply_fun ys alpha) ->
          forall x:set, x :e G -> apply_fun h' x = apply_fun h x).
set Gfam := graph J (fun alpha:set =>
  {g :e G | exists n:set, n :e int /\
    ((n :e omega /\ g = group_power_nat mult e (apply_fun gens alpha) n) \/
     (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
      g = group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m)))}).
set efam := graph J (fun alpha:set => e).
prove
  group_structure G mult e inv /\
  (forall alpha:set, alpha :e J -> subgroup_of (apply_fun Gfam alpha) G mult e inv) /\
  (forall alpha beta:set, alpha :e J -> beta :e J -> alpha <> beta ->
    forall x:set, x :e apply_fun Gfam alpha -> x :e apply_fun Gfam beta -> x = e) /\
  subgroups_generate G mult e inv J Gfam /\
  (forall x:set, x :e G -> x <> e ->
    exists n xs:set,
      reduced_word J Gfam efam n xs /\ n <> 0 /\
      word_product mult e xs n = x /\
      (forall n' xs':set,
        reduced_word J Gfam efam n' xs' -> n' <> 0 ->
        word_product mult e xs' n' = x ->
        n = n' /\ (forall i:set, i :e n -> apply_fun xs i = apply_fun xs' i))) /\
  (forall alpha:set, alpha :e J -> apply_fun efam alpha = e).
apply andI.
- apply andI.
  + apply andI.
    * apply andI.
      { apply andI.
        - (** Component 1: group_structure - immediate from hypothesis **)
          exact Hgrp.
        - (** Component 2: each Gfam(alpha) is a subgroup **)
          let alpha. assume HalphaJ : alpha :e J.
          claim HgensAlphaG : apply_fun gens alpha :e G. { exact (Hgens alpha HalphaJ). }
          claim HapGfam : apply_fun Gfam alpha =
            {g :e G | exists n:set, n :e int /\
              ((n :e omega /\ g = group_power_nat mult e (apply_fun gens alpha) n) \/
               (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
                g = group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m)))}.
          { exact (apply_fun_graph J (fun alpha:set =>
              {g :e G | exists n:set, n :e int /\
                ((n :e omega /\ g = group_power_nat mult e (apply_fun gens alpha) n) \/
                 (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
                  g = group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m)))})
              alpha HalphaJ). }
          rewrite HapGfam.
          exact (cyclic_generator_subgroup_is_subgroup G mult e inv (apply_fun gens alpha) Hgrp HgensAlphaG).
      }
      { (** Component 3: disjointness - resolved by extension_property_forces_disjointness **)
        let alpha beta. assume HalphaJ HbetaJ Hne.
        let x. assume HxGfamA HxGfamB.
        exact (extension_property_forces_disjointness
          G mult e inv J gens alpha beta x
          Hgrp Hgens Hext HalphaJ HbetaJ Hne HxGfamA HxGfamB).
      }
    * (** Component 4: subgroups_generate **)
    prove group_structure G mult e inv /\
      (forall alpha:set, alpha :e J -> subgroup_of (apply_fun Gfam alpha) G mult e inv) /\
      (forall x:set, x :e G ->
        x = e \/
        exists n:set, n :e omega /\ n <> 0 /\
        exists xs:set, function_on xs n G /\
          (forall i:set, i :e n ->
            exists alpha:set, alpha :e J /\ apply_fun xs i :e apply_fun Gfam alpha) /\
          x = nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) n).
    apply andI.
    { apply andI.
      { exact Hgrp. }
      { let alpha. assume HalphaJ : alpha :e J.
        claim HgensAlphaG : apply_fun gens alpha :e G. { exact (Hgens alpha HalphaJ). }
        claim HapGfam : apply_fun Gfam alpha =
          {g :e G | exists n:set, n :e int /\
            ((n :e omega /\ g = group_power_nat mult e (apply_fun gens alpha) n) \/
             (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
              g = group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m)))}.
        { exact (apply_fun_graph J (fun alpha:set =>
            {g :e G | exists n:set, n :e int /\
              ((n :e omega /\ g = group_power_nat mult e (apply_fun gens alpha) n) \/
               (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
                g = group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m)))})
            alpha HalphaJ). }
        rewrite HapGfam.
        exact (cyclic_generator_subgroup_is_subgroup G mult e inv (apply_fun gens alpha) Hgrp HgensAlphaG).
      }
    }
    { (** Generation property: every x :e G is e or a word product **)
      (** Strategy: define S = {word products}, show S is a subgroup,
          use extension property with H = S and H = G, uniqueness gives S = G **)
      let x. assume HxG : x :e G.
      (** Extract group structure components **)
      apply (and6E
        (function_on mult (setprod G G) G)
        (function_on inv G G)
        (e :e G)
        (forall a b c:set, a :e G -> b :e G -> c :e G ->
          apply_fun mult (apply_fun mult (a, b), c) = apply_fun mult (a, apply_fun mult (b, c)))
        (forall a:set, a :e G -> apply_fun mult (e, a) = a /\ apply_fun mult (a, e) = a)
        (forall a:set, a :e G ->
          apply_fun mult (a, apply_fun inv a) = e /\ apply_fun mult (apply_fun inv a, a) = e)
        Hgrp).
      assume HmultFn HinvFn HeG Hassoc Hid Hinv.
      set WordProd : set -> prop := fun w:set =>
        w = e \/
        exists n:set, n :e omega /\ n <> 0 /\
        exists xs:set, function_on xs n G /\
          (forall i:set, i :e n ->
            exists alpha:set, alpha :e J /\ apply_fun xs i :e apply_fun Gfam alpha) /\
          w = word_product mult e xs n.
      set S : set := Sep G WordProd.
      claim HSsubG : S c= G. { exact (Sep_Subq G WordProd). }
      claim HeS : e :e S.
      { apply (SepI G WordProd e).
        - exact HeG.
        - prove e = e \/
            exists n:set, n :e omega /\ n <> 0 /\
            exists xs:set, function_on xs n G /\
              (forall i:set, i :e n ->
                exists alpha:set, alpha :e J /\ apply_fun xs i :e apply_fun Gfam alpha) /\
              e = word_product mult e xs n.
          apply orIL. reflexivity. }
      (** Mult closure of S **)
      claim HSmultClosed : forall a b:set, a :e S -> b :e S ->
        apply_fun mult (a, b) :e S.
      {
        (** Helper: mult(a, word_product(ys, k)) :e S for any a :e S, by induction on k **)
        claim Haux : forall k:set, nat_p k ->
          forall ys:set, (forall i:set, i :e k -> apply_fun ys i :e G) ->
          (forall i:set, i :e k ->
            exists alpha:set, alpha :e J /\ apply_fun ys i :e apply_fun Gfam alpha) ->
          forall a:set, a :e S ->
          apply_fun mult (a, word_product mult e ys k) :e S.
        {
          apply nat_ind.
          { (** Base case: k = 0 **)
            let ys. assume HysG HysGfam.
            let a. assume HaS : a :e S.
            claim HaG : a :e G. { exact (HSsubG a HaS). }
            claim Hwp0 : word_product mult e ys 0 = e.
            { exact (nat_primrec_0 e (fun i r => apply_fun mult (r, apply_fun ys i))). }
            rewrite Hwp0.
            claim Hrid : apply_fun mult (a, e) = a.
            { exact (andER
                (apply_fun mult (e, a) = a)
                (apply_fun mult (a, e) = a)
                (Hid a HaG)). }
            rewrite Hrid. exact HaS.
          }
          { (** Step case: nat_p k -> P(k) -> P(ordsucc k) **)
            let k. assume Hk_nat : nat_p k.
            assume HIH : forall ys:set, (forall i:set, i :e k -> apply_fun ys i :e G) ->
              (forall i:set, i :e k ->
                exists alpha:set, alpha :e J /\ apply_fun ys i :e apply_fun Gfam alpha) ->
              forall a:set, a :e S ->
              apply_fun mult (a, word_product mult e ys k) :e S.
            let ys. assume HysG : forall i:set, i :e ordsucc k -> apply_fun ys i :e G.
            assume HysGfam : forall i:set, i :e ordsucc k ->
              exists alpha:set, alpha :e J /\ apply_fun ys i :e apply_fun Gfam alpha.
            let a. assume HaS : a :e S.
            claim HaG : a :e G. { exact (HSsubG a HaS). }
            (** word_product(ys, ordsucc k) = mult(word_product(ys, k), ys(k)) **)
            claim Hwps : word_product mult e ys (ordsucc k) =
              apply_fun mult (word_product mult e ys k, apply_fun ys k).
            { exact (word_product_succ mult e ys k Hk_nat). }
            rewrite Hwps.
            (** Get membership facts **)
            claim HykG : apply_fun ys k :e G.
            { exact (HysG k (ordsuccI2 k)). }
            claim HwpkG : word_product mult e ys k :e G.
            { exact (word_product_in_G_group G mult e inv k ys Hgrp Hk_nat
                (fun i Hi => HysG i (ordsuccI1 k i Hi))). }
            (** Use associativity: mult(mult(a, wp), yk) = mult(a, mult(wp, yk)) **)
            claim Hassoc_eq : apply_fun mult (apply_fun mult (a, word_product mult e ys k), apply_fun ys k) =
              apply_fun mult (a, apply_fun mult (word_product mult e ys k, apply_fun ys k)).
            { exact (Hassoc a (word_product mult e ys k) (apply_fun ys k) HaG HwpkG HykG). }
            rewrite <- Hassoc_eq.
            (** By IH: c := mult(a, wp(ys,k)) :e S **)
            claim HysG_k : forall i:set, i :e k -> apply_fun ys i :e G.
            { let i. assume Hin : i :e k. exact (HysG i (ordsuccI1 k i Hin)). }
            claim HysGfam_k : forall i:set, i :e k ->
              exists alpha:set, alpha :e J /\ apply_fun ys i :e apply_fun Gfam alpha.
            { let i. assume Hin : i :e k. exact (HysGfam i (ordsuccI1 k i Hin)). }
            set c := apply_fun mult (a, word_product mult e ys k).
            claim HcS : c :e S. { exact (HIH ys HysG_k HysGfam_k a HaS). }
            claim HcG : c :e G. { exact (HSsubG c HcS). }
            claim HcWP : WordProd c. { exact (SepE2 G WordProd c HcS). }
            (** Get ys(k) family membership **)
            claim HykGfam : exists alpha:set, alpha :e J /\ apply_fun ys k :e apply_fun Gfam alpha.
            { exact (HysGfam k (ordsuccI2 k)). }
            (** Case split on c: either c = e or c is a word product **)
            claim HmultcykG : apply_fun mult (c, apply_fun ys k) :e G.
            { exact (group_source_mult_closure G mult e inv Hgrp c (apply_fun ys k) HcG HykG). }
            apply (SepI G WordProd (apply_fun mult (c, apply_fun ys k)) HmultcykG).
            apply (HcWP (WordProd (apply_fun mult (c, apply_fun ys k)))).
            { (** c = e: mult(e, ys(k)) = ys(k), which is a word product **)
              assume Hce : c = e.
              claim Hlid : apply_fun mult (e, apply_fun ys k) = apply_fun ys k.
              { exact (andEL
                  (apply_fun mult (e, apply_fun ys k) = apply_fun ys k)
                  (apply_fun mult (apply_fun ys k, e) = apply_fun ys k)
                  (Hid (apply_fun ys k) HykG)). }
              claim Heq : apply_fun mult (c, apply_fun ys k) = apply_fun ys k.
              { rewrite Hce. exact Hlid. }
              prove WordProd (apply_fun mult (c, apply_fun ys k)).
              rewrite Heq.
              (** ys(k) is a length-1 word product: use word_product_right_append_in_generated with n=0 **)
              apply (HykGfam (WordProd (apply_fun ys k))).
              let alpha. assume Halpha_props : alpha :e J /\ apply_fun ys k :e apply_fun Gfam alpha.
              claim HalphaJ : alpha :e J.
              { exact (andEL (alpha :e J) (apply_fun ys k :e apply_fun Gfam alpha) Halpha_props). }
              claim HykGfam_al : apply_fun ys k :e apply_fun Gfam alpha.
              { exact (andER (alpha :e J) (apply_fun ys k :e apply_fun Gfam alpha) Halpha_props). }
              claim Happ0 : exists n' xs':set, n' :e omega /\ n' <> 0 /\
                function_on xs' n' G /\
                (forall i:set, i :e n' -> exists a:set, a :e J /\ apply_fun xs' i :e apply_fun Gfam a) /\
                apply_fun mult (word_product mult e Empty 0, apply_fun ys k) = word_product mult e xs' n'.
              { claim Hvac1 : forall i:set, i :e 0 -> apply_fun Empty i :e G.
                { let i. assume Hi : i :e 0. exact (EmptyE i Hi (apply_fun Empty i :e G)). }
                claim Hvac2 : forall i:set, i :e 0 -> exists a:set, a :e J /\ apply_fun Empty i :e apply_fun Gfam a.
                { let i. assume Hi : i :e 0. exact (EmptyE i Hi (exists a:set, a :e J /\ apply_fun Empty i :e apply_fun Gfam a)). }
                exact (word_product_right_append_in_generated G mult e inv J Gfam 0 Empty (apply_fun ys k) alpha
                  Hgrp (nat_p_omega 0 nat_0) Hvac1 Hvac2 HalphaJ HykGfam_al HykG). }
              apply (Happ0 (WordProd (apply_fun ys k))).
              let n'. assume Hex_xs' : exists xs':set, n' :e omega /\ n' <> 0 /\
                function_on xs' n' G /\
                (forall i:set, i :e n' -> exists a:set, a :e J /\ apply_fun xs' i :e apply_fun Gfam a) /\
                apply_fun mult (word_product mult e Empty 0, apply_fun ys k) = word_product mult e xs' n'.
              apply (Hex_xs' (WordProd (apply_fun ys k))).
              let xs'. assume Hprops : n' :e omega /\ n' <> 0 /\
                function_on xs' n' G /\
                (forall i:set, i :e n' -> exists a:set, a :e J /\ apply_fun xs' i :e apply_fun Gfam a) /\
                apply_fun mult (word_product mult e Empty 0, apply_fun ys k) = word_product mult e xs' n'.
              apply (and5E
                (n' :e omega)
                (n' <> 0)
                (function_on xs' n' G)
                (forall i:set, i :e n' -> exists a:set, a :e J /\ apply_fun xs' i :e apply_fun Gfam a)
                (apply_fun mult (word_product mult e Empty 0, apply_fun ys k) = word_product mult e xs' n')
                Hprops).
              assume Hn'O : n' :e omega.
              assume Hn'ne0 : n' <> 0.
              assume Hxs'Fn : function_on xs' n' G.
              assume Hxs'Gfam : forall i:set, i :e n' -> exists a:set, a :e J /\ apply_fun xs' i :e apply_fun Gfam a.
              assume Hyk_eq : apply_fun mult (word_product mult e Empty 0, apply_fun ys k) = word_product mult e xs' n'.
              (** word_product(Empty, 0) = e **)
              claim Hwp0 : word_product mult e Empty 0 = e.
              { exact (nat_primrec_0 e (fun i r => apply_fun mult (r, apply_fun Empty i))). }
              claim Hlid2 : apply_fun mult (e, apply_fun ys k) = apply_fun ys k.
              { exact (andEL
                  (apply_fun mult (e, apply_fun ys k) = apply_fun ys k)
                  (apply_fun mult (apply_fun ys k, e) = apply_fun ys k)
                  (Hid (apply_fun ys k) HykG)). }
              claim Hyk_is_wp : apply_fun ys k = word_product mult e xs' n'.
              { rewrite <- Hyk_eq. rewrite Hwp0. symmetry. exact Hlid2. }
              prove apply_fun ys k = e \/
                exists n:set, n :e omega /\ n <> 0 /\
                exists xs:set, function_on xs n G /\
                  (forall i:set, i :e n ->
                    exists alpha:set, alpha :e J /\ apply_fun xs i :e apply_fun Gfam alpha) /\
                  apply_fun ys k = word_product mult e xs n.
              apply orIR.
              witness n'. apply andI. { apply andI. { exact Hn'O. } { exact Hn'ne0. } }
              { witness xs'. apply andI. { apply andI. { exact Hxs'Fn. } { exact Hxs'Gfam. } }
                { exact Hyk_is_wp. } }
            }
            { (** c is a word product of length m: apply word_product_right_append_in_generated **)
              assume Hex : exists m:set, m :e omega /\ m <> 0 /\
                exists zs:set, function_on zs m G /\
                  (forall i:set, i :e m ->
                    exists alpha:set, alpha :e J /\ apply_fun zs i :e apply_fun Gfam alpha) /\
                  c = word_product mult e zs m.
              apply (Hex (WordProd (apply_fun mult (c, apply_fun ys k)))).
              let m. assume Hm_ex : m :e omega /\ m <> 0 /\
                exists zs:set, function_on zs m G /\
                  (forall i:set, i :e m ->
                    exists alpha:set, alpha :e J /\ apply_fun zs i :e apply_fun Gfam alpha) /\
                  c = word_product mult e zs m.
              apply (and3E (m :e omega) (m <> 0)
                (exists zs:set, function_on zs m G /\
                  (forall i:set, i :e m ->
                    exists alpha:set, alpha :e J /\ apply_fun zs i :e apply_fun Gfam alpha) /\
                  c = word_product mult e zs m)
                Hm_ex).
              assume HmO : m :e omega. assume _ : m <> 0.
              assume Hrest_m : exists zs:set, function_on zs m G /\
                (forall i:set, i :e m ->
                  exists alpha:set, alpha :e J /\ apply_fun zs i :e apply_fun Gfam alpha) /\
                c = word_product mult e zs m.
              apply (Hrest_m (WordProd (apply_fun mult (c, apply_fun ys k)))).
              let zs. assume Hzs_props : function_on zs m G /\
                (forall i:set, i :e m ->
                  exists alpha:set, alpha :e J /\ apply_fun zs i :e apply_fun Gfam alpha) /\
                c = word_product mult e zs m.
              apply (and3E (function_on zs m G)
                (forall i:set, i :e m ->
                  exists alpha:set, alpha :e J /\ apply_fun zs i :e apply_fun Gfam alpha)
                (c = word_product mult e zs m)
                Hzs_props).
              assume HzsFn : function_on zs m G.
              assume HzsGfam : forall i:set, i :e m ->
                exists alpha:set, alpha :e J /\ apply_fun zs i :e apply_fun Gfam alpha.
              assume Hceq : c = word_product mult e zs m.
              (** Apply word_product_right_append_in_generated **)
              apply (HykGfam (WordProd (apply_fun mult (c, apply_fun ys k)))).
              let alpha. assume Halpha_props : alpha :e J /\ apply_fun ys k :e apply_fun Gfam alpha.
              claim HalphaJ : alpha :e J.
              { exact (andEL (alpha :e J) (apply_fun ys k :e apply_fun Gfam alpha) Halpha_props). }
              claim HykGfam_al : apply_fun ys k :e apply_fun Gfam alpha.
              { exact (andER (alpha :e J) (apply_fun ys k :e apply_fun Gfam alpha) Halpha_props). }
              claim Happ : exists n' xs':set, n' :e omega /\ n' <> 0 /\
                function_on xs' n' G /\
                (forall i:set, i :e n' -> exists a:set, a :e J /\ apply_fun xs' i :e apply_fun Gfam a) /\
                apply_fun mult (word_product mult e zs m, apply_fun ys k) = word_product mult e xs' n'.
              { exact (word_product_right_append_in_generated G mult e inv J Gfam m zs (apply_fun ys k) alpha
                  Hgrp HmO HzsFn HzsGfam HalphaJ HykGfam_al HykG). }
              apply (Happ (WordProd (apply_fun mult (c, apply_fun ys k)))).
              let n'. assume Hex_xs2 : exists xs':set, n' :e omega /\ n' <> 0 /\
                function_on xs' n' G /\
                (forall i:set, i :e n' -> exists a:set, a :e J /\ apply_fun xs' i :e apply_fun Gfam a) /\
                apply_fun mult (word_product mult e zs m, apply_fun ys k) = word_product mult e xs' n'.
              apply (Hex_xs2 (WordProd (apply_fun mult (c, apply_fun ys k)))).
              let xs'. assume Hres : n' :e omega /\ n' <> 0 /\
                function_on xs' n' G /\
                (forall i:set, i :e n' -> exists a:set, a :e J /\ apply_fun xs' i :e apply_fun Gfam a) /\
                apply_fun mult (word_product mult e zs m, apply_fun ys k) = word_product mult e xs' n'.
              apply (and5E
                (n' :e omega)
                (n' <> 0)
                (function_on xs' n' G)
                (forall i:set, i :e n' -> exists a:set, a :e J /\ apply_fun xs' i :e apply_fun Gfam a)
                (apply_fun mult (word_product mult e zs m, apply_fun ys k) = word_product mult e xs' n')
                Hres).
              assume Hn'O : n' :e omega.
              assume Hn'ne0 : n' <> 0.
              assume Hxs'Fn : function_on xs' n' G.
              assume Hxs'Gfam : forall i:set, i :e n' -> exists a:set, a :e J /\ apply_fun xs' i :e apply_fun Gfam a.
              assume Hres_eq : apply_fun mult (word_product mult e zs m, apply_fun ys k) = word_product mult e xs' n'.
              claim Hfinal_eq : apply_fun mult (c, apply_fun ys k) = word_product mult e xs' n'.
              { rewrite Hceq. exact Hres_eq. }
              prove apply_fun mult (c, apply_fun ys k) = e \/
                exists n:set, n :e omega /\ n <> 0 /\
                exists xs:set, function_on xs n G /\
                  (forall i:set, i :e n ->
                    exists alpha:set, alpha :e J /\ apply_fun xs i :e apply_fun Gfam alpha) /\
                  apply_fun mult (c, apply_fun ys k) = word_product mult e xs n.
              apply orIR.
              witness n'. apply andI. { apply andI. { exact Hn'O. } { exact Hn'ne0. } }
              { witness xs'. apply andI. { apply andI. { exact Hxs'Fn. } { exact Hxs'Gfam. } }
                { exact Hfinal_eq. } }
            }
          }
        }
        (** Now prove the main claim using Haux **)
        let a b. assume HaS : a :e S. assume HbS : b :e S.
        claim HaG : a :e G. { exact (HSsubG a HaS). }
        claim HbG : b :e G. { exact (HSsubG b HbS). }
        claim HbWP : WordProd b. { exact (SepE2 G WordProd b HbS). }
        claim HabG : apply_fun mult (a, b) :e G.
        { exact (group_source_mult_closure G mult e inv Hgrp a b HaG HbG). }
        apply (SepI G WordProd (apply_fun mult (a, b)) HabG).
        apply (HbWP (WordProd (apply_fun mult (a, b)))).
        { (** b = e **)
          assume Hbe : b = e.
          claim Hrid : apply_fun mult (a, e) = a.
          { exact (andER
              (apply_fun mult (e, a) = a)
              (apply_fun mult (a, e) = a)
              (Hid a HaG)). }
          claim Hab_eq : apply_fun mult (a, b) = a.
          { rewrite Hbe. exact Hrid. }
          prove WordProd (apply_fun mult (a, b)).
          rewrite Hab_eq. exact (SepE2 G WordProd a HaS).
        }
        { (** b is a word product **)
          assume Hex : exists n:set, n :e omega /\ n <> 0 /\
            exists ys:set, function_on ys n G /\
              (forall i:set, i :e n ->
                exists alpha:set, alpha :e J /\ apply_fun ys i :e apply_fun Gfam alpha) /\
              b = word_product mult e ys n.
          apply (Hex (WordProd (apply_fun mult (a, b)))).
          let n. assume Hn_ex : n :e omega /\ n <> 0 /\
            exists ys:set, function_on ys n G /\
              (forall i:set, i :e n ->
                exists alpha:set, alpha :e J /\ apply_fun ys i :e apply_fun Gfam alpha) /\
              b = word_product mult e ys n.
          apply (and3E (n :e omega) (n <> 0)
            (exists ys:set, function_on ys n G /\
              (forall i:set, i :e n ->
                exists alpha:set, alpha :e J /\ apply_fun ys i :e apply_fun Gfam alpha) /\
              b = word_product mult e ys n)
            Hn_ex).
          assume HnO : n :e omega. assume _ : n <> 0.
          assume Hrest : exists ys:set, function_on ys n G /\
            (forall i:set, i :e n ->
              exists alpha:set, alpha :e J /\ apply_fun ys i :e apply_fun Gfam alpha) /\
            b = word_product mult e ys n.
          apply (Hrest (WordProd (apply_fun mult (a, b)))).
          let ys. assume Hys_props : function_on ys n G /\
            (forall i:set, i :e n ->
              exists alpha:set, alpha :e J /\ apply_fun ys i :e apply_fun Gfam alpha) /\
            b = word_product mult e ys n.
          apply (and3E (function_on ys n G)
            (forall i:set, i :e n ->
              exists alpha:set, alpha :e J /\ apply_fun ys i :e apply_fun Gfam alpha)
            (b = word_product mult e ys n)
            Hys_props).
          assume HysFn : function_on ys n G.
          assume HysGfam : forall i:set, i :e n ->
            exists alpha:set, alpha :e J /\ apply_fun ys i :e apply_fun Gfam alpha.
          assume Hbeq : b = word_product mult e ys n.
          prove WordProd (apply_fun mult (a, b)).
          rewrite Hbeq.
          exact (SepE2 G WordProd (apply_fun mult (a, word_product mult e ys n))
            (Haux n (omega_nat_p n HnO) ys HysFn HysGfam a HaS)).
        }
      }
      claim HSinvClosed : forall a:set, a :e S -> apply_fun inv a :e S.
      {
        (** Helper: Gfam(alpha) is a subgroup for each alpha **)
        claim HGfam_sub : forall alpha:set, alpha :e J ->
          subgroup_of (apply_fun Gfam alpha) G mult e inv.
        { let alpha. assume HalphaJ : alpha :e J.
          claim HgensAlphaG : apply_fun gens alpha :e G. { exact (Hgens alpha HalphaJ). }
          claim HapGfam : apply_fun Gfam alpha =
            {g :e G | exists n:set, n :e int /\
              ((n :e omega /\ g = group_power_nat mult e (apply_fun gens alpha) n) \/
               (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
                g = group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m)))}.
          { exact (apply_fun_graph J (fun alpha:set =>
              {g :e G | exists n:set, n :e int /\
                ((n :e omega /\ g = group_power_nat mult e (apply_fun gens alpha) n) \/
                 (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
                  g = group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m)))})
              alpha HalphaJ). }
          rewrite HapGfam.
          exact (cyclic_generator_subgroup_is_subgroup G mult e inv (apply_fun gens alpha) Hgrp HgensAlphaG). }
        (** Helper: inv(e) = e **)
        claim Hinv_e : apply_fun inv e = e.
        { claim HinveG : apply_fun inv e :e G. { exact (HinvFn e HeG). }
          claim Hlid_inve : apply_fun mult (e, apply_fun inv e) = apply_fun inv e.
          { exact (andEL
              (apply_fun mult (e, apply_fun inv e) = apply_fun inv e)
              (apply_fun mult (apply_fun inv e, e) = apply_fun inv e)
              (Hid (apply_fun inv e) HinveG)). }
          claim Hmult_e_inve : apply_fun mult (e, apply_fun inv e) = e.
          { exact (andEL
              (apply_fun mult (e, apply_fun inv e) = e)
              (apply_fun mult (apply_fun inv e, e) = e)
              (Hinv e HeG)). }
          exact (eq_i_tra (apply_fun inv e)
            (apply_fun mult (e, apply_fun inv e)) e
            (eq_symm (apply_fun mult (e, apply_fun inv e)) (apply_fun inv e) Hlid_inve)
            Hmult_e_inve). }
        (** Helper: anti-homomorphism inv(mult(a,b)) = mult(inv(b), inv(a)) **)
        claim Hinv_mult : forall a b:set, a :e G -> b :e G ->
          apply_fun inv (apply_fun mult (a, b)) = apply_fun mult (apply_fun inv b, apply_fun inv a).
        { let a b. assume HaG : a :e G. assume HbG : b :e G.
          claim HabG : apply_fun mult (a, b) :e G.
          { exact (group_source_mult_closure G mult e inv Hgrp a b HaG HbG). }
          claim HinvAG : apply_fun inv a :e G. { exact (HinvFn a HaG). }
          claim HinvBG : apply_fun inv b :e G. { exact (HinvFn b HbG). }
          claim HinvABG : apply_fun inv (apply_fun mult (a, b)) :e G.
          { exact (HinvFn (apply_fun mult (a, b)) HabG). }
          claim HprodInvG : apply_fun mult (apply_fun inv b, apply_fun inv a) :e G.
          { exact (group_source_mult_closure G mult e inv Hgrp
              (apply_fun inv b) (apply_fun inv a) HinvBG HinvAG). }
          (** Show mult(mult(a,b), mult(inv(b), inv(a))) = e **)
          claim Hprod_e : apply_fun mult (apply_fun mult (a, b), apply_fun mult (apply_fun inv b, apply_fun inv a)) = e.
          { rewrite (Hassoc a b (apply_fun mult (apply_fun inv b, apply_fun inv a))
              HaG HbG HprodInvG).
            rewrite <- (Hassoc b (apply_fun inv b) (apply_fun inv a)
              HbG HinvBG HinvAG).
            rewrite (andEL (apply_fun mult (b, apply_fun inv b) = e)
              (apply_fun mult (apply_fun inv b, b) = e) (Hinv b HbG)).
            rewrite (andEL (apply_fun mult (e, apply_fun inv a) = apply_fun inv a)
              (apply_fun mult (apply_fun inv a, e) = apply_fun inv a)
              (Hid (apply_fun inv a) HinvAG)).
            exact (andEL (apply_fun mult (a, apply_fun inv a) = e)
              (apply_fun mult (apply_fun inv a, a) = e) (Hinv a HaG)). }
          (** Use group_left_inv_solve to get mult(inv(b), inv(a)) = inv(mult(a,b)) **)
          claim Hinvprod_symm : apply_fun mult (apply_fun inv b, apply_fun inv a) =
            apply_fun inv (apply_fun mult (a, b)).
          { apply (group_left_inv_solve G mult inv e
              (apply_fun inv (apply_fun mult (a, b)))
              (apply_fun mult (apply_fun inv b, apply_fun inv a))
              HmultFn HinvFn HeG Hassoc Hid Hinv
              HinvABG HprodInvG).
            rewrite (group_inv_inv G mult inv e (apply_fun mult (a, b))
              HmultFn HinvFn HeG Hassoc Hid Hinv HabG).
            exact Hprod_e. }
          exact (eq_symm
            (apply_fun mult (apply_fun inv b, apply_fun inv a))
            (apply_fun inv (apply_fun mult (a, b)))
            Hinvprod_symm). }
        (** Helper: inv of word product of length k is in S, by induction on k **)
        claim Haux : forall k:set, nat_p k ->
          forall ys:set, (forall i:set, i :e k -> apply_fun ys i :e G) ->
          (forall i:set, i :e k ->
            exists alpha:set, alpha :e J /\ apply_fun ys i :e apply_fun Gfam alpha) ->
          apply_fun inv (word_product mult e ys k) :e S.
        {
          apply nat_ind.
          { (** Base case: k = 0 **)
            let ys. assume _ _.
            claim Hwp0 : word_product mult e ys 0 = e.
            { exact (nat_primrec_0 e (fun i r => apply_fun mult (r, apply_fun ys i))). }
            rewrite Hwp0.
            rewrite Hinv_e.
            exact HeS.
          }
          { (** Step case: k -> ordsucc k **)
            let k. assume Hk_nat : nat_p k.
            assume HIH : forall ys:set, (forall i:set, i :e k -> apply_fun ys i :e G) ->
              (forall i:set, i :e k ->
                exists alpha:set, alpha :e J /\ apply_fun ys i :e apply_fun Gfam alpha) ->
              apply_fun inv (word_product mult e ys k) :e S.
            let ys. assume HysG : forall i:set, i :e ordsucc k -> apply_fun ys i :e G.
            assume HysGfam : forall i:set, i :e ordsucc k ->
              exists alpha:set, alpha :e J /\ apply_fun ys i :e apply_fun Gfam alpha.
            claim HkO : k :e omega. { exact (nat_p_omega k Hk_nat). }
            (** word_product(ys, ordsucc k) = mult(word_product(ys, k), ys(k)) **)
            claim Hwps : word_product mult e ys (ordsucc k) =
              apply_fun mult (word_product mult e ys k, apply_fun ys k).
            { exact (word_product_succ mult e ys k Hk_nat). }
            claim HykG : apply_fun ys k :e G.
            { exact (HysG k (ordsuccI2 k)). }
            claim HwpkG : word_product mult e ys k :e G.
            { exact (word_product_in_G_group G mult e inv k ys Hgrp Hk_nat
                (fun i Hi => HysG i (ordsuccI1 k i Hi))). }
            (** inv(mult(wp, ys(k))) = mult(inv(ys(k)), inv(wp)) by anti-hom **)
            claim Hinv_eq : apply_fun inv (word_product mult e ys (ordsucc k)) =
              apply_fun mult (apply_fun inv (apply_fun ys k), apply_fun inv (word_product mult e ys k)).
            { rewrite Hwps.
              exact (Hinv_mult (word_product mult e ys k) (apply_fun ys k) HwpkG HykG). }
            rewrite Hinv_eq.
            (** inv(ys(k)) :e S **)
            claim HykGfam : exists alpha:set, alpha :e J /\ apply_fun ys k :e apply_fun Gfam alpha.
            { exact (HysGfam k (ordsuccI2 k)). }
            claim HinvYkG : apply_fun inv (apply_fun ys k) :e G.
            { exact (HinvFn (apply_fun ys k) HykG). }
            claim HinvYkS : apply_fun inv (apply_fun ys k) :e S.
            { apply (HykGfam (apply_fun inv (apply_fun ys k) :e S)).
              let alpha. assume Halpha_props : alpha :e J /\ apply_fun ys k :e apply_fun Gfam alpha.
              claim HalphaJ : alpha :e J.
              { exact (andEL (alpha :e J) (apply_fun ys k :e apply_fun Gfam alpha) Halpha_props). }
              claim HykGfamA : apply_fun ys k :e apply_fun Gfam alpha.
              { exact (andER (alpha :e J) (apply_fun ys k :e apply_fun Gfam alpha) Halpha_props). }
              claim HinvYkGfamA : apply_fun inv (apply_fun ys k) :e apply_fun Gfam alpha.
              { exact (subgroup_of_inv_closed (apply_fun Gfam alpha) G mult e inv (apply_fun ys k)
                  (HGfam_sub alpha HalphaJ) HykGfamA). }
              (** inv(ys(k)) is a word product of length 1 via word_product_right_append_in_generated with n=0 **)
              claim Happ0 : exists n' xs':set, n' :e omega /\ n' <> 0 /\
                function_on xs' n' G /\
                (forall i:set, i :e n' -> exists a:set, a :e J /\ apply_fun xs' i :e apply_fun Gfam a) /\
                apply_fun mult (word_product mult e Empty 0, apply_fun inv (apply_fun ys k)) = word_product mult e xs' n'.
              { claim Hvac1 : forall i:set, i :e 0 -> apply_fun Empty i :e G.
                { let i. assume Hi : i :e 0. exact (EmptyE i Hi (apply_fun Empty i :e G)). }
                claim Hvac2 : forall i:set, i :e 0 -> exists a:set, a :e J /\ apply_fun Empty i :e apply_fun Gfam a.
                { let i. assume Hi : i :e 0. exact (EmptyE i Hi (exists a:set, a :e J /\ apply_fun Empty i :e apply_fun Gfam a)). }
                exact (word_product_right_append_in_generated G mult e inv J Gfam 0 Empty (apply_fun inv (apply_fun ys k)) alpha
                  Hgrp (nat_p_omega 0 nat_0) Hvac1 Hvac2 HalphaJ HinvYkGfamA HinvYkG). }
              apply (Happ0 (apply_fun inv (apply_fun ys k) :e S)).
              let n'. assume Hex_xs' : exists xs':set, n' :e omega /\ n' <> 0 /\
                function_on xs' n' G /\
                (forall i:set, i :e n' -> exists a:set, a :e J /\ apply_fun xs' i :e apply_fun Gfam a) /\
                apply_fun mult (word_product mult e Empty 0, apply_fun inv (apply_fun ys k)) = word_product mult e xs' n'.
              apply (Hex_xs' (apply_fun inv (apply_fun ys k) :e S)).
              let xs'. assume Hprops : n' :e omega /\ n' <> 0 /\
                function_on xs' n' G /\
                (forall i:set, i :e n' -> exists a:set, a :e J /\ apply_fun xs' i :e apply_fun Gfam a) /\
                apply_fun mult (word_product mult e Empty 0, apply_fun inv (apply_fun ys k)) = word_product mult e xs' n'.
              apply (and5E
                (n' :e omega)
                (n' <> 0)
                (function_on xs' n' G)
                (forall i:set, i :e n' -> exists a:set, a :e J /\ apply_fun xs' i :e apply_fun Gfam a)
                (apply_fun mult (word_product mult e Empty 0, apply_fun inv (apply_fun ys k)) = word_product mult e xs' n')
                Hprops).
              assume Hn'O : n' :e omega.
              assume Hn'ne0 : n' <> 0.
              assume Hxs'Fn : function_on xs' n' G.
              assume Hxs'Gfam : forall i:set, i :e n' -> exists a:set, a :e J /\ apply_fun xs' i :e apply_fun Gfam a.
              assume Hinvyk_eq : apply_fun mult (word_product mult e Empty 0, apply_fun inv (apply_fun ys k)) = word_product mult e xs' n'.
              (** word_product(Empty, 0) = e **)
              claim Hwp0 : word_product mult e Empty 0 = e.
              { exact (nat_primrec_0 e (fun i r => apply_fun mult (r, apply_fun Empty i))). }
              claim Hlid_invyk : apply_fun mult (e, apply_fun inv (apply_fun ys k)) = apply_fun inv (apply_fun ys k).
              { exact (andEL
                  (apply_fun mult (e, apply_fun inv (apply_fun ys k)) = apply_fun inv (apply_fun ys k))
                  (apply_fun mult (apply_fun inv (apply_fun ys k), e) = apply_fun inv (apply_fun ys k))
                  (Hid (apply_fun inv (apply_fun ys k)) HinvYkG)). }
              claim Hinvyk_is_wp : apply_fun inv (apply_fun ys k) = word_product mult e xs' n'.
              { rewrite <- Hinvyk_eq. rewrite Hwp0. symmetry. exact Hlid_invyk. }
              apply (SepI G WordProd (apply_fun inv (apply_fun ys k)) HinvYkG).
              prove apply_fun inv (apply_fun ys k) = e \/
                exists n:set, n :e omega /\ n <> 0 /\
                exists xs:set, function_on xs n G /\
                  (forall i:set, i :e n ->
                    exists alpha:set, alpha :e J /\ apply_fun xs i :e apply_fun Gfam alpha) /\
                  apply_fun inv (apply_fun ys k) = word_product mult e xs n.
              apply orIR.
              witness n'. apply andI. { apply andI. { exact Hn'O. } { exact Hn'ne0. } }
              { witness xs'. apply andI. { apply andI. { exact Hxs'Fn. } { exact Hxs'Gfam. } }
                { exact Hinvyk_is_wp. } }
            }
            (** inv(wp(ys,k)) :e S by IH **)
            claim HysG_k : forall i:set, i :e k -> apply_fun ys i :e G.
            { let i. assume Hin : i :e k. exact (HysG i (ordsuccI1 k i Hin)). }
            claim HysGfam_k : forall i:set, i :e k ->
              exists alpha:set, alpha :e J /\ apply_fun ys i :e apply_fun Gfam alpha.
            { let i. assume Hin : i :e k. exact (HysGfam i (ordsuccI1 k i Hin)). }
            claim HinvWpS : apply_fun inv (word_product mult e ys k) :e S.
            { exact (HIH ys HysG_k HysGfam_k). }
            (** mult(inv(ys(k)), inv(wp(ys,k))) :e S by HSmultClosed **)
            exact (HSmultClosed (apply_fun inv (apply_fun ys k)) (apply_fun inv (word_product mult e ys k))
              HinvYkS HinvWpS).
          }
        }
        (** Main case analysis on a **)
        let a. assume HaS : a :e S.
        claim HaG : a :e G. { exact (HSsubG a HaS). }
        claim HinvAG : apply_fun inv a :e G. { exact (HinvFn a HaG). }
        claim HWordProdA : WordProd a. { exact (SepE2 G WordProd a HaS). }
        apply (SepI G WordProd (apply_fun inv a) HinvAG).
        apply (HWordProdA (WordProd (apply_fun inv a))).
        { (** a = e **)
          assume Hae : a = e.
          claim Hinva_eq : apply_fun inv a = e. { rewrite Hae. exact Hinv_e. }
          prove WordProd (apply_fun inv a).
          rewrite Hinva_eq.
          prove e = e \/
            exists n:set, n :e omega /\ n <> 0 /\
            exists xs:set, function_on xs n G /\
              (forall i:set, i :e n ->
                exists alpha:set, alpha :e J /\ apply_fun xs i :e apply_fun Gfam alpha) /\
              e = word_product mult e xs n.
          apply orIL. reflexivity.
        }
        { (** a is a word product **)
          assume Hex : exists n:set, n :e omega /\ n <> 0 /\
            exists xs:set, function_on xs n G /\
              (forall i:set, i :e n ->
                exists alpha:set, alpha :e J /\ apply_fun xs i :e apply_fun Gfam alpha) /\
              a = word_product mult e xs n.
          apply (Hex (WordProd (apply_fun inv a))).
          let n. assume Hn_ex : n :e omega /\ n <> 0 /\
            exists xs:set, function_on xs n G /\
              (forall i:set, i :e n ->
                exists alpha:set, alpha :e J /\ apply_fun xs i :e apply_fun Gfam alpha) /\
              a = word_product mult e xs n.
          apply (and3E (n :e omega) (n <> 0)
            (exists xs:set, function_on xs n G /\
              (forall i:set, i :e n ->
                exists alpha:set, alpha :e J /\ apply_fun xs i :e apply_fun Gfam alpha) /\
              a = word_product mult e xs n)
            Hn_ex).
          assume HnO : n :e omega. assume _ : n <> 0.
          assume Hrest : exists xs:set, function_on xs n G /\
            (forall i:set, i :e n ->
              exists alpha:set, alpha :e J /\ apply_fun xs i :e apply_fun Gfam alpha) /\
            a = word_product mult e xs n.
          apply (Hrest (WordProd (apply_fun inv a))).
          let xs. assume Hxs_props : function_on xs n G /\
            (forall i:set, i :e n ->
              exists alpha:set, alpha :e J /\ apply_fun xs i :e apply_fun Gfam alpha) /\
            a = word_product mult e xs n.
          apply (and3E (function_on xs n G)
            (forall i:set, i :e n ->
              exists alpha:set, alpha :e J /\ apply_fun xs i :e apply_fun Gfam alpha)
            (a = word_product mult e xs n)
            Hxs_props).
          assume HxsFn : function_on xs n G.
          assume HxsGfam : forall i:set, i :e n ->
            exists alpha:set, alpha :e J /\ apply_fun xs i :e apply_fun Gfam alpha.
          assume Haeq : a = word_product mult e xs n.
          prove WordProd (apply_fun inv a).
          rewrite Haeq.
          exact (SepE2 G WordProd (apply_fun inv (word_product mult e xs n))
            (Haux n (omega_nat_p n HnO) xs HxsFn HxsGfam)).
        }
      }
      (** S is a subgroup **)
      claim HSsub : subgroup_of S G mult e inv.
      { prove S c= G /\ e :e S /\
          (forall a b:set, a :e S -> b :e S -> apply_fun mult (a, b) :e S) /\
          (forall a:set, a :e S -> apply_fun inv a :e S).
        apply andI.
        { apply andI.
          { apply andI. { exact HSsubG. } { exact HeS. } }
          { exact HSmultClosed. } }
        { exact HSinvClosed. } }
      claim HSgrp : group_structure S mult e inv.
      { exact (subgroup_inherits_group_structure G mult e inv S Hgrp HSsub). }
      (** Each generator gens(alpha) is in S **)
      set ysS := graph J (fun alpha:set => apply_fun gens alpha).
      claim HgenS : function_on ysS J S.
      { let alpha. assume HalphaJ : alpha :e J.
        rewrite (apply_fun_graph J (fun alpha:set => apply_fun gens alpha) alpha HalphaJ).
        claim HgaG : apply_fun gens alpha :e G. { exact (Hgens alpha HalphaJ). }
        claim HgaGfam : apply_fun gens alpha :e apply_fun Gfam alpha.
        { exact (lemma69_1_generator_in_factor_family G mult e inv J gens alpha Hgrp Hgens HalphaJ). }
        apply (SepI G WordProd (apply_fun gens alpha) HgaG).
        apply orIR.
        witness 1. apply andI.
        { apply andI. { exact (nat_p_omega 1 nat_1). } { exact (neq_ordsucc_0 0). } }
        { witness (graph 1 (fun i:set => apply_fun gens alpha)).
          apply andI.
          { apply andI.
            { let i. assume Hi : i :e 1.
              rewrite (apply_fun_graph 1 (fun i:set => apply_fun gens alpha) i Hi).
              exact HgaG. }
            { let i. assume Hi : i :e 1.
              rewrite (apply_fun_graph 1 (fun i:set => apply_fun gens alpha) i Hi).
              witness alpha. apply andI. { exact HalphaJ. } { exact HgaGfam. } } }
          { (** gens(alpha) = word_product of length 1 **)
            claim Hwp1 : word_product mult e (graph 1 (fun i:set => apply_fun gens alpha)) 1 =
              apply_fun mult (word_product mult e (graph 1 (fun i:set => apply_fun gens alpha)) 0,
                apply_fun (graph 1 (fun i:set => apply_fun gens alpha)) 0).
            { exact (word_product_succ mult e (graph 1 (fun i:set => apply_fun gens alpha)) 0 nat_0). }
            claim Hwp0 : word_product mult e (graph 1 (fun i:set => apply_fun gens alpha)) 0 = e.
            { exact (nat_primrec_0 e (fun i r => apply_fun mult (r, apply_fun (graph 1 (fun i:set => apply_fun gens alpha)) i))). }
            claim Hap0 : apply_fun (graph 1 (fun i:set => apply_fun gens alpha)) 0 = apply_fun gens alpha.
            { exact (apply_fun_graph 1 (fun i:set => apply_fun gens alpha) 0 (ordsuccI2 0)). }
            claim Hlid : apply_fun mult (e, apply_fun gens alpha) = apply_fun gens alpha.
            { apply (Hid (apply_fun gens alpha) HgaG
                (apply_fun mult (e, apply_fun gens alpha) = apply_fun gens alpha)).
              assume H1 H2. exact H1. }
            rewrite Hwp1. rewrite Hwp0. rewrite Hap0. symmetry. exact Hlid. } } }
      (** Apply extension property with H = S **)
      claim HextS : exists h:set,
        group_homomorphism G mult S mult h /\
        (forall alpha:set, alpha :e J ->
          apply_fun h (apply_fun gens alpha) = apply_fun ysS alpha) /\
        (forall h':set, group_homomorphism G mult S mult h' ->
          (forall alpha:set, alpha :e J ->
            apply_fun h' (apply_fun gens alpha) = apply_fun ysS alpha) ->
          forall y:set, y :e G -> apply_fun h' y = apply_fun h y).
      { exact (Hext S mult e inv HSgrp ysS HgenS). }
      apply (HextS (WordProd x)).
      let h_S.
      assume Hh_S.
      claim Hh_S_hom : group_homomorphism G mult S mult h_S.
      { apply (Hh_S (group_homomorphism G mult S mult h_S)).
        assume HAB _. apply (HAB (group_homomorphism G mult S mult h_S)).
        assume HA _. exact HA. }
      claim Hh_S_fn : function_on h_S G S.
      { exact (group_homomorphism_function_on G mult S mult h_S Hh_S_hom). }
      claim Hh_S_fn_GG : function_on h_S G G.
      { let a. assume HaG : a :e G. exact (HSsubG (apply_fun h_S a) (Hh_S_fn a HaG)). }
      claim Hh_S_gens : forall alpha:set, alpha :e J ->
        apply_fun h_S (apply_fun gens alpha) = apply_fun gens alpha.
      { let alpha. assume HalphaJ : alpha :e J.
        claim Hraw : apply_fun h_S (apply_fun gens alpha) = apply_fun ysS alpha.
        { apply (Hh_S (apply_fun h_S (apply_fun gens alpha) = apply_fun ysS alpha)).
          assume HAB _. apply (HAB (apply_fun h_S (apply_fun gens alpha) = apply_fun ysS alpha)).
          assume _ HB. exact (HB alpha HalphaJ). }
        rewrite Hraw.
        exact (apply_fun_graph J (fun alpha:set => apply_fun gens alpha) alpha HalphaJ). }
      (** h_S as group_homomorphism G mult G mult **)
      claim Hh_S_hom_GG : group_homomorphism G mult G mult h_S.
      { prove function_on h_S G G /\
          (forall a b:set, a :e G -> b :e G ->
            apply_fun h_S (apply_fun mult (a, b)) = apply_fun mult (apply_fun h_S a, apply_fun h_S b)).
        apply andI. { exact Hh_S_fn_GG. }
        { let a b. assume HaG HbG.
          exact (group_homomorphism_mult_rule G mult S mult h_S a b Hh_S_hom HaG HbG). } }
      (** Apply extension property with H = G to get uniqueness **)
      claim HextG : exists h:set,
        group_homomorphism G mult G mult h /\
        (forall alpha:set, alpha :e J ->
          apply_fun h (apply_fun gens alpha) = apply_fun gens alpha) /\
        (forall h':set, group_homomorphism G mult G mult h' ->
          (forall alpha:set, alpha :e J ->
            apply_fun h' (apply_fun gens alpha) = apply_fun gens alpha) ->
          forall y:set, y :e G -> apply_fun h' y = apply_fun h y).
      { exact (Hext G mult e inv Hgrp gens Hgens). }
      apply (HextG (WordProd x)).
      let h_G.
      assume Hh_G.
      (** Extract uniqueness **)
      claim Hh_G_unique : forall h':set, group_homomorphism G mult G mult h' ->
        (forall alpha:set, alpha :e J ->
          apply_fun h' (apply_fun gens alpha) = apply_fun gens alpha) ->
        forall y:set, y :e G -> apply_fun h' y = apply_fun h_G y.
      { apply (Hh_G (forall h':set, group_homomorphism G mult G mult h' ->
          (forall alpha:set, alpha :e J ->
            apply_fun h' (apply_fun gens alpha) = apply_fun gens alpha) ->
          forall y:set, y :e G -> apply_fun h' y = apply_fun h_G y)).
        assume _ HC. exact HC. }
      (** h_S = h_G on x **)
      claim Hh_S_eq : apply_fun h_S x = apply_fun h_G x.
      { exact (Hh_G_unique h_S Hh_S_hom_GG Hh_S_gens x HxG). }
      (** Construct identity map and show it equals h_G **)
      set id_G := graph G (fun y:set => y).
      claim Hid_hom : group_homomorphism G mult G mult id_G.
      { prove function_on id_G G G /\
          (forall a b:set, a :e G -> b :e G ->
            apply_fun id_G (apply_fun mult (a, b)) = apply_fun mult (apply_fun id_G a, apply_fun id_G b)).
        apply andI.
        { exact (identity_graph_function_on_algtop G). }
        { let a b. assume HaG HbG.
          claim HabG : apply_fun mult (a, b) :e G.
          { exact (group_source_mult_closure G mult e inv Hgrp a b HaG HbG). }
          rewrite (apply_fun_graph G (fun y:set => y) (apply_fun mult (a, b)) HabG).
          rewrite (apply_fun_graph G (fun y:set => y) a HaG).
          rewrite (apply_fun_graph G (fun y:set => y) b HbG).
          reflexivity. } }
      claim Hid_gens : forall alpha:set, alpha :e J ->
        apply_fun id_G (apply_fun gens alpha) = apply_fun gens alpha.
      { let alpha. assume HalphaJ : alpha :e J.
        exact (apply_fun_graph G (fun y:set => y) (apply_fun gens alpha) (Hgens alpha HalphaJ)). }
      claim Hid_eq : apply_fun id_G x = apply_fun h_G x.
      { exact (Hh_G_unique id_G Hid_hom Hid_gens x HxG). }
      claim Hid_x : apply_fun id_G x = x.
      { exact (apply_fun_graph G (fun y:set => y) x HxG). }
      (** h_S(x) = x **)
      claim Hh_S_x_eq : apply_fun h_S x = x.
      { rewrite Hh_S_eq. rewrite <- Hid_eq. exact Hid_x. }
      (** x in S **)
      claim HxS : x :e S.
      { rewrite <- Hh_S_x_eq. exact (Hh_S_fn x HxG). }
      exact (SepE2 G WordProd x HxS).
    }
  + (** Component 5: unique reduced word representation **)
    admit.
- (** Component 6: efam maps to identity **)
  let alpha. assume Halpha : alpha :e J.
  exact (apply_fun_graph J (fun a:set => e) alpha Halpha).
Admitted.


(** from S69 Lem 69.1 (line 3047 in algtop.tex): extension condition for free groups **)
(** LATEX VERSION: G is a free group with generators {a_alpha} iff for any group H **)
(** and any family {y_alpha} of elements of H, there is a unique homomorphism **)
(** h: G -> H with h(a_alpha) = y_alpha. **)
(** EFFORT: 8 lines textbook, difficulty 4/10, USD 80 **)
(** Bounty 97 **)
Theorem lemma69_1_extension_free_group :
  forall G mult e inv J gens:set,
  group_structure G mult e inv ->
  function_on gens J G ->
  (free_group_with_generators G mult e inv J gens <->
   (forall H multH eH invH:set,
     group_structure H multH eH invH ->
     forall ys:set, function_on ys J H ->
       exists h:set,
         group_homomorphism G mult H multH h /\
         (forall alpha:set, alpha :e J ->
           apply_fun h (apply_fun gens alpha) = apply_fun ys alpha) /\
         (forall h':set, group_homomorphism G mult H multH h' ->
           (forall alpha:set, alpha :e J ->
             apply_fun h' (apply_fun gens alpha) = apply_fun ys alpha) ->
           forall x:set, x :e G -> apply_fun h' x = apply_fun h x))).
let G mult e inv J gens.
assume Hgrp : group_structure G mult e inv.
assume Hgens : function_on gens J G.
apply (iffI
  (free_group_with_generators G mult e inv J gens)
  (forall H multH eH invH:set,
    group_structure H multH eH invH ->
    forall ys:set, function_on ys J H ->
      exists h:set,
        group_homomorphism G mult H multH h /\
        (forall alpha:set, alpha :e J ->
          apply_fun h (apply_fun gens alpha) = apply_fun ys alpha) /\
        (forall h':set, group_homomorphism G mult H multH h' ->
          (forall alpha:set, alpha :e J ->
            apply_fun h' (apply_fun gens alpha) = apply_fun ys alpha) ->
          forall x:set, x :e G -> apply_fun h' x = apply_fun h x))).
- assume Hfree : free_group_with_generators G mult e inv J gens.
  apply (and4E
    (group_structure G mult e inv)
    (function_on gens J G)
    (forall alpha:set, alpha :e J ->
      infinite_cyclic_subgroup G mult e inv (apply_fun gens alpha))
    (free_product_of_subgroups G mult e inv J
      (graph J (fun alpha:set =>
        {g :e G | exists n:set, n :e int /\
          ((n :e omega /\ g = group_power_nat mult e (apply_fun gens alpha) n) \/
           (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
            g = group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m)))}))
      (graph J (fun alpha:set => e)))
    Hfree).
  assume Hgrp_free Hgens_free Hinfcyc Hfp.
  let H multH eH invH.
  assume HgrpH : group_structure H multH eH invH.
  let ys.
  assume Hys : function_on ys J H.
  set Gfam0 := graph J (fun alpha:set =>
    {g :e G | exists n:set, n :e int /\
      ((n :e omega /\ g = group_power_nat mult e (apply_fun gens alpha) n) \/
       (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
        g = group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m)))}).
  set efam0 := graph J (fun alpha:set => e).
  claim HextFP :
    forall hfam:set,
      (forall alpha:set, alpha :e J ->
        group_homomorphism (apply_fun Gfam0 alpha) mult H multH (apply_fun hfam alpha)) ->
      exists h:set,
        group_homomorphism G mult H multH h /\
        (forall alpha:set, alpha :e J ->
          forall x:set, x :e apply_fun Gfam0 alpha ->
            apply_fun h x = apply_fun (apply_fun hfam alpha) x) /\
        (forall h':set, group_homomorphism G mult H multH h' ->
          (forall alpha:set, alpha :e J ->
            forall x:set, x :e apply_fun Gfam0 alpha ->
              apply_fun h' x = apply_fun (apply_fun hfam alpha) x) ->
          forall x:set, x :e G -> apply_fun h' x = apply_fun h x).
  {
    exact (lemma68_1_extension_condition_free_product
      G
      mult
      e
      inv
      J
      Gfam0
      efam0
      Hfp
      H
      multH
      eH
      invH
      HgrpH).
  }
  claim HgenInFam :
    forall alpha:set, alpha :e J ->
      apply_fun gens alpha :e apply_fun Gfam0 alpha.
  {
    let alpha.
    assume Halpha : alpha :e J.
    exact (lemma69_1_generator_in_factor_family
      G
      mult
      e
      inv
      J
      gens
      alpha
      Hgrp_free
      Hgens
      Halpha).
  }
  claim Hreduce_from_family :
    forall hfam:set,
      (forall alpha:set, alpha :e J ->
        group_homomorphism (apply_fun Gfam0 alpha) mult H multH (apply_fun hfam alpha)) ->
      (forall alpha:set, alpha :e J ->
        apply_fun (apply_fun hfam alpha) (apply_fun gens alpha) = apply_fun ys alpha) ->
      (forall h2:set, group_homomorphism G mult H multH h2 ->
        (forall alpha:set, alpha :e J ->
          apply_fun h2 (apply_fun gens alpha) = apply_fun ys alpha) ->
        forall alpha:set, alpha :e J ->
          forall x:set, x :e apply_fun Gfam0 alpha ->
            apply_fun h2 x = apply_fun (apply_fun hfam alpha) x) ->
      exists h:set,
        group_homomorphism G mult H multH h /\
        (forall alpha:set, alpha :e J ->
          apply_fun h (apply_fun gens alpha) = apply_fun ys alpha) /\
        (forall h2:set, group_homomorphism G mult H multH h2 ->
          (forall alpha:set, alpha :e J ->
            apply_fun h2 (apply_fun gens alpha) = apply_fun ys alpha) ->
          forall x:set, x :e G -> apply_fun h2 x = apply_fun h x).
  {
    let hfam.
    assume HhfamHom :
      forall alpha:set, alpha :e J ->
        group_homomorphism (apply_fun Gfam0 alpha) mult H multH (apply_fun hfam alpha).
    assume HhfamGen :
      forall alpha:set, alpha :e J ->
        apply_fun (apply_fun hfam alpha) (apply_fun gens alpha) = apply_fun ys alpha.
    assume HfromGen :
      forall h2:set, group_homomorphism G mult H multH h2 ->
        (forall alpha:set, alpha :e J ->
          apply_fun h2 (apply_fun gens alpha) = apply_fun ys alpha) ->
        forall alpha:set, alpha :e J ->
          forall x:set, x :e apply_fun Gfam0 alpha ->
            apply_fun h2 x = apply_fun (apply_fun hfam alpha) x.
    apply (HextFP hfam HhfamHom).
    let h.
    assume HhPack :
      group_homomorphism G mult H multH h /\
      (forall alpha:set, alpha :e J ->
        forall x:set, x :e apply_fun Gfam0 alpha ->
          apply_fun h x = apply_fun (apply_fun hfam alpha) x) /\
      (forall h2:set, group_homomorphism G mult H multH h2 ->
        (forall alpha:set, alpha :e J ->
          forall x:set, x :e apply_fun Gfam0 alpha ->
            apply_fun h2 x = apply_fun (apply_fun hfam alpha) x) ->
        forall x:set, x :e G -> apply_fun h2 x = apply_fun h x).
    apply (and3E
      (group_homomorphism G mult H multH h)
      (forall alpha:set, alpha :e J ->
        forall x:set, x :e apply_fun Gfam0 alpha ->
          apply_fun h x = apply_fun (apply_fun hfam alpha) x)
      (forall h2:set, group_homomorphism G mult H multH h2 ->
        (forall alpha:set, alpha :e J ->
          forall x:set, x :e apply_fun Gfam0 alpha ->
            apply_fun h2 x = apply_fun (apply_fun hfam alpha) x) ->
        forall x:set, x :e G -> apply_fun h2 x = apply_fun h x)
      HhPack).
    assume HhHom HhRestr HhUniq.
    witness h.
    apply (andI
      (group_homomorphism G mult H multH h /\
        (forall alpha:set, alpha :e J ->
          apply_fun h (apply_fun gens alpha) = apply_fun ys alpha))
      (forall h2:set, group_homomorphism G mult H multH h2 ->
        (forall alpha:set, alpha :e J ->
          apply_fun h2 (apply_fun gens alpha) = apply_fun ys alpha) ->
        forall x:set, x :e G -> apply_fun h2 x = apply_fun h x)).
    - apply (andI
        (group_homomorphism G mult H multH h)
        (forall alpha:set, alpha :e J ->
          apply_fun h (apply_fun gens alpha) = apply_fun ys alpha)
        HhHom).
      let alpha.
      assume Halpha : alpha :e J.
      claim HgenMem : apply_fun gens alpha :e apply_fun Gfam0 alpha.
      {
        exact (HgenInFam alpha Halpha).
      }
      claim HhGen :
        apply_fun h (apply_fun gens alpha) =
        apply_fun (apply_fun hfam alpha) (apply_fun gens alpha).
      {
        exact (HhRestr alpha Halpha (apply_fun gens alpha) HgenMem).
      }
      rewrite HhGen.
      exact (HhfamGen alpha Halpha).
    - let h2.
      assume Hh2Hom : group_homomorphism G mult H multH h2.
      assume Hh2Gen :
        forall alpha:set, alpha :e J ->
          apply_fun h2 (apply_fun gens alpha) = apply_fun ys alpha.
      claim Hh2Restr :
        forall alpha:set, alpha :e J ->
          forall x:set, x :e apply_fun Gfam0 alpha ->
            apply_fun h2 x = apply_fun (apply_fun hfam alpha) x.
      {
        exact (HfromGen h2 Hh2Hom Hh2Gen).
      }
      exact (HhUniq h2 Hh2Hom Hh2Restr).
  }
  claim Hhom_restrict_factor :
    forall h2:set, group_homomorphism G mult H multH h2 ->
      forall alpha:set, alpha :e J ->
        group_homomorphism (apply_fun Gfam0 alpha) mult H multH h2.
  {
    let h2.
    assume Hh2 : group_homomorphism G mult H multH h2.
    let alpha.
    assume Halpha : alpha :e J.
    exact (lemma69_1_hom_restricts_to_factor_family
      G
      mult
      e
      inv
      J
      gens
      H
      multH
      h2
      alpha
      Hh2
      Halpha).
  }
  claim Hfactor_univ :
    forall alpha:set, alpha :e J ->
      exists f:set,
        group_homomorphism (apply_fun Gfam0 alpha) mult H multH f /\
        apply_fun f (apply_fun gens alpha) = apply_fun ys alpha /\
        (forall f':set,
          group_homomorphism (apply_fun Gfam0 alpha) mult H multH f' ->
          apply_fun f' (apply_fun gens alpha) = apply_fun ys alpha ->
          forall x:set, x :e apply_fun Gfam0 alpha ->
            apply_fun f' x = apply_fun f x).
  {
    let alpha.
    assume Halpha : alpha :e J.
    set Galpha := apply_fun Gfam0 alpha.
    claim HGalpha_def : Galpha = apply_fun Gfam0 alpha.
    {
      reflexivity.
    }
    claim Hgen_of_factor :
      generator_of Galpha mult e inv (apply_fun gens alpha).
    {
      rewrite HGalpha_def.
      exact (lemma69_1_factor_family_generator_of
        G
        mult
        e
        inv
        J
        gens
        alpha
        Hgrp_free
        Hgens
        Halpha).
    }
    claim Hgrp_factor : group_structure Galpha mult e inv.
    {
      rewrite HGalpha_def.
      exact (subgroup_inherits_group_structure
        G
        mult
        e
        inv
        (apply_fun Gfam0 alpha)
        Hgrp_free
        (lemma69_1_factor_family_subgroup_from_free_product
          G
          mult
          e
          inv
          J
          gens
          alpha
          Hfp
          Halpha)).
    }
    claim Hcyc_factor : cyclic_group Galpha mult e inv.
    {
      exact (group_structure_and_generator_of_implies_cyclic_group
        Galpha
        mult
        e
        inv
        (apply_fun gens alpha)
        Hgrp_factor
        Hgen_of_factor).
    }
    claim Hnonfinite_factor : ~ finite Galpha.
    {
      exact (infinite_cyclic_subgroup_nonfinite
        Galpha
        mult
        e
        inv
        (apply_fun gens alpha)
        Hgrp_factor
        (lemma69_1_factor_family_infinite_cyclic
          G
          mult
          e
          inv
          J
          gens
          alpha
          Hgrp_free
          Hgens
          Hinfcyc
          Halpha)).
    }
    apply (infinite_cyclic_universal_property
      Galpha
      mult
      e
      inv
      (apply_fun gens alpha)
      H
      multH
      eH
      invH
      (apply_fun ys alpha)
      Hgrp_factor
      Hcyc_factor
      Hnonfinite_factor
      Hgen_of_factor
      HgrpH
      (Hys alpha Halpha)).
  }
  set hfam0 := graph J (fun alpha:set =>
    Eps_i (fun f:set =>
      group_homomorphism (apply_fun Gfam0 alpha) mult H multH f /\
      apply_fun f (apply_fun gens alpha) = apply_fun ys alpha /\
      (forall f':set,
        group_homomorphism (apply_fun Gfam0 alpha) mult H multH f' ->
        apply_fun f' (apply_fun gens alpha) = apply_fun ys alpha ->
        forall x:set, x :e apply_fun Gfam0 alpha ->
          apply_fun f' x = apply_fun f x))).
  claim Hhfam0_spec :
    forall alpha:set, alpha :e J ->
      group_homomorphism (apply_fun Gfam0 alpha) mult H multH (apply_fun hfam0 alpha) /\
      apply_fun (apply_fun hfam0 alpha) (apply_fun gens alpha) = apply_fun ys alpha /\
      (forall f':set,
        group_homomorphism (apply_fun Gfam0 alpha) mult H multH f' ->
        apply_fun f' (apply_fun gens alpha) = apply_fun ys alpha ->
        forall x:set, x :e apply_fun Gfam0 alpha ->
          apply_fun f' x = apply_fun (apply_fun hfam0 alpha) x).
  {
    let alpha.
    assume Halpha : alpha :e J.
    rewrite (apply_fun_graph
      J
      (fun alpha:set =>
        Eps_i (fun f:set =>
          group_homomorphism (apply_fun Gfam0 alpha) mult H multH f /\
          apply_fun f (apply_fun gens alpha) = apply_fun ys alpha /\
          (forall f':set,
            group_homomorphism (apply_fun Gfam0 alpha) mult H multH f' ->
            apply_fun f' (apply_fun gens alpha) = apply_fun ys alpha ->
            forall x:set, x :e apply_fun Gfam0 alpha ->
              apply_fun f' x = apply_fun f x)))
      alpha
      Halpha).
    exact (Eps_i_ex
      (fun f:set =>
        group_homomorphism (apply_fun Gfam0 alpha) mult H multH f /\
        apply_fun f (apply_fun gens alpha) = apply_fun ys alpha /\
        (forall f':set,
          group_homomorphism (apply_fun Gfam0 alpha) mult H multH f' ->
          apply_fun f' (apply_fun gens alpha) = apply_fun ys alpha ->
          forall x:set, x :e apply_fun Gfam0 alpha ->
            apply_fun f' x = apply_fun f x))
      (Hfactor_univ alpha Halpha)).
  }
  claim Hhfam0_hom :
    forall alpha:set, alpha :e J ->
      group_homomorphism (apply_fun Gfam0 alpha) mult H multH (apply_fun hfam0 alpha).
  {
    let alpha.
    assume Halpha : alpha :e J.
    apply (and3E
      (group_homomorphism (apply_fun Gfam0 alpha) mult H multH (apply_fun hfam0 alpha))
      (apply_fun (apply_fun hfam0 alpha) (apply_fun gens alpha) = apply_fun ys alpha)
      (forall f':set,
        group_homomorphism (apply_fun Gfam0 alpha) mult H multH f' ->
        apply_fun f' (apply_fun gens alpha) = apply_fun ys alpha ->
        forall x:set, x :e apply_fun Gfam0 alpha ->
          apply_fun f' x = apply_fun (apply_fun hfam0 alpha) x)
      (Hhfam0_spec alpha Halpha)).
    assume Hhom Hgen Huniq.
    exact Hhom.
  }
  claim Hhfam0_gen :
    forall alpha:set, alpha :e J ->
      apply_fun (apply_fun hfam0 alpha) (apply_fun gens alpha) = apply_fun ys alpha.
  {
    let alpha.
    assume Halpha : alpha :e J.
    apply (and3E
      (group_homomorphism (apply_fun Gfam0 alpha) mult H multH (apply_fun hfam0 alpha))
      (apply_fun (apply_fun hfam0 alpha) (apply_fun gens alpha) = apply_fun ys alpha)
      (forall f':set,
        group_homomorphism (apply_fun Gfam0 alpha) mult H multH f' ->
        apply_fun f' (apply_fun gens alpha) = apply_fun ys alpha ->
        forall x:set, x :e apply_fun Gfam0 alpha ->
          apply_fun f' x = apply_fun (apply_fun hfam0 alpha) x)
      (Hhfam0_spec alpha Halpha)).
    assume Hhom Hgen Huniq.
    exact Hgen.
  }
  claim Hhfam0_uniq :
    forall alpha:set, alpha :e J ->
      forall f':set,
        group_homomorphism (apply_fun Gfam0 alpha) mult H multH f' ->
        apply_fun f' (apply_fun gens alpha) = apply_fun ys alpha ->
        forall x:set, x :e apply_fun Gfam0 alpha ->
          apply_fun f' x = apply_fun (apply_fun hfam0 alpha) x.
  {
    let alpha.
    assume Halpha : alpha :e J.
    apply (and3E
      (group_homomorphism (apply_fun Gfam0 alpha) mult H multH (apply_fun hfam0 alpha))
      (apply_fun (apply_fun hfam0 alpha) (apply_fun gens alpha) = apply_fun ys alpha)
      (forall f':set,
        group_homomorphism (apply_fun Gfam0 alpha) mult H multH f' ->
        apply_fun f' (apply_fun gens alpha) = apply_fun ys alpha ->
        forall x:set, x :e apply_fun Gfam0 alpha ->
          apply_fun f' x = apply_fun (apply_fun hfam0 alpha) x)
      (Hhfam0_spec alpha Halpha)).
    assume Hhom Hgen Huniq.
    exact Huniq.
  }
  claim HfromGen0 :
    forall h2:set, group_homomorphism G mult H multH h2 ->
      (forall alpha:set, alpha :e J ->
        apply_fun h2 (apply_fun gens alpha) = apply_fun ys alpha) ->
      forall alpha:set, alpha :e J ->
        forall x:set, x :e apply_fun Gfam0 alpha ->
          apply_fun h2 x = apply_fun (apply_fun hfam0 alpha) x.
  {
    let h2.
    assume Hh2 : group_homomorphism G mult H multH h2.
    assume Hh2Gen :
      forall alpha:set, alpha :e J ->
        apply_fun h2 (apply_fun gens alpha) = apply_fun ys alpha.
    let alpha.
    assume Halpha : alpha :e J.
    let x.
    assume Hx : x :e apply_fun Gfam0 alpha.
    exact (Hhfam0_uniq
      alpha
      Halpha
      h2
      (Hhom_restrict_factor h2 Hh2 alpha Halpha)
      (Hh2Gen alpha Halpha)
      x
      Hx).
  }
  exact (Hreduce_from_family hfam0 Hhfam0_hom Hhfam0_gen HfromGen0).
- assume Hext :
    forall H multH eH invH:set,
      group_structure H multH eH invH ->
      forall ys:set, function_on ys J H ->
        exists h:set,
          group_homomorphism G mult H multH h /\
          (forall alpha:set, alpha :e J ->
            apply_fun h (apply_fun gens alpha) = apply_fun ys alpha) /\
          (forall h':set, group_homomorphism G mult H multH h' ->
            (forall alpha:set, alpha :e J ->
              apply_fun h' (apply_fun gens alpha) = apply_fun ys alpha) ->
            forall x:set, x :e G -> apply_fun h' x = apply_fun h x).
  apply (andI
    (group_structure G mult e inv /\ function_on gens J G /\
      (forall alpha:set, alpha :e J ->
        infinite_cyclic_subgroup G mult e inv (apply_fun gens alpha)))
    (free_product_of_subgroups G mult e inv J
      (graph J (fun alpha:set =>
        {g :e G | exists n:set, n :e int /\
          ((n :e omega /\ g = group_power_nat mult e (apply_fun gens alpha) n) \/
           (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
            g = group_power_nat mult e (apply_fun inv (apply_fun gens alpha)) (ordsucc m)))}))
      (graph J (fun alpha:set => e)))).
  + apply (andI
      (group_structure G mult e inv /\ function_on gens J G)
      (forall alpha:set, alpha :e J ->
        infinite_cyclic_subgroup G mult e inv (apply_fun gens alpha))).
    * exact (andI
        (group_structure G mult e inv)
        (function_on gens J G)
        Hgrp
        Hgens).
    * let alpha.
    assume Halpha : alpha :e J.
    set galpha := apply_fun gens alpha.
    claim HgalphaG : galpha :e G.
    {
      exact (Hgens alpha Halpha).
    }
    claim HpowClosed :
      forall a:set, a :e G ->
      forall n:set, n :e omega ->
        group_power_nat mult e a n :e G.
    {
      let a.
      assume HaG : a :e G.
      let n.
      assume HnO : n :e omega.
      exact (group_power_nat_closed_in_group
        G
        mult
        e
        inv
        a
        n
        Hgrp
        HaG
        HnO).
    }
    claim HinvGalphaG : apply_fun inv galpha :e G.
    {
      exact (group_inverse_closed_in_group
        G
        mult
        e
        inv
        galpha
        Hgrp
        HgalphaG).
    }
    claim HpowGalpha :
      forall n:set, n :e omega -> group_power_nat mult e galpha n :e G.
    {
      let n.
      assume HnO : n :e omega.
      exact (HpowClosed galpha HgalphaG n HnO).
    }
    claim HpowInvGalpha :
      forall m:set, m :e omega ->
        group_power_nat mult e (apply_fun inv galpha) (ordsucc m) :e G.
    {
      let m.
      assume HmO : m :e omega.
      exact (HpowClosed
        (apply_fun inv galpha)
        HinvGalphaG
        (ordsucc m)
        (omega_ordsucc m HmO)).
    }
    claim HnontrivGalpha :
      ~(exists n:set, n :e omega /\ n <> 0 /\ group_power_nat mult e galpha n = e).
    {
      exact (extension_property_forces_nontrivial_generator_powers
        G
        mult
        e
        inv
        J
        gens
        Hgrp
        Hgens
        Hext
        alpha
        Halpha).
    }
    claim HgalphaPow :
      galpha :e G /\ (forall n:set, n :e omega -> group_power_nat mult e galpha n :e G).
    {
      exact (andI
        (galpha :e G)
        (forall n:set, n :e omega -> group_power_nat mult e galpha n :e G)
        HgalphaG
        HpowGalpha).
    }
    claim HgalphaPowInv :
      (galpha :e G /\ (forall n:set, n :e omega -> group_power_nat mult e galpha n :e G)) /\
      (forall m:set, m :e omega ->
        group_power_nat mult e (apply_fun inv galpha) (ordsucc m) :e G).
    {
      exact (andI
        (galpha :e G /\ (forall n:set, n :e omega -> group_power_nat mult e galpha n :e G))
        (forall m:set, m :e omega ->
          group_power_nat mult e (apply_fun inv galpha) (ordsucc m) :e G)
        HgalphaPow
        HpowInvGalpha).
    }
    exact (andI
      ((galpha :e G /\ (forall n:set, n :e omega -> group_power_nat mult e galpha n :e G)) /\
       (forall m:set, m :e omega ->
         group_power_nat mult e (apply_fun inv galpha) (ordsucc m) :e G))
      (~(exists n:set, n :e omega /\ n <> 0 /\ group_power_nat mult e galpha n = e))
      HgalphaPowInv
      HnontrivGalpha).
  + exact (extension_property_forces_free_product_generated_subgroups
      G
      mult
      e
      inv
      J
      gens
      Hgrp
      Hgens
      Hext).
Admitted.

(** Infrastructure helper for S69 Thm 69.2:
    free product of two free groups is free on the union of the generator families. **)
(** Proven Bob **)
Theorem free_product_of_free_groups_has_union_free_generators :
  forall G mult e inv G1 G2 J K gens:set,
  group_structure G mult e inv ->
  subgroup_of G1 G mult e inv ->
  subgroup_of G2 G mult e inv ->
  free_product_of_subgroups G mult e inv (UPair 0 1)
    (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2))
    (graph (UPair 0 1) (fun i:set => e)) ->
  J :/\: K = Empty ->
  free_group_with_generators G1 mult e inv J
    (graph J (fun alpha:set => apply_fun gens alpha)) ->
  free_group_with_generators G2 mult e inv K
    (graph K (fun alpha:set => apply_fun gens alpha)) ->
  free_group_with_generators G mult e inv (J :\/: K) gens.
let G mult e inv G1 G2 J K gens.
assume Hgrp : group_structure G mult e inv.
assume Hsub1 : subgroup_of G1 G mult e inv.
assume Hsub2 : subgroup_of G2 G mult e inv.
assume Hfp :
  free_product_of_subgroups G mult e inv (UPair 0 1)
    (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2))
    (graph (UPair 0 1) (fun i:set => e)).
assume Hdisj : J :/\: K = Empty.
assume Hfree1 :
  free_group_with_generators G1 mult e inv J
    (graph J (fun alpha:set => apply_fun gens alpha)).
assume Hfree2 :
  free_group_with_generators G2 mult e inv K
    (graph K (fun alpha:set => apply_fun gens alpha)).
claim HG1sub : G1 c= G.
{
  apply (and4E
    (G1 c= G)
    (e :e G1)
    (forall x y:set, x :e G1 -> y :e G1 -> apply_fun mult (x, y) :e G1)
    (forall x:set, x :e G1 -> apply_fun inv x :e G1)
    Hsub1).
  assume HG1sub0 _ _ _.
  exact HG1sub0.
}
claim HG2sub : G2 c= G.
{
  apply (and4E
    (G2 c= G)
    (e :e G2)
    (forall x y:set, x :e G2 -> y :e G2 -> apply_fun mult (x, y) :e G2)
    (forall x:set, x :e G2 -> apply_fun inv x :e G2)
    Hsub2).
  assume HG2sub0 _ _ _.
  exact HG2sub0.
}
claim Hgens1 :
  function_on (graph J (fun alpha:set => apply_fun gens alpha)) J G1.
{
  apply (and4E
    (group_structure G1 mult e inv)
    (function_on (graph J (fun alpha:set => apply_fun gens alpha)) J G1)
    (forall alpha:set, alpha :e J ->
      infinite_cyclic_subgroup G1 mult e inv
        (apply_fun (graph J (fun beta:set => apply_fun gens beta)) alpha))
    (free_product_of_subgroups G1 mult e inv J
      (graph J (fun alpha:set =>
        {g :e G1 | exists n:set, n :e int /\
          ((n :e omega /\ g = group_power_nat mult e
            (apply_fun (graph J (fun beta:set => apply_fun gens beta)) alpha) n) \/
           (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
            g = group_power_nat mult e
              (apply_fun inv (apply_fun (graph J (fun beta:set => apply_fun gens beta)) alpha))
              (ordsucc m)))}))
      (graph J (fun alpha:set => e)))
    Hfree1).
  assume _ Hgens1 _ _.
  exact Hgens1.
}
claim Hgens2 :
  function_on (graph K (fun alpha:set => apply_fun gens alpha)) K G2.
{
  apply (and4E
    (group_structure G2 mult e inv)
    (function_on (graph K (fun alpha:set => apply_fun gens alpha)) K G2)
    (forall alpha:set, alpha :e K ->
      infinite_cyclic_subgroup G2 mult e inv
        (apply_fun (graph K (fun beta:set => apply_fun gens beta)) alpha))
    (free_product_of_subgroups G2 mult e inv K
      (graph K (fun alpha:set =>
        {g :e G2 | exists n:set, n :e int /\
          ((n :e omega /\ g = group_power_nat mult e
            (apply_fun (graph K (fun beta:set => apply_fun gens beta)) alpha) n) \/
           (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
            g = group_power_nat mult e
              (apply_fun inv (apply_fun (graph K (fun beta:set => apply_fun gens beta)) alpha))
              (ordsucc m)))}))
      (graph K (fun alpha:set => e)))
    Hfree2).
  assume _ Hgens2 _ _.
  exact Hgens2.
}
claim Hinf1 :
  forall alpha:set, alpha :e J ->
    infinite_cyclic_subgroup G1 mult e inv (apply_fun gens alpha).
{
  let alpha.
  assume Halpha : alpha :e J.
  apply (and4E
    (group_structure G1 mult e inv)
    (function_on (graph J (fun alpha:set => apply_fun gens alpha)) J G1)
    (forall alpha:set, alpha :e J ->
      infinite_cyclic_subgroup G1 mult e inv
        (apply_fun (graph J (fun beta:set => apply_fun gens beta)) alpha))
    (free_product_of_subgroups G1 mult e inv J
      (graph J (fun alpha:set =>
        {g :e G1 | exists n:set, n :e int /\
          ((n :e omega /\ g = group_power_nat mult e
            (apply_fun (graph J (fun beta:set => apply_fun gens beta)) alpha) n) \/
           (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
            g = group_power_nat mult e
              (apply_fun inv (apply_fun (graph J (fun beta:set => apply_fun gens beta)) alpha))
