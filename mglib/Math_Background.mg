    (x :e Sn n)
    (y = UPair x (Rn_negate (ordsucc n) x))
    HxPack).
}
claim HyEq : y = UPair x (Rn_negate (ordsucc n) x).
{
  exact (andER
    (x :e Sn n)
    (y = UPair x (Rn_negate (ordsucc n) x))
    HxPack).
}
witness x.
apply andI.
- exact HxSn.
- rewrite HyEq.
  exact (apply_fun_graph
    (Sn n)
    (fun u:set => UPair u (Rn_negate (ordsucc n) u))
    x
    HxSn).
Qed.

