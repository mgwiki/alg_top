      apply_fun xsw i =
      apply_fun (graph 1 (fun _:set => apply_fun gensH0 alpha)) i.
  {
    exact (andER
      (nw = 1)
      (forall i:set, i :e nw ->
        apply_fun xsw i =
        apply_fun (graph 1 (fun _:set => apply_fun gensH0 alpha)) i)
      HuniqSingleton).
  }
  claim HnwEqN : nw = n.
  {
    exact (andEL
      (nw = n)
