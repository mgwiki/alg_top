    S1 S1_topology
    S1 S1_topology
    R R_standard_topology
    idS1 (const_fun S1 0)
    HidS1Cont Hconst0Cont).
}
claim HgFun : function_on g S1 X.
{
  exact (continuous_map_function_on S1 S1_topology X Tx g HgCont).
