claim HABEempty : (A :/\: E) :/\: (B :/\: E) = Empty.
{
  apply Empty_Subq_eq.
  let x.
  assume HxInter.
  claim HxAE : x :e A :/\: E.
  {
    exact (binintersectE1
      (A :/\: E)
      (B :/\: E)
      x
      HxInter).
  }
  claim HxBE : x :e B :/\: E.
  {
    exact (binintersectE2
      (A :/\: E)
      (B :/\: E)
