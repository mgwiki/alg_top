    {
      reflexivity.
    }
    apply (xm (beta = alpha)).
    - assume Hbeq : beta = alpha.
      rewrite HfAt.
      rewrite (If_i_1
        (beta = alpha)
        1
        0
        Hbeq).
      exact H1Int.
    - assume Hbneq : ~(beta = alpha).
      rewrite HfAt.
      rewrite (If_i_0
        (beta = alpha)
        1
        0
        Hbneq).
      exact H0Int.
  }
  exact (total_function_on_function_on
    ys0
    J
    int
    Hys0Total).
