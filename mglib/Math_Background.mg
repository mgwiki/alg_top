claim HoutsideUnionWordLengthConstraintsH0 :
  forall x n xs:set,
    x <> eF ->
    (x :e Union (Repl JH0 (fun alpha:set => apply_fun GfamH0 alpha)) -> False) ->
    reduced_word JH0 GfamH0 efamH0 n xs ->
