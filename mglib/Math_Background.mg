        exact (Rle_neq_implies_Rlt
          0
          (apply_fun v 1)
          (HvNonneg 1 H1in3)
          (fun H0 => Hv1ne0 (eq_symm 0 (apply_fun v 1) H0))).
      }
      exact (orIR
        (Rlt 0 (apply_fun v 0))
        (Rlt 0 (apply_fun v 1) \/ Rlt 0 (apply_fun v 2))
        (orIL
          (Rlt 0 (apply_fun v 1))
          (Rlt 0 (apply_fun v 2))
