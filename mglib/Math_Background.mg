  claim HlhsPair :
    apply_fun r (Rn_negate 2 p)
    =
    (minus_SNo (div_SNo (p 0) dnorm),
     minus_SNo (div_SNo (p 1) dnorm)).
  {
    claim HargEq :
      Rn_negate 2 p = (minus_SNo (p 0), minus_SNo (p 1)).
    {
      claim HpAp0Eq : apply_fun p 0 = p 0.
      {
        exact (andEL
          (apply_fun p 0 = p 0)
          (apply_fun p 1 = p 1)
