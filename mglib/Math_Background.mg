assume HxN.
claim HxSq : x :e unit_square.
{
  exact (HNsubSq
    x
    HxN).
}
claim Hx0I : x 0 :e unit_interval.
{
  exact (ap0_Sigma
    unit_interval
    (fun _ : set => unit_interval)
    x
    HxSq).
}
claim Hx1I : x 1 :e unit_interval.
{
  exact (ap1_Sigma
    unit_interval
    (fun _ : set => unit_interval)
    x
    HxSq).
}
claim HxEta : x = (x 0, x 1).
{
  exact (setprod_eta
    unit_interval
    unit_interval
    x
    HxSq).
}
rewrite HxEta.
exact (HcommSq
  (x 0)
  (x 1)
  Hx0I
  Hx1I).
Qed.

(** Infrastructure: image of a commuting lift stays in the preimage of U **)
