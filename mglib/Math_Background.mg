  apply Hred12.
  let n12. assume Hn12pack.
  apply Hn12pack.
  let xs12. assume Hxs12pack.
  apply (and4E
    (reduced_word (UPair 0 1) Gfam12 (graph (UPair 0 1) (fun _:set => eG)) n12 xs12)
    (n12 <> 0)
    (word_product multG eG xs12 n12 = x)
    (forall n' xs':set,
