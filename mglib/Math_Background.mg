      apply_fun (fundamental_group_mult X Tx a) (apply_fun (fundamental_group_mult X Tx a) (x, y), z)
      = apply_fun (fundamental_group_mult X Tx a) (x, apply_fun (fundamental_group_mult X Tx a) (y, z)))
