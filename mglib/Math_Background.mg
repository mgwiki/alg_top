            (product_topology U (subspace_topology B Tb U) U' (subspace_topology B' Tb' U'))
            U'
            (subspace_topology B' Tb' U')
            (projection_map2 U U').
        {
          exact (projection_maps_continuous
            U
            (subspace_topology B Tb U)
            U'
            (subspace_topology B' Tb' U')
            HtopU
            HtopU').
        }
        claim Hproj1U :
          continuous_map
            W
            (product_topology U (subspace_topology B Tb U) U' (subspace_topology B' Tb' U'))
            U
            (subspace_topology B Tb U)
            (projection_map1 U U').
        {
          exact (andEL
            (continuous_map
