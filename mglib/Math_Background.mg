      (real_SNo e0 He0R)).
    rewrite (add_SNo_minus_SNo_linv
      e0
      (real_SNo e0 He0R)).
    rewrite (add_SNo_0R
      mid_lift
      (real_SNo mid_lift HmidLiftR)).
    reflexivity.
