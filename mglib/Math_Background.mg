          (apply_fun row1 p)
          (apply_fun invlam p)
          HlamfS
          Hrow1S
          HinvS).
        rewrite (mul_SNo_com
          (apply_fun lamf p)
          (apply_fun row1 p)
          HlamfS
          Hrow1S).
        rewrite (eq_symm
          (mul_SNo (apply_fun row1 p) (mul_SNo (apply_fun lamf p) (apply_fun invlam p)))
          (mul_SNo (mul_SNo (apply_fun row1 p) (apply_fun lamf p)) (apply_fun invlam p))
          (mul_SNo_assoc
            (apply_fun row1 p)
            (apply_fun lamf p)
            (apply_fun invlam p)
            Hrow1S
            HlamfS
            HinvS)).
        rewrite HlamInv1.
        exact (mul_SNo_oneR
          (apply_fun row1 p)
