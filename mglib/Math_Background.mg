											          { rewrite <- Ht_eq. exact HwpA1_eq_xtp. }
											          claim HwpB1_tp : word_product multG eG xsB1 n1B = word_product multG eG xs12 (ordsucc tp).
											          { rewrite <- Ht_eq. exact HwpB1_eq_xtp. }
