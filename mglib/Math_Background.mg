                (n :e omega)
                (g = group_power_nat mult e x n)
                HnatCase).
            }
            claim HgPos :
              g = group_power_nat mult e x n.
            {
              exact (andER
                (n :e omega)
                (g = group_power_nat mult e x n)
                HnatCase).
            }
            claim HqrEx :
              exists q:set, q :e omega /\
                (exists r:set, r :e k /\
                  n = add_nat (mul_nat q k) r).
            {
              exact (quotient_remainder_nat
