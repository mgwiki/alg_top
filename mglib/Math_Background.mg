												            claim Hx1eq : apply_fun xs12 t = apply_fun xs12 (ordsucc 0).
												            {
												              rewrite Ht_os0.
												              reflexivity.
												            }
												            exact (eq_subst_mem_rev
												              (apply_fun xs12 t)
												              (apply_fun xs12 (ordsucc 0))
