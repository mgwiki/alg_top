												            Hxs0_pack).
												          assume Hred0 Hn0_ne0 Hwp0 Huniq0.
												          claim HuA : n0 = n1A /\ (forall i0:set, i0 :e n0 -> apply_fun xs0 i0 = apply_fun xsA1 i0).
												          { exact (Huniq0 n1A xsA1 HredA1_J (neq_ordsucc_0 mA) HwpA1_eq_xtp). }
