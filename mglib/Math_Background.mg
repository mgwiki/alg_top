        claim HgprodCont :
          continuous_map
            W
            (subspace_topology (setprod B B') (product_topology B Tb B' Tb') W)
            (setprod (w 0) (w 1))
            (subspace_topology (setprod E E') (product_topology E Te E' Te') (setprod (w 0) (w 1)))
            gprod.
        {
