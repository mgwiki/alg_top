apply (famunionE
  unit_interval_topology
  (fun U0:set => {rectangle_set U0 V|V :e unit_interval_topology})
  b
  HbSubbasis).
let U0.
assume HU0Pack.
claim HU0open : U0 :e unit_interval_topology.
{
  exact (andEL
    (U0 :e unit_interval_topology)
    (b :e {rectangle_set U0 V|V :e unit_interval_topology})
