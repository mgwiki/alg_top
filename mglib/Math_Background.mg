  claim Hraw :
    forall S:set, finite S ->
      (S c= Gnonid ->
        exists U:set, U :e Tx /\ x :e U /\
          (forall g:set, g :e S ->
            forall z:set, z :e U -> apply_fun g z /:e U)).
  {
    exact (finite_ind
      (fun S:set =>
        S c= Gnonid ->
        exists U:set, U :e Tx /\ x :e U /\
          (forall g:set, g :e S ->
            forall z:set, z :e U -> apply_fun g z /:e U))
      Hbase
      Hstep).
  }
  exact Hraw.
}
claim HglobalU :
  exists U:set, U :e Tx /\ x :e U /\
    (forall g:set, g :e Gnonid ->
      forall z:set, z :e U -> apply_fun g z /:e U).
{
