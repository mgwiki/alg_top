assume Hfcont Hf0 Hf1 HaI Ha0 Ha1.
set f1 := compose_fun unit_interval (affine_fun_I 0 a) f.
set f2 := compose_fun unit_interval (affine_fun_I a (add_SNo 1 (minus_SNo a))) f.
