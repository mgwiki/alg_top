(** Proven Bob **)
Theorem selected_arc_subset_union_selected_arcs :
  forall Y Arcs A:set,
  A :e {B :e Arcs | B c= Y} ->
  A c= Union {B :e Arcs | B c= Y}.
let Y Arcs A.
assume HA.
let x.
assume HxA.
exact (UnionI
