{
  exact (free_product_group_structure
    G
    multG
    eG
    invG
    (UPair 0 1)
    (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2))
    (graph (UPair 0 1) (fun i:set => eG))
    Hfp).
}
claim HG1sub : G1 c= G.
{
