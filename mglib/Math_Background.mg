		                    claim HtCases :
		                      (exists p:set, p :e omega /\ t = ordsucc p) \/
		                      (exists p:set, p :e omega /\ t = minus_SNo (ordsucc p)).
		                    { exact (int_nonzero_cases_cyclic_helper t HtInt HtNe0). }
		                    apply HtCases.
		                    + assume HtPos.
		                      apply HtPos.
		                      let p.
		                      assume HpPack.
		                      claim HpO : p :e omega.
		                      { exact (andEL
		                          (p :e omega)
		                          (t = ordsucc p)
		                          HpPack). }
		                      claim HtPosEq : t = ordsucc p.
		                      { exact (andER
		                          (p :e omega)
		                          (t = ordsucc p)
