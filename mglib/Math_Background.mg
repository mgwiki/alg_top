    exact (andER
      (function_on r (Bn_closed n) (Bn_closed n) /\
       continuous_map (Bn_closed n) (Bn_closed_topology n)
                      (Bn_closed n) (Bn_closed_topology n) r)
      (forall x:set, x :e Bn_closed n -> apply_fun r x :e Sn n)
      HrABC).
  }
  claim HrContSn :
    continuous_map (Bn_closed n) (Bn_closed_topology n)
                   (Sn n) (Sn_topology n) r.
  {
    rewrite <- (Sn_topology_subspace_of_Bn_closed
      n).
    exact (continuous_map_range_restrict
      (Bn_closed n)
      (Bn_closed_topology n)
      (Bn_closed n)
      (Bn_closed_topology n)
      r
      (Sn n)
      HrCont
      (fun x HxSn =>
        Sn_subset_Bn_closed
          n
          x
          HxSn)
      HrIntoSn).
  }
  claim HrFixSn : forall x:set, x :e Sn n -> apply_fun r x = x.
  {
    exact (andER
      ((function_on r (Bn_closed n) (Bn_closed n) /\
        continuous_map (Bn_closed n) (Bn_closed_topology n)
                       (Bn_closed n) (Bn_closed_topology n) r) /\
       (forall x:set, x :e Bn_closed n -> apply_fun r x :e Sn n))
      (forall x:set, x :e Sn n -> apply_fun r x = x)
      HrPack).
  }
  claim HextId : forall x:set, x :e Sn n ->
    apply_fun idSn x = apply_fun r x.
  {
    let x.
    assume HxSn.
    rewrite (apply_fun_graph
      (Sn n)
      (fun z:set => z)
      x
      HxSn).
    exact (eq_symm
      (apply_fun r x)
      x
      (HrFixSn x HxSn)).
  }
  exact (Sn_extends_to_Bn_closed_implies_nulhomotopic
    n
    (Sn n)
    (Sn_topology n)
    idSn
    r
    Hn_om
    HidCont
    HrContSn
    HextId).
}
exact (HnotNulId
  HnulId).
Qed.

(** from S57 Exercise 4(b) (line 1262 in algtop.tex) **)
(** LATEX VERSION: Given the hypothesis, there is no continuous antipode-preserving map g: S^{n+1} -> S^n. **)
(** EFFORT: 5 lines textbook, difficulty 4/10, USD 80 **)
(** Bounty 88 **)
Theorem ex57_4b_no_antipode_higher : forall n:set, n :e omega ->
  (forall h:set, antipode_preserving_Sn (ordsucc n) (ordsucc n) h ->
    ~(nulhomotopic (Sn (ordsucc n)) (Sn_topology (ordsucc n))
                   (Sn (ordsucc n)) (Sn_topology (ordsucc n)) h)) ->
  ~(exists g:set, antipode_preserving_Sn (ordsucc n) n g).
let n.
assume Hn_om.
assume HantiNoNul.
assume Hexg.
apply Hexg.
let g.
assume HgAP.
claim Hbridge :
  exists h:set,
    antipode_preserving_Sn (ordsucc n) (ordsucc n) h /\
    nulhomotopic
      (Sn (ordsucc n))
      (Sn_topology (ordsucc n))
      (Sn (ordsucc n))
      (Sn_topology (ordsucc n))
      h.
{
  (** Remaining core step for S57.4(b):
      from an antipode-preserving g : S^{n+1} -> S^n, construct an antipode-preserving
      self-map h : S^{n+1} -> S^{n+1} that is nulhomotopic. **)
  admit.
}
apply Hbridge.
let h.
assume HhPack.
claim HhAP :
  antipode_preserving_Sn (ordsucc n) (ordsucc n) h.
{
  exact (andEL
    (antipode_preserving_Sn (ordsucc n) (ordsucc n) h)
    (nulhomotopic
      (Sn (ordsucc n))
      (Sn_topology (ordsucc n))
      (Sn (ordsucc n))
      (Sn_topology (ordsucc n))
      h)
    HhPack).
}
claim HhNul :
  nulhomotopic
    (Sn (ordsucc n))
    (Sn_topology (ordsucc n))
    (Sn (ordsucc n))
    (Sn_topology (ordsucc n))
    h.
{
  exact (andER
    (antipode_preserving_Sn (ordsucc n) (ordsucc n) h)
    (nulhomotopic
      (Sn (ordsucc n))
      (Sn_topology (ordsucc n))
      (Sn (ordsucc n))
      (Sn_topology (ordsucc n))
      h)
    HhPack).
}
exact ((HantiNoNul h HhAP) HhNul).
Admitted.

(** from S57 Exercise 4(c) (line 1263 in algtop.tex) **)
(** LATEX VERSION: (Borsuk-Ulam) Given the hypothesis, for any continuous f: S^{n+1} -> R^{n+1}, there exists x with f(x) = f(-x). **)
(** EFFORT: 4 lines textbook, difficulty 3/10, USD 50 **)
(** Bounty 55 **)
Theorem ex57_4c_borsuk_ulam_general : forall n:set, n :e omega ->
  (forall h:set, antipode_preserving_Sn (ordsucc n) (ordsucc n) h ->
    ~(nulhomotopic (Sn (ordsucc n)) (Sn_topology (ordsucc n))
                   (Sn (ordsucc n)) (Sn_topology (ordsucc n)) h)) ->
  forall f:set,
    continuous_map (Sn (ordsucc n)) (Sn_topology (ordsucc n))
                   (euclidean_space (ordsucc n)) (euclidean_topology (ordsucc n)) f ->
    exists x:set, x :e Sn (ordsucc n) /\
      apply_fun f x = apply_fun f (Rn_negate (ordsucc (ordsucc n)) x).
let n.
assume Hn_om.
assume HantiNoNul.
let f.
assume HfCont.
apply (xm
  (exists x:set, x :e Sn (ordsucc n) /\
    apply_fun f x = apply_fun f (Rn_negate (ordsucc (ordsucc n)) x))).
- assume Hex.
  exact Hex.
- assume Hnone.
  claim Hsep :
    forall x:set, x :e Sn (ordsucc n) ->
      apply_fun f x <> apply_fun f (Rn_negate (ordsucc (ordsucc n)) x).
  {
    let x.
    assume HxSn.
    assume Heq.
    apply Hnone.
    witness x.
    exact (andI
      (x :e Sn (ordsucc n))
      (apply_fun f x = apply_fun f (Rn_negate (ordsucc (ordsucc n)) x))
      HxSn
      Heq).
  }
  claim HantiMapLower :
    exists g:set, antipode_preserving_Sn (ordsucc n) n g.
  {
    (** Remaining core step for S57.4(c):
        from f with no antipodal coincidence, build an antipode-preserving
        map g : S^{n+1} -> S^n (normalized antipodal-difference construction). **)
    admit.
  }
  claim HnoAntiLower :
    ~(exists g:set, antipode_preserving_Sn (ordsucc n) n g).
  {
    exact (ex57_4b_no_antipode_higher
      n
      Hn_om
      HantiNoNul).
  }
  exact (FalseE
    (HnoAntiLower
      HantiMapLower)
    (exists x:set, x :e Sn (ordsucc n) /\
      apply_fun f x = apply_fun f (Rn_negate (ordsucc (ordsucc n)) x))).
Admitted.

(** ======================= S58 DEFORMATION RETRACTS AND HOMOTOPY TYPE ======================= **)

(** from S58 Lem 58.1 (line 1272 in algtop.tex) **)
(** LATEX VERSION: Let h, k: (X,x0) -> (Y,y0) be continuous. If h and k are homotopic and the basepoint x0 remains fixed at y0 during the homotopy, then h-star = k-star. **)
(** EFFORT: 3 lines textbook, difficulty 2/10, USD 30 **)
(** Collected Alice 30 **)
(** Proven Alice **)
Theorem lemma58_1_basepoint_fixed_homotopy : forall X Tx Y Ty x0 y0 h k:set,
  continuous_map X Tx Y Ty h ->
  continuous_map X Tx Y Ty k ->
  apply_fun h x0 = y0 -> apply_fun k x0 = y0 ->
  x0 :e X ->
  (exists H:set, continuous_map (setprod X unit_interval)
    (product_topology X Tx unit_interval unit_interval_topology) Y Ty H /\
    (forall x:set, x :e X -> apply_fun H (x, 0) = apply_fun h x) /\
    (forall x:set, x :e X -> apply_fun H (x, 1) = apply_fun k x) /\
    (forall t:set, t :e unit_interval -> apply_fun H (x0, t) = y0)) ->
  (forall cls:set, cls :e fundamental_group X Tx x0 ->
    apply_fun (induced_homomorphism X Tx x0 Y Ty y0 h) cls =
    apply_fun (induced_homomorphism X Tx x0 Y Ty y0 k) cls).
let X Tx Y Ty x0 y0 h k.
assume Hh Hk Hh0 Hk0 Hx0X.
assume Hhomotopy.
let cls.
assume Hcls.
(** Expand induced homomorphisms **)
rewrite (induced_homomorphism_apply X Tx x0 Y Ty y0 h cls Hcls).
rewrite (induced_homomorphism_apply X Tx x0 Y Ty y0 k cls Hcls).
(** Get representative from cls **)
claim Hrep : exists f:set, f :e loop_space X Tx x0 /\
  cls = path_homotopy_class_loop X Tx x0 f.
{
  exact (fundamental_group_member_has_representative X Tx x0 cls Hcls).
}
apply Hrep.
let f.
assume HfPack.
claim HfLoop : f :e loop_space X Tx x0.
{ exact (andEL (f :e loop_space X Tx x0) (cls = path_homotopy_class_loop X Tx x0 f) HfPack). }
claim HclsEq : cls = path_homotopy_class_loop X Tx x0 f.
{ exact (andER (f :e loop_space X Tx x0) (cls = path_homotopy_class_loop X Tx x0 f) HfPack). }
rewrite HclsEq.
set eps := Eps_i (fun g:set => g :e path_homotopy_class_loop X Tx x0 f).
claim HfLoopAt : loop_at X Tx x0 f.
{ exact (loop_space_has_loop_at X Tx x0 f HfLoop). }
claim HfCont : continuous_map unit_interval unit_interval_topology X Tx f.
{ exact (loop_at_continuous X Tx x0 f HfLoopAt). }
claim Hf0 : apply_fun f 0 = x0.
{ exact (loop_at_at_zero X Tx x0 f HfLoopAt). }
claim Hf1 : apply_fun f 1 = x0.
{ exact (loop_at_at_one X Tx x0 f HfLoopAt). }
claim HfHomSelf : path_homotopic X Tx x0 x0 f f.
{ exact (Lemma_51_1_path_homotopy_refl X Tx x0 x0 f HfCont Hf0 Hf1). }
claim HfInClass : f :e path_homotopy_class_loop X Tx x0 f.
{ exact (SepI (loop_space X Tx x0) (fun z:set => path_homotopic X Tx x0 x0 f z) f HfLoop HfHomSelf). }
claim HepsInClassF : eps :e path_homotopy_class_loop X Tx x0 f.
{ exact (Eps_i_ax (fun g:set => g :e path_homotopy_class_loop X Tx x0 f) f HfInClass). }
claim HepsLoop : eps :e loop_space X Tx x0.
{ exact (path_homotopy_class_loop_in_loop_space X Tx x0 f eps HepsInClassF). }
claim HepsLoopAt : loop_at X Tx x0 eps.
{ exact (loop_space_has_loop_at X Tx x0 eps HepsLoop). }
claim HepsCont : continuous_map unit_interval unit_interval_topology X Tx eps.
{ exact (loop_at_continuous X Tx x0 eps HepsLoopAt). }
claim Heps0 : apply_fun eps 0 = x0.
{ exact (loop_at_at_zero X Tx x0 eps HepsLoopAt). }
claim Heps1 : apply_fun eps 1 = x0.
{ exact (loop_at_at_one X Tx x0 eps HepsLoopAt). }
(** h o eps and k o eps are continuous loops at y0 **)
claim HhepsCont : continuous_map unit_interval unit_interval_topology Y Ty
  (compose_fun unit_interval eps h).
{ exact (composition_continuous unit_interval unit_interval_topology X Tx Y Ty eps h HepsCont Hh). }
claim Hheps0 : apply_fun (compose_fun unit_interval eps h) 0 = y0.
{ rewrite (compose_fun_apply unit_interval eps h 0 zero_in_unit_interval). rewrite Heps0. exact Hh0. }
claim Hheps1 : apply_fun (compose_fun unit_interval eps h) 1 = y0.
{ rewrite (compose_fun_apply unit_interval eps h 1 one_in_unit_interval). rewrite Heps1. exact Hh0. }
claim HkepsCont : continuous_map unit_interval unit_interval_topology Y Ty
  (compose_fun unit_interval eps k).
{ exact (composition_continuous unit_interval unit_interval_topology X Tx Y Ty eps k HepsCont Hk). }
claim Hkeps0 : apply_fun (compose_fun unit_interval eps k) 0 = y0.
{ rewrite (compose_fun_apply unit_interval eps k 0 zero_in_unit_interval). rewrite Heps0. exact Hk0. }
claim Hkeps1 : apply_fun (compose_fun unit_interval eps k) 1 = y0.
{ rewrite (compose_fun_apply unit_interval eps k 1 one_in_unit_interval). rewrite Heps1. exact Hk0. }
(** Extract the homotopy H **)
apply Hhomotopy.
let HH.
assume HHpack.
(** HHpack: ((cont /\ at0) /\ at1) /\ base (left-assoc) **)
claim HHleft12 :
  (continuous_map (setprod X unit_interval)
    (product_topology X Tx unit_interval unit_interval_topology) Y Ty HH /\
   (forall x:set, x :e X -> apply_fun HH (x, 0) = apply_fun h x)) /\
  (forall x:set, x :e X -> apply_fun HH (x, 1) = apply_fun k x).
{ exact (andEL
    ((continuous_map (setprod X unit_interval)
      (product_topology X Tx unit_interval unit_interval_topology) Y Ty HH /\
     (forall x:set, x :e X -> apply_fun HH (x, 0) = apply_fun h x)) /\
     (forall x:set, x :e X -> apply_fun HH (x, 1) = apply_fun k x))
    (forall t:set, t :e unit_interval -> apply_fun HH (x0, t) = y0)
    HHpack). }
claim HH_base : forall t:set, t :e unit_interval -> apply_fun HH (x0, t) = y0.
{ exact (andER
    ((continuous_map (setprod X unit_interval)
      (product_topology X Tx unit_interval unit_interval_topology) Y Ty HH /\
     (forall x:set, x :e X -> apply_fun HH (x, 0) = apply_fun h x)) /\
     (forall x:set, x :e X -> apply_fun HH (x, 1) = apply_fun k x))
    (forall t:set, t :e unit_interval -> apply_fun HH (x0, t) = y0)
    HHpack). }
claim HHcont_at0 :
  continuous_map (setprod X unit_interval)
    (product_topology X Tx unit_interval unit_interval_topology) Y Ty HH /\
  (forall x:set, x :e X -> apply_fun HH (x, 0) = apply_fun h x).
{ exact (andEL
    (continuous_map (setprod X unit_interval)
      (product_topology X Tx unit_interval unit_interval_topology) Y Ty HH /\
     (forall x:set, x :e X -> apply_fun HH (x, 0) = apply_fun h x))
    (forall x:set, x :e X -> apply_fun HH (x, 1) = apply_fun k x)
    HHleft12). }
claim HH_at_1 : forall x:set, x :e X -> apply_fun HH (x, 1) = apply_fun k x.
{ exact (andER
    (continuous_map (setprod X unit_interval)
      (product_topology X Tx unit_interval unit_interval_topology) Y Ty HH /\
     (forall x:set, x :e X -> apply_fun HH (x, 0) = apply_fun h x))
    (forall x:set, x :e X -> apply_fun HH (x, 1) = apply_fun k x)
    HHleft12). }
claim HHcont : continuous_map (setprod X unit_interval)
  (product_topology X Tx unit_interval unit_interval_topology) Y Ty HH.
{ exact (andEL
    (continuous_map (setprod X unit_interval)
      (product_topology X Tx unit_interval unit_interval_topology) Y Ty HH)
    (forall x:set, x :e X -> apply_fun HH (x, 0) = apply_fun h x)
    HHcont_at0). }
claim HH_at_0 : forall x:set, x :e X -> apply_fun HH (x, 0) = apply_fun h x.
{ exact (andER
    (continuous_map (setprod X unit_interval)
      (product_topology X Tx unit_interval unit_interval_topology) Y Ty HH)
    (forall x:set, x :e X -> apply_fun HH (x, 0) = apply_fun h x)
    HHcont_at0). }
(** eps maps I to X **)
claim HepsFun : function_on eps unit_interval X.
{ exact (continuous_map_function_on unit_interval unit_interval_topology X Tx eps HepsCont). }
claim HtopX : topology_on X Tx.
{ exact (continuous_map_topology_dom X Tx Y Ty h Hh). }
claim HtopY : topology_on Y Ty.
{ exact (continuous_map_topology_cod X Tx Y Ty h Hh). }
(** Build phi: I x I -> X x I via (s,t) -> (eps(s), t) **)
set proj1_II := projection_map1 unit_interval unit_interval.
set proj2_II := projection_map2 unit_interval unit_interval.
claim Hproj1Cont : continuous_map unit_square unit_square_topology
  unit_interval unit_interval_topology proj1_II.
{ exact (andEL
    (continuous_map unit_square unit_square_topology unit_interval unit_interval_topology proj1_II)
    (continuous_map unit_square unit_square_topology unit_interval unit_interval_topology proj2_II)
    (projections_are_continuous unit_interval unit_interval_topology
      unit_interval unit_interval_topology
      unit_interval_topology_on unit_interval_topology_on)). }
claim Hproj2Cont : continuous_map unit_square unit_square_topology
  unit_interval unit_interval_topology proj2_II.
{ exact (andER
    (continuous_map unit_square unit_square_topology unit_interval unit_interval_topology proj1_II)
    (continuous_map unit_square unit_square_topology unit_interval unit_interval_topology proj2_II)
    (projections_are_continuous unit_interval unit_interval_topology
      unit_interval unit_interval_topology
      unit_interval_topology_on unit_interval_topology_on)). }
claim Heps_proj1_cont : continuous_map unit_square unit_square_topology X Tx
  (compose_fun unit_square proj1_II eps).
{ exact (composition_continuous unit_square unit_square_topology
    unit_interval unit_interval_topology X Tx
    proj1_II eps Hproj1Cont HepsCont). }
set phi := pair_map unit_square (compose_fun unit_square proj1_II eps) proj2_II.
claim HphiCont : continuous_map unit_square unit_square_topology
  (setprod X unit_interval) (product_topology X Tx unit_interval unit_interval_topology) phi.
{ exact (maps_into_products unit_square unit_square_topology
    X Tx unit_interval unit_interval_topology
    (compose_fun unit_square proj1_II eps) proj2_II
    Heps_proj1_cont Hproj2Cont). }
(** Build F = H o phi: I x I -> Y **)
set F := compose_fun unit_square phi HH.
claim HFcont : continuous_map unit_square unit_square_topology Y Ty F.
{ exact (composition_continuous unit_square unit_square_topology
    (setprod X unit_interval) (product_topology X Tx unit_interval unit_interval_topology)
    Y Ty phi HH HphiCont HHcont). }
(** Verify F boundary conditions **)
(** F(s,0) = H(eps(s), 0) = h(eps(s)) **)
claim HF_s0 : forall s:set, s :e unit_interval ->
  apply_fun F (s, 0) = apply_fun (compose_fun unit_interval eps h) s.
{
  let s. assume Hs.
  claim Hs0Sq : (s, 0) :e unit_square.
  { exact (tuple_2_setprod_by_pair_Sigma unit_interval unit_interval s 0 Hs zero_in_unit_interval). }
  rewrite (compose_fun_apply unit_square phi HH (s, 0) Hs0Sq).
  rewrite (pair_map_apply unit_square X unit_interval (compose_fun unit_square proj1_II eps) proj2_II (s, 0) Hs0Sq).
  rewrite (compose_fun_apply unit_square proj1_II eps (s, 0) Hs0Sq).
  rewrite (projection1_apply unit_interval unit_interval (s, 0) Hs0Sq).
  rewrite tuple_2_0_eq.
  rewrite (projection2_apply unit_interval unit_interval (s, 0) Hs0Sq).
  rewrite tuple_2_1_eq.
  claim HepsS_X : apply_fun eps s :e X.
  { exact (HepsFun s Hs). }
  rewrite (HH_at_0 (apply_fun eps s) HepsS_X).
  rewrite (compose_fun_apply unit_interval eps h s Hs).
  reflexivity.
}
(** F(s,1) = H(eps(s), 1) = k(eps(s)) **)
claim HF_s1 : forall s:set, s :e unit_interval ->
  apply_fun F (s, 1) = apply_fun (compose_fun unit_interval eps k) s.
{
  let s. assume Hs.
  claim Hs1Sq : (s, 1) :e unit_square.
  { exact (tuple_2_setprod_by_pair_Sigma unit_interval unit_interval s 1 Hs one_in_unit_interval). }
  rewrite (compose_fun_apply unit_square phi HH (s, 1) Hs1Sq).
  rewrite (pair_map_apply unit_square X unit_interval (compose_fun unit_square proj1_II eps) proj2_II (s, 1) Hs1Sq).
  rewrite (compose_fun_apply unit_square proj1_II eps (s, 1) Hs1Sq).
  rewrite (projection1_apply unit_interval unit_interval (s, 1) Hs1Sq).
  rewrite tuple_2_0_eq.
  rewrite (projection2_apply unit_interval unit_interval (s, 1) Hs1Sq).
  rewrite tuple_2_1_eq.
  claim HepsS_X : apply_fun eps s :e X.
  { exact (HepsFun s Hs). }
  rewrite (HH_at_1 (apply_fun eps s) HepsS_X).
  rewrite (compose_fun_apply unit_interval eps k s Hs).
  reflexivity.
}
(** F(0,t) = H(eps(0), t) = H(x0, t) = y0 **)
claim HF_0t : forall t:set, t :e unit_interval -> apply_fun F (0, t) = y0.
{
  let t. assume Ht.
  claim H0tSq : (0, t) :e unit_square.
  { exact (tuple_2_setprod_by_pair_Sigma unit_interval unit_interval 0 t zero_in_unit_interval Ht). }
  rewrite (compose_fun_apply unit_square phi HH (0, t) H0tSq).
  rewrite (pair_map_apply unit_square X unit_interval (compose_fun unit_square proj1_II eps) proj2_II (0, t) H0tSq).
  rewrite (compose_fun_apply unit_square proj1_II eps (0, t) H0tSq).
  rewrite (projection1_apply unit_interval unit_interval (0, t) H0tSq).
  rewrite tuple_2_0_eq.
  rewrite Heps0.
  rewrite (projection2_apply unit_interval unit_interval (0, t) H0tSq).
  rewrite tuple_2_1_eq.
  exact (HH_base t Ht).
}
(** F(1,t) = H(eps(1), t) = H(x0, t) = y0 **)
claim HF_1t : forall t:set, t :e unit_interval -> apply_fun F (1, t) = y0.
{
  let t. assume Ht.
  claim H1tSq : (1, t) :e unit_square.
  { exact (tuple_2_setprod_by_pair_Sigma unit_interval unit_interval 1 t one_in_unit_interval Ht). }
  rewrite (compose_fun_apply unit_square phi HH (1, t) H1tSq).
  rewrite (pair_map_apply unit_square X unit_interval (compose_fun unit_square proj1_II eps) proj2_II (1, t) H1tSq).
  rewrite (compose_fun_apply unit_square proj1_II eps (1, t) H1tSq).
  rewrite (projection1_apply unit_interval unit_interval (1, t) H1tSq).
  rewrite tuple_2_0_eq.
  rewrite Heps1.
  rewrite (projection2_apply unit_interval unit_interval (1, t) H1tSq).
  rewrite tuple_2_1_eq.
  exact (HH_base t Ht).
}
(** Build the path homotopy between h o eps and k o eps **)
claim Hhomotopic_heps_keps :
  path_homotopic Y Ty y0 y0 (compose_fun unit_interval eps h) (compose_fun unit_interval eps k).
{
  prove continuous_map unit_interval unit_interval_topology Y Ty (compose_fun unit_interval eps h) /\
    continuous_map unit_interval unit_interval_topology Y Ty (compose_fun unit_interval eps k) /\
    apply_fun (compose_fun unit_interval eps h) 0 = y0 /\
    apply_fun (compose_fun unit_interval eps h) 1 = y0 /\
    apply_fun (compose_fun unit_interval eps k) 0 = y0 /\
    apply_fun (compose_fun unit_interval eps k) 1 = y0 /\
    exists G:set,
      continuous_map unit_square unit_square_topology Y Ty G /\
      (forall s:set, s :e unit_interval ->
        apply_fun G (s, 0) = apply_fun (compose_fun unit_interval eps h) s) /\
      (forall s:set, s :e unit_interval ->
        apply_fun G (s, 1) = apply_fun (compose_fun unit_interval eps k) s) /\
      (forall t:set, t :e unit_interval ->
        apply_fun G (0, t) = y0) /\
      (forall t:set, t :e unit_interval ->
        apply_fun G (1, t) = y0).
  apply andI.
  - exact (and6I
      (continuous_map unit_interval unit_interval_topology Y Ty (compose_fun unit_interval eps h))
      (continuous_map unit_interval unit_interval_topology Y Ty (compose_fun unit_interval eps k))
      (apply_fun (compose_fun unit_interval eps h) 0 = y0)
      (apply_fun (compose_fun unit_interval eps h) 1 = y0)
      (apply_fun (compose_fun unit_interval eps k) 0 = y0)
      (apply_fun (compose_fun unit_interval eps k) 1 = y0)
      HhepsCont HkepsCont Hheps0 Hheps1 Hkeps0 Hkeps1).
  - witness F.
    exact (and5I
      (continuous_map unit_square unit_square_topology Y Ty F)
      (forall s:set, s :e unit_interval ->
        apply_fun F (s, 0) = apply_fun (compose_fun unit_interval eps h) s)
      (forall s:set, s :e unit_interval ->
        apply_fun F (s, 1) = apply_fun (compose_fun unit_interval eps k) s)
      (forall t:set, t :e unit_interval ->
        apply_fun F (0, t) = y0)
      (forall t:set, t :e unit_interval ->
        apply_fun F (1, t) = y0)
      HFcont HF_s0 HF_s1 HF_0t HF_1t).
}
(** Conclude: [h o eps] = [k o eps] **)
exact (path_homotopy_class_loop_eq_of_path_homotopic Y Ty y0
  (compose_fun unit_interval eps h) (compose_fun unit_interval eps k)
  Hhomotopic_heps_keps).
Qed.

(** from S58 Thm 58.2 (line 1284 in algtop.tex) **)
(** LATEX VERSION: The inclusion map j: S^n -> R^{n+1}-0 induces an isomorphism of fundamental groups. **)
(** EFFORT: 8 lines textbook, difficulty 4/10, USD 80 **)
(** Collected Bob 88 **)
(** Proven Bob **)
Theorem thm58_2_inclusion_Sn_isomorphism : forall n:set, n :e omega ->
  forall b0:set, b0 :e Sn n ->
  group_isomorphism
    (fundamental_group (Sn n) (Sn_topology n) b0)
    (fundamental_group_mult (Sn n) (Sn_topology n) b0)
    (fundamental_group (Rn_minus_origin (ordsucc n)) (Rn_minus_origin_topology (ordsucc n)) b0)
    (fundamental_group_mult (Rn_minus_origin (ordsucc n)) (Rn_minus_origin_topology (ordsucc n)) b0)
    (induced_homomorphism (Sn n) (Sn_topology n) b0
      (Rn_minus_origin (ordsucc n)) (Rn_minus_origin_topology (ordsucc n)) b0
      (graph (Sn n) (fun x:set => x))).
let n.
assume Hn_om.
let b0.
assume Hb0Sn.
set A := Sn n.
set Ta := Sn_topology n.
set X := Rn_minus_origin (ordsucc n).
set Tx := Rn_minus_origin_topology (ordsucc n).
set j := graph A (fun x:set => x).
set r := Rn_normalize_to_Sn n.
set GA := fundamental_group A Ta b0.
set multA := fundamental_group_mult A Ta b0.
set GX := fundamental_group X Tx b0.
set multX := fundamental_group_mult X Tx b0.
set jstar := induced_homomorphism A Ta b0 X Tx b0 j.
set rstar := induced_homomorphism X Tx b0 A Ta b0 r.
claim Hb0X : b0 :e X.
{
  exact (Sn_subset_Rn_minus_origin
    n
    b0
    Hn_om
    Hb0Sn).
}
claim HtopA : topology_on A Ta.
{
  exact (subspace_topology_is_topology
    (euclidean_space (ordsucc n))
    (euclidean_topology (ordsucc n))
    A
    (euclidean_topology_is_topology
      (ordsucc n))
    (Sep_Subq
      (euclidean_space (ordsucc n))
      (fun v:set => euclidean_norm_sq (ordsucc n) v = 1))).
}
claim HtopX : topology_on X Tx.
{
  exact (subspace_topology_is_topology
    (euclidean_space (ordsucc n))
    (euclidean_topology (ordsucc n))
    X
    (euclidean_topology_is_topology
      (ordsucc n))
    (Sep_Subq
      (euclidean_space (ordsucc n))
      (fun v:set => ~(forall i:set, i :e ordsucc n -> apply_fun v i = 0)))).
}
claim HjCont :
  continuous_map A Ta X Tx j.
{
  exact (Sn_inclusion_Rn_minus_origin_continuous
    n
    Hn_om).
}
claim HrCont :
  continuous_map X Tx A Ta r.
{
  exact (Rn_normalize_to_Sn_continuous
    n
    Hn_om).
}
claim Hjb0 : apply_fun j b0 = b0.
{
  exact (apply_fun_graph
    A
    (fun x:set => x)
    b0
    Hb0Sn).
}
claim Hrb0 : apply_fun r b0 = b0.
{
  exact (Rn_normalize_to_Sn_fix_on_Sn
    n
    b0
    Hn_om
    Hb0Sn).
}
claim HjstarHom :
  group_homomorphism GA multA GX multX jstar.
{
  exact (induced_homomorphism_is_homomorphism
    A
    Ta
    b0
    X
    Tx
    b0
    j
    HjCont
    Hjb0
    Hb0Sn).
}
claim HrstarHom :
  group_homomorphism GX multX GA multA rstar.
{
  exact (induced_homomorphism_is_homomorphism
    X
    Tx
    b0
    A
    Ta
    b0
    r
    HrCont
    Hrb0
    Hb0X).
}
claim HjFun : function_on j A X.
{
  exact (continuous_map_function_on
    A
    Ta
    X
    Tx
    j
    HjCont).
}
claim HrFun : function_on r X A.
{
  exact (continuous_map_function_on
    X
    Tx
    A
    Ta
    r
    HrCont).
}
claim HcompjrEq :
  compose_fun A j r = graph A (fun x:set => x).
{
  apply (total_function_space_extensional
    A
    A
    (compose_fun A j r)
    (graph A (fun x:set => x))).
  - exact (compose_fun_in_total_function_space
      A
      X
      A
      j
      r
      HjFun
      HrFun).
  - exact (graph_in_total_function_space
      A
      A
      (fun x:set => x)
      (fun x Hx => Hx)).
  - let x.
    assume HxA.
    rewrite (compose_fun_apply
      A
      j
      r
      x
      HxA).
    rewrite (apply_fun_graph
      A
      (fun z:set => z)
      x
      HxA) at 2.
    rewrite (apply_fun_graph
      A
      (fun z:set => z)
      x
      HxA).
    exact (Rn_normalize_to_Sn_fix_on_Sn
      n
      x
      Hn_om
      HxA).
}
claim Hrstar_jstar_id :
  forall cls:set, cls :e GA ->
    apply_fun (compose_fun GA jstar rstar) cls = cls.
{
  let cls.
  assume Hcls.
  claim Hcomp :
    apply_fun (induced_homomorphism A Ta b0 A Ta b0 (compose_fun A j r)) cls =
    apply_fun (compose_fun GA jstar rstar) cls.
  {
    exact (Theorem_52_4_functorial_composition
      A
      Ta
      b0
      X
      Tx
      b0
      A
      Ta
      b0
      j
      r
      HjCont
      HrCont
      Hjb0
      Hrb0
      Hb0Sn
      cls
      Hcls).
  }
  claim Hid :
    apply_fun (induced_homomorphism A Ta b0 A Ta b0 (compose_fun A j r)) cls = cls.
  {
    rewrite HcompjrEq.
    exact (Theorem_52_4_functorial_identity
      A
      Ta
      b0
      HtopA
      Hb0Sn
      cls
      Hcls).
  }
  exact (eq_i_tra
    (apply_fun (compose_fun GA jstar rstar) cls)
    (apply_fun (induced_homomorphism A Ta b0 A Ta b0 (compose_fun A j r)) cls)
    cls
    (eq_symm
      (apply_fun (induced_homomorphism A Ta b0 A Ta b0 (compose_fun A j r)) cls)
      (apply_fun (compose_fun GA jstar rstar) cls)
      Hcomp)
    Hid).
}
(** Remaining geometric step: j o r is homotopic to id_X with basepoint fixed at b0. **)
claim Hjstar_rstar_id :
  forall cls:set, cls :e GX ->
    apply_fun (compose_fun GX rstar jstar) cls = cls.
{
  set hX := compose_fun X r j.
  set idXMap := graph X (fun x:set => x).
  claim HhXDef : hX = compose_fun X r j.
  {
    reflexivity.
  }
  claim HidXDef : idXMap = graph X (fun x:set => x).
  {
    reflexivity.
  }
  claim HhXCont : continuous_map X Tx X Tx hX.
  {
    rewrite HhXDef.
    exact (composition_continuous
      X
      Tx
      A
      Ta
      X
      Tx
      r
      j
      HrCont
      HjCont).
  }
  claim HidXCont : continuous_map X Tx X Tx idXMap.
  {
    rewrite HidXDef.
    exact (identity_continuous
      X
      Tx
      HtopX).
  }
  claim HhXb0 : apply_fun hX b0 = b0.
  {
    rewrite HhXDef.
    rewrite (compose_fun_apply
      X
      r
      j
      b0
      Hb0X).
    rewrite Hrb0.
    exact Hjb0.
  }
  claim HidXb0 : apply_fun idXMap b0 = b0.
  {
    rewrite HidXDef.
    exact (apply_fun_graph
      X
      (fun x:set => x)
      b0
      Hb0X).
  }
  claim HexH :
    exists H:set, continuous_map (setprod X unit_interval)
      (product_topology X Tx unit_interval unit_interval_topology) X Tx H /\
      (forall x:set, x :e X -> apply_fun H (x, 0) = apply_fun hX x) /\
      (forall x:set, x :e X -> apply_fun H (x, 1) = apply_fun idXMap x) /\
      (forall t:set, t :e unit_interval -> apply_fun H (b0, t) = b0).
  {
    claim Hn_nat : nat_p n.
    {
      exact (omega_nat_p
        n
        Hn_om).
    }
    claim Hsn_om : ordsucc n :e omega.
    {
      exact (omega_ordsucc
        n
        Hn_om).
    }
    claim HrDef : r = Rn_normalize_to_Sn n.
    {
      reflexivity.
    }
    set dom := setprod X unit_interval.
    set Tdom := product_topology X Tx unit_interval unit_interval_topology.
    set normX := Rn_minus_origin_norm_map (ordsucc n).
    set H := graph dom (fun p:set =>
      Rn_scalar_mult
        (ordsucc n)
        (add_SNo
          (apply_fun flip_unit_interval (p 1))
          (mul_SNo
            (p 1)
            (apply_fun normX (p 0))))
        (apply_fun r (p 0))).
    claim HnormCont :
      continuous_map X Tx R R_standard_topology normX.
    {
      exact (Rn_minus_origin_norm_map_continuous_to_R
        (ordsucc n)
        Hsn_om).
    }
    claim HHcont :
      continuous_map dom Tdom X Tx H.
    {
      claim HcontEu :
        continuous_map
          dom
          Tdom
          (euclidean_space (ordsucc n))
          (euclidean_topology (ordsucc n))
          H.
      {
        set xproj := projection_map1 X unit_interval.
        set tproj := projection_map2 X unit_interval.
        set one_minus_t := compose_fun dom tproj flip_unit_interval.
        set norm_proj := compose_fun dom xproj normX.
        set tnorm := compose_fun dom (pair_map dom tproj norm_proj) mul_fun_R.
        set lam_raw := compose_fun dom (pair_map dom one_minus_t tnorm) add_fun_R.
        set lam := graph dom (fun p:set =>
          add_SNo
            (apply_fun flip_unit_interval (p 1))
            (mul_SNo
              (p 1)
              (apply_fun normX (p 0)))).
        set rx := compose_fun dom xproj r.
        claim HtopDom :
          topology_on dom Tdom.
        {
          exact (product_topology_is_topology
            X
            Tx
            unit_interval
            unit_interval_topology
            HtopX
            unit_interval_topology_on).
        }
        claim HprojPair :
          continuous_map dom Tdom X Tx xproj /\
          continuous_map dom Tdom unit_interval unit_interval_topology tproj.
        {
          exact (projection_maps_continuous
            X
            Tx
            unit_interval
            unit_interval_topology
            HtopX
            unit_interval_topology_on).
        }
        claim HxprojCont :
          continuous_map dom Tdom X Tx xproj.
        {
          exact (andEL
            (continuous_map dom Tdom X Tx xproj)
            (continuous_map dom Tdom unit_interval unit_interval_topology tproj)
            HprojPair).
        }
        claim HtprojContI :
          continuous_map dom Tdom unit_interval unit_interval_topology tproj.
        {
          exact (andER
            (continuous_map dom Tdom X Tx xproj)
            (continuous_map dom Tdom unit_interval unit_interval_topology tproj)
            HprojPair).
        }
        claim HtprojContR :
          continuous_map dom Tdom R R_standard_topology tproj.
        {
          exact (continuous_map_range_expand
            dom
            Tdom
            unit_interval
            unit_interval_topology
            R
            R_standard_topology
            tproj
            HtprojContI
            unit_interval_sub_R
            R_standard_topology_is_topology
            (fun P H => H)).
        }
        claim HoneMinusContI :
          continuous_map dom Tdom unit_interval unit_interval_topology one_minus_t.
        {
          exact (composition_continuous
            dom
            Tdom
            unit_interval
            unit_interval_topology
            unit_interval
            unit_interval_topology
            tproj
            flip_unit_interval
            HtprojContI
            flip_unit_interval_continuous).
        }
        claim HoneMinusContR :
          continuous_map dom Tdom R R_standard_topology one_minus_t.
        {
          exact (continuous_map_range_expand
            dom
            Tdom
            unit_interval
            unit_interval_topology
            R
            R_standard_topology
            one_minus_t
            HoneMinusContI
            unit_interval_sub_R
            R_standard_topology_is_topology
            (fun P H => H)).
        }
        claim HnormProjCont :
          continuous_map dom Tdom R R_standard_topology norm_proj.
        {
          exact (composition_continuous
            dom
            Tdom
            X
            Tx
            R
            R_standard_topology
            xproj
            normX
            HxprojCont
            HnormCont).
        }
        claim HtnormCont :
          continuous_map dom Tdom R R_standard_topology tnorm.
        {
          exact (mul_two_continuous_R
            dom
            Tdom
            tproj
            norm_proj
            HtopDom
            HtprojContR
            HnormProjCont).
        }
        claim HlamRawCont :
          continuous_map dom Tdom R R_standard_topology lam_raw.
        {
          exact (add_two_continuous_R
            dom
            Tdom
            one_minus_t
            tnorm
            HtopDom
            HoneMinusContR
            HtnormCont).
        }
        claim Hlam_val_in_R :
          forall p:set, p :e dom ->
            add_SNo
              (apply_fun flip_unit_interval (p 1))
              (mul_SNo
                (p 1)
                (apply_fun normX (p 0))) :e R.
        {
          let p.
          assume Hp.
          claim Hp0X : p 0 :e X.
          {
            exact (ap0_Sigma
              X
              (fun _ : set => unit_interval)
              p
              Hp).
          }
          claim Hp1I : p 1 :e unit_interval.
          {
            exact (ap1_Sigma
              X
              (fun _ : set => unit_interval)
              p
              Hp).
          }
          exact (real_add_SNo
            (apply_fun flip_unit_interval (p 1))
            (flip_unit_interval_in_R
              (p 1)
              Hp1I)
            (mul_SNo
              (p 1)
              (apply_fun normX (p 0)))
            (real_mul_SNo
              (p 1)
              (SepE1
                R
                (fun s:set => ~(Rlt s 0) /\ ~(Rlt 1 s))
                (p 1)
                Hp1I)
              (apply_fun normX (p 0))
              (continuous_map_function_on
                X
                Tx
                R
                R_standard_topology
                normX
                HnormCont
                (p 0)
                Hp0X))).
        }
        claim HlamFun :
          function_on lam dom R.
        {
          exact (function_on_of_function_space
            lam
            dom
            R
            (graph_in_function_space
              dom
              R
              (fun p:set =>
                add_SNo
                  (apply_fun flip_unit_interval (p 1))
                  (mul_SNo
                    (p 1)
                    (apply_fun normX (p 0))))
              (fun p Hp =>
                Hlam_val_in_R
                  p
                  Hp))).
        }
        claim HlamRawEqOn :
          forall p:set, p :e dom -> apply_fun lam_raw p = apply_fun lam p.
        {
          let p.
          assume Hp.
          claim HoneMinusR :
            apply_fun one_minus_t p :e R.
          {
            exact (continuous_map_function_on
              dom
              Tdom
              R
              R_standard_topology
              one_minus_t
              HoneMinusContR
              p
              Hp).
          }
          claim HtnormR :
            apply_fun tnorm p :e R.
          {
            exact (continuous_map_function_on
              dom
              Tdom
              R
              R_standard_topology
              tnorm
              HtnormCont
              p
              Hp).
          }
          rewrite (add_of_pair_map_apply
            dom
            one_minus_t
            tnorm
            p
            Hp
            HoneMinusR
            HtnormR).
          rewrite (compose_fun_apply
            dom
            tproj
            flip_unit_interval
            p
            Hp).
          rewrite (projection2_apply
            X
            unit_interval
            p
            Hp).
          rewrite (mul_of_pair_map_apply
            dom
            tproj
            norm_proj
            p
            Hp
            (continuous_map_function_on
              dom
              Tdom
              R
              R_standard_topology
              tproj
              HtprojContR
              p
              Hp)
            (continuous_map_function_on
              dom
              Tdom
              R
              R_standard_topology
              norm_proj
              HnormProjCont
              p
              Hp)).
          rewrite (projection2_apply
            X
            unit_interval
            p
            Hp).
          rewrite (compose_fun_apply
            dom
            xproj
            normX
            p
            Hp).
          rewrite (projection1_apply
            X
            unit_interval
            p
            Hp).
          symmetry.
          exact (apply_fun_graph
            dom
            (fun p0:set =>
              add_SNo
                (apply_fun flip_unit_interval (p0 1))
                (mul_SNo
                  (p0 1)
                  (apply_fun normX (p0 0))))
            p
            Hp).
        }
        claim HlamCont :
          continuous_map dom Tdom R R_standard_topology lam.
        {
          exact (continuous_map_congr_on
            dom
            Tdom
            R
            R_standard_topology
            lam_raw
            lam
            HlamRawCont
            HlamFun
            HlamRawEqOn).
        }
        claim HrxCont :
          continuous_map dom Tdom A Ta rx.
        {
          exact (composition_continuous
            dom
            Tdom
            X
            Tx
            A
            Ta
            xproj
            r
            HxprojCont
            HrCont).
        }
        set Fcoord := graph (ordsucc n) (fun i:set =>
          graph dom (fun p:set =>
            mul_SNo
              (apply_fun lam p)
              (apply_fun (apply_fun r (p 0)) i))).
        claim Hcoord_val_in_R :
          forall i p:set, i :e ordsucc n -> p :e dom ->
            mul_SNo
              (apply_fun lam p)
              (apply_fun (apply_fun r (p 0)) i) :e R.
        {
          let i p.
          assume Hi Hp.
          claim Hp0X : p 0 :e X.
          {
            exact (ap0_Sigma
              X
              (fun _ : set => unit_interval)
              p
              Hp).
          }
          claim Hr0A : apply_fun r (p 0) :e A.
          {
            exact (HrFun
              (p 0)
              Hp0X).
          }
          exact (real_mul_SNo
            (apply_fun lam p)
            (continuous_map_function_on
              dom
              Tdom
              R
              R_standard_topology
              lam
              HlamCont
              p
              Hp)
            (apply_fun (apply_fun r (p 0)) i)
            (euclidean_space_coord_in_R
              (ordsucc n)
              (apply_fun r (p 0))
              i
              (SepE1
                (euclidean_space (ordsucc n))
                (fun v:set => euclidean_norm_sq (ordsucc n) v = 1)
                (apply_fun r (p 0))
                Hr0A)
              Hi)).
        }
        claim HFcoord_total :
          total_function_on Fcoord (ordsucc n) (function_space dom R).
        {
          apply (total_function_on_graph
            (ordsucc n)
            (function_space dom R)
            (fun i:set =>
              graph dom (fun p:set =>
                mul_SNo
                  (apply_fun lam p)
                  (apply_fun (apply_fun r (p 0)) i)))).
          let i.
          assume Hi.
          exact (graph_in_function_space
            dom
            R
            (fun p:set =>
