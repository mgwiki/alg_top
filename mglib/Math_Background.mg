    phi
    HphiIso).
}
claim H0Int : 0 :e int.
{
  exact (Subq_omega_int
    0
    (nat_p_omega 0 nat_0)).
}
claim H1Int : 1 :e int.
{
  exact (Subq_omega_int
    1
    (nat_p_omega 1 nat_1)).
}
claim Hpre0 :
  exists cls0:set,
