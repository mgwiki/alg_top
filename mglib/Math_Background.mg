Axiom metric_dist_to_set_approx : forall X d x A eps : set , metric_on X d -> x :e X -> A c= X -> A <> Empty -> eps :e R -> Rlt 0 eps -> exists a : set , a :e A /\ a :e X /\ Rlt (apply_fun d (x,a)) (add_SNo (metric_dist_to_set X d x A) eps).
Axiom metric_dist_to_set_Lipschitz : forall X d x y A : set , metric_on X d -> x :e X -> y :e X -> A c= X -> A <> Empty -> Rle (metric_dist_to_set X d y A) (add_SNo (metric_dist_to_set X d x A) (apply_fun d (x,y))).
Axiom metric_dist_to_closed_set_pos_if_not_mem : forall X d B x : set , metric_on X d -> closed_in X (metric_topology X d) B -> x :e X -> x /:e B -> B <> Empty -> Rlt 0 (metric_dist_to_set X d x B).
