Axiom Stone_ex32_9_fixcoord_open_stub : forall J x i : set , uncountable_set J -> x :e Stone_ex32_9_space J -> i :e J -> {y :e Stone_ex32_9_space J|apply_fun y i = apply_fun x i} :e Stone_ex32_9_topology J.
Axiom Stone_ex32_9_U_open_stub : forall J x B : set , uncountable_set J -> x :e Stone_ex32_9_space J -> finite B -> B c= J -> Stone_ex32_9_U J x B :e Stone_ex32_9_topology J.
Axiom Stone_ex32_9_fixcoord_value_open : forall J i m : set , uncountable_set J -> i :e J -> m :e Zplus -> {y :e Stone_ex32_9_space J|apply_fun y i = m} :e Stone_ex32_9_topology J.
