  claim HxAB : x :e A :/\: B.
  {
    exact (binintersectI
      A
      B
      x
      HxA
      HxB).
  }
  claim HxEmpty : x :e Empty.
  {
    exact (mem_eqR
      x
      (A :/\: B)
      Empty
      HABdisj
      HxAB).
  }
  exact (FalseE
    (EmptyE x HxEmpty)
    (x :e Empty)).
}
exact (HsepE
  (A :/\: E)
  (B :/\: E)
  HclAE
  HclBE
  HABEempty).
Qed.

