(** S55 helper: a two-cycle witness on S1 forces a map to be non-identity. **)
(** Proven Bob **)
Theorem s55_two_cycle_witness_implies_nonidentity_graph_S1 : forall f:set,
  (exists x:set, exists y:set,
    ((x :e S1 /\ y :e S1) /\ x <> y) /\
    apply_fun f x = y /\
    apply_fun f y = x)
  ->
  f <> graph S1 (fun x:set => x).
let f.
assume Hcycle.
assume HfId.
apply Hcycle.
let x.
assume HyExists.
apply HyExists.
let y.
assume Hpack.
claim Hleft :
  (((x :e S1 /\ y :e S1) /\ x <> y) /\
    apply_fun f x = y).
{
  exact (andEL
    (((x :e S1 /\ y :e S1) /\ x <> y) /\
      apply_fun f x = y)
    (apply_fun f y = x)
    Hpack).
}
claim HxyPack :
  ((x :e S1 /\ y :e S1) /\ x <> y).
{
  exact (andEL
    ((x :e S1 /\ y :e S1) /\ x <> y)
    (apply_fun f x = y)
    Hleft).
}
claim HxS1 : x :e S1.
{
  exact (andEL
    (x :e S1)
    (y :e S1)
    (andEL
      (x :e S1 /\ y :e S1)
      (x <> y)
      HxyPack)).
}
claim HxyNe : x <> y.
{
  exact (andER
    (x :e S1 /\ y :e S1)
    (x <> y)
    HxyPack).
}
claim HfxEqY :
  apply_fun f x = y.
{
  exact (andER
    ((x :e S1 /\ y :e S1) /\ x <> y)
    (apply_fun f x = y)
    Hleft).
}
claim HfxEqX :
  apply_fun f x = x.
{
  rewrite HfId.
  rewrite (apply_fun_graph
    S1
    (fun z:set => z)
    x
    HxS1).
  reflexivity.
}
claim HyEqX : y = x.
{
  exact (eq_i_tra
    y
    (apply_fun f x)
    x
    (eq_symm
      (apply_fun f x)
      y
      HfxEqY)
    HfxEqX).
}
exact (HxyNe
  (eq_symm
    y
    x
    HyEqX)).
Qed.

