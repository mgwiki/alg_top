  { exact (Hinf1 alpha Halpha). }
  claim Hinf1raw' :
    infinite_cyclic_subgroup G1 mult e inv (apply_fun gens alpha).
  {
    rewrite <- (apply_fun_graph J (fun beta:set => apply_fun gens beta) alpha Halpha).
    exact Hinf1raw.
  }
  exact Hinf1raw'.
