												            }
												            rewrite Hieq.
												            exact Hmid.
												      - assume Ht_ne1.
												        (** Compare prefixes by IH on the predecessor of t, then glue with suffix equality. **)
												        claim Ht_succ : exists tp:set, nat_p tp /\ t = ordsucc tp.
												        {
											          apply (nat_inv t Ht_nat).
