    + exact Hend.
    + exact (orIR (q = p) (q = q) Hqq).
}
exact (SepI
  X
  (fun x:set => exists A0:set, A0 :e Arcs /\
    exists p0 q0:set, end_points_of_arc A0 (subspace_topology X Tx A0) p0 q0 /\
      (x = p0 \/ x = q0))
