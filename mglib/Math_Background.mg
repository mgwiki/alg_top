(** S51 helper: any map I -> Y is homotopic to the constant map at its initial value **)
(** Proven Bob **)
Theorem s51_maps_from_I_homotopic_to_start : forall Y Ty u:set,
  continuous_map unit_interval unit_interval_topology Y Ty u ->
  homotopic_maps
    unit_interval
    unit_interval_topology
    Y
    Ty
    u
    (const_fun unit_interval (apply_fun u 0)).
let Y Ty u.
assume Hu.
claim HtopY : topology_on Y Ty.
{
  exact (continuous_map_topology_cod
    unit_interval
    unit_interval_topology
    Y
    Ty
    u
    Hu).
}
claim HuFun : function_on u unit_interval Y.
{
  exact (continuous_map_function_on
    unit_interval
    unit_interval_topology
    Y
    Ty
    u
    Hu).
}
claim Hu0Y : apply_fun u 0 :e Y.
{
  exact (HuFun
    0
    zero_in_unit_interval).
}
claim HprojPair :
  continuous_map
    unit_square
    unit_square_topology
    unit_interval
    unit_interval_topology
    (projection_map1 unit_interval unit_interval)
  /\
  continuous_map
    unit_square
    unit_square_topology
    unit_interval
    unit_interval_topology
    (projection_map2 unit_interval unit_interval).
{
  exact (projection_maps_continuous
    unit_interval
    unit_interval_topology
    unit_interval
    unit_interval_topology
    unit_interval_topology_on
    unit_interval_topology_on).
}
claim Hproj1 :
  continuous_map
    unit_square
    unit_square_topology
    unit_interval
    unit_interval_topology
    (projection_map1 unit_interval unit_interval).
{
  exact (andEL
    (continuous_map
      unit_square
      unit_square_topology
      unit_interval
      unit_interval_topology
      (projection_map1 unit_interval unit_interval))
    (continuous_map
      unit_square
      unit_square_topology
      unit_interval
      unit_interval_topology
      (projection_map2 unit_interval unit_interval))
    HprojPair).
}
claim Hproj2 :
  continuous_map
    unit_square
    unit_square_topology
    unit_interval
    unit_interval_topology
    (projection_map2 unit_interval unit_interval).
{
  exact (andER
    (continuous_map
      unit_square
      unit_square_topology
      unit_interval
      unit_interval_topology
      (projection_map1 unit_interval unit_interval))
    (continuous_map
      unit_square
      unit_square_topology
      unit_interval
      unit_interval_topology
      (projection_map2 unit_interval unit_interval))
    HprojPair).
}
set one_minus_t := compose_fun
  unit_square
  (projection_map2 unit_interval unit_interval)
  flip_unit_interval.
claim HoneMinusTCont :
  continuous_map
    unit_square
    unit_square_topology
    unit_interval
    unit_interval_topology
    one_minus_t.
{
  exact (composition_continuous
    unit_square
    unit_square_topology
    unit_interval
    unit_interval_topology
    unit_interval
    unit_interval_topology
    (projection_map2 unit_interval unit_interval)
    flip_unit_interval
    Hproj2
    flip_unit_interval_continuous).
}
set arg := compose_fun
  unit_square
  (pair_map
    unit_square
    (projection_map1 unit_interval unit_interval)
    one_minus_t)
  mul_fun_R.
claim HargCont :
  continuous_map
    unit_square
    unit_square_topology
    unit_interval
    unit_interval_topology
    arg.
{
  exact (mul_two_continuous_unit_interval
    unit_square
    unit_square_topology
    (projection_map1 unit_interval unit_interval)
    one_minus_t
    (product_topology_is_topology
      unit_interval
      unit_interval_topology
      unit_interval
      unit_interval_topology
      unit_interval_topology_on
      unit_interval_topology_on)
    Hproj1
    HoneMinusTCont).
}
set F := compose_fun unit_square arg u.
claim HFCont :
  continuous_map
    unit_square
    unit_square_topology
    Y
    Ty
    F.
{
  exact (composition_continuous
    unit_square
    unit_square_topology
    unit_interval
    unit_interval_topology
    Y
    Ty
    arg
    u
    HargCont
    Hu).
}
claim HconstCont :
  continuous_map
    unit_interval
    unit_interval_topology
    Y
    Ty
    (const_fun unit_interval (apply_fun u 0)).
{
