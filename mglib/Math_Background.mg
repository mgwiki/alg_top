      { exact (andER (k :e n)
          ((k :e Uset /\ ordsucc k :e Vset) \/ (k :e Vset /\ ordsucc k :e Uset))
          Hkpack). }
      set a := apply_fun t_seq k.
      witness a.
      apply andI.
