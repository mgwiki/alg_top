												          + assume Hi_not1.
												            apply (nat_add_nat_decomp_beyond_left n1A n2A i Hn1A_nat Hn2A_nat Hi_sum Hi_not1).
												            let j. assume Hj_pack.
												            claim Hj2A : j :e n2A.
