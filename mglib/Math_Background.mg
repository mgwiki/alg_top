               (forall j:set, j :e n2 ->
                apply_fun ws2 j = apply_fun xs2 j)).
          apply Huof2Pack.
          let ws2.
          assume HpairPack :
            reduced_word J ImageFam efam_int n1 ws1 /\
            reduced_word J ImageFam efam_int n2 ws2 /\
            word_product multG eG ws1 n1 = x /\
            word_product multG eG ws2 n2 = x /\
