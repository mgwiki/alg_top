(** Proven Bob **)
Lemma binintersect_empty_no_common :
  forall J K a:set,
  J :/\: K = Empty ->
  a :e J -> a :e K -> False.
let J K a.
assume Hinter HaJ HaK.
claim HaJK : a :e J :/\: K.
{ exact (binintersectI J K a HaJ HaK). }
claim HaEmpty : a :e Empty.
{ exact (eq_subst_mem_set a (J :/\: K) Empty HaJK Hinter). }
exact (EmptyE a HaEmpty).
Qed.

