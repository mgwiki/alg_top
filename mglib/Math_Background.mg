		                        HgrpG
		                        Hh_hom
		                        Hb2G
		                        HtO).
		                    }
		                    claim HpowImg :
		                      group_power_nat multG eG (apply_fun h (apply_fun basis2 alpha)) t :e ImgAlpha.
		                    { exact (Hpow_cl_img
		                        (apply_fun h (apply_fun basis2 alpha))
		                        Hhb2Img
