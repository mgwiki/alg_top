              k
              (fun t:set => group_power_nat mult e x t)
              r
              Hrk).
          - assume HnegCase.
            apply HnegCase.
            let m0.
            assume Hm0Pack.
            claim Hm0O : m0 :e omega.
            {
              exact (andEL
                (m0 :e omega)
                (n = minus_SNo (ordsucc m0))
                (andEL
                  (m0 :e omega /\ n = minus_SNo (ordsucc m0))
