claim Hx2FS : x2 :e function_space S1 R.
{
  exact (graph_in_function_space
    S1
    R
    (fun _ : set => 0)
    (fun _ _ => real_0)).
}
claim H0in3 : 0 :e 3.
{ exact (ordsuccI1 2 0 In_0_2). }
claim H1in3 : 1 :e 3.
{ exact (ordsuccI1 2 1 In_1_2). }
claim H2in3 : 2 :e 3.
{ exact In_2_3. }
set F3 := graph 3 (fun i:set => if i = 0 then x0 else if i = 1 then x1 else x2).
claim HF3_tfn : total_function_on F3 3 (function_space S1 R).
{
  apply (total_function_on_graph 3 (function_space S1 R)).
  let i.
  assume Hi3.
  apply (ordsuccE 2 i Hi3).
  - assume Hi2.
    apply (ordsuccE 1 i Hi2).
    + assume Hi1.
      apply (ordsuccE 0 i Hi1).
      * assume Hi0.
        exact (EmptyE i Hi0
          ((if i = 0 then x0 else if i = 1 then x1 else x2) :e function_space S1 R)).
      * assume Hieq0.
        rewrite Hieq0.
        exact (eq_subst_mem
          (if 0 = 0 then x0 else if 0 = 1 then x1 else x2)
          x0
          (function_space S1 R)
          (If_i_1 (0 = 0) x0 (if 0 = 1 then x1 else x2) (eq_refl 0))
          Hx0FS).
    + assume Hieq1.
      rewrite Hieq1.
      exact (eq_subst_mem
        (if 1 = 0 then x0 else if 1 = 1 then x1 else x2)
        x1
        (function_space S1 R)
        (eq_i_tra
          (if 1 = 0 then x0 else if 1 = 1 then x1 else x2)
          (if 1 = 1 then x1 else x2)
          x1
          (If_i_0 (1 = 0) x0 (if 1 = 1 then x1 else x2) neq_1_0)
          (If_i_1 (1 = 1) x1 x2 (eq_refl 1)))
        Hx1FS).
  - assume Hieq2.
    rewrite Hieq2.
    exact (eq_subst_mem
      (if 2 = 0 then x0 else if 2 = 1 then x1 else x2)
      x2
      (function_space S1 R)
      (eq_i_tra
        (if 2 = 0 then x0 else if 2 = 1 then x1 else x2)
        (if 2 = 1 then x1 else x2)
        x2
        (If_i_0 (2 = 0) x0 (if 2 = 1 then x1 else x2) neq_2_0)
        (If_i_0 (2 = 1) x1 x2
          (fun H:2=1 => In_irref 1 (H (fun t _ => 1 :e t) In_1_2))))
      Hx2FS).
}
claim HF3_cond : forall i:set, i :e 3 ->
  continuous_map S1 S1_topology R R_standard_topology (apply_fun F3 i).
{
  let i.
  assume Hi3.
  apply (ordsuccE 2 i Hi3).
  - assume Hi2.
    apply (ordsuccE 1 i Hi2).
    + assume Hi1.
      apply (ordsuccE 0 i Hi1).
      * assume Hi0.
        exact (EmptyE i Hi0
          (continuous_map S1 S1_topology R R_standard_topology (apply_fun F3 i))).
      * assume Hieq0.
        rewrite Hieq0.
        rewrite (apply_fun_graph 3 (fun j:set => if j = 0 then x0 else if j = 1 then x1 else x2) 0 H0in3).
        rewrite (If_i_1 (0 = 0) x0 (if 0 = 1 then x1 else x2) (eq_refl 0)).
        exact Hx0Cont.
    + assume Hieq1.
      rewrite Hieq1.
      rewrite (apply_fun_graph 3 (fun j:set => if j = 0 then x0 else if j = 1 then x1 else x2) 1 H1in3).
      rewrite (If_i_0 (1 = 0) x0 (if 1 = 1 then x1 else x2) neq_1_0).
      rewrite (If_i_1 (1 = 1) x1 x2 (eq_refl 1)).
      exact Hx1Cont.
  - assume Hieq2.
    rewrite Hieq2.
    rewrite (apply_fun_graph 3 (fun j:set => if j = 0 then x0 else if j = 1 then x1 else x2) 2 H2in3).
    rewrite (If_i_0 (2 = 0) x0 (if 2 = 1 then x1 else x2) neq_2_0).
    rewrite (If_i_0 (2 = 1) x1 x2
      (fun H:2=1 => In_irref 1 (H (fun t _ => 1 :e t) In_1_2))).
    exact Hx2Cont.
}
claim H3ne : 3 <> Empty.
{
  exact (fun H => EmptyE 0 (H (fun t _ => 0 :e t) H0in3)).
}
claim HdiagCont :
  continuous_map S1 S1_topology (euclidean_space 3) (euclidean_topology 3)
    (diagonal_map S1 F3 3).
{
  exact (diagonal_map_continuous_power_real
    S1
    S1_topology
    F3
    3
    (subspace_topology_is_topology
      (setprod R R)
      R2_topology
      S1
      HtopR2
      HS1subR2)
    H3ne
    HF3_tfn
    HF3_cond).
}
claim HdiagFon :
  function_on (diagonal_map S1 F3 3) S1 (euclidean_space 3).
{
  exact (diagonal_map_function_on_power_real
    S1
    F3
    3
    HF3_tfn).
}
claim HequatorFunE3 :
  function_on S1_equator_in_S2 S1 (euclidean_space 3).
{
  exact (function_on_of_function_space
    S1_equator_in_S2
    S1
    (euclidean_space 3)
    (graph_in_function_space
      S1
      (euclidean_space 3)
      (fun z:set =>
        graph 3 (fun i:set =>
          if i = 0 then z 0 else if i = 1 then z 1 else 0))
      (fun z Hz =>
        eq_subst_mem
          (graph 3 (fun i:set =>
            if i = 0 then z 0 else if i = 1 then z 1 else 0))
          (apply_fun S1_equator_in_S2 z)
          (euclidean_space 3)
          (eq_symm
            (apply_fun S1_equator_in_S2 z)
            (graph 3 (fun i:set =>
              if i = 0 then z 0 else if i = 1 then z 1 else 0))
            (apply_fun_graph
              S1
              (fun z0:set =>
                graph 3 (fun i:set =>
                  if i = 0 then z0 0 else if i = 1 then z0 1 else 0))
              z
              Hz))
          (SepE1
            (euclidean_space 3)
            (fun v:set => euclidean_norm_sq 3 v = 1)
            (apply_fun S1_equator_in_S2 z)
            (S1_equator_in_S2_in_Sn2 z Hz))))).
}
claim HdiagEq : forall z:set, z :e S1 ->
  apply_fun (diagonal_map S1 F3 3) z = apply_fun S1_equator_in_S2 z.
{
  let z.
  assume HzS1.
  claim HzR2 : z :e setprod R R.
  {
    exact (SepE1
      (setprod R R)
      (fun p:set =>
        add_SNo (mul_SNo (p 0) (p 0))
          (mul_SNo (p 1) (p 1)) = 1)
      z
      HzS1).
  }
  claim HequatorE3 : apply_fun S1_equator_in_S2 z :e euclidean_space 3.
  {
    exact (SepE1
      (euclidean_space 3)
      (fun v:set => euclidean_norm_sq 3 v = 1)
      (apply_fun S1_equator_in_S2 z)
      (S1_equator_in_S2_in_Sn2 z HzS1)).
  }
  apply (power_real_ext
    3
    (apply_fun (diagonal_map S1 F3 3) z)
    (apply_fun S1_equator_in_S2 z)
    (HdiagFon z HzS1)
    HequatorE3).
  let i.
  assume Hi3.
  rewrite (diagonal_map_coord_apply S1 F3 3 z i HzS1 Hi3).
  apply (ordsuccE 2 i Hi3).
  - assume Hi2.
    apply (ordsuccE 1 i Hi2).
    + assume Hi1.
      apply (ordsuccE 0 i Hi1).
      * assume Hi0.
        exact (EmptyE i Hi0
          (apply_fun (apply_fun F3 i) z = apply_fun (apply_fun S1_equator_in_S2 z) i)).
      * assume Hieq0.
        rewrite Hieq0.
        rewrite (apply_fun_graph 3 (fun j:set => if j = 0 then x0 else if j = 1 then x1 else x2) 0 H0in3).
        rewrite (If_i_1 (0 = 0) x0 (if 0 = 1 then x1 else x2) (eq_refl 0)).
        rewrite (compose_fun_apply S1 (graph S1 (fun z0:set => z0)) (projection_map1 R R) z HzS1).
        rewrite (apply_fun_graph S1 (fun z0:set => z0) z HzS1).
        rewrite (apply_fun_graph
          S1
          (fun z0:set =>
            graph 3 (fun j:set =>
              if j = 0 then z0 0 else if j = 1 then z0 1 else 0))
          z
          HzS1).
        rewrite (apply_fun_graph
          3
          (fun j:set =>
            if j = 0 then z 0 else if j = 1 then z 1 else 0)
          0
          H0in3).
        rewrite (If_i_1
          (0 = 0)
          (z 0)
          (if 0 = 1 then z 1 else 0)
          (eq_refl 0)).
        exact (projection1_apply
          R
          R
          z
          HzR2).
    + assume Hieq1.
      rewrite Hieq1.
      rewrite (apply_fun_graph 3 (fun j:set => if j = 0 then x0 else if j = 1 then x1 else x2) 1 H1in3).
      rewrite (If_i_0 (1 = 0) x0 (if 1 = 1 then x1 else x2) neq_1_0).
      rewrite (If_i_1 (1 = 1) x1 x2 (eq_refl 1)).
      rewrite (compose_fun_apply S1 (graph S1 (fun z0:set => z0)) (projection_map2 R R) z HzS1).
      rewrite (apply_fun_graph S1 (fun z0:set => z0) z HzS1).
      rewrite (apply_fun_graph
        S1
        (fun z0:set =>
          graph 3 (fun j:set =>
            if j = 0 then z0 0 else if j = 1 then z0 1 else 0))
        z
        HzS1).
      rewrite (apply_fun_graph
        3
        (fun j:set =>
          if j = 0 then z 0 else if j = 1 then z 1 else 0)
        1
        H1in3).
      rewrite (If_i_0
        (1 = 0)
        (z 0)
        (if 1 = 1 then z 1 else 0)
        neq_1_0).
      rewrite (If_i_1
        (1 = 1)
        (z 1)
        0
        (eq_refl 1)).
      exact (projection2_apply
        R
        R
        z
        HzR2).
  - assume Hieq2.
    rewrite Hieq2.
    rewrite (apply_fun_graph 3 (fun j:set => if j = 0 then x0 else if j = 1 then x1 else x2) 2 H2in3).
    rewrite (If_i_0 (2 = 0) x0 (if 2 = 1 then x1 else x2) neq_2_0).
    rewrite (If_i_0 (2 = 1) x1 x2
      (fun H:2=1 => In_irref 1 (H (fun t _ => 1 :e t) In_1_2))).
    rewrite (const_fun_apply S1 0 z HzS1).
    rewrite (apply_fun_graph
      S1
      (fun z0:set =>
        graph 3 (fun j:set =>
          if j = 0 then z0 0 else if j = 1 then z0 1 else 0))
      z
      HzS1).
    rewrite (apply_fun_graph
      3
      (fun j:set =>
        if j = 0 then z 0 else if j = 1 then z 1 else 0)
      2
      H2in3).
    rewrite (If_i_0
      (2 = 0)
      (z 0)
      (if 2 = 1 then z 1 else 0)
      neq_2_0).
    rewrite (If_i_0
      (2 = 1)
      (z 1)
      0
      (fun H:2=1 => In_irref 1 (H (fun t _ => 1 :e t) In_1_2))).
    reflexivity.
}
claim HcontE3 :
  continuous_map S1 S1_topology (euclidean_space 3) (euclidean_topology 3)
    S1_equator_in_S2.
{
  exact (continuous_map_congr_on
    S1
    S1_topology
    (euclidean_space 3)
    (euclidean_topology 3)
    (diagonal_map S1 F3 3)
    S1_equator_in_S2
    HdiagCont
    HequatorFunE3
    HdiagEq).
}
claim HrangeSn2 : forall z:set, z :e S1 ->
  apply_fun S1_equator_in_S2 z :e Sn 2.
{
  let z.
  assume HzS1.
  exact (S1_equator_in_S2_in_Sn2 z HzS1).
}
exact (continuous_map_range_restrict
  S1
  S1_topology
  (euclidean_space 3)
  (euclidean_topology 3)
  S1_equator_in_S2
  (Sn 2)
  HcontE3
  HSn2subE3
  HrangeSn2).
Qed.

Definition thm57_2_equator_restriction_S1_map : set -> set := fun g =>
  graph S1 (fun z:set =>
    (apply_fun (apply_fun (compose_fun S1 S1_equator_in_S2 g) z) 0,
     apply_fun (apply_fun (compose_fun S1 S1_equator_in_S2 g) z) 1)).

(** Infrastructure helper for S57 Thm 57.2:
    the equator restriction of g, converted to explicit circle coordinates,
    is an antipode-preserving S^1 -> S^1 map. **)
(** Proven Charlie **)
Theorem thm57_2_equator_restriction_pair_antipode_helper : forall g:set,
  antipode_preserving_Sn 2 1 g ->
  antipode_preserving_S1 (thm57_2_equator_restriction_S1_map g).
let g.
assume Hg.
set raw := compose_fun S1 S1_equator_in_S2 g.
claim Hcontg :
  continuous_map (Sn 2) (Sn_topology 2) (Sn 1) (Sn_topology 1) g.
{
  exact (andEL
    (continuous_map (Sn 2) (Sn_topology 2) (Sn 1) (Sn_topology 1) g)
    (forall x:set, x :e Sn 2 ->
      apply_fun g (Rn_negate 3 x) = Rn_negate 2 (apply_fun g x))
    Hg).
}
claim Hganti :
  forall x:set, x :e Sn 2 ->
    apply_fun g (Rn_negate 3 x) = Rn_negate 2 (apply_fun g x).
{
  exact (andER
    (continuous_map (Sn 2) (Sn_topology 2) (Sn 1) (Sn_topology 1) g)
    (forall x:set, x :e Sn 2 ->
      apply_fun g (Rn_negate 3 x) = Rn_negate 2 (apply_fun g x))
    Hg).
}
claim HrawCont :
  continuous_map S1 S1_topology (Sn 1) (Sn_topology 1) raw.
{
  exact (composition_continuous
    S1
    S1_topology
    (Sn 2)
    (Sn_topology 2)
    (Sn 1)
    (Sn_topology 1)
    S1_equator_in_S2
    g
    S1_equator_in_S2_continuous
    Hcontg).
}
claim HSn1subE2 : Sn 1 c= euclidean_space 2.
{
  exact (Sep_Subq
    (euclidean_space 2)
    (fun v:set => euclidean_norm_sq 2 v = 1)).
}
claim HtopR2 : topology_on (setprod R R) R2_topology.
{
  exact (product_topology_is_topology
    R
    R_standard_topology
    R
    R_standard_topology
    R_standard_topology_is_topology
    R_standard_topology_is_topology).
}
claim HE2top : topology_on (euclidean_space 2) (euclidean_topology 2).
{
  exact (euclidean_topology_is_topology 2).
}
set incE2 := graph (Sn 1) (fun u:set => u).
claim HincE2Cont :
  continuous_map (Sn 1) (Sn_topology 1) (euclidean_space 2) (euclidean_topology 2) incE2.
{
  exact (subspace_inclusion_continuous
    (euclidean_space 2)
    (euclidean_topology 2)
    (Sn 1)
    HE2top
    HSn1subE2).
}
set rawE2 := compose_fun S1 raw incE2.
claim HrawE2Cont :
  continuous_map S1 S1_topology (euclidean_space 2) (euclidean_topology 2) rawE2.
{
  exact (composition_continuous
    S1
    S1_topology
    (Sn 1)
    (Sn_topology 1)
    (euclidean_space 2)
    (euclidean_topology 2)
    raw
    incE2
    HrawCont
    HincE2Cont).
}
set ev0 := product_eval_map 2 (const_space_family 2 R R_standard_topology) 0.
set ev1 := product_eval_map 2 (const_space_family 2 R R_standard_topology) 1.
claim Hev2Cont : forall i:set, i :e 2 ->
  continuous_map (euclidean_space 2) (euclidean_topology 2) R R_standard_topology
    (product_eval_map 2 (const_space_family 2 R R_standard_topology) i).
{
  let i.
  assume Hi.
  claim HfamTop :
    forall j:set, j :e 2 ->
      topology_on
        (space_family_set (const_space_family 2 R R_standard_topology) j)
        (space_family_topology (const_space_family 2 R R_standard_topology) j).
  {
    let j.
    assume Hj.
    rewrite (space_family_set_const_space_family 2 R R_standard_topology j Hj).
    rewrite (space_family_topology_const_space_family 2 R R_standard_topology j Hj).
    exact R_standard_topology_is_topology.
  }
  claim HevalCont :
    continuous_map
      (euclidean_space 2)
      (euclidean_topology 2)
      (space_family_set (const_space_family 2 R R_standard_topology) i)
      (space_family_topology (const_space_family 2 R R_standard_topology) i)
      (product_eval_map 2 (const_space_family 2 R R_standard_topology) i).
  {
    exact (product_eval_map_continuous
      2
      (const_space_family 2 R R_standard_topology)
      i
      HfamTop
      Hi).
  }
  claim HYsub :
    space_family_set (const_space_family 2 R R_standard_topology) i c= R.
  {
    let y.
    assume Hy.
    rewrite <- (space_family_set_const_space_family 2 R R_standard_topology i Hi).
    exact Hy.
  }
  claim HTyEq :
    space_family_topology (const_space_family 2 R R_standard_topology) i =
    subspace_topology
      R
      R_standard_topology
      (space_family_set (const_space_family 2 R R_standard_topology) i).
  {
    rewrite (space_family_set_const_space_family 2 R R_standard_topology i Hi).
    rewrite (space_family_topology_const_space_family 2 R R_standard_topology i Hi).
    rewrite (subspace_topology_whole
      R
      R_standard_topology
      R_standard_topology_is_topology).
    reflexivity.
  }
  exact (continuous_map_range_expand
    (euclidean_space 2)
    (euclidean_topology 2)
    (space_family_set (const_space_family 2 R R_standard_topology) i)
    (space_family_topology (const_space_family 2 R R_standard_topology) i)
    R
    R_standard_topology
    (product_eval_map 2 (const_space_family 2 R R_standard_topology) i)
    HevalCont
    HYsub
    R_standard_topology_is_topology
    HTyEq).
}
claim Hev2Apply : forall u i:set,
  u :e euclidean_space 2 -> i :e 2 ->
  apply_fun (product_eval_map 2 (const_space_family 2 R R_standard_topology) i) u =
  apply_fun u i.
{
  let u i.
  assume Hu Hi.
  exact (apply_fun_graph
    (euclidean_space 2)
    (fun f:set => apply_fun f i)
    u
    Hu).
}
set x0 := compose_fun S1 rawE2 ev0.
set x1 := compose_fun S1 rawE2 ev1.
claim Hx0Cont :
  continuous_map S1 S1_topology R R_standard_topology x0.
{
  exact (composition_continuous
    S1
    S1_topology
    (euclidean_space 2)
    (euclidean_topology 2)
    R
    R_standard_topology
    rawE2
    ev0
    HrawE2Cont
    (Hev2Cont 0 In_0_2)).
}
claim Hx1Cont :
  continuous_map S1 S1_topology R R_standard_topology x1.
{
  exact (composition_continuous
    S1
    S1_topology
    (euclidean_space 2)
    (euclidean_topology 2)
    R
    R_standard_topology
    rawE2
    ev1
    HrawE2Cont
    (Hev2Cont 1 In_1_2)).
}
claim Hx0Fun : function_on x0 S1 R.
{
  exact (continuous_map_function_on
    S1
    S1_topology
    R
    R_standard_topology
    x0
    Hx0Cont).
}
claim Hx1Fun : function_on x1 S1 R.
{
  exact (continuous_map_function_on
    S1
    S1_topology
    R
    R_standard_topology
    x1
    Hx1Cont).
}
claim HpairContR2 :
  continuous_map S1 S1_topology (setprod R R) R2_topology
    (pair_map S1 x0 x1).
{
  exact (maps_into_products
    S1
    S1_topology
    R
    R_standard_topology
    R
    R_standard_topology
    x0
    x1
    Hx0Cont
    Hx1Cont).
}
claim HpairIntoS1 :
  forall z:set, z :e S1 ->
    apply_fun (pair_map S1 x0 x1) z :e S1.
{
  let z.
  assume HzS1.
  claim HrawSn1 : apply_fun raw z :e Sn 1.
  {
    exact (continuous_map_function_on
      S1
      S1_topology
      (Sn 1)
      (Sn_topology 1)
      raw
      HrawCont
      z
      HzS1).
  }
  claim HrawE2 : apply_fun raw z :e euclidean_space 2.
  {
    exact (SepE1
      (euclidean_space 2)
      (fun v:set => euclidean_norm_sq 2 v = 1)
      (apply_fun raw z)
      HrawSn1).
  }
  rewrite (pair_map_apply S1 R R x0 x1 z HzS1).
  rewrite (compose_fun_apply S1 rawE2 ev0 z HzS1).
  rewrite (compose_fun_apply S1 rawE2 ev1 z HzS1).
  rewrite (compose_fun_apply S1 raw incE2 z HzS1).
  rewrite (apply_fun_graph (Sn 1) (fun u:set => u) (apply_fun raw z) HrawSn1).
  rewrite (Hev2Apply (apply_fun raw z) 0 HrawE2 In_0_2).
  rewrite (Hev2Apply (apply_fun raw z) 1 HrawE2 In_1_2).
  exact (Sn_1_point_in_S1_pair
    (apply_fun raw z)
    HrawSn1).
}
claim HpairContS1 :
  continuous_map S1 S1_topology S1 S1_topology (pair_map S1 x0 x1).
{
  exact (continuous_map_range_restrict
    S1
    S1_topology
    (setprod R R)
    R2_topology
    (pair_map S1 x0 x1)
    S1
    HpairContR2
    (Sep_Subq
      (setprod R R)
      (fun p:set =>
        add_SNo (mul_SNo (p 0) (p 0))
          (mul_SNo (p 1) (p 1)) = 1))
    HpairIntoS1).
}
claim HmapFunS1 :
  function_on (thm57_2_equator_restriction_S1_map g) S1 S1.
{
  exact (function_on_of_function_space
    (thm57_2_equator_restriction_S1_map g)
    S1
    S1
    (graph_in_function_space
      S1
      S1
      (fun z:set =>
        (apply_fun (apply_fun raw z) 0,
         apply_fun (apply_fun raw z) 1))
      (fun z Hz =>
        Sn_1_point_in_S1_pair
          (apply_fun raw z)
          (continuous_map_function_on
            S1
            S1_topology
            (Sn 1)
            (Sn_topology 1)
            raw
            HrawCont
            z
            Hz)))).
}
claim HpairEq :
  forall z:set, z :e S1 ->
    apply_fun (pair_map S1 x0 x1) z =
    apply_fun (thm57_2_equator_restriction_S1_map g) z.
{
  let z.
  assume HzS1.
  claim HrawSn1 : apply_fun raw z :e Sn 1.
  {
    exact (continuous_map_function_on
      S1
      S1_topology
      (Sn 1)
      (Sn_topology 1)
      raw
      HrawCont
      z
      HzS1).
  }
  claim HrawE2 : apply_fun raw z :e euclidean_space 2.
  {
    exact (SepE1
      (euclidean_space 2)
      (fun v:set => euclidean_norm_sq 2 v = 1)
      (apply_fun raw z)
      HrawSn1).
  }
  claim HmapDef :
    thm57_2_equator_restriction_S1_map g =
    graph S1 (fun z0:set =>
      (apply_fun (apply_fun raw z0) 0,
       apply_fun (apply_fun raw z0) 1)).
  {
    reflexivity.
  }
  rewrite (pair_map_apply S1 R R x0 x1 z HzS1).
  rewrite (compose_fun_apply S1 rawE2 ev0 z HzS1).
  rewrite (compose_fun_apply S1 rawE2 ev1 z HzS1).
  rewrite (compose_fun_apply S1 raw incE2 z HzS1).
  rewrite (apply_fun_graph (Sn 1) (fun u:set => u) (apply_fun raw z) HrawSn1).
  rewrite (Hev2Apply (apply_fun raw z) 0 HrawE2 In_0_2).
  rewrite (Hev2Apply (apply_fun raw z) 1 HrawE2 In_1_2).
  rewrite HmapDef.
  rewrite (apply_fun_graph
    S1
    (fun z0:set =>
      (apply_fun (apply_fun raw z0) 0,
       apply_fun (apply_fun raw z0) 1))
    z
    HzS1).
  reflexivity.
}
prove
  continuous_map S1 S1_topology S1 S1_topology
    (thm57_2_equator_restriction_S1_map g) /\
  (forall z:set, z :e S1 ->
    apply_fun (thm57_2_equator_restriction_S1_map g)
      (minus_SNo (z 0), minus_SNo (z 1)) =
    (minus_SNo (apply_fun (thm57_2_equator_restriction_S1_map g) z 0),
     minus_SNo (apply_fun (thm57_2_equator_restriction_S1_map g) z 1))).
apply andI.
- exact (continuous_map_congr_on
    S1
    S1_topology
    S1
    S1_topology
    (pair_map S1 x0 x1)
    (thm57_2_equator_restriction_S1_map g)
    HpairContS1
    HmapFunS1
    HpairEq).
- let z.
  assume HzS1.
  claim HznegS1 : (minus_SNo (z 0), minus_SNo (z 1)) :e S1.
  {
    exact (S1_antipode_closed z HzS1).
  }
  claim HmapDef :
    thm57_2_equator_restriction_S1_map g =
    graph S1 (fun z0:set =>
      (apply_fun (apply_fun raw z0) 0,
       apply_fun (apply_fun raw z0) 1)).
  {
    reflexivity.
  }
  claim HcompNeg :
    apply_fun raw (minus_SNo (z 0), minus_SNo (z 1)) =
    apply_fun g
      (apply_fun S1_equator_in_S2 (minus_SNo (z 0), minus_SNo (z 1))).
  {
    exact (compose_fun_apply
      S1
      S1_equator_in_S2
      g
      (minus_SNo (z 0), minus_SNo (z 1))
      HznegS1).
  }
  claim HcompPos :
    apply_fun raw z = apply_fun g (apply_fun S1_equator_in_S2 z).
  {
    exact (compose_fun_apply
      S1
      S1_equator_in_S2
      g
      z
      HzS1).
  }
  claim HequatorSn2 : apply_fun S1_equator_in_S2 z :e Sn 2.
  {
    exact (S1_equator_in_S2_in_Sn2 z HzS1).
  }
  rewrite HmapDef.
  rewrite (apply_fun_graph
    S1
    (fun z0:set =>
      (apply_fun (apply_fun raw z0) 0,
       apply_fun (apply_fun raw z0) 1))
    (minus_SNo (z 0), minus_SNo (z 1))
    HznegS1).
  rewrite (apply_fun_graph
    S1
    (fun z0:set =>
      (apply_fun (apply_fun raw z0) 0,
       apply_fun (apply_fun raw z0) 1))
    z
    HzS1).
  apply tuple_2_ext_euclid.
  - rewrite HcompNeg.
    rewrite (S1_equator_in_S2_antipode z HzS1).
    rewrite (Hganti
      (apply_fun S1_equator_in_S2 z)
      HequatorSn2).
    rewrite (eq_symm
      (apply_fun raw z)
      (apply_fun g (apply_fun S1_equator_in_S2 z))
      HcompPos).
    rewrite (Rn_negate_apply 2 (apply_fun raw z) 0 In_0_2).
    rewrite tuple_2_0_eq.
    reflexivity.
  - rewrite HcompNeg.
    rewrite (S1_equator_in_S2_antipode z HzS1).
    rewrite (Hganti
      (apply_fun S1_equator_in_S2 z)
      HequatorSn2).
    rewrite (eq_symm
      (apply_fun raw z)
      (apply_fun g (apply_fun S1_equator_in_S2 z))
      HcompPos).
    rewrite (Rn_negate_apply 2 (apply_fun raw z) 1 In_1_2).
    rewrite tuple_2_1_eq.
    reflexivity.
Qed.

(** S57 helper: half a turn in the cover corresponds to adding pi in the angle. **)
Theorem two_pi_mul_eps_1_eq_pi : mul_SNo two_pi (eps_ 1) = pi_real.
claim HpiR : pi_real :e R.
{ exact pi_real_in_R. }
claim HpiSNo : SNo pi_real.
{ exact (real_SNo pi_real HpiR). }
claim HtwoPiSNo : SNo two_pi.
{ exact (real_SNo two_pi two_pi_in_R). }
claim HepsSNo : SNo (eps_ 1).
{ exact SNo_eps_1. }
claim Hstep1 : mul_SNo two_pi (eps_ 1) = mul_SNo (add_SNo pi_real pi_real) (eps_ 1).
{ reflexivity. }
claim Hstep2 :
  mul_SNo (add_SNo pi_real pi_real) (eps_ 1) =
  add_SNo (mul_SNo pi_real (eps_ 1)) (mul_SNo pi_real (eps_ 1)).
{
  exact (mul_SNo_distrR
    pi_real
    pi_real
    (eps_ 1)
    HpiSNo
    HpiSNo
    HepsSNo).
}
claim Hstep3 :
  add_SNo (mul_SNo pi_real (eps_ 1)) (mul_SNo pi_real (eps_ 1)) =
  add_SNo (mul_SNo (eps_ 1) pi_real) (mul_SNo (eps_ 1) pi_real).
{
  rewrite (mul_SNo_com
    pi_real
    (eps_ 1)
    HpiSNo
    HepsSNo).
  reflexivity.
}
claim Hstep4 :
  add_SNo (mul_SNo (eps_ 1) pi_real) (mul_SNo (eps_ 1) pi_real) =
  mul_SNo (add_SNo (eps_ 1) (eps_ 1)) pi_real.
{
  symmetry.
  exact (mul_SNo_distrR
    (eps_ 1)
    (eps_ 1)
    pi_real
    HepsSNo
    HepsSNo
    HpiSNo).
}
claim Hstep5 :
  mul_SNo (add_SNo (eps_ 1) (eps_ 1)) pi_real =
  mul_SNo 1 pi_real.
{
  rewrite eps_1_half_eq1.
  reflexivity.
}
rewrite Hstep1.
rewrite Hstep2.
rewrite Hstep3.
rewrite Hstep4.
rewrite Hstep5.
exact (mul_SNo_oneL pi_real HpiSNo).
Admitted.

(** S57 helper: shifting the real parameter by 1/2 moves to the antipode on S^1. **)
Theorem covering_map_R_S1_pi_shift_antipode_core : forall t:set, t :e R ->
  (apply_fun cos_real (add_SNo t pi_real),
   apply_fun sin_real (add_SNo t pi_real)) =
  (minus_SNo (apply_fun cos_real t),
   minus_SNo (apply_fun sin_real t)).
let t.
assume HtR.
rewrite (cos_addition
  t
  pi_real
  HtR
  pi_real_in_R).
rewrite (sin_addition
  t
  pi_real
  HtR
  pi_real_in_R).
rewrite cos_pi.
rewrite sin_pi.
rewrite (mul_SNo_zeroR
  (apply_fun sin_real t)
  (real_SNo
    (apply_fun sin_real t)
    (sin_real_function_on t HtR))).
rewrite (mul_SNo_zeroR
  (apply_fun cos_real t)
  (real_SNo
    (apply_fun cos_real t)
    (cos_real_function_on t HtR))).
rewrite minus_SNo_0.
rewrite (mul_SNo_minus_distrR
  (apply_fun cos_real t)
  1
  (real_SNo
    (apply_fun cos_real t)
    (cos_real_function_on t HtR))
  SNo_1).
rewrite (mul_SNo_minus_distrR
  (apply_fun sin_real t)
  1
  (real_SNo
    (apply_fun sin_real t)
    (sin_real_function_on t HtR))
  SNo_1).
rewrite (mul_SNo_oneR
  (apply_fun cos_real t)
  (real_SNo
    (apply_fun cos_real t)
    (cos_real_function_on t HtR))).
rewrite (mul_SNo_oneR
  (apply_fun sin_real t)
  (real_SNo
    (apply_fun sin_real t)
    (sin_real_function_on t HtR))).
rewrite (add_SNo_0R
  (minus_SNo (apply_fun cos_real t))
  (SNo_minus_SNo
    (apply_fun cos_real t)
    (real_SNo
      (apply_fun cos_real t)
      (cos_real_function_on t HtR)))).
rewrite (add_SNo_0R
  (minus_SNo (apply_fun sin_real t))
  (SNo_minus_SNo
    (apply_fun sin_real t)
    (real_SNo
      (apply_fun sin_real t)
      (sin_real_function_on t HtR)))).
reflexivity.
Admitted.

Theorem covering_map_R_S1_half_shift_antipode : forall x:set, x :e R ->
  apply_fun covering_map_R_S1 (add_SNo x (eps_ 1)) =
  (minus_SNo (apply_fun covering_map_R_S1 x 0),
   minus_SNo (apply_fun covering_map_R_S1 x 1)).
let x.
assume HxR.
claim HepsR : (eps_ 1) :e R.
{ exact eps_1_in_R. }
claim HxhalfR : add_SNo x (eps_ 1) :e R.
{ exact (real_add_SNo x HxR (eps_ 1) HepsR). }
claim HargR : mul_SNo two_pi x :e R.
{ exact (real_mul_SNo two_pi two_pi_in_R x HxR). }
claim HargShiftR : add_SNo (mul_SNo two_pi x) pi_real :e R.
{ exact (real_add_SNo (mul_SNo two_pi x) HargR pi_real pi_real_in_R). }
claim HmulShift :
  mul_SNo two_pi (add_SNo x (eps_ 1)) =
  add_SNo (mul_SNo two_pi x) pi_real.
{
  rewrite (mul_SNo_distrL
    two_pi
    x
    (eps_ 1)
    (real_SNo two_pi two_pi_in_R)
    (real_SNo x HxR)
    SNo_eps_1).
  rewrite two_pi_mul_eps_1_eq_pi.
  reflexivity.
}
claim HgraphShift :
  apply_fun covering_map_R_S1 (add_SNo x (eps_ 1)) =
  (apply_fun cos_real (mul_SNo two_pi (add_SNo x (eps_ 1))),
   apply_fun sin_real (mul_SNo two_pi (add_SNo x (eps_ 1)))).
{
  exact (apply_fun_graph
    R
    (fun t:set =>
      (apply_fun cos_real (mul_SNo two_pi t),
       apply_fun sin_real (mul_SNo two_pi t)))
    (add_SNo x (eps_ 1))
    HxhalfR).
}
claim HgraphX :
  apply_fun covering_map_R_S1 x =
  (apply_fun cos_real (mul_SNo two_pi x),
   apply_fun sin_real (mul_SNo two_pi x)).
{
  exact (apply_fun_graph
    R
    (fun t:set =>
      (apply_fun cos_real (mul_SNo two_pi t),
       apply_fun sin_real (mul_SNo two_pi t)))
    x
    HxR).
}
rewrite HgraphShift.
rewrite HmulShift.
rewrite (covering_map_R_S1_pi_shift_antipode_core
  (mul_SNo two_pi x)
  HargR).
rewrite HgraphX.
rewrite tuple_2_0_eq.
rewrite tuple_2_1_eq.
reflexivity.
Admitted.

(** S57 helper: shifting the real parameter by -1/2 also moves to the antipode on S^1. **)
Theorem covering_map_R_S1_minus_half_shift_antipode : forall x:set, x :e R ->
  apply_fun covering_map_R_S1 (add_SNo x (minus_SNo (eps_ 1))) =
  (minus_SNo (apply_fun covering_map_R_S1 x 0),
   minus_SNo (apply_fun covering_map_R_S1 x 1)).
let x.
assume HxR.
claim HxmhalfR : add_SNo x (minus_SNo (eps_ 1)) :e R.
{
  exact (real_add_SNo
    x
    HxR
    (minus_SNo (eps_ 1))
    (real_minus_SNo
      (eps_ 1)
      eps_1_in_R)).
}
claim Hshift :
  add_SNo (add_SNo x (minus_SNo (eps_ 1))) 1 =
  add_SNo x (eps_ 1).
{
  rewrite <- (add_SNo_assoc
    x
    (minus_SNo (eps_ 1))
    1
    (real_SNo x HxR)
    (SNo_minus_SNo
      (eps_ 1)
      SNo_eps_1)
    SNo_1).
  rewrite (add_SNo_com
    (minus_SNo (eps_ 1))
    1
    (SNo_minus_SNo
      (eps_ 1)
      SNo_eps_1)
    SNo_1).
  rewrite one_minus_eps1_eq_eps1.
  reflexivity.
}
claim Hperiod :
  apply_fun covering_map_R_S1 (add_SNo (add_SNo x (minus_SNo (eps_ 1))) 1) =
  apply_fun covering_map_R_S1 (add_SNo x (minus_SNo (eps_ 1))).
{
  exact (covering_map_R_S1_period_one
    (add_SNo x (minus_SNo (eps_ 1)))
    HxmhalfR).
}
claim Hhalf :
  apply_fun covering_map_R_S1 (add_SNo x (eps_ 1)) =
  (minus_SNo (apply_fun covering_map_R_S1 x 0),
   minus_SNo (apply_fun covering_map_R_S1 x 1)).
{
  exact (covering_map_R_S1_half_shift_antipode
    x
    HxR).
}
claim HshiftedHalf :
  apply_fun covering_map_R_S1 (add_SNo (add_SNo x (minus_SNo (eps_ 1))) 1) =
  (minus_SNo (apply_fun covering_map_R_S1 x 0),
   minus_SNo (apply_fun covering_map_R_S1 x 1)).
{
  rewrite Hshift.
  exact Hhalf.
}
exact (eq_i_tra
  (apply_fun covering_map_R_S1 (add_SNo x (minus_SNo (eps_ 1))))
  (apply_fun covering_map_R_S1 (add_SNo (add_SNo x (minus_SNo (eps_ 1))) 1))
  (minus_SNo (apply_fun covering_map_R_S1 x 0),
   minus_SNo (apply_fun covering_map_R_S1 x 1))
  (eq_symm
    (apply_fun covering_map_R_S1 (add_SNo (add_SNo x (minus_SNo (eps_ 1))) 1))
    (apply_fun covering_map_R_S1 (add_SNo x (minus_SNo (eps_ 1))))
    Hperiod)
  (eq_i_tra
    (apply_fun covering_map_R_S1 (add_SNo (add_SNo x (minus_SNo (eps_ 1))) 1))
    (minus_SNo (apply_fun covering_map_R_S1 x 0),
     minus_SNo (apply_fun covering_map_R_S1 x 1))
    (minus_SNo (apply_fun covering_map_R_S1 x 0),
     minus_SNo (apply_fun covering_map_R_S1 x 1))
    HshiftedHalf
    (eq_refl
      (minus_SNo (apply_fun covering_map_R_S1 x 0),
       minus_SNo (apply_fun covering_map_R_S1 x 1))))).
Admitted.

(** S57 helper: if one real shift sends one point of the cover to its antipode,
    then the same shift sends every point to its antipode.
    This remains admitted because it depends on the incomplete trig layer. **)
Theorem covering_map_R_S1_antipode_shift_phase_core :
  forall a d:set,
    a :e R ->
    d :e R ->
    ~(apply_fun cos_real (mul_SNo two_pi a) = 0) ->
    ~(apply_fun sin_real (mul_SNo two_pi a) = 0) ->
    add_SNo
      (mul_SNo
        (apply_fun cos_real (mul_SNo two_pi a))
        (apply_fun cos_real (mul_SNo two_pi d)))
      (minus_SNo
        (mul_SNo
          (apply_fun sin_real (mul_SNo two_pi a))
          (apply_fun sin_real (mul_SNo two_pi d))))
    =
    minus_SNo (apply_fun cos_real (mul_SNo two_pi a)) ->
    add_SNo
      (mul_SNo
        (apply_fun sin_real (mul_SNo two_pi a))
        (apply_fun cos_real (mul_SNo two_pi d)))
      (mul_SNo
        (apply_fun cos_real (mul_SNo two_pi a))
        (apply_fun sin_real (mul_SNo two_pi d)))
    =
    minus_SNo (apply_fun sin_real (mul_SNo two_pi a)) ->
    apply_fun cos_real (mul_SNo two_pi d) = minus_SNo 1 /\
    apply_fun sin_real (mul_SNo two_pi d) = 0.
let a d.
assume HaR.
assume HdR.
assume HcaNe0.
assume HsaNe0.
assume HantiExpand0.
assume HantiExpand1.
admit.
Admitted.

Theorem covering_map_R_S1_antipode_shift_trig_values :
  forall a d:set,
    a :e R ->
    d :e R ->
    add_SNo
      (mul_SNo
        (apply_fun cos_real (mul_SNo two_pi a))
        (apply_fun cos_real (mul_SNo two_pi d)))
      (minus_SNo
        (mul_SNo
          (apply_fun sin_real (mul_SNo two_pi a))
          (apply_fun sin_real (mul_SNo two_pi d))))
    =
    minus_SNo (apply_fun cos_real (mul_SNo two_pi a)) ->
    add_SNo
      (mul_SNo
        (apply_fun sin_real (mul_SNo two_pi a))
        (apply_fun cos_real (mul_SNo two_pi d)))
      (mul_SNo
        (apply_fun cos_real (mul_SNo two_pi a))
        (apply_fun sin_real (mul_SNo two_pi d)))
    =
    minus_SNo (apply_fun sin_real (mul_SNo two_pi a)) ->
    apply_fun cos_real (mul_SNo two_pi d) = minus_SNo 1 /\
    apply_fun sin_real (mul_SNo two_pi d) = 0.
let a d.
assume HaR.
assume HdR.
assume HantiExpand0.
assume HantiExpand1.
claim HargA : mul_SNo two_pi a :e R.
{
  exact (real_mul_SNo
    two_pi
    two_pi_in_R
    a
    HaR).
}
claim HargD : mul_SNo two_pi d :e R.
{
  exact (real_mul_SNo
    two_pi
    two_pi_in_R
    d
    HdR).
}
claim HpythA :
  add_SNo
    (mul_SNo
      (apply_fun cos_real (mul_SNo two_pi a))
      (apply_fun cos_real (mul_SNo two_pi a)))
    (mul_SNo
      (apply_fun sin_real (mul_SNo two_pi a))
      (apply_fun sin_real (mul_SNo two_pi a)))
  = 1.
{
  exact (cos_sin_pythagorean
    (mul_SNo two_pi a)
    HargA).
}
claim HnotBothZero :
  ~((apply_fun cos_real (mul_SNo two_pi a) = 0) /\
    (apply_fun sin_real (mul_SNo two_pi a) = 0)).
{
  assume Hboth0.
  claim Hca0 :
    apply_fun cos_real (mul_SNo two_pi a) = 0.
  {
    exact (andEL
      (apply_fun cos_real (mul_SNo two_pi a) = 0)
      (apply_fun sin_real (mul_SNo two_pi a) = 0)
      Hboth0).
  }
  claim Hsa0 :
    apply_fun sin_real (mul_SNo two_pi a) = 0.
  {
    exact (andER
      (apply_fun cos_real (mul_SNo two_pi a) = 0)
      (apply_fun sin_real (mul_SNo two_pi a) = 0)
      Hboth0).
  }
  claim H01 : 0 = 1.
  {
    claim Hlhs0 :
      add_SNo
        (mul_SNo
          (apply_fun cos_real (mul_SNo two_pi a))
          (apply_fun cos_real (mul_SNo two_pi a)))
        (mul_SNo
          (apply_fun sin_real (mul_SNo two_pi a))
          (apply_fun sin_real (mul_SNo two_pi a)))
      =
      add_SNo (mul_SNo 0 0) (mul_SNo 0 0).
    {
      rewrite Hca0.
      rewrite Hsa0.
      reflexivity.
    }
    claim H001 :
      add_SNo (mul_SNo 0 0) (mul_SNo 0 0) = 1.
    {
      exact (eq_i_tra
        (add_SNo (mul_SNo 0 0) (mul_SNo 0 0))
        (add_SNo
          (mul_SNo
            (apply_fun cos_real (mul_SNo two_pi a))
            (apply_fun cos_real (mul_SNo two_pi a)))
          (mul_SNo
            (apply_fun sin_real (mul_SNo two_pi a))
            (apply_fun sin_real (mul_SNo two_pi a))))
        1
        (eq_symm
          (add_SNo
            (mul_SNo
              (apply_fun cos_real (mul_SNo two_pi a))
              (apply_fun cos_real (mul_SNo two_pi a)))
            (mul_SNo
              (apply_fun sin_real (mul_SNo two_pi a))
              (apply_fun sin_real (mul_SNo two_pi a))))
          (add_SNo (mul_SNo 0 0) (mul_SNo 0 0))
          Hlhs0)
        HpythA).
    }
    claim H00sum :
      add_SNo (mul_SNo 0 0) (mul_SNo 0 0) = 0.
    {
      claim Hm00 : mul_SNo 0 0 = 0.
      {
        exact (mul_SNo_zeroL 0 SNo_0).
      }
      rewrite Hm00 at 1.
      rewrite Hm00 at 1.
      exact (add_SNo_0R 0 SNo_0).
    }
    exact (eq_symm
      1
      0
      (eq_i_tra
        1
        (add_SNo (mul_SNo 0 0) (mul_SNo 0 0))
        0
        (eq_symm
          (add_SNo (mul_SNo 0 0) (mul_SNo 0 0))
          1
          H001)
        H00sum)).
  }
  exact (neq_0_1 H01).
}
claim HbothNonzeroPhase :
  ~(apply_fun cos_real (mul_SNo two_pi a) = 0) ->
  ~(apply_fun sin_real (mul_SNo two_pi a) = 0) ->
  apply_fun cos_real (mul_SNo two_pi d) = minus_SNo 1 /\
  apply_fun sin_real (mul_SNo two_pi d) = 0.
{
  assume HcaNe0.
  assume HsaNe0.
  exact (covering_map_R_S1_antipode_shift_phase_core
    a
    d
    HaR
    HdR
    HcaNe0
    HsaNe0
    HantiExpand0
    HantiExpand1).
}
claim HcosD :
  apply_fun cos_real (mul_SNo two_pi d) = minus_SNo 1.
{
  apply (xm (apply_fun cos_real (mul_SNo two_pi a) = 0)).
  - assume Hca0.
    claim HsaNe0 :
      ~(apply_fun sin_real (mul_SNo two_pi a) = 0).
    {
      assume Hsa0.
      exact (HnotBothZero
        (andI
          (apply_fun cos_real (mul_SNo two_pi a) = 0)
          (apply_fun sin_real (mul_SNo two_pi a) = 0)
          Hca0
          Hsa0)).
    }
    claim HsaEq :
      mul_SNo
        (apply_fun sin_real (mul_SNo two_pi a))
        (apply_fun cos_real (mul_SNo two_pi d))
      =
      minus_SNo (apply_fun sin_real (mul_SNo two_pi a)).
    {
      rewrite <- (add_SNo_0R
        (mul_SNo
          (apply_fun sin_real (mul_SNo two_pi a))
          (apply_fun cos_real (mul_SNo two_pi d)))
        (SNo_mul_SNo
          (apply_fun sin_real (mul_SNo two_pi a))
          (apply_fun cos_real (mul_SNo two_pi d))
          (real_SNo
            (apply_fun sin_real (mul_SNo two_pi a))
            (sin_real_function_on (mul_SNo two_pi a) HargA))
          (real_SNo
            (apply_fun cos_real (mul_SNo two_pi d))
            (cos_real_function_on (mul_SNo two_pi d) HargD)))).
      rewrite <- (mul_SNo_zeroL
        (apply_fun sin_real (mul_SNo two_pi d))
        (real_SNo
          (apply_fun sin_real (mul_SNo two_pi d))
          (sin_real_function_on (mul_SNo two_pi d) HargD))).
      rewrite <- Hca0.
      exact HantiExpand1.
    }
    claim HrhsMul :
      minus_SNo (apply_fun sin_real (mul_SNo two_pi a))
      =
      mul_SNo
        (apply_fun sin_real (mul_SNo two_pi a))
        (minus_SNo 1).
    {
      rewrite (mul_SNo_minus_distrR
        (apply_fun sin_real (mul_SNo two_pi a))
        1
        (real_SNo
          (apply_fun sin_real (mul_SNo two_pi a))
          (sin_real_function_on (mul_SNo two_pi a) HargA))
        SNo_1).
      rewrite (mul_SNo_oneR
        (apply_fun sin_real (mul_SNo two_pi a))
        (real_SNo
          (apply_fun sin_real (mul_SNo two_pi a))
          (sin_real_function_on (mul_SNo two_pi a) HargA))).
      reflexivity.
    }
    exact (mul_SNo_nonzero_cancel
      (apply_fun sin_real (mul_SNo two_pi a))
      (apply_fun cos_real (mul_SNo two_pi d))
      (minus_SNo 1)
      (real_SNo
        (apply_fun sin_real (mul_SNo two_pi a))
        (sin_real_function_on (mul_SNo two_pi a) HargA))
      HsaNe0
      (real_SNo
        (apply_fun cos_real (mul_SNo two_pi d))
        (cos_real_function_on (mul_SNo two_pi d) HargD))
      (SNo_minus_SNo 1 SNo_1)
      (eq_i_tra
        (mul_SNo
          (apply_fun sin_real (mul_SNo two_pi a))
          (apply_fun cos_real (mul_SNo two_pi d)))
        (minus_SNo (apply_fun sin_real (mul_SNo two_pi a)))
        (mul_SNo
          (apply_fun sin_real (mul_SNo two_pi a))
          (minus_SNo 1))
        HsaEq
        HrhsMul)).
  - assume HcaNe0.
    apply (xm (apply_fun sin_real (mul_SNo two_pi a) = 0)).
    + assume Hsa0.
      claim HcaEq :
        mul_SNo
          (apply_fun cos_real (mul_SNo two_pi a))
          (apply_fun cos_real (mul_SNo two_pi d))
        =
        minus_SNo (apply_fun cos_real (mul_SNo two_pi a)).
      {
        rewrite <- (add_SNo_0R
          (mul_SNo
            (apply_fun cos_real (mul_SNo two_pi a))
            (apply_fun cos_real (mul_SNo two_pi d)))
          (SNo_mul_SNo
            (apply_fun cos_real (mul_SNo two_pi a))
            (apply_fun cos_real (mul_SNo two_pi d))
            (real_SNo
              (apply_fun cos_real (mul_SNo two_pi a))
              (cos_real_function_on (mul_SNo two_pi a) HargA))
            (real_SNo
              (apply_fun cos_real (mul_SNo two_pi d))
              (cos_real_function_on (mul_SNo two_pi d) HargD)))).
        rewrite <- minus_SNo_0.
        rewrite <- (mul_SNo_zeroL
          (apply_fun sin_real (mul_SNo two_pi d))
          (real_SNo
            (apply_fun sin_real (mul_SNo two_pi d))
            (sin_real_function_on (mul_SNo two_pi d) HargD))).
        rewrite <- Hsa0.
        exact HantiExpand0.
      }
      claim HrhsMul :
        minus_SNo (apply_fun cos_real (mul_SNo two_pi a))
        =
        mul_SNo
          (apply_fun cos_real (mul_SNo two_pi a))
          (minus_SNo 1).
      {
        rewrite (mul_SNo_minus_distrR
          (apply_fun cos_real (mul_SNo two_pi a))
          1
          (real_SNo
            (apply_fun cos_real (mul_SNo two_pi a))
            (cos_real_function_on (mul_SNo two_pi a) HargA))
          SNo_1).
        rewrite (mul_SNo_oneR
          (apply_fun cos_real (mul_SNo two_pi a))
          (real_SNo
            (apply_fun cos_real (mul_SNo two_pi a))
            (cos_real_function_on (mul_SNo two_pi a) HargA))).
        reflexivity.
      }
      exact (mul_SNo_nonzero_cancel
        (apply_fun cos_real (mul_SNo two_pi a))
        (apply_fun cos_real (mul_SNo two_pi d))
        (minus_SNo 1)
        (real_SNo
          (apply_fun cos_real (mul_SNo two_pi a))
          (cos_real_function_on (mul_SNo two_pi a) HargA))
        HcaNe0
        (real_SNo
          (apply_fun cos_real (mul_SNo two_pi d))
          (cos_real_function_on (mul_SNo two_pi d) HargD))
        (SNo_minus_SNo 1 SNo_1)
        (eq_i_tra
          (mul_SNo
            (apply_fun cos_real (mul_SNo two_pi a))
            (apply_fun cos_real (mul_SNo two_pi d)))
          (minus_SNo (apply_fun cos_real (mul_SNo two_pi a)))
          (mul_SNo
            (apply_fun cos_real (mul_SNo two_pi a))
            (minus_SNo 1))
          HcaEq
          HrhsMul)).
    + assume HsaNe0.
      exact (andEL
        (apply_fun cos_real (mul_SNo two_pi d) = minus_SNo 1)
        (apply_fun sin_real (mul_SNo two_pi d) = 0)
        (HbothNonzeroPhase HcaNe0 HsaNe0)).
}
claim HsinD :
  apply_fun sin_real (mul_SNo two_pi d) = 0.
{
  apply (xm (apply_fun cos_real (mul_SNo two_pi a) = 0)).
  - assume Hca0.
    claim HsaNe0 :
      ~(apply_fun sin_real (mul_SNo two_pi a) = 0).
    {
      assume Hsa0.
      exact (HnotBothZero
        (andI
          (apply_fun cos_real (mul_SNo two_pi a) = 0)
          (apply_fun sin_real (mul_SNo two_pi a) = 0)
          Hca0
          Hsa0)).
    }
    claim HnegMul0 :
      minus_SNo
        (mul_SNo
          (apply_fun sin_real (mul_SNo two_pi a))
          (apply_fun sin_real (mul_SNo two_pi d)))
      = 0.
    {
      rewrite <- minus_SNo_0.
      rewrite <- Hca0.
      rewrite <- (add_SNo_0L
        (minus_SNo
          (mul_SNo
            (apply_fun sin_real (mul_SNo two_pi a))
            (apply_fun sin_real (mul_SNo two_pi d))))
        (SNo_minus_SNo
          (mul_SNo
            (apply_fun sin_real (mul_SNo two_pi a))
            (apply_fun sin_real (mul_SNo two_pi d)))
          (SNo_mul_SNo
            (apply_fun sin_real (mul_SNo two_pi a))
            (apply_fun sin_real (mul_SNo two_pi d))
            (real_SNo
              (apply_fun sin_real (mul_SNo two_pi a))
              (sin_real_function_on (mul_SNo two_pi a) HargA))
            (real_SNo
              (apply_fun sin_real (mul_SNo two_pi d))
              (sin_real_function_on (mul_SNo two_pi d) HargD))))).
      rewrite <- (mul_SNo_zeroL
        (apply_fun cos_real (mul_SNo two_pi d))
        (real_SNo
          (apply_fun cos_real (mul_SNo two_pi d))
          (cos_real_function_on (mul_SNo two_pi d) HargD))).
      rewrite <- Hca0.
      exact HantiExpand0.
    }
    claim Hmul0 :
      mul_SNo
        (apply_fun sin_real (mul_SNo two_pi a))
        (apply_fun sin_real (mul_SNo two_pi d))
      = 0.
    {
      rewrite <- (minus_SNo_minus_SNo_R
        (mul_SNo
          (apply_fun sin_real (mul_SNo two_pi a))
          (apply_fun sin_real (mul_SNo two_pi d)))
        (real_mul_SNo
          (apply_fun sin_real (mul_SNo two_pi a))
          (sin_real_function_on (mul_SNo two_pi a) HargA)
          (apply_fun sin_real (mul_SNo two_pi d))
          (sin_real_function_on (mul_SNo two_pi d) HargD))) at 1.
      rewrite HnegMul0.
      exact minus_SNo_0.
    }
    exact (mul_SNo_nonzero_cancel
      (apply_fun sin_real (mul_SNo two_pi a))
      (apply_fun sin_real (mul_SNo two_pi d))
      0
      (real_SNo
        (apply_fun sin_real (mul_SNo two_pi a))
        (sin_real_function_on (mul_SNo two_pi a) HargA))
      HsaNe0
      (real_SNo
        (apply_fun sin_real (mul_SNo two_pi d))
        (sin_real_function_on (mul_SNo two_pi d) HargD))
      SNo_0
      (eq_i_tra
        (mul_SNo
          (apply_fun sin_real (mul_SNo two_pi a))
          (apply_fun sin_real (mul_SNo two_pi d)))
        0
        (mul_SNo
          (apply_fun sin_real (mul_SNo two_pi a))
          0)
        Hmul0
        (eq_symm
          (mul_SNo
            (apply_fun sin_real (mul_SNo two_pi a))
            0)
          0
          (mul_SNo_zeroR
            (apply_fun sin_real (mul_SNo two_pi a))
            (real_SNo
              (apply_fun sin_real (mul_SNo two_pi a))
              (sin_real_function_on (mul_SNo two_pi a) HargA)))))).
  - assume HcaNe0.
    apply (xm (apply_fun sin_real (mul_SNo two_pi a) = 0)).
    + assume Hsa0.
      claim Hmul0 :
        mul_SNo
          (apply_fun cos_real (mul_SNo two_pi a))
          (apply_fun sin_real (mul_SNo two_pi d))
        = 0.
      {
        claim Htmp :
          add_SNo
            (mul_SNo
              0
              (apply_fun cos_real (mul_SNo two_pi d)))
            (mul_SNo
              (apply_fun cos_real (mul_SNo two_pi a))
              (apply_fun sin_real (mul_SNo two_pi d)))
          =
          0.
        {
          claim HleftTmp :
            add_SNo
              (mul_SNo
                0
                (apply_fun cos_real (mul_SNo two_pi d)))
              (mul_SNo
                (apply_fun cos_real (mul_SNo two_pi a))
                (apply_fun sin_real (mul_SNo two_pi d)))
            =
            add_SNo
              (mul_SNo
                (apply_fun sin_real (mul_SNo two_pi a))
                (apply_fun cos_real (mul_SNo two_pi d)))
              (mul_SNo
                (apply_fun cos_real (mul_SNo two_pi a))
                (apply_fun sin_real (mul_SNo two_pi d))).
          {
            rewrite <- Hsa0 at 1.
            reflexivity.
          }
          claim HrightTmp :
            minus_SNo (apply_fun sin_real (mul_SNo two_pi a)) =
            minus_SNo 0.
          {
            rewrite Hsa0.
            reflexivity.
          }
          exact (eq_i_tra
            (add_SNo
              (mul_SNo
                0
                (apply_fun cos_real (mul_SNo two_pi d)))
              (mul_SNo
                (apply_fun cos_real (mul_SNo two_pi a))
                (apply_fun sin_real (mul_SNo two_pi d))))
            (add_SNo
              (mul_SNo
                (apply_fun sin_real (mul_SNo two_pi a))
                (apply_fun cos_real (mul_SNo two_pi d)))
              (mul_SNo
                (apply_fun cos_real (mul_SNo two_pi a))
                (apply_fun sin_real (mul_SNo two_pi d))))
            0
            HleftTmp
            (eq_i_tra
              (add_SNo
                (mul_SNo
                  (apply_fun sin_real (mul_SNo two_pi a))
                  (apply_fun cos_real (mul_SNo two_pi d)))
                (mul_SNo
                  (apply_fun cos_real (mul_SNo two_pi a))
                  (apply_fun sin_real (mul_SNo two_pi d))))
              (minus_SNo (apply_fun sin_real (mul_SNo two_pi a)))
              0
              HantiExpand1
              (eq_i_tra
                (minus_SNo (apply_fun sin_real (mul_SNo two_pi a)))
                (minus_SNo 0)
                0
                HrightTmp
                minus_SNo_0))).
        }
        claim HlhsEq :
          add_SNo
            (mul_SNo
              0
              (apply_fun cos_real (mul_SNo two_pi d)))
            (mul_SNo
              (apply_fun cos_real (mul_SNo two_pi a))
              (apply_fun sin_real (mul_SNo two_pi d)))
          =
          mul_SNo
            (apply_fun cos_real (mul_SNo two_pi a))
            (apply_fun sin_real (mul_SNo two_pi d)).
        {
          rewrite (mul_SNo_zeroL
            (apply_fun cos_real (mul_SNo two_pi d))
            (real_SNo
              (apply_fun cos_real (mul_SNo two_pi d))
              (cos_real_function_on (mul_SNo two_pi d) HargD))).
          exact (add_SNo_0L
            (mul_SNo
              (apply_fun cos_real (mul_SNo two_pi a))
              (apply_fun sin_real (mul_SNo two_pi d)))
            (SNo_mul_SNo
              (apply_fun cos_real (mul_SNo two_pi a))
              (apply_fun sin_real (mul_SNo two_pi d))
              (real_SNo
                (apply_fun cos_real (mul_SNo two_pi a))
                (cos_real_function_on (mul_SNo two_pi a) HargA))
              (real_SNo
                (apply_fun sin_real (mul_SNo two_pi d))
                (sin_real_function_on (mul_SNo two_pi d) HargD)))).
        }
        exact (eq_i_tra
          (mul_SNo
            (apply_fun cos_real (mul_SNo two_pi a))
            (apply_fun sin_real (mul_SNo two_pi d)))
          (add_SNo
            (mul_SNo
              0
              (apply_fun cos_real (mul_SNo two_pi d)))
            (mul_SNo
              (apply_fun cos_real (mul_SNo two_pi a))
              (apply_fun sin_real (mul_SNo two_pi d))))
          0
          (eq_symm
            (add_SNo
              (mul_SNo
                0
                (apply_fun cos_real (mul_SNo two_pi d)))
              (mul_SNo
                (apply_fun cos_real (mul_SNo two_pi a))
                (apply_fun sin_real (mul_SNo two_pi d))))
            (mul_SNo
              (apply_fun cos_real (mul_SNo two_pi a))
              (apply_fun sin_real (mul_SNo two_pi d)))
            HlhsEq)
          Htmp).
      }
      exact (mul_SNo_nonzero_cancel
        (apply_fun cos_real (mul_SNo two_pi a))
        (apply_fun sin_real (mul_SNo two_pi d))
        0
        (real_SNo
          (apply_fun cos_real (mul_SNo two_pi a))
          (cos_real_function_on (mul_SNo two_pi a) HargA))
        HcaNe0
        (real_SNo
          (apply_fun sin_real (mul_SNo two_pi d))
          (sin_real_function_on (mul_SNo two_pi d) HargD))
        SNo_0
        (eq_i_tra
          (mul_SNo
            (apply_fun cos_real (mul_SNo two_pi a))
            (apply_fun sin_real (mul_SNo two_pi d)))
          0
          (mul_SNo
            (apply_fun cos_real (mul_SNo two_pi a))
            0)
          Hmul0
          (eq_symm
            (mul_SNo
              (apply_fun cos_real (mul_SNo two_pi a))
              0)
            0
            (mul_SNo_zeroR
              (apply_fun cos_real (mul_SNo two_pi a))
              (real_SNo
                (apply_fun cos_real (mul_SNo two_pi a))
                (cos_real_function_on (mul_SNo two_pi a) HargA)))))).
    + assume HsaNe0.
      exact (andER
        (apply_fun cos_real (mul_SNo two_pi d) = minus_SNo 1)
        (apply_fun sin_real (mul_SNo two_pi d) = 0)
        (HbothNonzeroPhase HcaNe0 HsaNe0)).
}
exact (andI
  (apply_fun cos_real (mul_SNo two_pi d) = minus_SNo 1)
  (apply_fun sin_real (mul_SNo two_pi d) = 0)
  HcosD
  HsinD).
Admitted.

(** S57 helper: antipode at one anchor point gives the two trig expansion equations. **)
Theorem covering_map_R_S1_antipode_anchor_expansions :
  forall a d:set,
    a :e R ->
    d :e R ->
    apply_fun covering_map_R_S1 (add_SNo a d) =
      (minus_SNo (apply_fun covering_map_R_S1 a 0),
       minus_SNo (apply_fun covering_map_R_S1 a 1)) ->
    add_SNo
      (mul_SNo
        (apply_fun cos_real (mul_SNo two_pi a))
        (apply_fun cos_real (mul_SNo two_pi d)))
      (minus_SNo
        (mul_SNo
          (apply_fun sin_real (mul_SNo two_pi a))
          (apply_fun sin_real (mul_SNo two_pi d))))
    =
    minus_SNo (apply_fun cos_real (mul_SNo two_pi a)) /\
    add_SNo
      (mul_SNo
        (apply_fun sin_real (mul_SNo two_pi a))
        (apply_fun cos_real (mul_SNo two_pi d)))
      (mul_SNo
        (apply_fun cos_real (mul_SNo two_pi a))
        (apply_fun sin_real (mul_SNo two_pi d)))
    =
    minus_SNo (apply_fun sin_real (mul_SNo two_pi a)).
let a d.
assume HaR.
assume HdR.
assume HantiAtA.
claim HaPlusDR : add_SNo a d :e R.
{
  exact (real_add_SNo
    a
    HaR
    d
    HdR).
}
claim HargA : mul_SNo two_pi a :e R.
{
  exact (real_mul_SNo
    two_pi
    two_pi_in_R
    a
    HaR).
}
claim HargD : mul_SNo two_pi d :e R.
{
  exact (real_mul_SNo
    two_pi
    two_pi_in_R
    d
    HdR).
}
claim HgraphA :
  apply_fun covering_map_R_S1 a =
  (apply_fun cos_real (mul_SNo two_pi a),
   apply_fun sin_real (mul_SNo two_pi a)).
{
  exact (apply_fun_graph
    R
    (fun t:set =>
      (apply_fun cos_real (mul_SNo two_pi t),
       apply_fun sin_real (mul_SNo two_pi t)))
    a
    HaR).
}
claim HgraphAD :
  apply_fun covering_map_R_S1 (add_SNo a d) =
  (apply_fun cos_real (mul_SNo two_pi (add_SNo a d)),
   apply_fun sin_real (mul_SNo two_pi (add_SNo a d))).
{
  exact (apply_fun_graph
    R
    (fun t:set =>
      (apply_fun cos_real (mul_SNo two_pi t),
       apply_fun sin_real (mul_SNo two_pi t)))
    (add_SNo a d)
    HaPlusDR).
}
claim HmulAD :
  mul_SNo two_pi (add_SNo a d) =
  add_SNo (mul_SNo two_pi a) (mul_SNo two_pi d).
{
  exact (mul_SNo_distrL
    two_pi
    a
    d
    (real_SNo two_pi two_pi_in_R)
    (real_SNo a HaR)
    (real_SNo d HdR)).
}
claim HantiCoord0 :
  apply_fun cos_real (add_SNo (mul_SNo two_pi a) (mul_SNo two_pi d)) =
  minus_SNo (apply_fun cos_real (mul_SNo two_pi a)).
{
  claim HantiAtAGraph :
    (apply_fun cos_real (mul_SNo two_pi (add_SNo a d)),
     apply_fun sin_real (mul_SNo two_pi (add_SNo a d)))
    =
    (minus_SNo (apply_fun cos_real (mul_SNo two_pi a)),
     minus_SNo (apply_fun sin_real (mul_SNo two_pi a))).
  {
    claim HanchorCoords :
      (minus_SNo (apply_fun covering_map_R_S1 a 0),
       minus_SNo (apply_fun covering_map_R_S1 a 1))
      =
      (minus_SNo (apply_fun cos_real (mul_SNo two_pi a)),
       minus_SNo (apply_fun sin_real (mul_SNo two_pi a))).
    {
      rewrite HgraphA.
      rewrite tuple_2_0_eq.
      rewrite tuple_2_1_eq.
      reflexivity.
    }
    rewrite <- HgraphAD.
    exact (eq_i_tra
      (apply_fun covering_map_R_S1 (add_SNo a d))
      (minus_SNo (apply_fun covering_map_R_S1 a 0),
       minus_SNo (apply_fun covering_map_R_S1 a 1))
      (minus_SNo (apply_fun cos_real (mul_SNo two_pi a)),
       minus_SNo (apply_fun sin_real (mul_SNo two_pi a)))
      HantiAtA
      HanchorCoords).
  }
  rewrite <- HmulAD.
  exact (pair_eq_fst
    (apply_fun cos_real (mul_SNo two_pi (add_SNo a d)))
    (apply_fun sin_real (mul_SNo two_pi (add_SNo a d)))
    (minus_SNo (apply_fun cos_real (mul_SNo two_pi a)))
    (minus_SNo (apply_fun sin_real (mul_SNo two_pi a)))
    HantiAtAGraph).
}
claim HantiCoord1 :
  apply_fun sin_real (add_SNo (mul_SNo two_pi a) (mul_SNo two_pi d)) =
  minus_SNo (apply_fun sin_real (mul_SNo two_pi a)).
{
  claim HantiAtAGraph :
    (apply_fun cos_real (mul_SNo two_pi (add_SNo a d)),
     apply_fun sin_real (mul_SNo two_pi (add_SNo a d)))
    =
    (minus_SNo (apply_fun cos_real (mul_SNo two_pi a)),
     minus_SNo (apply_fun sin_real (mul_SNo two_pi a))).
  {
    claim HanchorCoords :
      (minus_SNo (apply_fun covering_map_R_S1 a 0),
       minus_SNo (apply_fun covering_map_R_S1 a 1))
      =
      (minus_SNo (apply_fun cos_real (mul_SNo two_pi a)),
       minus_SNo (apply_fun sin_real (mul_SNo two_pi a))).
    {
      rewrite HgraphA.
      rewrite tuple_2_0_eq.
      rewrite tuple_2_1_eq.
      reflexivity.
    }
    rewrite <- HgraphAD.
    exact (eq_i_tra
      (apply_fun covering_map_R_S1 (add_SNo a d))
      (minus_SNo (apply_fun covering_map_R_S1 a 0),
       minus_SNo (apply_fun covering_map_R_S1 a 1))
      (minus_SNo (apply_fun cos_real (mul_SNo two_pi a)),
       minus_SNo (apply_fun sin_real (mul_SNo two_pi a)))
      HantiAtA
      HanchorCoords).
  }
  rewrite <- HmulAD.
  exact (pair_eq_snd
    (apply_fun cos_real (mul_SNo two_pi (add_SNo a d)))
    (apply_fun sin_real (mul_SNo two_pi (add_SNo a d)))
    (minus_SNo (apply_fun cos_real (mul_SNo two_pi a)))
    (minus_SNo (apply_fun sin_real (mul_SNo two_pi a)))
    HantiAtAGraph).
}
claim HantiExpand0 :
  add_SNo
    (mul_SNo
      (apply_fun cos_real (mul_SNo two_pi a))
      (apply_fun cos_real (mul_SNo two_pi d)))
    (minus_SNo
      (mul_SNo
        (apply_fun sin_real (mul_SNo two_pi a))
        (apply_fun sin_real (mul_SNo two_pi d))))
  =
  minus_SNo (apply_fun cos_real (mul_SNo two_pi a)).
{
  rewrite <- (cos_addition
    (mul_SNo two_pi a)
    (mul_SNo two_pi d)
    HargA
    HargD).
  exact HantiCoord0.
}
claim HantiExpand1 :
  add_SNo
    (mul_SNo
      (apply_fun sin_real (mul_SNo two_pi a))
      (apply_fun cos_real (mul_SNo two_pi d)))
    (mul_SNo
      (apply_fun cos_real (mul_SNo two_pi a))
      (apply_fun sin_real (mul_SNo two_pi d)))
  =
  minus_SNo (apply_fun sin_real (mul_SNo two_pi a)).
{
  rewrite <- (sin_addition
    (mul_SNo two_pi a)
    (mul_SNo two_pi d)
    HargA
    HargD).
  exact HantiCoord1.
}
exact (andI
  (add_SNo
    (mul_SNo
      (apply_fun cos_real (mul_SNo two_pi a))
      (apply_fun cos_real (mul_SNo two_pi d)))
    (minus_SNo
      (mul_SNo
        (apply_fun sin_real (mul_SNo two_pi a))
        (apply_fun sin_real (mul_SNo two_pi d))))
   =
   minus_SNo (apply_fun cos_real (mul_SNo two_pi a)))
  (add_SNo
    (mul_SNo
      (apply_fun sin_real (mul_SNo two_pi a))
      (apply_fun cos_real (mul_SNo two_pi d)))
    (mul_SNo
      (apply_fun cos_real (mul_SNo two_pi a))
     (apply_fun sin_real (mul_SNo two_pi d)))
   =
   minus_SNo (apply_fun sin_real (mul_SNo two_pi a)))
  HantiExpand0
  HantiExpand1).
Admitted.

Theorem covering_map_R_S1_shift_from_trig_values :
  forall x d:set,
    x :e R ->
    d :e R ->
    apply_fun cos_real (mul_SNo two_pi d) = minus_SNo 1 ->
    apply_fun sin_real (mul_SNo two_pi d) = 0 ->
    apply_fun covering_map_R_S1 (add_SNo x d) =
      (minus_SNo (apply_fun covering_map_R_S1 x 0),
       minus_SNo (apply_fun covering_map_R_S1 x 1)).
let x d.
assume HxR.
assume HdR.
assume HcosD.
assume HsinD.
claim HxPlusDR : add_SNo x d :e R.
{
  exact (real_add_SNo
    x
    HxR
    d
    HdR).
}
claim HargX : mul_SNo two_pi x :e R.
{
  exact (real_mul_SNo
    two_pi
    two_pi_in_R
    x
    HxR).
}
claim HargD : mul_SNo two_pi d :e R.
{
  exact (real_mul_SNo
    two_pi
    two_pi_in_R
    d
    HdR).
}
claim HgraphX :
  apply_fun covering_map_R_S1 x =
  (apply_fun cos_real (mul_SNo two_pi x),
   apply_fun sin_real (mul_SNo two_pi x)).
{
  exact (apply_fun_graph
    R
    (fun t:set =>
      (apply_fun cos_real (mul_SNo two_pi t),
       apply_fun sin_real (mul_SNo two_pi t)))
    x
    HxR).
}
claim HgraphXD :
  apply_fun covering_map_R_S1 (add_SNo x d) =
  (apply_fun cos_real (mul_SNo two_pi (add_SNo x d)),
   apply_fun sin_real (mul_SNo two_pi (add_SNo x d))).
{
  exact (apply_fun_graph
    R
    (fun t:set =>
      (apply_fun cos_real (mul_SNo two_pi t),
       apply_fun sin_real (mul_SNo two_pi t)))
    (add_SNo x d)
    HxPlusDR).
}
claim HmulXD :
  mul_SNo two_pi (add_SNo x d) =
  add_SNo (mul_SNo two_pi x) (mul_SNo two_pi d).
{
  exact (mul_SNo_distrL
    two_pi
    x
    d
    (real_SNo two_pi two_pi_in_R)
    (real_SNo x HxR)
    (real_SNo d HdR)).
}
claim Hcoord0 :
  apply_fun cos_real (add_SNo (mul_SNo two_pi x) (mul_SNo two_pi d)) =
  minus_SNo (apply_fun cos_real (mul_SNo two_pi x)).
{
  rewrite (cos_addition
    (mul_SNo two_pi x)
    (mul_SNo two_pi d)
    HargX
    HargD).
  rewrite HcosD.
  rewrite HsinD.
  rewrite (mul_SNo_zeroR
    (apply_fun sin_real (mul_SNo two_pi x))
    (real_SNo
      (apply_fun sin_real (mul_SNo two_pi x))
      (sin_real_function_on (mul_SNo two_pi x) HargX))).
  rewrite minus_SNo_0.
  rewrite (mul_SNo_minus_distrR
    (apply_fun cos_real (mul_SNo two_pi x))
    1
    (real_SNo
      (apply_fun cos_real (mul_SNo two_pi x))
      (cos_real_function_on (mul_SNo two_pi x) HargX))
    SNo_1).
  rewrite (mul_SNo_oneR
    (apply_fun cos_real (mul_SNo two_pi x))
    (real_SNo
      (apply_fun cos_real (mul_SNo two_pi x))
      (cos_real_function_on (mul_SNo two_pi x) HargX))).
  rewrite (add_SNo_0R
    (minus_SNo (apply_fun cos_real (mul_SNo two_pi x)))
    (SNo_minus_SNo
      (apply_fun cos_real (mul_SNo two_pi x))
      (real_SNo
        (apply_fun cos_real (mul_SNo two_pi x))
        (cos_real_function_on (mul_SNo two_pi x) HargX)))).
  reflexivity.
}
claim Hcoord1 :
  apply_fun sin_real (add_SNo (mul_SNo two_pi x) (mul_SNo two_pi d)) =
  minus_SNo (apply_fun sin_real (mul_SNo two_pi x)).
{
  rewrite (sin_addition
    (mul_SNo two_pi x)
    (mul_SNo two_pi d)
    HargX
    HargD).
  rewrite HcosD.
  rewrite HsinD.
  rewrite (mul_SNo_zeroR
    (apply_fun cos_real (mul_SNo two_pi x))
    (real_SNo
      (apply_fun cos_real (mul_SNo two_pi x))
      (cos_real_function_on (mul_SNo two_pi x) HargX))).
  rewrite (mul_SNo_minus_distrR
    (apply_fun sin_real (mul_SNo two_pi x))
    1
    (real_SNo
      (apply_fun sin_real (mul_SNo two_pi x))
      (sin_real_function_on (mul_SNo two_pi x) HargX))
    SNo_1).
  rewrite (mul_SNo_oneR
    (apply_fun sin_real (mul_SNo two_pi x))
    (real_SNo
      (apply_fun sin_real (mul_SNo two_pi x))
      (sin_real_function_on (mul_SNo two_pi x) HargX))).
  rewrite (add_SNo_0R
    (minus_SNo (apply_fun sin_real (mul_SNo two_pi x)))
    (SNo_minus_SNo
      (apply_fun sin_real (mul_SNo two_pi x))
      (real_SNo
        (apply_fun sin_real (mul_SNo two_pi x))
        (sin_real_function_on (mul_SNo two_pi x) HargX)))).
  reflexivity.
}
rewrite HgraphXD.
rewrite HmulXD.
rewrite Hcoord0.
rewrite Hcoord1.
rewrite HgraphX.
rewrite tuple_2_0_eq.
rewrite tuple_2_1_eq.
reflexivity.
Admitted.

Theorem covering_map_R_S1_antipode_shift_from_one_point :
  forall x a d:set,
    x :e R ->
    a :e R ->
    d :e R ->
    apply_fun covering_map_R_S1 (add_SNo a d) =
      (minus_SNo (apply_fun covering_map_R_S1 a 0),
       minus_SNo (apply_fun covering_map_R_S1 a 1)) ->
    apply_fun covering_map_R_S1 (add_SNo x d) =
      (minus_SNo (apply_fun covering_map_R_S1 x 0),
       minus_SNo (apply_fun covering_map_R_S1 x 1)).
let x a d.
assume HxR.
assume HaR.
assume HdR.
assume HantiAtA.
claim HxPlusDR : add_SNo x d :e R.
{
  exact (real_add_SNo
    x
    HxR
    d
    HdR).
}
claim HaPlusDR : add_SNo a d :e R.
{
  exact (real_add_SNo
    a
    HaR
    d
    HdR).
}
claim HargA : mul_SNo two_pi a :e R.
{
  exact (real_mul_SNo
    two_pi
    two_pi_in_R
    a
    HaR).
}
claim HargD : mul_SNo two_pi d :e R.
{
  exact (real_mul_SNo
    two_pi
    two_pi_in_R
    d
    HdR).
}
claim HargAD : mul_SNo two_pi (add_SNo a d) :e R.
{
  exact (real_mul_SNo
    two_pi
    two_pi_in_R
    (add_SNo a d)
    HaPlusDR).
}
claim HargX : mul_SNo two_pi x :e R.
{
  exact (real_mul_SNo
    two_pi
    two_pi_in_R
    x
    HxR).
}
claim HargXD : mul_SNo two_pi (add_SNo x d) :e R.
{
  exact (real_mul_SNo
    two_pi
    two_pi_in_R
    (add_SNo x d)
    HxPlusDR).
}
claim HgraphA :
  apply_fun covering_map_R_S1 a =
  (apply_fun cos_real (mul_SNo two_pi a),
   apply_fun sin_real (mul_SNo two_pi a)).
{
  exact (apply_fun_graph
    R
    (fun t:set =>
      (apply_fun cos_real (mul_SNo two_pi t),
       apply_fun sin_real (mul_SNo two_pi t)))
    a
    HaR).
}
claim HgraphAD :
  apply_fun covering_map_R_S1 (add_SNo a d) =
  (apply_fun cos_real (mul_SNo two_pi (add_SNo a d)),
   apply_fun sin_real (mul_SNo two_pi (add_SNo a d))).
{
  exact (apply_fun_graph
    R
    (fun t:set =>
      (apply_fun cos_real (mul_SNo two_pi t),
       apply_fun sin_real (mul_SNo two_pi t)))
    (add_SNo a d)
    HaPlusDR).
}
claim HgraphX :
  apply_fun covering_map_R_S1 x =
  (apply_fun cos_real (mul_SNo two_pi x),
   apply_fun sin_real (mul_SNo two_pi x)).
{
  exact (apply_fun_graph
    R
    (fun t:set =>
      (apply_fun cos_real (mul_SNo two_pi t),
       apply_fun sin_real (mul_SNo two_pi t)))
    x
    HxR).
}
claim HgraphXD :
  apply_fun covering_map_R_S1 (add_SNo x d) =
  (apply_fun cos_real (mul_SNo two_pi (add_SNo x d)),
   apply_fun sin_real (mul_SNo two_pi (add_SNo x d))).
{
  exact (apply_fun_graph
    R
    (fun t:set =>
      (apply_fun cos_real (mul_SNo two_pi t),
       apply_fun sin_real (mul_SNo two_pi t)))
