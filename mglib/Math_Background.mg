apply (SepI
  (total_function_space 3 R)
  (fun u:set =>
    (forall i:set, i :e 3 -> ~(Rlt (apply_fun u i) 0)) /\
    finite_real_sum (fun i:set => apply_fun u i) 3 = 1)
  w).
- exact HwTotal.
- apply andI.
  * exact HwNonneg.
  * exact Hsum1.
