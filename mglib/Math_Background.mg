        x2
        (mul_const_fun (apply_fun A (2, 2)))
        p
        HpT).
      rewrite (mul_const_fun_apply
        (apply_fun A (2, 2))
        (apply_fun x2 p)
        HA22R
        Hx2R).
      exact (mul_SNo_com
