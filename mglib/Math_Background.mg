      (euclidean_space_coord_in_R n v j Hv Hj)
      (apply_fun v j)
      (euclidean_space_coord_in_R n v j Hv Hj))
  (fun j Hj =>
    Rle_of_SNoLe
      0
      (mul_SNo (apply_fun v j) (apply_fun v j))
      real_0
      (real_mul_SNo
        (apply_fun v j)
        (euclidean_space_coord_in_R n v j Hv Hj)
        (apply_fun v j)
        (euclidean_space_coord_in_R n v j Hv Hj))
      (SNo_sqr_nonneg
        (apply_fun v j)
        (real_SNo
          (apply_fun v j)
          (euclidean_space_coord_in_R n v j Hv Hj))))).
Qed.

