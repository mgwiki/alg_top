Theorem cor82_2_universal_covering_existence :
  forall B Tb:set,
  (exists E Te p:set,
    covering_map E Te B Tb p /\ simply_connected E Te)
  <->
  (path_connected_space B Tb /\ locally_path_connected B Tb /\
   semilocally_simply_connected B Tb).
