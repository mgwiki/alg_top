claim HnegySn :
  Rn_negate (ordsucc n) y :e Sn n.
{
  exact (Rn_negate_in_Sn_ordsucc
    n
    y
    Hn_om
    HySn).
}
claim HnegyEq :
  Rn_negate (ordsucc n) y =
  Rn_scalar_mult (ordsucc n) a x.
{
  rewrite HyEq.
  rewrite (Rn_negate_scalar_mult
    (ordsucc n)
    (minus_SNo a)
    x
    HxEu
    (real_minus_SNo
      a
