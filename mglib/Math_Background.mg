(** Proven Bob **)
Theorem simply_connected_topology_eq_transport :
  forall X T1 T2:set,
  T1 = T2 ->
  simply_connected X T1 ->
  simply_connected X T2.
let X T1 T2.
assume Heq Hsimp.
rewrite <- Heq.
exact Hsimp.
Qed.

