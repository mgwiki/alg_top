              xcoord
              HtopDom
              HlamCont
              HxcoordCont).
          }
          claim HcoordGraphFun :
            function_on
              (graph dom (fun p:set =>
                mul_SNo
                  (apply_fun lam p)
                  (apply_fun (apply_fun r (p 0)) i)))
              dom
              R.
          {
            exact (function_on_of_function_space
              (graph dom (fun p:set =>
                mul_SNo
                  (apply_fun lam p)
                  (apply_fun (apply_fun r (p 0)) i)))
              dom
              R
              (graph_in_function_space
                dom
                R
                (fun p:set =>
                  mul_SNo
                    (apply_fun lam p)
                    (apply_fun (apply_fun r (p 0)) i))
                (fun p Hp =>
                  Hcoord_val_in_R
                    i
                    p
                    Hi
                    Hp))).
          }
          claim HprodEqOn :
            forall p:set, p :e dom ->
              apply_fun prodcoord p =
              apply_fun
                (graph dom (fun p0:set =>
                  mul_SNo
                    (apply_fun lam p0)
                    (apply_fun (apply_fun r (p0 0)) i)))
                p.
          {
            let p.
            assume Hp.
            claim HxcoordVal :
              apply_fun xcoord p = apply_fun (apply_fun r (p 0)) i.
            {
              rewrite (compose_fun_apply
                dom
                rx
