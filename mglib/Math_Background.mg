            HprojPairU).
        }
        claim Hg1Cont :
          continuous_map
            W
            (product_topology U (subspace_topology B Tb U) U' (subspace_topology B' Tb' U'))
            (w 0)
            (subspace_topology E Te (w 0))
            g1.
        {
          exact (composition_continuous
            W
            (product_topology U (subspace_topology B Tb U) U' (subspace_topology B' Tb' U'))
            U
            (subspace_topology B Tb U)
            (w 0)
            (subspace_topology E Te (w 0))
            (projection_map1 U U')
