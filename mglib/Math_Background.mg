- let x.
  assume HxRest.
  claim HxInt : x :e A :/\: C.
  {
    exact (setminusE1
      (A :/\: C)
      B
      x
      HxRest).
  }
  claim HxNotB : x /:e B.
  {
    exact (setminusE2
      (A :/\: C)
      B
      x
      HxRest).
  }
  claim HxA : x :e A.
  {
    exact (binintersectE1
      A
      C
      x
      HxInt).
  }
  claim HxC : x :e C.
  {
    exact (binintersectE2
      A
      C
      x
      HxInt).
  }
  exact (binintersectI
    (A :\: B)
    C
    x
    (setminusI
      A
      B
      x
      HxA
      HxNotB)
