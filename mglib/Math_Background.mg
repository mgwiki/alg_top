      p
      HpR2m0).
  }
  claim HpNot00 : ~(p 0 = 0 /\ p 1 = 0).
  {
    exact (SepE2
      (setprod R R)
      (fun q:set => ~(q 0 = 0 /\ q 1 = 0))
