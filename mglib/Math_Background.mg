    claim HliftFxLeft :
      continuous_map unit_interval unit_interval_topology E Te lx /\
      apply_fun lx 0 = e0.
    {
      exact (andEL
        (continuous_map unit_interval unit_interval_topology E Te lx /\
          apply_fun lx 0 = e0)
