                   A (subspace_topology B2 B2_topology A) f ->
    exists x:set, x :e A /\ apply_fun f x = x.
let A.
assume Hretr.
let f.
assume HfCont.
claim HAsub : A c= B2.
{
  exact (andEL
    (A c= B2)
    (exists r:set,
      function_on r B2 B2 /\
      continuous_map B2 B2_topology B2 B2_topology r /\
