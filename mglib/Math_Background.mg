      T
      ArcsT
      X
      Tx
      Arcs
      A
      Htree
      HA
      Hnsub
      HmeetEx).
  }
  exact (lemma84_2_tree_extension_from_hypotheses_and_components
    T
    ArcsT
    X
    Tx
    Arcs
    A
    Htree
    HA
    Hnsub
    HmeetEx
    HglgTA
    HconnTA
    HnoloopTA).
}
