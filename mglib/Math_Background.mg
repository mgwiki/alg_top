    claim HfLoop : f :e loop_space R R_standard_topology 0.
    {
      exact (andEL
        (f :e loop_space R R_standard_topology 0)
        (cls = path_homotopy_class_loop R R_standard_topology 0 f)
        Hfpack).
    }
    claim HclsEqF :
      cls = path_homotopy_class_loop R R_standard_topology 0 f.
    {
