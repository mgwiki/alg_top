          (setprod X Y) Tprod (x0, y0) X Tx x0 (projection_map1 X Y)
          cls_XY HclsXY_in).
        (** eps_XY = Eps_i(g: g in cls_XY), it is in cls_XY = [gamma] **)
        set eps_XY := Eps_i (fun f:set => f :e cls_XY).
        claim Heps_XY_in_cls : eps_XY :e cls_XY.
        {
