                  exact (ReplI (Ga (apply_fun e_bij i))
                    (fun z => apply_fun (apply_fun ifam (apply_fun e_bij i)) z)
                    (f (apply_fun e_bij i))
                    (HG_ap f Hf (apply_fun e_bij i) (Hei_J i Hi))).
