            rewrite HuofEval.
            exact (Eps_i_ex
              (fun u:set =>
                apply_fun aof' i :e J /\
                u :e apply_fun Gfam (apply_fun aof' i) /\
                apply_fun xs' i =
                  apply_fun (apply_fun ifam (apply_fun aof' i)) u)
              HexUi).
          }
          witness aof'.
          witness uof'.
          let i.
          assume Hi : i :e n'.
          exact (HuofPack i Hi).
