  exact (function_on_restrict_dom
    seq'
    (n :\/: {n})
    (ordsucc n)
    (setprod (setprod X X) (Power X))
    HfunSeq'
    HsuccSub).
- let i.
  assume Hi.
  apply (ordsuccE
    n
    i
    Hi).
  * assume Hin.
    apply (edge_path_edge_decomposition
      X
      Tx
      Arcs
      n
      path_seq
      x0
      i
      Hep
      Hin).
    let A0.
    assume HA0.
    apply HA0.
    let ini0.
    assume Hini0.
    apply Hini0.
    let fin0.
    assume Hfin0.
    claim Happ :
      apply_fun seq' i = apply_fun path_seq i.
    {
      rewrite (apply_fun_union_left
        n
        {n}
        (setprod (setprod X X) (Power X))
        (graph n (fun i0:set => apply_fun path_seq i0))
        (graph {n} (fun _:set => ((p, q), A)))
        i
        HdisjDom
        HdomLeft
        HdomRight
        HtotLeft
        HtotRight
        HfuncLeft
        HfuncRight
        Hin).
      rewrite (apply_fun_graph n (fun i0:set => apply_fun path_seq i0) i Hin).
      reflexivity.
    }
    witness A0.
    witness ini0.
    witness fin0.
    apply andI.
    { rewrite Happ.
      exact (andEL
        (apply_fun path_seq i = ((ini0, fin0), A0))
        (oriented_edge X Tx Arcs A0 ini0 fin0)
        Hfin0). }
    { exact (andER
        (apply_fun path_seq i = ((ini0, fin0), A0))
        (oriented_edge X Tx Arcs A0 ini0 fin0)
        Hfin0). }
  * assume HiEq.
    witness A.
    witness p.
    witness q.
    apply andI.
    { rewrite HiEq.
      claim HnIn : n :e {n}.
      { exact (SingI n). }
      rewrite (apply_fun_union_right
        n
        {n}
        (setprod (setprod X X) (Power X))
        (graph n (fun i0:set => apply_fun path_seq i0))
        (graph {n} (fun _:set => ((p, q), A)))
        n
        HdisjDom
        HdomLeft
        HdomRight
        HtotLeft
        HtotRight
        HfuncLeft
        HfuncRight
        HnIn).
      rewrite (apply_fun_graph {n} (fun _:set => ((p, q), A)) n HnIn).
      reflexivity. }
    { exact Hori. }
- assume Hsn0.
  claim H0In : 0 :e n.
  { exact Hj0InN. }
  rewrite (apply_fun_union_left
    n
    {n}
    (setprod (setprod X X) (Power X))
    (graph n (fun i0:set => apply_fun path_seq i0))
    (graph {n} (fun _:set => ((p, q), A)))
    0
    HdisjDom
    HdomLeft
    HdomRight
    HtotLeft
    HtotRight
    HfuncLeft
    HfuncRight
    H0In).
  rewrite (apply_fun_graph n (fun i0:set => apply_fun path_seq i0) 0 H0In).
  exact (edge_path_start_vertex
    X
    Tx
    Arcs
    n
    path_seq
    x0
    Hep
    HnNe0).
- let i.
  assume Hi His.
  apply (ordsuccE
    n
    i
    Hi).
  * assume Hin.
    apply (ordsuccE
      n
      (ordsucc i)
      His).
    + assume HsIn.
      (** internal old step **)
      rewrite (apply_fun_union_left
        n
        {n}
        (setprod (setprod X X) (Power X))
        (graph n (fun i0:set => apply_fun path_seq i0))
        (graph {n} (fun _:set => ((p, q), A)))
        i
        HdisjDom
        HdomLeft
        HdomRight
        HtotLeft
        HtotRight
        HfuncLeft
        HfuncRight
        Hin).
      rewrite (apply_fun_graph n (fun i0:set => apply_fun path_seq i0) i Hin).
      rewrite (apply_fun_union_left
        n
        {n}
        (setprod (setprod X X) (Power X))
        (graph n (fun i0:set => apply_fun path_seq i0))
        (graph {n} (fun _:set => ((p, q), A)))
        (ordsucc i)
        HdisjDom
        HdomLeft
        HdomRight
        HtotLeft
        HtotRight
        HfuncLeft
        HfuncRight
        HsIn).
      rewrite (apply_fun_graph n (fun i0:set => apply_fun path_seq i0) (ordsucc i) HsIn).
      exact (edge_path_consecutive_match
        X
        Tx
        Arcs
        n
        path_seq
        x0
        i
        Hep
        Hin
        HsIn).
    + assume HsEq.
      (** junction step: ordsucc i = n, so i is j and we connect to the appended edge **)
      claim HiEqj : i = j.
      {
        claim HSjEqN : ordsucc j = n.
        {
          rewrite HnEqSj.
          reflexivity.
        }
        claim HsEq2 : ordsucc i = ordsucc j.
        {
          rewrite HSjEqN.
          exact HsEq.
        }
        exact (ordsucc_inj
          i
          j
          HsEq2).
      }
      rewrite (apply_fun_union_left
        n
        {n}
        (setprod (setprod X X) (Power X))
        (graph n (fun i0:set => apply_fun path_seq i0))
        (graph {n} (fun _:set => ((p, q), A)))
        i
        HdisjDom
        HdomLeft
        HdomRight
        HtotLeft
        HtotRight
        HfuncLeft
        HfuncRight
        Hin).
      rewrite (apply_fun_graph n (fun i0:set => apply_fun path_seq i0) i Hin).
      rewrite HiEqj.
      rewrite Hfinj.
      claim HSjEqN : ordsucc j = n.
      {
        rewrite <- HiEqj.
        exact HsEq.
      }
      rewrite HSjEqN.
      claim HnIn : n :e {n}.
      { exact (SingI n). }
      rewrite (apply_fun_union_right
        n
        {n}
        (setprod (setprod X X) (Power X))
        (graph n (fun i0:set => apply_fun path_seq i0))
        (graph {n} (fun _:set => ((p, q), A)))
        n
        HdisjDom
        HdomLeft
        HdomRight
        HtotLeft
        HtotRight
        HfuncLeft
        HfuncRight
        HnIn).
      rewrite (apply_fun_graph {n} (fun _:set => ((p, q), A)) n HnIn).
      rewrite (tuple_2_0_eq (p, q) A).
      rewrite tuple_2_0_eq.
      reflexivity.
  * assume HiEq.
    (** no successor step from the appended edge **)
    claim HsEq0 : ordsucc n = ordsucc i.
    {
      rewrite HiEq.
      reflexivity.
    }
    claim Hbad : ordsucc n :e ordsucc n.
    {
      exact (eq_subst_mem
        (ordsucc n)
        (ordsucc i)
        (ordsucc n)
        HsEq0
        His).
    }
    exact (FalseE
      (In_irref (ordsucc n) Hbad)
      ((apply_fun seq' i) 0 1 = (apply_fun seq' (ordsucc i)) 0 0)).
Qed.

(** from S84 Definition (line 5581 in algtop.tex): tree **)
(** LATEX VERSION: A subgraph T of X is a tree if T is connected and **)
(** T contains no closed reduced edge paths. **)
(** Admin-approved-refactored per noticeboard proposal 1772495150 **)
Definition tree_in_graph : set -> set -> set -> set -> set -> prop :=
  fun T ArcsT X Tx Arcs =>
    subgraph_of T X Tx Arcs /\
    ArcsT c= Arcs /\
    general_linear_graph T (subspace_topology X Tx T) ArcsT /\
    connected_space T (subspace_topology X Tx T) /\
    ~(exists n path_seq x0:set,
        n :e omega /\ n <> 0 /\
        reduced_edge_path T (subspace_topology X Tx T) ArcsT n path_seq x0 /\
        (exists j:set, j :e n /\ ordsucc j /:e n /\
          (apply_fun path_seq j) 0 1 = x0)).

(** from S84 Definition (line 5623 in algtop.tex): maximal tree **)
(** LATEX VERSION: A tree T in X is maximal if no tree in X properly contains T. **)
Definition maximal_tree : set -> set -> set -> set -> set -> prop :=
  fun T ArcsT X Tx Arcs =>
    tree_in_graph T ArcsT X Tx Arcs /\
    (forall T' ArcsT':set,
      tree_in_graph T' ArcsT' X Tx Arcs ->
      T c= T' -> T' = T).

(** Infrastructure: constructors for tree_in_graph / maximal_tree **)
(** Proven Bob **)
Theorem tree_in_graph_intro :
  forall T ArcsT X Tx Arcs:set,
  subgraph_of T X Tx Arcs ->
  ArcsT c= Arcs ->
  general_linear_graph T (subspace_topology X Tx T) ArcsT ->
  connected_space T (subspace_topology X Tx T) ->
  ~(exists n path_seq x0:set,
      n :e omega /\ n <> 0 /\
      reduced_edge_path T (subspace_topology X Tx T) ArcsT n path_seq x0 /\
      (exists j:set, j :e n /\ ordsucc j /:e n /\
        (apply_fun path_seq j) 0 1 = x0)) ->
  tree_in_graph T ArcsT X Tx Arcs.
let T ArcsT X Tx Arcs.
assume Hsub HarcsSub HglgT HconnT Hnoloop.
exact (and5I
  (subgraph_of T X Tx Arcs)
  (ArcsT c= Arcs)
  (general_linear_graph T (subspace_topology X Tx T) ArcsT)
  (connected_space T (subspace_topology X Tx T))
  (~(exists n path_seq x0:set,
      n :e omega /\ n <> 0 /\
      reduced_edge_path T (subspace_topology X Tx T) ArcsT n path_seq x0 /\
      (exists j:set, j :e n /\ ordsucc j /:e n /\
        (apply_fun path_seq j) 0 1 = x0)))
  Hsub
  HarcsSub
  HglgT
  HconnT
  Hnoloop).
Qed.

(** Proven Bob **)
Theorem maximal_tree_intro :
  forall T ArcsT X Tx Arcs:set,
  tree_in_graph T ArcsT X Tx Arcs ->
  (forall T' ArcsT':set,
    tree_in_graph T' ArcsT' X Tx Arcs ->
    T c= T' -> T' = T) ->
  maximal_tree T ArcsT X Tx Arcs.
let T ArcsT X Tx Arcs.
assume Htree Hmaxprop.
exact (andI
  (tree_in_graph T ArcsT X Tx Arcs)
  (forall T' ArcsT':set,
    tree_in_graph T' ArcsT' X Tx Arcs ->
    T c= T' -> T' = T)
  Htree
  Hmaxprop).
Qed.

