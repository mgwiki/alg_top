      R.
  {
    exact (function_on_of_function_space
      (graph dom (fun y:set =>
        mul_SNo (apply_fun lam y) (apply_fun y i)))
      dom
      R
      (graph_in_function_space
        dom
        R
        (fun y:set =>
          mul_SNo (apply_fun lam y) (apply_fun y i))
        (fun y Hy =>
          Hcoord_val_in_R
            i
            y
            Hi
            Hy))).
  }
  claim HprodEqOn :
    forall y:set, y :e dom ->
      apply_fun prodcoord y =
