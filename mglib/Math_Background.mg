											            (beta :e (UPair 0 1))
											            (apply_fun xs12 t :e apply_fun Gfam12 beta)
											            (apply_fun xs12 t <> apply_fun (graph (UPair 0 1) (fun _:set => eG)) beta)
											            Hbeta_pack).
