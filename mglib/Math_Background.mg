Axiom Zplus_Subq_R : Zplus c= R.
Axiom Zplus_ordsucc_closed : forall n : set , n :e Zplus -> ordsucc n :e Zplus.
Axiom nat_nonzero_in_Zplus : forall n : set , nat_p n -> n <> 0 -> n :e Zplus.
Axiom singleton_ordsucc0_in_order_topology_basis_Zplus : {ordsucc 0} :e order_topology_basis Zplus.
Axiom singleton_ordsucc_in_order_topology_basis_Zplus : forall m : set , m :e Zplus -> {ordsucc m} :e order_topology_basis Zplus.
Axiom singleton_in_order_topology_basis_Zplus : forall n : set , n :e Zplus -> {n} :e order_topology_basis Zplus.
Axiom Zplus_order_topology_is_discrete : generated_topology Zplus (order_topology_basis Zplus) = Power Zplus.
Axiom order_topology_on_Zplus_discrete : order_topology Zplus = discrete_topology Zplus.
Axiom omega_order_topology_is_discrete : generated_topology omega (order_topology_basis omega) = Power omega.
Axiom order_topology_on_omega_discrete : order_topology omega = discrete_topology omega.
Axiom and_assoc : forall A B C : prop , (A /\ B) /\ C -> A /\ (B /\ C).
Axiom and_assoc_rev : forall A B C : prop , A /\ (B /\ C) -> (A /\ B) /\ C.
Axiom and7E : forall A B C D E F G : prop , A /\ B /\ C /\ D /\ E /\ F /\ G -> forall p : prop , (A -> B -> C -> D -> E -> F -> G -> p) -> p.
Axiom and4E : forall A B C D : prop , A /\ B /\ C /\ D -> forall p : prop , (A -> B -> C -> D -> p) -> p.
Axiom and5E : forall A B C D E : prop , A /\ B /\ C /\ D /\ E -> forall p : prop , (A -> B -> C -> D -> E -> p) -> p.
Axiom and6E : forall A B C D E F : prop , A /\ B /\ C /\ D /\ E /\ F -> forall p : prop , (A -> B -> C -> D -> E -> F -> p) -> p.
Axiom mem_eqR : forall x A B : set , A = B -> x :e A -> x :e B.
Axiom mem_eqL : forall x A B : set , A = B -> x :e B -> x :e A.
Axiom conj7_last_disjE : forall i m j n a b : set , i :e 2 /\ m :e omega /\ j :e 2 /\ n :e omega /\ a = (i,m) /\ b = (j,n) /\ (i :e j \/ (i = j /\ m :e n)) -> (i :e j \/ (i = j /\ m :e n)).
Definition two_by_nat : set := setprod 2 omega.
Definition two_by_nat_order_topology : set := order_topology two_by_nat.
Axiom two_by_nat_singleton_not_in_basis : {(1,0)} /:e order_topology_basis two_by_nat.
Axiom two_by_nat_singleton_not_open : ~ ({(1,0)} :e two_by_nat_order_topology).
Axiom two_by_nat_not_discrete : ~ (two_by_nat_order_topology = discrete_topology two_by_nat).
Axiom simply_ordered_set_setprod_2_omega : simply_ordered_set (setprod 2 omega).
Axiom pair_eq_fst : forall a b c d : set , (a,b) = (c,d) -> a = c.
Axiom pair_eq_snd : forall a b c d : set , (a,b) = (c,d) -> b = d.
Axiom no_point_between_setprod_2_omega_0k_0succk : forall k y : set , k :e omega -> y :e setprod 2 omega -> order_rel (setprod 2 omega) (0,k) y -> order_rel (setprod 2 omega) y (0,ordsucc k) -> False.
Axiom no_point_between_setprod_2_omega_1n_1succn : forall n y : set , n :e omega -> y :e setprod 2 omega -> order_rel (setprod 2 omega) (1,n) y -> order_rel (setprod 2 omega) y (1,ordsucc n) -> False.
Axiom open_ray_lower_setprod_2_omega_01_eq_Sing00 : open_ray_lower (setprod 2 omega) (0,1) = {(0,0)}.
Axiom singleton_setprod_2_omega_00_open : {(0,0)} :e order_topology (setprod 2 omega).
Axiom singleton_setprod_2_omega_0k_open : forall k : set , k :e omega -> {(0,k)} :e order_topology (setprod 2 omega).
Axiom singleton_setprod_2_omega_1n_open_if_nonzero : forall n : set , n :e omega -> n <> 0 -> {(1,n)} :e order_topology (setprod 2 omega).
Axiom setminus_open_ray_upper_setprod_2_omega_0k : forall k : set , k :e omega -> (setprod 2 omega) :\: open_ray_upper (setprod 2 omega) (0,k) = open_ray_lower (setprod 2 omega) (0,ordsucc k).
Axiom setminus_open_ray_lower_setprod_2_omega_1succ : forall n : set , n :e omega -> (setprod 2 omega) :\: open_ray_lower (setprod 2 omega) (1,ordsucc n) = open_ray_upper (setprod 2 omega) (1,n).
Definition rectangle_set : set -> set -> set := fun U V => setprod U V.
Axiom rectangle_set_def : forall U V : set , rectangle_set U V = setprod U V.
Axiom tuple_2_rectangle_set : forall U V : set , forall x y : set , x :e U -> y :e V -> (x,y) :e rectangle_set U V.
Axiom setprod_eta : forall X Y p : set , p :e setprod X Y -> p = (p 0,p 1).
Axiom setprod_Subq : forall U V X Y : set , U c= X -> V c= Y -> setprod U V c= setprod X Y.
Axiom setprod_elem_decompose : forall X Y p : set , p :e setprod X Y -> exists x :e X , exists y :e Y , p :e setprod {x} {y}.
Axiom singleton_subset : forall x U : set , x :e U -> {x} c= U.
Axiom singleton_elem : forall x y : set , x :e {y} -> x = y.
Axiom setprod_coords_in : forall x y U V p : set , p :e setprod {x} {y} -> p :e setprod U V -> x :e U /\ y :e V.
Axiom setprod_intersection : forall U1 V1 U2 V2 : set , setprod U1 V1 :/\: setprod U2 V2 = setprod (U1 :/\: U2) (V1 :/\: V2).
Definition product_subbasis : set -> set -> set -> set -> set := fun X Tx Y Ty => \/_ U :e Tx , {rectangle_set U V|V :e Ty}.
Definition product_topology : set -> set -> set -> set -> set := fun X Tx Y Ty => generated_topology (setprod X Y) (product_subbasis X Tx Y Ty).
Axiom product_subbasis_is_basis : forall X Tx Y Ty : set , topology_on X Tx -> topology_on Y Ty -> basis_on (setprod X Y) (product_subbasis X Tx Y Ty).
Axiom product_topology_is_topology : forall X Tx Y Ty : set , topology_on X Tx -> topology_on Y Ty -> topology_on (setprod X Y) (product_topology X Tx Y Ty).
Definition product_basis_from : set -> set -> set := fun Bx By => \/_ U :e Bx , {setprod U V|V :e By}.
Axiom product_basis_generates_product_topology : forall X Y Bx By Tx Ty : set , basis_on X Bx -> generated_topology X Bx = Tx -> basis_on Y By -> generated_topology Y By = Ty -> generated_topology (setprod X Y) (product_basis_from Bx By) = product_topology X Tx Y Ty.
Axiom product_basis_from_is_basis_on : forall X Y Bx By Tx Ty : set , basis_on X Bx -> generated_topology X Bx = Tx -> basis_on Y By -> generated_topology Y By = Ty -> basis_on (setprod X Y) (product_basis_from Bx By).
Axiom product_basis_generates : forall X Tx Y Ty Bx By : set , basis_on X Bx /\ generated_topology X Bx = Tx -> basis_on Y By /\ generated_topology Y By = Ty -> exists B : set , basis_on (setprod X Y) B /\ (forall U :e Bx , forall V :e By , setprod U V :e B) /\ generated_topology (setprod X Y) B = product_topology X Tx Y Ty.
Definition projection1 : set -> set -> set := fun X Y => {(p,p 0)|p :e setprod X Y}.
Definition projection2 : set -> set -> set := fun X Y => {(p,p 1)|p :e setprod X Y}.
Axiom product_subbasis_from_projections : forall X Tx Y Ty : set , topology_on X Tx -> topology_on Y Ty -> exists S : set , S = product_subbasis X Tx Y Ty /\ generated_topology (setprod X Y) S = product_topology X Tx Y Ty.
Definition apply_fun : set -> set -> set := fun f x => Eps_i (fun y => (x,y) :e f).
Definition function_on : set -> set -> set -> prop := fun f X Y => forall x : set , x :e X -> apply_fun f x :e Y.
Definition function_space : set -> set -> set := fun X Y => {f :e Power (setprod X Y)|function_on f X Y}.
Axiom function_on_restrict_dom : forall f X X' Y : set , function_on f X Y -> X' c= X -> function_on f X' Y.
Axiom function_on_of_function_space : forall f X Y : set , f :e function_space X Y -> function_on f X Y.
Definition functional_graph : set -> prop := fun f => forall x y1 y2 : set , (x,y1) :e f -> (x,y2) :e f -> y1 = y2.
Definition graph_domain_subset : set -> set -> prop := fun f X => forall x y : set , (x,y) :e f -> x :e X.
Definition graph_range_subset : set -> set -> prop := fun f Y => forall x y : set , (x,y) :e f -> y :e Y.
Axiom graph_domain_subset_of_sub_setprod : forall f X Y : set , f c= setprod X Y -> graph_domain_subset f X.
Axiom graph_range_subset_of_sub_setprod : forall f X Y : set , f c= setprod X Y -> graph_range_subset f Y.
Axiom graph_domain_subset_graph : forall A : set , forall g : set -> set , graph_domain_subset {(a,g a)|a :e A} A.
Axiom graph_domain_subset_const_fun : forall A c : set , graph_domain_subset {(a,c)|a :e A} A.
Axiom graph_range_subset_graph : forall A Y : set , forall g : set -> set , (forall a : set , a :e A -> g a :e Y) -> graph_range_subset {(a,g a)|a :e A} Y.
Axiom graph_range_subset_const_fun : forall A Y c : set , c :e Y -> graph_range_subset {(a,c)|a :e A} Y.
Axiom functional_graph_graph : forall A : set , forall g : set -> set , functional_graph {(a,g a)|a :e A}.
Axiom functional_graph_const_fun : forall A c : set , functional_graph {(a,c)|a :e A}.
Axiom apply_fun_in_graph_of_ex : forall f x : set , (exists y : set , (x,y) :e f) -> (x,apply_fun f x) :e f.
Axiom functional_graph_apply_fun_eq : forall f x y : set , functional_graph f -> (x,y) :e f -> apply_fun f x = y.
Axiom graph_domain_subset_binunion : forall A B f g : set , graph_domain_subset f A -> graph_domain_subset g B -> graph_domain_subset (f :\/: g) (A :\/: B).
Axiom graph_range_subset_binunion : forall f g Y : set , graph_range_subset f Y -> graph_range_subset g Y -> graph_range_subset (f :\/: g) Y.
Axiom function_on_from_totality_and_range : forall X Y f : set , (forall x : set , x :e X -> exists y : set , y :e Y /\ (x,y) :e f) -> graph_range_subset f Y -> function_on f X Y.
Definition graph : set -> (set -> set) -> set := fun A g => {(a,g a)|a :e A}.
Axiom apply_fun_graph : forall A : set , forall g : set -> set , forall a : set , a :e A -> apply_fun (graph A g) a = g a.
Definition total_function_on : set -> set -> set -> prop := fun f X Y => function_on f X Y /\ forall x : set , x :e X -> exists y : set , y :e Y /\ (x,y) :e f.
Axiom total_function_on_function_on : forall f X Y : set , total_function_on f X Y -> function_on f X Y.
Axiom total_function_on_totality : forall f X Y : set , total_function_on f X Y -> forall x : set , x :e X -> exists y : set , y :e Y /\ (x,y) :e f.
Axiom total_functional_graph_eq_graph_of_apply_fun : forall f X Y : set , total_function_on f X Y -> functional_graph f -> f c= setprod X Y -> f = graph X (fun x : set => apply_fun f x).
Definition total_function_space : set -> set -> set := fun X Y => {f :e Power (setprod X Y)|total_function_on f X Y /\ functional_graph f}.
Axiom total_function_space_extensional : forall X Y f g : set , f :e total_function_space X Y -> g :e total_function_space X Y -> (forall x : set , x :e X -> apply_fun f x = apply_fun g x) -> f = g.
Axiom total_function_on_domain_iff_exists_pair : forall f X Y x : set , total_function_on f X Y -> graph_domain_subset f X -> (x :e X <-> exists y : set , (x,y) :e f).
Axiom total_function_on_domain_unique : forall f X X' Y : set , total_function_on f X Y -> graph_domain_subset f X -> total_function_on f X' Y -> graph_domain_subset f X' -> X = X'.
Axiom total_function_on_apply_fun_in_graph : forall f X Y x : set , total_function_on f X Y -> x :e X -> (x,apply_fun f x) :e f.
Axiom total_function_on_apply_fun_in_Y : forall f X Y x : set , total_function_on f X Y -> x :e X -> apply_fun f x :e Y.
Axiom graph_range_subset_from_total_functional : forall A Y f : set , graph_domain_subset f A -> total_function_on f A Y -> functional_graph f -> graph_range_subset f Y.
Definition const_fun : set -> set -> set := fun A x => {(a,x)|a :e A}.
Axiom const_fun_apply : forall A x a : set , a :e A -> apply_fun (const_fun A x) a = x.
Axiom const_fun_total_function_on : forall A Y x : set , x :e Y -> total_function_on (const_fun A x) A Y.
Axiom identity_function_apply : forall X x : set , x :e X -> apply_fun {(y,y)|y :e X} x = x.
Axiom identity_total_function_on : forall X : set , total_function_on {(y,y)|y :e X} X X.
Definition const_family : set -> set -> set := fun I X => {(i,X)|i :e I}.
Axiom const_family_apply : forall I X i : set , i :e I -> apply_fun (const_family I X) i = X.
Definition product_component : set -> set -> set := fun Xi i => (apply_fun Xi i) 0.
Definition product_component_topology : set -> set -> set := fun Xi i => (apply_fun Xi i) 1.
Axiom product_component_def : forall Xi i : set , product_component Xi i = (apply_fun Xi i) 0.
Axiom product_component_topology_def : forall Xi i : set , product_component_topology Xi i = (apply_fun Xi i) 1.
Definition const_space_family : set -> set -> set -> set := fun I X Tx => {(i,(X,Tx))|i :e I}.
Axiom const_space_family_apply : forall I X Tx i : set , i :e I -> apply_fun (const_space_family I X Tx) i = (X,Tx).
Definition space_family_set : set -> set -> set := fun Xi i => (apply_fun Xi i) 0.
Definition space_family_topology : set -> set -> set := fun Xi i => (apply_fun Xi i) 1.
Axiom space_family_set_def : forall Xi i : set , space_family_set Xi i = (apply_fun Xi i) 0.
Axiom space_family_topology_def : forall Xi i : set , space_family_topology Xi i = (apply_fun Xi i) 1.
Axiom space_family_set_eq_product_component : forall Xi i : set , space_family_set Xi i = product_component Xi i.
Axiom space_family_topology_eq_product_component_topology : forall Xi i : set , space_family_topology Xi i = product_component_topology Xi i.
Axiom space_family_set_const_space_family : forall I X Tx i : set , i :e I -> space_family_set (const_space_family I X Tx) i = X.
Axiom space_family_topology_const_space_family : forall I X Tx i : set , i :e I -> space_family_topology (const_space_family I X Tx) i = Tx.
Definition space_family_union : set -> set -> set := fun I Xi => Union {space_family_set Xi i|i :e I}.
Definition topology_family_union : set -> set -> set := fun I Xi => Union {space_family_topology Xi i|i :e I}.
Axiom space_family_union_const_space_family : forall I X Tx : set , I <> Empty -> space_family_union I (const_space_family I X Tx) = X.
Axiom topology_family_union_const_space_family : forall I X Tx : set , I <> Empty -> topology_family_union I (const_space_family I X Tx) = Tx.
Definition product_space : set -> set -> set := fun I Xi => {f :e Power (setprod I (space_family_union I Xi))|total_function_on f I (space_family_union I Xi) /\ functional_graph f /\ forall i : set , i :e I -> apply_fun f i :e space_family_set Xi i}.
Axiom product_space_graphI : forall I Xi : set , forall g : set -> set , (forall i : set , i :e I -> g i :e space_family_set Xi i) -> graph I g :e product_space I Xi.
Definition product_cylinder : set -> set -> set -> set -> set := fun I Xi i U => {f :e product_space I Xi|i :e I /\ U :e space_family_topology Xi i /\ apply_fun f i :e U}.
Definition product_subbasis_full : set -> set -> set := fun I Xi => \/_ i :e I , {product_cylinder I Xi i U|U :e space_family_topology Xi i}.
Definition product_topology_full : set -> set -> set := fun I Xi => generated_topology_from_subbasis (product_space I Xi) (product_subbasis_full I Xi).
Definition box_basis : set -> set -> set := fun I Xi => {B :e Power (product_space I Xi)|exists U : set , total_function_on U I (topology_family_union I Xi) /\ functional_graph U /\ (forall i : set , i :e I -> apply_fun U i :e space_family_topology Xi i) /\ B = {f :e product_space I Xi|forall i : set , i :e I -> apply_fun f i :e apply_fun U i}}.
Definition box_topology : set -> set -> set := fun I Xi => generated_topology (product_space I Xi) (box_basis I Xi).
Definition countable_product_space : set -> set -> set := fun I Xi => product_space I Xi.
Definition countable_product_topology : set -> set -> set := fun I Xi => product_topology_full I Xi.
Definition euclidean_space : set -> set := fun n => product_space n (const_space_family n R R_standard_topology).
Definition euclidean_topology : set -> set := fun n => product_topology_full n (const_space_family n R R_standard_topology).
Axiom SingEmpty_ne_Empty : Sing Empty <> Empty.
Definition R1_singleton_seq : set -> set := fun r => graph (Sing Empty) (fun _ : set => r).
Axiom R1_singleton_seq_in_euclidean_space_1 : forall r : set , r :e R -> R1_singleton_seq r :e euclidean_space (Sing Empty).
Definition R1_singleton_map : set := graph R (fun r : set => R1_singleton_seq r).
Definition R2_standard_topology : set := product_topology R R_standard_topology R R_standard_topology.
Axiom R2_standard_equals_product : R2_standard_topology = product_topology R R_standard_topology R R_standard_topology.
Axiom open_rectangle_set_eq_rectangle_set_intervals : forall a b c d : set , {p :e EuclidPlane|exists x y : set , p = (x,y) /\ Rlt a x /\ Rlt x b /\ Rlt c y /\ Rlt y d} = rectangle_set (open_interval a b) (open_interval c d).
Axiom open_rectangle_in_R2_standard_topology : forall a b c d : set , Rlt a b -> Rlt c d -> {p :e EuclidPlane|exists x y : set , p = (x,y) /\ Rlt a x /\ Rlt x b /\ Rlt c y /\ Rlt y d} :e R2_standard_topology.
Axiom rectangular_regions_subset_R2_standard_topology : forall U : set , U :e rectangular_regions -> U :e R2_standard_topology.
Axiom generated_topology_rectangular_regions_sub_R2_standard_topology : generated_topology EuclidPlane rectangular_regions c= R2_standard_topology.
Axiom generated_topology_rectangular_regions_eq_R2_standard_topology : generated_topology EuclidPlane rectangular_regions = R2_standard_topology.
Axiom generated_topology_circular_regions_eq_R2_standard_topology : generated_topology EuclidPlane circular_regions = R2_standard_topology.
Axiom rectangular_regions_generate_R2_standard_topology : basis_generates EuclidPlane rectangular_regions R2_standard_topology.
Axiom circular_regions_generate_R2_standard_topology : basis_generates EuclidPlane circular_regions R2_standard_topology.
Axiom R2_standard_topology_eq_generated_rectangular_regions : R2_standard_topology = generated_topology EuclidPlane rectangular_regions.
Axiom R2_standard_topology_eq_generated_circular_regions : R2_standard_topology = generated_topology EuclidPlane circular_regions.
Definition subspace_topology : set -> set -> set -> set := fun X Tx Y => {U :e Power Y|exists V :e Tx , U = V :/\: Y}.
Definition closed_interval_topology : set -> set -> set := fun a b => subspace_topology R R_standard_topology (closed_interval a b).
Axiom subspace_topologyE : forall X Tx Y U : set , U :e subspace_topology X Tx Y -> exists V :e Tx , U = V :/\: Y.
Axiom subspace_topologyI : forall X Tx Y V : set , V :e Tx -> (V :/\: Y) :e subspace_topology X Tx Y.
Axiom subspace_topology_subset : forall X Tx Y U : set , U :e subspace_topology X Tx Y -> U c= Y.
Axiom subspace_topology_in_Power : forall X Tx Y U : set , U :e subspace_topology X Tx Y -> U :e Power Y.
Axiom subspace_topology_binintersect_witness : forall X Tx Y U V VU VV : set , U = VU :/\: Y -> V = VV :/\: Y -> U :/\: V = (VU :/\: VV) :/\: Y.
Axiom subspace_topology_binintersect : forall X Tx Y U V : set , topology_on X Tx -> Y c= X -> U :e subspace_topology X Tx Y -> V :e subspace_topology X Tx Y -> U :/\: V :e subspace_topology X Tx Y.
Axiom subspace_topology_mono : forall X Tx1 Tx2 Y U : set , Tx1 c= Tx2 -> U :e subspace_topology X Tx1 Y -> U :e subspace_topology X Tx2 Y.
Axiom subspace_topology_union_closed : forall X Tx Y UFam : set , topology_on X Tx -> Y c= X -> UFam c= subspace_topology X Tx Y -> Union UFam :e subspace_topology X Tx Y.
Axiom subspace_topology_whole : forall X Tx : set , topology_on X Tx -> subspace_topology X Tx X = Tx.
Axiom subspace_topology_is_topology : forall X Tx Y : set , topology_on X Tx -> Y c= X -> topology_on Y (subspace_topology X Tx Y).
Axiom open_in_subspace_iff : forall X Tx Y U : set , topology_on X Tx -> Y c= X -> U c= Y -> (open_in Y (subspace_topology X Tx Y) U <-> exists V :e Tx , U = V :/\: Y).
Axiom subspace_basis : forall X Tx Y B : set , topology_on X Tx -> Y c= X -> basis_on X B /\ generated_topology X B = Tx -> basis_on Y {b :/\: Y|b :e B} /\ generated_topology Y {b :/\: Y|b :e B} = subspace_topology X Tx Y.
Axiom open_in_subspace_if_ambient_open : forall X Tx Y U : set , topology_on X Tx -> Y :e Tx -> U c= Y -> open_in Y (subspace_topology X Tx Y) U -> U :e Tx.
Axiom product_subspace_topology : forall X Tx Y Ty A B : set , topology_on X Tx -> topology_on Y Ty -> A c= X -> B c= Y -> product_topology A (subspace_topology X Tx A) B (subspace_topology Y Ty B) = subspace_topology (setprod X Y) (product_topology X Tx Y Ty) (setprod A B).
Definition unit_interval : set := {x :e R|~ (Rlt x 0) /\ ~ (Rlt 1 x)}.
Axiom unit_interval_sub_R : unit_interval c= R.
Axiom open_interval_Subq_unit_interval : forall a b : set , a :e R -> b :e R -> Rlt 0 a -> Rlt b 1 -> open_interval a b c= unit_interval.
Axiom eps_1_in_R : eps_ 1 :e R.
Axiom eps_1_pos_R : Rlt 0 (eps_ 1).
Axiom order_rel_setprod_R_R_x0_xeps1 : forall x : set , x :e R -> order_rel (setprod R R) (x,0) (x,eps_ 1).
Axiom eps_1_lt1_R : Rlt (eps_ 1) 1.
Axiom zero_in_unit_interval : 0 :e unit_interval.
Axiom one_in_unit_interval : 1 :e unit_interval.
Axiom eps_1_in_unit_interval : eps_ 1 :e unit_interval.
Axiom unit_interval_Rle0 : forall t : set , t :e unit_interval -> Rle 0 t.
Axiom unit_interval_Rle1 : forall t : set , t :e unit_interval -> Rle t 1.
Axiom unit_interval_mul_closed : forall a b : set , a :e unit_interval -> b :e unit_interval -> mul_SNo a b :e unit_interval.
Axiom two_not_in_unit_interval : 2 /:e unit_interval.
Axiom two_in_R : 2 :e R.
Axiom unit_interval_neq_R : unit_interval <> R.
Definition unit_interval_topology : set := subspace_topology R R_standard_topology unit_interval.
Axiom unit_interval_topology_on : topology_on unit_interval unit_interval_topology.
Definition flip_unit_interval : set := {(t,add_SNo 1 (minus_SNo t))|t :e unit_interval}.
Axiom flip_unit_interval_apply : forall t : set , t :e unit_interval -> apply_fun flip_unit_interval t = add_SNo 1 (minus_SNo t).
Axiom flip_unit_interval_in_R : forall t : set , t :e unit_interval -> apply_fun flip_unit_interval t :e R.
Axiom flip_unit_interval_at_0 : apply_fun flip_unit_interval 0 = 1.
Axiom flip_unit_interval_at_1 : apply_fun flip_unit_interval 1 = 0.
Axiom flip_unit_interval_function_on : function_on flip_unit_interval unit_interval unit_interval.
Axiom unit_interval_open_neighborhood_has_other_point : forall U0 : set , U0 :e unit_interval_topology -> eps_ 1 :e U0 -> exists x : set , x :e U0 /\ x <> eps_ 1.
Definition ordered_square : set := setprod unit_interval unit_interval.
Definition ordered_square_order_basis : set := ({I :e Power ordered_square|exists a :e ordered_square , exists b :e ordered_square , I = {x :e ordered_square|order_rel (setprod R R) a x /\ order_rel (setprod R R) x b}} :\/: {I :e Power ordered_square|exists b :e ordered_square , I = {x :e ordered_square|order_rel (setprod R R) x b}} :\/: {I :e Power ordered_square|exists a :e ordered_square , I = {x :e ordered_square|order_rel (setprod R R) a x}}).
Definition ordered_square_topology : set := generated_topology ordered_square ordered_square_order_basis.
Definition ordered_square_open_strip : set := {p :e ordered_square|exists y : set , p = (eps_ 1,y) /\ Rlt (eps_ 1) y /\ ~ (Rlt 1 y)}.
Definition ordered_square_A : set := setprod unit_interval (open_interval 0 1).
Definition ordered_square_A_topology : set := subspace_topology ordered_square ordered_square_topology ordered_square_A.
Axiom open_interval_0_1_Subq_unit_interval : open_interval 0 1 c= unit_interval.
Axiom ordered_square_A_Subq_ordered_square : ordered_square_A c= ordered_square.
Definition ordered_square_subspace_topology : set := subspace_topology (setprod R R) R2_dictionary_order_topology ordered_square.
Axiom ordered_square_neq_setprod_R_R : ordered_square <> setprod R R.
Axiom ordered_square_standard_subspace_equals_product : subspace_topology (setprod R R) R2_standard_topology ordered_square = product_topology unit_interval unit_interval_topology unit_interval unit_interval_topology.
Axiom ordered_square_not_subspace_dictionary : ordered_square_topology <> subspace_topology (setprod R R) R2_dictionary_order_topology ordered_square.
Definition order_interval : set -> set -> set -> set := fun X a b => {x :e X|order_rel X a x /\ order_rel X x b}.
Axiom order_interval_R_eq_open_interval : forall a b : set , order_interval R a b = open_interval a b.
Axiom order_interval_subset : forall X a b : set , order_interval X a b c= X.
Axiom order_intervalE : forall X a b x : set , x :e order_interval X a b -> x :e X /\ (order_rel X a x /\ order_rel X x b).
Axiom order_intervalI : forall X a b x : set , x :e X -> order_rel X a x -> order_rel X x b -> x :e order_interval X a b.
Definition convex_in : set -> set -> prop := fun X Y => Y c= X /\ forall a b : set , a :e Y -> b :e Y -> order_interval X a b c= Y.
Axiom convex_in_subset : forall X Y : set , convex_in X Y -> Y c= X.
Axiom convex_in_interval_property : forall X Y : set , convex_in X Y -> forall a b : set , a :e Y -> b :e Y -> order_interval X a b c= Y.
Definition order_topology_basis_inherited : set -> set -> set := fun X Y => (({I :e Power Y|exists a :e Y , exists b :e Y , I = {x :e Y|order_rel X a x /\ order_rel X x b}} :\/: {I :e Power Y|exists b :e Y , I = {x :e Y|order_rel X x b}} :\/: {I :e Power Y|exists a :e Y , I = {x :e Y|order_rel X a x}}) :\/: {Y}).
Definition order_topology_inherited : set -> set -> set := fun X Y => generated_topology Y (order_topology_basis_inherited X Y).
Axiom convex_subspace_order_topology : forall X Y : set , simply_ordered_set X -> convex_in X Y -> order_topology_inherited X Y = subspace_topology X (order_topology X) Y.
Axiom binintersect_right_absorb_subset : forall W Y A : set , A c= Y -> (W :/\: Y) :/\: A = W :/\: A.
Axiom ex16_1_subspace_transitive : forall X Tx Y A : set , topology_on X Tx -> Y c= X -> A c= Y -> subspace_topology Y (subspace_topology X Tx Y) A = subspace_topology X Tx A.
Axiom ex16_2_finer_subspaces : forall X T T' Y : set , topology_on X T -> topology_on X T' -> T' c= T -> Y c= X -> subspace_topology X T' Y c= subspace_topology X T Y.
Axiom subspace_topology_eq_of_eq : forall X T T' Y : set , T = T' -> subspace_topology X T Y = subspace_topology X T' Y.
Definition one_half : set := inv_nat 2.
Definition interval_A : set := {x :e R|one_half < abs_SNo x /\ abs_SNo x < 1}.
Definition interval_B : set := {x :e R|one_half < abs_SNo x /\ ~ (1 < abs_SNo x)}.
Definition interval_C : set := {x :e R|~ (abs_SNo x < one_half) /\ abs_SNo x < 1}.
Definition interval_D : set := {x :e R|~ (abs_SNo x < one_half) /\ ~ (1 < abs_SNo x)}.
Definition interval_E : set := {x :e R|0 < abs_SNo x /\ abs_SNo x < 1 /\ ~ (div_SNo 1 x :e Zplus)}.
Axiom ex16_3_open_sets_subspace : forall X Tx Y : set , topology_on X Tx -> Y c= X -> forall U : set , open_in Y (subspace_topology X Tx Y) U -> exists V : set , open_in X Tx V /\ U = V :/\: Y.
Definition projection_image1 : set -> set -> set -> set := fun X Y U => {x :e X|exists y : set , (x,y) :e U}.
Definition projection_image2 : set -> set -> set -> set := fun X Y U => {y :e Y|exists x : set , (x,y) :e U}.
Axiom nonempty_has_element : forall V : set , V <> Empty -> exists y : set , y :e V.
Axiom elem_implies_nonempty : forall V y : set , y :e V -> V <> Empty.
Axiom projection_image1_rectangle_nonempty : forall X Y U V : set , U c= X -> V c= Y -> V <> Empty -> projection_image1 X Y (setprod U V) = U.
Axiom projection_image1_rectangle_empty : forall X Y U : set , projection_image1 X Y (setprod U Empty) = Empty.
Axiom projection_image2_rectangle_nonempty : forall X Y U V : set , U c= X -> V c= Y -> U <> Empty -> projection_image2 X Y (setprod U V) = V.
Axiom projection_image2_rectangle_empty : forall X Y V : set , projection_image2 X Y (setprod Empty V) = Empty.
Axiom ex16_4_projections_open : forall X Tx Y Ty : set , topology_on X Tx -> topology_on Y Ty -> forall U : set , U :e product_topology X Tx Y Ty -> open_in X Tx (projection_image1 X Y U) /\ open_in Y Ty (projection_image2 X Y U).
Axiom ex16_5a_product_monotone : forall X T T' Y U U' : set , X <> Empty -> Y <> Empty -> topology_on X T -> topology_on X T' -> topology_on Y U -> topology_on Y U' -> T c= T' /\ U c= U' -> product_topology X T Y U c= product_topology X T' Y U'.
Axiom ex16_5b_product_converse : forall X T T' Y U U' : set , X <> Empty -> Y <> Empty -> topology_on X T -> topology_on X T' -> topology_on Y U -> topology_on Y U' -> product_topology X T Y U c= product_topology X T' Y U' -> T c= T' /\ U c= U'.
Definition rational_rectangle_basis : set := {r :e Power (setprod R R)|exists a b c d : set , a :e rational_numbers /\ b :e rational_numbers /\ c :e rational_numbers /\ d :e rational_numbers /\ r = setprod (open_interval a b) (open_interval c d)}.
Axiom open_interval_in_R_standard_topology_endpoints : forall a b : set , a :e R -> b :e R -> open_interval a b :e R_standard_topology.
Axiom open_interval_in_rational_open_intervals_basis : forall q1 q2 : set , q1 :e rational_numbers -> q2 :e rational_numbers -> open_interval q1 q2 :e rational_open_intervals_basis.
Axiom rational_open_intervals_basisE : forall b : set , b :e rational_open_intervals_basis -> exists q1 , exists q2 , (q1 :e rational_numbers /\ q2 :e rational_numbers /\ b = open_interval q1 q2).
Axiom rational_rectangle_basis_eq_product_basis_from : rational_rectangle_basis = product_basis_from rational_open_intervals_basis rational_open_intervals_basis.
Axiom ex16_6_rational_rectangles_basis : basis_on (setprod R R) rational_rectangle_basis /\ generated_topology (setprod R R) rational_rectangle_basis = R2_standard_topology.
Definition closed_interval_in : set -> set -> set -> set := fun X a b => {x :e X|(x = a \/ order_rel X a x) /\ (x = b \/ order_rel X x b)}.
Definition halfopen_interval_left_in : set -> set -> set -> set := fun X a b => {x :e X|(x = a \/ order_rel X a x) /\ order_rel X x b}.
Definition halfopen_interval_right_in : set -> set -> set -> set := fun X a b => {x :e X|order_rel X a x /\ (x = b \/ order_rel X x b)}.
Definition closed_ray_upper : set -> set -> set := fun X a => {x :e X|x = a \/ order_rel X a x}.
Definition closed_ray_lower : set -> set -> set := fun X a => {x :e X|x = a \/ order_rel X x a}.
Axiom closed_interval_in_eq_ray_intersection : forall X a b : set , closed_interval_in X a b = (closed_ray_upper X a) :/\: (closed_ray_lower X b).
Definition interval_in : set -> set -> set -> set -> prop := fun X a b Y => Y = order_interval X a b \/ Y = halfopen_interval_left_in X a b \/ Y = halfopen_interval_right_in X a b \/ Y = closed_interval_in X a b.
Definition ray_in : set -> set -> set -> prop := fun X a Y => Y = open_ray_upper X a \/ Y = closed_ray_upper X a \/ Y = open_ray_lower X a \/ Y = closed_ray_lower X a.
Definition interval_or_ray_in : set -> set -> prop := fun X Y => (exists a b : set , a :e X /\ b :e X /\ interval_in X a b Y) \/ (exists a : set , a :e X /\ ray_in X a Y).
Definition Q_sqrt2_cut : set := {q :e rational_numbers|mul_SNo q q < 2}.
Axiom two_in_rational_numbers : 2 :e rational_numbers.
Axiom two_not_in_Q_sqrt2_cut : 2 /:e Q_sqrt2_cut.
Axiom minus_two_not_in_Q_sqrt2_cut : minus_SNo 2 /:e Q_sqrt2_cut.
Axiom Q_sqrt2_cut_neq_Q : Q_sqrt2_cut <> rational_numbers.
Axiom Q_sqrt2_cut_sub_Q : Q_sqrt2_cut c= rational_numbers.
Axiom zero_in_Q_sqrt2_cut : 0 :e Q_sqrt2_cut.
Axiom Q_sqrt2_cut_between_square : forall a b x : set , a :e Q_sqrt2_cut -> b :e Q_sqrt2_cut -> x :e rational_numbers -> Rlt a x -> Rlt x b -> mul_SNo x x < 2.
Axiom Q_sqrt2_cut_convex : convex_in rational_numbers Q_sqrt2_cut.
Axiom Q_sqrt2_cut_no_max : forall q : set , q :e Q_sqrt2_cut -> exists r : set , r :e Q_sqrt2_cut /\ Rlt q r.
Axiom Q_sqrt2_cut_neg_closed : forall q : set , q :e Q_sqrt2_cut -> minus_SNo q :e Q_sqrt2_cut.
Axiom Q_sqrt2_cut_no_min : forall q : set , q :e Q_sqrt2_cut -> exists r : set , r :e Q_sqrt2_cut /\ Rlt r q.
Axiom Q_sqrt2_cut_not_interval_or_ray : ~ interval_or_ray_in rational_numbers Q_sqrt2_cut.
Axiom ex16_7_convex_interval_or_ray : exists X Y : set , convex_in X Y /\ Y <> X /\ ~ interval_or_ray_in X Y.
Axiom singleton_rectangle_in_dictionary : forall a V : set , a :e R -> V :e R_standard_topology -> rectangle_set {a} V :e R2_dictionary_order_topology.
Axiom rectangle_in_dictionary : forall U V : set , U :e discrete_topology R -> V :e R_standard_topology -> rectangle_set U V :e R2_dictionary_order_topology.
Axiom singleton_not_open_R_standard_topology : forall a : set , a :e R -> {a} /:e R_standard_topology.
Axiom ex16_9_dictionary_equals_product : R2_dictionary_order_topology = product_topology R (discrete_topology R) R R_standard_topology /\ R2_dictionary_order_topology <> R2_standard_topology.
Axiom ex16_10_compare_topologies_on_square : ordered_square_topology <> subspace_topology (setprod R R) R2_dictionary_order_topology ordered_square /\ subspace_topology (setprod R R) R2_dictionary_order_topology ordered_square <> product_topology unit_interval unit_interval_topology unit_interval unit_interval_topology.
Definition interior_of : set -> set -> set -> set := fun X T A => {x :e X|exists U : set , U :e T /\ x :e U /\ U c= A}.
Definition closure_of : set -> set -> set -> set := fun X T A => {x :e X|forall U : set , U :e T -> x :e U -> U :/\: A <> Empty}.
Axiom interior_of_contains_open_subset_point : forall X Tx A U x : set , topology_on X Tx -> U :e Tx -> x :e U -> U c= A -> x :e interior_of X Tx A.
Axiom point_in_open_empty_interior_not_subset : forall X Tx A U x : set , topology_on X Tx -> interior_of X Tx A = Empty -> U :e Tx -> x :e U -> ~ (U c= A).
Axiom closure_infinite_finite_complement : forall X A : set , A c= X -> infinite A -> closure_of X (finite_complement_topology X) A = X.
Axiom subset_of_closure : forall X Tx A : set , topology_on X Tx -> A c= X -> A c= closure_of X Tx A.
Axiom closure_monotone : forall X Tx A B : set , topology_on X Tx -> A c= B -> B c= X -> closure_of X Tx A c= closure_of X Tx B.
Axiom closure_finer_than_Subq : forall X T1 T2 A : set , finer_than T1 T2 -> closure_of X T1 A c= closure_of X T2 A.
Axiom interior_subset : forall X Tx A : set , topology_on X Tx -> interior_of X Tx A c= A.
Axiom interior_monotone : forall X Tx A B : set , topology_on X Tx -> A c= B -> interior_of X Tx A c= interior_of X Tx B.
Axiom open_interior_eq : forall X Tx U : set , topology_on X Tx -> U :e Tx -> interior_of X Tx U = U.
Axiom open_subset_interior : forall X Tx U A : set , topology_on X Tx -> U :e Tx -> U c= A -> U c= interior_of X Tx A.
Axiom open_subset_empty_interior_implies_empty : forall X Tx U A : set , topology_on X Tx -> U :e Tx -> U c= A -> interior_of X Tx A = Empty -> U = Empty.
Axiom interior_of_empty : forall X Tx : set , topology_on X Tx -> interior_of X Tx Empty = Empty.
Axiom interior_of_space : forall X Tx : set , topology_on X Tx -> interior_of X Tx X = X.
Axiom interior_is_open : forall X Tx A : set , topology_on X Tx -> A c= X -> interior_of X Tx A :e Tx.
Axiom interior_union_contains_union_interiors : forall X Tx A B : set , topology_on X Tx -> A c= X -> B c= X -> interior_of X Tx A :\/: interior_of X Tx B c= interior_of X Tx (A :\/: B).
Axiom interior_intersection_contains_intersection : forall X Tx A B : set , topology_on X Tx -> A c= X -> B c= X -> interior_of X Tx (A :/\: B) c= interior_of X Tx A :/\: interior_of X Tx B.
Axiom interior_intersection_of_opens : forall X Tx U V : set , topology_on X Tx -> U :e Tx -> V :e Tx -> interior_of X Tx (U :/\: V) = U :/\: V.
Axiom interior_idempotent : forall X Tx A : set , topology_on X Tx -> A c= X -> interior_of X Tx (interior_of X Tx A) = interior_of X Tx A.
Axiom not_in_closure_has_disjoint_open : forall X Tx A x : set , topology_on X Tx -> A c= X -> x :e X -> x /:e closure_of X Tx A -> exists U : set , U :e Tx /\ x :e U /\ U :/\: A = Empty.
Axiom closure_is_closed : forall X Tx A : set , topology_on X Tx -> A c= X -> closed_in X Tx (closure_of X Tx A).
Axiom interior_closure_complement_duality : forall X Tx A : set , topology_on X Tx -> A c= X -> interior_of X Tx A = X :\: closure_of X Tx (X :\: A).
Axiom closure_contains_set : forall X Tx A : set , topology_on X Tx -> A c= X -> A c= closure_of X Tx A.
Axiom closure_in_space : forall X Tx A : set , topology_on X Tx -> closure_of X Tx A c= X.
Axiom closure_subset_of_closed_superset : forall X Tx A C : set , topology_on X Tx -> A c= C -> closed_in X Tx C -> closure_of X Tx A c= C.
Axiom closure_union_contains_union_closures : forall X Tx A B : set , topology_on X Tx -> A c= X -> B c= X -> closure_of X Tx A :\/: closure_of X Tx B c= closure_of X Tx (A :\/: B).
Axiom closure_of_empty : forall X Tx : set , topology_on X Tx -> closure_of X Tx Empty = Empty.
Axiom closure_of_space : forall X Tx : set , topology_on X Tx -> closure_of X Tx X = X.
Axiom union_of_closed_is_closed : forall X Tx C D : set , topology_on X Tx -> closed_in X Tx C -> closed_in X Tx D -> closed_in X Tx (C :\/: D).
Axiom empty_is_closed : forall X Tx : set , topology_on X Tx -> closed_in X Tx Empty.
Axiom space_is_closed : forall X Tx : set , topology_on X Tx -> closed_in X Tx X.
Axiom binunion_eq_Union_UPair : forall U V : set , U :\/: V = Union (UPair U V).
Axiom Union_UPair_eq_binunion : forall U V : set , Union (UPair U V) = U :\/: V.
Axiom lemma_union_two_open : forall X T U V : set , topology_on X T -> U :e T -> V :e T -> U :\/: V :e T.
Axiom intersection_of_closed_is_closed : forall X Tx C D : set , topology_on X Tx -> closed_in X Tx C -> closed_in X Tx D -> closed_in X Tx (C :/\: D).
Axiom closed_closure_eq : forall X Tx C : set , topology_on X Tx -> closed_in X Tx C -> closure_of X Tx C = C.
Axiom closure_intersection_of_closed : forall X Tx C D : set , topology_on X Tx -> closed_in X Tx C -> closed_in X Tx D -> closure_of X Tx (C :/\: D) = C :/\: D.
Axiom closure_union_of_closed : forall X Tx C D : set , topology_on X Tx -> closed_in X Tx C -> closed_in X Tx D -> closure_of X Tx (C :\/: D) = C :\/: D.
Axiom closure_idempotent : forall X Tx A : set , topology_on X Tx -> A c= X -> closure_of X Tx (closure_of X Tx A) = closure_of X Tx A.
Axiom closure_intersection_contained : forall X Tx A B : set , topology_on X Tx -> A c= X -> B c= X -> closure_of X Tx (A :/\: B) c= closure_of X Tx A :/\: closure_of X Tx B.
Axiom closed_sets_axioms : forall X T : set , topology_on X T -> let C := {X :\: U|U :e T} in X :e C /\ Empty :e C /\ (forall F : set , F :e Power C -> intersection_of_family X F :e C) /\ (forall A B : set , A :e C -> B :e C -> A :\/: B :e C).
Axiom closed_in_subspace_iff_intersection : forall X Tx Y A : set , topology_on X Tx -> Y c= X -> (closed_in Y (subspace_topology X Tx Y) A <-> exists C : set , closed_in X Tx C /\ A = C :/\: Y).
Axiom closed_in_closed_subspace : forall X Tx Y A : set , topology_on X Tx -> closed_in X Tx Y -> closed_in Y (subspace_topology X Tx Y) A -> closed_in X Tx A.
Axiom closure_in_subspace : forall X Tx Y A : set , topology_on X Tx -> Y c= X -> A c= Y -> closure_of Y (subspace_topology X Tx Y) A = (closure_of X Tx A) :/\: Y.
Axiom closure_characterization : forall X Tx A x : set , topology_on X Tx -> x :e X -> (x :e closure_of X Tx A <-> (forall U :e Tx , x :e U -> U :/\: A <> Empty)).
Definition limit_point_of : set -> set -> set -> set -> prop := fun X Tx A x => topology_on X Tx /\ x :e X /\ forall U : set , U :e Tx -> x :e U -> exists y : set , y :e A /\ y <> x /\ y :e U.
Definition limit_points_of : set -> set -> set -> set := fun X Tx A => {x :e X|limit_point_of X Tx A x}.
Axiom closure_equals_set_plus_limit_points : forall X Tx A : set , topology_on X Tx -> A c= X -> closure_of X Tx A = A :\/: limit_points_of X Tx A.
Axiom closed_iff_contains_limit_points : forall X Tx A : set , topology_on X Tx -> A c= X -> (closed_in X Tx A <-> limit_points_of X Tx A c= A).
Definition Hausdorff_space : set -> set -> prop := fun X Tx => topology_on X Tx /\ forall x1 x2 : set , x1 :e X -> x2 :e X -> x1 <> x2 -> exists U V : set , U :e Tx /\ V :e Tx /\ x1 :e U /\ x2 :e V /\ U :/\: V = Empty.
Axiom Hausdorff_space_topology : forall X Tx : set , Hausdorff_space X Tx -> topology_on X Tx.
Axiom Hausdorff_space_separation : forall X Tx x1 x2 : set , Hausdorff_space X Tx -> x1 :e X -> x2 :e X -> x1 <> x2 -> exists U V : set , U :e Tx /\ V :e Tx /\ x1 :e U /\ x2 :e V /\ U :/\: V = Empty.
Definition T1_space : set -> set -> prop := fun X Tx => topology_on X Tx /\ (forall F : set , F c= X -> finite F -> closed_in X Tx F).
Axiom T1_space_topology : forall X Tx : set , T1_space X Tx -> topology_on X Tx.
Axiom T1_space_finite_closed : forall X Tx F : set , T1_space X Tx -> F c= X -> finite F -> closed_in X Tx F.
Axiom Hausdorff_singleton_complement_open : forall X Tx x : set , Hausdorff_space X Tx -> x :e X -> X :\: {x} :e Tx.
Axiom Hausdorff_singletons_closed : forall X Tx x : set , Hausdorff_space X Tx -> x :e X -> closed_in X Tx {x}.
Axiom finite_sets_closed_in_Hausdorff : forall X Tx : set , Hausdorff_space X Tx -> forall F : set , F c= X -> finite F -> closed_in X Tx F.
Axiom limit_points_infinite_neighborhoods : forall X Tx A x : set , T1_space X Tx -> x :e X -> (limit_point_of X Tx A x <-> (forall U :e Tx , x :e U -> infinite (U :/\: A))).
Axiom Hausdorff_unique_limits : forall X Tx seq x y : set , Hausdorff_space X Tx -> x :e X -> y :e X -> x <> y -> function_on seq omega X -> (forall U : set , U :e Tx -> x :e U -> exists N : set , N :e omega /\ forall n : set , n :e omega -> N c= n -> apply_fun seq n :e U) -> (forall U : set , U :e Tx -> y :e U -> exists N : set , N :e omega /\ forall n : set , n :e omega -> N c= n -> apply_fun seq n :e U) -> False.
Axiom Hausdorff_stability : forall X Tx Y Ty : set , Hausdorff_space X Tx /\ Hausdorff_space Y Ty -> Hausdorff_space (setprod X Y) (product_topology X Tx Y Ty).
Axiom ex17_1_topology_from_closed_sets : forall X Tx : set , closed_in X Tx X -> (forall A : set , closed_in X Tx A -> closed_in X Tx (X :\: A)) -> topology_on X Tx.
Axiom ex17_2_closed_in_closed_subspace : forall X Tx Y A : set , closed_in X Tx Y -> closed_in Y (subspace_topology X Tx Y) A -> closed_in X Tx A.
Axiom ex17_3_product_of_closed_sets_closed : forall X Tx Y Ty A B : set , closed_in X Tx A -> closed_in Y Ty B -> closed_in (setprod X Y) (product_topology X Tx Y Ty) (setprod A B).
Axiom ex17_4_open_minus_closed_and_closed_minus_open : forall X Tx U A : set , topology_on X Tx -> open_in X Tx U -> closed_in X Tx A -> open_in X Tx (U :\: A) /\ closed_in X Tx (A :\: U).
Axiom ex17_5_closure_of_interval_in_order_topology : forall X a b : set , simply_ordered_set X -> a :e X -> b :e X -> closure_of X (order_topology X) (order_interval X a b) c= closed_interval_in X a b.
Definition no_immediate_successor : set -> set -> prop := fun X a => forall c : set , c :e X -> order_rel X a c -> exists x : set , x :e X /\ order_rel X a x /\ order_rel X x c.
Definition no_immediate_predecessor : set -> set -> prop := fun X b => forall c : set , c :e X -> order_rel X c b -> exists x : set , x :e X /\ order_rel X c x /\ order_rel X x b.
Axiom ex17_5_basis_elem_meets_interval : forall X a b x b0 : set , simply_ordered_set X -> a :e X -> b :e X -> order_rel X a b -> no_immediate_successor X a -> no_immediate_predecessor X b -> x :e closed_interval_in X a b -> b0 :e order_topology_basis X -> x :e b0 -> exists y : set , y :e b0 /\ y :e order_interval X a b.
Axiom ex17_5_closure_of_interval_eq_conditions : forall X a b : set , simply_ordered_set X -> a :e X -> b :e X -> order_rel X a b -> no_immediate_successor X a -> no_immediate_predecessor X b -> closure_of X (order_topology X) (order_interval X a b) = closed_interval_in X a b.
Axiom closure_idempotent_and_closed : forall X Tx A : set , topology_on X Tx -> closure_of X Tx (closure_of X Tx A) = closure_of X Tx A /\ closed_in X Tx (closure_of X Tx A).
Axiom ex17_6a_closure_monotone : forall X Tx A B : set , topology_on X Tx -> A c= B -> B c= X -> closure_of X Tx A c= closure_of X Tx B.
Axiom ex17_6b_closure_binunion : forall X Tx A B : set , topology_on X Tx -> A c= X -> B c= X -> closure_of X Tx (A :\/: B) = closure_of X Tx A :\/: closure_of X Tx B.
Axiom ex17_6c_closure_Union_contains_Union_closures : forall X Tx Fam : set , topology_on X Tx -> (forall A : set , A :e Fam -> A c= X) -> Union {closure_of X Tx A|A :e Fam} c= closure_of X Tx (Union Fam).
Axiom ex17_7_counterexample_union_closure : exists X Tx Fam : set , topology_on X Tx /\ (forall A : set , A :e Fam -> A c= X) /\ ~ (closure_of X Tx (Union Fam) c= Union {closure_of X Tx A|A :e Fam}).
Axiom ex17_8a_closure_intersection_Subq_intersection_closures : forall X Tx A B : set , topology_on X Tx -> closure_of X Tx (A :/\: B) c= closure_of X Tx A :/\: closure_of X Tx B.
Axiom ex17_8b_closure_intersection_family_Subq_intersection_closures : forall X Tx Fam : set , topology_on X Tx -> (forall A : set , A :e Fam -> A c= X) -> closure_of X Tx (intersection_of_family X Fam) c= intersection_of_family X {closure_of X Tx A|A :e Fam}.
Axiom ex17_8c_closure_setminus_Subq_closure_left : forall X Tx A B : set , topology_on X Tx -> A c= X -> B c= X -> closure_of X Tx (A :\: B) c= closure_of X Tx A.
Axiom ex17_8c_counterexample_equality_fails : exists X Tx A B : set , topology_on X Tx /\ A c= X /\ B c= X /\ closure_of X Tx (A :\: B) <> (closure_of X Tx A :\: closure_of X Tx B).
Axiom ex17_9_closure_of_product_subset : forall X Y Tx Ty A B : set , topology_on X Tx -> topology_on Y Ty -> closure_of (setprod X Y) (product_topology X Tx Y Ty) (setprod A B) = setprod (closure_of X Tx A) (closure_of Y Ty B).
Axiom ex17_10_order_topology_Hausdorff : forall X : set , simply_ordered_set X -> Hausdorff_space X (order_topology X).
Axiom ex17_11_product_Hausdorff : forall X Tx Y Ty : set , Hausdorff_space X Tx -> Hausdorff_space Y Ty -> Hausdorff_space (setprod X Y) (product_topology X Tx Y Ty).
Axiom ex17_12_subspace_Hausdorff : forall X Tx Y : set , Hausdorff_space X Tx -> Y c= X -> Hausdorff_space Y (subspace_topology X Tx Y).
Axiom ex17_13_diagonal_closed_iff_Hausdorff : forall X Tx : set , topology_on X Tx -> (Hausdorff_space X Tx <-> closed_in (setprod X X) (product_topology X Tx X Tx) {(x,x)|x :e X}).
Definition seq_one_over_n : set := (fun n :e omega => {inv_nat (ordsucc n)}).
Axiom seq_one_over_n_apply : forall n : set , n :e omega -> apply_fun seq_one_over_n n = inv_nat (ordsucc n).
Axiom inv_nat_ordsucc_inj : forall n m : set , n :e omega -> m :e omega -> inv_nat (ordsucc n) = inv_nat (ordsucc m) -> n = m.
Axiom omega_binunion : forall a b : set , a :e omega -> b :e omega -> a :\/: b :e omega.
Axiom seq_one_over_n_inj : forall n m : set , n :e omega -> m :e omega -> apply_fun seq_one_over_n n = apply_fun seq_one_over_n m -> n = m.
Axiom K_set_infinite : infinite K_set.
Axiom ex17_14_sequence_in_finite_complement_topology : forall x : set , x :e R -> forall U : set , U :e finite_complement_topology R -> x :e U -> exists N : set , N :e omega /\ forall n : set , n :e omega -> N c= n -> apply_fun seq_one_over_n n :e U.
Axiom lemma_T1_singletons_closed : forall X Tx : set , topology_on X Tx -> (T1_space X Tx <-> (forall x : set , x :e X -> closed_in X Tx {x})).
Axiom T1_singleton_complement_open : forall X Tx x : set , T1_space X Tx -> x :e X -> X :\: {x} :e Tx.
Axiom subspace_T1 : forall X Tx Y : set , topology_on X Tx -> Y c= X -> T1_space X Tx -> T1_space Y (subspace_topology X Tx Y).
Axiom ex17_15_T1_characterization : forall X Tx : set , topology_on X Tx -> (T1_space X Tx <-> forall x y : set , x :e X -> y :e X -> x <> y -> (exists U : set , U :e Tx /\ x :e U /\ y /:e U) /\ (exists V : set , V :e Tx /\ y :e V /\ x /:e V)).
Definition R_nonneg_set : set := {x :e R|0 <= x}.
Axiom closure_of_K_in_R_K_topology : closure_of R R_K_topology K_set = K_set.
Axiom closure_of_K_in_R_ray_topology : closure_of R R_ray_topology K_set = R_nonneg_set.
Axiom K_set_above_positive_bound_finite : forall b : set , b :e R -> Rlt 0 b -> finite (K_set :/\: {y :e R|Rlt b y}).
Axiom standard_open_neighborhood_disjoint_from_K_set_pos : forall x : set , x :e R -> 0 < x -> ~ (x :e K_set) -> exists U : set , U :e R_standard_topology /\ x :e U /\ U :/\: K_set = Empty.
Axiom closure_of_K_in_R_upper_limit_topology : closure_of R R_upper_limit_topology K_set = K_set.
Axiom closure_of_K_in_R_standard_topology : closure_of R R_standard_topology K_set = K_set :\/: {0}.
Axiom ex17_16a_closure_of_K_in_five_topologies : closure_of R R_standard_topology K_set = K_set :\/: {0} /\ closure_of R R_K_topology K_set = K_set /\ closure_of R R_finite_complement_topology K_set = R /\ closure_of R R_upper_limit_topology K_set = K_set /\ closure_of R R_ray_topology K_set = R_nonneg_set.
Axiom ray_topology_contains_0_if_contains_1 : forall U : set , U :e R_ray_topology -> 1 :e U -> 0 :e U.
Axiom ray_topology_not_Hausdorff : ~ Hausdorff_space R R_ray_topology.
Axiom ray_topology_not_T1 : ~ T1_space R R_ray_topology.
Axiom setminus_Empty_eq : forall X : set , X :\: Empty = X.
Axiom infinite_R : infinite R.
Axiom finite_complement_topology_T1 : forall X : set , T1_space X (finite_complement_topology X).
Axiom R_finite_complement_not_Hausdorff : ~ Hausdorff_space R R_finite_complement_topology.
Axiom R_standard_topology_Hausdorff : Hausdorff_space R R_standard_topology.
Axiom R_standard_topology_T1 : T1_space R R_standard_topology.
Axiom finer_preserves_Hausdorff : forall X Tx Ty : set , Hausdorff_space X Tx -> topology_on X Ty -> Tx c= Ty -> Hausdorff_space X Ty.
Axiom R_upper_limit_topology_Hausdorff : Hausdorff_space R R_upper_limit_topology.
Axiom R_upper_limit_topology_T1 : T1_space R R_upper_limit_topology.
Axiom R_K_topology_Hausdorff : Hausdorff_space R R_K_topology.
Axiom R_K_topology_T1 : T1_space R R_K_topology.
Axiom ex17_16b_Hausdorff_and_T1_for_five_topologies : (Hausdorff_space R R_standard_topology /\ T1_space R R_standard_topology) /\ (Hausdorff_space R R_upper_limit_topology /\ T1_space R R_upper_limit_topology) /\ (Hausdorff_space R R_K_topology /\ T1_space R R_K_topology) /\ (~ Hausdorff_space R R_finite_complement_topology /\ T1_space R R_finite_complement_topology) /\ (~ Hausdorff_space R R_ray_topology /\ ~ T1_space R R_ray_topology).
Axiom real_2 : 2 :e R.
Axiom ordsucc_2_eq_3 : ordsucc 2 = 3.
Axiom add_SNo_2_1_eq_3 : add_SNo 2 1 = 3.
Axiom real_3 : 3 :e R.
Definition sqrt2 : set := sqrt_SNo_nonneg 2.
Axiom sqrt2_in_R : sqrt2 :e R.
Axiom SNoLt_0_sqrt2 : 0 < sqrt2.
Axiom three_in_rational_numbers : 3 :e rational_numbers.
Axiom sqrt2_not_rational_numbers : sqrt2 /:e rational_numbers.
Definition R_C_topology : set := generated_topology R rational_halfopen_intervals_basis.
Axiom R_lower_limit_finer_than_R_C : finer_than R_lower_limit_topology R_C_topology.
Definition ex17_17_interval_A : set := open_interval 0 sqrt2.
Definition ex17_17_interval_B : set := open_interval sqrt2 3.
Definition ex17_17_interval_A_closure_lower : set := {x :e R|0 <= x /\ x < sqrt2}.
Definition ex17_17_interval_A_closure_C : set := {x :e R|0 <= x /\ x <= sqrt2}.
Definition ex17_17_interval_B_closure_lower : set := {x :e R|sqrt2 <= x /\ x < 3}.
Axiom ex17_17_closure_A_lower_Subq : closure_of R R_lower_limit_topology ex17_17_interval_A c= ex17_17_interval_A_closure_lower.
Axiom ex17_17_closure_A_lower_Supq : ex17_17_interval_A_closure_lower c= closure_of R R_lower_limit_topology ex17_17_interval_A.
Axiom ex17_17_closure_B_lower_Subq : closure_of R R_lower_limit_topology ex17_17_interval_B c= ex17_17_interval_B_closure_lower.
Axiom ex17_17_closure_B_lower_Supq : ex17_17_interval_B_closure_lower c= closure_of R R_lower_limit_topology ex17_17_interval_B.
Axiom ex17_17_closure_A_C_Subq : closure_of R R_C_topology ex17_17_interval_A c= ex17_17_interval_A_closure_C.
Axiom ex17_17_closure_A_C_Supq : ex17_17_interval_A_closure_C c= closure_of R R_C_topology ex17_17_interval_A.
Axiom ex17_17_closure_B_C_Subq : closure_of R R_C_topology ex17_17_interval_B c= ex17_17_interval_B_closure_lower.
Axiom ex17_17_closure_B_C_Supq : ex17_17_interval_B_closure_lower c= closure_of R R_C_topology ex17_17_interval_B.
Axiom ex17_17_closures_of_A_B_in_two_topologies : closure_of R R_lower_limit_topology ex17_17_interval_A = ex17_17_interval_A_closure_lower /\ closure_of R R_C_topology ex17_17_interval_A = ex17_17_interval_A_closure_C /\ closure_of R R_lower_limit_topology ex17_17_interval_B = ex17_17_interval_B_closure_lower /\ closure_of R R_C_topology ex17_17_interval_B = ex17_17_interval_B_closure_lower.
Definition ordsq_A : set := {(inv_nat n,0)|n :e omega :\: {0}}.
Definition ordsq_B : set := {(add_SNo 1 (minus_SNo (inv_nat n)),eps_ 1)|n :e omega :\: {0}}.
Definition ordsq_C : set := {p :e ordered_square|exists x : set , p = (x,0) /\ Rlt 0 x /\ Rlt x 1}.
Definition ordsq_D : set := {p :e ordered_square|exists x : set , p = (x,eps_ 1) /\ Rlt 0 x /\ Rlt x 1}.
Definition ordsq_E : set := {p :e ordered_square|exists y : set , p = (eps_ 1,y) /\ Rlt 0 y /\ Rlt y 1}.
Definition ordsq_p01 : set := (0,1).
Definition ordsq_p10 : set := (1,0).
Definition ordsq_E_closure : set := ordsq_E :\/: {(eps_ 1,0)} :\/: {(eps_ 1,1)}.
Definition ordsq_top_edge_lt1 : set := {p :e ordered_square|exists x : set , p = (x,1) /\ x :e unit_interval /\ Rlt x 1}.
Definition ordsq_C_closure : set := ordsq_C :\/: ordsq_top_edge_lt1 :\/: {ordsq_p10}.
Definition ordsq_D_closure : set := ordsq_D :\/: ordsq_C :\/: ordsq_top_edge_lt1 :\/: {ordsq_p10}.
Axiom simply_ordered_set_setprod_R_R : simply_ordered_set (setprod R R).
Axiom ordered_square_sub_setprod_R_R : ordered_square c= setprod R R.
Axiom order_rel_setprod_R_R_same_first : forall x a2 b2 : set , Rlt a2 b2 -> order_rel (setprod R R) (x,a2) (x,b2).
Axiom order_rel_setprod_R_R_disj : forall a1 a2 b1 b2 : set , order_rel (setprod R R) (a1,a2) (b1,b2) -> Rlt a1 b1 \/ (a1 = b1 /\ Rlt a2 b2).
Axiom ordsq_eps1_eps1_in_E : (eps_ 1,eps_ 1) :e ordsq_E.
Axiom ex17_18_closure_E : closure_of ordered_square ordered_square_topology ordsq_E = ordsq_E_closure.
Axiom inv_nat_Rle_1_local : forall n : set , n :e omega :\: {0} -> Rle (inv_nat n) 1.
Axiom inv_nat_in_unit_interval : forall n : set , n :e omega :\: {0} -> inv_nat n :e unit_interval.
Axiom ordsq_B_sub_ordered_square : ordsq_B c= ordered_square.
Axiom div_SNo_1_eq_inv_nat_local : forall n : set , SNo n -> div_SNo 1 n = inv_nat n.
Axiom exists_inv_nat_ordsucc_lt_local : forall r : set , r :e R -> Rlt 0 r -> exists N : set , N :e omega /\ Rlt (inv_nat (ordsucc N)) r.
Axiom inv_nat_ordsucc_antitone_local2 : forall i j : set , i :e omega -> j :e omega -> i :e j -> Rlt (inv_nat (ordsucc j)) (inv_nat (ordsucc i)).
Axiom ex17_18_closure_A_Supq : ordsq_A :\/: {ordsq_p01} c= closure_of ordered_square ordered_square_topology ordsq_A.
Axiom ex17_18_closure_A_Subq : closure_of ordered_square ordered_square_topology ordsq_A c= ordsq_A :\/: {ordsq_p01}.
Axiom ex17_18_p10_interval_basis_meets_B : forall a0 b0 : set , a0 :e ordered_square -> b0 :e ordered_square -> order_rel (setprod R R) a0 ordsq_p10 -> order_rel (setprod R R) ordsq_p10 b0 -> exists w : set , w :e {x0 :e ordered_square|order_rel (setprod R R) a0 x0 /\ order_rel (setprod R R) x0 b0} /\ w :e ordsq_B.
Axiom ex17_18_p10_lower_basis_meets_B : forall b0 : set , b0 :e ordered_square -> order_rel (setprod R R) ordsq_p10 b0 -> exists w : set , w :e {x0 :e ordered_square|order_rel (setprod R R) x0 b0} /\ w :e ordsq_B.
Axiom ex17_18_p10_upper_basis_meets_B : forall a0 : set , a0 :e ordered_square -> order_rel (setprod R R) a0 ordsq_p10 -> exists w : set , w :e {x0 :e ordered_square|order_rel (setprod R R) a0 x0} /\ w :e ordsq_B.
Axiom ordsq_B_lt_p10 : forall w : set , w :e ordsq_B -> order_rel (setprod R R) w ordsq_p10.
Axiom ordsq_B_ordsucc_index_increasing : forall i j : set , i :e omega -> j :e omega -> i :e j -> order_rel (setprod R R) (add_SNo 1 (minus_SNo (inv_nat (ordsucc i))),eps_ 1) (add_SNo 1 (minus_SNo (inv_nat (ordsucc j))),eps_ 1).
Axiom ex17_18_closure_B_eq : closure_of ordered_square ordered_square_topology ordsq_B = ordsq_B :\/: {ordsq_p10}.
Axiom ex17_18_top_edge_lt1_Sub_closure_C : ordsq_top_edge_lt1 c= closure_of ordered_square ordered_square_topology ordsq_C.
Axiom ex17_18_p10_in_closure_C : ordsq_p10 :e closure_of ordered_square ordered_square_topology ordsq_C.
Axiom ex17_18_closure_C_eq : closure_of ordered_square ordered_square_topology ordsq_C = ordsq_C_closure.
Axiom ex17_18_p10_in_closure_D : ordsq_p10 :e closure_of ordered_square ordered_square_topology ordsq_D.
Axiom ex17_18_C_Sub_closure_D : forall p : set , p :e ordsq_C -> p :e closure_of ordered_square ordered_square_topology ordsq_D.
Axiom ex17_18_top_edge_lt1_Sub_closure_D : ordsq_top_edge_lt1 c= closure_of ordered_square ordered_square_topology ordsq_D.
Axiom ex17_18_closure_D_eq : closure_of ordered_square ordered_square_topology ordsq_D = ordsq_D_closure.
Axiom ex17_18_closures_in_ordered_square : closure_of ordered_square ordered_square_topology ordsq_A = ordsq_A :\/: {ordsq_p01} /\ closure_of ordered_square ordered_square_topology ordsq_B = ordsq_B :\/: {ordsq_p10} /\ closure_of ordered_square ordered_square_topology ordsq_C = ordsq_C_closure /\ closure_of ordered_square ordered_square_topology ordsq_D = ordsq_D_closure /\ closure_of ordered_square ordered_square_topology ordsq_E = ordsq_E_closure.
Definition boundary_of : set -> set -> set -> set := fun X Tx A => closure_of X Tx A :/\: closure_of X Tx (X :\: A).
Axiom ex17_19_boundary_properties : forall X Tx A : set , topology_on X Tx -> boundary_of X Tx A c= closure_of X Tx A /\ boundary_of X Tx A c= closure_of X Tx (X :\: A).
Axiom ex17_20_boundaries_and_interiors_in_R2 : boundary_of (setprod R R) R2_standard_topology ordered_square_open_strip <> boundary_of (setprod R R) R2_dictionary_order_topology ordered_square_open_strip.
Axiom ex17_21_Kuratowski_closure_complement_maximal : forall X : set , closure_of X (discrete_topology X) (X :\: Empty) = X.
Axiom closure_of_discrete_eq : forall X A : set , A c= X -> closure_of X (discrete_topology X) A = A.
Definition preimage_of : set -> set -> set -> set := fun X f V => {x :e X|apply_fun f x :e V}.
Axiom preimage_of_Union : forall X f Fam : set , preimage_of X f (Union Fam) = Union {preimage_of X f V|V :e Fam}.
Axiom preimage_of_binintersect : forall X f U V : set , preimage_of X f (U :/\: V) = (preimage_of X f U) :/\: (preimage_of X f V).
Axiom preimage_of_mono : forall X f V W : set , V c= W -> preimage_of X f V c= preimage_of X f W.
Axiom preimage_of_binunion : forall X f U V : set , preimage_of X f (U :\/: V) = (preimage_of X f U) :\/: (preimage_of X f V).
Axiom preimage_of_setminus : forall X f U V : set , preimage_of X f (U :\: V) = (preimage_of X f U) :\: (preimage_of X f V).
Axiom preimage_of_Empty : forall X f : set , preimage_of X f Empty = Empty.
Axiom preimage_of_whole : forall X Y f : set , function_on f X Y -> preimage_of X f Y = X.
Axiom preimage_of_complement : forall X Y f V : set , function_on f X Y -> preimage_of X f (Y :\: V) = X :\: preimage_of X f V.
Axiom projection1_apply : forall X Y p : set , p :e setprod X Y -> apply_fun (projection1 X Y) p = p 0.
Axiom projection2_apply : forall X Y p : set , p :e setprod X Y -> apply_fun (projection2 X Y) p = p 1.
Axiom preimage_projection1_rectangle : forall X Y U : set , U c= X -> preimage_of (setprod X Y) (projection1 X Y) U = rectangle_set U Y.
Axiom preimage_projection2_rectangle : forall X Y V : set , V c= Y -> preimage_of (setprod X Y) (projection2 X Y) V = rectangle_set X V.
Definition continuous_map : set -> set -> set -> set -> set -> prop := fun X Tx Y Ty f => topology_on X Tx /\ topology_on Y Ty /\ function_on f X Y /\ forall V : set , V :e Ty -> preimage_of X f V :e Tx.
Axiom continuous_map_topology_dom : forall X Tx Y Ty f : set , continuous_map X Tx Y Ty f -> topology_on X Tx.
Axiom continuous_map_topology_cod : forall X Tx Y Ty f : set , continuous_map X Tx Y Ty f -> topology_on Y Ty.
Axiom continuous_map_function_on : forall X Tx Y Ty f : set , continuous_map X Tx Y Ty f -> function_on f X Y.
Axiom continuous_map_preimage : forall X Tx Y Ty f : set , continuous_map X Tx Y Ty f -> forall V : set , V :e Ty -> preimage_of X f V :e Tx.
Definition mul_const_funR : set -> set := fun c => graph R (fun t : set => mul_SNo t c).
Axiom mul_const_funR_apply : forall c t : set , c :e R -> t :e R -> apply_fun (mul_const_funR c) t = mul_SNo t c.
Axiom preimage_mul_const_funR_open_ray_upper : forall c a : set , c :e R -> 0 < c -> a :e R -> preimage_of R (mul_const_funR c) (open_ray_upper R a) = open_ray_upper R (div_SNo a c).
Axiom preimage_mul_const_funR_open_ray_lower : forall c b : set , c :e R -> 0 < c -> b :e R -> preimage_of R (mul_const_funR c) (open_ray_lower R b) = open_ray_lower R (div_SNo b c).
Axiom closure_preimage_contained : forall X Tx Y Ty f A : set , topology_on X Tx -> topology_on Y Ty -> continuous_map X Tx Y Ty f -> closure_of X Tx (preimage_of X f A) c= preimage_of X f (closure_of Y Ty A).
Axiom continuous_map_domain_finer : forall X Tx Tx' Y Ty f : set , continuous_map X Tx Y Ty f -> topology_on X Tx' -> Tx c= Tx' -> continuous_map X Tx' Y Ty f.
Axiom continuous_map_codomain_coarser : forall X Tx Y Ty Ty' f : set , continuous_map X Tx Y Ty f -> topology_on Y Ty' -> Ty' c= Ty -> continuous_map X Tx Y Ty' f.
Axiom continuous_map_range_restrict : forall X Tx Y Ty f Z0 : set , continuous_map X Tx Y Ty f -> Z0 c= Y -> (forall x : set , x :e X -> apply_fun f x :e Z0) -> continuous_map X Tx Z0 (subspace_topology Y Ty Z0) f.
Axiom continuous_map_range_expand : forall X Tx Y Ty Z0 Tz0 f : set , continuous_map X Tx Y Ty f -> Y c= Z0 -> topology_on Z0 Tz0 -> Ty = subspace_topology Z0 Tz0 Y -> continuous_map X Tx Z0 Tz0 f.
Axiom continuous_map_from_subbasis : forall X Tx Y S f : set , topology_on X Tx -> function_on f X Y -> subbasis_on Y S -> (forall s : set , s :e S -> preimage_of X f s :e Tx) -> continuous_map X Tx Y (generated_topology_from_subbasis Y S) f.
Axiom mul_const_funR_continuous_pos : forall c : set , c :e R -> 0 < c -> continuous_map R R_standard_topology R R_standard_topology (mul_const_funR c).
Definition neg_funR : set := graph R (fun t : set => minus_SNo t).
Axiom neg_funR_apply : forall t : set , t :e R -> apply_fun neg_funR t = minus_SNo t.
Axiom preimage_neg_funR_open_ray_upper : forall a : set , a :e R -> preimage_of R neg_funR (open_ray_upper R a) = open_ray_lower R (minus_SNo a).
Axiom preimage_neg_funR_open_ray_lower : forall b : set , b :e R -> preimage_of R neg_funR (open_ray_lower R b) = open_ray_upper R (minus_SNo b).
Axiom neg_funR_continuous : continuous_map R R_standard_topology R R_standard_topology neg_funR.
Definition continuous_map_total : set -> set -> set -> set -> set -> prop := fun X Tx Y Ty f => topology_on X Tx /\ topology_on Y Ty /\ total_function_on f X Y /\ forall V : set , V :e Ty -> preimage_of X f V :e Tx.
Axiom continuous_map_total_topology_dom : forall X Tx Y Ty f : set , continuous_map_total X Tx Y Ty f -> topology_on X Tx.
Axiom continuous_map_total_topology_cod : forall X Tx Y Ty f : set , continuous_map_total X Tx Y Ty f -> topology_on Y Ty.
Axiom continuous_map_total_total_function_on : forall X Tx Y Ty f : set , continuous_map_total X Tx Y Ty f -> total_function_on f X Y.
Axiom continuous_map_total_preimage : forall X Tx Y Ty f : set , continuous_map_total X Tx Y Ty f -> forall V : set , V :e Ty -> preimage_of X f V :e Tx.
Axiom continuous_map_total_imp : forall X Tx Y Ty f : set , continuous_map_total X Tx Y Ty f -> continuous_map X Tx Y Ty f.
Axiom continuous_map_total_of_continuous_map_and_total : forall X Tx Y Ty f : set , continuous_map X Tx Y Ty f -> total_function_on f X Y -> continuous_map_total X Tx Y Ty f.
Axiom const_fun_continuous : forall X Tx Y Ty x : set , topology_on X Tx -> topology_on Y Ty -> x :e Y -> continuous_map X Tx Y Ty (const_fun X x).
Axiom const_fun_continuous_total : forall X Tx Y Ty x : set , topology_on X Tx -> topology_on Y Ty -> x :e Y -> continuous_map_total X Tx Y Ty (const_fun X x).
Axiom continuous_preserves_closed : forall X Tx Y Ty f : set , continuous_map X Tx Y Ty f -> forall C : set , closed_in Y Ty C -> closed_in X Tx (preimage_of X f C).
Axiom continuous_local_neighborhood : forall X Tx Y Ty f : set , topology_on X Tx -> topology_on Y Ty -> function_on f X Y -> (forall V : set , V :e Ty -> preimage_of X f V :e Tx) -> forall x : set , x :e X -> forall V : set , V :e Ty -> apply_fun f x :e V -> exists U : set , U :e Tx /\ x :e U /\ forall u : set , u :e U -> apply_fun f u :e V.
Axiom topology_elem_of_local_neighborhoods : forall X Tx U : set , topology_on X Tx -> U c= X -> (forall x : set , x :e U -> exists V : set , V :e Tx /\ x :e V /\ V c= U) -> U :e Tx.
Definition continuous_at : set -> set -> prop := fun f x => function_on f R R /\ x :e R /\ forall V : set , V :e R_standard_topology -> apply_fun f x :e V -> exists U : set , U :e R_standard_topology /\ x :e U /\ forall u : set , u :e U -> apply_fun f u :e V.
Axiom continuity_equiv_forms : forall X Tx Y Ty f : set , topology_on X Tx -> topology_on Y Ty -> (continuous_map X Tx Y Ty f <-> function_on f X Y /\ (forall V : set , V :e Ty -> preimage_of X f V :e Tx) /\ (forall C : set , closed_in Y Ty C -> closed_in X Tx (preimage_of X f C)) /\ (forall x : set , x :e X -> forall V : set , V :e Ty -> apply_fun f x :e V -> exists U : set , U :e Tx /\ x :e U /\ forall u : set , u :e U -> apply_fun f u :e V)).
Axiom identity_continuous : forall X Tx : set , topology_on X Tx -> let id := {(x,x)|x :e X} in continuous_map X Tx X Tx id.
Axiom identity_continuous_R_lower_to_standard : continuous_map R R_lower_limit_topology R R_standard_topology {(x,x)|x :e R}.
Definition compose_fun : set -> set -> set -> set := fun X f g => {(x,apply_fun g (apply_fun f x))|x :e X}.
Axiom graph_domain_subset_compose_fun : forall X f g : set , graph_domain_subset (compose_fun X f g) X.
Axiom functional_graph_compose_fun : forall X f g : set , functional_graph (compose_fun X f g).
Axiom function_on_compose_fun : forall X Y Z f g : set , function_on f X Y -> function_on g Y Z -> function_on (compose_fun X f g) X Z.
Axiom total_function_on_compose_fun : forall X Y Z f g : set , function_on f X Y -> function_on g Y Z -> total_function_on (compose_fun X f g) X Z.
Axiom compose_fun_in_function_space : forall X Y Z f g : set , function_on f X Y -> function_on g Y Z -> compose_fun X f g :e function_space X Z.
Axiom compose_fun_in_total_function_space : forall X Y Z f g : set , function_on f X Y -> function_on g Y Z -> compose_fun X f g :e total_function_space X Z.
Axiom compose_fun_apply : forall X f g x : set , x :e X -> apply_fun (compose_fun X f g) x = apply_fun g (apply_fun f x).
Axiom preimage_compose_fun : forall X Y f g W : set , function_on f X Y -> preimage_of X (compose_fun X f g) W = preimage_of X f (preimage_of Y g W).
Axiom composition_continuous : forall X Tx Y Ty Z Tz f g : set , continuous_map X Tx Y Ty f -> continuous_map Y Ty Z Tz g -> continuous_map X Tx Z Tz (compose_fun X f g).
Axiom mul_const_funR_continuous_nonzero : forall c : set , c :e R -> c <> 0 -> continuous_map R R_standard_topology R R_standard_topology (mul_const_funR c).
Axiom continuous_construction_rules : forall X Tx Y Ty Z Tz : set , topology_on X Tx -> topology_on Y Ty -> topology_on Z Tz -> (forall y0 : set , y0 :e Y -> continuous_map X Tx Y Ty (const_fun X y0)) /\ (forall A : set , A c= X -> continuous_map A (subspace_topology X Tx A) X Tx {(y,y)|y :e A}) /\ (forall f g : set , continuous_map X Tx Y Ty f -> continuous_map Y Ty Z Tz g -> continuous_map X Tx Z Tz (compose_fun X f g)) /\ (forall f A : set , A c= X -> continuous_map X Tx Y Ty f -> continuous_map A (subspace_topology X Tx A) Y Ty f) /\ ((forall f Z0 : set , continuous_map X Tx Y Ty f -> Z0 c= Y -> (forall x : set , x :e X -> apply_fun f x :e Z0) -> continuous_map X Tx Z0 (subspace_topology Y Ty Z0) f) /\ (forall f Z0 Tz0 : set , continuous_map X Tx Y Ty f -> Y c= Z0 -> topology_on Z0 Tz0 -> Ty = subspace_topology Z0 Tz0 Y -> continuous_map X Tx Z0 Tz0 f)) /\ (forall f : set , (exists UFam : set , UFam c= Tx /\ Union UFam = X /\ (forall U : set , U :e UFam -> continuous_map U (subspace_topology X Tx U) Y Ty f)) -> continuous_map X Tx Y Ty f).
Axiom continuous_map_local_cover : forall X Tx Y Ty f : set , topology_on X Tx -> topology_on Y Ty -> (exists UFam : set , UFam c= Tx /\ Union UFam = X /\ (forall U : set , U :e UFam -> continuous_map U (subspace_topology X Tx U) Y Ty f)) -> continuous_map X Tx Y Ty f.
Axiom continuous_on_subspace_rule : forall X Tx Y Ty f A : set , topology_on X Tx -> topology_on Y Ty -> A c= X -> continuous_map X Tx Y Ty f -> continuous_map A (subspace_topology X Tx A) Y Ty f.
Axiom function_on_subdomain : forall f X Y A : set , function_on f X Y -> A c= X -> function_on f A Y.
Axiom function_on_codomain : forall f X Y Z : set , function_on f X Y -> Y c= Z -> function_on f X Z.
Axiom total_function_on_codomain : forall f X Y Z : set , total_function_on f X Y -> Y c= Z -> total_function_on f X Z.
Axiom product_space_component_sub : forall I Xi Xi0 : set , (forall i : set , i :e I -> space_family_set Xi0 i c= space_family_set Xi i) -> product_space I Xi0 c= product_space I Xi.
Axiom continuous_map_congr_on : forall X Tx Y Ty f g : set , continuous_map X Tx Y Ty f -> function_on g X Y -> (forall x : set , x :e X -> apply_fun f x = apply_fun g x) -> continuous_map X Tx Y Ty g.
Axiom flip_unit_interval_continuous : continuous_map unit_interval unit_interval_topology unit_interval unit_interval_topology flip_unit_interval.
Definition homeomorphism : set -> set -> set -> set -> set -> prop := fun X Tx Y Ty f => continuous_map X Tx Y Ty f /\ exists g : set , continuous_map Y Ty X Tx g /\ (forall x : set , x :e X -> apply_fun g (apply_fun f x) = x) /\ (forall y : set , y :e Y -> apply_fun f (apply_fun g y) = y).
Axiom homeomorphism_continuous : forall X Tx Y Ty f : set , homeomorphism X Tx Y Ty f -> continuous_map X Tx Y Ty f.
Axiom homeomorphism_inverse_package : forall X Tx Y Ty f : set , homeomorphism X Tx Y Ty f -> exists g : set , continuous_map Y Ty X Tx g /\ (forall x : set , x :e X -> apply_fun g (apply_fun f x) = x) /\ (forall y : set , y :e Y -> apply_fun f (apply_fun g y) = y).
Axiom homeomorphism_topology_left : forall X Tx Y Ty f : set , homeomorphism X Tx Y Ty f -> topology_on X Tx.
Axiom homeomorphism_topology_right : forall X Tx Y Ty f : set , homeomorphism X Tx Y Ty f -> topology_on Y Ty.
Definition affine_line_R2 : set -> set -> set -> set := fun a b c => {p :e EuclidPlane|add_SNo (mul_SNo a (R2_xcoord p)) (mul_SNo b (R2_ycoord p)) = c}.
Axiom affine_line_R2_subset : forall a b c : set , affine_line_R2 a b c c= EuclidPlane.
Axiom affine_line_R2_in_Power : forall a b c : set , affine_line_R2 a b c :e Power EuclidPlane.
Axiom affine_line_R2_subset_R2 : forall a b c : set , affine_line_R2 a b c c= setprod R R.
Axiom affine_line_R2_in_Power_R2 : forall a b c : set , affine_line_R2 a b c :e Power (setprod R R).
Definition affine_line_R2_param_by_x : set -> set -> set -> set := fun a b c => graph R (fun x : set => (x,div_SNo (add_SNo c (minus_SNo (mul_SNo a x))) b)).
Definition affine_line_R2_param_by_y : set -> set -> set -> set := fun a b c => graph R (fun y : set => (div_SNo c a,y)).
Axiom affine_line_R2_param_by_x_apply : forall a b c x : set , x :e R -> apply_fun (affine_line_R2_param_by_x a b c) x = (x,div_SNo (add_SNo c (minus_SNo (mul_SNo a x))) b).
Axiom affine_line_R2_param_by_y_apply : forall a b c y : set , y :e R -> apply_fun (affine_line_R2_param_by_y a b c) y = (div_SNo c a,y).
Axiom projection2_after_affine_line_R2_param_by_y : forall a b c y : set , a :e R -> c :e R -> y :e R -> apply_fun (projection2 R R) (apply_fun (affine_line_R2_param_by_y a b c) y) = y.
Axiom affine_line_R2_param_by_y_after_projection2_on_slice : forall a b c p : set , a :e R -> c :e R -> p :e setprod {div_SNo c a} R -> apply_fun (affine_line_R2_param_by_y a b c) (apply_fun (projection2 R R) p) = p.
Axiom affine_line_R2_param_by_x_function_on : forall a b c : set , a :e R -> b :e R -> c :e R -> function_on (affine_line_R2_param_by_x a b c) R EuclidPlane.
Axiom projection1_after_affine_line_R2_param_by_x : forall a b c x : set , a :e R -> b :e R -> c :e R -> x :e R -> apply_fun (projection1 R R) (apply_fun (affine_line_R2_param_by_x a b c) x) = x.
Axiom affine_line_R2_param_by_y_function_on : forall a b c : set , a :e R -> b :e R -> c :e R -> function_on (affine_line_R2_param_by_y a b c) R EuclidPlane.
Axiom projection1_continuous_in_product : forall X Tx Y Ty : set , topology_on X Tx -> topology_on Y Ty -> continuous_map (setprod X Y) (product_topology X Tx Y Ty) X Tx (projection1 X Y).
Axiom projection2_continuous_in_product : forall X Tx Y Ty : set , topology_on X Tx -> topology_on Y Ty -> continuous_map (setprod X Y) (product_topology X Tx Y Ty) Y Ty (projection2 X Y).
Axiom projection2_continuous_on_vertical_slice : forall x0 Tx Ty : set , topology_on R Tx -> topology_on R Ty -> x0 :e R -> continuous_map (setprod {x0} R) (subspace_topology EuclidPlane (product_topology R Tx R Ty) (setprod {x0} R)) R Ty (projection2 R R).
Axiom affine_line_R2_param_by_y_continuous_in_product : forall a b c Tx Ty : set , topology_on R Tx -> topology_on R Ty -> a :e R -> c :e R -> continuous_map R Ty EuclidPlane (product_topology R Tx R Ty) (affine_line_R2_param_by_y a b c).
Axiom affine_line_R2_param_by_x_in_line : forall a b c x : set , a :e R -> b :e R -> c :e R -> x :e R -> b <> 0 -> apply_fun (affine_line_R2_param_by_x a b c) x :e affine_line_R2 a b c.
Axiom affine_line_R2_param_by_x_after_projection1_on_line : forall a b c p : set , a :e R -> b :e R -> c :e R -> b <> 0 -> p :e affine_line_R2 a b c -> apply_fun (affine_line_R2_param_by_x a b c) (apply_fun (projection1 R R) p) = p.
Axiom affine_line_R2_param_by_y_in_line : forall a b c y : set , a :e R -> b :e R -> c :e R -> y :e R -> b = 0 -> a <> 0 -> apply_fun (affine_line_R2_param_by_y a b c) y :e affine_line_R2 a b c.
Axiom affine_line_R2_b0_eq_slice : forall a b c : set , a :e R -> b :e R -> c :e R -> b = 0 -> a <> 0 -> affine_line_R2 a b c = setprod {div_SNo c a} R.
Definition same_sign_nonzero_R : set -> set -> prop := fun a b => (Rlt 0 a /\ Rlt 0 b) \/ (Rlt a 0 /\ Rlt b 0).
Axiom affine_line_R2_param_by_x_y_decreases_same_sign : forall a b c x1 x2 : set , a :e R -> b :e R -> c :e R -> b <> 0 -> same_sign_nonzero_R a b -> x1 :e R -> x2 :e R -> Rlt x1 x2 -> Rlt (div_SNo (add_SNo c (minus_SNo (mul_SNo a x2))) b) (div_SNo (add_SNo c (minus_SNo (mul_SNo a x1))) b).
Axiom affine_line_R2_singleton_open_same_sign : forall a b c p : set , a :e R -> b :e R -> c :e R -> b <> 0 -> same_sign_nonzero_R a b -> p :e affine_line_R2 a b c -> {p} :e subspace_topology (setprod R R) (product_topology R R_lower_limit_topology R R_lower_limit_topology) (affine_line_R2 a b c).
Axiom projection1_continuous_on_affine_line_same_sign : forall a b c : set , a :e R -> b :e R -> c :e R -> b <> 0 -> same_sign_nonzero_R a b -> continuous_map (affine_line_R2 a b c) (subspace_topology (setprod R R) (product_topology R R_lower_limit_topology R R_lower_limit_topology) (affine_line_R2 a b c)) R (discrete_topology R) (projection1 R R).
Axiom affine_scalar_div_continuous_R_lower_to_standard : forall a b c : set , a :e R -> b :e R -> c :e R -> b <> 0 -> continuous_map R R_lower_limit_topology R R_standard_topology (graph R (fun x : set => div_SNo (add_SNo c (minus_SNo (mul_SNo a x))) b)).
Axiom affine_line_R2_param_by_x_continuous_to_ll_std_line : forall a b c : set , a :e R -> b :e R -> c :e R -> b <> 0 -> continuous_map R R_lower_limit_topology (affine_line_R2 a b c) (subspace_topology (setprod R R) (product_topology R R_lower_limit_topology R R_standard_topology) (affine_line_R2 a b c)) (affine_line_R2_param_by_x a b c).
Axiom affine_line_R2_param_by_x_continuous_in_product_ll_ll : forall a b c : set , a :e R -> b :e R -> c :e R -> b <> 0 -> ~ same_sign_nonzero_R a b -> continuous_map R R_lower_limit_topology (setprod R R) (product_topology R R_lower_limit_topology R R_lower_limit_topology) (affine_line_R2_param_by_x a b c).
Axiom ex16_8_lines_in_lower_limit_products : forall a b c : set , a :e R -> b :e R -> c :e R -> ~ (a = 0 /\ b = 0) -> ((b = 0 -> exists f : set , homeomorphism R R_standard_topology (affine_line_R2 a b c) (subspace_topology (setprod R R) (product_topology R R_lower_limit_topology R R_standard_topology) (affine_line_R2 a b c)) f) /\ (b <> 0 -> exists f : set , homeomorphism R R_lower_limit_topology (affine_line_R2 a b c) (subspace_topology (setprod R R) (product_topology R R_lower_limit_topology R R_standard_topology) (affine_line_R2 a b c)) f)) /\ ((b <> 0 /\ same_sign_nonzero_R a b) -> exists f : set , homeomorphism R (discrete_topology R) (affine_line_R2 a b c) (subspace_topology (setprod R R) (product_topology R R_lower_limit_topology R R_lower_limit_topology) (affine_line_R2 a b c)) f) /\ ((b = 0 \/ ~ same_sign_nonzero_R a b) -> exists f : set , homeomorphism R R_lower_limit_topology (affine_line_R2 a b c) (subspace_topology (setprod R R) (product_topology R R_lower_limit_topology R R_lower_limit_topology) (affine_line_R2 a b c)) f).
Axiom homeomorphism_injective : forall X Tx Y Ty f : set , homeomorphism X Tx Y Ty f -> forall x1 x2 : set , x1 :e X -> x2 :e X -> apply_fun f x1 = apply_fun f x2 -> x1 = x2.
Axiom continuous_on_subspace : forall X Tx Y Ty f A : set , topology_on X Tx -> A c= X -> continuous_map X Tx Y Ty f -> continuous_map A (subspace_topology X Tx A) Y Ty f.
Axiom homeomorphism_inverse_continuous : forall X Tx Y Ty f : set , homeomorphism X Tx Y Ty f -> exists g : set , continuous_map Y Ty X Tx g /\ (forall x : set , x :e X -> apply_fun g (apply_fun f x) = x) /\ (forall y : set , y :e Y -> apply_fun f (apply_fun g y) = y).
Axiom function_union_on_disjoint_total_functional : forall A B Y f g : set , A :/\: B = Empty -> graph_domain_subset f A -> graph_domain_subset g B -> total_function_on f A Y -> total_function_on g B Y -> functional_graph f -> functional_graph g -> function_on (f :\/: g) (A :\/: B) Y.
Axiom total_function_union_on_disjoint_total_functional : forall A B Y f g : set , A :/\: B = Empty -> graph_domain_subset f A -> graph_domain_subset g B -> total_function_on f A Y -> total_function_on g B Y -> functional_graph f -> functional_graph g -> total_function_on (f :\/: g) (A :\/: B) Y.
Axiom functional_graph_union_disjoint_domains : forall A B f g : set , A :/\: B = Empty -> graph_domain_subset f A -> graph_domain_subset g B -> functional_graph f -> functional_graph g -> functional_graph (f :\/: g).
Axiom apply_fun_union_left : forall A B Y f g x : set , A :/\: B = Empty -> graph_domain_subset f A -> graph_domain_subset g B -> total_function_on f A Y -> total_function_on g B Y -> functional_graph f -> functional_graph g -> x :e A -> apply_fun (f :\/: g) x = apply_fun f x.
Axiom apply_fun_union_right : forall A B Y f g x : set , A :/\: B = Empty -> graph_domain_subset f A -> graph_domain_subset g B -> total_function_on f A Y -> total_function_on g B Y -> functional_graph f -> functional_graph g -> x :e B -> apply_fun (f :\/: g) x = apply_fun g x.
Axiom preimage_of_union_functions_total : forall A B Y f g V : set , A :/\: B = Empty -> graph_domain_subset f A -> graph_domain_subset g B -> total_function_on f A Y -> total_function_on g B Y -> functional_graph f -> functional_graph g -> preimage_of (A :\/: B) (f :\/: g) V = (preimage_of A f V) :\/: (preimage_of B g V).
Axiom subspace_union_of_opens : forall X Tx A B U V : set , topology_on X Tx -> A :e Tx -> B :e Tx -> A :/\: B = Empty -> U :e subspace_topology X Tx A -> V :e subspace_topology X Tx B -> (U :\/: V) :e subspace_topology X Tx (A :\/: B).
Axiom pasting_lemma_total_functional : forall X A B Y Tx Ty f g : set , topology_on X Tx -> A :e Tx -> B :e Tx -> A :/\: B = Empty -> graph_domain_subset f A -> graph_domain_subset g B -> functional_graph f -> functional_graph g -> continuous_map_total A (subspace_topology X Tx A) Y Ty f -> continuous_map_total B (subspace_topology X Tx B) Y Ty g -> continuous_map_total (A :\/: B) (subspace_topology X Tx (A :\/: B)) Y Ty (f :\/: g).
Axiom pasting_lemma_total_functional_imp : forall X A B Y Tx Ty f g : set , topology_on X Tx -> A :e Tx -> B :e Tx -> A :/\: B = Empty -> graph_domain_subset f A -> graph_domain_subset g B -> functional_graph f -> functional_graph g -> continuous_map_total A (subspace_topology X Tx A) Y Ty f -> continuous_map_total B (subspace_topology X Tx B) Y Ty g -> continuous_map (A :\/: B) (subspace_topology X Tx (A :\/: B)) Y Ty (f :\/: g).
Axiom pasting_lemma : forall X A B Y Tx Ty f g : set , topology_on X Tx -> closed_in X Tx A -> closed_in X Tx B -> A :\/: B = X -> continuous_map A (subspace_topology X Tx A) Y Ty f -> continuous_map B (subspace_topology X Tx B) Y Ty g -> (forall x : set , x :e (A :/\: B) -> apply_fun f x = apply_fun g x) -> exists h : set , continuous_map X Tx Y Ty h /\ ((forall x : set , x :e A -> apply_fun h x = apply_fun f x) /\ (forall x : set , x :e B -> apply_fun h x = apply_fun g x)).
Definition pair_map : set -> set -> set -> set := fun A f g => {(a,(apply_fun f a,apply_fun g a))|a :e A}.
Axiom pair_map_apply : forall A X Y f g a : set , a :e A -> apply_fun (pair_map A f g) a = (apply_fun f a,apply_fun g a).
Axiom pair_map_in_function_space : forall A X Y f g : set , function_on f A X -> function_on g A Y -> pair_map A f g :e function_space A (setprod X Y).
Axiom total_function_on_pair_map : forall A X Y f g : set , function_on f A X -> function_on g A Y -> total_function_on (pair_map A f g) A (setprod X Y).
Axiom preimage_pair_map_rectangle : forall A X Y f g U V : set , preimage_of A (pair_map A f g) (rectangle_set U V) = (preimage_of A f U) :/\: (preimage_of A g V).
Axiom maps_into_products_axiom : forall A Ta X Tx Y Ty f g : set , continuous_map A Ta X Tx f -> continuous_map A Ta Y Ty g -> continuous_map A Ta (setprod X Y) (product_topology X Tx Y Ty) (pair_map A f g).
Axiom maps_into_products : forall A Ta X Tx Y Ty f g : set , continuous_map A Ta X Tx f -> continuous_map A Ta Y Ty g -> continuous_map A Ta (setprod X Y) (product_topology X Tx Y Ty) (pair_map A f g).
Definition projection_map1 : set -> set -> set := fun X Y => projection1 X Y.
Definition projection_map2 : set -> set -> set := fun X Y => projection2 X Y.
Axiom preimage_of_rectangle_via_projections : forall A X Y h U V : set , function_on h A (setprod X Y) -> U c= X -> V c= Y -> preimage_of A h (rectangle_set U V) = (preimage_of A (compose_fun A h (projection_map1 X Y)) U) :/\: (preimage_of A (compose_fun A h (projection_map2 X Y)) V).
Axiom projection_maps_continuous : forall X Tx Y Ty : set , topology_on X Tx -> topology_on Y Ty -> continuous_map (setprod X Y) (product_topology X Tx Y Ty) X Tx (projection_map1 X Y) /\ continuous_map (setprod X Y) (product_topology X Tx Y Ty) Y Ty (projection_map2 X Y).
Axiom maps_into_products_converse : forall A Ta X Tx Y Ty h : set , topology_on X Tx -> topology_on Y Ty -> continuous_map A Ta (setprod X Y) (product_topology X Tx Y Ty) h -> continuous_map A Ta X Tx (compose_fun A h (projection_map1 X Y)) /\ continuous_map A Ta Y Ty (compose_fun A h (projection_map2 X Y)).
Axiom maps_into_products_coords_imp : forall A Ta X Tx Y Ty h : set , topology_on X Tx -> topology_on Y Ty -> function_on h A (setprod X Y) -> continuous_map A Ta X Tx (compose_fun A h (projection_map1 X Y)) -> continuous_map A Ta Y Ty (compose_fun A h (projection_map2 X Y)) -> continuous_map A Ta (setprod X Y) (product_topology X Tx Y Ty) h.
Axiom maps_into_products_iff_coords : forall A Ta X Tx Y Ty h : set , topology_on X Tx -> topology_on Y Ty -> function_on h A (setprod X Y) -> (continuous_map A Ta (setprod X Y) (product_topology X Tx Y Ty) h <-> (continuous_map A Ta X Tx (compose_fun A h (projection_map1 X Y)) /\ continuous_map A Ta Y Ty (compose_fun A h (projection_map2 X Y)))).
Axiom projections_are_continuous : forall X Tx Y Ty : set , topology_on X Tx -> topology_on Y Ty -> continuous_map (setprod X Y) (product_topology X Tx Y Ty) X Tx (projection_map1 X Y) /\ continuous_map (setprod X Y) (product_topology X Tx Y Ty) Y Ty (projection_map2 X Y).
Axiom product_topology_universal : forall X Tx Y Ty : set , topology_on X Tx -> topology_on Y Ty -> exists Tprod : set , topology_on (setprod X Y) Tprod /\ continuous_map (setprod X Y) Tprod X Tx (projection_map1 X Y) /\ continuous_map (setprod X Y) Tprod Y Ty (projection_map2 X Y).
Axiom rectangle_set_as_intersection : forall X Y U V : set , U c= X -> V c= Y -> rectangle_set U V = (rectangle_set U Y) :/\: (rectangle_set X V).
Axiom product_topology_coarsest : forall X Tx Y Ty Tprod : set , topology_on X Tx -> topology_on Y Ty -> topology_on (setprod X Y) Tprod -> continuous_map (setprod X Y) Tprod X Tx (projection_map1 X Y) -> continuous_map (setprod X Y) Tprod Y Ty (projection_map2 X Y) -> coarser_than (product_topology X Tx Y Ty) Tprod.
Definition metric_on : set -> set -> prop := fun X d => function_on d (setprod X X) R /\ (forall x y : set , x :e X -> y :e X -> apply_fun d (x,y) = apply_fun d (y,x)) /\ (forall x : set , x :e X -> apply_fun d (x,x) = 0) /\ (forall x y : set , x :e X -> y :e X -> ~ (Rlt (apply_fun d (x,y)) 0) /\ (apply_fun d (x,y) = 0 -> x = y)) /\ (forall x y z : set , x :e X -> y :e X -> z :e X -> ~ (Rlt (add_SNo (apply_fun d (x,y)) (apply_fun d (y,z))) (apply_fun d (x,z)))).
Definition pseudometric_on : set -> set -> prop := fun X d => function_on d (setprod X X) R /\ (forall x y : set , x :e X -> y :e X -> apply_fun d (x,y) = apply_fun d (y,x)) /\ (forall x : set , x :e X -> apply_fun d (x,x) = 0) /\ (forall x y : set , x :e X -> y :e X -> ~ (Rlt (apply_fun d (x,y)) 0)) /\ (forall x y z : set , x :e X -> y :e X -> z :e X -> ~ (Rlt (add_SNo (apply_fun d (x,y)) (apply_fun d (y,z))) (apply_fun d (x,z)))).
Definition metric_on_total : set -> set -> prop := fun X d => metric_on X d /\ total_function_on d (setprod X X) R.
Axiom metric_on_function_on : forall X d : set , metric_on X d -> function_on d (setprod X X) R.
Definition EuclidPlane_metric : set := graph (setprod EuclidPlane EuclidPlane) (fun pq : set => distance_R2 (pq 0) (pq 1)).
Axiom EuclidPlane_metric_apply : forall p q : set , p :e EuclidPlane -> q :e EuclidPlane -> apply_fun EuclidPlane_metric (p,q) = distance_R2 p q.
Axiom EuclidPlane_metric_is_metric_on : metric_on EuclidPlane EuclidPlane_metric.
Axiom EuclidPlane_metric_is_metric_on_total : metric_on_total EuclidPlane EuclidPlane_metric.
Axiom metric_on_symmetric : forall X d x y : set , metric_on X d -> x :e X -> y :e X -> apply_fun d (x,y) = apply_fun d (y,x).
Axiom metric_on_diag_zero : forall X d x : set , metric_on X d -> x :e X -> apply_fun d (x,x) = 0.
Axiom metric_on_nonneg : forall X d x y : set , metric_on X d -> x :e X -> y :e X -> ~ (Rlt (apply_fun d (x,y)) 0).
Axiom metric_on_zero_eq : forall X d x y : set , metric_on X d -> x :e X -> y :e X -> apply_fun d (x,y) = 0 -> x = y.
Axiom metric_on_pos_of_neq : forall X d x y : set , metric_on X d -> x :e X -> y :e X -> ~ (x = y) -> Rlt 0 (apply_fun d (x,y)).
Definition metric_neg_dists : set -> set -> set -> set -> set := fun X d x A => {minus_SNo (apply_fun d (x,a))|a :e A}.
Axiom metric_neg_dists_in_R : forall X d x A : set , metric_on X d -> x :e X -> A c= X -> forall t : set , t :e metric_neg_dists X d x A -> t :e R.
Axiom metric_neg_dists_le_0 : forall X d x A : set , metric_on X d -> x :e X -> A c= X -> forall t : set , t :e metric_neg_dists X d x A -> Rle t 0.
Axiom metric_on_triangle : forall X d x y z : set , metric_on X d -> x :e X -> y :e X -> z :e X -> ~ (Rlt (add_SNo (apply_fun d (x,y)) (apply_fun d (y,z))) (apply_fun d (x,z))).
Axiom metric_on_total_imp_metric_on : forall X d : set , metric_on_total X d -> metric_on X d.
Axiom metric_on_total_total_function : forall X d : set , metric_on_total X d -> total_function_on d (setprod X X) R.
Axiom metric_triangle_Rle : forall X d x y z : set , metric_on X d -> x :e X -> y :e X -> z :e X -> Rle (apply_fun d (x,z)) (add_SNo (apply_fun d (x,y)) (apply_fun d (y,z))).
Definition open_ball : set -> set -> set -> set -> set := fun X d x r => {y :e X|Rlt (apply_fun d (x,y)) r}.
Axiom open_ballE1 : forall X d x r y : set , y :e open_ball X d x r -> y :e X.
Axiom open_ballE2 : forall X d x r y : set , y :e open_ball X d x r -> Rlt (apply_fun d (x,y)) r.
Axiom open_ballI : forall X d x r y : set , y :e X -> Rlt (apply_fun d (x,y)) r -> y :e open_ball X d x r.
Axiom open_ball_EuclidPlane_metric_eq : forall c r : set , c :e EuclidPlane -> open_ball EuclidPlane EuclidPlane_metric c r = {p :e EuclidPlane|Rlt (distance_R2 p c) r}.
Axiom open_ball_subset_X : forall X d x r : set , open_ball X d x r c= X.
Axiom open_ball_in_Power : forall X d x r : set , open_ball X d x r :e Power X.
Axiom center_in_open_ball : forall X d x r : set , metric_on X d -> x :e X -> Rlt 0 r -> x :e open_ball X d x r.
Axiom open_ball_nonempty : forall X d x r : set , metric_on X d -> x :e X -> Rlt 0 r -> open_ball X d x r <> Empty.
Axiom exists_eps_lt_pos : forall d : set , d :e R -> Rlt 0 d -> exists N :e omega , eps_ N < d.
Axiom exists_eps_lt_two_pos : forall a b : set , a :e R -> b :e R -> Rlt 0 a -> Rlt 0 b -> exists r3 : set , r3 :e R /\ Rlt 0 r3 /\ Rlt r3 a /\ Rlt r3 b.
Axiom exists_eps_lt_four_pos : forall a b c d : set , a :e R -> b :e R -> c :e R -> d :e R -> Rlt 0 a -> Rlt 0 b -> Rlt 0 c -> Rlt 0 d -> exists r3 : set , r3 :e R /\ Rlt 0 r3 /\ Rlt r3 a /\ Rlt r3 b /\ Rlt r3 c /\ Rlt r3 d.
Axiom Rle_Rlt_tra : forall a b c : set , Rle a b -> Rlt b c -> Rlt a c.
Axiom Rlt_Rle_tra : forall a b c : set , Rlt a b -> Rle b c -> Rlt a c.
Axiom Rlt_add_SNo : forall a b c d : set , Rlt a b -> Rlt c d -> Rlt (add_SNo a c) (add_SNo b d).
Axiom open_ball_pair_dist_lt_add_radius : forall X d x r y z : set , metric_on X d -> x :e X -> y :e open_ball X d x r -> z :e open_ball X d x r -> Rlt (apply_fun d (y,z)) (add_SNo r r).
Axiom open_ball_pair_dist_lt_eps_pred : forall X d x n y z : set , metric_on X d -> x :e X -> n :e omega -> y :e open_ball X d x (eps_ (ordsucc n)) -> z :e open_ball X d x (eps_ (ordsucc n)) -> Rlt (apply_fun d (y,z)) (eps_ n).
Axiom eps_ordsucc_lt_eps : forall n : set , n :e omega -> Rlt (eps_ (ordsucc n)) (eps_ n).
Axiom eps_ordsucc_ordsucc_lt_eps : forall n : set , n :e omega -> Rlt (eps_ (ordsucc (ordsucc n))) (eps_ n).
Axiom metric_ball_intersect_centers_lt_add : forall X d x y p r1 r2 : set , metric_on X d -> x :e X -> y :e X -> p :e X -> r1 :e R -> r2 :e R -> p :e open_ball X d x r1 -> p :e open_ball X d y r2 -> Rlt (apply_fun d (x,y)) (add_SNo r1 r2).
Definition well_ordered_set : set -> prop := fun X => ordinal X /\ X <> R /\ X <> rational_numbers /\ X <> setprod 2 omega /\ X <> setprod R R.
Axiom well_ordering_theorem_axiom : forall A : set , exists W : set , well_ordered_set W /\ equip A W.
Axiom well_ordering_theorem_equip : forall A : set , exists W : set , well_ordered_set W /\ equip A W.
Axiom well_ordered_set_is_ordinal : forall X : set , well_ordered_set X -> ordinal X.
Definition eps_separated_set : set -> set -> set -> set -> prop := fun X d S n => S c= X /\ forall x y : set , x :e S -> y :e S -> ~ (x = y) -> ~ (Rlt (apply_fun d (x,y)) (eps_ n)).
Definition maximal_eps_separated_set : set -> set -> set -> set -> prop := fun X d S n => eps_separated_set X d S n /\ forall x : set , x :e X -> (forall y : set , y :e S -> ~ (Rlt (apply_fun d (x,y)) (eps_ n))) -> x :e S.
Axiom maximal_eps_separated_set_implies_cover : forall X d S n : set , metric_on X d -> n :e omega -> maximal_eps_separated_set X d S n -> X c= (\/_ c :e S , open_ball X d c (eps_ n)).
Definition maximal_eps_separated_set_on : set -> set -> set -> set -> set -> prop := fun X d Y S n => (Y c= X) /\ (S c= Y) /\ (forall x y : set , x :e S -> y :e S -> ~ (x = y) -> ~ (Rlt (apply_fun d (x,y)) (eps_ n))) /\ (forall x : set , x :e Y -> (forall y : set , y :e S -> ~ (Rlt (apply_fun d (x,y)) (eps_ n))) -> x :e S).
Axiom maximal_eps_separated_set_on_exists : forall X d Y n : set , metric_on X d -> n :e omega -> Y c= X -> exists S : set , maximal_eps_separated_set_on X d Y S n.
Axiom maximal_eps_separated_set_on_implies_cover : forall X d Y S n : set , metric_on X d -> n :e omega -> maximal_eps_separated_set_on X d Y S n -> Y c= (\/_ c :e S , open_ball X d c (eps_ n)).
Axiom eps_separated_imp_eps_succ_ball_point_unique : forall X d S n p x y : set , metric_on X d -> n :e omega -> eps_separated_set X d S n -> p :e X -> x :e S -> y :e S -> p :e open_ball X d x (eps_ (ordsucc n)) -> p :e open_ball X d y (eps_ (ordsucc n)) -> x = y.
Axiom open_ball_refine_intersection : forall X d c1 c2 x r1 r2 : set , metric_on X d -> c1 :e X -> c2 :e X -> x :e X -> r1 :e R -> r2 :e R -> Rlt 0 r1 -> Rlt 0 r2 -> x :e open_ball X d c1 r1 -> x :e open_ball X d c2 r2 -> exists r3 : set , r3 :e R /\ Rlt 0 r3 /\ open_ball X d x r3 c= (open_ball X d c1 r1) :/\: (open_ball X d c2 r2).
Axiom open_ball_refine_center : forall X d c x r : set , metric_on X d -> c :e X -> x :e X -> r :e R -> Rlt 0 r -> x :e open_ball X d c r -> exists s : set , s :e R /\ Rlt 0 s /\ open_ball X d x s c= open_ball X d c r.
Axiom open_ball_refine_center_eps : forall X d c x r : set , metric_on X d -> c :e X -> x :e X -> r :e R -> Rlt 0 r -> x :e open_ball X d c r -> exists N : set , N :e omega /\ open_ball X d x (eps_ N) c= open_ball X d c r.
Definition metric_topology : set -> set -> set := fun X d => generated_topology X (famunion X (fun x => {open_ball X d x r|r :e R,Rlt 0 r})).
Axiom open_balls_form_basis : forall X d : set , metric_on X d -> basis_on X (famunion X (fun x => {open_ball X d x r|r :e R,Rlt 0 r})).
Axiom open_in_metric_topology_has_eps_ball_sub : forall X d U x : set , metric_on X d -> open_in X (metric_topology X d) U -> x :e U -> exists N : set , N :e omega /\ open_ball X d x (eps_ N) c= U.
Axiom open_in_metric_topology_has_eps_succsucc_ball_sub : forall X d U x : set , metric_on X d -> open_in X (metric_topology X d) U -> x :e U -> exists n : set , n :e omega /\ open_ball X d x (eps_ (ordsucc (ordsucc n))) c= U.
Axiom metric_topology_is_topology : forall X d : set , metric_on X d -> topology_on X (metric_topology X d).
Axiom metric_topology_generated_by_balls : forall X d : set , metric_on X d -> generated_topology X (famunion X (fun x => {open_ball X d x r|r :e R,Rlt 0 r})) = metric_topology X d.
Axiom open_ball_EuclidPlane_metric_in_circular_regions : forall c r : set , c :e EuclidPlane -> r :e R -> Rlt 0 r -> open_ball EuclidPlane EuclidPlane_metric c r :e circular_regions.
Axiom EuclidPlane_metric_open_balls_family_eq_circular_regions : famunion EuclidPlane (fun c : set => {open_ball EuclidPlane EuclidPlane_metric c r|r :e R,Rlt 0 r}) = circular_regions.
Axiom metric_topology_EuclidPlane_metric_eq_generated_circular_regions : metric_topology EuclidPlane EuclidPlane_metric = generated_topology EuclidPlane circular_regions.
Axiom metric_topology_EuclidPlane_metric_eq_generated_rectangular_regions : metric_topology EuclidPlane EuclidPlane_metric = generated_topology EuclidPlane rectangular_regions.
Axiom metric_topology_EuclidPlane_metric_sub_R2_standard_topology : metric_topology EuclidPlane EuclidPlane_metric c= R2_standard_topology.
Axiom metric_topology_EuclidPlane_metric_eq_R2_standard_topology : metric_topology EuclidPlane EuclidPlane_metric = R2_standard_topology.
Axiom open_ball_open_in_metric_topology : forall X d x r : set , metric_on X d -> x :e X -> Rlt 0 r -> open_in X (metric_topology X d) (open_ball X d x r).
Axiom open_ball_in_metric_topology : forall X d x r : set , metric_on X d -> x :e X -> Rlt 0 r -> open_ball X d x r :e metric_topology X d.
Axiom metric_topology_Hausdorff : forall X d : set , metric_on X d -> Hausdorff_space X (metric_topology X d).
Axiom metric_epsilon_delta_continuity : forall X dX Y dY f : set , metric_on X dX -> metric_on Y dY -> function_on f X Y -> (continuous_map X (metric_topology X dX) Y (metric_topology Y dY) f <-> (forall x0 : set , x0 :e X -> forall eps : set , eps :e R /\ Rlt 0 eps -> exists delta : set , delta :e R /\ Rlt 0 delta /\ (forall x : set , x :e X -> Rlt (apply_fun dX (x,x0)) delta -> Rlt (apply_fun dY (apply_fun f x,apply_fun f x0)) eps))).
Definition sequence_in : set -> set -> prop := fun seq A => function_on seq omega A.
Definition sequence_on : set -> set -> prop := fun seq A => function_on seq omega A.
Axiom apply_fun_of_graph_eq : forall f A : set , forall g : set -> set , forall a : set , f = graph A g -> a :e A -> apply_fun f a = g a.
Definition converges_to : set -> set -> set -> set -> prop := fun X Tx seq x => topology_on X Tx /\ sequence_on seq X /\ x :e X /\ forall U : set , U :e Tx -> x :e U -> exists N : set , N :e omega /\ forall n : set , n :e omega -> N c= n -> apply_fun seq n :e U.
Axiom converges_to_topology : forall X Tx seq x : set , converges_to X Tx seq x -> topology_on X Tx.
Axiom converges_to_sequence_on : forall X Tx seq x : set , converges_to X Tx seq x -> sequence_on seq X.
Axiom converges_to_point_in_X : forall X Tx seq x : set , converges_to X Tx seq x -> x :e X.
Axiom converges_to_neighborhoods : forall X Tx seq x : set , converges_to X Tx seq x -> forall U : set , U :e Tx -> x :e U -> exists N : set , N :e omega /\ forall n : set , n :e omega -> N c= n -> apply_fun seq n :e U.
Definition map_sequence : set -> set -> set := fun f seq => compose_fun omega seq f.
Definition image_of : set -> set -> set := fun f U => Repl U (fun x => apply_fun f x).
Definition function_sequence_value : set -> set -> set -> set := fun f_seq n x => apply_fun (apply_fun f_seq n) x.
Axiom image_of_mono : forall f U V : set , U c= V -> image_of f U c= image_of f V.
Axiom image_of_sub_codomain : forall f X Y U : set , function_on f X Y -> U c= X -> image_of f U c= Y.
Axiom image_of_Empty : forall f : set , image_of f Empty = Empty.
Axiom image_of_binunion : forall f U V : set , image_of f (U :\/: V) = (image_of f U) :\/: (image_of f V).
Axiom image_of_Union : forall f Fam : set , image_of f (Union Fam) = Union {image_of f U|U :e Fam}.
Axiom image_of_compose_fun : forall X f g U : set , U c= X -> image_of (compose_fun X f g) U = image_of g (image_of f U).
Definition sequence_converges_metric : set -> set -> set -> set -> prop := fun X d seq x => metric_on X d /\ sequence_on seq X /\ x :e X /\ forall eps : set , eps :e R /\ Rlt 0 eps -> exists N : set , N :e omega /\ forall n : set , n :e omega -> N c= n -> Rlt (apply_fun d (apply_fun seq n,x)) eps.
Axiom sequence_converges_metric_metric_on : forall X d seq x : set , sequence_converges_metric X d seq x -> metric_on X d.
Axiom sequence_converges_metric_sequence_on : forall X d seq x : set , sequence_converges_metric X d seq x -> sequence_on seq X.
Axiom sequence_converges_metric_point_in_X : forall X d seq x : set , sequence_converges_metric X d seq x -> x :e X.
Axiom sequence_converges_metric_eps : forall X d seq x : set , sequence_converges_metric X d seq x -> forall eps : set , eps :e R /\ Rlt 0 eps -> exists N : set , N :e omega /\ forall n : set , n :e omega -> N c= n -> Rlt (apply_fun d (apply_fun seq n,x)) eps.
Axiom metric_limits_unique : forall X d seq x y : set , metric_on X d -> sequence_on seq X -> sequence_converges_metric X d seq x -> sequence_converges_metric X d seq y -> x = y.
Definition uniform_convergence_functions : set -> set -> set -> set -> set -> set -> prop := fun X dX Y dY f_seq f => metric_on X dX /\ metric_on Y dY /\ function_on f_seq omega (function_space X Y) /\ function_on f X Y /\ (forall n : set , n :e omega -> function_on (apply_fun f_seq n) X Y) /\ forall eps : set , eps :e R /\ Rlt 0 eps -> exists N : set , N :e omega /\ forall n : set , n :e omega -> N c= n -> forall x : set , x :e X -> Rlt (apply_fun dY (apply_fun (apply_fun f_seq n) x,apply_fun f x)) eps.
Axiom uniform_convergence_functions_metric_on_X : forall X dX Y dY f_seq f : set , uniform_convergence_functions X dX Y dY f_seq f -> metric_on X dX.
Axiom uniform_convergence_functions_metric_on_Y : forall X dX Y dY f_seq f : set , uniform_convergence_functions X dX Y dY f_seq f -> metric_on Y dY.
Axiom uniform_convergence_functions_fseq : forall X dX Y dY f_seq f : set , uniform_convergence_functions X dX Y dY f_seq f -> function_on f_seq omega (function_space X Y).
Axiom uniform_convergence_functions_f : forall X dX Y dY f_seq f : set , uniform_convergence_functions X dX Y dY f_seq f -> function_on f X Y.
Axiom uniform_convergence_functions_pointwise : forall X dX Y dY f_seq f : set , uniform_convergence_functions X dX Y dY f_seq f -> forall n : set , n :e omega -> function_on (apply_fun f_seq n) X Y.
Axiom uniform_convergence_functions_eps : forall X dX Y dY f_seq f : set , uniform_convergence_functions X dX Y dY f_seq f -> forall eps : set , eps :e R /\ Rlt 0 eps -> exists N : set , N :e omega /\ forall n : set , n :e omega -> N c= n -> forall x : set , x :e X -> Rlt (apply_fun dY (apply_fun (apply_fun f_seq n) x,apply_fun f x)) eps.
Axiom Rle_tra : forall a b c : set , Rle a b -> Rle b c -> Rle a c.
Axiom Rle_add_SNo_2 : forall x y z : set , x :e R -> y :e R -> z :e R -> Rle y z -> Rle (add_SNo x y) (add_SNo x z).
Axiom uniform_limit_of_continuous_is_continuous : forall X dX Y dY f_seq f : set , metric_on X dX -> metric_on Y dY -> function_on f_seq omega (function_space X Y) -> (forall n : set , n :e omega -> continuous_map X (metric_topology X dX) Y (metric_topology Y dY) (apply_fun f_seq n)) -> uniform_convergence_functions X dX Y dY f_seq f -> continuous_map X (metric_topology X dX) Y (metric_topology Y dY) f.
Axiom sequence_convergence_metric : forall X d seq x : set , sequence_converges_metric X d seq x -> sequence_converges_metric X d seq x.
Axiom continuity_via_sequences_metric : forall X dX Y dY f : set , metric_on X dX -> metric_on Y dY -> function_on f X Y -> (continuous_map X (metric_topology X dX) Y (metric_topology Y dY) f <-> forall seq x : set , sequence_converges_metric X dX seq x -> sequence_converges_metric Y dY ({(n,apply_fun f (apply_fun seq n))|n :e omega}) (apply_fun f x)).
Definition quotient_topology : set -> set -> set -> set -> set := fun X Tx Y f => {V :e Power Y|{x :e X|apply_fun f x :e V} :e Tx}.
Definition quotient_map : set -> set -> set -> set -> prop := fun X Tx Y f => topology_on X Tx /\ function_on f X Y /\ (forall y : set , y :e Y -> exists x : set , x :e X /\ apply_fun f x = y).
Axiom quotient_topology_is_topology : forall X Tx Y f : set , topology_on X Tx -> quotient_map X Tx Y f -> topology_on Y (quotient_topology X Tx Y f).
Axiom quotient_universal_property : forall X Tx Y Ty f : set , quotient_map X Tx Y f -> topology_on Y Ty -> Ty c= quotient_topology X Tx Y f -> continuous_map X Tx Y Ty f.
Definition separation_of : set -> set -> set -> prop := fun X U V => U :e Power X /\ V :e Power X /\ U :/\: V = Empty /\ U <> Empty /\ V <> Empty /\ U :\/: V = X.
Axiom separation_of_complement : forall X U : set , U c= X -> U <> Empty -> U <> X -> separation_of X U (X :\: U).
Definition connected_space : set -> set -> prop := fun X Tx => topology_on X Tx /\ ~ (exists U V : set , U :e Tx /\ V :e Tx /\ separation_of X U V).
Axiom connected_space_topology : forall X Tx : set , connected_space X Tx -> topology_on X Tx.
Axiom connected_space_no_separation : forall X Tx : set , connected_space X Tx -> ~ (exists U V : set , U :e Tx /\ V :e Tx /\ separation_of X U V).
Axiom homeomorphism_preserves_connected : forall X Tx Y Ty f : set , homeomorphism X Tx Y Ty f -> connected_space X Tx -> connected_space Y Ty.
Axiom clopen_gives_separation : forall X Tx A : set , topology_on X Tx -> A <> Empty -> A <> X -> open_in X Tx A -> closed_in X Tx A -> exists U V : set , U :e Tx /\ V :e Tx /\ separation_of X U V.
Axiom separation_gives_clopen : forall X Tx U V : set , topology_on X Tx -> U :e Tx -> V :e Tx -> separation_of X U V -> exists A : set , A <> Empty /\ A <> X /\ open_in X Tx A /\ closed_in X Tx A.
Axiom connected_iff_no_nontrivial_clopen : forall X Tx : set , topology_on X Tx -> (connected_space X Tx <-> ~ (exists A : set , A <> Empty /\ A <> X /\ open_in X Tx A /\ closed_in X Tx A)).
Axiom separation_subspace_limit_points : forall X Tx Y A B : set , topology_on X Tx -> Y c= X -> (((A :e subspace_topology X Tx Y /\ B :e subspace_topology X Tx Y) /\ separation_of Y A B) <-> (separation_of Y A B /\ ~ (exists b : set , b :e B /\ limit_point_of X Tx A b) /\ ~ (exists a : set , a :e A /\ limit_point_of X Tx B a))).
Axiom connected_subset_in_separation_side : forall X Tx C D Y : set , topology_on X Tx -> Y c= X -> connected_space Y (subspace_topology X Tx Y) -> C :e Tx -> D :e Tx -> separation_of X C D -> Y c= C \/ Y c= D.
Axiom union_connected_common_point : forall X Tx F : set , topology_on X Tx -> (forall C : set , C :e F -> C c= X) -> (forall C : set , C :e F -> connected_space C (subspace_topology X Tx C)) -> (exists x : set , forall C : set , C :e F -> x :e C) -> connected_space (Union F) (subspace_topology X Tx (Union F)).
Axiom connected_with_limit_points : forall X Tx A B : set , topology_on X Tx -> A c= X -> B c= X -> connected_space A (subspace_topology X Tx A) -> A c= B -> B c= closure_of X Tx A -> connected_space B (subspace_topology X Tx B).
Axiom continuous_image_connected : forall X Tx Y Ty f : set , connected_space X Tx -> continuous_map X Tx Y Ty f -> connected_space (image_of f X) (subspace_topology Y Ty (image_of f X)).
Definition R_upper_bound : set -> set -> prop := fun A u => u :e R /\ forall a : set , a :e A -> a :e R -> Rle a u.
Definition R_lower_bound : set -> set -> prop := fun A u => u :e R /\ forall a : set , a :e A -> a :e R -> Rle u a.
Definition R_lub : set -> set -> prop := fun A l => l :e R /\ (forall a : set , a :e A -> a :e R -> Rle a l) /\ (forall u : set , u :e R -> (forall a : set , a :e A -> a :e R -> Rle a u) -> Rle l u).
Definition R_glb : set -> set -> prop := fun A g => g :e R /\ (forall a : set , a :e A -> a :e R -> Rle g a) /\ (forall u : set , u :e R -> (forall a : set , a :e A -> a :e R -> Rle u a) -> Rle u g).
Axiom R_lub_in_R : forall A l : set , R_lub A l -> l :e R.
Axiom R_glb_in_R : forall A g : set , R_glb A g -> g :e R.
Axiom R_lub_upper : forall A l x : set , R_lub A l -> x :e A -> x :e R -> Rle x l.
Axiom R_glb_lower : forall A g x : set , R_glb A g -> x :e A -> x :e R -> Rle g x.
Axiom R_lub_min : forall A l u : set , R_lub A l -> u :e R -> (forall a : set , a :e A -> a :e R -> Rle a u) -> Rle l u.
Axiom R_glb_max : forall A g u : set , R_glb A g -> u :e R -> (forall a : set , a :e A -> a :e R -> Rle u a) -> Rle u g.
Axiom R_lub_strict_witness : forall A l a : set , R_lub A l -> (forall x : set , x :e A -> x :e R) -> a :e R -> Rlt a l -> exists x : set , x :e A /\ Rlt a x.
Axiom R_glb_strict_witness : forall A g b : set , R_glb A g -> (forall x : set , x :e A -> x :e R) -> b :e R -> Rlt g b -> exists x : set , x :e A /\ Rlt x b.
Axiom R_lub_unique : forall A l1 l2 : set , R_lub A l1 -> R_lub A l2 -> l1 = l2.
Axiom R_glb_unique : forall A g1 g2 : set , R_glb A g1 -> R_glb A g2 -> g1 = g2.
Axiom R_lub_Sing0 : R_lub {0} 0.
Axiom not_imp : forall A B : prop , ~ (A -> B) -> A /\ ~ B.
Axiom R_lub_exists : forall A : set , (exists a0 : set , a0 :e A) -> (forall a : set , a :e A -> a :e R) -> (exists u : set , u :e R /\ forall a : set , a :e A -> a :e R -> Rle a u) -> exists l : set , R_lub A l.
Axiom R_glb_exists : forall A : set , (exists a0 : set , a0 :e A) -> (forall a : set , a :e A -> a :e R) -> (exists l : set , l :e R /\ forall a : set , a :e A -> a :e R -> Rle l a) -> exists g : set , R_glb A g.
Axiom R_lub_approx_from_below : forall A l eps : set , R_lub A l -> eps :e R -> Rlt 0 eps -> exists a : set , a :e A /\ a :e R /\ Rlt (add_SNo l (minus_SNo eps)) a.
Axiom R_lub_ex_gt : forall A l a : set , R_lub A l -> (forall x : set , x :e A -> x :e R) -> a :e R -> Rlt a l -> exists x : set , x :e A /\ x :e R /\ Rlt a x.
Axiom interval_connected : connected_space R R_standard_topology.
Definition between_in_order : set -> set -> set -> set -> prop := fun Y u r v => (order_rel Y u r /\ order_rel Y r v) \/ (order_rel Y v r /\ order_rel Y r u) \/ r = u \/ r = v.
Axiom between_in_orderI_left : forall Y u r v : set , order_rel Y u r -> order_rel Y r v -> between_in_order Y u r v.
Axiom between_in_orderI_right : forall Y u r v : set , order_rel Y v r -> order_rel Y r u -> between_in_order Y u r v.
Axiom between_in_orderI_eq_left : forall Y u v : set , between_in_order Y u u v.
Axiom between_in_orderI_eq_right : forall Y u v : set , between_in_order Y u v v.
Axiom intermediate_value_theorem : forall X Tx Y f a b r : set , connected_space X Tx -> simply_ordered_set Y -> continuous_map X Tx Y (order_topology Y) f -> a :e X -> b :e X -> r :e Y -> between_in_order Y (apply_fun f a) r (apply_fun f b) -> exists c : set , c :e X /\ apply_fun f c = r.
Axiom connected_subsets_real_are_intervals : forall A : set , A c= R -> connected_space A (subspace_topology R R_standard_topology A) -> forall x y z : set , x :e A -> y :e A -> z :e R -> (Rlt x z /\ Rlt z y \/ Rlt y z /\ Rlt z x) -> z :e A.
Axiom image_of_id_const_is_slice : forall X y0 : set , image_of (pair_map X {(x,x)|x :e X} (const_fun X y0)) X = setprod X {y0}.
Axiom slice_X_connected : forall X Tx Y Ty y0 : set , connected_space X Tx -> topology_on Y Ty -> y0 :e Y -> connected_space (setprod X {y0}) (subspace_topology (setprod X Y) (product_topology X Tx Y Ty) (setprod X {y0})).
Axiom image_of_const_id_is_slice : forall Y x0 : set , image_of (pair_map Y (const_fun Y x0) {(y,y)|y :e Y}) Y = setprod {x0} Y.
Axiom homeomorphism_const_id_slice : forall X Tx Y Ty x0 : set , topology_on X Tx -> topology_on Y Ty -> x0 :e X -> homeomorphism Y Ty (setprod {x0} Y) (subspace_topology (setprod X Y) (product_topology X Tx Y Ty) (setprod {x0} Y)) (pair_map Y (const_fun Y x0) {(y,y)|y :e Y}).
Axiom slice_Y_connected : forall X Tx Y Ty x0 : set , connected_space Y Ty -> topology_on X Tx -> x0 :e X -> connected_space (setprod {x0} Y) (subspace_topology (setprod X Y) (product_topology X Tx Y Ty) (setprod {x0} Y)).
Axiom finite_product_connected : forall X Tx Y Ty : set , connected_space X Tx -> connected_space Y Ty -> connected_space (setprod X Y) (product_topology X Tx Y Ty).
Axiom total_function_on_graph : forall A Y : set , forall g : set -> set , (forall a : set , a :e A -> g a :e Y) -> total_function_on (graph A g) A Y.
Axiom graph_in_total_function_space : forall A Y : set , forall g : set -> set , (forall a : set , a :e A -> g a :e Y) -> (graph A g) :e total_function_space A Y.
Axiom graph_extensional : forall A : set , forall g h : set -> set , (forall a : set , a :e A -> g a = h a) -> graph A g = graph A h.
Axiom graph_Subq_of_domain_Subq_and_agree : forall B C : set , forall f g : set -> set , B c= C -> (forall b : set , b :e B -> f b = g b) -> graph B f c= graph C g.
Axiom inj_apply_fun_graph : forall B Y : set , forall f : set -> set , inj B Y f -> inj B Y (fun b : set => apply_fun (graph B f) b).
Axiom box_basis_is_basis_on : forall I Xi : set , (forall i : set , i :e I -> topology_on (space_family_set Xi i) (space_family_topology Xi i)) -> basis_on (product_space I Xi) (box_basis I Xi).
Axiom box_topology_is_topology_on : forall I Xi : set , (forall i : set , i :e I -> topology_on (space_family_set Xi i) (space_family_topology Xi i)) -> topology_on (product_space I Xi) (box_topology I Xi).
Definition R_omega_space : set := product_space omega (const_space_family omega R R_standard_topology).
Definition R_omega_box_topology : set := box_topology omega (const_space_family omega R R_standard_topology).
Definition R_omega_product_topology : set := product_topology_full omega (const_space_family omega R R_standard_topology).
Definition bounded_sequence_Romega : set -> prop := fun f => exists M : set , M :e R /\ forall n : set , n :e omega -> apply_fun f n :e open_interval (minus_SNo M) M.
Definition bounded_sequences_Romega : set := {f :e R_omega_space|bounded_sequence_Romega f}.
Definition unbounded_sequence_Romega : set -> prop := fun f => forall M : set , M :e R -> exists n : set , n :e omega /\ ~ (apply_fun f n :e open_interval (minus_SNo M) M).
Definition unbounded_sequences_Romega : set := {f :e R_omega_space|unbounded_sequence_Romega f}.
Axiom Romega_coord_in_R : forall f i : set , f :e R_omega_space -> i :e omega -> apply_fun f i :e R.
Axiom bounded_sequences_Romega_in_Power : bounded_sequences_Romega :e Power R_omega_space.
Axiom unbounded_sequences_Romega_in_Power : unbounded_sequences_Romega :e Power R_omega_space.
Axiom bounded_sequences_in_Romega_box_topology : bounded_sequences_Romega :e R_omega_box_topology.
Axiom unbounded_sequences_in_Romega_box_topology : unbounded_sequences_Romega :e R_omega_box_topology.
Axiom bounded_unbounded_disjoint_Romega : bounded_sequences_Romega :/\: unbounded_sequences_Romega = Empty.
Axiom bounded_union_unbounded_Romega : bounded_sequences_Romega :\/: unbounded_sequences_Romega = R_omega_space.
Axiom bounded_sequences_Romega_nonempty : bounded_sequences_Romega <> Empty.
Axiom unbounded_sequences_Romega_nonempty : unbounded_sequences_Romega <> Empty.
Axiom bounded_unbounded_separation_Romega : separation_of R_omega_space bounded_sequences_Romega unbounded_sequences_Romega.
Axiom R_omega_box_not_connected : ~ connected_space (product_space omega (const_space_family omega R R_standard_topology)) (box_topology omega (const_space_family omega R R_standard_topology)).
Definition Romega_tilde : set -> set := fun n => {f :e R_omega_space|forall i : set , i :e omega -> n :e i -> apply_fun f i = 0}.
Definition Romega_infty : set := Union {Romega_tilde n|n :e omega}.
Axiom Romega_tilde_sub_Romega : forall n : set , Romega_tilde n c= R_omega_space.
Axiom Romega_infty_sub_Romega : Romega_infty c= R_omega_space.
Definition Romega_zero : set := const_fun omega 0.
Axiom Romega_zero_in_Romega_space : Romega_zero :e R_omega_space.
Axiom Romega_zero_in_Romega_tilde : forall n : set , n :e omega -> Romega_zero :e Romega_tilde n.
Axiom Romega_tilde_nonempty : forall n : set , n :e omega -> Romega_tilde n <> Empty.
Axiom Romega_product_topology_is_topology : topology_on R_omega_space R_omega_product_topology.
Axiom Romega_product_topology_sub_Romega_box_topology : R_omega_product_topology c= R_omega_box_topology.
Axiom Romega_tilde_subspace_product_subspace_box : forall n : set , n :e omega -> subspace_topology R_omega_space R_omega_product_topology (Romega_tilde n) c= subspace_topology R_omega_space R_omega_box_topology (Romega_tilde n).
Axiom dense_in_meets_nonempty_open : forall A X Tx U : set , topology_on X Tx -> closure_of X Tx A = X -> U :e Tx -> U <> Empty -> U :/\: A <> Empty.
Axiom connected_space_if_dense_connected_subset : forall X Tx A : set , topology_on X Tx -> A c= X -> connected_space A (subspace_topology X Tx A) -> closure_of X Tx A = X -> connected_space X Tx.
Axiom graph_omega_in_Romega_space : forall h : set -> set , (forall i : set , i :e omega -> h i :e R) -> graph omega h :e R_omega_space.
Definition Romega_singleton_seq : set -> set := fun r => graph omega (fun i : set => If_i (0 :e i) 0 r).
Axiom Romega_singleton_seq_in_Romega_space : forall r : set , r :e R -> Romega_singleton_seq r :e R_omega_space.
Axiom Romega_singleton_seq_apply : forall r i : set , r :e R -> i :e omega -> apply_fun (Romega_singleton_seq r) i = If_i (0 :e i) 0 r.
Axiom Romega_singleton_seq_in_Romega_tilde0 : forall r : set , r :e R -> Romega_singleton_seq r :e Romega_tilde 0.
Definition Romega_singleton_map : set := graph R Romega_singleton_seq.
Axiom Romega_singleton_map_apply : forall r : set , r :e R -> apply_fun Romega_singleton_map r = Romega_singleton_seq r.
Axiom Romega_singleton_map_function_on : function_on Romega_singleton_map R R_omega_space.
Axiom Romega_singleton_map_continuous_prod : continuous_map R R_standard_topology R_omega_space R_omega_product_topology Romega_singleton_map.
Axiom image_of_Romega_singleton_map_sub_Romega_tilde0 : image_of Romega_singleton_map R c= Romega_tilde 0.
Definition Romega_extend_seq : set -> set -> set := fun k p => graph omega (fun i : set => If_i (ordsucc k :e i) 0 (If_i (i = ordsucc k) (p 1) (apply_fun (p 0) i))).
Axiom Romega_extend_seq_apply : forall k p i : set , i :e omega -> apply_fun (Romega_extend_seq k p) i = If_i (ordsucc k :e i) 0 (If_i (i = ordsucc k) (p 1) (apply_fun (p 0) i)).
Axiom Romega_extend_seq_in_Romega_tilde_succ : forall k p : set , k :e omega -> p :e setprod (Romega_tilde k) R -> Romega_extend_seq k p :e Romega_tilde (ordsucc k).
Definition Romega_extend_map : set -> set := fun k => graph (setprod (Romega_tilde k) R) (fun p : set => Romega_extend_seq k p).
Axiom Romega_extend_map_apply : forall k p : set , k :e omega -> p :e setprod (Romega_tilde k) R -> apply_fun (Romega_extend_map k) p = Romega_extend_seq k p.
Axiom Romega_extend_map_function_on : forall k : set , k :e omega -> function_on (Romega_extend_map k) (setprod (Romega_tilde k) R) R_omega_space.
Axiom Romega_extend_map_function_on_tilde_succ : forall k : set , k :e omega -> function_on (Romega_extend_map k) (setprod (Romega_tilde k) R) (Romega_tilde (ordsucc k)).
Axiom image_of_Romega_extend_map_sub_Romega_tilde_succ : forall k : set , k :e omega -> image_of (Romega_extend_map k) (setprod (Romega_tilde k) R) c= Romega_tilde (ordsucc k).
Axiom Romega_extend_map_continuous_in_Romega_product : forall k : set , k :e omega -> continuous_map (setprod (Romega_tilde k) R) (product_topology (Romega_tilde k) (subspace_topology R_omega_space R_omega_product_topology (Romega_tilde k)) R R_standard_topology) R_omega_space R_omega_product_topology (Romega_extend_map k).
Axiom Romega_extend_map_continuous_to_Romega_tilde_succ : forall k : set , k :e omega -> continuous_map (setprod (Romega_tilde k) R) (product_topology (Romega_tilde k) (subspace_topology R_omega_space R_omega_product_topology (Romega_tilde k)) R R_standard_topology) (Romega_tilde (ordsucc k)) (subspace_topology R_omega_space R_omega_product_topology (Romega_tilde (ordsucc k))) (Romega_extend_map k).
Definition Romega_restrict_seq : set -> set -> set := fun k f => graph omega (fun i : set => If_i (k :e i) 0 (apply_fun f i)).
Axiom Romega_restrict_seq_apply : forall k f i : set , k :e omega -> f :e R_omega_space -> i :e omega -> apply_fun (Romega_restrict_seq k f) i = If_i (k :e i) 0 (apply_fun f i).
Axiom Romega_restrict_seq_in_Romega_tilde : forall k f : set , k :e omega -> f :e R_omega_space -> Romega_restrict_seq k f :e Romega_tilde k.
Definition Romega_coord_map : set -> set := fun i => graph R_omega_space (fun f : set => apply_fun f i).
Axiom Romega_coord_map_apply : forall i f : set , i :e omega -> f :e R_omega_space -> apply_fun (Romega_coord_map i) f = apply_fun f i.
Axiom Romega_coord_map_function_on : forall i : set , i :e omega -> function_on (Romega_coord_map i) R_omega_space R.
Axiom Romega_product_subbasis_on : subbasis_on R_omega_space (product_subbasis_full omega (const_space_family omega R R_standard_topology)).
Axiom Romega_coord_map_continuous_in_Romega_product : forall i : set , i :e omega -> continuous_map R_omega_space R_omega_product_topology R R_standard_topology (Romega_coord_map i).
Axiom Romega_coord_map_continuous_in_Romega_box : forall i : set , i :e omega -> continuous_map R_omega_space R_omega_box_topology R R_standard_topology (Romega_coord_map i).
Definition Romega_restrict_map : set -> set := fun k => graph R_omega_space (fun f : set => Romega_restrict_seq k f).
Axiom Romega_restrict_map_apply : forall k f : set , k :e omega -> f :e R_omega_space -> apply_fun (Romega_restrict_map k) f = Romega_restrict_seq k f.
Axiom Romega_restrict_map_function_on : forall k : set , k :e omega -> function_on (Romega_restrict_map k) R_omega_space R_omega_space.
Axiom Romega_restrict_map_continuous_in_Romega_product : forall k : set , k :e omega -> continuous_map R_omega_space R_omega_product_topology R_omega_space R_omega_product_topology (Romega_restrict_map k).
Definition Romega_split_map : set -> set := fun k => graph (Romega_tilde (ordsucc k)) (fun f : set => (Romega_restrict_seq k f,apply_fun f (ordsucc k))).
Axiom Romega_split_map_apply : forall k f : set , k :e omega -> f :e Romega_tilde (ordsucc k) -> apply_fun (Romega_split_map k) f = (Romega_restrict_seq k f,apply_fun f (ordsucc k)).
Axiom Romega_split_map_function_on : forall k : set , k :e omega -> function_on (Romega_split_map k) (Romega_tilde (ordsucc k)) (setprod (Romega_tilde k) R).
Axiom Romega_split_map_continuous : forall k : set , k :e omega -> continuous_map (Romega_tilde (ordsucc k)) (subspace_topology R_omega_space R_omega_product_topology (Romega_tilde (ordsucc k))) (setprod (Romega_tilde k) R) (product_topology (Romega_tilde k) (subspace_topology R_omega_space R_omega_product_topology (Romega_tilde k)) R R_standard_topology) (Romega_split_map k).
Axiom R_omega_space_ext : forall f g : set , f :e R_omega_space -> g :e R_omega_space -> (forall i : set , i :e omega -> apply_fun f i = apply_fun g i) -> f = g.
Axiom Romega_tilde_succ_homeomorphism : forall k : set , k :e omega -> homeomorphism (setprod (Romega_tilde k) R) (product_topology (Romega_tilde k) (subspace_topology R_omega_space R_omega_product_topology (Romega_tilde k)) R R_standard_topology) (Romega_tilde (ordsucc k)) (subspace_topology R_omega_space R_omega_product_topology (Romega_tilde (ordsucc k))) (Romega_extend_map k).
Axiom finite_subset_of_omega_bounded : forall F : set , F c= omega -> finite F -> exists n :e omega , forall m :e F , m :e n.
Axiom Romega_infty_eq_finite_support : Romega_infty = {f :e R_omega_space|exists F : set , finite F /\ forall i : set , i :e omega :\: F -> apply_fun f i = 0}.
Axiom Romega_product_cylinder_open : forall i U : set , i :e omega -> U :e space_family_topology (const_space_family omega R R_standard_topology) i -> product_cylinder omega (const_space_family omega R R_standard_topology) i U :e R_omega_product_topology.
Axiom Romega_box_basis_cap_Romega_tilde_in_product_subspace : forall n b : set , n :e omega -> b :e box_basis omega (const_space_family omega R R_standard_topology) -> (b :/\: Romega_tilde n) :e subspace_topology R_omega_space R_omega_product_topology (Romega_tilde n).
Axiom Romega_tilde_subspace_box_subspace_product : forall n : set , n :e omega -> subspace_topology R_omega_space R_omega_box_topology (Romega_tilde n) c= subspace_topology R_omega_space R_omega_product_topology (Romega_tilde n).
Axiom Romega_tilde_subspace_box_eq_product : forall n : set , n :e omega -> subspace_topology R_omega_space R_omega_box_topology (Romega_tilde n) = subspace_topology R_omega_space R_omega_product_topology (Romega_tilde n).
Axiom Romega_infty_closed_in_Romega_box_topology : closed_in R_omega_space R_omega_box_topology Romega_infty.
Axiom Romega_infty_meets_product_basis : forall b x : set , b :e basis_of_subbasis R_omega_space (product_subbasis_full omega (const_space_family omega R R_standard_topology)) -> x :e b -> b :/\: Romega_infty <> Empty.
Axiom Romega_tilde0_meets_product_basis : forall b x : set , b :e basis_of_subbasis R_omega_space (product_subbasis_full omega (const_space_family omega R R_standard_topology)) -> x :e Romega_tilde 0 -> x :e b -> b :/\: image_of Romega_singleton_map R <> Empty.
Axiom Romega_tilde0_singletons_dense_in_subspace : closure_of (Romega_tilde 0) (subspace_topology R_omega_space R_omega_product_topology (Romega_tilde 0)) (image_of Romega_singleton_map R) = Romega_tilde 0.
Axiom Romega_tilde0_connected : connected_space (Romega_tilde 0) (subspace_topology R_omega_space R_omega_product_topology (Romega_tilde 0)).
Axiom Romega_tilde_connected : forall n : set , n :e omega -> connected_space (Romega_tilde n) (subspace_topology R_omega_space R_omega_product_topology (Romega_tilde n)).
Axiom Romega_infty_connected : connected_space Romega_infty (subspace_topology R_omega_space R_omega_product_topology Romega_infty).
Axiom Romega_infty_dense : closure_of R_omega_space R_omega_product_topology Romega_infty = R_omega_space.
Axiom R_omega_product_connected : connected_space (product_space omega (const_space_family omega R R_standard_topology)) (product_topology_full omega (const_space_family omega R R_standard_topology)).
Axiom Romega_tilde_connected_box : forall n : set , n :e omega -> connected_space (Romega_tilde n) (subspace_topology R_omega_space R_omega_box_topology (Romega_tilde n)).
Axiom Romega_infty_connected_box : connected_space Romega_infty (subspace_topology R_omega_space R_omega_box_topology Romega_infty).
Definition path_between : set -> set -> set -> set -> prop := fun X x y p => function_on p unit_interval X /\ apply_fun p 0 = x /\ apply_fun p 1 = y.
Definition path_connected_space : set -> set -> prop := fun X Tx => topology_on X Tx /\ forall x y : set , x :e X -> y :e X -> exists p : set , path_between X x y p /\ continuous_map unit_interval unit_interval_topology X Tx p.
Axiom path_between_pair0 : forall X x y p : set , path_between X x y p -> function_on p unit_interval X /\ apply_fun p 0 = x.
Axiom path_between_function_on : forall X x y p : set , path_between X x y p -> function_on p unit_interval X.
Axiom path_between_at_zero : forall X x y p : set , path_between X x y p -> apply_fun p 0 = x.
Axiom path_between_at_one : forall X x y p : set , path_between X x y p -> apply_fun p 1 = y.
Axiom path_betweenI : forall X x y p : set , function_on p unit_interval X -> apply_fun p 0 = x -> apply_fun p 1 = y -> path_between X x y p.
Axiom path_witness_between : forall X Tx x y p : set , (path_between X x y p /\ continuous_map unit_interval unit_interval_topology X Tx p) -> path_between X x y p.
Axiom path_witness_continuous : forall X Tx x y p : set , (path_between X x y p /\ continuous_map unit_interval unit_interval_topology X Tx p) -> continuous_map unit_interval unit_interval_topology X Tx p.
Axiom path_connected_space_topology : forall X Tx : set , path_connected_space X Tx -> topology_on X Tx.
Axiom path_connected_space_paths : forall X Tx x y : set , path_connected_space X Tx -> x :e X -> y :e X -> exists p : set , path_between X x y p /\ continuous_map unit_interval unit_interval_topology X Tx p.
Axiom unit_interval_connected : connected_space unit_interval unit_interval_topology.
Axiom zero_one_in_unit_interval : 0 :e unit_interval /\ 1 :e unit_interval.
Axiom path_between_exists : forall X x y : set , x :e X -> y :e X -> exists p : set , path_between X x y p.
Axiom separation_has_elements : forall X U V : set , separation_of X U V -> (exists x : set , x :e U) /\ (exists y : set , y :e V).
Axiom separation_subsets : forall X U V : set , separation_of X U V -> U c= X /\ V c= X.
Axiom subset_elem : forall A B x : set , A c= B -> x :e A -> x :e B.
Axiom path_connected_implies_connected : forall X Tx : set , path_connected_space X Tx -> connected_space X Tx.
Axiom continuous_image_path_connected : forall X Tx Y Ty f : set , path_connected_space X Tx -> continuous_map X Tx Y Ty f -> (forall y : set , y :e Y -> exists x : set , x :e X /\ apply_fun f x = y) -> path_connected_space Y Ty.
Definition path_component_of : set -> set -> set -> set := fun X Tx x => {y :e X|exists p : set , function_on p unit_interval X /\ continuous_map unit_interval unit_interval_topology X Tx p /\ apply_fun p 0 = x /\ apply_fun p 1 = y}.
Axiom path_component_symmetric_axiom : forall X Tx x y : set , topology_on X Tx -> x :e X -> y :e X -> y :e path_component_of X Tx x -> x :e path_component_of X Tx y.
Definition unit_interval_left_half : set := {t :e unit_interval|~ (Rlt (eps_ 1) t)}.
Definition unit_interval_right_half : set := {t :e unit_interval|~ (Rlt t (eps_ 1))}.
Axiom unit_interval_left_half_sub : unit_interval_left_half c= unit_interval.
Axiom unit_interval_right_half_sub : unit_interval_right_half c= unit_interval.
Axiom mul2_in_unit_interval_implies_unit_interval : forall u : set , u :e R -> mul_SNo 2 u :e unit_interval -> u :e unit_interval.
Axiom mul2_in_unit_interval_implies_left_half : forall u : set , u :e R -> mul_SNo 2 u :e unit_interval -> u :e unit_interval_left_half.
Definition double_map_left_half : set := graph unit_interval_left_half (fun t : set => mul_SNo 2 t).
Definition double_minus_one_map_right_half : set := graph unit_interval_right_half (fun t : set => add_SNo (mul_SNo 2 t) (minus_SNo 1)).
Axiom double_map_apply : forall t : set , t :e unit_interval_left_half -> apply_fun double_map_left_half t = mul_SNo 2 t.
Axiom double_minus_one_map_apply : forall t : set , t :e unit_interval_right_half -> apply_fun double_minus_one_map_right_half t = add_SNo (mul_SNo 2 t) (minus_SNo 1).
Axiom Rlt_mul2_left_iff : forall a t : set , a :e R -> t :e R -> (Rlt a (mul_SNo 2 t) <-> Rlt (mul_SNo (eps_ 1) a) t).
Axiom Rlt_mul2_right_iff : forall t b : set , t :e R -> b :e R -> (Rlt (mul_SNo 2 t) b <-> Rlt t (mul_SNo (eps_ 1) b)).
Axiom zero_in_unit_interval_left_half : 0 :e unit_interval_left_half.
Axiom eps_1_in_unit_interval_left_half : eps_ 1 :e unit_interval_left_half.
Axiom eps_1_in_unit_interval_right_half : eps_ 1 :e unit_interval_right_half.
Axiom one_in_unit_interval_right_half : 1 :e unit_interval_right_half.
Axiom double_map_at_0 : apply_fun double_map_left_half 0 = 0.
Axiom double_map_at_eps1 : apply_fun double_map_left_half (eps_ 1) = 1.
Axiom double_minus_one_map_at_eps1 : apply_fun double_minus_one_map_right_half (eps_ 1) = 0.
Axiom double_minus_one_map_at_1 : apply_fun double_minus_one_map_right_half 1 = 1.
Axiom unit_interval_halves_cover : unit_interval_left_half :\/: unit_interval_right_half = unit_interval.
Axiom unit_interval_halves_closed : closed_in unit_interval unit_interval_topology unit_interval_left_half /\ closed_in unit_interval unit_interval_topology unit_interval_right_half.
Axiom unit_interval_halves_intersection : (unit_interval_left_half :/\: unit_interval_right_half) = {eps_ 1}.
Axiom double_map_function_on : function_on double_map_left_half unit_interval_left_half unit_interval.
Axiom double_minus_one_map_function_on : function_on double_minus_one_map_right_half unit_interval_right_half unit_interval.
Axiom double_map_continuous : continuous_map unit_interval_left_half (subspace_topology unit_interval unit_interval_topology unit_interval_left_half) unit_interval unit_interval_topology double_map_left_half.
Axiom double_minus_one_map_continuous : continuous_map unit_interval_right_half (subspace_topology unit_interval unit_interval_topology unit_interval_right_half) unit_interval unit_interval_topology double_minus_one_map_right_half.
Axiom unit_interval_collapse_left_half_rescale_right_half_exists : exists phi : set , continuous_map unit_interval unit_interval_topology unit_interval unit_interval_topology phi /\ (forall t : set , t :e unit_interval_left_half -> apply_fun phi t = 0) /\ (forall t : set , t :e unit_interval_right_half -> apply_fun phi t = add_SNo (mul_SNo 2 t) (minus_SNo 1)).
Axiom path_component_transitive_axiom : forall X Tx x y z : set , topology_on X Tx -> x :e X -> y :e X -> z :e X -> y :e path_component_of X Tx x -> z :e path_component_of X Tx y -> z :e path_component_of X Tx x.
Axiom unit_interval_inclusion_continuous : continuous_map unit_interval unit_interval_topology R R_standard_topology {(t,t)|t :e unit_interval}.
Axiom subspace_path_connected_implies_in_path_component : forall X Tx V y z : set , topology_on X Tx -> V c= X -> path_connected_space V (subspace_topology X Tx V) -> y :e V -> z :e V -> z :e path_component_of X Tx y.
Axiom path_component_reflexive : forall X Tx x : set , topology_on X Tx -> x :e X -> x :e path_component_of X Tx x.
Axiom path_components_equivalence_relation : forall X Tx : set , topology_on X Tx -> (forall x : set , x :e X -> x :e path_component_of X Tx x) /\ (forall x y : set , x :e X -> y :e X -> y :e path_component_of X Tx x -> x :e path_component_of X Tx y) /\ (forall x y z : set , x :e X -> y :e X -> z :e X -> y :e path_component_of X Tx x -> z :e path_component_of X Tx y -> z :e path_component_of X Tx x).
Definition component_of : set -> set -> set -> set := fun X Tx x => {y :e X|exists C : set , connected_space C (subspace_topology X Tx C) /\ x :e C /\ y :e C}.
Definition locally_connected : set -> set -> prop := fun X Tx => topology_on X Tx /\ forall x : set , x :e X -> forall U : set , U :e Tx -> x :e U -> exists V : set , V :e Tx /\ x :e V /\ V c= U /\ connected_space V (subspace_topology X Tx V).
Axiom locally_connected_topology : forall X Tx : set , locally_connected X Tx -> topology_on X Tx.
Axiom locally_connected_local : forall X Tx x U : set , locally_connected X Tx -> x :e X -> U :e Tx -> x :e U -> exists V : set , V :e Tx /\ x :e V /\ V c= U /\ connected_space V (subspace_topology X Tx V).
Axiom open_subspace_locally_connected : forall X Tx Y : set , locally_connected X Tx -> Y :e Tx -> locally_connected Y (subspace_topology X Tx Y).
Definition locally_path_connected : set -> set -> prop := fun X Tx => topology_on X Tx /\ forall x : set , x :e X -> forall U : set , U :e Tx -> x :e U -> exists V : set , V :e Tx /\ x :e V /\ V c= U /\ path_connected_space V (subspace_topology X Tx V).
Axiom locally_path_connected_topology : forall X Tx : set , locally_path_connected X Tx -> topology_on X Tx.
Axiom locally_path_connected_local : forall X Tx x U : set , locally_path_connected X Tx -> x :e X -> U :e Tx -> x :e U -> exists V : set , V :e Tx /\ x :e V /\ V c= U /\ path_connected_space V (subspace_topology X Tx V).
Axiom singleton_subspace_connected : forall X Tx x : set , topology_on X Tx -> x :e X -> connected_space {x} (subspace_topology X Tx {x}).
Axiom point_in_component : forall X Tx x : set , topology_on X Tx -> x :e X -> x :e component_of X Tx x.
Axiom connected_subspace_subset : forall X Tx C : set , topology_on X Tx -> connected_space C (subspace_topology X Tx C) -> C c= X.
Axiom component_of_connected : forall X Tx x : set , topology_on X Tx -> x :e X -> connected_space (component_of X Tx x) (subspace_topology X Tx (component_of X Tx x)).
Axiom component_of_eq_if_in : forall X Tx x y : set , topology_on X Tx -> x :e X -> y :e component_of X Tx x -> component_of X Tx y = component_of X Tx x.
Axiom component_of_whole : forall X Tx x : set , connected_space X Tx -> x :e X -> component_of X Tx x = X.
Axiom path_component_of_whole : forall X Tx x : set , path_connected_space X Tx -> x :e X -> path_component_of X Tx x = X.
Definition pairwise_disjoint : set -> prop := fun Fam => forall U V : set , U :e Fam -> V :e Fam -> U <> V -> U :/\: V = Empty.
Definition covers : set -> set -> prop := fun X U => forall x : set , x :e X -> exists u : set , u :e U /\ x :e u.
Axiom Subq_Union_implies_covers : forall X Fam : set , X c= Union Fam -> covers X Fam.
Axiom covers_implies_Subq_Union : forall X Fam : set , covers X Fam -> X c= Union Fam.
Axiom path_components_open : forall X Tx : set , locally_path_connected X Tx -> forall x : set , x :e X -> open_in X Tx (path_component_of X Tx x).
Axiom components_equal_path_components : forall X Tx : set , locally_path_connected X Tx -> forall x : set , x :e X -> path_component_of X Tx x = component_of X Tx x.
Axiom components_are_closed : forall X Tx : set , topology_on X Tx -> forall x : set , x :e X -> closed_in X Tx (component_of X Tx x).
Axiom components_are_open_in_locally_connected : forall X Tx : set , locally_connected X Tx -> forall x : set , x :e X -> open_in X Tx (component_of X Tx x).
Axiom components_partition_space : forall X Tx : set , topology_on X Tx -> covers X {component_of X Tx x|x :e X} /\ pairwise_disjoint {component_of X Tx x|x :e X}.
Axiom quotient_preserves_local_connectedness : forall X Tx Y f : set , quotient_map X Tx Y f -> locally_connected X Tx -> locally_connected Y (quotient_topology X Tx Y f).
Definition quasicomponent_of : set -> set -> set -> set := fun X Tx x => {y :e X|forall U : set , open_in X Tx U -> closed_in X Tx U -> x :e U -> y :e U}.
Axiom components_vs_quasicomponents : forall X Tx : set , topology_on X Tx -> (forall x : set , component_of X Tx x c= quasicomponent_of X Tx x) /\ (locally_connected X Tx -> forall x : set , x :e X -> component_of X Tx x = quasicomponent_of X Tx x).
Axiom right_closed_ray_in_R_lower_limit_topology : forall a : set , a :e R -> {x :e R|~ (Rlt x a)} :e R_lower_limit_topology.
Axiom halfopen_interval_left_complement_eq_rays : forall a b : set , a :e R -> b :e R -> R :\: (halfopen_interval_left a b) = {x :e R|Rlt x a} :\/: {x :e R|~ (Rlt x b)}.
Axiom complement_halfopen_interval_left_in_R_lower_limit_topology : forall a b : set , a :e R -> b :e R -> (R :\: halfopen_interval_left a b) :e R_lower_limit_topology.
Axiom ex23_Rl_components : component_of R R_lower_limit_topology 0 = {0} /\ (forall x : set , x :e R -> component_of R R_lower_limit_topology x = {x}).
Axiom component_of_Romega_box_zero_finite_support_from_connected : forall f : set , f :e product_space omega (const_space_family omega R R_standard_topology) -> (exists C : set , connected_space C (subspace_topology (product_space omega (const_space_family omega R R_standard_topology)) (box_topology omega (const_space_family omega R R_standard_topology)) C) /\ const_family omega 0 :e C /\ f :e C) -> exists F : set , finite F /\ forall i : set , i :e omega :\: F -> apply_fun f i = 0.
Axiom component_of_Romega_box_zero_subset_Romega_infty : forall f : set , f :e component_of (product_space omega (const_space_family omega R R_standard_topology)) (box_topology omega (const_space_family omega R R_standard_topology)) (const_family omega 0) -> f :e Romega_infty.
Axiom component_of_Romega_box_zero_subset_Romega_infty_sketch : forall f : set , f :e component_of (product_space omega (const_space_family omega R R_standard_topology)) (box_topology omega (const_space_family omega R R_standard_topology)) (const_family omega 0) -> f :e Romega_infty.
Axiom ex23_Romega_components : component_of (product_space omega (const_space_family omega R R_standard_topology)) (product_topology_full omega (const_space_family omega R R_standard_topology)) (const_family omega 0) = product_space omega (const_space_family omega R R_standard_topology) /\ component_of (product_space omega (const_space_family omega R R_standard_topology)) (box_topology omega (const_space_family omega R R_standard_topology)) (const_family omega 0) = {f :e product_space omega (const_space_family omega R R_standard_topology)|exists F : set , finite F /\ forall i : set , i :e omega :\: F -> apply_fun f i = 0}.
Axiom ordered_square_locally_connected : locally_connected ordered_square ordered_square_topology.
Axiom ordered_square_locally_connected_sketch : locally_connected ordered_square ordered_square_topology.
Axiom ordered_square_not_locally_path_connected : ~ locally_path_connected ordered_square ordered_square_topology.
Axiom ordered_square_not_locally_path_connected_sketch : ~ locally_path_connected ordered_square ordered_square_topology.
Axiom ex23_ordered_square_locally_conn_not_pathconn : locally_connected ordered_square ordered_square_topology /\ ~ locally_path_connected ordered_square ordered_square_topology.
Axiom ex23_connected_open_sets_path_connected : forall X Tx U : set , locally_path_connected X Tx -> open_in X Tx U -> connected_space U (subspace_topology X Tx U) -> path_connected_space U (subspace_topology X Tx U).
Axiom path_connected_not_locally_connected_subset_of_plane_exists : exists A : set , A c= EuclidPlane /\ path_connected_space A (subspace_topology EuclidPlane R2_standard_topology A) /\ ~ locally_connected A (subspace_topology EuclidPlane R2_standard_topology A).
Axiom path_connected_not_locally_connected_subset_of_plane_exists_sketch : exists A : set , A c= EuclidPlane /\ path_connected_space A (subspace_topology EuclidPlane R2_standard_topology A) /\ ~ locally_connected A (subspace_topology EuclidPlane R2_standard_topology A).
Axiom ex23_path_connected_not_locally_connected_examples : exists A : set , A c= EuclidPlane /\ path_connected_space A (subspace_topology EuclidPlane R2_standard_topology A) /\ ~ locally_connected A (subspace_topology EuclidPlane R2_standard_topology A).
Definition open_cover_of : set -> set -> set -> prop := fun X Tx Fam => topology_on X Tx /\ Fam c= Power X /\ X c= Union Fam /\ (forall U : set , U :e Fam -> U :e Tx).
Axiom open_cover_ofI : forall X Tx Fam : set , topology_on X Tx -> Fam c= Power X -> X c= Union Fam -> (forall U : set , U :e Fam -> U :e Tx) -> open_cover_of X Tx Fam.
Axiom open_cover_of_topology : forall X Tx Fam : set , open_cover_of X Tx Fam -> topology_on X Tx.
Axiom open_cover_of_family_sub : forall X Tx Fam : set , open_cover_of X Tx Fam -> Fam c= Power X.
Axiom open_cover_of_covers : forall X Tx Fam : set , open_cover_of X Tx Fam -> X c= Union Fam.
Axiom open_cover_of_implies_covers : forall X Tx Fam : set , open_cover_of X Tx Fam -> covers X Fam.
Axiom open_cover_of_members_open : forall X Tx Fam U : set , open_cover_of X Tx Fam -> U :e Fam -> U :e Tx.
Axiom open_cover_of_union_eq : forall X Tx Fam : set , open_cover_of X Tx Fam -> Union Fam = X.
Axiom open_cover_of_members_open_in : forall X Tx Fam U : set , open_cover_of X Tx Fam -> U :e Fam -> open_in X Tx U.
Definition restrict_family_to_subspace : set -> set -> set := fun Fam Y => {U :/\: Y|U :e Fam}.
Axiom restrict_family_to_subspace_subset_Power : forall Fam Y : set , restrict_family_to_subspace Fam Y c= Power Y.
Axiom open_cover_of_restrict_to_subspace : forall X Tx Fam Y : set , open_cover_of X Tx Fam -> Y c= X -> open_cover_of Y (subspace_topology X Tx Y) (restrict_family_to_subspace Fam Y).
Definition has_finite_subcover : set -> set -> set -> prop := fun X Tx Fam => exists G : set , G c= Fam /\ finite G /\ X c= Union G.
Axiom has_finite_subcoverI : forall X Tx Fam G : set , G c= Fam /\ finite G /\ X c= Union G -> has_finite_subcover X Tx Fam.
Definition compact_space : set -> set -> prop := fun X Tx => topology_on X Tx /\ forall Fam : set , open_cover_of X Tx Fam -> has_finite_subcover X Tx Fam.
Axiom compact_space_topology : forall X Tx : set , compact_space X Tx -> topology_on X Tx.
Axiom compact_space_subcover_property : forall X Tx : set , compact_space X Tx -> forall Fam : set , open_cover_of X Tx Fam -> has_finite_subcover X Tx Fam.
Axiom compact_space_singleton : forall X Tx a : set , X = {a} -> topology_on X Tx -> compact_space X Tx.
Axiom Heine_Borel_subcover : forall X Tx Fam : set , compact_space X Tx -> open_cover_of X Tx Fam -> has_finite_subcover X Tx Fam.
Axiom compact_subspace_via_ambient_covers : forall X Tx Y : set , topology_on X Tx -> Y c= X -> (compact_space Y (subspace_topology X Tx Y) <-> forall Fam : set , (Fam c= Tx /\ Y c= Union Fam) -> has_finite_subcover Y Tx Fam).
Axiom closed_subspace_compact : forall X Tx Y : set , compact_space X Tx -> closed_in X Tx Y -> compact_space Y (subspace_topology X Tx Y).
Axiom Hausdorff_separate_point_compact_set_aux : forall X Tx Y x : set , Hausdorff_space X Tx -> Y c= X -> compact_space Y (subspace_topology X Tx Y) -> x :e X -> x /:e Y -> exists U V : set , U :e Tx /\ V :e Tx /\ x :e U /\ Y c= V /\ U :/\: V = Empty.
Axiom compact_subspace_in_Hausdorff_closed : forall X Tx Y : set , Hausdorff_space X Tx -> Y c= X -> compact_space Y (subspace_topology X Tx Y) -> closed_in X Tx Y.
Axiom Hausdorff_separate_point_compact_set : forall X Tx Y x : set , Hausdorff_space X Tx -> Y c= X -> compact_space Y (subspace_topology X Tx Y) -> x :e X -> x /:e Y -> exists U V : set , U :e Tx /\ V :e Tx /\ x :e U /\ Y c= V /\ U :/\: V = Empty.
Definition image_of_fun : set -> set -> set := fun f X => image_of f X.
Axiom continuous_image_compact : forall X Tx Y Ty f : set , compact_space X Tx -> continuous_map X Tx Y Ty f -> compact_space (image_of_fun f X) (subspace_topology Y Ty (image_of_fun f X)).
Axiom tube_lemma : forall X Tx Y Ty : set , topology_on X Tx -> topology_on Y Ty -> compact_space Y Ty -> forall x0 : set , x0 :e X -> forall N : set , N :e product_topology X Tx Y Ty /\ setprod {x0} Y c= N -> exists U : set , U :e Tx /\ x0 :e U /\ setprod U Y c= N.
Definition bijection : set -> set -> set -> prop := fun X Y f => function_on f X Y /\ (forall y : set , y :e Y -> exists x : set , x :e X /\ apply_fun f x = y /\ (forall x' : set , x' :e X -> apply_fun f x' = y -> x' = x)).
Axiom equip_of_bijection : forall X Y f : set , bijection X Y f -> equip X Y.
Axiom bijection_graph_of_bij : forall X Y : set , forall g : set -> set , bij X Y g -> bijection X Y (graph X g).
Axiom bijection_compose_fun : forall X Y Z f g : set , bijection X Y f -> bijection Y Z g -> bijection X Z (compose_fun X f g).
Definition inv_fun_graph : set -> set -> set -> set := fun X f Y => {(y,inv X (fun x : set => apply_fun f x) y)|y :e Y}.
Axiom inv_fun_graph_apply : forall X Y f y : set , y :e Y -> apply_fun (inv_fun_graph X f Y) y = inv X (fun x : set => apply_fun f x) y.
Axiom bijection_surj : forall X Y f y : set , bijection X Y f -> y :e Y -> exists x : set , x :e X /\ apply_fun f x = y.
Axiom bijection_inj : forall X Y f u v : set , bijection X Y f -> u :e X -> v :e X -> apply_fun f u = apply_fun f v -> u = v.
Axiom bijection_drop_last : forall m F e : set , m :e omega -> bijection (ordsucc m) F e -> bijection m (F :\: {apply_fun e m}) e.
Axiom inv_fun_graph_right_inverse : forall X Y f y : set , bijection X Y f -> y :e Y -> apply_fun f (apply_fun (inv_fun_graph X f Y) y) = y.
Axiom inv_fun_graph_left_inverse : forall X Y f x : set , bijection X Y f -> x :e X -> apply_fun (inv_fun_graph X f Y) (apply_fun f x) = x.
Axiom inv_fun_graph_preimage_eq_image : forall X Y f A : set , bijection X Y f -> A c= X -> preimage_of Y (inv_fun_graph X f Y) A = image_of_fun f A.
Definition Abs : set -> set := abs_SNo.
Axiom compact_to_Hausdorff_inverse_continuous : forall X Tx Y Ty f : set , compact_space X Tx -> Hausdorff_space Y Ty -> continuous_map X Tx Y Ty f -> bijection X Y f -> continuous_map Y Ty X Tx (inv_fun_graph X f Y).
Axiom compact_to_Hausdorff_bijection_homeomorphism : forall X Tx Y Ty f : set , compact_space X Tx -> Hausdorff_space Y Ty -> continuous_map X Tx Y Ty f -> bijection X Y f -> homeomorphism X Tx Y Ty f.
Definition bounded_subset_of_reals : set -> prop := fun A => exists M : set , M :e R /\ forall x : set , x :e A -> ~ (Rlt M (Abs x)).
Axiom omega_in_R : forall n : set , n :e omega -> n :e R.
Axiom ordsucc_in_R : forall n : set , n :e omega -> ordsucc n :e R.
Axiom interval_bounds_Abs : forall M x : set , M :e R -> x :e R -> Rlt (minus_SNo M) x -> Rlt x M -> ~ (Rlt M (Abs x)).
Axiom finite_product_compact : forall X Tx Y Ty : set , compact_space X Tx -> compact_space Y Ty -> compact_space (setprod X Y) (product_topology X Tx Y Ty).
Axiom unit_interval_has_finite_subcover : forall Fam : set , open_cover_of unit_interval unit_interval_topology Fam -> has_finite_subcover unit_interval unit_interval_topology Fam.
Axiom unit_interval_compact_axiom : compact_space unit_interval unit_interval_topology.
Axiom ex26_compactness_exercises : (closed_in R R_standard_topology unit_interval) /\ (compact_space unit_interval unit_interval_topology).
Axiom ex27_5_compact_Hausdorff_countable_union_empty_interior : forall X Tx : set , forall An : set -> set , compact_space X Tx -> Hausdorff_space X Tx -> (forall n : set , n :e omega -> closed_in X Tx (An n) /\ interior_of X Tx (An n) = Empty) -> interior_of X Tx (Union {An n|n :e omega}) = Empty.
Axiom Heine_Borel_closed_bounded : forall A : set , A c= R -> compact_space A (subspace_topology R R_standard_topology A) -> closed_in R R_standard_topology A /\ bounded_subset_of_reals A.
Axiom compact_real_closed_bounded : forall A : set , compact_space A (subspace_topology R R_standard_topology A) -> closed_in R R_standard_topology A /\ bounded_subset_of_reals A.
Definition limit_point_compact : set -> set -> prop := fun X Tx => topology_on X Tx /\ forall A : set , A c= X -> infinite A -> exists x : set , limit_point_of X Tx A x.
Axiom limit_point_compact_topology : forall X Tx : set , limit_point_compact X Tx -> topology_on X Tx.
Axiom limit_point_compact_property : forall X Tx A : set , limit_point_compact X Tx -> A c= X -> infinite A -> exists x : set , limit_point_of X Tx A x.
Axiom compact_implies_limit_point_compact : forall X Tx : set , compact_space X Tx -> limit_point_compact X Tx.
Axiom limit_point_compact_not_necessarily_compact : exists X Tx : set , limit_point_compact X Tx /\ ~ compact_space X Tx.
Definition locally_compact : set -> set -> prop := fun X Tx => topology_on X Tx /\ forall x : set , x :e X -> exists C : set , C c= X /\ compact_space C (subspace_topology X Tx C) /\ exists U : set , U :e Tx /\ x :e U /\ U c= C.
Axiom locally_compact_topology : forall X Tx : set , locally_compact X Tx -> topology_on X Tx.
Axiom locally_compact_local : forall X Tx x : set , locally_compact X Tx -> x :e X -> exists C : set , C c= X /\ compact_space C (subspace_topology X Tx C) /\ exists U : set , U :e Tx /\ x :e U /\ U c= C.
Axiom product_locally_compact : forall X Tx Y Ty : set , locally_compact X Tx -> locally_compact Y Ty -> locally_compact (setprod X Y) (product_topology X Tx Y Ty).
Axiom Hausdorff_compact_sets_closed : forall X Tx A : set , Hausdorff_space X Tx -> A c= X -> compact_space A (subspace_topology X Tx A) -> closed_in X Tx A.
Axiom compact_empty_subspace : forall X Tx : set , topology_on X Tx -> compact_space Empty (subspace_topology X Tx Empty).
Definition one_point_compactification : set -> set -> set -> set -> prop := fun X Tx Y Ty => compact_space Y Ty /\ Hausdorff_space Y Ty /\ X c= Y /\ exists p : set , p :e Y /\ ~ p :e X /\ subspace_topology Y Ty X = Tx /\ (forall y : set , y :e Y -> y :e X \/ y = p).
Axiom one_point_compactification_exists : forall X Tx : set , locally_compact X Tx -> Hausdorff_space X Tx -> exists Y Ty : set , one_point_compactification X Tx Y Ty.
Axiom ex29_local_compactness_exercises : forall X Tx : set , locally_compact X Tx -> Hausdorff_space X Tx -> exists Y Ty : set , one_point_compactification X Tx Y Ty.
Definition relation_on : set -> set -> prop := fun le J => forall a b : set , (a,b) :e le -> a :e J /\ b :e J.
Definition partial_order_on : set -> set -> prop := fun J le => relation_on le J /\ (forall a : set , a :e J -> (a,a) :e le) /\ (forall a b : set , a :e J -> b :e J -> (a,b) :e le -> (b,a) :e le -> a = b) /\ (forall a b c : set , a :e J -> b :e J -> c :e J -> (a,b) :e le -> (b,c) :e le -> (a,c) :e le).
Axiom partial_order_on_refl : forall J le : set , partial_order_on J le -> forall a : set , a :e J -> (a,a) :e le.
Axiom partial_order_on_antisym : forall J le : set , partial_order_on J le -> forall a b : set , a :e J -> b :e J -> (a,b) :e le -> (b,a) :e le -> a = b.
Axiom partial_order_on_trans : forall J le : set , partial_order_on J le -> forall a b c : set , a :e J -> b :e J -> c :e J -> (a,b) :e le -> (b,c) :e le -> (a,c) :e le.
Definition directed_set : set -> set -> prop := fun J le => (J <> Empty /\ partial_order_on J le) /\ forall a b : set , a :e J -> b :e J -> exists c : set , c :e J /\ (a,c) :e le /\ (b,c) :e le.
Axiom directed_set_partial_order : forall J le : set , directed_set J le -> partial_order_on J le.
Axiom directed_set_refl : forall J le : set , directed_set J le -> forall a : set , a :e J -> (a,a) :e le.
Axiom directed_set_trans : forall J le : set , directed_set J le -> forall a b c : set , a :e J -> b :e J -> c :e J -> (a,b) :e le -> (b,c) :e le -> (a,c) :e le.
Axiom directed_set_nonempty : forall J le : set , directed_set J le -> J <> Empty.
Axiom directed_set_upper_bound_property : forall J le : set , directed_set J le -> forall i j : set , i :e J -> j :e J -> exists k : set , k :e J /\ (i,k) :e le /\ (j,k) :e le.
Axiom directed_set_upper_bound : forall J le i : set , directed_set J le -> i :e J -> exists k : set , k :e J /\ (i,k) :e le.
Axiom directed_set_pair_upper_bound : forall J le i j : set , directed_set J le -> i :e J -> j :e J -> exists k : set , k :e J /\ (i,k) :e le /\ (j,k) :e le.
Axiom examples_of_directed_sets : forall J le : set , directed_set J le -> directed_set J le.
Definition rel_restrict : set -> set -> set := fun le K => {p :e le|p 0 :e K /\ p 1 :e K}.
Axiom rel_restrict_def : forall le K : set , rel_restrict le K = {p :e le|p 0 :e K /\ p 1 :e K}.
Axiom rel_restrictE : forall le K a b : set , (a,b) :e rel_restrict le K -> (a,b) :e le /\ a :e K /\ b :e K.
Axiom rel_restrictI : forall le K a b : set , (a,b) :e le -> a :e K -> b :e K -> (a,b) :e rel_restrict le K.
Axiom cofinal_subset_directed : forall J le K : set , directed_set J le -> K c= J -> (forall a : set , a :e J -> exists b : set , b :e K /\ (a,b) :e le) -> directed_set K (rel_restrict le K).
Definition net_on : set -> prop := fun net => exists J le X : set , directed_set J le /\ total_function_on net J X /\ functional_graph net /\ graph_domain_subset net J.
Definition net_in_space : set -> set -> prop := fun X net => exists J le : set , directed_set J le /\ total_function_on net J X /\ functional_graph net /\ graph_domain_subset net J.
Axiom net_in_space_implies_net_on : forall X net : set , net_in_space X net -> net_on net.
Axiom net_in_space_domain_unique : forall X net J le J' le' : set , directed_set J le /\ total_function_on net J X /\ functional_graph net /\ graph_domain_subset net J -> directed_set J' le' /\ total_function_on net J' X /\ functional_graph net /\ graph_domain_subset net J' -> J = J'.
Definition net_pack : set -> set -> set -> set := fun J le net => (J,(le,net)).
Definition net_pack_index : set -> set := fun N => N 0.
Definition net_pack_le : set -> set := fun N => (N 1) 0.
Definition net_pack_fun : set -> set := fun N => (N 1) 1.
Axiom net_pack_index_unfold : forall N : set , net_pack_index N = N 0.
Axiom net_pack_le_unfold : forall N : set , net_pack_le N = (N 1) 0.
Axiom net_pack_fun_unfold : forall N : set , net_pack_fun N = (N 1) 1.
Axiom net_pack_def : forall J le net : set , net_pack J le net = (J,(le,net)).
Axiom net_pack_index_eq : forall J le net : set , net_pack_index (net_pack J le net) = J.
Axiom net_pack_le_eq : forall J le net : set , net_pack_le (net_pack J le net) = le.
Axiom net_pack_fun_eq : forall J le net : set , net_pack_fun (net_pack J le net) = net.
Definition net_pack_in_space : set -> set -> prop := fun X N => exists J le net : set , N = net_pack J le net /\ directed_set J le /\ total_function_on net J X /\ functional_graph net /\ graph_domain_subset net J.
Axiom net_pack_in_space_unpack_eq : forall X N J le net : set , net_pack_in_space X N -> N = net_pack J le net -> directed_set J le /\ total_function_on net J X /\ functional_graph net /\ graph_domain_subset net J.
Axiom net_pack_in_space_implies_net_in_space : forall X N : set , net_pack_in_space X N -> net_in_space X (net_pack_fun N).
Axiom net_pack_in_space_implies_directed_set : forall X N : set , net_pack_in_space X N -> directed_set (net_pack_index N) (net_pack_le N).
Axiom net_pack_in_space_implies_total_function_on : forall X N : set , net_pack_in_space X N -> total_function_on (net_pack_fun N) (net_pack_index N) X.
Axiom net_pack_in_space_implies_functional_graph : forall X N : set , net_pack_in_space X N -> functional_graph (net_pack_fun N).
Axiom net_pack_in_space_implies_graph_domain_subset : forall X N : set , net_pack_in_space X N -> graph_domain_subset (net_pack_fun N) (net_pack_index N).
Axiom net_in_space_implies_exists_net_pack_in_space : forall X net : set , net_in_space X net -> exists N : set , net_pack_in_space X N /\ net_pack_fun N = net.
Axiom graph_subset_setprod : forall A Y : set , forall g : set -> set , (forall a : set , a :e A -> g a :e Y) -> graph A g c= setprod A Y.
Axiom graph_in_function_space : forall A Y : set , forall g : set -> set , (forall a : set , a :e A -> g a :e Y) -> graph A g :e function_space A Y.
Definition subnet_of : set -> set -> prop := fun net sub => exists J leJ K leK X phi : set , directed_set J leJ /\ directed_set K leK /\ total_function_on net J X /\ functional_graph net /\ total_function_on sub K X /\ functional_graph sub /\ total_function_on phi K J /\ functional_graph phi /\ graph_domain_subset net J /\ graph_domain_subset sub K /\ graph_domain_subset phi K /\ (forall i j : set , i :e K -> j :e K -> (i,j) :e leK -> (apply_fun phi i,apply_fun phi j) :e leJ) /\ (forall j : set , j :e J -> exists k : set , k :e K /\ (j,apply_fun phi k) :e leJ) /\ (forall k : set , k :e K -> apply_fun sub k = apply_fun net (apply_fun phi k)).
Axiom pair_order_pred : forall K le i j : set , (i,j) :e {q :e setprod K K|(q 1) 0 c= (q 0) 0 /\ ((q 0) 1,(q 1) 1) :e le} -> (j 0) c= (i 0) /\ ((i 1),(j 1)) :e le.
Axiom subnet_implies_net_on : forall net sub : set , subnet_of net sub -> net_on sub.
Axiom subnet_implies_net_on_source : forall net sub : set , subnet_of net sub -> net_on net.
Section PropN2.
Variable P1 P2 P3 P4 P5 P6 P7 P8 P9 P10 P11 P12 P13 P14 : prop.
Axiom and8I : P1 -> P2 -> P3 -> P4 -> P5 -> P6 -> P7 -> P8 -> P1 /\ P2 /\ P3 /\ P4 /\ P5 /\ P6 /\ P7 /\ P8.
Axiom and9I : P1 -> P2 -> P3 -> P4 -> P5 -> P6 -> P7 -> P8 -> P9 -> P1 /\ P2 /\ P3 /\ P4 /\ P5 /\ P6 /\ P7 /\ P8 /\ P9.
Axiom and10I : P1 -> P2 -> P3 -> P4 -> P5 -> P6 -> P7 -> P8 -> P9 -> P10 -> P1 /\ P2 /\ P3 /\ P4 /\ P5 /\ P6 /\ P7 /\ P8 /\ P9 /\ P10.
Axiom and11I : P1 -> P2 -> P3 -> P4 -> P5 -> P6 -> P7 -> P8 -> P9 -> P10 -> P11 -> P1 /\ P2 /\ P3 /\ P4 /\ P5 /\ P6 /\ P7 /\ P8 /\ P9 /\ P10 /\ P11.
Axiom and12I : P1 -> P2 -> P3 -> P4 -> P5 -> P6 -> P7 -> P8 -> P9 -> P10 -> P11 -> P12 -> P1 /\ P2 /\ P3 /\ P4 /\ P5 /\ P6 /\ P7 /\ P8 /\ P9 /\ P10 /\ P11 /\ P12.
Axiom and13I : P1 -> P2 -> P3 -> P4 -> P5 -> P6 -> P7 -> P8 -> P9 -> P10 -> P11 -> P12 -> P13 -> P1 /\ P2 /\ P3 /\ P4 /\ P5 /\ P6 /\ P7 /\ P8 /\ P9 /\ P10 /\ P11 /\ P12 /\ P13.
Axiom and14I : P1 -> P2 -> P3 -> P4 -> P5 -> P6 -> P7 -> P8 -> P9 -> P10 -> P11 -> P12 -> P13 -> P14 -> P1 /\ P2 /\ P3 /\ P4 /\ P5 /\ P6 /\ P7 /\ P8 /\ P9 /\ P10 /\ P11 /\ P12 /\ P13 /\ P14.
End PropN2.
Axiom subnet_of_refl_witnessed : forall J le X net : set , directed_set J le -> total_function_on net J X -> functional_graph net -> graph_domain_subset net J -> subnet_of net net.
Axiom subnet_of_refl : forall net : set , net_on net -> subnet_of net net.
Definition accumulation_point_of_net : set -> set -> set -> set -> prop := fun X Tx net x => exists J le : set , topology_on X Tx /\ directed_set J le /\ total_function_on net J X /\ functional_graph net /\ graph_domain_subset net J /\ x :e X /\ forall U : set , U :e Tx -> x :e U -> forall j0 : set , j0 :e J -> exists j : set , j :e J /\ (j0,j) :e le /\ apply_fun net j :e U.
Definition accumulation_point_of_net_on : set -> set -> set -> set -> set -> set -> prop := fun X Tx net J le x => topology_on X Tx /\ directed_set J le /\ total_function_on net J X /\ functional_graph net /\ graph_domain_subset net J /\ x :e X /\ forall U : set , U :e Tx -> x :e U -> forall j0 : set , j0 :e J -> exists j : set , j :e J /\ (j0,j) :e le /\ apply_fun net j :e U.
Axiom accumulation_point_of_net_on_implies_accumulation_point_of_net : forall X Tx net J le x : set , accumulation_point_of_net_on X Tx net J le x -> accumulation_point_of_net X Tx net x.
Axiom accumulation_point_of_net_on_implies_topology_on : forall X Tx net J le x : set , accumulation_point_of_net_on X Tx net J le x -> topology_on X Tx.
Axiom accumulation_point_of_net_on_implies_directed_set : forall X Tx net J le x : set , accumulation_point_of_net_on X Tx net J le x -> directed_set J le.
Axiom accumulation_point_of_net_on_implies_total_function_on : forall X Tx net J le x : set , accumulation_point_of_net_on X Tx net J le x -> total_function_on net J X.
Axiom accumulation_point_of_net_on_implies_functional_graph : forall X Tx net J le x : set , accumulation_point_of_net_on X Tx net J le x -> functional_graph net.
Axiom accumulation_point_of_net_on_implies_graph_domain_subset : forall X Tx net J le x : set , accumulation_point_of_net_on X Tx net J le x -> graph_domain_subset net J.
Axiom accumulation_point_of_net_on_implies_x_in_space : forall X Tx net J le x : set , accumulation_point_of_net_on X Tx net J le x -> x :e X.
Axiom accumulation_point_of_net_on_implies_hits : forall X Tx net J le x : set , accumulation_point_of_net_on X Tx net J le x -> forall U : set , U :e Tx -> x :e U -> forall j0 : set , j0 :e J -> exists j : set , j :e J /\ (j0,j) :e le /\ apply_fun net j :e U.
Definition net_converges : set -> set -> set -> set -> prop := fun X Tx net x => exists J le : set , topology_on X Tx /\ directed_set J le /\ total_function_on net J X /\ functional_graph net /\ graph_domain_subset net J /\ x :e X /\ forall U : set , U :e Tx -> x :e U -> exists i0 : set , i0 :e J /\ forall i : set , i :e J -> (i0,i) :e le -> apply_fun net i :e U.
Definition net_converges_on : set -> set -> set -> set -> set -> set -> prop := fun X Tx net J le x => topology_on X Tx /\ directed_set J le /\ total_function_on net J X /\ functional_graph net /\ graph_domain_subset net J /\ x :e X /\ forall U : set , U :e Tx -> x :e U -> exists i0 : set , i0 :e J /\ forall i : set , i :e J -> (i0,i) :e le -> apply_fun net i :e U.
Axiom net_converges_on_implies_net_converges : forall X Tx net J le x : set , net_converges_on X Tx net J le x -> net_converges X Tx net x.
Axiom net_converges_on_implies_net_in_space : forall X Tx net J le x : set , net_converges_on X Tx net J le x -> net_in_space X net.
Axiom net_converges_on_implies_net_on : forall X Tx net J le x : set , net_converges_on X Tx net J le x -> net_on net.
Axiom net_converges_on_implies_topology_on : forall X Tx net J le x : set , net_converges_on X Tx net J le x -> topology_on X Tx.
Axiom net_converges_on_implies_directed_set : forall X Tx net J le x : set , net_converges_on X Tx net J le x -> directed_set J le.
Axiom net_converges_on_implies_total_function_on : forall X Tx net J le x : set , net_converges_on X Tx net J le x -> total_function_on net J X.
Axiom net_converges_on_implies_functional_graph : forall X Tx net J le x : set , net_converges_on X Tx net J le x -> functional_graph net.
Axiom net_converges_on_implies_graph_domain_subset : forall X Tx net J le x : set , net_converges_on X Tx net J le x -> graph_domain_subset net J.
Axiom net_converges_on_implies_x_in_space : forall X Tx net J le x : set , net_converges_on X Tx net J le x -> x :e X.
Axiom net_converges_on_implies_eventually : forall X Tx net J le x : set , net_converges_on X Tx net J le x -> forall U : set , U :e Tx -> x :e U -> exists i0 : set , i0 :e J /\ forall i : set , i :e J -> (i0,i) :e le -> apply_fun net i :e U.
Axiom net_converges_implies_net_in_space : forall X Tx net x : set , net_converges X Tx net x -> net_in_space X net.
Axiom net_converges_on_in_subspace_topology : forall X Tx A net J le x : set , topology_on X Tx -> A c= X -> directed_set J le -> total_function_on net J A -> functional_graph net -> graph_domain_subset net J -> x :e A -> net_converges_on X Tx net J le x -> net_converges_on A (subspace_topology X Tx A) net J le x.
Axiom net_converges_implies_exists_net_converges_on : forall X Tx net x : set , net_converges X Tx net x -> exists J le : set , net_converges_on X Tx net J le x.
Axiom net_converges_on_domain_unique : forall X Tx net J le J' le' x : set , net_converges_on X Tx net J le x -> net_converges_on X Tx net J' le' x -> J = J'.
Axiom net_converges_implies_accumulation_point : forall X Tx net x : set , net_converges X Tx net x -> accumulation_point_of_net X Tx net x.
Axiom net_converges_implies_net_on : forall X Tx net x : set , net_converges X Tx net x -> net_on net.
Definition subnet_of_witness : set -> set -> set -> set -> set -> set -> set -> set -> prop := fun net sub J leJ K leK X phi => directed_set J leJ /\ directed_set K leK /\ total_function_on net J X /\ functional_graph net /\ graph_domain_subset net J /\ total_function_on sub K X /\ functional_graph sub /\ graph_domain_subset sub K /\ total_function_on phi K J /\ functional_graph phi /\ graph_domain_subset phi K /\ (forall i j : set , i :e K -> j :e K -> (i,j) :e leK -> (apply_fun phi i,apply_fun phi j) :e leJ) /\ (forall j : set , j :e J -> exists k : set , k :e K /\ (j,apply_fun phi k) :e leJ) /\ (forall k : set , k :e K -> apply_fun sub k = apply_fun net (apply_fun phi k)).
Axiom subnet_of_witness_dirJ : forall net sub J leJ K leK X phi : set , subnet_of_witness net sub J leJ K leK X phi -> directed_set J leJ.
Axiom subnet_of_witness_dirK : forall net sub J leJ K leK X phi : set , subnet_of_witness net sub J leJ K leK X phi -> directed_set K leK.
Axiom subnet_of_witness_compose_fun : forall net J leJ K leK X phi : set , directed_set J leJ -> directed_set K leK -> total_function_on net J X -> functional_graph net -> graph_domain_subset net J -> total_function_on phi K J -> functional_graph phi -> graph_domain_subset phi K -> (forall i j : set , i :e K -> j :e K -> (i,j) :e leK -> (apply_fun phi i,apply_fun phi j) :e leJ) -> (forall j : set , j :e J -> exists k : set , k :e K /\ (j,apply_fun phi k) :e leJ) -> subnet_of_witness net (compose_fun K phi net) J leJ K leK X phi.
Axiom subnet_of_witness_map : forall net sub J leJ K leK X phi Y f : set , subnet_of_witness net sub J leJ K leK X phi -> function_on f X Y -> subnet_of_witness (compose_fun J net f) (compose_fun K sub f) J leJ K leK Y phi.
Axiom subnet_of_witness_trans : forall net sub sub2 J leJ K leK L leL X phi psi : set , subnet_of_witness net sub J leJ K leK X phi -> subnet_of_witness sub sub2 K leK L leL X psi -> subnet_of_witness net sub2 J leJ L leL X (compose_fun L psi phi).
Axiom subnet_of_witness_totnet : forall net sub J leJ K leK X phi : set , subnet_of_witness net sub J leJ K leK X phi -> total_function_on net J X.
Axiom subnet_of_witness_graphnet : forall net sub J leJ K leK X phi : set , subnet_of_witness net sub J leJ K leK X phi -> functional_graph net.
Axiom subnet_of_witness_domnet : forall net sub J leJ K leK X phi : set , subnet_of_witness net sub J leJ K leK X phi -> graph_domain_subset net J.
Axiom subnet_of_witness_totsub : forall net sub J leJ K leK X phi : set , subnet_of_witness net sub J leJ K leK X phi -> total_function_on sub K X.
Axiom subnet_of_witness_graphsub : forall net sub J leJ K leK X phi : set , subnet_of_witness net sub J leJ K leK X phi -> functional_graph sub.
Axiom subnet_of_witness_domsub : forall net sub J leJ K leK X phi : set , subnet_of_witness net sub J leJ K leK X phi -> graph_domain_subset sub K.
Axiom subnet_of_witness_totphi : forall net sub J leJ K leK X phi : set , subnet_of_witness net sub J leJ K leK X phi -> total_function_on phi K J.
Axiom subnet_of_witness_graphphi : forall net sub J leJ K leK X phi : set , subnet_of_witness net sub J leJ K leK X phi -> functional_graph phi.
Axiom subnet_of_witness_domphi : forall net sub J leJ K leK X phi : set , subnet_of_witness net sub J leJ K leK X phi -> graph_domain_subset phi K.
Axiom subnet_of_witness_mono : forall net sub J leJ K leK X phi : set , subnet_of_witness net sub J leJ K leK X phi -> (forall i j : set , i :e K -> j :e K -> (i,j) :e leK -> (apply_fun phi i,apply_fun phi j) :e leJ).
Axiom subnet_of_witness_cofinal : forall net sub J leJ K leK X phi : set , subnet_of_witness net sub J leJ K leK X phi -> (forall j : set , j :e J -> exists k : set , k :e K /\ (j,apply_fun phi k) :e leJ).
Axiom subnet_of_witness_tail_above : forall net sub J leJ K leK X phi j0 : set , subnet_of_witness net sub J leJ K leK X phi -> j0 :e J -> exists k0 : set , k0 :e K /\ forall k : set , k :e K -> (k0,k) :e leK -> (j0,apply_fun phi k) :e leJ.
Axiom subnet_of_witness_vals : forall net sub J leJ K leK X phi : set , subnet_of_witness net sub J leJ K leK X phi -> (forall k : set , k :e K -> apply_fun sub k = apply_fun net (apply_fun phi k)).
Axiom subnet_of_witness_converges_implies_cofinal_hits : forall X Tx net sub J leJ K leK x phi : set , subnet_of_witness net sub J leJ K leK X phi -> net_converges_on X Tx sub K leK x -> forall U j0 : set , U :e Tx -> x :e U -> j0 :e J -> exists j : set , j :e J /\ (j0,j) :e leJ /\ apply_fun net j :e U.
Axiom subnet_of_witness_eventually_implies_cofinal_hits : forall X net sub J leJ K leK phi U : set , subnet_of_witness net sub J leJ K leK X phi -> (exists kU : set , kU :e K /\ forall k : set , k :e K -> (kU,k) :e leK -> apply_fun sub k :e U) -> forall j0 : set , j0 :e J -> exists j : set , j :e J /\ (j0,j) :e leJ /\ apply_fun net j :e U.
Axiom subnet_of_witness_implies_subnet_of : forall net sub J leJ K leK X phi : set , subnet_of_witness net sub J leJ K leK X phi -> subnet_of net sub.
Axiom subnet_of_implies_exists_subnet_of_witness : forall net sub : set , subnet_of net sub -> exists J leJ K leK X phi : set , subnet_of_witness net sub J leJ K leK X phi.
Axiom subnet_of_witness_congr : forall net1 net2 sub1 sub2 J1 J2 leJ1 leJ2 K1 K2 leK1 leK2 X phi : set , net1 = net2 -> sub1 = sub2 -> J1 = J2 -> leJ1 = leJ2 -> K1 = K2 -> leK1 = leK2 -> subnet_of_witness net1 sub1 J1 leJ1 K1 leK1 X phi -> subnet_of_witness net2 sub2 J2 leJ2 K2 leK2 X phi.
Definition net_pack_converges : set -> set -> set -> set -> prop := fun X Tx N x => exists J le net : set , N = net_pack J le net /\ net_converges_on X Tx net J le x.
Axiom net_pack_converges_implies_x_in_space : forall X Tx N x : set , net_pack_converges X Tx N x -> x :e X.
Axiom net_pack_converges_implies_topology_on : forall X Tx N x : set , net_pack_converges X Tx N x -> topology_on X Tx.
Axiom net_pack_converges_implies_net_converges : forall X Tx N x : set , net_pack_converges X Tx N x -> net_converges X Tx (net_pack_fun N) x.
Axiom net_pack_converges_implies_net_converges_on_components : forall X Tx N x : set , net_pack_converges X Tx N x -> net_converges_on X Tx (net_pack_fun N) (net_pack_index N) (net_pack_le N) x.
Axiom net_pack_converges_implies_net_pack_in_space : forall X Tx N x : set , net_pack_converges X Tx N x -> net_pack_in_space X N.
Definition subnet_pack_of : set -> set -> prop := fun N S => exists X phi : set , subnet_of_witness (net_pack_fun N) (net_pack_fun S) (net_pack_index N) (net_pack_le N) (net_pack_index S) (net_pack_le S) X phi.
Definition subnet_pack_of_in : set -> set -> set -> prop := fun X N S => exists phi : set , subnet_of_witness (net_pack_fun N) (net_pack_fun S) (net_pack_index N) (net_pack_le N) (net_pack_index S) (net_pack_le S) X phi.
Axiom subnet_pack_of_in_trans : forall X N S T : set , subnet_pack_of_in X N S -> subnet_pack_of_in X S T -> subnet_pack_of_in X N T.
Axiom subnet_pack_of_in_refl : forall X N : set , net_pack_in_space X N -> subnet_pack_of_in X N N.
Axiom subnet_pack_of_in_implies_dirN : forall X N S : set , subnet_pack_of_in X N S -> directed_set (net_pack_index N) (net_pack_le N).
Axiom subnet_pack_of_in_implies_dirS : forall X N S : set , subnet_pack_of_in X N S -> directed_set (net_pack_index S) (net_pack_le S).
Axiom subnet_pack_of_in_implies_totnet : forall X N S : set , subnet_pack_of_in X N S -> total_function_on (net_pack_fun N) (net_pack_index N) X.
Axiom subnet_pack_of_in_implies_graphnet : forall X N S : set , subnet_pack_of_in X N S -> functional_graph (net_pack_fun N).
Axiom subnet_pack_of_in_implies_domnet : forall X N S : set , subnet_pack_of_in X N S -> graph_domain_subset (net_pack_fun N) (net_pack_index N).
Axiom subnet_pack_of_in_implies_totsub : forall X N S : set , subnet_pack_of_in X N S -> total_function_on (net_pack_fun S) (net_pack_index S) X.
Axiom subnet_pack_of_in_implies_graphsub : forall X N S : set , subnet_pack_of_in X N S -> functional_graph (net_pack_fun S).
Axiom subnet_pack_of_in_implies_domsub : forall X N S : set , subnet_pack_of_in X N S -> graph_domain_subset (net_pack_fun S) (net_pack_index S).
Definition setprod_le : set -> set -> set -> set -> set := fun K1 le1 K2 le2 => {q :e setprod (setprod K1 K2) (setprod K1 K2)|(((q 0) 0,(q 1) 0) :e le1) /\ (((q 0) 1,(q 1) 1) :e le2)}.
Axiom setprod_le_pred : forall K1 le1 K2 le2 a b : set , (a,b) :e setprod_le K1 le1 K2 le2 -> ((a 0,b 0) :e le1) /\ ((a 1,b 1) :e le2).
Axiom directed_set_setprod : forall K1 le1 K2 le2 : set , directed_set K1 le1 -> directed_set K2 le2 -> directed_set (setprod K1 K2) (setprod_le K1 le1 K2 le2).
Axiom subnet_pack_of_in_refl_from_subnet : forall X N S : set , subnet_pack_of_in X N S -> subnet_pack_of_in X N N.
Axiom subnet_pack_of_in_common_refinement : forall X N S1 S2 : set , subnet_pack_of_in X N S1 -> subnet_pack_of_in X N S2 -> exists R : set , subnet_pack_of_in X N R /\ subnet_pack_of_in X R S1 /\ subnet_pack_of_in X R S2.
Axiom subnet_pack_of_in_common_supernet_finite_family : forall X N Fam : set , net_pack_in_space X N -> finite Fam -> (forall S : set , S :e Fam -> subnet_pack_of_in X N S) -> exists R : set , subnet_pack_of_in X N R /\ (forall S : set , S :e Fam -> subnet_pack_of_in X R S).
Axiom subnet_pack_of_in_implies_subnet_of_fun : forall X N S : set , subnet_pack_of_in X N S -> subnet_of (net_pack_fun N) (net_pack_fun S).
Axiom subnet_preserves_convergence_witnessed : forall X Tx net sub x J leJ K leK phi : set , topology_on X Tx -> directed_set J leJ -> directed_set K leK -> total_function_on net J X -> functional_graph net -> graph_domain_subset net J -> total_function_on sub K X -> functional_graph sub -> graph_domain_subset sub K -> total_function_on phi K J -> functional_graph phi -> graph_domain_subset phi K -> (forall i j : set , i :e K -> j :e K -> (i,j) :e leK -> (apply_fun phi i,apply_fun phi j) :e leJ) -> (forall j : set , j :e J -> exists k : set , k :e K /\ (j,apply_fun phi k) :e leJ) -> (forall k : set , k :e K -> apply_fun sub k = apply_fun net (apply_fun phi k)) -> x :e X -> (forall U : set , U :e Tx -> x :e U -> exists j0 : set , j0 :e J /\ forall j : set , j :e J -> (j0,j) :e leJ -> apply_fun net j :e U) -> net_converges X Tx sub x.
Axiom subnet_preserves_convergence : forall X Tx net sub x J leJ K leK phi : set , subnet_of_witness net sub J leJ K leK X phi -> net_converges_on X Tx net J leJ x -> net_converges_on X Tx sub K leK x.
Axiom subnet_pack_of_in_preserves_net_converges_on : forall X Tx N S x : set , subnet_pack_of_in X N S -> net_converges_on X Tx (net_pack_fun N) (net_pack_index N) (net_pack_le N) x -> net_converges_on X Tx (net_pack_fun S) (net_pack_index S) (net_pack_le S) x.
Axiom subnet_pack_of_in_preserves_net_pack_converges : forall X Tx N S x : set , net_pack_in_space X N -> net_pack_in_space X S -> subnet_pack_of_in X N S -> net_pack_converges X Tx N x -> net_pack_converges X Tx S x.
Definition net_points_in : set -> set -> set -> prop := fun A net J => forall j : set , j :e J -> apply_fun net j :e A.
Definition rev_inclusion_rel : set -> set := fun J => {p :e setprod J J|p 1 c= p 0}.
Axiom rev_inclusion_rel_def : forall J : set , rev_inclusion_rel J = {p :e setprod J J|p 1 c= p 0}.
Axiom rev_inclusion_relE : forall J a b : set , (a,b) :e rev_inclusion_rel J -> (a,b) :e setprod J J /\ b c= a.
Axiom rev_inclusion_relI : forall J a b : set , (a,b) :e setprod J J -> b c= a -> (a,b) :e rev_inclusion_rel J.
Definition inclusion_rel : set -> set := fun J => {p :e setprod J J|(p 0) c= (p 1)}.
Axiom inclusion_rel_def : forall J : set , inclusion_rel J = {p :e setprod J J|(p 0) c= (p 1)}.
Axiom inclusion_relE : forall J a b : set , (a,b) :e inclusion_rel J -> (a,b) :e setprod J J /\ a c= b.
Axiom inclusion_relI : forall J a b : set , (a,b) :e setprod J J -> a c= b -> (a,b) :e inclusion_rel J.
Axiom omega_directed_by_inclusion_rel : directed_set omega (inclusion_rel omega).
Axiom finite_subcollections_directed_by_inclusion_rel : forall I : set , directed_set (finite_subcollections I) (inclusion_rel (finite_subcollections I)).
Definition sequence_as_net : set -> set := fun seq => graph omega (fun n : set => apply_fun seq n).
Axiom sequence_as_net_in_space : forall X seq : set , sequence_on seq X -> net_in_space X (sequence_as_net seq).
Axiom converges_to_iff_net_converges_on_sequence_as_net : forall X Tx seq x : set , sequence_on seq X -> (converges_to X Tx seq x <-> net_converges_on X Tx (sequence_as_net seq) omega (inclusion_rel omega) x).
Axiom converges_to_implies_net_converges_sequence_as_net : forall X Tx seq x : set , converges_to X Tx seq x -> net_converges X Tx (sequence_as_net seq) x.
Axiom neighborhoods_directed_by_reverse_inclusion : forall X Tx x : set , topology_on X Tx -> x :e X -> directed_set {U :e Tx|x :e U} (rev_inclusion_rel {U :e Tx|x :e U}).
Axiom closure_via_nets : forall X Tx A x : set , topology_on X Tx -> (x :e closure_of X Tx A <-> exists net J le : set , net_converges_on X Tx net J le x /\ net_points_in A net J).
Axiom continuity_via_nets : forall X Tx Y Ty f : set , topology_on X Tx -> topology_on Y Ty -> (continuous_map X Tx Y Ty f <-> forall net J le x : set , net_converges_on X Tx net J le x -> net_converges_on Y Ty (compose_fun J net f) J le (apply_fun f x)).
Axiom subnet_converges_to_accumulation : forall X Tx net x : set , accumulation_point_of_net X Tx net x -> exists sub : set , subnet_of net sub /\ net_converges X Tx sub x.
Axiom subnet_converges_to_accumulation_witnessed : forall X Tx net x : set , accumulation_point_of_net X Tx net x -> exists J le K leK phi sub : set , subnet_of_witness net sub J le K leK X phi /\ net_converges_on X Tx sub K leK x.
Axiom subnet_converges_to_accumulation_witnessed_on : forall X Tx net x J le : set , accumulation_point_of_net_on X Tx net J le x -> exists K leK phi sub : set , subnet_of_witness net sub J le K leK X phi /\ net_converges_on X Tx sub K leK x.
Axiom compact_space_net_has_accumulation_point : forall X Tx net : set , compact_space X Tx -> net_in_space X net -> exists x0 : set , accumulation_point_of_net X Tx net x0.
Axiom compact_space_net_has_accumulation_point_on : forall X Tx net J le : set , compact_space X Tx -> directed_set J le -> total_function_on net J X -> functional_graph net -> graph_domain_subset net J -> exists x0 : set , accumulation_point_of_net_on X Tx net J le x0.
Axiom finite_subcollections_directed_by_subset : forall S : set , directed_set (finite_subcollections S) (inclusion_rel (finite_subcollections S)).
Axiom open_cover_no_finite_subcover_implies_net_counterexample : forall X Tx Fam : set , topology_on X Tx -> open_cover_of X Tx Fam -> ~ (has_finite_subcover X Tx Fam) -> exists J le net0 : set , directed_set J le /\ total_function_on net0 J X /\ functional_graph net0 /\ graph_domain_subset net0 J /\ (forall sub K leK phi x : set , subnet_of_witness net0 sub J le K leK X phi -> ~ (net_converges_on X Tx sub K leK x)).
Axiom open_cover_no_finite_subcover_implies_net_pack_counterexample : forall X Tx Fam : set , topology_on X Tx -> open_cover_of X Tx Fam -> ~ (has_finite_subcover X Tx Fam) -> exists N : set , net_pack_in_space X N /\ (forall S x : set , subnet_pack_of_in X N S -> ~ (net_pack_converges X Tx S x)).
Axiom compact_space_implies_every_net_has_convergent_subnet : forall X Tx : set , compact_space X Tx -> forall net : set , net_in_space X net -> exists sub x : set , subnet_of net sub /\ net_converges X Tx sub x.
Axiom compact_space_implies_every_net_pack_has_convergent_subnet_fun : forall X Tx : set , compact_space X Tx -> forall N : set , net_pack_in_space X N -> exists sub x : set , subnet_of (net_pack_fun N) sub /\ net_converges X Tx sub x.
Axiom compact_space_implies_every_net_pack_has_convergent_subnet_pack : forall X Tx : set , compact_space X Tx -> forall N : set , net_pack_in_space X N -> exists S x : set , subnet_pack_of_in X N S /\ net_pack_converges X Tx S x.
Axiom compact_space_of_every_net_pack_has_convergent_subnet_pack : forall X Tx : set , topology_on X Tx -> (forall N : set , net_pack_in_space X N -> exists S x : set , subnet_pack_of_in X N S /\ net_pack_converges X Tx S x) -> compact_space X Tx.
Axiom compact_iff_every_net_pack_has_convergent_subnet_pack : forall X Tx : set , topology_on X Tx -> (compact_space X Tx <-> forall N : set , net_pack_in_space X N -> exists S x : set , subnet_pack_of_in X N S /\ net_pack_converges X Tx S x).
Definition countable_set : set -> prop := fun A => countable A.
Axiom omega_countable_set : countable_set omega.
Axiom equip_countable_set_left : forall X Y : set , equip X Y -> countable_set X -> countable_set Y.
Axiom equip_countable_set_right : forall X Y : set , equip X Y -> countable_set Y -> countable_set X.
Axiom rational_numbers_countable : countable_set rational_numbers.
Definition countable_subcollection : set -> set -> prop := fun V U => V c= U /\ countable_set V.
Definition countable_index_set : set -> prop := fun I => countable_set I.
Definition countable_product_topology_subbasis : set -> set -> set := fun I Xi => generated_topology_from_subbasis (product_space I Xi) (product_subbasis_full I Xi).
Axiom product_subbasis_full_subbasis_on : forall I Xi : set , I <> Empty -> (forall i : set , i :e I -> topology_on (space_family_set Xi i) (space_family_topology Xi i)) -> subbasis_on (product_space I Xi) (product_subbasis_full I Xi).
Axiom preimage_R1_singleton_map_cylinder : forall i U : set , i :e Sing Empty -> U :e space_family_topology (const_space_family (Sing Empty) R R_standard_topology) i -> preimage_of R R1_singleton_map (product_cylinder (Sing Empty) (const_space_family (Sing Empty) R R_standard_topology) i U) = U.
Axiom R1_singleton_map_continuous : continuous_map R R_standard_topology (euclidean_space (Sing Empty)) (euclidean_topology (Sing Empty)) R1_singleton_map.
Definition R1_eval_map : set := graph (euclidean_space (Sing Empty)) (fun f : set => apply_fun f Empty).
Axiom euclidean_space_1_coord_in_R : forall f : set , f :e euclidean_space (Sing Empty) -> apply_fun f Empty :e R.
Axiom R1_eval_map_continuous : continuous_map (euclidean_space (Sing Empty)) (euclidean_topology (Sing Empty)) R R_standard_topology R1_eval_map.
Axiom euclidean_space_1_eta : forall y : set , y :e euclidean_space (Sing Empty) -> y = R1_singleton_seq (apply_fun y Empty).
Axiom R_homeomorphic_euclidean_space_1 : homeomorphism R R_standard_topology (euclidean_space (Sing Empty)) (euclidean_topology (Sing Empty)) R1_singleton_map.
Axiom setprod_Empty_left : forall Y : set , setprod Empty Y = Empty.
Axiom basis_on_singleton : forall X : set , basis_on X {X}.
Axiom product_space_empty_index : forall Xi : set , product_space Empty Xi = {Empty}.
Axiom basis_of_subbasis_empty_eq : forall X : set , X <> Empty -> basis_of_subbasis X Empty = {X}.
Axiom countable_product_topology_subbasis_empty_is_topology : forall Xi : set , topology_on (product_space Empty Xi) (countable_product_topology_subbasis Empty Xi).
Axiom product_topology_full_is_topology : forall I Xi : set , (forall i : set , i :e I -> topology_on (space_family_set Xi i) (space_family_topology Xi i)) -> topology_on (product_space I Xi) (product_topology_full I Xi).
Axiom product_topology_full_empty_is_topology : forall Xi : set , topology_on (product_space Empty Xi) (product_topology_full Empty Xi).
Axiom product_topology_full_empty_is_compact : forall Xi : set , compact_space (product_space Empty Xi) (product_topology_full Empty Xi).
Axiom equip_Power_nat : forall n : set , nat_p n -> equip (Power n) (exp_nat 2 n).
Axiom countable_image : forall X : set , countable_set X -> forall F : set -> set , countable_set {F x|x :e X}.
Axiom rational_open_intervals_basis_countable : countable_set rational_open_intervals_basis.
Axiom finite_subcollections_omega_countable : countable (finite_subcollections omega).
Axiom finite_subcollections_countable : forall S : set , countable_set S -> countable_set (finite_subcollections S).
Axiom finite_intersections_of_countable : forall X S : set , countable_set S -> countable_set (finite_intersections_of X S).
Axiom basis_of_subbasis_countable : forall X S : set , countable_set S -> countable_set (basis_of_subbasis X S).
Definition real_sequences : set := {f :e Power (setprod omega R)|total_function_on f omega R /\ functional_graph f}.
Axiom real_sequences_ext : forall f g : set , f :e real_sequences -> g :e real_sequences -> (forall n : set , n :e omega -> apply_fun f n = apply_fun g n) -> f = g.
Axiom exists_metric_on : forall X : set , exists d : set , metric_on X d.
Axiom space_family_set_const_Romega : forall i : set , i :e omega -> space_family_set (const_space_family omega R R_standard_topology) i = R.
Axiom space_family_union_const_Romega : space_family_union omega (const_space_family omega R R_standard_topology) = R.
Axiom real_sequences_eq_Romega_space : real_sequences = R_omega_space.
Definition Romega_coord_abs_diff : set -> set -> set -> set := fun f g n => abs_SNo (add_SNo (apply_fun f n) (minus_SNo (apply_fun g n))).
Definition Romega_coord_clipped_diff : set -> set -> set -> set := fun f g n => If_i (Rlt (Romega_coord_abs_diff f g n) 1) (Romega_coord_abs_diff f g n) 1.
Definition Romega_clipped_diffs : set -> set -> set := fun f g => Repl omega (fun n : set => Romega_coord_clipped_diff f g n).
Axiom Romega_clipped_diffs_sym : forall f g : set , f :e real_sequences -> g :e real_sequences -> Romega_clipped_diffs f g = Romega_clipped_diffs g f.
Axiom Romega_coord_clipped_diff_self_zero : forall f n : set , f :e real_sequences -> n :e omega -> Romega_coord_clipped_diff f f n = 0.
Axiom Romega_clipped_diffs_diag_eq_Sing0 : forall f : set , f :e real_sequences -> Romega_clipped_diffs f f = {0}.
Definition Romega_uniform_metric_value : set -> set -> set := fun f g => Eps_i (fun r : set => R_lub (Romega_clipped_diffs f g) r).
Axiom Romega_clipped_diffs_in_R : forall f g : set , f :e real_sequences -> g :e real_sequences -> forall a : set , a :e Romega_clipped_diffs f g -> a :e R.
Axiom Romega_clipped_diffs_bounded : forall f g : set , f :e real_sequences -> g :e real_sequences -> exists u : set , u :e R /\ forall a : set , a :e Romega_clipped_diffs f g -> a :e R -> Rle a u.
Axiom Romega_uniform_metric_value_is_lub : forall f g : set , f :e real_sequences -> g :e real_sequences -> R_lub (Romega_clipped_diffs f g) (Romega_uniform_metric_value f g).
Axiom Romega_coord_clipped_diff_le_uniform : forall f g i : set , f :e real_sequences -> g :e real_sequences -> i :e omega -> Rle (Romega_coord_clipped_diff f g i) (Romega_uniform_metric_value f g).
Axiom Romega_coord_clipped_diff_lt_of_uniform_lt : forall f g i r : set , f :e real_sequences -> g :e real_sequences -> i :e omega -> Rlt (Romega_uniform_metric_value f g) r -> Rlt (Romega_coord_clipped_diff f g i) r.
Axiom Romega_uniform_metric_value_sym : forall f g : set , f :e real_sequences -> g :e real_sequences -> Romega_uniform_metric_value f g = Romega_uniform_metric_value g f.
Axiom Romega_uniform_metric_value_self_zero : forall f : set , f :e real_sequences -> Romega_uniform_metric_value f f = 0.
Axiom Romega_uniform_metric_value_in_R : forall f g : set , f :e real_sequences -> g :e real_sequences -> Romega_uniform_metric_value f g :e R.
Axiom Romega_uniform_metric_value_nonneg : forall f g : set , f :e real_sequences -> g :e real_sequences -> ~ (Rlt (Romega_uniform_metric_value f g) 0).
Axiom Romega_coord_clipped_diff_nonneg : forall f g n : set , f :e real_sequences -> g :e real_sequences -> n :e omega -> 0 <= Romega_coord_clipped_diff f g n.
Axiom Romega_uniform_metric_value_eq0_coord_eq : forall f g : set , f :e real_sequences -> g :e real_sequences -> Romega_uniform_metric_value f g = 0 -> forall n : set , n :e omega -> apply_fun f n = apply_fun g n.
Definition uniform_metric_Romega : set := graph (setprod real_sequences real_sequences) (fun p : set => Romega_uniform_metric_value (p 0) (p 1)).
Axiom uniform_metric_Romega_function_on : function_on uniform_metric_Romega (setprod real_sequences real_sequences) R.
Definition uniform_topology : set := metric_topology real_sequences uniform_metric_Romega.
Axiom Rle_of_SNoLe : forall a b : set , a :e R -> b :e R -> a <= b -> Rle a b.
Axiom recip_SNo_pos_le1_of_ge1 : forall x : set , SNo x -> 0 < x -> 1 <= x -> recip_SNo_pos x <= 1.
Axiom recip_SNo_pos_in_unit_interval_of_ge1 : forall t : set , t :e R -> Rle 1 t -> Rlt 0 t -> recip_SNo_pos t :e unit_interval.
Axiom abs_SNo_upper_bound : forall x : set , SNo x -> x <= abs_SNo x.
Axiom abs_SNo_lower_bound : forall x : set , SNo x -> minus_SNo (abs_SNo x) <= x.
Axiom abs_SNo_Le_of_bounds : forall t u : set , SNo t -> SNo u -> minus_SNo u <= t -> t <= u -> abs_SNo t <= u.
Axiom abs_SNo_subadd : forall x y : set , SNo x -> SNo y -> abs_SNo (add_SNo x y) <= add_SNo (abs_SNo x) (abs_SNo y).
Axiom abs_SNo_reverse_triangle : forall x y : set , SNo x -> SNo y -> abs_SNo x <= add_SNo (abs_SNo (add_SNo x y)) (abs_SNo y).
Axiom abs_SNo_add_lower_bound : forall x y : set , SNo x -> SNo y -> add_SNo (abs_SNo x) (minus_SNo (abs_SNo y)) <= abs_SNo (add_SNo x y).
Axiom abs_SNo_triangle : forall a b c : set , SNo a -> SNo b -> SNo c -> abs_SNo (add_SNo a (minus_SNo c)) <= add_SNo (abs_SNo (add_SNo a (minus_SNo b))) (abs_SNo (add_SNo b (minus_SNo c))).
Axiom SNo_If_i : forall P : prop , forall x y : set , SNo x -> SNo y -> SNo (If_i P x y).
Axiom Romega_coord_abs_diff_in_R : forall f g n : set , f :e real_sequences -> g :e real_sequences -> n :e omega -> Romega_coord_abs_diff f g n :e R.
Axiom Rclip_mono : forall t s : set , t :e R -> s :e R -> t <= s -> If_i (Rlt t 1) t 1 <= If_i (Rlt s 1) s 1.
Axiom Rclip_subadd_nonneg : forall p q : set , p :e R -> q :e R -> 0 <= p -> 0 <= q -> If_i (Rlt (add_SNo p q) 1) (add_SNo p q) 1 <= add_SNo (If_i (Rlt p 1) p 1) (If_i (Rlt q 1) q 1).
Axiom Romega_coord_abs_diff_triangle : forall f g h n : set , f :e real_sequences -> g :e real_sequences -> h :e real_sequences -> n :e omega -> Romega_coord_abs_diff f h n <= add_SNo (Romega_coord_abs_diff f g n) (Romega_coord_abs_diff g h n).
Axiom Romega_coord_clipped_diff_triangle : forall f g h n : set , f :e real_sequences -> g :e real_sequences -> h :e real_sequences -> n :e omega -> Romega_coord_clipped_diff f h n <= add_SNo (Romega_coord_clipped_diff f g n) (Romega_coord_clipped_diff g h n).
Axiom Romega_uniform_metric_value_triangle : forall x y z : set , x :e real_sequences -> y :e real_sequences -> z :e real_sequences -> ~ (Rlt (add_SNo (Romega_uniform_metric_value x y) (Romega_uniform_metric_value y z)) (Romega_uniform_metric_value x z)).
Axiom uniform_metric_Romega_is_metric : metric_on real_sequences uniform_metric_Romega.
Axiom uniform_topology_is_topology : topology_on real_sequences uniform_topology.
Axiom uniform_topology_is_topology_on_Romega_space : topology_on R_omega_space uniform_topology.
Definition Romega_product_topology_on_real_sequences : set := subspace_topology R_omega_space (product_topology_full omega (const_space_family omega R R_standard_topology)) real_sequences.
Definition Romega_box_topology_on_real_sequences : set := subspace_topology R_omega_space (box_topology omega (const_space_family omega R R_standard_topology)) real_sequences.
Axiom Romega_product_topology_on_real_sequences_eq : Romega_product_topology_on_real_sequences = R_omega_product_topology.
Axiom uniform_topology_finer_than_product_and_coarser_than_box : finer_than uniform_topology Romega_product_topology_on_real_sequences /\ coarser_than uniform_topology Romega_box_topology_on_real_sequences.
Definition R_bounded_distance : set -> set -> set := fun a b => If_i (Rlt (abs_SNo (add_SNo a (minus_SNo b))) 1) (abs_SNo (add_SNo a (minus_SNo b))) 1.
Definition R_bounded_metric : set := graph (setprod R R) (fun p : set => R_bounded_distance (p 0) (p 1)).
Axiom R_bounded_metric_apply_early : forall x y : set , x :e R -> y :e R -> apply_fun R_bounded_metric (x,y) = R_bounded_distance x y.
Axiom R_bounded_distance_sym : forall a b : set , a :e R -> b :e R -> R_bounded_distance a b = R_bounded_distance b a.
Axiom R_bounded_distance_self_zero : forall a : set , a :e R -> R_bounded_distance a a = 0.
Axiom R_bounded_distance_nonneg : forall a b : set , a :e R -> b :e R -> 0 <= R_bounded_distance a b.
Axiom SNo_pos_ne0 : forall x : set , SNo x -> 0 < x -> x <> 0.
Axiom abs_SNo_eq0 : forall x : set , SNo x -> abs_SNo x = 0 -> x = 0.
Axiom R_bounded_distance_eq0 : forall a b : set , a :e R -> b :e R -> R_bounded_distance a b = 0 -> a = b.
Axiom R_bounded_distance_le_1 : forall a b : set , a :e R -> b :e R -> Rle (R_bounded_distance a b) 1.
Axiom abs_SNo_in_R : forall x : set , x :e R -> abs_SNo x :e R.
Axiom R_not_bounded_subset_of_reals : ~ bounded_subset_of_reals R.
Axiom R_standard_topology_not_compact : ~ compact_space R R_standard_topology.
Axiom R_bounded_distance_in_R : forall a b : set , a :e R -> b :e R -> R_bounded_distance a b :e R.
Axiom R_bounded_distance_le_abs_diff : forall a b : set , a :e R -> b :e R -> Rle (R_bounded_distance a b) (abs_SNo (add_SNo a (minus_SNo b))).
Axiom R_bounded_distance_le_of_abs_le_lt1 : forall a b r : set , a :e R -> b :e R -> r :e R -> Rlt r 1 -> Rle (abs_SNo (add_SNo a (minus_SNo b))) r -> Rle (R_bounded_distance a b) r.
Axiom R_bounded_distance_le_lt1_imp_abs_le : forall a b r : set , a :e R -> b :e R -> r :e R -> Rlt r 1 -> Rle (R_bounded_distance a b) r -> Rle (abs_SNo (add_SNo a (minus_SNo b))) r.
Axiom R_bounded_distance_le_of_Rle_1 : forall a b r : set , a :e R -> b :e R -> r :e R -> Rle 1 r -> Rle (R_bounded_distance a b) r.
Axiom R_bounded_distance_triangle_Le : forall a b c : set , a :e R -> b :e R -> c :e R -> R_bounded_distance a c <= add_SNo (R_bounded_distance a b) (R_bounded_distance b c).
Definition Romega_D_scaled_diffs : set -> set -> set := fun x y => Repl omega (fun i : set => mul_SNo (R_bounded_distance (apply_fun x i) (apply_fun y i)) (inv_nat (ordsucc i))).
Axiom Romega_D_scaled_diffs_sym : forall x y : set , x :e R_omega_space -> y :e R_omega_space -> Romega_D_scaled_diffs x y = Romega_D_scaled_diffs y x.
Axiom Romega_D_scaled_diffs_diag_subset0 : forall x : set , x :e R_omega_space -> Romega_D_scaled_diffs x x c= {0}.
Axiom Romega_D_scaled_diffs_diag_eq_Sing0 : forall x : set , x :e R_omega_space -> Romega_D_scaled_diffs x x = {0}.
Definition Romega_D_metric_value : set -> set -> set := fun x y => Eps_i (fun r : set => R_lub (Romega_D_scaled_diffs x y) r).
Axiom inv_nat_Rle_1 : forall n : set , n :e omega :\: {0} -> Rle (inv_nat n) 1.
Axiom Romega_D_scaled_diffs_in_R : forall x y : set , x :e R_omega_space -> y :e R_omega_space -> forall a : set , a :e Romega_D_scaled_diffs x y -> a :e R.
Axiom Romega_D_scaled_diffs_bounded : forall x y : set , x :e R_omega_space -> y :e R_omega_space -> exists u : set , u :e R /\ forall a : set , a :e Romega_D_scaled_diffs x y -> a :e R -> Rle a u.
Axiom Romega_D_metric_value_is_lub : forall x y : set , x :e R_omega_space -> y :e R_omega_space -> R_lub (Romega_D_scaled_diffs x y) (Romega_D_metric_value x y).
Axiom Romega_D_metric_value_sym : forall x y : set , x :e R_omega_space -> y :e R_omega_space -> Romega_D_metric_value x y = Romega_D_metric_value y x.
Axiom Romega_D_metric_value_self_zero : forall x : set , x :e R_omega_space -> Romega_D_metric_value x x = 0.
Axiom Romega_D_metric_value_in_R : forall x y : set , x :e R_omega_space -> y :e R_omega_space -> Romega_D_metric_value x y :e R.
Axiom Romega_D_metric_value_nonneg : forall x y : set , x :e R_omega_space -> y :e R_omega_space -> ~ (Rlt (Romega_D_metric_value x y) 0).
Axiom Romega_D_metric_value_eq0_coord_eq : forall x y : set , x :e R_omega_space -> y :e R_omega_space -> Romega_D_metric_value x y = 0 -> forall i : set , i :e omega -> apply_fun x i = apply_fun y i.
Axiom Romega_D_metric_value_ub_scaled : forall x y i : set , x :e R_omega_space -> y :e R_omega_space -> i :e omega -> Rle (mul_SNo (R_bounded_distance (apply_fun x i) (apply_fun y i)) (inv_nat (ordsucc i))) (Romega_D_metric_value x y).
Axiom Romega_D_metric_value_lt_implies_scaled_lt : forall x y i r : set , x :e R_omega_space -> y :e R_omega_space -> i :e omega -> Rlt (Romega_D_metric_value x y) r -> Rlt (mul_SNo (R_bounded_distance (apply_fun x i) (apply_fun y i)) (inv_nat (ordsucc i))) r.
Axiom R_bounded_distance_lt_lt1_imp_abs_lt : forall a b r : set , a :e R -> b :e R -> r :e R -> Rlt r 1 -> Rlt (R_bounded_distance a b) r -> abs_SNo (add_SNo a (minus_SNo b)) < r.
Axiom abs_lt_lt1_imp_R_bounded_distance_lt : forall a b r : set , a :e R -> b :e R -> r :e R -> Rlt r 1 -> abs_SNo (add_SNo a (minus_SNo b)) < r -> Rlt (R_bounded_distance a b) r.
Axiom Romega_D_metric_coord_abs_lt : forall x y i delta : set , x :e R_omega_space -> y :e R_omega_space -> i :e omega -> delta :e R -> Rlt 0 delta -> Rlt delta 1 -> Rlt (Romega_D_metric_value x y) (mul_SNo delta (inv_nat (ordsucc i))) -> abs_SNo (add_SNo (apply_fun x i) (minus_SNo (apply_fun y i))) < delta.
Axiom div_SNo_1_eq_inv_nat : forall n : set , SNo n -> div_SNo 1 n = inv_nat n.
Axiom inv_nat_1_eq_1 : inv_nat 1 = 1.
Axiom inv_nat_ordsucc_antitone : forall i j : set , i :e omega -> j :e omega -> i :e j -> Rlt (inv_nat (ordsucc j)) (inv_nat (ordsucc i)).
Axiom inv_nat_2_lt_1 : Rlt (inv_nat 2) 1.
Axiom exists_inv_nat_ordsucc_lt : forall r : set , r :e R -> Rlt 0 r -> exists N : set , N :e omega /\ Rlt (inv_nat (ordsucc N)) r.
Axiom Romega_D_metric_value_triangle : forall x y z : set , x :e R_omega_space -> y :e R_omega_space -> z :e R_omega_space -> ~ (Rlt (add_SNo (Romega_D_metric_value x y) (Romega_D_metric_value y z)) (Romega_D_metric_value x z)).
Definition Romega_D_metric : set := graph (setprod R_omega_space R_omega_space) (fun p : set => Romega_D_metric_value (p 0) (p 1)).
Axiom Romega_D_metric_function_on : function_on Romega_D_metric (setprod R_omega_space R_omega_space) R.
Definition Romega_D_metric_topology : set := metric_topology R_omega_space Romega_D_metric.
Axiom Romega_D_metric_open_ball_in_product_topology : forall x r : set , metric_on R_omega_space Romega_D_metric -> x :e R_omega_space -> r :e R -> Rlt 0 r -> open_ball R_omega_space Romega_D_metric x r :e R_omega_product_topology.
Axiom Romega_product_cylinder_in_D_metric_topology : forall i U : set , metric_on R_omega_space Romega_D_metric -> i :e omega -> U :e R_standard_topology -> product_cylinder omega (const_space_family omega R R_standard_topology) i U :e Romega_D_metric_topology.
Axiom Romega_D_metric_induces_product_topology : metric_on R_omega_space Romega_D_metric /\ Romega_D_metric_topology = R_omega_product_topology.
Definition open_cover : set -> set -> set -> prop := fun X Tx U => (forall u : set , u :e U -> u :e Tx) /\ covers X U.
Axiom open_cover_members_open : forall X Tx U u : set , open_cover X Tx U -> u :e U -> u :e Tx.
Axiom open_cover_implies_covers : forall X Tx U : set , open_cover X Tx U -> covers X U.
Axiom open_cover_of_implies_open_cover : forall X Tx Fam : set , open_cover_of X Tx Fam -> open_cover X Tx Fam.
Axiom open_cover_family_sub : forall X Tx U : set , topology_on X Tx -> open_cover X Tx U -> U c= Power X.
Axiom open_cover_implies_open_cover_of : forall X Tx Fam : set , topology_on X Tx -> open_cover X Tx Fam -> open_cover_of X Tx Fam.
Definition Lindelof_space : set -> set -> prop := fun X Tx => topology_on X Tx /\ forall U : set , open_cover X Tx U -> exists V : set , countable_subcollection V U /\ covers X V.
Axiom countable_space_implies_Lindelof_space : forall X Tx : set , topology_on X Tx -> countable X -> Lindelof_space X Tx.
Axiom compact_space_implies_Lindelof_space : forall X Tx : set , compact_space X Tx -> Lindelof_space X Tx.
Definition Sorgenfrey_line : set := R.
Definition Sorgenfrey_topology : set := R_lower_limit_topology.
Axiom Sorgenfrey_topology_local_halfopen_refine : forall U x : set , U :e Sorgenfrey_topology -> x :e U -> exists b : set , b :e R /\ Rlt x b /\ halfopen_interval_left x b c= U.
Axiom R_lower_limit_topology_Hausdorff : Hausdorff_space R R_lower_limit_topology.
Axiom Sorgenfrey_line_Hausdorff : Hausdorff_space Sorgenfrey_line Sorgenfrey_topology.
Definition countable_basis_at : set -> set -> set -> prop := fun X Tx x => topology_on X Tx /\ x :e X /\ exists B : set , B c= Tx /\ countable_set B /\ (forall b : set , b :e B -> x :e b) /\ (forall U : set , U :e Tx -> x :e U -> exists b : set , b :e B /\ b c= U).
Definition first_countable_space : set -> set -> prop := fun X Tx => topology_on X Tx /\ forall x : set , x :e X -> countable_basis_at X Tx x.
Axiom open_ball_radius_mono : forall X d x r1 r2 : set , Rlt r1 r2 -> open_ball X d x r1 c= open_ball X d x r2.
Axiom metric_topology_first_countable : forall X d : set , metric_on X d -> first_countable_space X (metric_topology X d).
Axiom uniform_topology_first_countable : first_countable_space real_sequences uniform_topology.
Axiom product_countable_basis_at_point_if_components_first_countable : forall I Xi f : set , countable_index_set I -> I <> Empty -> (forall i : set , i :e I -> first_countable_space (space_family_set Xi i) (space_family_topology Xi i)) -> f :e product_space I Xi -> countable_basis_at (product_space I Xi) (countable_product_topology_subbasis I Xi) f.
Axiom convergent_sequence_implies_closure : forall X Tx A x : set , topology_on X Tx -> A c= X -> (exists seq : set , sequence_in seq A /\ converges_to X Tx seq x) -> x :e closure_of X Tx A.
Axiom equip_finite_transfer : forall X Y : set , equip X Y -> finite Y -> finite X.
Axiom inj_equip_image : forall X Y : set , forall f : set -> set , inj X Y f -> equip X {f x|x :e X}.
Axiom inj_into_finite_nat : forall X n : set , forall f : set -> set , nat_p n -> inj X n f -> finite X.
Axiom first_countable_sequences_detect_closure : forall X Tx A x : set , first_countable_space X Tx -> A c= X -> (x :e closure_of X Tx A <-> exists seq : set , sequence_in seq A /\ converges_to X Tx seq x).
Axiom first_countable_sequences_detect_continuity : forall X Tx Y Ty f : set , topology_on X Tx -> topology_on Y Ty -> (continuous_map X Tx Y Ty f -> forall x seq : set , sequence_on seq X -> converges_to X Tx seq x -> converges_to Y Ty (map_sequence f seq) (apply_fun f x)).
Definition second_countable_space : set -> set -> prop := fun X Tx => topology_on X Tx /\ exists B : set , basis_on X B /\ countable_set B /\ basis_generates X B Tx.
Axiom second_countable_implies_first_countable : forall X Tx : set , second_countable_space X Tx -> first_countable_space X Tx.
Axiom R_standard_topology_second_countable : second_countable_space R R_standard_topology.
Axiom euclidean_spaces_second_countable : forall n : set , n :e omega -> second_countable_space (euclidean_space n) (euclidean_topology n).
Definition discrete_subspace : set -> set -> set -> prop := fun X Tx A => A c= X /\ (forall a : set , a :e A -> exists U : set , U :e Tx /\ U :/\: A = {a}).
Axiom second_countable_discrete_subspace_countable : forall X Tx A : set , second_countable_space X Tx -> discrete_subspace X Tx A -> countable_set A.
Definition binary_sequences_Romega : set := {f :e real_sequences|forall n : set , n :e omega -> apply_fun f n :e {0,1}}.
Axiom binary_sequences_Romega_uncountable : ~ countable_set binary_sequences_Romega.
Axiom real_sequences_in_Power_setprod : forall f : set , f :e real_sequences -> f :e Power (setprod omega R).
Axiom real_sequences_total : forall f : set , f :e real_sequences -> total_function_on f omega R.
Axiom real_sequences_functional : forall f : set , f :e real_sequences -> functional_graph f.
Axiom real_sequences_neq_exists_coord : forall f g : set , f :e real_sequences -> g :e real_sequences -> f <> g -> exists n : set , n :e omega /\ apply_fun f n <> apply_fun g n.
Axiom uniform_metric_Romega_binary_dist_1 : forall f g : set , f :e binary_sequences_Romega -> g :e binary_sequences_Romega -> f <> g -> apply_fun uniform_metric_Romega (f,g) = 1.
Axiom binary_sequences_Romega_discrete_in_uniform_topology : discrete_subspace real_sequences uniform_topology binary_sequences_Romega.
Axiom Romega_uniform_first_not_second_countable : first_countable_space real_sequences uniform_topology /\ ~ second_countable_space real_sequences uniform_topology.
Axiom countability_axioms_subspace_product : forall X Tx : set , topology_on X Tx -> (forall A : set , A c= X -> first_countable_space X Tx -> first_countable_space A (subspace_topology X Tx A)) /\ (forall A : set , A c= X -> second_countable_space X Tx -> second_countable_space A (subspace_topology X Tx A)) /\ (forall I Xi : set , countable_index_set I -> (forall i : set , i :e I -> first_countable_space (space_family_set Xi i) (space_family_topology Xi i)) -> first_countable_space (countable_product_space I Xi) (countable_product_topology_subbasis I Xi)) /\ (forall I Xi : set , countable_index_set I -> (forall i : set , i :e I -> second_countable_space (space_family_set Xi i) (space_family_topology Xi i)) -> second_countable_space (countable_product_space I Xi) (countable_product_topology_subbasis I Xi)).
Definition dense_in : set -> set -> set -> prop := fun A X Tx => closure_of X Tx A = X.
Definition separable_space : set -> set -> prop := fun X Tx => exists D : set , countable_set D /\ dense_in D X Tx.
Axiom separable_spaceI : forall X Tx D : set , countable_set D -> dense_in D X Tx -> separable_space X Tx.
Axiom separable_spaceE : forall X Tx : set , separable_space X Tx -> exists D : set , countable_set D /\ dense_in D X Tx.
Definition countable_dense_subset : set -> set -> prop := fun X Tx => exists D : set , D c= X /\ countable D /\ dense_in D X Tx.
Axiom countable_dense_subset_implies_separable : forall X Tx : set , countable_dense_subset X Tx -> separable_space X Tx.
Axiom binintersect_with_space_right : forall X U A : set , U c= X -> U :/\: (A :/\: X) = U :/\: A.
Axiom closure_of_binintersect_space_eq : forall X Tx A : set , topology_on X Tx -> closure_of X Tx (A :/\: X) = closure_of X Tx A.
Axiom separable_implies_countable_dense_subset : forall X Tx : set , topology_on X Tx -> separable_space X Tx -> countable_dense_subset X Tx.
Axiom dense_in_superset : forall A B X Tx : set , topology_on X Tx -> A c= B -> B c= X -> dense_in A X Tx -> dense_in B X Tx.
Axiom meets_nonempty_open_implies_dense_in : forall A X Tx : set , topology_on X Tx -> (forall U : set , U :e Tx -> U <> Empty -> U :/\: A <> Empty) -> dense_in A X Tx.
Axiom countable_basis_implies_Lindelof : forall X Tx : set , topology_on X Tx -> second_countable_space X Tx -> forall U : set , open_cover X Tx U -> exists V : set , countable_subcollection V U /\ covers X V.
Axiom second_countable_implies_Lindelof_space : forall X Tx : set , second_countable_space X Tx -> Lindelof_space X Tx.
Axiom countable_basis_implies_separable : forall X Tx : set , topology_on X Tx -> second_countable_space X Tx -> exists D : set , countable_set D /\ dense_in D X Tx.
Axiom countable_basis_implies_separable_space : forall X Tx : set , topology_on X Tx -> second_countable_space X Tx -> separable_space X Tx.
Axiom Sorgenfrey_line_first_countable : first_countable_space Sorgenfrey_line Sorgenfrey_topology.
Axiom Sorgenfrey_line_rationals_dense : dense_in rational_numbers Sorgenfrey_line Sorgenfrey_topology.
Axiom disjoint_open_family_countable_of_dense : forall X Tx D Fam : set , topology_on X Tx -> dense_in D X Tx -> countable_set D -> Fam c= Tx -> (forall U : set , U :e Fam -> U <> Empty) -> pairwise_disjoint Fam -> countable_set Fam.
Axiom Sorgenfrey_line_not_second_countable : ~ second_countable_space Sorgenfrey_line Sorgenfrey_topology.
Axiom Sorgenfrey_line_Lindelof : Lindelof_space Sorgenfrey_line Sorgenfrey_topology.
Axiom Sorgenfrey_line_countability : first_countable_space Sorgenfrey_line Sorgenfrey_topology /\ dense_in rational_numbers Sorgenfrey_line Sorgenfrey_topology /\ Lindelof_space Sorgenfrey_line Sorgenfrey_topology /\ ~ second_countable_space Sorgenfrey_line Sorgenfrey_topology.
Definition Sorgenfrey_plane_topology : set := product_topology Sorgenfrey_line Sorgenfrey_topology Sorgenfrey_line Sorgenfrey_topology.
Definition Sorgenfrey_plane_rational_points : set := setprod rational_numbers rational_numbers.
Axiom Sorgenfrey_plane_rational_points_countable : countable_set Sorgenfrey_plane_rational_points.
Axiom Sorgenfrey_plane_rational_points_dense : dense_in Sorgenfrey_plane_rational_points (setprod Sorgenfrey_line Sorgenfrey_line) Sorgenfrey_plane_topology.
Definition one_point_sets_closed : set -> set -> prop := fun X Tx => topology_on X Tx /\ forall x : set , x :e X -> closed_in X Tx {x}.
Axiom metric_topology_one_point_sets_closed : forall X d : set , metric_on X d -> one_point_sets_closed X (metric_topology X d).
Axiom Hausdorff_one_point_sets_closed : forall X Tx : set , Hausdorff_space X Tx -> one_point_sets_closed X Tx.
Definition regular_space : set -> set -> prop := fun X Tx => one_point_sets_closed X Tx /\ forall x : set , x :e X -> forall F : set , closed_in X Tx F -> x /:e F -> exists U V : set , U :e Tx /\ V :e Tx /\ x :e U /\ F c= V /\ U :/\: V = Empty.
Definition normal_space : set -> set -> prop := fun X Tx => one_point_sets_closed X Tx /\ forall A B : set , closed_in X Tx A -> closed_in X Tx B -> A :/\: B = Empty -> exists U V : set , U :e Tx /\ V :e Tx /\ A c= U /\ B c= V /\ U :/\: V = Empty.
Axiom normal_space_topology_on : forall X Tx : set , normal_space X Tx -> topology_on X Tx.
Axiom regular_space_topology_on : forall X Tx : set , regular_space X Tx -> topology_on X Tx.
Axiom regular_space_open_nbhd_closure_sub : forall X Tx U x : set , regular_space X Tx -> U :e Tx -> x :e U -> exists V : set , V :e Tx /\ x :e V /\ closure_of X Tx V c= U.
Axiom discrete_normal_space : forall X : set , normal_space X (discrete_topology X).
Axiom regular_space_implies_Hausdorff : forall X Tx : set , regular_space X Tx -> Hausdorff_space X Tx.
Axiom normal_space_implies_regular : forall X Tx : set , normal_space X Tx -> regular_space X Tx.
Definition Hausdorff_spaces_family : set -> set -> prop := fun I Xi => forall i : set , i :e I -> Hausdorff_space (product_component Xi i) (product_component_topology Xi i).
Definition regular_spaces_family : set -> set -> prop := fun I Xi => forall i : set , i :e I -> regular_space (product_component Xi i) (product_component_topology Xi i).
Definition uncountable_set : set -> prop := fun X => ~ countable_set X.
Axiom uncountable_set_ne_Empty : forall X : set , uncountable_set X -> X <> Empty.
Axiom uncountable_set_setminus_countable : forall X C : set , uncountable_set X -> countable_set C -> uncountable_set (X :\: C).
Axiom uncountable_set_setminus_finite : forall X F : set , uncountable_set X -> finite F -> uncountable_set (X :\: F).
Axiom uncountable_set_exists_outside_countable : forall X C : set , uncountable_set X -> countable_set C -> exists x : set , x :e X /\ x /:e C.
Axiom uncountable_set_exists_outside_finite : forall X F : set , uncountable_set X -> finite F -> exists x : set , x :e X /\ x /:e F.
Axiom famunion_countable : forall I : set , countable_set I -> forall F : set -> set , (forall i : set , i :e I -> countable_set (F i)) -> countable_set (Union {F i|i :e I}).
Axiom omega_Subq_infinite_ordinal : forall alpha : set , ordinal alpha -> infinite alpha -> omega c= alpha.
Axiom uncountable_set_atleastp_omega : forall X : set , uncountable_set X -> atleastp omega X.
Definition countable_subsets_bounded : set -> prop := fun X => forall A : set , A c= X -> countable_set A -> exists b : set , b :e X /\ forall a : set , a :e A -> a :e b.
Axiom mem_implies_order_rel_well_ordered : forall X a b : set , well_ordered_set X -> a :e b -> order_rel X a b.
Axiom order_rel_well_ordered_implies_mem : forall X a b : set , well_ordered_set X -> order_rel X a b -> a :e b.
Axiom open_ray_lower_well_ordered_1_eq_singleton0 : forall X : set , well_ordered_set X -> 1 :e X -> open_ray_lower X 1 = {0}.
Axiom open_ray_lower_in_order_topology : forall X b : set , b :e X -> open_ray_lower X b :e order_topology X.
Axiom open_ray_upper_in_order_topology : forall X a : set , a :e X -> open_ray_upper X a :e order_topology X.
Axiom open_ray_upper_in_R_standard_topology : forall a : set , a :e R -> open_ray_upper R a :e R_standard_topology.
Axiom open_ray_lower_in_R_standard_topology : forall b : set , b :e R -> open_ray_lower R b :e R_standard_topology.
Axiom open_ray_rectangle_in_R2_standard_topology : forall q : set , q :e R -> rectangle_set (open_ray_lower R q) (open_ray_upper R q) :e R2_standard_topology.
Axiom R2_strict_lt_open : {p :e EuclidPlane|Rlt (p 0) (p 1)} :e R2_standard_topology.
Axiom open_ray_rectangle_swapped_in_R2_standard_topology : forall q : set , q :e R -> rectangle_set (open_ray_upper R q) (open_ray_lower R q) :e R2_standard_topology.
Axiom R2_strict_gt_open : {p :e EuclidPlane|Rlt (p 1) (p 0)} :e R2_standard_topology.
Axiom continuous_Rlt_preimage_open : forall X Tx g h : set , continuous_map X Tx R R_standard_topology g -> continuous_map X Tx R R_standard_topology h -> {x :e X|Rlt (apply_fun g x) (apply_fun h x)} :e Tx.
Axiom continuous_Rlt_preimage_open_swapped : forall X Tx g h : set , continuous_map X Tx R R_standard_topology g -> continuous_map X Tx R R_standard_topology h -> {x :e X|Rlt (apply_fun h x) (apply_fun g x)} :e Tx.
Axiom continuous_Rle_preimage_closed : forall X Tx g h : set , continuous_map X Tx R R_standard_topology g -> continuous_map X Tx R R_standard_topology h -> closed_in X Tx {x :e X|Rle (apply_fun g x) (apply_fun h x)}.
Axiom singleton0_open_in_order_topology_well_ordered : forall X : set , well_ordered_set X -> 1 :e X -> {0} :e order_topology X.
Axiom singleton0_open_in_order_topology_well_ordered_nonempty : forall X : set , well_ordered_set X -> simply_ordered_set X -> 0 :e X -> {0} :e order_topology X.
Definition separating_family_of_functions : set -> set -> set -> set -> prop := fun X Tx F J => topology_on X Tx /\ total_function_on F J (function_space X R) /\ (forall j : set , j :e J -> continuous_map X Tx R R_standard_topology (apply_fun F j)) /\ (forall x0 : set , x0 :e X -> forall U : set , U :e Tx -> x0 :e U -> exists j : set , j :e J /\ Rlt 0 (apply_fun (apply_fun F j) x0) /\ forall x : set , x :e X :\: U -> apply_fun (apply_fun F j) x = 0).
Axiom separating_family_of_functions_separates_points : forall X Tx F J x y : set , topology_on X Tx -> one_point_sets_closed X Tx -> separating_family_of_functions X Tx F J -> x :e X -> y :e X -> x <> y -> exists j : set , j :e J /\ apply_fun (apply_fun F j) x <> apply_fun (apply_fun F j) y.
Definition diagonal_map : set -> set -> set -> set := fun X F J => graph X (fun x : set => graph J (fun j : set => apply_fun (apply_fun F j) x)).
Axiom diagonal_map_coord_apply : forall X F J x i : set , x :e X -> i :e J -> apply_fun (apply_fun (diagonal_map X F J) x) i = apply_fun (apply_fun F i) x.
Definition embedding_of : set -> set -> set -> set -> set -> prop := fun X Tx Y Ty f => continuous_map X Tx Y Ty f /\ homeomorphism X Tx (image_of f X) (subspace_topology Y Ty (image_of f X)) f.
Axiom embedding_of_continuous : forall X Tx Y Ty f : set , embedding_of X Tx Y Ty f -> continuous_map X Tx Y Ty f.
Axiom embedding_of_homeomorphism : forall X Tx Y Ty f : set , embedding_of X Tx Y Ty f -> homeomorphism X Tx (image_of f X) (subspace_topology Y Ty (image_of f X)) f.
Axiom embedding_of_from_local_refinement : forall X Tx Y Ty f : set , continuous_map X Tx Y Ty f -> (forall x U : set , x :e X -> U :e Tx -> x :e U -> exists V : set , V :e Ty /\ apply_fun f x :e V /\ preimage_of X f V c= U) -> (forall x y : set , x :e X -> y :e X -> apply_fun f x = apply_fun f y -> x = y) -> embedding_of X Tx Y Ty f.
Definition power_real : set -> set := fun J => product_space J (const_space_family J R R_standard_topology).
Definition unit_interval_power : set -> set := fun J => product_space J (const_space_family J unit_interval unit_interval_topology).
Axiom power_real_Subq_function_space : forall J : set , power_real J c= function_space J R.
Definition power_real_coord_abs_diff : set -> set -> set -> set := fun f g j => abs_SNo (add_SNo (apply_fun f j) (minus_SNo (apply_fun g j))).
Definition power_real_coord_clipped_diff : set -> set -> set -> set := fun f g j => If_i (Rlt (power_real_coord_abs_diff f g j) 1) (power_real_coord_abs_diff f g j) 1.
Definition power_real_clipped_diffs : set -> set -> set -> set := fun J f g => Repl J (fun j : set => power_real_coord_clipped_diff f g j).
Definition power_real_uniform_metric_value : set -> set -> set -> set := fun J f g => If_i (J = Empty) 0 (Eps_i (fun r : set => R_lub (power_real_clipped_diffs J f g) r)).
Definition uniform_metric_power_real : set -> set := fun J => graph (setprod (power_real J) (power_real J)) (fun p : set => power_real_uniform_metric_value J (p 0) (p 1)).
Definition uniform_topology_power_real : set -> set := fun J => metric_topology (power_real J) (uniform_metric_power_real J).
Axiom power_real_coord_clipped_diff_eq_R_bounded_distance : forall J f g j : set , j :e J -> f :e power_real J -> g :e power_real J -> power_real_coord_clipped_diff f g j = R_bounded_distance (apply_fun f j) (apply_fun g j).
Axiom power_real_coord_in_R : forall J f j : set , j :e J -> f :e power_real J -> apply_fun f j :e R.
Axiom power_real_ext : forall J f g : set , f :e power_real J -> g :e power_real J -> (forall j : set , j :e J -> apply_fun f j = apply_fun g j) -> f = g.
Axiom power_real_clipped_diffs_in_R : forall J f g a : set , f :e power_real J -> g :e power_real J -> a :e power_real_clipped_diffs J f g -> a :e R.
Axiom power_real_coord_clipped_diff_le_1 : forall J f g j : set , j :e J -> f :e power_real J -> g :e power_real J -> Rle (power_real_coord_clipped_diff f g j) 1.
Axiom power_real_clipped_diffs_nonempty : forall J f g : set , J <> Empty -> f :e power_real J -> g :e power_real J -> exists a0 : set , a0 :e power_real_clipped_diffs J f g.
Axiom power_real_uniform_metric_value_is_lub : forall J f g : set , J <> Empty -> f :e power_real J -> g :e power_real J -> R_lub (power_real_clipped_diffs J f g) (power_real_uniform_metric_value J f g).
Axiom power_real_coord_clipped_diff_le_uniform_metric_value : forall J f g j : set , j :e J -> f :e power_real J -> g :e power_real J -> Rle (power_real_coord_clipped_diff f g j) (power_real_uniform_metric_value J f g).
Axiom power_real_coord_clipped_diff_lt_of_uniform_metric_value_lt : forall J f g j r : set , j :e J -> f :e power_real J -> g :e power_real J -> r :e R -> Rlt (power_real_uniform_metric_value J f g) r -> Rlt (power_real_coord_clipped_diff f g j) r.
Axiom power_real_uniform_metric_value_in_R : forall J f g : set , f :e power_real J -> g :e power_real J -> power_real_uniform_metric_value J f g :e R.
Axiom uniform_metric_power_real_apply : forall J x y : set , x :e power_real J -> y :e power_real J -> apply_fun (uniform_metric_power_real J) (x,y) = power_real_uniform_metric_value J x y.
Axiom power_real_clipped_diffs_sym : forall J f g : set , f :e power_real J -> g :e power_real J -> power_real_clipped_diffs J f g = power_real_clipped_diffs J g f.
Axiom power_real_clipped_diffs_diag_eq_Sing0 : forall J f : set , J <> Empty -> f :e power_real J -> power_real_clipped_diffs J f f = {0}.
Axiom power_real_uniform_metric_value_sym : forall J f g : set , f :e power_real J -> g :e power_real J -> power_real_uniform_metric_value J f g = power_real_uniform_metric_value J g f.
Axiom power_real_uniform_metric_value_self_zero : forall J f : set , f :e power_real J -> power_real_uniform_metric_value J f f = 0.
Axiom uniform_metric_power_real_function_on : forall J : set , function_on (uniform_metric_power_real J) (setprod (power_real J) (power_real J)) R.
Axiom power_real_uniform_metric_value_nonneg : forall J f g : set , f :e power_real J -> g :e power_real J -> ~ (Rlt (power_real_uniform_metric_value J f g) 0).
Axiom power_real_uniform_metric_value_eq0_coord_eq : forall J x y j : set , J <> Empty -> x :e power_real J -> y :e power_real J -> j :e J -> power_real_uniform_metric_value J x y = 0 -> apply_fun x j = apply_fun y j.
Axiom power_real_uniform_metric_value_triangle : forall J x y z : set , x :e power_real J -> y :e power_real J -> z :e power_real J -> ~ (Rlt (add_SNo (power_real_uniform_metric_value J x y) (power_real_uniform_metric_value J y z)) (power_real_uniform_metric_value J x z)).
Axiom uniform_metric_power_real_is_metric_on : forall J : set , metric_on (power_real J) (uniform_metric_power_real J).
Definition one_minus_fun : set := graph R (fun t : set => add_SNo 1 (minus_SNo t)).
Axiom one_minus_fun_value_in_R : forall t : set , t :e R -> apply_fun one_minus_fun t :e R.
Axiom one_minus_fun_0 : apply_fun one_minus_fun 0 = 1.
Axiom one_minus_fun_1 : apply_fun one_minus_fun 1 = 0.
Axiom one_minus_fun_continuous : continuous_map R R_standard_topology R R_standard_topology one_minus_fun.
Definition neg_fun : set := graph R (fun t : set => minus_SNo t).
Axiom neg_fun_value_in_R : forall t : set , t :e R -> apply_fun neg_fun t :e R.
Axiom neg_fun_in_function_space : neg_fun :e function_space R R.
Axiom neg_fun_apply : forall t : set , t :e R -> apply_fun neg_fun t = minus_SNo t.
Axiom minus_SNo_minus_SNo_R : forall t : set , t :e R -> minus_SNo (minus_SNo t) = t.
Axiom neg_fun_flip_upper : forall a t : set , a :e R -> t :e R -> (Rlt a (minus_SNo t) <-> Rlt t (minus_SNo a)).
Axiom neg_fun_flip_lower : forall t b : set , t :e R -> b :e R -> (Rlt (minus_SNo t) b <-> Rlt (minus_SNo b) t).
Axiom preimage_neg_fun_open_ray_upper : forall a : set , a :e R -> preimage_of R neg_fun (open_ray_upper R a) = open_ray_lower R (minus_SNo a).
Axiom preimage_neg_fun_open_ray_lower : forall b : set , b :e R -> preimage_of R neg_fun (open_ray_lower R b) = open_ray_upper R (minus_SNo b).
Axiom neg_fun_continuous : continuous_map R R_standard_topology R R_standard_topology neg_fun.
Definition add_fun_R : set := graph (setprod R R) (fun p : set => add_SNo (p 0) (p 1)).
Definition mul_fun_R : set := graph (setprod R R) (fun p : set => mul_SNo (p 0) (p 1)).
Definition mul_const_fun : set -> set := fun c => graph R (fun t : set => mul_SNo t c).
Axiom add_fun_R_value_in_R : forall p : set , p :e setprod R R -> apply_fun add_fun_R p :e R.
Axiom add_fun_R_in_function_space : add_fun_R :e function_space (setprod R R) R.
Axiom mul_fun_R_in_function_space : mul_fun_R :e function_space (setprod R R) R.
Axiom compose_pair_map_mul_in_total_function_space_R : forall X f g : set , f :e total_function_space X R -> g :e total_function_space X R -> compose_fun X (pair_map X f g) mul_fun_R :e total_function_space X R.
Axiom add_fun_R_apply : forall p : set , p :e setprod R R -> apply_fun add_fun_R p = add_SNo (p 0) (p 1).
Axiom preimage_add_fun_R_open_ray_upper_in_product_topology : forall a : set , a :e R -> preimage_of (setprod R R) add_fun_R (open_ray_upper R a) :e (product_topology R R_standard_topology R R_standard_topology).
Axiom preimage_add_fun_R_open_ray_lower_in_product_topology : forall b : set , b :e R -> preimage_of (setprod R R) add_fun_R (open_ray_lower R b) :e (product_topology R R_standard_topology R R_standard_topology).
Axiom add_fun_R_continuous : continuous_map (setprod R R) (product_topology R R_standard_topology R R_standard_topology) R R_standard_topology add_fun_R.
Definition normalize01_fun : set := graph R (fun t : set => div_SNo (mul_SNo t t) (add_SNo (mul_SNo t t) (mul_SNo (add_SNo t (minus_SNo 1)) (add_SNo t (minus_SNo 1))))).
Axiom normalize01_fun_value_in_R : forall t : set , t :e R -> apply_fun normalize01_fun t :e R.
Axiom normalize01_fun_range_in_unit_interval : forall t : set , t :e R -> apply_fun normalize01_fun t :e unit_interval.
Axiom normalize01_fun_img_in_open_ray_upper_iff : forall a t : set , a :e R -> t :e R -> (apply_fun normalize01_fun t :e open_ray_upper R a <-> Rlt a (apply_fun normalize01_fun t)).
Axiom normalize01_fun_img_in_open_ray_lower_iff : forall b t : set , b :e R -> t :e R -> (apply_fun normalize01_fun t :e open_ray_lower R b <-> Rlt (apply_fun normalize01_fun t) b).
Axiom normalize01_fun_den_pos : forall t : set , t :e R -> 0 < add_SNo (mul_SNo t t) (mul_SNo (add_SNo t (minus_SNo 1)) (add_SNo t (minus_SNo 1))).
Axiom normalize01_fun_pos_of_neq0 : forall t : set , t :e R -> t <> 0 -> Rlt 0 (apply_fun normalize01_fun t).
Axiom normalize01_fun_lt1_of_neq1 : forall t : set , t :e R -> t <> 1 -> Rlt (apply_fun normalize01_fun t) 1.
Axiom normalize01_fun_0 : apply_fun normalize01_fun 0 = 0.
Axiom normalize01_fun_1 : apply_fun normalize01_fun 1 = 1.
Axiom normalize01_fun_gt_iff_mul_den_lt_num : forall a t : set , a :e R -> t :e R -> 0 < a -> a < 1 -> (a < apply_fun normalize01_fun t <-> mul_SNo a (add_SNo (mul_SNo t t) (mul_SNo (add_SNo t (minus_SNo 1)) (add_SNo t (minus_SNo 1)))) < (mul_SNo t t)).
Axiom normalize01_fun_lt_iff_num_lt_mul_den : forall b t : set , b :e R -> t :e R -> 0 < b -> (apply_fun normalize01_fun t < b <-> (mul_SNo t t) < mul_SNo b (add_SNo (mul_SNo t t) (mul_SNo (add_SNo t (minus_SNo 1)) (add_SNo t (minus_SNo 1))))).
Axiom open_ball_R_bounded_metric_abs_early : forall x r y : set , x :e R -> r :e R -> Rlt 0 r -> Rlt r 1 -> (y :e open_ball R R_bounded_metric x r <-> (y :e R /\ Rlt (R_bounded_distance x y) r)).
Axiom open_ball_R_bounded_metric_absdiff_lt : forall x r y : set , x :e R -> r :e R -> Rlt 0 r -> Rlt r 1 -> y :e open_ball R R_bounded_metric x r -> abs_SNo (add_SNo x (minus_SNo y)) < r.
Axiom open_ball_R_bounded_metric_eq_R_if_1_lt_early : forall c r : set , c :e R -> r :e R -> Rlt 1 r -> open_ball R R_bounded_metric c r = R.
Axiom open_ball_R_bounded_metric_eq_open_interval_early : forall c r : set , c :e R -> r :e R -> Rlt 0 r -> Rlt r 1 -> open_ball R R_bounded_metric c r = open_interval (add_SNo c (minus_SNo r)) (add_SNo c r).
Axiom open_ball_R_bounded_metric_r1_eq_open_interval_early : forall c : set , c :e R -> open_ball R R_bounded_metric c 1 = open_interval (add_SNo c (minus_SNo 1)) (add_SNo c 1).
Axiom open_ball_R_bounded_metric_in_R_standard_topology_early : forall c r : set , c :e R -> r :e R -> Rlt 0 r -> open_ball R R_bounded_metric c r :e R_standard_topology.
Axiom R_bounded_metric_is_metric_on_early : metric_on R R_bounded_metric.
Axiom mul_const_fun_apply : forall c t : set , c :e R -> t :e R -> apply_fun (mul_const_fun c) t = mul_SNo t c.
Axiom mul_const_fun_in_function_space : forall c : set , c :e R -> mul_const_fun c :e function_space R R.
Axiom mul_const_fun_value_in_R : forall c t : set , c :e R -> t :e R -> apply_fun (mul_const_fun c) t :e R.
Axiom preimage_mul_const_open_ray_upper : forall c a : set , c :e R -> 0 < c -> a :e R -> preimage_of R (mul_const_fun c) (open_ray_upper R a) = open_ray_upper R (div_SNo a c).
Axiom preimage_mul_const_open_ray_lower : forall c b : set , c :e R -> 0 < c -> b :e R -> preimage_of R (mul_const_fun c) (open_ray_lower R b) = open_ray_lower R (div_SNo b c).
Axiom mul_const_fun_continuous_pos : forall c : set , c :e R -> 0 < c -> continuous_map R R_standard_topology R R_standard_topology (mul_const_fun c).
Axiom mul_const_fun_continuous : forall c : set , c :e R -> continuous_map R R_standard_topology R R_standard_topology (mul_const_fun c).
Axiom add_two_continuous_R : forall X Tx g h : set , topology_on X Tx -> continuous_map X Tx R R_standard_topology g -> continuous_map X Tx R R_standard_topology h -> continuous_map X Tx R R_standard_topology (compose_fun X (pair_map X g h) add_fun_R).
Axiom mul_fun_R_value_in_R : forall p : set , p :e setprod R R -> apply_fun mul_fun_R p :e R.
Axiom mul_fun_R_apply : forall p : set , p :e setprod R R -> apply_fun mul_fun_R p = mul_SNo (p 0) (p 1).
Axiom abs_SNo_mul_nonneg_left : forall x y : set , SNo x -> SNo y -> 0 <= x -> abs_SNo (mul_SNo x y) = mul_SNo x (abs_SNo y).
Axiom abs_SNo_mul_eq : forall x y : set , SNo x -> SNo y -> abs_SNo (mul_SNo x y) = mul_SNo (abs_SNo x) (abs_SNo y).
Axiom preimage_mul_fun_R_open_ray_upper_in_product_topology : forall a : set , a :e R -> preimage_of (setprod R R) mul_fun_R (open_ray_upper R a) :e (product_topology R R_standard_topology R R_standard_topology).
Axiom preimage_mul_fun_R_open_ray_lower_in_product_topology : forall b : set , b :e R -> preimage_of (setprod R R) mul_fun_R (open_ray_lower R b) :e (product_topology R R_standard_topology R R_standard_topology).
Axiom mul_fun_R_continuous : continuous_map (setprod R R) (product_topology R R_standard_topology R R_standard_topology) R R_standard_topology mul_fun_R.
Axiom mul_two_continuous_R : forall X Tx g h : set , topology_on X Tx -> continuous_map X Tx R R_standard_topology g -> continuous_map X Tx R R_standard_topology h -> continuous_map X Tx R R_standard_topology (compose_fun X (pair_map X g h) mul_fun_R).
Axiom mul_two_continuous_unit_interval : forall X Tx f g : set , topology_on X Tx -> continuous_map X Tx unit_interval unit_interval_topology f -> continuous_map X Tx unit_interval unit_interval_topology g -> continuous_map X Tx unit_interval unit_interval_topology (compose_fun X (pair_map X f g) mul_fun_R).
Axiom add_of_pair_map_apply : forall A f g a : set , a :e A -> apply_fun f a :e R -> apply_fun g a :e R -> apply_fun (compose_fun A (pair_map A f g) add_fun_R) a = add_SNo (apply_fun f a) (apply_fun g a).
Axiom mul_of_pair_map_apply : forall A f g a : set , a :e A -> apply_fun f a :e R -> apply_fun g a :e R -> apply_fun (compose_fun A (pair_map A f g) mul_fun_R) a = mul_SNo (apply_fun f a) (apply_fun g a).
Axiom normalize01_fun_preimage_open_ray_upper_mid : forall a : set , a :e R -> ~ (Rlt a 0) -> Rlt a 1 -> preimage_of R normalize01_fun (open_ray_upper R a) :e R_standard_topology.
Axiom normalize01_fun_preimage_open_ray_upper : forall a : set , a :e R -> preimage_of R normalize01_fun (open_ray_upper R a) :e R_standard_topology.
Axiom normalize01_fun_preimage_open_ray_lower_mid : forall b : set , b :e R -> ~ (Rlt 1 b) -> Rlt 0 b -> preimage_of R normalize01_fun (open_ray_lower R b) :e R_standard_topology.
