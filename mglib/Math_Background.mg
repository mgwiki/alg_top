    {
      exact (HxswSingleton i HiNw).
    }
    claim HxsIxsw : apply_fun xs i = apply_fun xsw i.
    {
      symmetry.
      exact HxswIxs.
    }
    exact (eq_i_tra
      (apply_fun xs i)
      (apply_fun xsw i)
      (apply_fun (graph 1 (fun _:set => apply_fun gensH0 alpha)) i)
      HxsIxsw
      HxswIsingle).
