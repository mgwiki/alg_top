											        }
											
											        (** Use IHt at tp to compare xsA1 and xsB1. **)
											        claim Hprefix_pack : n1A = n1B /\ (forall i:set, i :e n1A -> apply_fun xsA1 i = apply_fun xsB1 i).
											        {
											          claim Ptp : P tp.
											          { exact (IHt tp Htp_in_t). }
