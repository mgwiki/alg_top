claim HrOdd :
  forall p:set, p :e R2_minus_origin ->
    apply_fun r (Rn_negate 2 p) = Rn_negate 2 (apply_fun r p).
{
  let p.
  assume HpR2m0.
  claim HpR2 : p :e setprod R R.
  {
    exact (SepE1
      (setprod R R)
