      A
      B
      p
      HpAB).
  }
  claim HpB : p :e B.
  {
    exact (binintersectE2
      A
      B
      p
      HpAB).
  }
  claim HpX : p :e X.
  {
    exact (HAsub
      p
      HpA).
  }
  claim Hle01 : Rle (p 0) (p 1).
  {
    exact (SepE2
      X
      (fun q:set => Rle (q 0) (q 1))
      p
      HpA).
