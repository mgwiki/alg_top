      forall n1 n2:set, n1 :e omega -> n2 :e omega -> 
      forall a1 a2:set, function_on a1 n1 J -> function_on a2 n2 J ->
      forall x1 x2:set, function_on x1 n1 G -> function_on x2 n2 G ->
        (forall i:set, i :e n1 -> apply_fun x1 i :e apply_fun Gfam (apply_fun a1 i)) ->
        (forall i:set, i :e n2 -> apply_fun x2 i :e apply_fun Gfam (apply_fun a2 i)) ->
        (forall i j:set, i :e n1 -> j :e n1 -> i <> j -> apply_fun a1 i <> apply_fun a1 j) ->
        (forall i j:set, i :e n2 -> j :e n2 -> i <> j -> apply_fun a2 i <> apply_fun a2 j) ->
        x = nat_primrec e (fun i r => apply_fun mult (r, apply_fun x1 i)) n1 ->
        x = nat_primrec e (fun i r => apply_fun mult (r, apply_fun x2 i)) n2 ->
        (forall alpha:set, alpha :e J ->
          (forall i j:set, i :e n1 -> j :e n2 ->
            apply_fun a1 i = alpha -> apply_fun a2 j = alpha ->
            apply_fun x1 i = apply_fun x2 j) /\
          ((exists i:set, i :e n1 /\ apply_fun a1 i = alpha) ->
           ~(exists j:set, j :e n2 /\ apply_fun a2 j = alpha) ->
           forall i:set, i :e n1 -> apply_fun a1 i = alpha -> apply_fun x1 i = e) /\
          (~(exists i:set, i :e n1 /\ apply_fun a1 i = alpha) ->
           (exists j:set, j :e n2 /\ apply_fun a2 j = alpha) ->
           forall j:set, j :e n2 -> apply_fun a2 j = alpha -> apply_fun x2 j = e))).
  apply andI.
  + exact HsGA.
  + (** Prove uniqueness condition from zero-sum **)
    let x. assume Hx : x :e G.
    let n1 n2. assume Hn1 : n1 :e omega. assume Hn2 : n2 :e omega.
    let a1 a2. assume Ha1 : function_on a1 n1 J. assume Ha2 : function_on a2 n2 J.
    let x1 x2. assume Hx1 : function_on x1 n1 G. assume Hx2 : function_on x2 n2 G.
    assume Hxfam1 : forall i:set, i :e n1 -> apply_fun x1 i :e apply_fun Gfam (apply_fun a1 i).
    assume Hxfam2 : forall i:set, i :e n2 -> apply_fun x2 i :e apply_fun Gfam (apply_fun a2 i).
    assume Hinj1 : forall i j:set, i :e n1 -> j :e n1 -> i <> j -> apply_fun a1 i <> apply_fun a1 j.
    assume Hinj2 : forall i j:set, i :e n2 -> j :e n2 -> i <> j -> apply_fun a2 i <> apply_fun a2 j.
    assume Hrep1 : x = nat_primrec e (fun i r => apply_fun mult (r, apply_fun x1 i)) n1.
    assume Hrep2 : x = nat_primrec e (fun i r => apply_fun mult (r, apply_fun x2 i)) n2.
    claim Hprodeq : nat_primrec e (fun i r => apply_fun mult (r, apply_fun x1 i)) n1 =
      nat_primrec e (fun i r => apply_fun mult (r, apply_fun x2 i)) n2.
    { rewrite <- Hrep1. rewrite <- Hrep2. reflexivity. }
    apply (xm (n1 = 0)).
    - assume Hn1_eq0 : n1 = 0.
      (** n1=0: clause 1,2 vacuous; clause 3 by zero-sum **)
      claim Hprod1_e : nat_primrec e (fun i r => apply_fun mult (r, apply_fun x1 i)) n1 = e.
      { rewrite Hn1_eq0. exact (nat_primrec_0 e (fun i r => apply_fun mult (r, apply_fun x1 i))). }
      claim Hprod2_e : nat_primrec e (fun i r => apply_fun mult (r, apply_fun x2 i)) n2 = e.
      { rewrite <- Hprodeq. exact Hprod1_e. }
      let alpha. assume HalJ : alpha :e J.
      apply and3I.
      * let i j. assume Hi : i :e n1.
        claim Hi0 : i :e 0. { rewrite <- Hn1_eq0. exact Hi. }
        exact (FalseE (EmptyE i Hi0)
          (j :e n2 -> apply_fun a1 i = alpha -> apply_fun a2 j = alpha -> apply_fun x1 i = apply_fun x2 j)).
      * assume Hex. apply Hex. let i. assume Hand.
        claim Hi : i :e n1. { exact (andEL (i :e n1) (apply_fun a1 i = alpha) Hand). }
        claim Hi0 : i :e 0. { rewrite <- Hn1_eq0. exact Hi. }
        exact (FalseE (EmptyE i Hi0)
          (~(exists j:set, j :e n2 /\ apply_fun a2 j = alpha) ->
           forall i0:set, i0 :e n1 -> apply_fun a1 i0 = alpha -> apply_fun x1 i0 = e)).
      * assume _. assume Hex_j. let j. assume Hj : j :e n2. assume Ha2j : apply_fun a2 j = alpha.
        apply (xm (n2 = 0)).
        + assume Hn2_eq0 : n2 = 0.
          claim Hj0 : j :e 0. { rewrite <- Hn2_eq0. exact Hj. }
          exact (FalseE (EmptyE j Hj0) (apply_fun x2 j = e)).
        + assume Hn2_ne : n2 <> 0.
          exact (Hzs n2 Hn2 Hn2_ne a2 Ha2 Hinj2 x2 Hx2 Hxfam2 Hprod2_e j Hj).
    - assume Hn1_ne : n1 <> 0.
      apply (xm (n2 = 0)).
      + assume Hn2_eq0 : n2 = 0.
        (** n2=0: clause 1,3 vacuous; clause 2 by zero-sum **)
        claim Hprod2_e : nat_primrec e (fun i r => apply_fun mult (r, apply_fun x2 i)) n2 = e.
        { rewrite Hn2_eq0. exact (nat_primrec_0 e (fun i r => apply_fun mult (r, apply_fun x2 i))). }
        claim Hprod1_e : nat_primrec e (fun i r => apply_fun mult (r, apply_fun x1 i)) n1 = e.
        { rewrite Hprodeq. exact Hprod2_e. }
        let alpha. assume HalJ : alpha :e J.
        apply and3I.
        * let i j. assume Hi : i :e n1. assume Hj : j :e n2.
          claim Hj0 : j :e 0. { rewrite <- Hn2_eq0. exact Hj. }
          exact (FalseE (EmptyE j Hj0)
            (apply_fun a1 i = alpha -> apply_fun a2 j = alpha -> apply_fun x1 i = apply_fun x2 j)).
        * assume Hex_i. assume _.
          let i. assume Hi : i :e n1. assume Ha1i : apply_fun a1 i = alpha.
          exact (Hzs n1 Hn1 Hn1_ne a1 Ha1 Hinj1 x1 Hx1 Hxfam1 Hprod1_e i Hi).
        * assume _. assume Hex_j. apply Hex_j. let j. assume Hand.
          claim Hj : j :e n2. { exact (andEL (j :e n2) (apply_fun a2 j = alpha) Hand). }
          claim Hj0 : j :e 0. { rewrite <- Hn2_eq0. exact Hj. }
          exact (FalseE (EmptyE j Hj0)
            (forall j0:set, j0 :e n2 -> apply_fun a2 j0 = alpha -> apply_fun x2 j0 = e)).
      + assume Hn2_ne : n2 <> 0.
        exact (zero_sum_component_extraction G mult e inv J Gfam HabG HsubGfam Hzs
          n1 n2 Hn1 Hn2 Hn1_ne Hn2_ne a1 a2 Ha1 Ha2 x1 x2 Hx1 Hx2
          Hxfam1 Hxfam2 Hinj1 Hinj2 Hprodeq).
Qed.

(** from S67 Exercise 3 (line 2706 in algtop.tex) **)
(** LATEX VERSION: If G is free abelian with basis {x, y}, then {2x+3y, x-y} is also a basis. **)
(** EFFORT: 5 lines textbook, difficulty 3/10, USD 50 **)
(** Bounty 55 **)
Theorem ex67_3_change_of_basis :
  forall G mult e inv x y:set,
  free_abelian_group_with_basis G mult e inv 2 (graph 2 (fun i =>
    if i = 0 then x else y)) ->
  free_abelian_group_with_basis G mult e inv 2 (graph 2 (fun i =>
    if i = 0
    then apply_fun mult (group_power_nat mult e x 2, group_power_nat mult e y 3)
    else apply_fun mult (x, apply_fun inv y))).
let G mult e inv x y.
assume Hfree_old.
set oldbasis := graph 2 (fun i => if i = 0 then x else y).
set newbasis := graph 2 (fun i =>
  if i = 0
  then apply_fun mult (group_power_nat mult e x 2, group_power_nat mult e y 3)
  else apply_fun mult (x, apply_fun inv y)).
claim Hfree_old' : free_abelian_group_with_basis G mult e inv 2 oldbasis.
{ exact Hfree_old. }
claim Hold_left :
  (abelian_group G mult e inv /\ function_on oldbasis 2 G) /\
  (forall alpha:set, alpha :e 2 ->
    infinite_cyclic_subgroup G mult e inv (apply_fun oldbasis alpha)).
{
  set oldfam := graph 2 (fun alpha:set =>
    {g :e G | exists n:set, n :e int /\
      ((n :e omega /\ g = group_power_nat mult e (apply_fun oldbasis alpha) n) \/
       (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
        g = group_power_nat mult e (apply_fun inv (apply_fun oldbasis alpha)) (ordsucc m)))}).
  claim Hfree_old'' :
    ((abelian_group G mult e inv /\ function_on oldbasis 2 G) /\
      (forall alpha:set, alpha :e 2 ->
        infinite_cyclic_subgroup G mult e inv (apply_fun oldbasis alpha))) /\
    direct_sum_of_subgroups G mult e inv 2 oldfam.
  {
    exact Hfree_old'.
  }
  exact (andEL
    ((abelian_group G mult e inv /\ function_on oldbasis 2 G) /\
      (forall alpha:set, alpha :e 2 ->
        infinite_cyclic_subgroup G mult e inv (apply_fun oldbasis alpha)))
    (direct_sum_of_subgroups G mult e inv 2 oldfam)
    Hfree_old'').
}
claim Hold_ab_fn : abelian_group G mult e inv /\ function_on oldbasis 2 G.
{ exact (andEL
    (abelian_group G mult e inv /\ function_on oldbasis 2 G)
    (forall alpha:set, alpha :e 2 ->
      infinite_cyclic_subgroup G mult e inv (apply_fun oldbasis alpha))
    Hold_left). }
claim HabG : abelian_group G mult e inv.
{ exact (andEL
    (abelian_group G mult e inv)
    (function_on oldbasis 2 G)
    Hold_ab_fn). }
claim Hold_fn : function_on oldbasis 2 G.
{ exact (andER
    (abelian_group G mult e inv)
    (function_on oldbasis 2 G)
    Hold_ab_fn). }
claim Hold_inf :
  forall alpha:set, alpha :e 2 ->
    infinite_cyclic_subgroup G mult e inv (apply_fun oldbasis alpha).
{ exact (andER
    (abelian_group G mult e inv /\ function_on oldbasis 2 G)
    (forall alpha:set, alpha :e 2 ->
      infinite_cyclic_subgroup G mult e inv (apply_fun oldbasis alpha))
    Hold_left). }
claim HgrpG : group_structure G mult e inv.
{ exact (andEL
    (group_structure G mult e inv)
    (forall u v:set, u :e G -> v :e G -> apply_fun mult (u, v) = apply_fun mult (v, u))
    HabG). }
claim Hbasis0 : apply_fun oldbasis 0 = x.
{
  rewrite (apply_fun_graph 2 (fun i => if i = 0 then x else y) 0 In_0_2).
  claim H00 : 0 = 0.
  { reflexivity. }
  rewrite (If_i_1 (0 = 0) x y H00).
  reflexivity.
}
claim Hbasis1 : apply_fun oldbasis 1 = y.
{
  rewrite (apply_fun_graph 2 (fun i => if i = 0 then x else y) 1 In_1_2).
  rewrite (If_i_0 (1 = 0) x y neq_1_0).
  reflexivity.
}
claim HxG : x :e G.
{ rewrite <- Hbasis0.
  exact (Hold_fn 0 In_0_2). }
claim HyG : y :e G.
{ rewrite <- Hbasis1.
  exact (Hold_fn 1 In_1_2). }
claim Hx2G : group_power_nat mult e x 2 :e G.
{
  apply (and4E
    (apply_fun oldbasis 0 :e G)
    (forall n:set, n :e omega -> group_power_nat mult e (apply_fun oldbasis 0) n :e G)
    (forall m:set, m :e omega ->
      group_power_nat mult e (apply_fun inv (apply_fun oldbasis 0)) (ordsucc m) :e G)
    (~(exists n:set, n :e omega /\ n <> 0 /\
      group_power_nat mult e (apply_fun oldbasis 0) n = e))
    (Hold_inf 0 In_0_2)).
  assume _ Hpow0 _ _.
  rewrite <- Hbasis0.
  exact (Hpow0 2 (nat_p_omega 2 nat_2)).
}
claim H3O : 3 :e omega.
{ exact (nat_p_omega 3 (nat_ordsucc 2 nat_2)). }
claim Hy3G : group_power_nat mult e y 3 :e G.
{
  apply (and4E
    (apply_fun oldbasis 1 :e G)
    (forall n:set, n :e omega -> group_power_nat mult e (apply_fun oldbasis 1) n :e G)
    (forall m:set, m :e omega ->
      group_power_nat mult e (apply_fun inv (apply_fun oldbasis 1)) (ordsucc m) :e G)
    (~(exists n:set, n :e omega /\ n <> 0 /\
      group_power_nat mult e (apply_fun oldbasis 1) n = e))
    (Hold_inf 1 In_1_2)).
  assume _ Hpow1 _ _.
  rewrite <- Hbasis1.
  exact (Hpow1 3 H3O).
}
claim HmultFn : function_on mult (setprod G G) G.
{
  apply (and6E
    (function_on mult (setprod G G) G)
    (function_on inv G G)
    (e :e G)
    (forall u v w:set, u :e G -> v :e G -> w :e G ->
      apply_fun mult (apply_fun mult (u, v), w) = apply_fun mult (u, apply_fun mult (v, w)))
    (forall u:set, u :e G -> apply_fun mult (e, u) = u /\ apply_fun mult (u, e) = u)
    (forall u:set, u :e G ->
      apply_fun mult (u, apply_fun inv u) = e /\ apply_fun mult (apply_fun inv u, u) = e)
    HgrpG).
  assume HmultFn HinvFn HeG Hassoc Hid HinvLaw.
  exact HmultFn.
}
claim HinvFn : function_on inv G G.
{
  apply (and6E
    (function_on mult (setprod G G) G)
    (function_on inv G G)
    (e :e G)
    (forall u v w:set, u :e G -> v :e G -> w :e G ->
      apply_fun mult (apply_fun mult (u, v), w) = apply_fun mult (u, apply_fun mult (v, w)))
    (forall u:set, u :e G -> apply_fun mult (e, u) = u /\ apply_fun mult (u, e) = u)
    (forall u:set, u :e G ->
      apply_fun mult (u, apply_fun inv u) = e /\ apply_fun mult (apply_fun inv u, u) = e)
    HgrpG).
  assume HmultFn HinvFn HeG Hassoc Hid HinvLaw.
  exact HinvFn.
}
claim Hnew0G :
  apply_fun mult (group_power_nat mult e x 2, group_power_nat mult e y 3) :e G.
{
  exact (HmultFn
    (group_power_nat mult e x 2, group_power_nat mult e y 3)
    (tuple_2_setprod_by_pair_Sigma G G
      (group_power_nat mult e x 2)
      (group_power_nat mult e y 3)
      Hx2G
      Hy3G)).
}
claim HinvyG : apply_fun inv y :e G.
{ exact (HinvFn y HyG). }
claim Hnew1G : apply_fun mult (x, apply_fun inv y) :e G.
{
  exact (HmultFn
    (x, apply_fun inv y)
    (tuple_2_setprod_by_pair_Sigma G G x (apply_fun inv y) HxG HinvyG)).
}
claim Hnew_fn : function_on newbasis 2 G.
{
  let i.
  assume Hi : i :e 2.
  rewrite (apply_fun_graph 2 (fun i0:set =>
    if i0 = 0
    then apply_fun mult (group_power_nat mult e x 2, group_power_nat mult e y 3)
    else apply_fun mult (x, apply_fun inv y)) i Hi).
  apply (in_2_cases i Hi).
  - assume Hi0 : i = 0.
    rewrite (If_i_1
      (i = 0)
      (apply_fun mult (group_power_nat mult e x 2, group_power_nat mult e y 3))
      (apply_fun mult (x, apply_fun inv y))
      Hi0).
    exact Hnew0G.
  - assume Hi1 : i = 1.
    claim Hine0 : ~(i = 0).
    { rewrite Hi1.
      exact neq_1_0. }
    rewrite (If_i_0
      (i = 0)
      (apply_fun mult (group_power_nat mult e x 2, group_power_nat mult e y 3))
      (apply_fun mult (x, apply_fun inv y))
      Hine0).
    exact Hnew1G.
}
claim Hgoal_new : free_abelian_group_with_basis G mult e inv 2 newbasis.
{
  set newfam := graph 2 (fun alpha:set =>
    {g :e G | exists n:set, n :e int /\
      ((n :e omega /\ g = group_power_nat mult e (apply_fun newbasis alpha) n) \/
       (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
        g = group_power_nat mult e (apply_fun inv (apply_fun newbasis alpha)) (ordsucc m)))}).
  apply (and4I
    (abelian_group G mult e inv)
    (function_on newbasis 2 G)
    (forall alpha:set, alpha :e 2 ->
      infinite_cyclic_subgroup G mult e inv (apply_fun newbasis alpha))
    (direct_sum_of_subgroups G mult e inv 2 newfam)).
  - exact HabG.
  - exact Hnew_fn.
  - let alpha.
    assume Halpha : alpha :e 2.
    apply (in_2_cases alpha Halpha).
    + assume Ha0 : alpha = 0.
      claim Hnew0eq :
        apply_fun newbasis alpha =
        apply_fun mult (group_power_nat mult e x 2, group_power_nat mult e y 3).
      {
        rewrite Ha0.
        rewrite (apply_fun_graph 2 (fun i0:set =>
          if i0 = 0
          then apply_fun mult (group_power_nat mult e x 2, group_power_nat mult e y 3)
          else apply_fun mult (x, apply_fun inv y)) 0 In_0_2).
        claim H00 : 0 = 0.
        { reflexivity. }
        rewrite (If_i_1
          (0 = 0)
          (apply_fun mult (group_power_nat mult e x 2, group_power_nat mult e y 3))
          (apply_fun mult (x, apply_fun inv y))
          H00).
        reflexivity.
      }
      admit.
    + assume Ha1 : alpha = 1.
      claim Hnew1eq :
        apply_fun newbasis alpha =
        apply_fun mult (x, apply_fun inv y).
      {
        rewrite Ha1.
        rewrite (apply_fun_graph 2 (fun i0:set =>
          if i0 = 0
          then apply_fun mult (group_power_nat mult e x 2, group_power_nat mult e y 3)
          else apply_fun mult (x, apply_fun inv y)) 1 In_1_2).
        rewrite (If_i_0
          (1 = 0)
          (apply_fun mult (group_power_nat mult e x 2, group_power_nat mult e y 3))
          (apply_fun mult (x, apply_fun inv y))
          neq_1_0).
        reflexivity.
      }
      admit.
  - admit.
}
exact Hgoal_new.
Admitted.

(** from S67 Exercise 4(a) (line 2708 in algtop.tex) **)
(** LATEX VERSION: The elements of finite order in an abelian group G form a subgroup (torsion subgroup). **)
(** EFFORT: 5 lines textbook, difficulty 3/10, USD 50 **)
(** Collected Alice 50 **)
(** Proven Alice **)
Theorem ex67_4a_torsion_subgroup :
  forall G mult e inv:set,
  abelian_group G mult e inv ->
  subgroup_of
    {a :e G | exists m:set, m :e omega /\ m <> 0 /\ group_power_nat mult e a m = e}
    G mult e inv.
let G mult e inv.
assume Hab : abelian_group G mult e inv.
claim Hcomm : forall x y:set, x :e G -> y :e G -> apply_fun mult (x, y) = apply_fun mult (y, x).
{ exact (andER (group_structure G mult e inv) (forall x y:set, x :e G -> y :e G -> apply_fun mult (x, y) = apply_fun mult (y, x)) Hab). }
apply (and6E
  (function_on mult (setprod G G) G)
  (function_on inv G G)
  (e :e G)
  (forall x y z:set, x :e G -> y :e G -> z :e G ->
    apply_fun mult (apply_fun mult (x, y), z) = apply_fun mult (x, apply_fun mult (y, z)))
  (forall x:set, x :e G -> apply_fun mult (e, x) = x /\ apply_fun mult (x, e) = x)
  (forall x:set, x :e G ->
    apply_fun mult (x, apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x, x) = e)
  (andEL (group_structure G mult e inv)
    (forall x y:set, x :e G -> y :e G -> apply_fun mult (x, y) = apply_fun mult (y, x)) Hab)).
assume HmultF HinvG HeG Hassoc Hid Hinverse.
claim HmG : forall x y:set, x :e G -> y :e G -> apply_fun mult (x, y) :e G.
{ let x y. assume HxG HyG.
  exact (HmultF (x, y) (tuple_2_setprod_by_pair_Sigma G G x y HxG HyG)). }
claim HidL : forall x:set, x :e G -> apply_fun mult (e, x) = x.
{ let x. assume HxG.
  exact (andEL (apply_fun mult (e, x) = x) (apply_fun mult (x, e) = x) (Hid x HxG)). }
claim HidR : forall x:set, x :e G -> apply_fun mult (x, e) = x.
{ let x. assume HxG.
  exact (andER (apply_fun mult (e, x) = x) (apply_fun mult (x, e) = x) (Hid x HxG)). }
claim HinvR : forall x:set, x :e G -> apply_fun mult (x, apply_fun inv x) = e.
{ let x. assume HxG.
  exact (andEL
    (apply_fun mult (x, apply_fun inv x) = e)
    (apply_fun mult (apply_fun inv x, x) = e) (Hinverse x HxG)). }
set T : set := {a :e G | exists m:set, m :e omega /\ m <> 0 /\ group_power_nat mult e a m = e}.
set P : set -> prop := fun a => exists m:set, m :e omega /\ m <> 0 /\ group_power_nat mult e a m = e.
(** Helper: a^n :e G **)
claim HpowG : forall a:set, a :e G -> forall n:set, n :e omega ->
  group_power_nat mult e a n :e G.
{
  let a. assume HaG : a :e G.
  claim Hnat : forall n:set, nat_p n -> group_power_nat mult e a n :e G.
  {
    apply nat_ind.
    - prove group_power_nat mult e a 0 :e G.
      claim H0 : group_power_nat mult e a 0 = e.
      { exact (nat_primrec_0 e (fun _ r => apply_fun mult (a, r))). }
      rewrite H0. exact HeG.
    - let n. assume Hn : nat_p n.
      assume IH : group_power_nat mult e a n :e G.
      prove group_power_nat mult e a (ordsucc n) :e G.
      claim HS : group_power_nat mult e a (ordsucc n) =
        apply_fun mult (a, group_power_nat mult e a n).
      { exact (nat_primrec_S e (fun _ r => apply_fun mult (a, r)) n Hn). }
      rewrite HS. exact (HmG a (group_power_nat mult e a n) HaG IH).
  }
  let n. assume HnO : n :e omega.
  exact (Hnat n (omega_nat_p n HnO)).
}
(** Helper: if a^k = e then a^{k+p} = a^p **)
claim Hshift : forall a:set, a :e G -> forall k:set, k :e omega ->
  group_power_nat mult e a k = e ->
  forall p:set, p :e omega ->
    group_power_nat mult e a (add_nat k p) = group_power_nat mult e a p.
{
  let a. assume HaG. let k. assume HkO. assume Hak : group_power_nat mult e a k = e.
  claim Hnat : forall p:set, nat_p p ->
    group_power_nat mult e a (add_nat k p) = group_power_nat mult e a p.
  {
    apply nat_ind.
    - prove group_power_nat mult e a (add_nat k 0) = group_power_nat mult e a 0.
      rewrite (add_nat_0R k).
      rewrite Hak.
      claim H0 : group_power_nat mult e a 0 = e.
      { exact (nat_primrec_0 e (fun _ r => apply_fun mult (a, r))). }
      rewrite H0. reflexivity.
    - let p. assume Hp : nat_p p.
      assume IH : group_power_nat mult e a (add_nat k p) = group_power_nat mult e a p.
      prove group_power_nat mult e a (add_nat k (ordsucc p)) = group_power_nat mult e a (ordsucc p).
      claim HkpN : nat_p (add_nat k p).
      { exact (add_nat_p k (omega_nat_p k HkO) p Hp). }
      claim Hksp : add_nat k (ordsucc p) = ordsucc (add_nat k p).
      { exact (add_nat_SR k p Hp). }
      claim Hstep1 : group_power_nat mult e a (ordsucc (add_nat k p)) =
        apply_fun mult (a, group_power_nat mult e a (add_nat k p)).
      { exact (nat_primrec_S e (fun _ r => apply_fun mult (a, r)) (add_nat k p) HkpN). }
      claim Hstep2 : group_power_nat mult e a (ordsucc p) =
        apply_fun mult (a, group_power_nat mult e a p).
      { exact (nat_primrec_S e (fun _ r => apply_fun mult (a, r)) p Hp). }
      rewrite Hksp. rewrite Hstep1. rewrite Hstep2. rewrite IH. reflexivity.
  }
  let p. assume HpO. exact (Hnat p (omega_nat_p p HpO)).
}
(** Helper: if a^k = e then a^{k x n} = e **)
claim Hmultzero : forall a:set, a :e G -> forall k:set, k :e omega ->
  group_power_nat mult e a k = e ->
  forall n:set, n :e omega -> group_power_nat mult e a (mul_nat k n) = e.
{
  let a. assume HaG. let k. assume HkO. assume Hak.
  claim Hnat : forall n:set, nat_p n -> group_power_nat mult e a (mul_nat k n) = e.
  {
    apply nat_ind.
    - prove group_power_nat mult e a (mul_nat k 0) = e.
      rewrite (mul_nat_0R k).
      exact (nat_primrec_0 e (fun _ r => apply_fun mult (a, r))).
    - let n. assume Hn : nat_p n. assume IH : group_power_nat mult e a (mul_nat k n) = e.
      prove group_power_nat mult e a (mul_nat k (ordsucc n)) = e.
      claim HknO : mul_nat k n :e omega.
      { exact (nat_p_omega (mul_nat k n) (mul_nat_p k (omega_nat_p k HkO) n Hn)). }
      rewrite (mul_nat_SR k n Hn).
      rewrite (Hshift a HaG k HkO Hak (mul_nat k n) HknO).
      exact IH.
  }
  let n. assume HnO. exact (Hnat n (omega_nat_p n HnO)).
}
(** Helper: abelian power distribution **)
claim Hdist : forall a b:set, a :e G -> b :e G -> forall n:set, n :e omega ->
  group_power_nat mult e (apply_fun mult (a, b)) n =
  apply_fun mult (group_power_nat mult e a n, group_power_nat mult e b n).
{
  let a b. assume HaG : a :e G. assume HbG : b :e G.
  claim Hnat : forall n:set, nat_p n ->
    group_power_nat mult e (apply_fun mult (a, b)) n =
    apply_fun mult (group_power_nat mult e a n, group_power_nat mult e b n).
  {
    apply nat_ind.
    - prove group_power_nat mult e (apply_fun mult (a, b)) 0 =
        apply_fun mult (group_power_nat mult e a 0, group_power_nat mult e b 0).
      claim H0ab : group_power_nat mult e (apply_fun mult (a, b)) 0 = e.
      { exact (nat_primrec_0 e (fun _ r => apply_fun mult (apply_fun mult (a, b), r))). }
      claim H0a : group_power_nat mult e a 0 = e.
      { exact (nat_primrec_0 e (fun _ r => apply_fun mult (a, r))). }
      claim H0b : group_power_nat mult e b 0 = e.
      { exact (nat_primrec_0 e (fun _ r => apply_fun mult (b, r))). }
      rewrite H0ab. rewrite H0a. rewrite H0b.
      prove e = apply_fun mult (e, e).
      symmetry. exact (HidL e HeG).
    - let n. assume Hn : nat_p n.
      assume IH : group_power_nat mult e (apply_fun mult (a, b)) n =
        apply_fun mult (group_power_nat mult e a n, group_power_nat mult e b n).
      prove group_power_nat mult e (apply_fun mult (a, b)) (ordsucc n) =
        apply_fun mult (group_power_nat mult e a (ordsucc n), group_power_nat mult e b (ordsucc n)).
      claim HnO : n :e omega. { exact (nat_p_omega n Hn). }
      claim HanG : group_power_nat mult e a n :e G. { exact (HpowG a HaG n HnO). }
      claim HbnG : group_power_nat mult e b n :e G. { exact (HpowG b HbG n HnO). }
      claim HSab : group_power_nat mult e (apply_fun mult (a, b)) (ordsucc n) =
        apply_fun mult (apply_fun mult (a, b), group_power_nat mult e (apply_fun mult (a, b)) n).
      { exact (nat_primrec_S e (fun _ r => apply_fun mult (apply_fun mult (a, b), r)) n Hn). }
      claim HSa : group_power_nat mult e a (ordsucc n) =
        apply_fun mult (a, group_power_nat mult e a n).
      { exact (nat_primrec_S e (fun _ r => apply_fun mult (a, r)) n Hn). }
      claim HSb : group_power_nat mult e b (ordsucc n) =
        apply_fun mult (b, group_power_nat mult e b n).
      { exact (nat_primrec_S e (fun _ r => apply_fun mult (b, r)) n Hn). }
      rewrite HSab. rewrite IH. rewrite HSa. rewrite HSb.
      (** Goal: mult(ab, mult(an, bn)) = mult(mult(a, an), mult(b, bn)) **)
      claim HanbnG : apply_fun mult (group_power_nat mult e a n, group_power_nat mult e b n) :e G.
      { exact (HmG (group_power_nat mult e a n) (group_power_nat mult e b n) HanG HbnG). }
      claim HbbnG : apply_fun mult (b, group_power_nat mult e b n) :e G.
      { exact (HmG b (group_power_nat mult e b n) HbG HbnG). }
      claim HabG : apply_fun mult (a, b) :e G. { exact (HmG a b HaG HbG). }
      rewrite (Hassoc a b (apply_fun mult (group_power_nat mult e a n, group_power_nat mult e b n))
        HaG HbG HanbnG).
      rewrite <- (Hassoc b (group_power_nat mult e a n) (group_power_nat mult e b n)
        HbG HanG HbnG).
      rewrite (Hcomm b (group_power_nat mult e a n) HbG HanG).
      rewrite (Hassoc (group_power_nat mult e a n) b (group_power_nat mult e b n)
        HanG HbG HbnG).
      rewrite <- (Hassoc a (group_power_nat mult e a n)
        (apply_fun mult (b, group_power_nat mult e b n)) HaG HanG HbbnG).
      reflexivity.
  }
  let n. assume HnO. exact (Hnat n (omega_nat_p n HnO)).
}
(** Helper: e^n = e **)
claim Hpow_e : forall n:set, n :e omega -> group_power_nat mult e e n = e.
{
  claim Hnat : forall n:set, nat_p n -> group_power_nat mult e e n = e.
  {
    apply nat_ind.
    - prove group_power_nat mult e e 0 = e.
      exact (nat_primrec_0 e (fun _ r => apply_fun mult (e, r))).
    - let n. assume Hn : nat_p n. assume IH : group_power_nat mult e e n = e.
      prove group_power_nat mult e e (ordsucc n) = e.
      claim HS : group_power_nat mult e e (ordsucc n) =
        apply_fun mult (e, group_power_nat mult e e n).
      { exact (nat_primrec_S e (fun _ r => apply_fun mult (e, r)) n Hn). }
      rewrite HS. rewrite IH. exact (HidL e HeG).
  }
  let n. assume HnO. exact (Hnat n (omega_nat_p n HnO)).
}
(** Main proof: 4 parts of subgroup_of **)
prove T c= G /\
  e :e T /\
  (forall x y:set, x :e T -> y :e T -> apply_fun mult (x, y) :e T) /\
  (forall x:set, x :e T -> apply_fun inv x :e T).
apply and4I.
- prove T c= G.
  let a. assume HaT : a :e T.
  exact (SepE1 G P a HaT).
- prove e :e T.
  apply (SepI G P e).
  + exact HeG.
  + prove exists m:set, m :e omega /\ m <> 0 /\ group_power_nat mult e e m = e.
    witness (ordsucc 0).
    apply and3I.
    * prove ordsucc 0 :e omega.
      exact (nat_p_omega (ordsucc 0) (nat_ordsucc 0 nat_0)).
    * prove ordsucc 0 <> 0.
      exact (neq_ordsucc_0 0).
    * prove group_power_nat mult e e (ordsucc 0) = e.
      claim HS : group_power_nat mult e e (ordsucc 0) =
        apply_fun mult (e, group_power_nat mult e e 0).
      { exact (nat_primrec_S e (fun _ r => apply_fun mult (e, r)) 0 nat_0). }
      claim H0 : group_power_nat mult e e 0 = e.
      { exact (nat_primrec_0 e (fun _ r => apply_fun mult (e, r))). }
      rewrite HS. rewrite H0. exact (HidL e HeG).
- prove forall x y:set, x :e T -> y :e T -> apply_fun mult (x, y) :e T.
  let x y. assume HxT : x :e T. assume HyT : y :e T.
  claim HxG : x :e G. { exact (SepE1 G P x HxT). }
  claim HyG : y :e G. { exact (SepE1 G P y HyT). }
  claim HxP : P x. { exact (SepE2 G P x HxT). }
  claim HyP : P y. { exact (SepE2 G P y HyT). }
  apply (SepI G P (apply_fun mult (x, y))).
  + exact (HmG x y HxG HyG).
  + prove exists m:set, m :e omega /\ m <> 0 /\
      group_power_nat mult e (apply_fun mult (x, y)) m = e.
    apply HxP.
    let mx. assume Hmx : mx :e omega /\ mx <> 0 /\ group_power_nat mult e x mx = e.
    apply (and3E (mx :e omega) (mx <> 0) (group_power_nat mult e x mx = e) Hmx).
    assume HmxO : mx :e omega. assume Hmx0 : mx <> 0. assume Hxmx : group_power_nat mult e x mx = e.
    apply HyP.
    let my. assume Hmy : my :e omega /\ my <> 0 /\ group_power_nat mult e y my = e.
    apply (and3E (my :e omega) (my <> 0) (group_power_nat mult e y my = e) Hmy).
    assume HmyO : my :e omega. assume Hmy0 : my <> 0. assume Hymy : group_power_nat mult e y my = e.
    set k : set := mul_nat mx my.
    claim HkO : k :e omega.
    { exact (nat_p_omega k (mul_nat_p mx (omega_nat_p mx HmxO) my (omega_nat_p my HmyO))). }
    claim Hk0 : k <> 0.
    { assume Habs : k = 0.
      apply (mul_nat_0_inv mx (omega_nat_p mx HmxO) my (omega_nat_p my HmyO) Habs).
      assume H : mx = 0. exact (Hmx0 H).
      assume H : my = 0. exact (Hmy0 H). }
    witness k.
    apply and3I.
    * exact HkO.
    * exact Hk0.
    * prove group_power_nat mult e (apply_fun mult (x, y)) k = e.
      rewrite (Hdist x y HxG HyG k HkO).
      claim Hxk : group_power_nat mult e x k = e.
      { exact (Hmultzero x HxG mx HmxO Hxmx my HmyO). }
      claim Hyk : group_power_nat mult e y k = e.
      { claim Hkmn : k = mul_nat my mx.
        { exact (mul_nat_com mx (omega_nat_p mx HmxO) my (omega_nat_p my HmyO)). }
        rewrite Hkmn. exact (Hmultzero y HyG my HmyO Hymy mx HmxO). }
      rewrite Hxk. rewrite Hyk. exact (HidL e HeG).
- prove forall x:set, x :e T -> apply_fun inv x :e T.
  let x. assume HxT : x :e T.
  claim HxG : x :e G. { exact (SepE1 G P x HxT). }
  claim HxP : P x. { exact (SepE2 G P x HxT). }
  claim HixG : apply_fun inv x :e G. { exact (HinvG x HxG). }
  apply (SepI G P (apply_fun inv x)).
  + exact HixG.
  + prove exists m:set, m :e omega /\ m <> 0 /\
      group_power_nat mult e (apply_fun inv x) m = e.
    apply HxP.
    let mx. assume Hmx : mx :e omega /\ mx <> 0 /\ group_power_nat mult e x mx = e.
    apply (and3E (mx :e omega) (mx <> 0) (group_power_nat mult e x mx = e) Hmx).
    assume HmxO : mx :e omega. assume Hmx0 : mx <> 0. assume Hxmx : group_power_nat mult e x mx = e.
    witness mx.
    apply and3I.
    * exact HmxO.
    * exact Hmx0.
    * prove group_power_nat mult e (apply_fun inv x) mx = e.
      (** Strategy: (x inv(x))^mx = x^mx (inv x)^mx = e (inv x)^mx **)
      (** Also (x inv(x))^mx = e^mx = e **)
      (** So e = e (inv x)^mx = (inv x)^mx **)
      claim HixmxG : group_power_nat mult e (apply_fun inv x) mx :e G.
      { exact (HpowG (apply_fun inv x) HixG mx HmxO). }
      claim HxmxG : group_power_nat mult e x mx :e G.
      { exact (HpowG x HxG mx HmxO). }
      (** Chain: (x inv x)^mx = x^mx (inv x)^mx, but x inv x = e, so e^mx = x^mx (inv x)^mx **)
      (** e^mx = e, x^mx = e, so e = e (inv x)^mx = (inv x)^mx **)
      (** Prove mult(x^mx, (inv x)^mx) = e two ways, then extract (inv x)^mx = e **)
      claim Hprod_eq : apply_fun mult (group_power_nat mult e x mx, group_power_nat mult e (apply_fun inv x) mx) = e.
      { claim Hdist_xinv : group_power_nat mult e (apply_fun mult (x, apply_fun inv x)) mx =
          apply_fun mult (group_power_nat mult e x mx, group_power_nat mult e (apply_fun inv x) mx).
        { exact (Hdist x (apply_fun inv x) HxG HixG mx HmxO). }
        claim Hxinv_e : apply_fun mult (x, apply_fun inv x) = e.
        { exact (HinvR x HxG). }
        claim Hemx : group_power_nat mult e e mx = e.
        { exact (Hpow_e mx HmxO). }
        claim Hstep1 : group_power_nat mult e (apply_fun mult (x, apply_fun inv x)) mx = e.
        { rewrite Hxinv_e. exact Hemx. }
        rewrite <- Hdist_xinv. exact Hstep1. }
      claim Hprod_eq2 : apply_fun mult (group_power_nat mult e x mx, group_power_nat mult e (apply_fun inv x) mx) =
        apply_fun mult (e, group_power_nat mult e (apply_fun inv x) mx).
      { rewrite Hxmx. reflexivity. }
      claim Hprod_eq3 : apply_fun mult (e, group_power_nat mult e (apply_fun inv x) mx) = e.
      { rewrite <- Hprod_eq2. exact Hprod_eq. }
      claim Hid_applied : apply_fun mult (e, group_power_nat mult e (apply_fun inv x) mx) =
        group_power_nat mult e (apply_fun inv x) mx.
      { exact (HidL (group_power_nat mult e (apply_fun inv x) mx) HixmxG). }
      rewrite <- Hid_applied. exact Hprod_eq3.
Qed.

(** Helper: group power composed is group power of product **)
(** Proven Dave **)
Theorem group_power_nat_of_power_nat :
  forall G mult e inv a k m:set,
  group_structure G mult e inv ->
  a :e G -> k :e omega -> m :e omega ->
  group_power_nat mult e (group_power_nat mult e a k) m =
  group_power_nat mult e a (mul_nat k m).
let G mult e inv a k m.
assume Hgrp HaG HkO HmO.
apply (and6E
  (function_on mult (setprod G G) G)
  (function_on inv G G)
  (e :e G)
  (forall x y z:set, x :e G -> y :e G -> z :e G ->
    apply_fun mult (apply_fun mult (x, y), z) = apply_fun mult (x, apply_fun mult (y, z)))
  (forall x:set, x :e G -> apply_fun mult (e, x) = x /\ apply_fun mult (x, e) = x)
  (forall x:set, x :e G ->
    apply_fun mult (x, apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x, x) = e)
  Hgrp).
assume HmultF HinvG HeG Hassoc Hid Hinverse.
claim HmG : forall x y:set, x :e G -> y :e G -> apply_fun mult (x, y) :e G.
{ let x y. assume HxG HyG.
  exact (HmultF (x, y) (tuple_2_setprod_by_pair_Sigma G G x y HxG HyG)). }
claim HpowkG : group_power_nat mult e a k :e G.
{ exact (nat_ind (fun n => group_power_nat mult e a n :e G)
    (eq_subst_mem (group_power_nat mult e a 0) e G
      (nat_primrec_0 e (fun _ r => apply_fun mult (a, r))) HeG)
    (fun n Hn IH =>
      eq_subst_mem (group_power_nat mult e a (ordsucc n))
        (apply_fun mult (a, group_power_nat mult e a n)) G
        (nat_primrec_S e (fun _ r => apply_fun mult (a, r)) n Hn)
        (HmG a (group_power_nat mult e a n) HaG IH))
    k (omega_nat_p k HkO)). }
claim Hknat : nat_p k. { exact (omega_nat_p k HkO). }
claim Hnat : forall n:set, nat_p n ->
  group_power_nat mult e (group_power_nat mult e a k) n =
  group_power_nat mult e a (mul_nat k n).
{ apply nat_ind.
  - prove group_power_nat mult e (group_power_nat mult e a k) 0 =
      group_power_nat mult e a (mul_nat k 0).
    claim H0L : group_power_nat mult e (group_power_nat mult e a k) 0 = e.
    { exact (nat_primrec_0 e (fun _ r => apply_fun mult (group_power_nat mult e a k, r))). }
    claim Hmk0 : mul_nat k 0 = 0. { exact (mul_nat_0R k). }
    claim Hgpa0 : group_power_nat mult e a 0 = e.
    { exact (nat_primrec_0 e (fun _ r => apply_fun mult (a, r))). }
    rewrite H0L. rewrite Hmk0. symmetry. exact Hgpa0.
  - let n. assume Hn : nat_p n.
    assume IH : group_power_nat mult e (group_power_nat mult e a k) n =
      group_power_nat mult e a (mul_nat k n).
    prove group_power_nat mult e (group_power_nat mult e a k) (ordsucc n) =
      group_power_nat mult e a (mul_nat k (ordsucc n)).
    claim HknO : mul_nat k n :e omega.
    { exact (nat_p_omega (mul_nat k n) (mul_nat_p k Hknat n Hn)). }
    claim HstepL : group_power_nat mult e (group_power_nat mult e a k) (ordsucc n) =
      apply_fun mult (group_power_nat mult e a k, group_power_nat mult e (group_power_nat mult e a k) n).
    { exact (nat_primrec_S e (fun _ r => apply_fun mult (group_power_nat mult e a k, r)) n Hn). }
    claim HstepR : group_power_nat mult e a (mul_nat k (ordsucc n)) =
      apply_fun mult (group_power_nat mult e a k, group_power_nat mult e a (mul_nat k n)).
    { claim Hmksr : mul_nat k (ordsucc n) = add_nat k (mul_nat k n).
      { exact (mul_nat_SR k n Hn). }
      rewrite Hmksr.
      exact (group_power_nat_add_nat_cyclic_helper G mult e inv a k (mul_nat k n)
        Hgrp HaG HkO HknO). }
    rewrite HstepL. rewrite IH. symmetry. exact HstepR. }
exact (Hnat m (omega_nat_p m HmO)).
Qed.

(** from S67 Exercise 4(b) (line 2709 in algtop.tex) **)
(** LATEX VERSION: If G is free abelian, it has no elements of finite order. **)
(** EFFORT: 3 lines textbook, difficulty 2/10, USD 30 **)
(** Collected Dave 37 **)
(** Proven Dave **)
Theorem ex67_4b_free_abelian_no_torsion :
  forall G mult e inv J basis:set,
  free_abelian_group_with_basis G mult e inv J basis ->
  forall a:set, a :e G -> a <> e ->
  ~(exists m:set, m :e omega /\ m <> 0 /\ group_power_nat mult e a m = e).
let G mult e inv J basis.
assume Hfree : free_abelian_group_with_basis G mult e inv J basis.
set Gfam_e : set := graph J (fun alpha:set =>
  {g :e G | exists n:set, n :e int /\
    ((n :e omega /\ g = group_power_nat mult e (apply_fun basis alpha) n) \/
     (exists k:set, k :e omega /\ n = minus_SNo (ordsucc k) /\
      g = group_power_nat mult e (apply_fun inv (apply_fun basis alpha)) (ordsucc k)))}).
apply (and4E
  (abelian_group G mult e inv)
  (function_on basis J G)
  (forall alpha:set, alpha :e J ->
    infinite_cyclic_subgroup G mult e inv (apply_fun basis alpha))
  (direct_sum_of_subgroups G mult e inv J Gfam_e)
  Hfree).
assume Hab Hbasis_f Hicyc Hdsom.
claim Hgrp : group_structure G mult e inv.
{ exact (andEL (group_structure G mult e inv)
    (forall x y:set, x :e G -> y :e G -> apply_fun mult (x, y) = apply_fun mult (y, x)) Hab). }
apply (and6E
  (function_on mult (setprod G G) G)
  (function_on inv G G)
  (e :e G)
  (forall x y z:set, x :e G -> y :e G -> z :e G ->
    apply_fun mult (apply_fun mult (x, y), z) = apply_fun mult (x, apply_fun mult (y, z)))
  (forall x:set, x :e G -> apply_fun mult (e, x) = x /\ apply_fun mult (x, e) = x)
  (forall x:set, x :e G ->
    apply_fun mult (x, apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x, x) = e)
  Hgrp).
assume HmultF HinvG HeG Hassoc Hid Hinverse.
claim HmG : forall x y:set, x :e G -> y :e G -> apply_fun mult (x, y) :e G.
{ let x y. assume HxG HyG.
  exact (HmultF (x, y) (tuple_2_setprod_by_pair_Sigma G G x y HxG HyG)). }
claim Hcomm : forall x y:set, x :e G -> y :e G ->
  apply_fun mult (x, y) = apply_fun mult (y, x).
{ exact (andER (group_structure G mult e inv)
    (forall x y:set, x :e G -> y :e G -> apply_fun mult (x, y) = apply_fun mult (y, x)) Hab). }
claim HidL : forall x:set, x :e G -> apply_fun mult (e, x) = x.
{ let x. assume HxG.
  exact (andEL (apply_fun mult (e, x) = x) (apply_fun mult (x, e) = x) (Hid x HxG)). }
claim HidR : forall x:set, x :e G -> apply_fun mult (x, e) = x.
{ let x. assume HxG.
  exact (andER (apply_fun mult (e, x) = x) (apply_fun mult (x, e) = x) (Hid x HxG)). }
claim HinvR : forall x:set, x :e G ->
  apply_fun mult (x, apply_fun inv x) = e.
{ let x. assume HxG.
  exact (andEL (apply_fun mult (x, apply_fun inv x) = e)
    (apply_fun mult (apply_fun inv x, x) = e) (Hinverse x HxG)). }
claim HinvL : forall x:set, x :e G ->
  apply_fun mult (apply_fun inv x, x) = e.
{ let x. assume HxG.
  exact (andER (apply_fun mult (x, apply_fun inv x) = e)
    (apply_fun mult (apply_fun inv x, x) = e) (Hinverse x HxG)). }
(** Unpack direct_sum_of_subgroups **)
claim Hdsga : subgroups_generate_abelian G mult e inv J Gfam_e.
{ exact (andEL (subgroups_generate_abelian G mult e inv J Gfam_e)
    (forall x:set, x :e G ->
      forall n1 n2:set, n1 :e omega -> n2 :e omega -> 
      forall a1 a2:set, function_on a1 n1 J -> function_on a2 n2 J ->
      forall x1 x2:set, function_on x1 n1 G -> function_on x2 n2 G ->
        (forall i:set, i :e n1 -> apply_fun x1 i :e apply_fun Gfam_e (apply_fun a1 i)) ->
        (forall i:set, i :e n2 -> apply_fun x2 i :e apply_fun Gfam_e (apply_fun a2 i)) ->
        (forall i j:set, i :e n1 -> j :e n1 -> i <> j -> apply_fun a1 i <> apply_fun a1 j) ->
        (forall i j:set, i :e n2 -> j :e n2 -> i <> j -> apply_fun a2 i <> apply_fun a2 j) ->
        x = nat_primrec e (fun i r => apply_fun mult (r, apply_fun x1 i)) n1 ->
        x = nat_primrec e (fun i r => apply_fun mult (r, apply_fun x2 i)) n2 ->
        (forall alpha:set, alpha :e J ->
          (forall i j:set, i :e n1 -> j :e n2 ->
            apply_fun a1 i = alpha -> apply_fun a2 j = alpha ->
            apply_fun x1 i = apply_fun x2 j) /\
          ((exists i:set, i :e n1 /\ apply_fun a1 i = alpha) ->
           ~(exists j:set, j :e n2 /\ apply_fun a2 j = alpha) ->
           forall i:set, i :e n1 -> apply_fun a1 i = alpha -> apply_fun x1 i = e) /\
          (~(exists i:set, i :e n1 /\ apply_fun a1 i = alpha) ->
           (exists j:set, j :e n2 /\ apply_fun a2 j = alpha) ->
           forall j:set, j :e n2 -> apply_fun a2 j = alpha -> apply_fun x2 j = e)))
    Hdsom). }
claim Hdsom_uniq : forall x:set, x :e G ->
  forall n1 n2:set, n1 :e omega -> n2 :e omega -> 
  forall a1 a2:set, function_on a1 n1 J -> function_on a2 n2 J ->
  forall x1 x2:set, function_on x1 n1 G -> function_on x2 n2 G ->
    (forall i:set, i :e n1 -> apply_fun x1 i :e apply_fun Gfam_e (apply_fun a1 i)) ->
    (forall i:set, i :e n2 -> apply_fun x2 i :e apply_fun Gfam_e (apply_fun a2 i)) ->
    (forall i j:set, i :e n1 -> j :e n1 -> i <> j -> apply_fun a1 i <> apply_fun a1 j) ->
    (forall i j:set, i :e n2 -> j :e n2 -> i <> j -> apply_fun a2 i <> apply_fun a2 j) ->
    x = nat_primrec e (fun i r => apply_fun mult (r, apply_fun x1 i)) n1 ->
    x = nat_primrec e (fun i r => apply_fun mult (r, apply_fun x2 i)) n2 ->
    (forall alpha:set, alpha :e J ->
      (forall i j:set, i :e n1 -> j :e n2 ->
        apply_fun a1 i = alpha -> apply_fun a2 j = alpha ->
        apply_fun x1 i = apply_fun x2 j) /\
      ((exists i:set, i :e n1 /\ apply_fun a1 i = alpha) ->
       ~(exists j:set, j :e n2 /\ apply_fun a2 j = alpha) ->
       forall i:set, i :e n1 -> apply_fun a1 i = alpha -> apply_fun x1 i = e) /\
      (~(exists i:set, i :e n1 /\ apply_fun a1 i = alpha) ->
       (exists j:set, j :e n2 /\ apply_fun a2 j = alpha) ->
       forall j:set, j :e n2 -> apply_fun a2 j = alpha -> apply_fun x2 j = e)).
{ exact (andER (subgroups_generate_abelian G mult e inv J Gfam_e)
    (forall x:set, x :e G ->
      forall n1 n2:set, n1 :e omega -> n2 :e omega -> 
      forall a1 a2:set, function_on a1 n1 J -> function_on a2 n2 J ->
      forall x1 x2:set, function_on x1 n1 G -> function_on x2 n2 G ->
        (forall i:set, i :e n1 -> apply_fun x1 i :e apply_fun Gfam_e (apply_fun a1 i)) ->
        (forall i:set, i :e n2 -> apply_fun x2 i :e apply_fun Gfam_e (apply_fun a2 i)) ->
        (forall i j:set, i :e n1 -> j :e n1 -> i <> j -> apply_fun a1 i <> apply_fun a1 j) ->
        (forall i j:set, i :e n2 -> j :e n2 -> i <> j -> apply_fun a2 i <> apply_fun a2 j) ->
        x = nat_primrec e (fun i r => apply_fun mult (r, apply_fun x1 i)) n1 ->
        x = nat_primrec e (fun i r => apply_fun mult (r, apply_fun x2 i)) n2 ->
        (forall alpha:set, alpha :e J ->
          (forall i j:set, i :e n1 -> j :e n2 ->
            apply_fun a1 i = alpha -> apply_fun a2 j = alpha ->
            apply_fun x1 i = apply_fun x2 j) /\
          ((exists i:set, i :e n1 /\ apply_fun a1 i = alpha) ->
           ~(exists j:set, j :e n2 /\ apply_fun a2 j = alpha) ->
           forall i:set, i :e n1 -> apply_fun a1 i = alpha -> apply_fun x1 i = e) /\
          (~(exists i:set, i :e n1 /\ apply_fun a1 i = alpha) ->
           (exists j:set, j :e n2 /\ apply_fun a2 j = alpha) ->
           forall j:set, j :e n2 -> apply_fun a2 j = alpha -> apply_fun x2 j = e)))
    Hdsom). }
claim Hdsom_sg : forall alpha:set, alpha :e J ->
  subgroup_of (apply_fun Gfam_e alpha) G mult e inv.
{ exact (andER (abelian_group G mult e inv)
    (forall alpha:set, alpha :e J -> subgroup_of (apply_fun Gfam_e alpha) G mult e inv)
    (andEL (abelian_group G mult e inv /\
            (forall alpha:set, alpha :e J -> subgroup_of (apply_fun Gfam_e alpha) G mult e inv))
       (forall x:set, x :e G ->
         exists n:set, n :e omega /\
         exists alphas:set, function_on alphas n J /\
         exists xs:set, function_on xs n G /\
           (forall i:set, i :e n -> apply_fun xs i :e apply_fun Gfam_e (apply_fun alphas i)) /\
           (forall i j:set, i :e n -> j :e n -> i <> j ->
             apply_fun alphas i <> apply_fun alphas j) /\
           x = nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) n)
       Hdsga)). }
claim Hdsom_gen : forall x:set, x :e G ->
  exists n:set, n :e omega /\
  exists alphas:set, function_on alphas n J /\
  exists xs:set, function_on xs n G /\
    (forall i:set, i :e n -> apply_fun xs i :e apply_fun Gfam_e (apply_fun alphas i)) /\
    (forall i j:set, i :e n -> j :e n -> i <> j ->
      apply_fun alphas i <> apply_fun alphas j) /\
    x = nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) n.
{ exact (andER (abelian_group G mult e inv /\
              (forall alpha:set, alpha :e J -> subgroup_of (apply_fun Gfam_e alpha) G mult e inv))
    (forall x:set, x :e G ->
      exists n:set, n :e omega /\
      exists alphas:set, function_on alphas n J /\
      exists xs:set, function_on xs n G /\
        (forall i:set, i :e n -> apply_fun xs i :e apply_fun Gfam_e (apply_fun alphas i)) /\
        (forall i j:set, i :e n -> j :e n -> i <> j ->
          apply_fun alphas i <> apply_fun alphas j) /\
        x = nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) n)
    Hdsga). }
claim HpowG : forall b:set, b :e G -> forall n:set, n :e omega ->
  group_power_nat mult e b n :e G.
{ let b. assume HbG : b :e G.
  let n. assume HnO : n :e omega.
  exact (nat_ind (fun m => group_power_nat mult e b m :e G)
    (eq_subst_mem (group_power_nat mult e b 0) e G
      (nat_primrec_0 e (fun _ r => apply_fun mult (b, r))) HeG)
    (fun m Hm IH =>
      eq_subst_mem (group_power_nat mult e b (ordsucc m))
        (apply_fun mult (b, group_power_nat mult e b m)) G
        (nat_primrec_S e (fun _ r => apply_fun mult (b, r)) m Hm)
        (HmG b (group_power_nat mult e b m) HbG IH))
    n (omega_nat_p n HnO)). }
(** Main proof: let a, assume non-identity, assume finite order, derive contradiction **)
let a. assume HaG : a :e G. assume Hane : a <> e.
assume Hexists : exists m:set, m :e omega /\ m <> 0 /\ group_power_nat mult e a m = e.
apply Hexists.
let m. assume Hm : m :e omega /\ m <> 0 /\ group_power_nat mult e a m = e.
apply (and3E (m :e omega) (m <> 0) (group_power_nat mult e a m = e) Hm).
assume HmO : m :e omega. assume Hm0 : m <> 0. assume Ham : group_power_nat mult e a m = e.
(** Get representation of a from direct sum **)
apply (Hdsom_gen a HaG).
let n. assume Hn_rep : (n :e omega) /\
  exists alphas:set, function_on alphas n J /\
  exists xs:set, function_on xs n G /\
    (forall i:set, i :e n -> apply_fun xs i :e apply_fun Gfam_e (apply_fun alphas i)) /\
    (forall i j:set, i :e n -> j :e n -> i <> j ->
      apply_fun alphas i <> apply_fun alphas j) /\
    a = nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) n.
claim HnO : n :e omega.
{ exact (andEL (n :e omega)
    (exists alphas:set, function_on alphas n J /\ exists xs:set, function_on xs n G /\
      (forall i:set, i :e n -> apply_fun xs i :e apply_fun Gfam_e (apply_fun alphas i)) /\
      (forall i j:set, i :e n -> j :e n -> i <> j -> apply_fun alphas i <> apply_fun alphas j) /\
      a = nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) n)
    Hn_rep). }
claim HnExAlphas : exists alphas:set, function_on alphas n J /\ exists xs:set, function_on xs n G /\
  (forall i:set, i :e n -> apply_fun xs i :e apply_fun Gfam_e (apply_fun alphas i)) /\
  (forall i j:set, i :e n -> j :e n -> i <> j -> apply_fun alphas i <> apply_fun alphas j) /\
  a = nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) n.
{ exact (andER (n :e omega)
    (exists alphas:set, function_on alphas n J /\ exists xs:set, function_on xs n G /\
      (forall i:set, i :e n -> apply_fun xs i :e apply_fun Gfam_e (apply_fun alphas i)) /\
      (forall i j:set, i :e n -> j :e n -> i <> j -> apply_fun alphas i <> apply_fun alphas j) /\
      a = nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) n)
    Hn_rep). }
apply HnExAlphas.
let alphas. assume Halphas_rep : function_on alphas n J /\ exists xs:set, function_on xs n G /\
  (forall i:set, i :e n -> apply_fun xs i :e apply_fun Gfam_e (apply_fun alphas i)) /\
  (forall i j:set, i :e n -> j :e n -> i <> j -> apply_fun alphas i <> apply_fun alphas j) /\
  a = nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) n.
claim Halphas_f : function_on alphas n J.
{ exact (andEL (function_on alphas n J)
    (exists xs:set, function_on xs n G /\
      (forall i:set, i :e n -> apply_fun xs i :e apply_fun Gfam_e (apply_fun alphas i)) /\
      (forall i j:set, i :e n -> j :e n -> i <> j -> apply_fun alphas i <> apply_fun alphas j) /\
      a = nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) n)
    Halphas_rep). }
claim HnExXs : exists xs:set, function_on xs n G /\
  (forall i:set, i :e n -> apply_fun xs i :e apply_fun Gfam_e (apply_fun alphas i)) /\
  (forall i j:set, i :e n -> j :e n -> i <> j -> apply_fun alphas i <> apply_fun alphas j) /\
  a = nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) n.
{ exact (andER (function_on alphas n J)
    (exists xs:set, function_on xs n G /\
      (forall i:set, i :e n -> apply_fun xs i :e apply_fun Gfam_e (apply_fun alphas i)) /\
      (forall i j:set, i :e n -> j :e n -> i <> j -> apply_fun alphas i <> apply_fun alphas j) /\
      a = nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) n)
    Halphas_rep). }
apply HnExXs.
let xs. assume Hxs_rep : function_on xs n G /\
  (forall i:set, i :e n -> apply_fun xs i :e apply_fun Gfam_e (apply_fun alphas i)) /\
  (forall i j:set, i :e n -> j :e n -> i <> j -> apply_fun alphas i <> apply_fun alphas j) /\
  a = nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) n.
apply (and4E
  (function_on xs n G)
  (forall i:set, i :e n -> apply_fun xs i :e apply_fun Gfam_e (apply_fun alphas i))
  (forall i j:set, i :e n -> j :e n -> i <> j -> apply_fun alphas i <> apply_fun alphas j)
  (a = nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) n)
  Hxs_rep).
assume Hxs_f : function_on xs n G.
assume Hxs_fam : forall i:set, i :e n -> apply_fun xs i :e apply_fun Gfam_e (apply_fun alphas i).
assume Halphas_dist : forall i j:set, i :e n -> j :e n -> i <> j -> apply_fun alphas i <> apply_fun alphas j.
assume Hxs_eq : a = nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) n.
(** Helper: e^n = e **)
claim Hpow_e : forall k:set, k :e omega -> group_power_nat mult e e k = e.
{ let k. assume HkO2 : k :e omega.
  claim Hnat : forall j:set, nat_p j -> group_power_nat mult e e j = e.
  { apply nat_ind.
    - prove group_power_nat mult e e 0 = e.
      exact (nat_primrec_0 e (fun _ r => apply_fun mult (e, r))).
    - let j. assume Hj IH.
      prove group_power_nat mult e e (ordsucc j) = e.
      claim HstepE : group_power_nat mult e e (ordsucc j) =
        apply_fun mult (e, group_power_nat mult e e j).
      { exact (nat_primrec_S e (fun _ r => apply_fun mult (e, r)) j Hj). }
      rewrite HstepE. rewrite IH. exact (HidL e HeG). }
  exact (Hnat k (omega_nat_p k HkO2)). }
(** Helper: abelian group power distributes over product **)
claim Hdist : forall a2 b2:set, a2 :e G -> b2 :e G -> forall k:set, k :e omega ->
  group_power_nat mult e (apply_fun mult (a2, b2)) k =
  apply_fun mult (group_power_nat mult e a2 k, group_power_nat mult e b2 k).
{ let a2 b2. assume Ha2G : a2 :e G. assume Hb2G : b2 :e G.
  claim Hnat : forall k:set, nat_p k ->
    group_power_nat mult e (apply_fun mult (a2, b2)) k =
    apply_fun mult (group_power_nat mult e a2 k, group_power_nat mult e b2 k).
  { apply nat_ind.
    - prove group_power_nat mult e (apply_fun mult (a2, b2)) 0 =
        apply_fun mult (group_power_nat mult e a2 0, group_power_nat mult e b2 0).
      claim H0ab : group_power_nat mult e (apply_fun mult (a2, b2)) 0 = e.
      { exact (nat_primrec_0 e (fun _ r => apply_fun mult (apply_fun mult (a2, b2), r))). }
      claim H0a : group_power_nat mult e a2 0 = e.
      { exact (nat_primrec_0 e (fun _ r => apply_fun mult (a2, r))). }
      claim H0b : group_power_nat mult e b2 0 = e.
      { exact (nat_primrec_0 e (fun _ r => apply_fun mult (b2, r))). }
      rewrite H0ab. rewrite H0a. rewrite H0b. symmetry. exact (HidL e HeG).
    - let k. assume Hk : nat_p k.
      assume IH : group_power_nat mult e (apply_fun mult (a2, b2)) k =
        apply_fun mult (group_power_nat mult e a2 k, group_power_nat mult e b2 k).
      prove group_power_nat mult e (apply_fun mult (a2, b2)) (ordsucc k) =
        apply_fun mult (group_power_nat mult e a2 (ordsucc k), group_power_nat mult e b2 (ordsucc k)).
      claim HkO2 : k :e omega. { exact (nat_p_omega k Hk). }
      claim HakG : group_power_nat mult e a2 k :e G. { exact (HpowG a2 Ha2G k HkO2). }
      claim HbkG : group_power_nat mult e b2 k :e G. { exact (HpowG b2 Hb2G k HkO2). }
      claim HSab : group_power_nat mult e (apply_fun mult (a2, b2)) (ordsucc k) =
        apply_fun mult (apply_fun mult (a2, b2), group_power_nat mult e (apply_fun mult (a2, b2)) k).
      { exact (nat_primrec_S e (fun _ r => apply_fun mult (apply_fun mult (a2, b2), r)) k Hk). }
      claim HSa : group_power_nat mult e a2 (ordsucc k) =
        apply_fun mult (a2, group_power_nat mult e a2 k).
      { exact (nat_primrec_S e (fun _ r => apply_fun mult (a2, r)) k Hk). }
      claim HSb : group_power_nat mult e b2 (ordsucc k) =
        apply_fun mult (b2, group_power_nat mult e b2 k).
      { exact (nat_primrec_S e (fun _ r => apply_fun mult (b2, r)) k Hk). }
      rewrite HSab. rewrite IH. rewrite HSa. rewrite HSb.
      claim HakbkG : apply_fun mult (group_power_nat mult e a2 k, group_power_nat mult e b2 k) :e G.
      { exact (HmG (group_power_nat mult e a2 k) (group_power_nat mult e b2 k) HakG HbkG). }
      claim HbbkG : apply_fun mult (b2, group_power_nat mult e b2 k) :e G.
      { exact (HmG b2 (group_power_nat mult e b2 k) Hb2G HbkG). }
      rewrite (Hassoc a2 b2 (apply_fun mult (group_power_nat mult e a2 k, group_power_nat mult e b2 k))
        Ha2G Hb2G HakbkG).
      rewrite <- (Hassoc b2 (group_power_nat mult e a2 k) (group_power_nat mult e b2 k)
        Hb2G HakG HbkG).
      rewrite (Hcomm b2 (group_power_nat mult e a2 k) Hb2G HakG).
      rewrite (Hassoc (group_power_nat mult e a2 k) b2 (group_power_nat mult e b2 k)
        HakG Hb2G HbkG).
      rewrite <- (Hassoc a2 (group_power_nat mult e a2 k)
        (apply_fun mult (b2, group_power_nat mult e b2 k)) Ha2G HakG HbbkG).
      reflexivity. }
  let k. assume HkO2. exact (Hnat k (omega_nat_p k HkO2)). }
(** Helper: product stays in G **)
claim HProd_G : forall k:set, nat_p k -> k c= n ->
  nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) k :e G.
{ exact (nat_ind
    (fun k => k c= n -> nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) k :e G)
    (fun _ => eq_subst_mem
      (nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) 0) e G
      (nat_primrec_0 e (fun i r => apply_fun mult (r, apply_fun xs i))) HeG)
    (fun k Hk IH Hsk =>
      let Hk_cn : k c= n := Subq_tra k (ordsucc k) n (ordsuccI1 k) Hsk in
      let HkN : k :e n := Hsk k (ordsuccI2 k) in
      let HxskG : apply_fun xs k :e G := Hxs_f k HkN in
      eq_subst_mem
        (nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) (ordsucc k))
        (apply_fun mult (nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) k, apply_fun xs k))
        G
        (nat_primrec_S e (fun i r => apply_fun mult (r, apply_fun xs i)) k Hk)
        (HmG (nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) k) (apply_fun xs k)
          (IH Hk_cn) HxskG))). }
(** Helper: subgroup closed under natural powers **)
claim Hsg_pow : forall H a2:set,
  subgroup_of H G mult e inv -> a2 :e H -> forall k:set, k :e omega ->
  group_power_nat mult e a2 k :e H.
{ let H a2. assume Hsg : subgroup_of H G mult e inv. assume Ha2H : a2 :e H.
  apply (and4E (H c= G) (e :e H)
    (forall x y:set, x :e H -> y :e H -> apply_fun mult (x, y) :e H)
    (forall x:set, x :e H -> apply_fun inv x :e H)
    Hsg).
  assume HHG HeH HmH HinvH.
  let k. assume HkO2 : k :e omega.
  exact (nat_ind (fun j => group_power_nat mult e a2 j :e H)
    (eq_subst_mem (group_power_nat mult e a2 0) e H
      (nat_primrec_0 e (fun _ r => apply_fun mult (a2, r))) HeH)
    (fun j Hj IH =>
      eq_subst_mem (group_power_nat mult e a2 (ordsucc j))
        (apply_fun mult (a2, group_power_nat mult e a2 j)) H
        (nat_primrec_S e (fun _ r => apply_fun mult (a2, r)) j Hj)
        (HmH a2 (group_power_nat mult e a2 j) Ha2H IH))
    k (omega_nat_p k HkO2)). }
(** Helper: xs(i)^m stays in Gfam_e(alphas(i)) by subgroup closure **)
claim HXsm_mem_fam : forall i:set, i :e n ->
  group_power_nat mult e (apply_fun xs i) m :e apply_fun Gfam_e (apply_fun alphas i).
{ let i. assume HiN.
  exact (Hsg_pow (apply_fun Gfam_e (apply_fun alphas i)) (apply_fun xs i)
    (Hdsom_sg (apply_fun alphas i) (Halphas_f i HiN))
    (Hxs_fam i HiN) m HmO). }
(** Find i0 :e n with xs(i0) <> e **)
claim Hall_e_then_a_e : (forall i:set, i :e n -> apply_fun xs i = e) -> a = e.
{ assume Hall.
  rewrite Hxs_eq.
  claim Hnat : forall k:set, nat_p k -> k c= n ->
    nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) k = e.
  { apply nat_ind.
    - assume _. exact (nat_primrec_0 e (fun i r => apply_fun mult (r, apply_fun xs i))).
    - let k. assume Hk IH Hsk.
      claim Hk_cn : k c= n. { exact (Subq_tra k (ordsucc k) n (ordsuccI1 k) Hsk). }
      claim HkN : k :e n. { exact (Hsk k (ordsuccI2 k)). }
      claim Hstep_eq2 : nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) (ordsucc k) =
        apply_fun mult (nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) k, apply_fun xs k).
      { exact (nat_primrec_S e (fun i r => apply_fun mult (r, apply_fun xs i)) k Hk). }
      rewrite Hstep_eq2. rewrite (Hall k HkN). rewrite (IH Hk_cn). exact (HidR e HeG). }
  exact (Hnat n (omega_nat_p n HnO) (fun x Hx => Hx)). }
claim Hnot_all_e : ~(forall i:set, i :e n -> apply_fun xs i = e).
{ assume Hall. exact (Hane (Hall_e_then_a_e Hall)). }
apply (not_all_ex_demorgan_i (fun i => i :e n -> apply_fun xs i = e) Hnot_all_e).
let i0. assume Hi0_not : ~(i0 :e n -> apply_fun xs i0 = e).
claim Hi0N : i0 :e n.
{ apply (xm (i0 :e n)).
  - assume H. exact H.
  - assume H : ~(i0 :e n).
    exact (FalseE (Hi0_not (fun Hin : i0 :e n => (H Hin) (apply_fun xs i0 = e))) (i0 :e n)). }
claim Hxsi0_ne : apply_fun xs i0 <> e.
{ assume H : apply_fun xs i0 = e. exact (Hi0_not (fun _ => H)). }
(** Helper: (∏_{i<k} xs(i))^m = ∏_{i<k} xs(i)^m **)
claim HPow_prod : forall k:set, nat_p k -> k c= n ->
  group_power_nat mult e (nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) k) m =
  nat_primrec e (fun i r => apply_fun mult (r, group_power_nat mult e (apply_fun xs i) m)) k.
{ apply nat_ind.
  - assume _.
    rewrite (nat_primrec_0 e (fun i r => apply_fun mult (r, apply_fun xs i))).
    rewrite (nat_primrec_0 e (fun i r => apply_fun mult (r, group_power_nat mult e (apply_fun xs i) m))).
    exact (Hpow_e m HmO).
  - let k. assume Hk IH. assume Hsk.
    prove group_power_nat mult e (nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) (ordsucc k)) m =
      nat_primrec e (fun i r => apply_fun mult (r, group_power_nat mult e (apply_fun xs i) m)) (ordsucc k).
    claim Hk_cn : k c= n. { exact (Subq_tra k (ordsucc k) n (ordsuccI1 k) Hsk). }
    claim HkN : k :e n. { exact (Hsk k (ordsuccI2 k)). }
    claim HPkG : nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) k :e G.
    { exact (HProd_G k Hk Hk_cn). }
    claim HxskG : apply_fun xs k :e G. { exact (Hxs_f k HkN). }
    rewrite (nat_primrec_S e (fun i r => apply_fun mult (r, apply_fun xs i)) k Hk).
    rewrite (nat_primrec_S e (fun i r => apply_fun mult (r, group_power_nat mult e (apply_fun xs i) m)) k Hk).
    rewrite (Hdist (nat_primrec e (fun i r => apply_fun mult (r, apply_fun xs i)) k)
      (apply_fun xs k) HPkG HxskG m HmO).
    rewrite (IH Hk_cn).
    reflexivity. }
(** Setup xm_fun for Hdsom_uniq **)
set xm_fun : set := graph n (fun i:set => group_power_nat mult e (apply_fun xs i) m).
claim Hxm_apply : forall i:set, i :e n ->
  apply_fun xm_fun i = group_power_nat mult e (apply_fun xs i) m.
{ let i. assume HiN.
  exact (apply_fun_graph n (fun i2 => group_power_nat mult e (apply_fun xs i2) m) i HiN). }
(** Agree claim: nat_primrec with xm_fun = nat_primrec with xs^m **)
claim HXmProd_eq : forall k:set, nat_p k -> k c= n ->
  nat_primrec e (fun i r => apply_fun mult (r, apply_fun xm_fun i)) k =
  nat_primrec e (fun i r => apply_fun mult (r, group_power_nat mult e (apply_fun xs i) m)) k.
{ apply nat_ind.
  - assume _.
    rewrite (nat_primrec_0 e (fun i r => apply_fun mult (r, apply_fun xm_fun i))).
    rewrite (nat_primrec_0 e (fun i r => apply_fun mult (r, group_power_nat mult e (apply_fun xs i) m))).
    reflexivity.
  - let k. assume Hk IH. assume Hsk.
    claim Hk_cn : k c= n. { exact (Subq_tra k (ordsucc k) n (ordsuccI1 k) Hsk). }
    claim HkN : k :e n. { exact (Hsk k (ordsuccI2 k)). }
    rewrite (nat_primrec_S e (fun i r => apply_fun mult (r, apply_fun xm_fun i)) k Hk).
    rewrite (nat_primrec_S e (fun i r => apply_fun mult (r, group_power_nat mult e (apply_fun xs i) m)) k Hk).
    rewrite (Hxm_apply k HkN).
    rewrite (IH Hk_cn).
    reflexivity. }
(** function_on xm_fun n G **)
claim Hxm_f : function_on xm_fun n G.
{ let i. assume HiN. rewrite (Hxm_apply i HiN). exact (HpowG (apply_fun xs i) (Hxs_f i HiN) m HmO). }
(** xm_fun(i) :e Gfam_e(alphas(i)) **)
claim Hxm_fam : forall i:set, i :e n ->
  apply_fun xm_fun i :e apply_fun Gfam_e (apply_fun alphas i).
{ let i. assume HiN. rewrite (Hxm_apply i HiN). exact (HXsm_mem_fam i HiN). }
(** a2_fun and x2_fun for second representation (single e) **)
set a2_fun : set := const_fun (ordsucc 0) (apply_fun alphas i0).
set x2_fun : set := const_fun (ordsucc 0) e.
claim H1O : ordsucc 0 :e omega.
{ exact (nat_p_omega (ordsucc 0) (nat_ordsucc 0 nat_0)). }
claim Ha2_f : function_on a2_fun (ordsucc 0) J.
{ let i. assume HiOs0.
  rewrite (const_fun_apply (ordsucc 0) (apply_fun alphas i0) i HiOs0).
  exact (Halphas_f i0 Hi0N). }
claim Hx2_f : function_on x2_fun (ordsucc 0) G.
{ let i. assume HiOs0.
  rewrite (const_fun_apply (ordsucc 0) e i HiOs0). exact HeG. }
(** e :e Gfam_e(alphas(i0)) **)
claim HeGfam_i0 : e :e apply_fun Gfam_e (apply_fun alphas i0).
{ claim Hi0J : apply_fun alphas i0 :e J. { exact (Halphas_f i0 Hi0N). }
  rewrite (apply_fun_graph J (fun alpha:set =>
    {g :e G | exists n0:set, n0 :e int /\
      ((n0 :e omega /\ g = group_power_nat mult e (apply_fun basis alpha) n0) \/
       (exists k:set, k :e omega /\ n0 = minus_SNo (ordsucc k) /\
        g = group_power_nat mult e (apply_fun inv (apply_fun basis alpha)) (ordsucc k)))})
    (apply_fun alphas i0) Hi0J).
  apply (SepI G (fun g:set => exists n0:set, n0 :e int /\
    ((n0 :e omega /\ g = group_power_nat mult e (apply_fun basis (apply_fun alphas i0)) n0) \/
     (exists k:set, k :e omega /\ n0 = minus_SNo (ordsucc k) /\
      g = group_power_nat mult e (apply_fun inv (apply_fun basis (apply_fun alphas i0))) (ordsucc k))))
    e HeG).
  witness 0.
  apply andI.
  - prove 0 :e int. exact (Subq_omega_int 0 (nat_p_omega 0 nat_0)).
  - apply orIL. apply andI.
    + prove 0 :e omega. exact (nat_p_omega 0 nat_0).
    + prove e = group_power_nat mult e (apply_fun basis (apply_fun alphas i0)) 0.
      symmetry.
      exact (nat_primrec_0 e (fun _ r => apply_fun mult (apply_fun basis (apply_fun alphas i0), r))). }
(** x2_fun(i) :e Gfam_e(a2_fun(i)) **)
claim Hx2_fam : forall i:set, i :e ordsucc 0 ->
  apply_fun x2_fun i :e apply_fun Gfam_e (apply_fun a2_fun i).
{ let i. assume HiOs0.
  rewrite (const_fun_apply (ordsucc 0) e i HiOs0).
  rewrite (const_fun_apply (ordsucc 0) (apply_fun alphas i0) i HiOs0).
  exact HeGfam_i0. }
(** a2_fun distinctness (vacuous for n2=1) **)
claim Ha2_dist : forall i j:set, i :e ordsucc 0 -> j :e ordsucc 0 -> i <> j ->
  apply_fun a2_fun i <> apply_fun a2_fun j.
{ let i j. assume HiOs0 HjOs0 Hne.
  assume _.
  apply Hne.
  apply (ordsuccE 0 i HiOs0).
  + assume Hi0 : i :e 0. exact (EmptyE i Hi0 (i = j)).
  + assume Hi0eq : i = 0.
    apply (ordsuccE 0 j HjOs0).
    - assume Hj0 : j :e 0. exact (EmptyE j Hj0 (i = j)).
    - assume Hj0eq : j = 0.
      rewrite Hi0eq. symmetry. exact Hj0eq. }
(** e = ∏_{i<n} xm_fun(i) **)
claim Hrep1 : e = nat_primrec e (fun i r => apply_fun mult (r, apply_fun xm_fun i)) n.
{ symmetry.
  rewrite (HXmProd_eq n (omega_nat_p n HnO) (fun x Hx => Hx)).
  rewrite <- (HPow_prod n (omega_nat_p n HnO) (fun x Hx => Hx)).
  rewrite <- Hxs_eq.
  exact Ham. }
(** e = [e in Gfam_e(alphas(i0))] **)
claim Hrep2 : e = nat_primrec e (fun i r => apply_fun mult (r, apply_fun x2_fun i)) (ordsucc 0).
{ symmetry.
  rewrite (nat_primrec_S e (fun i r => apply_fun mult (r, apply_fun x2_fun i)) 0 nat_0).
  rewrite (nat_primrec_0 e (fun i r => apply_fun mult (r, apply_fun x2_fun i))).
  rewrite (const_fun_apply (ordsucc 0) e 0 (ordsuccI2 0)).
  exact (HidL e HeG). }
(** Apply Hdsom_uniq to get xs(i0)^m = e **)
claim Hxsi0_m_eq : group_power_nat mult e (apply_fun xs i0) m = e.
{ claim Hmatch_full :
    (forall i j:set, i :e n -> j :e ordsucc 0 ->
      apply_fun alphas i = apply_fun alphas i0 ->
      apply_fun a2_fun j = apply_fun alphas i0 ->
      apply_fun xm_fun i = apply_fun x2_fun j) /\
    ((exists i:set, i :e n /\ apply_fun alphas i = apply_fun alphas i0) ->
     ~(exists j:set, j :e ordsucc 0 /\ apply_fun a2_fun j = apply_fun alphas i0) ->
     forall i:set, i :e n -> apply_fun alphas i = apply_fun alphas i0 -> apply_fun xm_fun i = e) /\
    (~(exists i:set, i :e n /\ apply_fun alphas i = apply_fun alphas i0) ->
     (exists j:set, j :e ordsucc 0 /\ apply_fun a2_fun j = apply_fun alphas i0) ->
     forall j:set, j :e ordsucc 0 -> apply_fun a2_fun j = apply_fun alphas i0 -> apply_fun x2_fun j = e).
  { exact (Hdsom_uniq e HeG n (ordsucc 0) HnO H1O
      alphas a2_fun Halphas_f Ha2_f
      xm_fun x2_fun Hxm_f Hx2_f Hxm_fam Hx2_fam
      Halphas_dist Ha2_dist Hrep1 Hrep2
      (apply_fun alphas i0) (Halphas_f i0 Hi0N)). }
  claim Hmatch : forall i j:set, i :e n -> j :e ordsucc 0 ->
    apply_fun alphas i = apply_fun alphas i0 ->
    apply_fun a2_fun j = apply_fun alphas i0 ->
    apply_fun xm_fun i = apply_fun x2_fun j.
  { exact (andEL (forall i j:set, i :e n -> j :e ordsucc 0 ->
        apply_fun alphas i = apply_fun alphas i0 ->
        apply_fun a2_fun j = apply_fun alphas i0 ->
        apply_fun xm_fun i = apply_fun x2_fun j)
      ((exists i:set, i :e n /\ apply_fun alphas i = apply_fun alphas i0) ->
       ~(exists j:set, j :e ordsucc 0 /\ apply_fun a2_fun j = apply_fun alphas i0) ->
       forall i:set, i :e n -> apply_fun alphas i = apply_fun alphas i0 -> apply_fun xm_fun i = e)
      (andEL ((forall i j:set, i :e n -> j :e ordsucc 0 ->
            apply_fun alphas i = apply_fun alphas i0 ->
            apply_fun a2_fun j = apply_fun alphas i0 ->
            apply_fun xm_fun i = apply_fun x2_fun j) /\
          ((exists i:set, i :e n /\ apply_fun alphas i = apply_fun alphas i0) ->
           ~(exists j:set, j :e ordsucc 0 /\ apply_fun a2_fun j = apply_fun alphas i0) ->
           forall i:set, i :e n -> apply_fun alphas i = apply_fun alphas i0 -> apply_fun xm_fun i = e))
        (~(exists i:set, i :e n /\ apply_fun alphas i = apply_fun alphas i0) ->
         (exists j:set, j :e ordsucc 0 /\ apply_fun a2_fun j = apply_fun alphas i0) ->
         forall j:set, j :e ordsucc 0 -> apply_fun a2_fun j = apply_fun alphas i0 -> apply_fun x2_fun j = e)
        Hmatch_full)). }
  claim Hmatch_i0 : apply_fun xm_fun i0 = apply_fun x2_fun 0.
  { claim Hrefl_al : apply_fun alphas i0 = apply_fun alphas i0. { reflexivity. }
    exact (Hmatch i0 0 Hi0N (ordsuccI2 0) Hrefl_al
      (const_fun_apply (ordsucc 0) (apply_fun alphas i0) 0 (ordsuccI2 0))). }
  rewrite <- (Hxm_apply i0 Hi0N).
  rewrite Hmatch_i0.
  exact (const_fun_apply (ordsucc 0) e 0 (ordsuccI2 0)). }
(** Now: xs(i0) :e Gfam_e(alphas(i0)), xs(i0) <> e, xs(i0)^m = e **)
(** Unpack membership: xs(i0) is integer power of basis(alphas(i0)) **)
claim Hi0J : apply_fun alphas i0 :e J. { exact (Halphas_f i0 Hi0N). }
claim HbiG : apply_fun basis (apply_fun alphas i0) :e G. { exact (Hbasis_f (apply_fun alphas i0) Hi0J). }
claim HinvbiG : apply_fun inv (apply_fun basis (apply_fun alphas i0)) :e G.
{ exact (HinvG (apply_fun basis (apply_fun alphas i0)) HbiG). }
claim HGfam_i0_eq : apply_fun Gfam_e (apply_fun alphas i0) =
  {g :e G | exists n0:set, n0 :e int /\
    ((n0 :e omega /\ g = group_power_nat mult e (apply_fun basis (apply_fun alphas i0)) n0) \/
     (exists k:set, k :e omega /\ n0 = minus_SNo (ordsucc k) /\
      g = group_power_nat mult e (apply_fun inv (apply_fun basis (apply_fun alphas i0))) (ordsucc k)))}.
{ exact (apply_fun_graph J (fun alpha:set =>
    {g :e G | exists n0:set, n0 :e int /\
      ((n0 :e omega /\ g = group_power_nat mult e (apply_fun basis alpha) n0) \/
       (exists k:set, k :e omega /\ n0 = minus_SNo (ordsucc k) /\
        g = group_power_nat mult e (apply_fun inv (apply_fun basis alpha)) (ordsucc k)))})
    (apply_fun alphas i0) Hi0J). }
claim Hxsi0_in_sep : apply_fun xs i0 :e
  {g :e G | exists n0:set, n0 :e int /\
    ((n0 :e omega /\ g = group_power_nat mult e (apply_fun basis (apply_fun alphas i0)) n0) \/
     (exists k:set, k :e omega /\ n0 = minus_SNo (ordsucc k) /\
      g = group_power_nat mult e (apply_fun inv (apply_fun basis (apply_fun alphas i0))) (ordsucc k)))}.
{ rewrite <- HGfam_i0_eq. exact (Hxs_fam i0 Hi0N). }
claim Hxsi0_prop : exists n0:set, n0 :e int /\
  ((n0 :e omega /\ apply_fun xs i0 = group_power_nat mult e (apply_fun basis (apply_fun alphas i0)) n0) \/
   (exists k:set, k :e omega /\ n0 = minus_SNo (ordsucc k) /\
    apply_fun xs i0 = group_power_nat mult e (apply_fun inv (apply_fun basis (apply_fun alphas i0))) (ordsucc k))).
{ exact (SepE2 G (fun g:set => exists n0:set, n0 :e int /\
    ((n0 :e omega /\ g = group_power_nat mult e (apply_fun basis (apply_fun alphas i0)) n0) \/
     (exists k:set, k :e omega /\ n0 = minus_SNo (ordsucc k) /\
      g = group_power_nat mult e (apply_fun inv (apply_fun basis (apply_fun alphas i0))) (ordsucc k))))
    (apply_fun xs i0) Hxsi0_in_sep). }
apply Hxsi0_prop.
let n0. assume Hn0_conj : n0 :e int /\
  ((n0 :e omega /\ apply_fun xs i0 = group_power_nat mult e (apply_fun basis (apply_fun alphas i0)) n0) \/
   (exists k:set, k :e omega /\ n0 = minus_SNo (ordsucc k) /\
    apply_fun xs i0 = group_power_nat mult e (apply_fun inv (apply_fun basis (apply_fun alphas i0))) (ordsucc k))).
claim Hn0_cases : (n0 :e omega /\ apply_fun xs i0 = group_power_nat mult e (apply_fun basis (apply_fun alphas i0)) n0) \/
  (exists k:set, k :e omega /\ n0 = minus_SNo (ordsucc k) /\
   apply_fun xs i0 = group_power_nat mult e (apply_fun inv (apply_fun basis (apply_fun alphas i0))) (ordsucc k)).
{ exact (andER (n0 :e int)
    ((n0 :e omega /\ apply_fun xs i0 = group_power_nat mult e (apply_fun basis (apply_fun alphas i0)) n0) \/
     (exists k:set, k :e omega /\ n0 = minus_SNo (ordsucc k) /\
      apply_fun xs i0 = group_power_nat mult e (apply_fun inv (apply_fun basis (apply_fun alphas i0))) (ordsucc k)))
    Hn0_conj). }
apply Hn0_cases.
- (** Case A: n0 :e omega, xs(i0) = basis(alpha0)^n0 **)
  assume HcaseA : n0 :e omega /\ apply_fun xs i0 = group_power_nat mult e (apply_fun basis (apply_fun alphas i0)) n0.
  claim Hn0O : n0 :e omega.
  { exact (andEL (n0 :e omega)
      (apply_fun xs i0 = group_power_nat mult e (apply_fun basis (apply_fun alphas i0)) n0) HcaseA). }
  claim Hxsi0_A : apply_fun xs i0 = group_power_nat mult e (apply_fun basis (apply_fun alphas i0)) n0.
  { exact (andER (n0 :e omega)
      (apply_fun xs i0 = group_power_nat mult e (apply_fun basis (apply_fun alphas i0)) n0) HcaseA). }
  claim Hn0ne0 : n0 <> 0.
  { assume Hn0_0 : n0 = 0.
    apply Hxsi0_ne. rewrite Hxsi0_A. rewrite Hn0_0.
    exact (nat_primrec_0 e (fun _ r => apply_fun mult (apply_fun basis (apply_fun alphas i0), r))). }
  claim Hxsi0m_eq : group_power_nat mult e (apply_fun xs i0) m =
    group_power_nat mult e (apply_fun basis (apply_fun alphas i0)) (mul_nat n0 m).
  { rewrite Hxsi0_A.
    exact (group_power_nat_of_power_nat G mult e inv (apply_fun basis (apply_fun alphas i0)) n0 m
      Hgrp HbiG Hn0O HmO). }
  claim Hbasis_finite_order : group_power_nat mult e (apply_fun basis (apply_fun alphas i0)) (mul_nat n0 m) = e.
  { rewrite <- Hxsi0m_eq. exact Hxsi0_m_eq. }
  claim Hn0m_O : mul_nat n0 m :e omega.
  { exact (nat_p_omega (mul_nat n0 m) (mul_nat_p n0 (omega_nat_p n0 Hn0O) m (omega_nat_p m HmO))). }
  claim Hn0mne0 : mul_nat n0 m <> 0.
  { assume Habs.
    apply (mul_nat_0_inv n0 (omega_nat_p n0 Hn0O) m (omega_nat_p m HmO) Habs).
    - assume H0 : n0 = 0. exact (Hn0ne0 H0).
    - assume H0 : m = 0. exact (Hm0 H0). }
  apply (andER ((apply_fun basis (apply_fun alphas i0) :e G /\
      forall n1:set, n1 :e omega -> group_power_nat mult e (apply_fun basis (apply_fun alphas i0)) n1 :e G) /\
      forall n1:set, n1 :e omega -> group_power_nat mult e (apply_fun inv (apply_fun basis (apply_fun alphas i0))) (ordsucc n1) :e G)
    (~(exists n1:set, n1 :e omega /\ n1 <> 0 /\ group_power_nat mult e (apply_fun basis (apply_fun alphas i0)) n1 = e))
    (Hicyc (apply_fun alphas i0) Hi0J)).
  witness (mul_nat n0 m). apply and3I.
  + exact Hn0m_O.
  + exact Hn0mne0.
  + exact Hbasis_finite_order.
- (** Case B: xs(i0) = inv(basis(alpha0))^{succ k0} **)
  assume HcaseB : exists k0:set, k0 :e omega /\ n0 = minus_SNo (ordsucc k0) /\
    apply_fun xs i0 = group_power_nat mult e (apply_fun inv (apply_fun basis (apply_fun alphas i0))) (ordsucc k0).
  apply HcaseB. let k0. assume Hk0_conj : k0 :e omega /\ n0 = minus_SNo (ordsucc k0) /\
    apply_fun xs i0 = group_power_nat mult e (apply_fun inv (apply_fun basis (apply_fun alphas i0))) (ordsucc k0).
  apply (and3E (k0 :e omega) (n0 = minus_SNo (ordsucc k0))
    (apply_fun xs i0 = group_power_nat mult e (apply_fun inv (apply_fun basis (apply_fun alphas i0))) (ordsucc k0))
    Hk0_conj).
  assume Hk0O Hn0_neg Hxsi0_B.
  claim Hsk0O : ordsucc k0 :e omega.
  { exact (nat_p_omega (ordsucc k0) (nat_ordsucc k0 (omega_nat_p k0 Hk0O))). }
  claim HinvbiSkO_eq : group_power_nat mult e (apply_fun xs i0) m =
    group_power_nat mult e (apply_fun inv (apply_fun basis (apply_fun alphas i0))) (mul_nat (ordsucc k0) m).
  { rewrite Hxsi0_B.
    exact (group_power_nat_of_power_nat G mult e inv
      (apply_fun inv (apply_fun basis (apply_fun alphas i0))) (ordsucc k0) m
      Hgrp HinvbiG Hsk0O HmO). }
  claim HinvN_e : group_power_nat mult e (apply_fun inv (apply_fun basis (apply_fun alphas i0))) (mul_nat (ordsucc k0) m) = e.
  { rewrite <- HinvbiSkO_eq. exact Hxsi0_m_eq. }
  claim HNO : mul_nat (ordsucc k0) m :e omega.
  { exact (nat_p_omega (mul_nat (ordsucc k0) m) (mul_nat_p (ordsucc k0)
      (nat_ordsucc k0 (omega_nat_p k0 Hk0O)) m (omega_nat_p m HmO))). }
  claim HNne0 : mul_nat (ordsucc k0) m <> 0.
  { assume Habs.
    apply (mul_nat_0_inv (ordsucc k0) (nat_ordsucc k0 (omega_nat_p k0 Hk0O)) m (omega_nat_p m HmO) Habs).
    - assume H. exact (neq_ordsucc_0 k0 H).
    - assume H. exact (Hm0 H). }
  (** Show basis(alpha0)^N = e from inv(basis(alpha0))^N = e **)
  claim HbiNG : group_power_nat mult e (apply_fun basis (apply_fun alphas i0)) (mul_nat (ordsucc k0) m) :e G.
  { exact (HpowG (apply_fun basis (apply_fun alphas i0)) HbiG (mul_nat (ordsucc k0) m) HNO). }
  claim Hbinvb_e : apply_fun mult (apply_fun basis (apply_fun alphas i0), apply_fun inv (apply_fun basis (apply_fun alphas i0))) = e.
  { exact (HinvR (apply_fun basis (apply_fun alphas i0)) HbiG). }
  claim HProd_eN : group_power_nat mult e
    (apply_fun mult (apply_fun basis (apply_fun alphas i0), apply_fun inv (apply_fun basis (apply_fun alphas i0))))
    (mul_nat (ordsucc k0) m) = e.
  { rewrite Hbinvb_e. exact (Hpow_e (mul_nat (ordsucc k0) m) HNO). }
  claim HProd_dist : group_power_nat mult e
    (apply_fun mult (apply_fun basis (apply_fun alphas i0), apply_fun inv (apply_fun basis (apply_fun alphas i0))))
    (mul_nat (ordsucc k0) m) =
    apply_fun mult (group_power_nat mult e (apply_fun basis (apply_fun alphas i0)) (mul_nat (ordsucc k0) m),
      group_power_nat mult e (apply_fun inv (apply_fun basis (apply_fun alphas i0))) (mul_nat (ordsucc k0) m)).
  { exact (Hdist (apply_fun basis (apply_fun alphas i0)) (apply_fun inv (apply_fun basis (apply_fun alphas i0)))
      HbiG HinvbiG (mul_nat (ordsucc k0) m) HNO). }
  claim HbiN_times_invbiN_e :
    apply_fun mult (group_power_nat mult e (apply_fun basis (apply_fun alphas i0)) (mul_nat (ordsucc k0) m),
      group_power_nat mult e (apply_fun inv (apply_fun basis (apply_fun alphas i0))) (mul_nat (ordsucc k0) m)) = e.
  { rewrite <- HProd_dist. exact HProd_eN. }
  claim HbiN_times_e_e :
    apply_fun mult (group_power_nat mult e (apply_fun basis (apply_fun alphas i0)) (mul_nat (ordsucc k0) m), e) = e.
  { claim Hstep : apply_fun mult (group_power_nat mult e (apply_fun basis (apply_fun alphas i0)) (mul_nat (ordsucc k0) m),
        group_power_nat mult e (apply_fun inv (apply_fun basis (apply_fun alphas i0))) (mul_nat (ordsucc k0) m)) =
      apply_fun mult (group_power_nat mult e (apply_fun basis (apply_fun alphas i0)) (mul_nat (ordsucc k0) m), e).
    { rewrite HinvN_e. reflexivity. }
    rewrite <- Hstep. exact HbiN_times_invbiN_e. }
  claim HbiN_e : group_power_nat mult e (apply_fun basis (apply_fun alphas i0)) (mul_nat (ordsucc k0) m) = e.
  { rewrite <- (HidR (group_power_nat mult e (apply_fun basis (apply_fun alphas i0)) (mul_nat (ordsucc k0) m)) HbiNG).
    exact HbiN_times_e_e. }
  apply (andER ((apply_fun basis (apply_fun alphas i0) :e G /\
      forall n1:set, n1 :e omega -> group_power_nat mult e (apply_fun basis (apply_fun alphas i0)) n1 :e G) /\
      forall n1:set, n1 :e omega -> group_power_nat mult e (apply_fun inv (apply_fun basis (apply_fun alphas i0))) (ordsucc n1) :e G)
    (~(exists n1:set, n1 :e omega /\ n1 <> 0 /\ group_power_nat mult e (apply_fun basis (apply_fun alphas i0)) n1 = e))
    (Hicyc (apply_fun alphas i0) Hi0J)).
  witness (mul_nat (ordsucc k0) m). apply and3I.
  + exact HNO.
  + exact HNne0.
  + exact HbiN_e.
Qed.

(** from S67 Exercise 4(c) (line 2710 in algtop.tex) **)
(** LATEX VERSION: The rationals have no elements of finite order but are not free abelian. **)
(** EFFORT: 5 lines textbook, difficulty 4/10, USD 60 **)
(** Collected Bob 66 **)
(** Proven Bob **)
Theorem ex67_4c_rationals_not_free_abelian :
  (forall q:set, q :e rational -> q <> 0 ->
    ~(exists m:set, m :e omega /\ m <> 0 /\
      nat_primrec 0 (fun _ r => add_SNo r q) m = 0)) /\
  ~(exists J basis:set,
    free_abelian_group_with_basis rational
      (graph (setprod rational rational) (fun p:set => add_SNo (p 0) (p 1)))
      0 (graph rational (fun q:set => minus_SNo q)) J basis).
apply andI.
- let q.
  assume HqRat HqNe0.
  assume Htors.
  apply Htors.
  let m.
  assume HmPack.
  claim HmPair : m :e omega /\ m <> 0.
  { exact (andEL (m :e omega /\ m <> 0)
      (nat_primrec 0 (fun _ r => add_SNo r q) m = 0)
      HmPack). }
  claim HmO : m :e omega.
  { exact (andEL (m :e omega) (m <> 0) HmPair). }
  claim HmNe0 : m <> 0.
  { exact (andER (m :e omega) (m <> 0) HmPair). }
  claim Hsum0 : nat_primrec 0 (fun _ r => add_SNo r q) m = 0.
  { exact (andER (m :e omega /\ m <> 0)
      (nat_primrec 0 (fun _ r => add_SNo r q) m = 0)
      HmPack). }
  claim HqR : q :e real.
  { exact (Subq_rational_real q HqRat). }
  claim HqSNo : SNo q.
  { exact (real_SNo q HqR). }
  claim Hsum_mul : nat_primrec 0 (fun _ r => add_SNo r q) m = mul_SNo q m.
  {
    claim Hnat : forall k:set, nat_p k ->
      nat_primrec 0 (fun _ r => add_SNo r q) k = mul_SNo q k.
    {
      apply nat_ind.
      - rewrite (nat_primrec_0 0 (fun _ r => add_SNo r q)).
        symmetry.
        exact (mul_SNo_zeroR q HqSNo).
      - let k.
        assume Hk.
        assume IH.
        claim HkO : k :e omega.
        { exact (nat_p_omega k Hk). }
        claim HkS : SNo k.
        { exact (omega_SNo k HkO). }
        rewrite (nat_primrec_S 0 (fun _ r => add_SNo r q) k Hk).
        rewrite IH.
        claim Hk1 : add_SNo k 1 = ordsucc k.
        { exact (add_SNo_1_ordsucc k HkO). }
        claim HmulSucc : mul_SNo q (ordsucc k) = add_SNo (mul_SNo q k) q.
        {
          rewrite <- Hk1.
          rewrite (mul_SNo_distrL q k 1 HqSNo HkS SNo_1).
          rewrite (mul_SNo_oneR q HqSNo).
          reflexivity.
        }
        rewrite <- HmulSucc.
        reflexivity.
    }
    exact (Hnat m (omega_nat_p m HmO)).
  }
  claim Hqm0 : mul_SNo q m = 0.
  { rewrite <- Hsum_mul.
    exact Hsum0. }
  claim Hqmm0 : mul_SNo q m = mul_SNo q 0.
  { rewrite Hqm0.
    symmetry.
    exact (mul_SNo_zeroR q HqSNo). }
  claim Hm0 : m = 0.
  { exact (mul_SNo_nonzero_cancel q m 0
      HqSNo HqNe0 (omega_SNo m HmO) SNo_0 Hqmm0). }
  exact (HmNe0 Hm0).
- assume HfreeQ.
  apply HfreeQ.
  let J.
  assume HbasisEx.
  apply HbasisEx.
  let basis.
  assume Hfab.
  set multQ := graph (setprod rational rational) (fun p:set => add_SNo (p 0) (p 1)).
  set invQ := graph rational (fun q0:set => minus_SNo q0).
  set Gfam := graph J (fun beta:set =>
    {g :e rational | exists n:set, n :e int /\
      ((n :e omega /\ g = group_power_nat multQ 0 (apply_fun basis beta) n) \/
       (exists m:set, m :e omega /\ n = minus_SNo (ordsucc m) /\
         g = group_power_nat multQ 0 (apply_fun invQ (apply_fun basis beta)) (ordsucc m)))}).
  claim Hfab_abc : (abelian_group rational multQ 0 invQ /\ function_on basis J rational) /\
    (forall beta:set, beta :e J -> infinite_cyclic_subgroup rational multQ 0 invQ (apply_fun basis beta)).
  { exact (andEL
      ((abelian_group rational multQ 0 invQ /\ function_on basis J rational) /\
        (forall beta:set, beta :e J ->
          infinite_cyclic_subgroup rational multQ 0 invQ (apply_fun basis beta)))
      (direct_sum_of_subgroups rational multQ 0 invQ J Gfam)
      Hfab). }
  claim Hbasis_fn : function_on basis J rational.
  { exact (andER
      (abelian_group rational multQ 0 invQ)
      (function_on basis J rational)
      (andEL
        (abelian_group rational multQ 0 invQ /\ function_on basis J rational)
        (forall beta:set, beta :e J ->
          infinite_cyclic_subgroup rational multQ 0 invQ (apply_fun basis beta))
        Hfab_abc)). }
  claim Hds : direct_sum_of_subgroups rational multQ 0 invQ J Gfam.
  { exact (andER
      ((abelian_group rational multQ 0 invQ /\ function_on basis J rational) /\
        (forall beta:set, beta :e J ->
          infinite_cyclic_subgroup rational multQ 0 invQ (apply_fun basis beta)))
      (direct_sum_of_subgroups rational multQ 0 invQ J Gfam)
      Hfab). }
  claim Hsga : subgroups_generate_abelian rational multQ 0 invQ J Gfam.
  { exact (andEL
      (subgroups_generate_abelian rational multQ 0 invQ J Gfam)
      (forall x:set, x :e rational ->
        forall n1 n2:set, n1 :e omega -> n2 :e omega ->
        forall a1 a2:set, function_on a1 n1 J -> function_on a2 n2 J ->
        forall x1 x2:set, function_on x1 n1 rational -> function_on x2 n2 rational ->
          (forall i:set, i :e n1 -> apply_fun x1 i :e apply_fun Gfam (apply_fun a1 i)) ->
          (forall i:set, i :e n2 -> apply_fun x2 i :e apply_fun Gfam (apply_fun a2 i)) ->
          (forall i j:set, i :e n1 -> j :e n1 -> i <> j -> apply_fun a1 i <> apply_fun a1 j) ->
          (forall i j:set, i :e n2 -> j :e n2 -> i <> j -> apply_fun a2 i <> apply_fun a2 j) ->
          x = nat_primrec 0 (fun i r => apply_fun multQ (r, apply_fun x1 i)) n1 ->
          x = nat_primrec 0 (fun i r => apply_fun multQ (r, apply_fun x2 i)) n2 ->
          (forall alpha0:set, alpha0 :e J ->
            (forall i j:set, i :e n1 -> j :e n2 ->
              apply_fun a1 i = alpha0 -> apply_fun a2 j = alpha0 ->
              apply_fun x1 i = apply_fun x2 j) /\
            ((exists i:set, i :e n1 /\ apply_fun a1 i = alpha0) ->
             ~(exists j:set, j :e n2 /\ apply_fun a2 j = alpha0) ->
             forall i:set, i :e n1 -> apply_fun a1 i = alpha0 -> apply_fun x1 i = 0) /\
            (~(exists i:set, i :e n1 /\ apply_fun a1 i = alpha0) ->
             (exists j:set, j :e n2 /\ apply_fun a2 j = alpha0) ->
             forall j:set, j :e n2 -> apply_fun a2 j = alpha0 -> apply_fun x2 j = 0)))
      Hds). }
  claim HJne : J <> Empty.
  {
    apply (subgroups_generate_abelian_index_nonempty
      rational multQ 0 invQ J Gfam Hsga).
    witness 1.
    apply andI.
    - exact (Subq_SNoS_omega_rational 1 (omega_SNoS_omega 1 (nat_p_omega 1 nat_1))).
    - exact neq_1_0.
  }
  apply (nonempty_has_element J HJne).
  let alpha.
  assume HalphaJ : alpha :e J.
  set S := {alpha}.
  claim HSJ : S c= J.
  { exact (singleton_subset alpha J HalphaJ). }
  claim HhSpec : exists h:set,
    group_homomorphism rational multQ 2 Z2_mult h /\
    (forall beta:set, beta :e S -> apply_fun h (apply_fun basis beta) = 1) /\
    (forall beta:set, beta :e J -> ~(beta :e S) -> apply_fun h (apply_fun basis beta) = 0).
  { exact (free_abelian_hom_from_subset rational multQ 0 invQ J basis S Hfab HSJ). }
  apply HhSpec.
  let h.
  assume Hhpack.
  claim Hh_hom : group_homomorphism rational multQ 2 Z2_mult h.
  { exact (andEL
      (group_homomorphism rational multQ 2 Z2_mult h)
      (forall beta:set, beta :e S -> apply_fun h (apply_fun basis beta) = 1)
      (andEL
        (group_homomorphism rational multQ 2 Z2_mult h /\
          (forall beta:set, beta :e S -> apply_fun h (apply_fun basis beta) = 1))
        (forall beta:set, beta :e J -> ~(beta :e S) -> apply_fun h (apply_fun basis beta) = 0)
        Hhpack)). }
  claim Hh_in : forall beta:set, beta :e S -> apply_fun h (apply_fun basis beta) = 1.
  { exact (andER
      (group_homomorphism rational multQ 2 Z2_mult h)
      (forall beta:set, beta :e S -> apply_fun h (apply_fun basis beta) = 1)
      (andEL
        (group_homomorphism rational multQ 2 Z2_mult h /\
          (forall beta:set, beta :e S -> apply_fun h (apply_fun basis beta) = 1))
        (forall beta:set, beta :e J -> ~(beta :e S) -> apply_fun h (apply_fun basis beta) = 0)
        Hhpack)). }
  claim Hh_basis_alpha_1 : apply_fun h (apply_fun basis alpha) = 1.
  { exact (Hh_in alpha (SingI alpha)). }
  claim Hbasis_alpha_rat : apply_fun basis alpha :e rational.
  { exact (Hbasis_fn alpha HalphaJ). }
  claim Hh_fn : function_on h rational 2.
  { exact (andEL
      (function_on h rational 2)
      (forall x y:set, x :e rational -> y :e rational ->
        apply_fun h (apply_fun multQ (x, y)) = apply_fun Z2_mult (apply_fun h x, apply_fun h y))
      Hh_hom). }
  claim Hh_mul : forall x y:set, x :e rational -> y :e rational ->
    apply_fun h (apply_fun multQ (x, y)) = apply_fun Z2_mult (apply_fun h x, apply_fun h y).
  { exact (andER
      (function_on h rational 2)
      (forall x y:set, x :e rational -> y :e rational ->
        apply_fun h (apply_fun multQ (x, y)) = apply_fun Z2_mult (apply_fun h x, apply_fun h y))
      Hh_hom). }
  claim Hbasis_alpha_repr : exists m:set, m :e int /\
    exists n:set, n :e omega :\: {0} /\ apply_fun basis alpha = div_SNo m n.
  { exact (SepE2
      real
      (fun x:set => exists m:set, m :e int /\ exists n:set, n :e omega :\: {0} /\ x = div_SNo m n)
      (apply_fun basis alpha)
      Hbasis_alpha_rat). }
  apply Hbasis_alpha_repr.
  let m.
  assume HmPack.
  claim HmInt : m :e int.
  { exact (andEL
      (m :e int)
      (exists n:set, n :e omega :\: {0} /\ apply_fun basis alpha = div_SNo m n)
      HmPack). }
  claim HmSNo : SNo m.
  { exact (int_SNo m HmInt). }
  claim HnPack : exists n:set, n :e omega :\: {0} /\ apply_fun basis alpha = div_SNo m n.
  { exact (andER
      (m :e int)
      (exists n:set, n :e omega :\: {0} /\ apply_fun basis alpha = div_SNo m n)
      HmPack). }
  apply HnPack.
  let n.
  assume HnPack2.
  claim HnNZ : n :e omega :\: {0}.
  { exact (andEL
      (n :e omega :\: {0})
      (apply_fun basis alpha = div_SNo m n)
      HnPack2). }
  claim Hbasis_alpha_eq : apply_fun basis alpha = div_SNo m n.
  { exact (andER
      (n :e omega :\: {0})
      (apply_fun basis alpha = div_SNo m n)
      HnPack2). }
  claim HnO : n :e omega.
  { exact (setminusE1 omega {0} n HnNZ). }
  claim HnNot0Set : n /:e {0}.
  { exact (setminusE2 omega {0} n HnNZ). }
  claim HnNe0 : n <> 0.
  {
    assume Hn0.
    apply HnNot0Set.
    rewrite Hn0.
    exact (SingI 0).
  }
  claim HnNat : nat_p n.
  { exact (omega_nat_p n HnO). }
  claim HdNat : nat_p (mul_nat n 2).
  { exact (mul_nat_p n HnNat 2 nat_2). }
  claim HdO : mul_nat n 2 :e omega.
  { exact (nat_p_omega (mul_nat n 2) HdNat). }
  claim HdNe0 : mul_nat n 2 <> 0.
  {
    assume Hd0.
    apply (mul_nat_0_inv n HnNat 2 nat_2 Hd0).
    - assume Hn0. exact (HnNe0 Hn0).
    - assume H20. exact (neq_2_0 H20).
  }
  claim HdNZ : mul_nat n 2 :e omega :\: {0}.
  {
    apply setminusI.
    - exact HdO.
    - assume HdzSing.
      apply HdNe0.
      exact (SingE 0 (mul_nat n 2) HdzSing).
  }
  claim HmSNoW : m :e SNoS_ omega.
  { exact (Subq_int_SNoS_omega m HmInt). }
  claim HmReal : m :e real.
  { exact (SNoS_omega_real m HmSNoW). }
  claim HdSNoW : mul_nat n 2 :e SNoS_ omega.
  { exact (omega_SNoS_omega (mul_nat n 2) HdO). }
  claim HdReal : mul_nat n 2 :e real.
  { exact (SNoS_omega_real (mul_nat n 2) HdSNoW). }
  set r := div_SNo m (mul_nat n 2).
  claim HrReal : r :e real.
  { exact (real_div_SNo m HmReal (mul_nat n 2) HdReal). }
  claim HrRat : r :e rational.
  {
    apply (SepI
      real
      (fun x:set => exists m0:set, m0 :e int /\ exists n0:set, n0 :e omega :\: {0} /\ x = div_SNo m0 n0)
      r
      HrReal).
    witness m.
    apply andI.
    - exact HmInt.
    - witness (mul_nat n 2).
      apply andI.
      + exact HdNZ.
      + reflexivity.
  }
  claim Hh_r_2 : apply_fun h r :e 2.
  { exact (Hh_fn r HrRat). }
  claim HrSNo : SNo r.
  { exact (real_SNo r HrReal). }
  claim HnSNo : SNo n.
  { exact (omega_SNo n HnO). }
  claim H2O : 2 :e omega.
  { exact (nat_p_omega 2 nat_2). }
  claim HmulNatEq : mul_nat n 2 = mul_SNo n 2.
  { exact (mul_nat_mul_SNo n HnO 2 H2O). }
  claim HrDef : r = div_SNo m (mul_nat n 2).
  { reflexivity. }
  claim Hr_eq_div2 : r = div_SNo (div_SNo m n) 2.
  {
    rewrite HrDef.
    rewrite HmulNatEq.
    exact (eq_symm
      (div_SNo (div_SNo m n) 2)
      (div_SNo m (mul_SNo n 2))
      (div_div_SNo m n 2 HmSNo HnSNo SNo_2)).
  }
  claim H2r_eq_divmn : mul_SNo 2 r = div_SNo m n.
  {
    rewrite Hr_eq_div2.
    exact (mul_div_SNo_invR
      (div_SNo m n)
      2
      (SNo_div_SNo m n HmSNo HnSNo)
      SNo_2
      neq_2_0).
  }
  claim Hbasis_alpha_from_r : apply_fun basis alpha = mul_SNo 2 r.
  { exact (eq_i_tra
      (apply_fun basis alpha)
      (div_SNo m n)
      (mul_SNo 2 r)
      Hbasis_alpha_eq
      (eq_symm (mul_SNo 2 r) (div_SNo m n) H2r_eq_divmn)). }
  claim Hbasis_alpha_double : apply_fun basis alpha = add_SNo r r.
  { exact (eq_i_tra
      (apply_fun basis alpha)
      (mul_SNo 2 r)
      (add_SNo r r)
      Hbasis_alpha_from_r
      (mul_SNo_2_eq_add r HrSNo)). }
  claim HmultQ_rr : apply_fun multQ (r, r) = add_SNo r r.
  {
    rewrite (apply_fun_graph
      (setprod rational rational)
      (fun p:set => add_SNo (p 0) (p 1))
      (r, r)
      (tuple_2_setprod_by_pair_Sigma rational rational r r HrRat HrRat)).
    rewrite (tuple_2_0_eq r r).
    rewrite (tuple_2_1_eq r r).
    reflexivity.
  }
  claim Hh_basis_mul : apply_fun h (apply_fun basis alpha) =
    apply_fun Z2_mult (apply_fun h r, apply_fun h r).
  {
    rewrite Hbasis_alpha_double.
    rewrite <- HmultQ_rr.
    exact (Hh_mul r r HrRat HrRat).
  }
  claim Hh_basis_0 : apply_fun h (apply_fun basis alpha) = 0.
  {
    rewrite Hh_basis_mul.
    apply (in_2_cases (apply_fun h r) Hh_r_2).
    - assume Hr0.
      rewrite Hr0.
      exact Z2_mult_0_0.
    - assume Hr1.
      rewrite Hr1.
      exact Z2_mult_1_1.
  }
  claim H10 : 1 = 0.
  { rewrite <- Hh_basis_alpha_1.
    exact Hh_basis_0. }
  exact (neq_1_0 H10).
Qed.

(** from S67 Exercise 5 (line 2711 in algtop.tex) **)
(** LATEX VERSION: Give an example of a free abelian group G of rank n having **)
(** a subgroup H of rank n for which H is not equal to G. **)
(** EFFORT: 3 lines textbook, difficulty 2/10, USD 30 **)
(** Collected Bob 33 **)
(** Proven Bob **)
Theorem ex67_5_proper_subgroup_same_rank :
  forall n:set, n :e omega -> n <> 0 ->
  exists G mult e inv J1 basis1 J2 basis2:set,
    free_abelian_group_with_basis G mult e inv J1 basis1 /\
    equip J1 n /\
    exists H:set,
      subgroup_of H G mult e inv /\ H <> G /\
      free_abelian_group_with_basis H mult e inv J2 basis2 /\
      equip J2 n.
let n.
assume Hn : n :e omega.
assume HnNZ : n <> 0.
set J := n.
set Gfam := graph J (fun _ : set => int).
set multfam := graph J (fun _ : set => integers_group_mult).
set efam := graph J (fun _ : set => 0).
set invfam := graph J (fun _ : set => integers_group_inv).
claim HabFam :
  forall alpha:set, alpha :e J ->
    abelian_group
      (apply_fun Gfam alpha)
      (apply_fun multfam alpha)
      (apply_fun efam alpha)
      (apply_fun invfam alpha).
{
  let alpha.
  assume Halpha : alpha :e J.
  rewrite (apply_fun_graph J (fun _ : set => int) alpha Halpha).
  rewrite (apply_fun_graph J (fun _ : set => integers_group_mult) alpha Halpha).
  rewrite (apply_fun_graph J (fun _ : set => 0) alpha Halpha).
  rewrite (apply_fun_graph J (fun _ : set => integers_group_inv) alpha Halpha).
  claim HcommZ : forall x y:set, x :e int -> y :e int ->
    apply_fun integers_group_mult (x, y) = apply_fun integers_group_mult (y, x).
  {
    let x. let y.
    assume Hx : x :e int.
    assume Hy : y :e int.
    claim Hxy : (x, y) :e setprod int int.
    { exact (tuple_2_setprod_by_pair_Sigma int int x y Hx Hy). }
    claim Hyx : (y, x) :e setprod int int.
    { exact (tuple_2_setprod_by_pair_Sigma int int y x Hy Hx). }
    rewrite (apply_fun_graph
      (setprod int int)
      (fun p:set => add_SNo (p 0) (p 1))
      (x, y)
      Hxy).
    rewrite (tuple_2_0_eq x y).
    rewrite (tuple_2_1_eq x y).
    rewrite (apply_fun_graph
      (setprod int int)
      (fun p:set => add_SNo (p 0) (p 1))
      (y, x)
      Hyx).
    rewrite (tuple_2_0_eq y x).
    rewrite (tuple_2_1_eq y x).
    exact (add_SNo_com x y (int_SNo x Hx) (int_SNo y Hy)).
  }
  exact (andI
    (group_structure int integers_group_mult 0 integers_group_inv)
    (forall x y:set, x :e int -> y :e int ->
      apply_fun integers_group_mult (x, y) = apply_fun integers_group_mult (y, x))
    integers_group_is_group_cyclic_helper
    HcommZ).
}
claim HexDS :
  exists G multG eG invG ifam:set,
    abelian_group G multG eG invG /\
    (forall alpha:set, alpha :e J ->
      group_homomorphism (apply_fun Gfam alpha)
        (apply_fun multfam alpha) G multG (apply_fun ifam alpha) /\
      (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
        apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) y -> x = y)) /\
    direct_sum_of_subgroups G multG eG invG J
      (graph J (fun alpha:set => homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha))).
{
  exact (thm67_4_existence_external_direct_sum
    J
    Gfam
    multfam
    efam
    invfam
    HabFam).
}
claim HexDS_unpacked :
  exists G multG eG invG ifam basis1:set,
    abelian_group G multG eG invG /\
    function_on basis1 J G /\
    (forall alpha:set, alpha :e J ->
      apply_fun basis1 alpha :e homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha)) /\
    direct_sum_of_subgroups G multG eG invG J
      (graph J (fun alpha:set => homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha))).
{
  apply HexDS.
  let G.
  assume HGpack.
  apply HGpack.
  let multG.
  assume HmPack.
  apply HmPack.
  let eG.
  assume HePack.
  apply HePack.
  let invG.
  assume HinvPack.
  apply HinvPack.
  let ifam.
  assume Hmain.
  set basis1 := graph J (fun alpha:set => apply_fun (apply_fun ifam alpha) 1).
  claim Hleft :
    abelian_group G multG eG invG /\
    (forall alpha:set, alpha :e J ->
      group_homomorphism (apply_fun Gfam alpha)
        (apply_fun multfam alpha) G multG (apply_fun ifam alpha) /\
      (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
        apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) y -> x = y)).
  { exact (andEL
      (abelian_group G multG eG invG /\
        (forall alpha:set, alpha :e J ->
          group_homomorphism (apply_fun Gfam alpha)
            (apply_fun multfam alpha) G multG (apply_fun ifam alpha) /\
          (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
            apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) y -> x = y)))
      (direct_sum_of_subgroups G multG eG invG J
        (graph J (fun alpha:set => homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha))))
      Hmain). }
  claim HabG : abelian_group G multG eG invG.
  { exact (andEL
      (abelian_group G multG eG invG)
      (forall alpha:set, alpha :e J ->
        group_homomorphism (apply_fun Gfam alpha)
          (apply_fun multfam alpha) G multG (apply_fun ifam alpha) /\
        (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
          apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) y -> x = y))
      Hleft). }
  claim Hifam_data :
    forall alpha:set, alpha :e J ->
      group_homomorphism (apply_fun Gfam alpha)
        (apply_fun multfam alpha) G multG (apply_fun ifam alpha) /\
      (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
        apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) y -> x = y).
  { exact (andER
      (abelian_group G multG eG invG)
      (forall alpha:set, alpha :e J ->
        group_homomorphism (apply_fun Gfam alpha)
          (apply_fun multfam alpha) G multG (apply_fun ifam alpha) /\
        (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
          apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) y -> x = y))
      Hleft). }
  claim HdsG :
    direct_sum_of_subgroups G multG eG invG J
      (graph J (fun alpha:set => homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha))).
  { exact (andER
      (abelian_group G multG eG invG /\
        (forall alpha:set, alpha :e J ->
          group_homomorphism (apply_fun Gfam alpha)
            (apply_fun multfam alpha) G multG (apply_fun ifam alpha) /\
          (forall x y:set, x :e apply_fun Gfam alpha -> y :e apply_fun Gfam alpha ->
            apply_fun (apply_fun ifam alpha) x = apply_fun (apply_fun ifam alpha) y -> x = y)))
      (direct_sum_of_subgroups G multG eG invG J
        (graph J (fun alpha:set => homomorphism_image (apply_fun Gfam alpha) (apply_fun ifam alpha))))
      Hmain). }
