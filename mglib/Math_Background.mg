  }
  claim Heq1 :
    apply_fun (graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2)) 1 = G2.
  {
    rewrite (apply_fun_graph
      (UPair 0 1)
      (fun i:set => if i = 0 then G1 else G2)
