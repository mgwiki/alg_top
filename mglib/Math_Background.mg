          S1
          S1_topology
          covering_map_R_S1
          e0
          gamma)
        (eps_ 1)))
    (apply_fun covering_map_R_S1 e0)
    (eq_symm
      (apply_fun covering_map_R_S1
        (apply_fun
          (path_lift
            R
            R_standard_topology
            S1
            S1_topology
            covering_map_R_S1
            e0
            gamma)
