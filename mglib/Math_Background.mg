    (apply_fun s55_S1_antipode_map y)
    HinvIn
    HyImageInS1
    HinvEqFF).
}
rewrite (inv_fun_graph_apply
  S1
  S1
  s55_S1_antipode_map
  y
  HyS1).
exact HinvAtY.
Qed.

