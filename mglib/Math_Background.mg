    claim HSNot :
      SNo t.
    {
      exact (real_SNo
        t
        HtR).
    }
    claim HdoubleHalfT :
      mul_SNo (mul_SNo 2 t) (eps_ 1) = t.
    {
      claim Hstep1 :
        mul_SNo (mul_SNo 2 t) (eps_ 1) =
        mul_SNo 2 (mul_SNo t (eps_ 1)).
      {
        symmetry.
        exact (mul_SNo_assoc
          2
          t
          (eps_ 1)
          SNo_2
          HSNot
          SNo_eps_1).
      }
      claim Hstep2 :
        mul_SNo 2 (mul_SNo t (eps_ 1)) =
        mul_SNo t (mul_SNo 2 (eps_ 1)).
      {
        exact (mul_SNo_com_3_0_1
          2
          t
          (eps_ 1)
          SNo_2
          HSNot
          SNo_eps_1).
      }
      rewrite Hstep1.
      rewrite Hstep2.
      rewrite eps_1_half_eq2.
      rewrite (mul_SNo_oneR
        t
        HSNot).
      reflexivity.
    }
    apply (binunionE
      unit_interval_left_half
      unit_interval_right_half
      t
      (unit_interval_halves_cover
        (fun a b:set => t :e b)
        HtI)).
    - assume HtL.
      claim H2tI :
        mul_SNo 2 t :e unit_interval.
      {
        rewrite <- (double_map_apply
          t
          HtL).
        exact (double_map_function_on
          t
          HtL).
      }
      rewrite (path_concat_apply_left
        alpha_half
        beta_half
        t
        HalphaBetaJoin
        HtL).
      rewrite (compose_fun_apply
        unit_interval
        (affine_fun_I 0 (eps_ 1))
        gamma
        (mul_SNo 2 t)
        H2tI).
      rewrite (affine_fun_I_apply
        0
        (eps_ 1)
        (mul_SNo 2 t)
        real_0
        eps_1_in_R
        (RltE_lt 0 (eps_ 1) eps_1_pos_R)
        H2tI).
      rewrite (add_SNo_0R
        (mul_SNo (mul_SNo 2 t) (eps_ 1))
        (SNo_mul_SNo
          (mul_SNo 2 t)
          (eps_ 1)
          (SNo_mul_SNo
            2
            t
            SNo_2
            HSNot)
          SNo_eps_1)).
      rewrite HdoubleHalfT.
      reflexivity.
    - assume HtRHalf.
      claim H2tm1I :
        add_SNo (mul_SNo 2 t) (minus_SNo 1) :e unit_interval.
      {
        rewrite <- (double_minus_one_map_apply
          t
          HtRHalf).
        exact (double_minus_one_map_function_on
          t
          HtRHalf).
      }
      claim HSNo_2t :
        SNo (mul_SNo 2 t).
      {
        exact (SNo_mul_SNo
          2
          t
          SNo_2
          HSNot).
      }
      rewrite (path_concat_apply_right
        alpha_half
        beta_half
        t
        HalphaBetaJoin
        HtRHalf).
      rewrite (compose_fun_apply
        unit_interval
        (affine_fun_I (eps_ 1) (eps_ 1))
        gamma
        (add_SNo (mul_SNo 2 t) (minus_SNo 1))
        H2tm1I).
      rewrite (affine_fun_I_apply
        (eps_ 1)
        (eps_ 1)
        (add_SNo (mul_SNo 2 t) (minus_SNo 1))
        eps_1_in_R
        eps_1_in_R
        (RltE_lt 0 (eps_ 1) eps_1_pos_R)
        H2tm1I).
      rewrite (mul_SNo_distrR
        (mul_SNo 2 t)
        (minus_SNo 1)
        (eps_ 1)
        HSNo_2t
        (SNo_minus_SNo 1 SNo_1)
        SNo_eps_1).
      rewrite (mul_SNo_minus_distrL
        1
        (eps_ 1)
        SNo_1
        SNo_eps_1).
      rewrite (mul_SNo_oneL
        (eps_ 1)
        SNo_eps_1).
      rewrite (add_SNo_minus_R2'
        (mul_SNo (mul_SNo 2 t) (eps_ 1))
        (eps_ 1)
        (SNo_mul_SNo
          (mul_SNo 2 t)
          (eps_ 1)
          HSNo_2t
          SNo_eps_1)
        SNo_eps_1).
      rewrite HdoubleHalfT.
      reflexivity.
  }
