  exists k:set,
    homeomorphism
      (orbit_space X (covering_transformation_group X Tx B Tb p))
      (orbit_topology X Tx (covering_transformation_group X Tx B Tb p))
      B Tb k /\
    (forall x:set, x :e X ->
      apply_fun k (apply_fun (orbit_map X (covering_transformation_group X Tx B Tb p)) x) =
      apply_fun p x).
admit.
