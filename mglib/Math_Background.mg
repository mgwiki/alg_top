                            rewrite (If_i_0 (1 = 0) (apply_fun cs3 k2)
                              (if 1 = 1 then x3 else apply_fun inv (apply_fun cs3 k2)) H10B).
                            exact (If_i_1 (1 = 1) x3 (apply_fun inv (apply_fun cs3 k2)) (fun q H => H)). }
                          claim HcwB2 : apply_fun conj_word_B 2 = apply_fun inv (apply_fun cs3 k2).
                          { claim H2in3B : 2 :e 3. { exact (ordsuccI2 2). }
                            claim HevalB : apply_fun conj_word_B 2 =
                              (if 2 = 0 then apply_fun cs3 k2
                               else if 2 = 1 then x3
                               else apply_fun inv (apply_fun cs3 k2)).
                            { exact (apply_fun_graph 3 (fun i:set =>
                                if i = 0 then apply_fun cs3 k2
                                else if i = 1 then x3
                                else apply_fun inv (apply_fun cs3 k2)) 2 H2in3B). }
                            rewrite HevalB.
                            claim H20B : 2 <> 0. { exact (neq_2_0). }
                            rewrite (If_i_0 (2 = 0) (apply_fun cs3 k2)
                              (if 2 = 1 then x3 else apply_fun inv (apply_fun cs3 k2)) H20B).
                            claim H21B : 2 <> 1.
                            { assume HB : 2 = 1. claim H10B : 1 = 0. { exact (ordsucc_inj 1 0 HB). }
                              exact (neq_ordsucc_0 0 H10B). }
                            exact (If_i_0 (2 = 1) x3 (apply_fun inv (apply_fun cs3 k2)) H21B). }
                          (** Build reduced_word **)
                          claim Hred_cwB : reduced_word J Gfam efam 3 conj_word_B.
                          { prove 3 :e omega /\
                              (forall i:set, i :e 3 ->
                                exists a:set, a :e J /\ apply_fun conj_word_B i :e apply_fun Gfam a /\ apply_fun conj_word_B i <> apply_fun efam a) /\
                              (forall i:set, i :e 3 -> ordsucc i :e 3 ->
                                forall a b:set, a :e J -> b :e J ->
                                apply_fun conj_word_B i :e apply_fun Gfam a ->
                                apply_fun conj_word_B (ordsucc i) :e apply_fun Gfam b -> a <> b).
                            apply and3I.
                            - exact (nat_p_omega 3 (nat_ordsucc 2 (nat_ordsucc 1 (nat_ordsucc 0 nat_0)))).
                            - (** Each entry in a factor and not efam **)
                              let i. assume Hi3.
                              apply (ordsuccE 2 i Hi3).
                              + assume Hi2.
                                apply (ordsuccE 1 i Hi2).
                                * assume Hi1.
                                  apply (ordsuccE 0 i Hi1).
                                  { assume Hi0. exact (FalseE (EmptyE i Hi0)
                                      (exists a:set, a :e J /\ apply_fun conj_word_B i :e apply_fun Gfam a /\ apply_fun conj_word_B i <> apply_fun efam a)). }
                                  { assume Hi_eq0B : i = 0. rewrite Hi_eq0B. rewrite HcwB0.
                                    witness gamma2. apply and3I. exact Hg2J. exact Hcs3k2_Gg2. exact Hcs3k2_ne. }
                                * assume Hi_eq1B : i = 1. rewrite Hi_eq1B. rewrite HcwB1.
                                  witness alpha. apply and3I. exact HalJ. exact Hx3Ga. exact Hx3_ne_efamB.
                              + assume Hi_eq2B : i = 2. rewrite Hi_eq2B. rewrite HcwB2.
                                witness gamma2. apply and3I. exact Hg2J. exact Hinvcs3k2_Gg2B. exact Hinvcs3k2_ne_efamB.
                            - (** Adjacency: adjacent entries in different factors **)
                              let i. assume Hi3 Hsi3.
                              let a b. assume HaJ HbJ Hia Hsib.
                              apply (ordsuccE 2 i Hi3).
                              + assume Hi2.
                                apply (ordsuccE 1 i Hi2).
                                * assume Hi1.
                                  apply (ordsuccE 0 i Hi1).
                                  { assume Hi0. exact (FalseE (EmptyE i Hi0) (a <> b)). }
                                  { assume Hi_eq0B : i = 0.
                                    (** cw(0)=cs3(k2) in Gfam(a), cw(1)=x3 in Gfam(b), need a <> b **)
                                    claim HcwB0_Ga : apply_fun cs3 k2 :e apply_fun Gfam a.
                                    { claim HeqiB : apply_fun conj_word_B i = apply_fun conj_word_B 0.
                                      { rewrite Hi_eq0B. reflexivity. }
                                      claim HcwB0i : apply_fun conj_word_B 0 :e apply_fun Gfam a.
                                      { exact (eq_subst_mem_rev (apply_fun conj_word_B i) (apply_fun conj_word_B 0)
                                          (apply_fun Gfam a) HeqiB Hia). }
                                      exact (eq_subst_mem_rev (apply_fun conj_word_B 0) (apply_fun cs3 k2)
                                        (apply_fun Gfam a) HcwB0 HcwB0i). }
                                    claim HcwB1_Gb : x3 :e apply_fun Gfam b.
                                    { claim HsiB : ordsucc i = 1. { rewrite Hi_eq0B. reflexivity. }
                                      claim HeqsiB : apply_fun conj_word_B (ordsucc i) = apply_fun conj_word_B 1.
                                      { rewrite HsiB. reflexivity. }
                                      claim HcwB1i : apply_fun conj_word_B 1 :e apply_fun Gfam b.
                                      { exact (eq_subst_mem_rev (apply_fun conj_word_B (ordsucc i)) (apply_fun conj_word_B 1)
                                          (apply_fun Gfam b) HeqsiB Hsib). }
                                      exact (eq_subst_mem_rev (apply_fun conj_word_B 1) x3
                                        (apply_fun Gfam b) HcwB1 HcwB1i). }
                                    assume HabB : a = b.
                                    (** cs3(k2) in Gfam(a) and Gfam(gamma2). x3 in Gfam(a) and Gfam(alpha). a = b. **)
                                    apply (xm (a = alpha)).
                                    + assume Ha_alphaB : a = alpha.
                                      (** cs3(k2) in Gfam(alpha) and Gfam(gamma2), gamma2 <> alpha -> cs3(k2) = e **)
                                      claim Hcs3k2_GaB : apply_fun cs3 k2 :e apply_fun Gfam alpha.
                                      { rewrite <- Ha_alphaB. exact HcwB0_Ga. }
                                      claim Hcs3k2_eB : apply_fun cs3 k2 = e.
                                      { exact (Hdisjoint alpha gamma2 HalJ Hg2J
                                          (fun Heq : alpha = gamma2 => Hg2_ne_alpha (eq_symm alpha gamma2 Heq))
                                          (apply_fun cs3 k2) Hcs3k2_GaB Hcs3k2_Gg2). }
                                      exact (Hcs3k2_neB Hcs3k2_eB).
                                    + assume Ha_ne_alphaB : a <> alpha.
                                      (** x3 in Gfam(b) = Gfam(a) and Gfam(alpha), a <> alpha -> x3 = e **)
                                      claim Hx3_GaB : x3 :e apply_fun Gfam a.
                                      { rewrite HabB. exact HcwB1_Gb. }
                                      claim Hx3_eB : x3 = e.
                                      { exact (Hdisjoint a alpha HaJ HalJ Ha_ne_alphaB x3 Hx3_GaB Hx3Ga). }
                                      exact (Hx3ne Hx3_eB). }
                                * assume Hi_eq1B : i = 1.
                                  (** cw(1)=x3 in Gfam(a), cw(2)=inv(cs3(k2)) in Gfam(b), need a <> b **)
                                  claim HcwB1_Ga : x3 :e apply_fun Gfam a.
                                  { claim HeqiB : apply_fun conj_word_B i = apply_fun conj_word_B 1.
                                    { rewrite Hi_eq1B. reflexivity. }
                                    claim HcwB1i : apply_fun conj_word_B 1 :e apply_fun Gfam a.
                                    { exact (eq_subst_mem_rev (apply_fun conj_word_B i) (apply_fun conj_word_B 1)
                                        (apply_fun Gfam a) HeqiB Hia). }
                                    exact (eq_subst_mem_rev (apply_fun conj_word_B 1) x3
                                      (apply_fun Gfam a) HcwB1 HcwB1i). }
                                  claim HcwB2_Gb : apply_fun inv (apply_fun cs3 k2) :e apply_fun Gfam b.
                                  { claim HsiB : ordsucc i = 2. { rewrite Hi_eq1B. reflexivity. }
                                    claim HeqsiB : apply_fun conj_word_B (ordsucc i) = apply_fun conj_word_B 2.
                                    { rewrite HsiB. reflexivity. }
                                    claim HcwB2i : apply_fun conj_word_B 2 :e apply_fun Gfam b.
                                    { exact (eq_subst_mem_rev (apply_fun conj_word_B (ordsucc i)) (apply_fun conj_word_B 2)
                                        (apply_fun Gfam b) HeqsiB Hsib). }
                                    exact (eq_subst_mem_rev (apply_fun conj_word_B 2) (apply_fun inv (apply_fun cs3 k2))
                                      (apply_fun Gfam b) HcwB2 HcwB2i). }
                                  assume HabB : a = b.
                                  apply (xm (a = gamma2)).
                                  + assume Ha_g2B : a = gamma2.
                                    (** x3 in Gfam(gamma2) and Gfam(alpha), gamma2 <> alpha -> x3 = e **)
                                    claim Hx3_Gg2B : x3 :e apply_fun Gfam gamma2.
                                    { rewrite <- Ha_g2B. exact HcwB1_Ga. }
                                    claim Hx3_eB : x3 = e.
                                    { exact (Hdisjoint gamma2 alpha Hg2J HalJ Hg2_ne_alpha x3 Hx3_Gg2B Hx3Ga). }
                                    exact (Hx3ne Hx3_eB).
                                  + assume Ha_ne_g2B : a <> gamma2.
                                    (** inv(cs3(k2)) in Gfam(b)=Gfam(a) and Gfam(gamma2), a <> gamma2 -> inv(cs3(k2)) = e **)
                                    claim Hinv_GaB : apply_fun inv (apply_fun cs3 k2) :e apply_fun Gfam a.
                                    { rewrite HabB. exact HcwB2_Gb. }
                                    claim Hinvcs3k2_eB : apply_fun inv (apply_fun cs3 k2) = e.
                                    { exact (Hdisjoint a gamma2 HaJ Hg2J Ha_ne_g2B (apply_fun inv (apply_fun cs3 k2))
                                        Hinv_GaB Hinvcs3k2_Gg2B). }
                                    exact (Hinvcs3k2_neB Hinvcs3k2_eB).
                              + assume Hi_eq2B : i = 2.
                                (** ordsucc 2 = 3 :e 3 is false **)
                                claim Hsi_eqB : ordsucc i = 3. { rewrite Hi_eq2B. reflexivity. }
                                claim Hsi3_falseB : 3 :e 3.
                                { exact (eq_subst_mem_rev (ordsucc i) 3 3 Hsi_eqB Hsi3). }
                                exact (FalseE (In_irref 3 Hsi3_falseB) (a <> b)). }
                          (** word_product of conj_word_B = y3 **)
                          claim Hwp_cwB : word_product mult e conj_word_B 3 = y3.
                          { prove nat_primrec e (fun i r => apply_fun mult (r, apply_fun conj_word_B i)) 3 = y3.
                            set fwpB := fun i:set => fun r:set => apply_fun mult (r, apply_fun conj_word_B i).
                            claim Hstep2B : nat_primrec e fwpB 3 = fwpB 2 (nat_primrec e fwpB 2).
                            { exact (nat_primrec_S e fwpB 2 (nat_ordsucc 1 (nat_ordsucc 0 nat_0))). }
                            claim Hstep1B : nat_primrec e fwpB 2 = fwpB 1 (nat_primrec e fwpB 1).
                            { exact (nat_primrec_S e fwpB 1 (nat_ordsucc 0 nat_0)). }
                            claim Hstep0B : nat_primrec e fwpB 1 = fwpB 0 (nat_primrec e fwpB 0).
                            { exact (nat_primrec_S e fwpB 0 nat_0). }
                            claim HbaseB : nat_primrec e fwpB 0 = e.
                            { exact (nat_primrec_0 e fwpB). }
                            rewrite Hstep2B. rewrite Hstep1B. rewrite Hstep0B. rewrite HbaseB.
                            prove fwpB 2 (fwpB 1 (fwpB 0 e)) = y3.
                            prove apply_fun mult (apply_fun mult (apply_fun mult (e, apply_fun conj_word_B 0), apply_fun conj_word_B 1), apply_fun conj_word_B 2) = y3.
                            rewrite HcwB0. rewrite HcwB1. rewrite HcwB2.
                            claim Hecs_B : apply_fun mult (e, apply_fun cs3 k2) = apply_fun cs3 k2.
                            { exact (andEL (apply_fun mult (e, apply_fun cs3 k2) = apply_fun cs3 k2)
                                (apply_fun mult (apply_fun cs3 k2, e) = apply_fun cs3 k2)
                                (Hid (apply_fun cs3 k2) Hcs3k2_G)). }
                            rewrite Hecs_B.
                            (** mult(mult(cs3(k2), x3), inv(cs3(k2))) = y3 **)
                            (** y3 = mult(mult(c3, x3), inv(c3)) and c3 = cs3(k2) **)
                            prove apply_fun mult (apply_fun mult (apply_fun cs3 k2, x3), apply_fun inv (apply_fun cs3 k2)) = y3.
                            prove apply_fun mult (apply_fun mult (apply_fun cs3 k2, x3), apply_fun inv (apply_fun cs3 k2)) =
                              apply_fun mult (apply_fun mult (c3, x3), apply_fun inv c3).
                            rewrite Hc3_is_cs3k2B. reflexivity. }
                          (** y3 has reduced word of length 1 **)
                          claim Hy3_len1B : 3 = 1.
                          { exact (free_product_factor_element_length1 G mult e inv J Gfam efam beta y3 3 conj_word_B
                              Hfp HbeJ Hy3Gb Hy3_ne Hy3_ne_efam Hred_cwB (neq_ordsucc_0 2) Hwp_cwB). }
                          (** 3 = 1 is false **)
                          claim H3ne1B : 3 <> 1.
                          { assume H31B : 3 = 1. claim H20B : 2 = 0. { exact (ordsucc_inj 2 0 H31B). }
                            exact (neq_2_0 H20B). }
                          exact (FalseE (H3ne1B Hy3_len1B) (y3 = e)).
                        * assume Hk2_ne0B : k2 <> 0.
                          (** k2 >= 1. Full word of length 2m+1 >= 5. **)
                          (** Strategy: build reversed-inverse word of cs3 via nat_ind, **)
                          (** concatenate cs3 ++ [x3] ++ reversed_inv to get 2m+1 word for y3, **)
                          (** then use factor_element_length1 to get 2m+1 = 1, contradiction. **)
                          claim Hk2_omega : k2 :e omega. { exact (nat_p_omega k2 Hk2_nat). }
                          claim Hm_nat2 : nat_p m. { exact Hm_nat. }
                          claim Hm_omega2 : m :e omega. { exact (nat_p_omega m Hm_nat2). }
                          (** cs3 entries are in G **)
                          claim Hcs3_in_G_all : forall i:set, i :e m -> apply_fun cs3 i :e G.
                          { let i. assume Hi. exact (reduced_word_in_G G mult e inv J Gfam efam m cs3 Hsubfam Hred3 i Hi). }
                          (** cs3 entries are not e **)
                          claim Hcs3_ne_e_all : forall i:set, i :e m -> apply_fun cs3 i <> e.
                          { let i. assume Hi.
                            apply (Hcs3_mem i Hi). let ai. assume Hai_pack : ai :e J /\ apply_fun cs3 i :e apply_fun Gfam ai /\ apply_fun cs3 i <> apply_fun efam ai.
                            claim Hne_efam : apply_fun cs3 i <> apply_fun efam ai.
                            { exact (andER (ai :e J /\ apply_fun cs3 i :e apply_fun Gfam ai) (apply_fun cs3 i <> apply_fun efam ai) Hai_pack). }
                            claim HaiJ : ai :e J.
                            { exact (andEL (ai :e J) (apply_fun cs3 i :e apply_fun Gfam ai) (andEL (ai :e J /\ apply_fun cs3 i :e apply_fun Gfam ai) (apply_fun cs3 i <> apply_fun efam ai) Hai_pack)). }
                            claim Hefam_e : apply_fun efam ai = e.
                            { exact (free_product_efam_eq_e G mult e inv J Gfam efam Hfp ai HaiJ). }
                            assume Habs : apply_fun cs3 i = e. apply Hne_efam. rewrite Hefam_e. exact Habs. }
                          (** inv of cs3 entries: properties **)
                          claim Hinv_cs3_in_G : forall i:set, i :e m -> apply_fun inv (apply_fun cs3 i) :e G.
                          { let i. assume Hi. exact (HinvG (apply_fun cs3 i) (Hcs3_in_G_all i Hi)). }
                          claim Hinv_cs3_factor : forall i:set, i :e m ->
                            forall ai:set, ai :e J -> apply_fun cs3 i :e apply_fun Gfam ai ->
                            apply_fun inv (apply_fun cs3 i) :e apply_fun Gfam ai.
                          { let i. assume Hi. let ai. assume HaiJ Hcs3_ai.
                            exact (HGfam_inv ai HaiJ (apply_fun cs3 i) Hcs3_ai). }
                          claim Hinv_cs3_ne_e : forall i:set, i :e m -> apply_fun inv (apply_fun cs3 i) <> e.
                          { let i. assume Hi Hie.
                            apply (Hcs3_ne_e_all i Hi).
                            claim Hrinv : apply_fun mult (apply_fun inv (apply_fun cs3 i), apply_fun cs3 i) = e.
                            { exact (andER (apply_fun mult (apply_fun cs3 i, apply_fun inv (apply_fun cs3 i)) = e)
                                (apply_fun mult (apply_fun inv (apply_fun cs3 i), apply_fun cs3 i) = e)
                                (Hinverse (apply_fun cs3 i) (Hcs3_in_G_all i Hi))). }
                            claim Hid_cs3i : apply_fun mult (e, apply_fun cs3 i) = apply_fun cs3 i.
                            { exact (andEL (apply_fun mult (e, apply_fun cs3 i) = apply_fun cs3 i)
                                (apply_fun mult (apply_fun cs3 i, e) = apply_fun cs3 i)
                                (Hid (apply_fun cs3 i) (Hcs3_in_G_all i Hi))). }
                            claim Hsym : apply_fun cs3 i = apply_fun mult (e, apply_fun cs3 i).
                            { symmetry. exact Hid_cs3i. }
                            rewrite Hsym. rewrite <- Hie at 1. exact Hrinv. }
                          claim Hinv_cs3_ne_efam : forall i:set, i :e m ->
                            forall ai:set, ai :e J -> apply_fun cs3 i :e apply_fun Gfam ai ->
                            apply_fun inv (apply_fun cs3 i) <> apply_fun efam ai.
                          { let i. assume Hi. let ai. assume HaiJ Hcs3_ai.
                            assume Habs : apply_fun inv (apply_fun cs3 i) = apply_fun efam ai.
                            apply (Hinv_cs3_ne_e i Hi).
                            rewrite Habs. exact (free_product_efam_eq_e G mult e inv J Gfam efam Hfp ai HaiJ). }
                          (** PART 1: Build reversed-inverse word via nat_ind **)
                          (** P(j) for j :e ordsucc k2: exists ws of length ordsucc j, **)
                          (** reduced, product = inv(wp(cs3, ordsucc j)), first entry = inv(cs3(j)) **)
                          set P_ri := fun j:set =>
                            exists ws:set, reduced_word J Gfam efam (ordsucc j) ws /\
                            word_product mult e ws (ordsucc j) =
                              apply_fun inv (word_product mult e cs3 (ordsucc j)) /\
                            apply_fun ws 0 = apply_fun inv (apply_fun cs3 j).
                          claim Hri_build : forall j:set, nat_p j -> j :e ordsucc k2 -> P_ri j.
                          {
                            apply (nat_ind (fun j => j :e ordsucc k2 -> P_ri j)).
                            - (** Base: j = 0 **)
                              assume H0_sk2 : 0 :e ordsucc k2.
                              prove P_ri 0.
                              prove exists ws:set, reduced_word J Gfam efam 1 ws /\
                                word_product mult e ws 1 =
                                  apply_fun inv (word_product mult e cs3 1) /\
                                apply_fun ws 0 = apply_fun inv (apply_fun cs3 0).
                              set ws0 := graph 1 (fun _:set => apply_fun inv (apply_fun cs3 0)).
                              witness ws0.
                              claim H0m : 0 :e m.
                              { rewrite Hm_eq. exact (nat_0_in_ordsucc k2 Hk2_nat). }
                              claim Hcs30_G2 : apply_fun cs3 0 :e G. { exact (Hcs3_in_G_all 0 H0m). }
                              claim Hinv0_G : apply_fun inv (apply_fun cs3 0) :e G. { exact (HinvG (apply_fun cs3 0) Hcs30_G2). }
                              (** Evaluate ws0(0) **)
                              claim Hws0_0 : apply_fun ws0 0 = apply_fun inv (apply_fun cs3 0).
                              { exact (apply_fun_graph 1 (fun _:set => apply_fun inv (apply_fun cs3 0)) 0 (ordsuccI2 0)). }
                              apply and3I.
                              + (** reduced_word 1 ws0 **)
                                prove 1 :e omega /\
                                  (forall i:set, i :e 1 ->
                                    exists a:set, a :e J /\ apply_fun ws0 i :e apply_fun Gfam a /\ apply_fun ws0 i <> apply_fun efam a) /\
                                  (forall i:set, i :e 1 -> ordsucc i :e 1 ->
                                    forall a b:set, a :e J -> b :e J ->
                                    apply_fun ws0 i :e apply_fun Gfam a ->
                                    apply_fun ws0 (ordsucc i) :e apply_fun Gfam b -> a <> b).
                                apply and3I.
                                * exact (nat_p_omega 1 (nat_ordsucc 0 nat_0)).
                                * let i. assume Hi1 : i :e 1.
                                  apply (ordsuccE 0 i Hi1).
                                  { assume Hi_empty : i :e 0. exact (FalseE (EmptyE i Hi_empty) (exists a:set, a :e J /\ apply_fun ws0 i :e apply_fun Gfam a /\ apply_fun ws0 i <> apply_fun efam a)). }
                                  { assume Hi0 : i = 0.
                                  rewrite Hi0. rewrite Hws0_0.
                                  apply (Hcs3_mem 0 H0m). let a0.
                                  assume Ha0p : a0 :e J /\ apply_fun cs3 0 :e apply_fun Gfam a0 /\ apply_fun cs3 0 <> apply_fun efam a0.
                                  claim Ha0J : a0 :e J. { exact (andEL (a0 :e J) (apply_fun cs3 0 :e apply_fun Gfam a0) (andEL (a0 :e J /\ apply_fun cs3 0 :e apply_fun Gfam a0) (apply_fun cs3 0 <> apply_fun efam a0) Ha0p)). }
                                  claim Hcs3_0_a0 : apply_fun cs3 0 :e apply_fun Gfam a0. { exact (andER (a0 :e J) (apply_fun cs3 0 :e apply_fun Gfam a0) (andEL (a0 :e J /\ apply_fun cs3 0 :e apply_fun Gfam a0) (apply_fun cs3 0 <> apply_fun efam a0) Ha0p)). }
                                  witness a0. apply and3I.
                                  { exact Ha0J. }
                                  { exact (Hinv_cs3_factor 0 H0m a0 Ha0J Hcs3_0_a0). }
                                  { exact (Hinv_cs3_ne_efam 0 H0m a0 Ha0J Hcs3_0_a0). } }
                                * let i. assume Hi1 Hsi1.
                                  (** ordsucc i :e 1 means ordsucc i :e ordsucc 0: impossible **)
                                  apply (ordsuccE 0 (ordsucc i) Hsi1).
                                  { assume Hsi0 : ordsucc i :e 0. exact (FalseE (EmptyE (ordsucc i) Hsi0) (forall a b:set, a :e J -> b :e J -> apply_fun ws0 i :e apply_fun Gfam a -> apply_fun ws0 (ordsucc i) :e apply_fun Gfam b -> a <> b)). }
                                  { assume Hsi_eq0 : ordsucc i = 0. exact (FalseE (neq_ordsucc_0 i Hsi_eq0) (forall a b:set, a :e J -> b :e J -> apply_fun ws0 i :e apply_fun Gfam a -> apply_fun ws0 (ordsucc i) :e apply_fun Gfam b -> a <> b)). }
                              + (** word product = inv(wp(cs3, 1)) **)
                                claim Hwp_ws0 : word_product mult e ws0 1 = apply_fun inv (apply_fun cs3 0).
                                { exact (word_product_singleton_group G mult e inv (apply_fun inv (apply_fun cs3 0)) Hgrp Hinv0_G). }
                                claim Hwp_cs3_1 : word_product mult e cs3 1 = apply_fun cs3 0.
                                { claim Hstep : word_product mult e cs3 1 = apply_fun mult (word_product mult e cs3 0, apply_fun cs3 0).
                                  { exact (word_product_succ mult e cs3 0 nat_0). }
                                  claim Hbase : word_product mult e cs3 0 = e.
                                  { exact (nat_primrec_0 e (fun i r => apply_fun mult (r, apply_fun cs3 i))). }
                                  rewrite Hstep. rewrite Hbase.
                                  exact (andEL (apply_fun mult (e, apply_fun cs3 0) = apply_fun cs3 0)
                                    (apply_fun mult (apply_fun cs3 0, e) = apply_fun cs3 0) (Hid (apply_fun cs3 0) Hcs30_G2)). }
                                claim Hinv_cs3_0 : apply_fun inv (apply_fun cs3 0) = apply_fun inv (word_product mult e cs3 1).
                                { rewrite Hwp_cs3_1. reflexivity. }
                                rewrite Hwp_ws0. exact Hinv_cs3_0.
                              + exact Hws0_0.
                            - (** Step: j -> ordsucc j **)
                              let j. assume Hj_nat : nat_p j.
                              assume HIHP : j :e ordsucc k2 -> P_ri j.
                              assume Hsj_sk2 : ordsucc j :e ordsucc k2.
                              prove P_ri (ordsucc j).
                              (** j :e k2 from ordsucc j :e ordsucc k2 **)
                              claim Hj_k2 : j :e k2.
                              { apply (ordsuccE k2 (ordsucc j) Hsj_sk2).
                                - assume Hsj_k2 : ordsucc j :e k2.
                                  exact (nat_trans k2 Hk2_nat (ordsucc j) Hsj_k2 j (ordsuccI2 j)).
                                - assume Hsj_eq_k2 : ordsucc j = k2.
                                  rewrite <- Hsj_eq_k2. exact (ordsuccI2 j). }
                              claim Hj_sk2 : j :e ordsucc k2.
                              { exact (ordsuccI1 k2 j Hj_k2). }
                              claim Hj_m : j :e m. { rewrite Hm_eq. exact Hj_sk2. }
                              claim Hsj_m : ordsucc j :e m. { rewrite Hm_eq. exact Hsj_sk2. }
                              claim Hsj_nat : nat_p (ordsucc j). { exact (nat_ordsucc j Hj_nat). }
                              claim Hsj_omega : ordsucc j :e omega. { exact (nat_p_omega (ordsucc j) Hsj_nat). }
                              (** Get IH for j **)
                              claim HPj : P_ri j. { exact (HIHP Hj_sk2). }
                              apply HPj. let ws_j.
                              assume Hws_j_pack : reduced_word J Gfam efam (ordsucc j) ws_j /\
                                word_product mult e ws_j (ordsucc j) =
                                  apply_fun inv (word_product mult e cs3 (ordsucc j)) /\
                                apply_fun ws_j 0 = apply_fun inv (apply_fun cs3 j).
                              apply (and3E (reduced_word J Gfam efam (ordsucc j) ws_j)
                                (word_product mult e ws_j (ordsucc j) = apply_fun inv (word_product mult e cs3 (ordsucc j)))
                                (apply_fun ws_j 0 = apply_fun inv (apply_fun cs3 j))
                                Hws_j_pack).
                              assume Hred_wsj Hwp_wsj Hfirst_wsj.
                              (** Build 1-element word [inv(cs3(ordsucc j))] **)
                              set ws_sj_single := graph 1 (fun _:set => apply_fun inv (apply_fun cs3 (ordsucc j))).
                              claim Hinv_sj_G : apply_fun inv (apply_fun cs3 (ordsucc j)) :e G.
                              { exact (Hinv_cs3_in_G (ordsucc j) Hsj_m). }
                              claim Hred_single : reduced_word J Gfam efam 1 ws_sj_single.
                              { prove 1 :e omega /\
                                  (forall i:set, i :e 1 ->
                                    exists a:set, a :e J /\ apply_fun ws_sj_single i :e apply_fun Gfam a /\ apply_fun ws_sj_single i <> apply_fun efam a) /\
                                  (forall i:set, i :e 1 -> ordsucc i :e 1 ->
                                    forall a b:set, a :e J -> b :e J ->
                                    apply_fun ws_sj_single i :e apply_fun Gfam a ->
                                    apply_fun ws_sj_single (ordsucc i) :e apply_fun Gfam b -> a <> b).
                                apply and3I.
                                - exact (nat_p_omega 1 (nat_ordsucc 0 nat_0)).
                                - let i. assume Hi1.
                                  apply (ordsuccE 0 i Hi1).
                                  { assume Hi_empty : i :e 0. exact (FalseE (EmptyE i Hi_empty)
                                      (exists a:set, a :e J /\ apply_fun ws_sj_single i :e apply_fun Gfam a /\ apply_fun ws_sj_single i <> apply_fun efam a)). }
                                  { assume Hi0 : i = 0.
                                  rewrite Hi0.
                                  claim Heval : apply_fun ws_sj_single 0 = apply_fun inv (apply_fun cs3 (ordsucc j)).
                                  { exact (apply_fun_graph 1 (fun _:set => apply_fun inv (apply_fun cs3 (ordsucc j))) 0 (ordsuccI2 0)). }
                                  rewrite Heval.
                                  apply (Hcs3_mem (ordsucc j) Hsj_m). let asj.
                                  assume Hasj_pack : asj :e J /\ apply_fun cs3 (ordsucc j) :e apply_fun Gfam asj /\ apply_fun cs3 (ordsucc j) <> apply_fun efam asj.
                                  claim HasjJ : asj :e J. { exact (andEL (asj :e J) (apply_fun cs3 (ordsucc j) :e apply_fun Gfam asj) (andEL (asj :e J /\ apply_fun cs3 (ordsucc j) :e apply_fun Gfam asj) (apply_fun cs3 (ordsucc j) <> apply_fun efam asj) Hasj_pack)). }
                                  claim Hcs3sj_asj : apply_fun cs3 (ordsucc j) :e apply_fun Gfam asj. { exact (andER (asj :e J) (apply_fun cs3 (ordsucc j) :e apply_fun Gfam asj) (andEL (asj :e J /\ apply_fun cs3 (ordsucc j) :e apply_fun Gfam asj) (apply_fun cs3 (ordsucc j) <> apply_fun efam asj) Hasj_pack)). }
                                  witness asj. apply and3I.
                                  { exact HasjJ. }
                                  { exact (Hinv_cs3_factor (ordsucc j) Hsj_m asj HasjJ Hcs3sj_asj). }
                                  { exact (Hinv_cs3_ne_efam (ordsucc j) Hsj_m asj HasjJ Hcs3sj_asj). } }
                                - let i. assume _ Hsi1.
                                  apply (ordsuccE 0 (ordsucc i) Hsi1).
                                  { assume Hsi0 : ordsucc i :e 0. exact (FalseE (EmptyE (ordsucc i) Hsi0) (forall a b:set, a :e J -> b :e J -> apply_fun ws_sj_single i :e apply_fun Gfam a -> apply_fun ws_sj_single (ordsucc i) :e apply_fun Gfam b -> a <> b)). }
                                  { assume Hsi_eq0 : ordsucc i = 0. exact (FalseE (neq_ordsucc_0 i Hsi_eq0) (forall a b:set, a :e J -> b :e J -> apply_fun ws_sj_single i :e apply_fun Gfam a -> apply_fun ws_sj_single (ordsucc i) :e apply_fun Gfam b -> a <> b)). } }
                              (** Boundary for concat: last of single = inv(cs3(ordsucc j)), first of ws_j = inv(cs3(j)) **)
                              (** These are in different factors because cs3(ordsucc j) and cs3(j) are adjacent in reduced word **)
                              claim Hboundary_ri :
                                forall a b:set, a :e J -> b :e J ->
                                apply_fun ws_sj_single 0 :e apply_fun Gfam a ->
                                apply_fun ws_j 0 :e apply_fun Gfam b ->
                                a <> b.
                              { let a b. assume HaJ HbJ Ha_single Hb_wsj.
                                claim Hsingle_eval : apply_fun ws_sj_single 0 = apply_fun inv (apply_fun cs3 (ordsucc j)).
                                { exact (apply_fun_graph 1 (fun _:set => apply_fun inv (apply_fun cs3 (ordsucc j))) 0 (ordsuccI2 0)). }
                                claim Hinvsj_Ga : apply_fun inv (apply_fun cs3 (ordsucc j)) :e apply_fun Gfam a.
                                { exact (eq_subst_mem_rev (apply_fun ws_sj_single 0) (apply_fun inv (apply_fun cs3 (ordsucc j))) (apply_fun Gfam a) Hsingle_eval Ha_single). }
                                claim Hinvj_Gb : apply_fun inv (apply_fun cs3 j) :e apply_fun Gfam b.
                                { exact (eq_subst_mem_rev (apply_fun ws_j 0) (apply_fun inv (apply_fun cs3 j)) (apply_fun Gfam b) Hfirst_wsj Hb_wsj). }
                                (** cs3(ordsucc j) :e Gfam(a) and cs3(j) :e Gfam(b), and j, ordsucc j in m **)
                                (** By double inv: cs3(ordsucc j) :e Gfam(a) **)
                                claim Hdinvsj : apply_fun inv (apply_fun inv (apply_fun cs3 (ordsucc j))) = apply_fun cs3 (ordsucc j).
                                { exact (group_inv_inv G mult inv e (apply_fun cs3 (ordsucc j)) HmultF HinvF HeG Hassoc Hid Hinverse (Hcs3_in_G_all (ordsucc j) Hsj_m)). }
                                claim Hdinvj : apply_fun inv (apply_fun inv (apply_fun cs3 j)) = apply_fun cs3 j.
                                { exact (group_inv_inv G mult inv e (apply_fun cs3 j) HmultF HinvF HeG Hassoc Hid Hinverse (Hcs3_in_G_all j Hj_m)). }
                                claim Hcs3sj_Ga : apply_fun cs3 (ordsucc j) :e apply_fun Gfam a.
                                { claim Hinvsj_inv_Ga : apply_fun inv (apply_fun inv (apply_fun cs3 (ordsucc j))) :e apply_fun Gfam a.
                                  { exact (HGfam_inv a HaJ (apply_fun inv (apply_fun cs3 (ordsucc j))) Hinvsj_Ga). }
                                  exact (eq_subst_mem_rev
                                    (apply_fun inv (apply_fun inv (apply_fun cs3 (ordsucc j))))
                                    (apply_fun cs3 (ordsucc j))
                                    (apply_fun Gfam a) Hdinvsj Hinvsj_inv_Ga). }
                                claim Hcs3j_Gb : apply_fun cs3 j :e apply_fun Gfam b.
                                { claim Hinvj_inv_Gb : apply_fun inv (apply_fun inv (apply_fun cs3 j)) :e apply_fun Gfam b.
                                  { exact (HGfam_inv b HbJ (apply_fun inv (apply_fun cs3 j)) Hinvj_Gb). }
                                  exact (eq_subst_mem_rev
                                    (apply_fun inv (apply_fun inv (apply_fun cs3 j)))
                                    (apply_fun cs3 j)
                                    (apply_fun Gfam b) Hdinvj Hinvj_inv_Gb). }
                                (** Now use adjacency: cs3(j), cs3(ordsucc j) adjacent in reduced word -> different factors **)
                                (** But we need: Hcs3_adj j Hj_m Hsj_m a b gives cs3(j) in Gfam(a) and cs3(ordsucc j) in Gfam(b) -> a <> b **)
                                (** However, we have cs3(ordsucc j) in Gfam(a) and cs3(j) in Gfam(b). **)
                                (** The adjacency gives: if cs3(j) in Gfam(b) and cs3(ordsucc j) in Gfam(a), then b <> a. **)
                                (** From b <> a, we get a <> b. **)
                                claim Hba : b <> a. { exact (Hcs3_adj j Hj_m Hsj_m b a HbJ HaJ Hcs3j_Gb Hcs3sj_Ga). }
                                assume Hab2 : a = b. apply Hba. symmetry. exact Hab2. }
                              (** Apply reduced_word_concat_agree **)
                              apply (reduced_word_concat_agree G mult e inv J Gfam efam
                                1 ws_sj_single (ordsucc j) ws_j 0
                                Hgrp Hsubfam Hred_single Hred_wsj
                                (neq_ordsucc_0 0) (neq_ordsucc_0 j)
                                nat_0 (eq_symm (ordsucc 0) 1 ordsucc_0_eq_1_nat)
                                Hboundary_ri).
                              let ws_new.
                              assume Hws_new_pack :
                                reduced_word J Gfam efam (add_nat 1 (ordsucc j)) ws_new /\
                                word_product mult e ws_new (add_nat 1 (ordsucc j)) =
                                  apply_fun mult (word_product mult e ws_sj_single 1,
                                    word_product mult e ws_j (ordsucc j)) /\
                                (forall t:set, nat_p t -> ordsucc j = ordsucc t ->
                                  apply_fun ws_new (add_nat 1 t) = apply_fun ws_j t) /\
                                (forall i:set, i :e 1 -> apply_fun ws_new i = apply_fun ws_sj_single i).
                              apply (and4E
                                (reduced_word J Gfam efam (add_nat 1 (ordsucc j)) ws_new)
                                (word_product mult e ws_new (add_nat 1 (ordsucc j)) =
                                  apply_fun mult (word_product mult e ws_sj_single 1, word_product mult e ws_j (ordsucc j)))
                                (forall t:set, nat_p t -> ordsucc j = ordsucc t ->
                                  apply_fun ws_new (add_nat 1 t) = apply_fun ws_j t)
                                (forall i:set, i :e 1 -> apply_fun ws_new i = apply_fun ws_sj_single i)
                                Hws_new_pack).
                              assume Hred_new Hwp_new Htail_new Hhead_new.
                              (** add_nat 1 (ordsucc j) = ordsucc (ordsucc j) **)
                              claim Hadd_eq : add_nat 1 (ordsucc j) = ordsucc (ordsucc j).
                              { claim H1sj : add_nat 1 (ordsucc j) = ordsucc (add_nat 1 j).
                                { exact (add_nat_SR 1 j Hj_nat). }
                                claim H1j : add_nat 1 j = ordsucc j.
                                { claim H10 : add_nat 1 0 = 1.
                                  { exact (add_nat_0R 1). }
                                  claim H1j_ind : forall k:set, nat_p k -> add_nat 1 k = ordsucc k.
                                  { apply nat_ind.
                                    - exact H10.
                                    - let k. assume Hkn HIH_k.
                                      claim Hsr : add_nat 1 (ordsucc k) = ordsucc (add_nat 1 k).
                                      { exact (add_nat_SR 1 k Hkn). }
                                      rewrite Hsr. rewrite HIH_k. reflexivity. }
                                  exact (H1j_ind j Hj_nat). }
                                rewrite H1sj. rewrite H1j. reflexivity. }
                              (** Rewrite the reduced word to use ordsucc (ordsucc j) **)
                              claim Hred_new2 : reduced_word J Gfam efam (ordsucc (ordsucc j)) ws_new.
                              { rewrite <- Hadd_eq. exact Hred_new. }
                              (** ws_new(0) = ws_sj_single(0) = inv(cs3(ordsucc j)) **)
                              claim H0in1 : 0 :e 1. { exact (ordsuccI2 0). }
                              claim Hfirst_new : apply_fun ws_new 0 = apply_fun inv (apply_fun cs3 (ordsucc j)).
                              { claim Heq0 : apply_fun ws_new 0 = apply_fun ws_sj_single 0.
                                { exact (Hhead_new 0 H0in1). }
                                claim Hsingle0 : apply_fun ws_sj_single 0 = apply_fun inv (apply_fun cs3 (ordsucc j)).
                                { exact (apply_fun_graph 1 (fun _:set => apply_fun inv (apply_fun cs3 (ordsucc j))) 0 H0in1). }
                                exact (eq_i_tra (apply_fun ws_new 0) (apply_fun ws_sj_single 0)
                                  (apply_fun inv (apply_fun cs3 (ordsucc j))) Heq0 Hsingle0). }
                              (** word product of ws_new = inv(wp(cs3, ordsucc (ordsucc j))) **)
                              claim Hwp_new2 :
                                word_product mult e ws_new (ordsucc (ordsucc j)) =
                                  apply_fun inv (word_product mult e cs3 (ordsucc (ordsucc j))).
                              { claim Hwp_new_eq :
                                  word_product mult e ws_new (ordsucc (ordsucc j)) =
                                    apply_fun mult (word_product mult e ws_sj_single 1,
                                      word_product mult e ws_j (ordsucc j)).
                                { rewrite <- Hadd_eq. exact Hwp_new. }
                                rewrite Hwp_new_eq.
                                (** wp(ws_sj_single, 1) = inv(cs3(ordsucc j)) **)
                                claim Hwp_single : word_product mult e ws_sj_single 1 = apply_fun inv (apply_fun cs3 (ordsucc j)).
                                { exact (word_product_singleton_group G mult e inv
                                    (apply_fun inv (apply_fun cs3 (ordsucc j))) Hgrp Hinv_sj_G). }
                                rewrite Hwp_single. rewrite Hwp_wsj.
                                (** mult(inv(cs3(ordsucc j)), inv(wp(cs3, ordsucc j))) = inv(wp(cs3, ordsucc (ordsucc j))) **)
                                claim Hwp_ssj : word_product mult e cs3 (ordsucc (ordsucc j)) =
                                  apply_fun mult (word_product mult e cs3 (ordsucc j), apply_fun cs3 (ordsucc j)).
                                { exact (word_product_succ mult e cs3 (ordsucc j) Hsj_nat). }
                                claim Hwp_sj_G : word_product mult e cs3 (ordsucc j) :e G.
                                { exact (word_product_in_G_group G mult e inv (ordsucc j) cs3 Hgrp Hsj_nat
                                    (fun i Hi => Hcs3_in_G_all i (nat_trans m Hm_nat2 (ordsucc j) Hsj_m i Hi))). }
                                claim Hcs3sj_G : apply_fun cs3 (ordsucc j) :e G. { exact (Hcs3_in_G_all (ordsucc j) Hsj_m). }
                                claim Hinv_prod : apply_fun inv (word_product mult e cs3 (ordsucc (ordsucc j))) =
                                  apply_fun mult (apply_fun inv (apply_fun cs3 (ordsucc j)),
                                    apply_fun inv (word_product mult e cs3 (ordsucc j))).
                                { rewrite Hwp_ssj.
                                  exact (group_inv_mult G mult e inv
                                    (word_product mult e cs3 (ordsucc j)) (apply_fun cs3 (ordsucc j))
                                    Hgrp Hwp_sj_G Hcs3sj_G). }
                                symmetry. exact Hinv_prod. }
                              (** Package the result **)
                              prove exists ws:set, reduced_word J Gfam efam (ordsucc (ordsucc j)) ws /\
                                word_product mult e ws (ordsucc (ordsucc j)) =
                                  apply_fun inv (word_product mult e cs3 (ordsucc (ordsucc j))) /\
                                apply_fun ws 0 = apply_fun inv (apply_fun cs3 (ordsucc j)).
                              witness ws_new. exact (and3I
                                (reduced_word J Gfam efam (ordsucc (ordsucc j)) ws_new)
                                (word_product mult e ws_new (ordsucc (ordsucc j)) = apply_fun inv (word_product mult e cs3 (ordsucc (ordsucc j))))
                                (apply_fun ws_new 0 = apply_fun inv (apply_fun cs3 (ordsucc j)))
                                Hred_new2 Hwp_new2 Hfirst_new).
                          }
                          (** Get reversed-inverse word for full cs3 (j = k2) **)
                          claim Hk2_sk2 : k2 :e ordsucc k2. { exact (ordsuccI2 k2). }
                          claim HP_k2 : P_ri k2. { exact (Hri_build k2 Hk2_nat Hk2_sk2). }
                          apply HP_k2. let ws_ri.
                          assume Hws_ri_pack : reduced_word J Gfam efam (ordsucc k2) ws_ri /\
                            word_product mult e ws_ri (ordsucc k2) =
                              apply_fun inv (word_product mult e cs3 (ordsucc k2)) /\
                            apply_fun ws_ri 0 = apply_fun inv (apply_fun cs3 k2).
                          apply (and3E
                            (reduced_word J Gfam efam (ordsucc k2) ws_ri)
                            (word_product mult e ws_ri (ordsucc k2) = apply_fun inv (word_product mult e cs3 (ordsucc k2)))
                            (apply_fun ws_ri 0 = apply_fun inv (apply_fun cs3 k2))
                            Hws_ri_pack).
                          assume Hred_ri Hwp_ri Hfirst_ri.
                          (** ordsucc k2 = m **)
                          claim Hred_ri_m : reduced_word J Gfam efam m ws_ri.
                          { rewrite Hm_eq. exact Hred_ri. }
                          claim Hwp_ri_eq : word_product mult e ws_ri m = apply_fun inv c3.
                          { claim Heq1 : word_product mult e ws_ri m = word_product mult e ws_ri (ordsucc k2).
                            { rewrite Hm_eq. reflexivity. }
                            claim Heq2 : word_product mult e cs3 (ordsucc k2) = word_product mult e cs3 m.
                            { rewrite Hm_eq. reflexivity. }
                            claim Heq3 : word_product mult e cs3 m = c3.
                            { exact Hwp3. }
                            rewrite Heq1. rewrite Hwp_ri.
                            rewrite Heq2. rewrite Heq3. reflexivity. }
                          (** PART 2: Build [x3] as 1-element reduced word **)
                          set xs_x3 := graph 1 (fun _:set => x3).
                          claim Hx3_G2 : x3 :e G. { exact (Hsub_in_G alpha HalJ x3 Hx3Ga). }
                          claim Hefam_alpha_e : apply_fun efam alpha = e.
                          { exact (free_product_efam_eq_e G mult e inv J Gfam efam Hfp alpha HalJ). }
                          claim Hx3_ne_efam2 : x3 <> apply_fun efam alpha.
                          { assume H : x3 = apply_fun efam alpha. apply Hx3ne. rewrite H. exact Hefam_alpha_e. }
                          claim Hred_x3 : reduced_word J Gfam efam 1 xs_x3.
                          { prove 1 :e omega /\
                              (forall i:set, i :e 1 ->
                                exists a:set, a :e J /\ apply_fun xs_x3 i :e apply_fun Gfam a /\ apply_fun xs_x3 i <> apply_fun efam a) /\
                              (forall i:set, i :e 1 -> ordsucc i :e 1 ->
                                forall a b:set, a :e J -> b :e J ->
                                apply_fun xs_x3 i :e apply_fun Gfam a ->
                                apply_fun xs_x3 (ordsucc i) :e apply_fun Gfam b -> a <> b).
                            apply and3I.
                            - exact (nat_p_omega 1 (nat_ordsucc 0 nat_0)).
                            - let i. assume Hi1.
                              apply (ordsuccE 0 i Hi1).
                              { assume Hi_empty : i :e 0. exact (FalseE (EmptyE i Hi_empty)
                                  (exists a:set, a :e J /\ apply_fun xs_x3 i :e apply_fun Gfam a /\ apply_fun xs_x3 i <> apply_fun efam a)). }
                              { assume Hi0 : i = 0.
                              rewrite Hi0.
                              claim Heval : apply_fun xs_x3 0 = x3.
                              { exact (apply_fun_graph 1 (fun _:set => x3) 0 (ordsuccI2 0)). }
                              rewrite Heval.
                              witness alpha. apply and3I. exact HalJ. exact Hx3Ga. exact Hx3_ne_efam2. }
                            - let i. assume _ Hsi1.
                              apply (ordsuccE 0 (ordsucc i) Hsi1).
                              { assume Hsi0 : ordsucc i :e 0. exact (FalseE (EmptyE (ordsucc i) Hsi0)
                                  (forall a b:set, a :e J -> b :e J -> apply_fun xs_x3 i :e apply_fun Gfam a -> apply_fun xs_x3 (ordsucc i) :e apply_fun Gfam b -> a <> b)). }
                              { assume Hsi_eq0 : ordsucc i = 0. exact (FalseE (neq_ordsucc_0 i Hsi_eq0)
                                  (forall a b:set, a :e J -> b :e J -> apply_fun xs_x3 i :e apply_fun Gfam a -> apply_fun xs_x3 (ordsucc i) :e apply_fun Gfam b -> a <> b)). } }
                          claim Hwp_x3 : word_product mult e xs_x3 1 = x3.
                          { exact (word_product_singleton_group G mult e inv x3 Hgrp Hx3_G2). }
                          claim Hxs_x3_0 : apply_fun xs_x3 0 = x3.
                          { exact (apply_fun_graph 1 (fun _:set => x3) 0 (ordsuccI2 0)). }
                          (** PART 3: Concatenate [x3] with ws_ri **)
                          (** Boundary: x3 in Gfam(alpha), ws_ri(0) = inv(cs3(k2)) in Gfam(gamma2). alpha <> gamma2. **)
                          claim Hinvk2_Gg2 : apply_fun inv (apply_fun cs3 k2) :e apply_fun Gfam gamma2.
                          { exact (HGfam_inv gamma2 Hg2J (apply_fun cs3 k2) Hcs3k2_Gg2). }
                          claim Hboundary_xr :
                            forall a b:set, a :e J -> b :e J ->
                            apply_fun xs_x3 0 :e apply_fun Gfam a ->
                            apply_fun ws_ri 0 :e apply_fun Gfam b ->
                            a <> b.
                          { let a b. assume HaJ HbJ Ha_xs Hb_ri.
                            claim Hx3_Ga : x3 :e apply_fun Gfam a.
                            { exact (eq_subst_mem_rev (apply_fun xs_x3 0) x3 (apply_fun Gfam a) Hxs_x3_0 Ha_xs). }
                            claim Hinvk2_Gb : apply_fun inv (apply_fun cs3 k2) :e apply_fun Gfam b.
                            { exact (eq_subst_mem_rev (apply_fun ws_ri 0) (apply_fun inv (apply_fun cs3 k2)) (apply_fun Gfam b) Hfirst_ri Hb_ri). }
                            (** x3 in Gfam(alpha) and Gfam(a) -> a = alpha or x3 = e **)
                            (** inv(cs3(k2)) in Gfam(gamma2) and Gfam(b) -> b = gamma2 or inv(cs3(k2)) = e **)
                            apply (xm (a = alpha)).
                            - assume Ha_alpha : a = alpha.
                              apply (xm (b = gamma2)).
                              + assume Hb_g2 : b = gamma2.
                                assume Hab3 : a = b. apply Hg2_ne_alpha. rewrite <- Ha_alpha. rewrite <- Hb_g2. symmetry. exact Hab3.
                              + assume Hb_ne_g2 : b <> gamma2.
                                (** inv(cs3(k2)) in Gfam(b) and Gfam(gamma2), b <> gamma2 -> inv(cs3(k2)) = e **)
                                claim Hinvk2_e : apply_fun inv (apply_fun cs3 k2) = e.
                                { exact (Hdisjoint b gamma2 HbJ Hg2J Hb_ne_g2
                                    (apply_fun inv (apply_fun cs3 k2)) Hinvk2_Gb Hinvk2_Gg2). }
                                claim Hk2_m : k2 :e m. { exact Hk2_in_m. }
                                exact (FalseE (Hinv_cs3_ne_e k2 Hk2_m Hinvk2_e) (a <> b)).
                            - assume Ha_ne_alpha : a <> alpha.
                              (** x3 in Gfam(a) and Gfam(alpha), a <> alpha -> x3 = e **)
                              claim Hx3_e : x3 = e.
                              { exact (Hdisjoint a alpha HaJ HalJ Ha_ne_alpha x3 Hx3_Ga Hx3Ga). }
                              exact (FalseE (Hx3ne Hx3_e) (a <> b)). }
                          apply (reduced_word_concat_agree G mult e inv J Gfam efam
                            1 xs_x3 m ws_ri 0
                            Hgrp Hsubfam Hred_x3 Hred_ri_m
                            (neq_ordsucc_0 0) Hm_ne0
                            nat_0 (eq_symm (ordsucc 0) 1 ordsucc_0_eq_1_nat)
                            Hboundary_xr).
                          let ws_xr.
                          assume Hws_xr_pack :
                            reduced_word J Gfam efam (add_nat 1 m) ws_xr /\
                            word_product mult e ws_xr (add_nat 1 m) =
                              apply_fun mult (word_product mult e xs_x3 1, word_product mult e ws_ri m) /\
                            (forall t:set, nat_p t -> m = ordsucc t ->
                              apply_fun ws_xr (add_nat 1 t) = apply_fun ws_ri t) /\
                            (forall i:set, i :e 1 -> apply_fun ws_xr i = apply_fun xs_x3 i).
                          apply (and4E
                            (reduced_word J Gfam efam (add_nat 1 m) ws_xr)
                            (word_product mult e ws_xr (add_nat 1 m) =
                              apply_fun mult (word_product mult e xs_x3 1, word_product mult e ws_ri m))
                            (forall t:set, nat_p t -> m = ordsucc t ->
                              apply_fun ws_xr (add_nat 1 t) = apply_fun ws_ri t)
                            (forall i:set, i :e 1 -> apply_fun ws_xr i = apply_fun xs_x3 i)
                            Hws_xr_pack).
                          assume Hred_xr Hwp_xr _ Hhead_xr.
                          (** add_nat 1 m = ordsucc m **)
                          claim Hadd1m : add_nat 1 m = ordsucc m.
                          { claim H1j_ind : forall k:set, nat_p k -> add_nat 1 k = ordsucc k.
                            { apply nat_ind.
                              - exact (add_nat_0R 1).
                              - let k. assume Hkn HIH_k.
                                rewrite (add_nat_SR 1 k Hkn). rewrite HIH_k. reflexivity. }
                            exact (H1j_ind m Hm_nat2). }
                          claim Hred_xr_sm : reduced_word J Gfam efam (ordsucc m) ws_xr.
                          { rewrite <- Hadd1m. exact Hred_xr. }
                          claim Hws_xr_0 : apply_fun ws_xr 0 = x3.
                          { claim Heq0 : apply_fun ws_xr 0 = apply_fun xs_x3 0.
                            { exact (Hhead_xr 0 (ordsuccI2 0)). }
                            exact (eq_i_tra (apply_fun ws_xr 0) (apply_fun xs_x3 0) x3 Heq0 Hxs_x3_0). }
                          claim Hwp_xr_eq : word_product mult e ws_xr (ordsucc m) =
                            apply_fun mult (x3, apply_fun inv c3).
                          { claim Heq_len : word_product mult e ws_xr (ordsucc m) =
                              word_product mult e ws_xr (add_nat 1 m).
                            { rewrite Hadd1m. reflexivity. }
                            rewrite Heq_len. rewrite Hwp_xr. rewrite Hwp_x3. rewrite Hwp_ri_eq. reflexivity. }
                          (** PART 4: Concatenate cs3 with ws_xr **)
                          (** Boundary: cs3(k2) in Gfam(gamma2), ws_xr(0) = x3 in Gfam(alpha). gamma2 <> alpha. **)
                          claim Hboundary_main :
                            forall a b:set, a :e J -> b :e J ->
                            apply_fun cs3 k2 :e apply_fun Gfam a ->
                            apply_fun ws_xr 0 :e apply_fun Gfam b ->
                            a <> b.
                          { let a b. assume HaJ HbJ Ha_cs3 Hb_xr.
                            claim Hx3_Gb : x3 :e apply_fun Gfam b.
                            { exact (eq_subst_mem_rev (apply_fun ws_xr 0) x3 (apply_fun Gfam b) Hws_xr_0 Hb_xr). }
                            apply (xm (a = gamma2)).
                            - assume Ha_g2 : a = gamma2.
                              apply (xm (b = alpha)).
                              + assume Hb_al : b = alpha.
                                assume Hab4 : a = b. apply Hg2_ne_alpha. rewrite <- Ha_g2. rewrite <- Hb_al. exact Hab4.
                              + assume Hb_ne_al : b <> alpha.
                                claim Hx3_e : x3 = e.
                                { exact (Hdisjoint b alpha HbJ HalJ Hb_ne_al x3 Hx3_Gb Hx3Ga). }
                                exact (FalseE (Hx3ne Hx3_e) (a <> b)).
                            - assume Ha_ne_g2 : a <> gamma2.
                              claim Hcs3k2_e : apply_fun cs3 k2 = e.
                              { exact (Hdisjoint a gamma2 HaJ Hg2J Ha_ne_g2 (apply_fun cs3 k2) Ha_cs3 Hcs3k2_Gg2). }
                              exact (FalseE (Hcs3_ne_e_all k2 Hk2_in_m Hcs3k2_e) (a <> b)). }
                          apply (reduced_word_concat G mult e inv J Gfam efam
                            m cs3 (ordsucc m) ws_xr k2
                            Hgrp Hsubfam Hred3 Hred_xr_sm
                            Hm_ne0 (neq_ordsucc_0 m)
                            Hk2_nat Hm_eq
                            Hboundary_main).
                          let ws_full.
                          assume Hws_full_pack :
                            reduced_word J Gfam efam (add_nat m (ordsucc m)) ws_full /\
                            word_product mult e ws_full (add_nat m (ordsucc m)) =
                              apply_fun mult (word_product mult e cs3 m, word_product mult e ws_xr (ordsucc m)) /\
                            (forall t:set, nat_p t -> ordsucc m = ordsucc t ->
                              apply_fun ws_full (add_nat m t) = apply_fun ws_xr t).
                          apply (and3E
                            (reduced_word J Gfam efam (add_nat m (ordsucc m)) ws_full)
                            (word_product mult e ws_full (add_nat m (ordsucc m)) =
                              apply_fun mult (word_product mult e cs3 m, word_product mult e ws_xr (ordsucc m)))
                            (forall t:set, nat_p t -> ordsucc m = ordsucc t ->
                              apply_fun ws_full (add_nat m t) = apply_fun ws_xr t)
                            Hws_full_pack).
                          assume Hred_full Hwp_full _.
                          (** add_nat m (ordsucc m) = ordsucc (add_nat m m) **)
                          claim Hadd_msm : add_nat m (ordsucc m) = ordsucc (add_nat m m).
                          { exact (add_nat_SR m m Hm_nat2). }
                          claim Hred_full2 : reduced_word J Gfam efam (ordsucc (add_nat m m)) ws_full.
                          { rewrite <- Hadd_msm. exact Hred_full. }
                          (** word product = y3 **)
                          claim Hwp_full_eq : word_product mult e ws_full (ordsucc (add_nat m m)) = y3.
                          { claim Heq_len : word_product mult e ws_full (ordsucc (add_nat m m)) =
                              word_product mult e ws_full (add_nat m (ordsucc m)).
                            { rewrite Hadd_msm. reflexivity. }
                            rewrite Heq_len. rewrite Hwp_full. rewrite Hwp3. rewrite Hwp_xr_eq.
                            (** mult(c3, mult(x3, inv(c3))) = y3 **)
                            (** y3 = mult(mult(c3, x3), inv(c3)) **)
                            prove apply_fun mult (c3, apply_fun mult (x3, apply_fun inv c3)) = y3.
                            prove apply_fun mult (c3, apply_fun mult (x3, apply_fun inv c3)) =
                              apply_fun mult (apply_fun mult (c3, x3), apply_fun inv c3).
                            claim HinvcG2 : apply_fun inv c3 :e G. { exact (HinvG c3 Hc3G). }
                            symmetry. exact (Hassoc c3 x3 (apply_fun inv c3) Hc3G Hx3_G2 HinvcG2). }
                          (** length is ordsucc (add_nat m m). Since y3 in Gfam(beta), use factor_element_length1 **)
                          claim Hlen_ne0 : ordsucc (add_nat m m) <> 0. { exact (neq_ordsucc_0 (add_nat m m)). }
                          claim Hy3_len1_full : ordsucc (add_nat m m) = 1.
                          { exact (free_product_factor_element_length1 G mult e inv J Gfam efam beta y3
                              (ordsucc (add_nat m m)) ws_full
                              Hfp HbeJ Hy3Gb Hy3_ne Hy3_ne_efam Hred_full2 Hlen_ne0 Hwp_full_eq). }
                          (** ordsucc (add_nat m m) = 1 -> add_nat m m = 0 **)
                          claim Hamm_0 : add_nat m m = 0.
                          { exact (ordsucc_inj (add_nat m m) 0 Hy3_len1_full). }
                          (** m c= add_nat m m by add_nat_Subq_R' **)
                          claim Hm_sub_amm : m c= add_nat m m.
                          { exact (add_nat_Subq_R' m Hm_nat2 m Hm_nat2). }
                          (** m c= 0, so k2 :e m -> k2 :e 0 = Empty, contradiction **)
                          claim Hm_sub_0 : m c= 0.
                          { rewrite <- Hamm_0. exact Hm_sub_amm. }
                          claim Hk2_in_0 : k2 :e 0. { exact (Hm_sub_0 k2 Hk2_in_m). }
                          exact (FalseE (EmptyE k2 Hk2_in_0) (y3 = e)). } }
    }
    (** Apply the main inductive claim to our specific c, x **)
    (** Get reduced word info **)
    claim Hnc_omega : nc :e omega.
    { apply (and3E (nc :e omega)
        (forall i:set, i :e nc -> exists a:set, a :e J /\ apply_fun cs i :e apply_fun Gfam a /\ apply_fun cs i <> apply_fun efam a)
        (forall i:set, i :e nc -> ordsucc i :e nc ->
          forall a b:set, a :e J -> b :e J -> apply_fun cs i :e apply_fun Gfam a -> apply_fun cs (ordsucc i) :e apply_fun Gfam b -> a <> b)
        Hredc). assume HnO _ _. exact HnO. }
    claim Hnc_nat : nat_p nc. { exact (omega_nat_p nc Hnc_omega). }
    claim Hc_word : exists cs0:set, reduced_word J Gfam efam nc cs0 /\ word_product mult e cs0 nc = c /\
      (forall n' xs':set, reduced_word J Gfam efam n' xs' -> n' <> 0 ->
        word_product mult e xs' n' = c -> nc = n' /\ (forall i:set, i :e nc -> apply_fun cs0 i = apply_fun xs' i)).
    { witness cs. apply and3I.
      - exact Hredc.
      - exact Hwpc.
      - exact Hunicc. }
    exact (Hyne (Hmain_ind nc Hnc_nat c x HcG HxGa Hxne Hcne Hc_word HyGb)).
Qed.

(** Infrastructure bounty: torsion/involution in free products (order 2 case).
    Expected use: discharge the remaining "boundary labels coincide" admit branches by showing
    that an involution is conjugate into some factor subgroup. **)
(** Collected Alice 66 **)
(** Proven Alice **)
Lemma free_product_involution_conjugate_into_factor :
  forall G mult e inv J Gfam efam u:set,
  free_product_of_subgroups G mult e inv J Gfam efam ->
  u :e G ->
  u <> e ->
  apply_fun inv u = u ->
  exists alpha c x:set,
    alpha :e J /\
    c :e G /\
    x :e apply_fun Gfam alpha /\
    x <> e /\
    apply_fun inv x = x /\
    u = apply_fun mult (apply_fun inv c, apply_fun mult (x, c)).
let G mult e inv J Gfam efam u.
assume Hfp Hu_G Hu_ne_e Hu_invol.

(** Unpack the free product structure. **)
apply (and6E
  (group_structure G mult e inv)
  (forall alpha:set, alpha :e J -> subgroup_of (apply_fun Gfam alpha) G mult e inv)
  (forall alpha beta:set, alpha :e J -> beta :e J -> alpha <> beta ->
    forall x:set, x :e apply_fun Gfam alpha -> x :e apply_fun Gfam beta -> x = e)
  (subgroups_generate G mult e inv J Gfam)
  (forall x:set, x :e G -> x <> e ->
    exists n xs:set,
      reduced_word J Gfam efam n xs /\ n <> 0 /\
      word_product mult e xs n = x /\
      (forall n' xs':set,
        reduced_word J Gfam efam n' xs' -> n' <> 0 ->
        word_product mult e xs' n' = x ->
        n = n' /\ (forall i:set, i :e n -> apply_fun xs i = apply_fun xs' i)))
  (forall alpha:set, alpha :e J -> apply_fun efam alpha = e)
  Hfp).
assume Hgrp Hsubfam Hdisjoint _ Huniq _.

(** u^2 = e in the ambient group. **)
claim Hu_sq : apply_fun mult (u, u) = e.
{
  exact (group_involutive_square_e
    G mult e inv u Hgrp Hu_G Hu_invol).
}

(** Choose the canonical reduced word for u. **)
apply (Huniq u Hu_G Hu_ne_e).
let n. assume Hex : exists xs:set,
  reduced_word J Gfam efam n xs /\ n <> 0 /\
  word_product mult e xs n = u /\
  (forall n' xs':set,
    reduced_word J Gfam efam n' xs' -> n' <> 0 ->
    word_product mult e xs' n' = u ->
    n = n' /\ (forall i:set, i :e n -> apply_fun xs i = apply_fun xs' i)).
apply Hex. let xs. assume Hpack :
  reduced_word J Gfam efam n xs /\ n <> 0 /\
  word_product mult e xs n = u /\
  (forall n' xs':set,
    reduced_word J Gfam efam n' xs' -> n' <> 0 ->
    word_product mult e xs' n' = u ->
    n = n' /\ (forall i:set, i :e n -> apply_fun xs i = apply_fun xs' i)).
apply (and4E
  (reduced_word J Gfam efam n xs)
  (n <> 0)
  (word_product mult e xs n = u)
  (forall n' xs':set,
    reduced_word J Gfam efam n' xs' -> n' <> 0 ->
    word_product mult e xs' n' = u ->
    n = n' /\ (forall i:set, i :e n -> apply_fun xs i = apply_fun xs' i))
  Hpack).
assume Hred Hn_ne0 Hwp _.

(** We prove a stronger statement by strong induction on the reduced word length. **)
set P := fun t:set =>
  forall v xs0:set,
    v :e G ->
    v <> e ->
    apply_fun inv v = v ->
    reduced_word J Gfam efam t xs0 ->
    t <> 0 ->
    word_product mult e xs0 t = v ->
    exists alpha c x:set,
      alpha :e J /\
      c :e G /\
      x :e apply_fun Gfam alpha /\
      x <> e /\
      apply_fun inv x = x /\
      v = apply_fun mult (apply_fun inv c, apply_fun mult (x, c)).

claim HnO : n :e omega.
{
  apply (and3E
    (n :e omega)
    (forall i:set, i :e n ->
      exists alpha:set, alpha :e J /\
        apply_fun xs i :e apply_fun Gfam alpha /\
        apply_fun xs i <> apply_fun efam alpha)
    (forall i:set, i :e n -> ordsucc i :e n ->
      forall alpha beta:set, alpha :e J -> beta :e J ->
        apply_fun xs i :e apply_fun Gfam alpha ->
        apply_fun xs (ordsucc i) :e apply_fun Gfam beta ->
        alpha <> beta)
    Hred).
  assume HnO0 _ _. exact HnO0.
}
claim Hn_nat : nat_p n.
{ exact (omega_nat_p n HnO). }

claim HPn : P n.
{
  apply (nat_strong_ind_early P).
  - let t. assume Ht_nat IHt.
  prove P t.
  let v xs0.
  assume Hv_G Hv_ne_e Hv_invol Hredt Ht_ne0 Hwpv.

  (** Decompose t into cases 0, 1, >= 2. **)
  apply (nat_inv t Ht_nat).
  - assume Ht0 : t = 0.
    exact (FalseE (Ht_ne0 Ht0) (exists alpha c x:set,
      alpha :e J /\
      c :e G /\
      x :e apply_fun Gfam alpha /\
      x <> e /\
      apply_fun inv x = x /\
      v = apply_fun mult (apply_fun inv c, apply_fun mult (x, c)))).
  - assume Hexm : exists m:set, nat_p m /\ t = ordsucc m.
    apply Hexm. let m.
    assume Hm_pack : nat_p m /\ t = ordsucc m.
    claim Hm_nat : nat_p m.
    { exact (andEL (nat_p m) (t = ordsucc m) Hm_pack). }
    claim Ht_sm : t = ordsucc m.
    { exact (andER (nat_p m) (t = ordsucc m) Hm_pack). }

    apply (nat_inv m Hm_nat).
    - assume Hm0 : m = 0.
      (** Then t = 1 and v is a single letter in some factor. **)
      claim Ht1 : t = 1.
      { rewrite Ht_sm. rewrite Hm0. exact ordsucc_0_eq_1_nat. }
      claim H0_in_t : 0 :e t.
      { rewrite Ht1. exact In_0_1. }
      apply (reduced_word_elem J Gfam efam t xs0 0 Hredt H0_in_t).
      let alpha. assume Halpha_pack :
        alpha :e J /\
        apply_fun xs0 0 :e apply_fun Gfam alpha /\
        apply_fun xs0 0 <> apply_fun efam alpha.
      apply (and3E
        (alpha :e J)
        (apply_fun xs0 0 :e apply_fun Gfam alpha)
        (apply_fun xs0 0 <> apply_fun efam alpha)
        Halpha_pack).
      assume HalphaJ Hx0_in_Ga _.
      set x := apply_fun xs0 0.

      witness alpha.
      witness e.
      witness x.
      apply and6I.
      - exact HalphaJ.
      - apply (and6E
          (function_on mult (setprod G G) G)
          (function_on inv G G)
          (e :e G)
          (forall a b c:set, a :e G -> b :e G -> c :e G ->
            apply_fun mult (apply_fun mult (a, b), c) = apply_fun mult (a, apply_fun mult (b, c)))
          (forall a:set, a :e G -> apply_fun mult (e, a) = a /\ apply_fun mult (a, e) = a)
          (forall a:set, a :e G ->
            apply_fun mult (a, apply_fun inv a) = e /\ apply_fun mult (apply_fun inv a, a) = e)
          Hgrp).
        assume _ _ He_G _ _ _. exact He_G.
      - exact Hx0_in_Ga.
      - (** x <> e **)
        claim Hx_ne_e : x <> e.
        {
          exact (reduced_word_no_eG_if_product_non_e
            G mult e inv J Gfam efam t xs0 v
            Hgrp Hsubfam Hredt Ht_ne0 Hwpv Hv_ne_e
            0 H0_in_t).
        }
        exact Hx_ne_e.
      - (** inv x = x **)
        claim Hwp1 : word_product mult e xs0 1 =
          apply_fun mult (word_product mult e xs0 0, apply_fun xs0 0).
        { exact (word_product_succ mult e xs0 0 nat_0). }
        claim Hwp0 : word_product mult e xs0 0 = e.
        { exact (nat_primrec_0 e (fun i r => apply_fun mult (r, apply_fun xs0 i))). }
        claim Hx_G : x :e G.
        {
          exact (subgroup_of_subset
            (apply_fun Gfam alpha) G mult e inv
            (Hsubfam alpha HalphaJ)
            x Hx0_in_Ga).
        }
        claim HidL : apply_fun mult (e, x) = x.
        {
          apply (and6E
            (function_on mult (setprod G G) G)
            (function_on inv G G)
            (e :e G)
            (forall a b c:set, a :e G -> b :e G -> c :e G ->
              apply_fun mult (apply_fun mult (a, b), c) = apply_fun mult (a, apply_fun mult (b, c)))
            (forall a:set, a :e G -> apply_fun mult (e, a) = a /\ apply_fun mult (a, e) = a)
            (forall a:set, a :e G ->
              apply_fun mult (a, apply_fun inv a) = e /\ apply_fun mult (apply_fun inv a, a) = e)
            Hgrp).
          assume _ _ _ _ Hid _.
          exact (andEL
            (apply_fun mult (e, x) = x)
            (apply_fun mult (x, e) = x)
            (Hid x Hx_G)).
        }
        claim Hwp1_eq : word_product mult e xs0 1 = x.
        {
          rewrite Hwp1.
          rewrite Hwp0.
          exact HidL.
        }
        claim Hv_eq_x : v = x.
        { rewrite <- Hwp1_eq. rewrite <- Ht1.
          exact (eq_symm (word_product mult e xs0 t) v Hwpv). }
        rewrite <- Hv_eq_x.
        exact Hv_invol.
      - (** v = inv(e) mul (x mul e) **)
        apply (and6E
          (function_on mult (setprod G G) G)
          (function_on inv G G)
          (e :e G)
          (forall a b c:set, a :e G -> b :e G -> c :e G ->
            apply_fun mult (apply_fun mult (a, b), c) = apply_fun mult (a, apply_fun mult (b, c)))
          (forall a:set, a :e G -> apply_fun mult (e, a) = a /\ apply_fun mult (a, e) = a)
          (forall a:set, a :e G ->
            apply_fun mult (a, apply_fun inv a) = e /\ apply_fun mult (apply_fun inv a, a) = e)
          Hgrp).
        assume HmultFn HinvFn He_G _ HidG HinvLaw.
        claim Hx_G : x :e G.
        {
          exact (subgroup_of_subset
            (apply_fun Gfam alpha) G mult e inv
            (Hsubfam alpha HalphaJ)
            x Hx0_in_Ga).
        }
        claim Hinv_e : apply_fun inv e = e.
        {
          claim Hinv_e_G : apply_fun inv e :e G.
          { exact (HinvFn e He_G). }
          claim Hmul_inv_e : apply_fun mult (apply_fun inv e, e) = e.
          {
            exact (andER
              (apply_fun mult (e, apply_fun inv e) = e)
              (apply_fun mult (apply_fun inv e, e) = e)
              (HinvLaw e He_G)).
          }
          claim Hmul_e_e : apply_fun mult (e, e) = e.
          {
            exact (andEL
              (apply_fun mult (e, e) = e)
              (apply_fun mult (e, e) = e)
              (HidG e He_G)).
          }
          exact (group_right_cancel
            G mult e inv e (apply_fun inv e) e
            Hgrp He_G Hinv_e_G He_G
            (eq_i_tra
              (apply_fun mult (apply_fun inv e, e))
              e
              (apply_fun mult (e, e))
              Hmul_inv_e
              (eq_symm (apply_fun mult (e, e)) e Hmul_e_e))).
        }
        claim Hxe : apply_fun mult (x, e) = x.
        { exact (andER
            (apply_fun mult (e, x) = x)
            (apply_fun mult (x, e) = x)
            (HidG x Hx_G)). }
        claim Hwp1 : word_product mult e xs0 1 =
          apply_fun mult (word_product mult e xs0 0, apply_fun xs0 0).
        { exact (word_product_succ mult e xs0 0 nat_0). }
        claim Hwp0 : word_product mult e xs0 0 = e.
        { exact (nat_primrec_0 e (fun i r => apply_fun mult (r, apply_fun xs0 i))). }
        claim HidL : apply_fun mult (e, x) = x.
        { exact (andEL
            (apply_fun mult (e, x) = x)
            (apply_fun mult (x, e) = x)
            (HidG x Hx_G)). }
        claim Hwp1_eq : word_product mult e xs0 1 = x.
        { rewrite Hwp1. rewrite Hwp0.
          exact HidL. }
        claim Hv_eq_x : v = x.
        { rewrite <- Hwp1_eq. rewrite <- Ht1.
          exact (eq_symm (word_product mult e xs0 t) v Hwpv). }
        rewrite Hv_eq_x.
        rewrite Hinv_e.
        rewrite Hxe.
        exact (eq_symm
          (apply_fun mult (e, x))
          x
          (andEL
            (apply_fun mult (e, x) = x)
            (apply_fun mult (x, e) = x)
            (HidG x Hx_G))).

    - assume Hexk : exists k:set, nat_p k /\ m = ordsucc k.
      (** Length t >= 2. Analyze cyclic reduction. **)
      apply Hexk. let k.
      assume Hk_pack : nat_p k /\ m = ordsucc k.
      claim Hk_nat : nat_p k.
      { exact (andEL (nat_p k) (m = ordsucc k) Hk_pack). }
      claim Hm_sm : m = ordsucc k.
      { exact (andER (nat_p k) (m = ordsucc k) Hk_pack). }

      claim H0_in_t : 0 :e t.
      { rewrite Ht_sm. exact (nat_0_in_ordsucc m Hm_nat). }
      claim Hm_in_t : m :e t.
      { rewrite Ht_sm. exact (ordsuccI2 m). }

      apply (reduced_word_elem J Gfam efam t xs0 0 Hredt H0_in_t).
      let beta0. assume Hbeta_pack :
        beta0 :e J /\
        apply_fun xs0 0 :e apply_fun Gfam beta0 /\
        apply_fun xs0 0 <> apply_fun efam beta0.
      apply (and3E
        (beta0 :e J)
        (apply_fun xs0 0 :e apply_fun Gfam beta0)
        (apply_fun xs0 0 <> apply_fun efam beta0)
        Hbeta_pack).
      assume HbetaJ Hx0_in_Gb0 _.

      apply (reduced_word_elem J Gfam efam t xs0 m Hredt Hm_in_t).
      let alphaL. assume Halpha_pack :
        alphaL :e J /\
        apply_fun xs0 m :e apply_fun Gfam alphaL /\
        apply_fun xs0 m <> apply_fun efam alphaL.
      apply (and3E
        (alphaL :e J)
        (apply_fun xs0 m :e apply_fun Gfam alphaL)
        (apply_fun xs0 m <> apply_fun efam alphaL)
        Halpha_pack).
      assume HalphaJ HxL_in_GaL _.

      (** If boundary labels differ, doubling yields a reduced word for v^2, contradiction. **)
      apply (xm (alphaL <> beta0)).
      * assume Hcyc_ne : alphaL <> beta0.
        claim Hv_sq : apply_fun mult (v, v) = e.
        { exact (group_involutive_square_e G mult e inv v Hgrp Hv_G Hv_invol). }
        claim Hcyc_all :
          forall a b:set, a :e J -> b :e J ->
            apply_fun xs0 m :e apply_fun Gfam a ->
            apply_fun xs0 0 :e apply_fun Gfam b ->
            a <> b.
        {
          let a b. assume HaJ HbJ Hlast Hfirst.
          claim Hx0_ne_e : apply_fun xs0 0 <> e.
          {
            exact (reduced_word_no_eG_if_product_non_e
              G mult e inv J Gfam efam t xs0 v
              Hgrp Hsubfam Hredt Ht_ne0 Hwpv Hv_ne_e
              0 H0_in_t).
          }
          claim HxL_ne_e : apply_fun xs0 m <> e.
          {
            exact (reduced_word_no_eG_if_product_non_e
              G mult e inv J Gfam efam t xs0 v
              Hgrp Hsubfam Hredt Ht_ne0 Hwpv Hv_ne_e
              m Hm_in_t).
          }
          claim Ha_eq : a = alphaL.
          {
            symmetry.
            exact (disjoint_subgroups_label_unique
              G mult e inv J Gfam alphaL a (apply_fun xs0 m)
              Hdisjoint HalphaJ HaJ HxL_in_GaL Hlast HxL_ne_e).
          }
          claim Hb_eq : b = beta0.
          {
            symmetry.
            exact (disjoint_subgroups_label_unique
              G mult e inv J Gfam beta0 b (apply_fun xs0 0)
              Hdisjoint HbetaJ HbJ Hx0_in_Gb0 Hfirst Hx0_ne_e).
          }
          rewrite Ha_eq. rewrite Hb_eq.
          exact Hcyc_ne.
        }
        apply (reduced_word_double_cyclic_word_product
          G mult e inv J Gfam efam t xs0 m
          Hgrp Hsubfam Hredt Ht_sm Hm_nat Hcyc_all).
        let ys2.
        assume Hys2_pack :
          reduced_word J Gfam efam (add_nat t t) ys2 /\
          word_product mult e ys2 (add_nat t t) =
            apply_fun mult (word_product mult e xs0 t, word_product mult e xs0 t).
        claim Hred2 : reduced_word J Gfam efam (add_nat t t) ys2.
        {
          exact (andEL
            (reduced_word J Gfam efam (add_nat t t) ys2)
            (word_product mult e ys2 (add_nat t t) =
              apply_fun mult (word_product mult e xs0 t, word_product mult e xs0 t))
            Hys2_pack).
        }
        claim Hwp2 :
          word_product mult e ys2 (add_nat t t) =
            apply_fun mult (word_product mult e xs0 t, word_product mult e xs0 t).
        {
          exact (andER
            (reduced_word J Gfam efam (add_nat t t) ys2)
            (word_product mult e ys2 (add_nat t t) =
              apply_fun mult (word_product mult e xs0 t, word_product mult e xs0 t))
            Hys2_pack).
        }
        claim Hlen2_ne0 : add_nat t t <> 0.
        {
          rewrite Ht_sm.
          rewrite (add_nat_SR (ordsucc m) m Hm_nat).
          exact (neq_ordsucc_0 (add_nat (ordsucc m) m)).
        }
        claim Hlen2_ne1 : add_nat t t <> 1.
        {
          assume Habs2 : add_nat t t = 1.
          claim Htmp1 : add_nat (ordsucc m) (ordsucc m) =
            ordsucc (add_nat (ordsucc m) m).
          { exact (add_nat_SR (ordsucc m) m Hm_nat). }
          claim Heq : ordsucc (add_nat (ordsucc m) m) = 1.
          {
            claim Habs1 : add_nat (ordsucc m) (ordsucc m) = 1.
            { rewrite <- Ht_sm. exact Habs2. }
            rewrite <- Htmp1. exact Habs1.
          }
          claim Hmm_eq0 : add_nat (ordsucc m) m = 0.
          {
            claim Hs : ordsucc (add_nat (ordsucc m) m) = ordsucc 0.
            { rewrite Heq. symmetry. exact ordsucc_0_eq_1_nat. }
            exact (ordsucc_inj (add_nat (ordsucc m) m) 0 Hs).
          }
          claim Hmm_ne0 : add_nat (ordsucc m) m <> 0.
          {
            claim Htmp2 : add_nat (ordsucc m) m = ordsucc (add_nat m m).
            { exact (add_nat_SL m Hm_nat m Hm_nat). }
            assume H0.
            claim Hs0 : ordsucc (add_nat m m) = 0.
            {
              exact (eq_i_tra
                (ordsucc (add_nat m m))
                (add_nat (ordsucc m) m)
                0
                (eq_symm (add_nat (ordsucc m) m) (ordsucc (add_nat m m)) Htmp2)
                H0).
            }
            exact (neq_ordsucc_0 (add_nat m m) Hs0).
          }
          exact (Hmm_ne0 Hmm_eq0).
        }
        claim Hys2_in_G : forall i:set, i :e add_nat t t -> apply_fun ys2 i :e G.
        {
          let i. assume Hi.
          exact (reduced_word_in_G
            G mult e inv J Gfam efam (add_nat t t) ys2
            Hsubfam Hred2 i Hi).
        }
        claim Hys2_ne_e : forall i:set, i :e add_nat t t -> apply_fun ys2 i <> e.
        {
          let i. assume Hi.
          exact (reduced_word_no_eG_all
            G mult e inv J Gfam efam (add_nat t t) ys2
            Hgrp Hsubfam Hred2 Hlen2_ne0 Hlen2_ne1 i Hi).
        }
        claim Hwp2_e : word_product mult e ys2 (add_nat t t) = e.
        {
          rewrite Hwp2.
          rewrite Hwpv.
          exact Hv_sq.
        }
        claim Hwp2_ne : word_product mult e ys2 (add_nat t t) <> e.
        {
          exact (free_product_reduced_word_length_ne0_product_ne_e
            G mult e inv J Gfam efam (add_nat t t) ys2
            Hfp Hred2 Hys2_in_G Hys2_ne_e Hlen2_ne0).
        }
        exact (FalseE (Hwp2_ne Hwp2_e) (exists alpha c x:set,
          alpha :e J /\
          c :e G /\
          x :e apply_fun Gfam alpha /\
          x <> e /\
          apply_fun inv x = x /\
          v = apply_fun mult (apply_fun inv c, apply_fun mult (x, c)))).

	      * assume Hcyc_eq : ~(alphaL <> beta0).
	        (** Boundary labels coincide. Split on p = mult(xs(m), xs(0)). **)
	        set p := apply_fun mult (apply_fun xs0 (ordsucc k), apply_fun xs0 0).
	        apply (xm (p = e)).
        - assume Hp_e : p = e.
           (** Cyclic reduction by boundary cancellation reduces to the middle involution of length k. **)
           claim Hk_in_m : k :e m.
           { rewrite Hm_sm. exact (ordsuccI2 k). }
           claim Hk_in_t : k :e t.
           { rewrite Ht_sm. exact (ordsuccI1 m k Hk_in_m). }
           claim Ht_eq : t = ordsucc m.
           { exact Ht_sm. }
           claim Hm_eq : m = ordsucc k.
           { exact Hm_sm. }
           claim Hred_sm : reduced_word J Gfam efam (ordsucc m) xs0.
           { rewrite <- Ht_sm. exact Hredt. }
           set xs_suf := graph m (fun i:set => apply_fun xs0 (ordsucc i)).
           claim Hred_suf : reduced_word J Gfam efam m xs_suf.
           { exact (reduced_word_suffix J Gfam efam m xs0 Hred_sm). }
           set xs_mid := graph k (fun i:set => apply_fun xs_suf i).
           claim Hred_mid : reduced_word J Gfam efam k xs_mid.
           { exact (reduced_word_prefix J Gfam efam m xs_suf k Hred_suf Hk_in_m). }

           set w := word_product mult e xs_suf k.
           claim Hw_eq : word_product mult e xs_mid k = w.
           {
             claim HkO : k :e omega.
             { exact (nat_p_omega k Hk_nat). }
             apply (word_product_congr_on mult e xs_mid xs_suf k HkO).
             let i. assume Hi.
             rewrite (apply_fun_graph k (fun j:set => apply_fun xs_suf j) i Hi).
             reflexivity.
           }

           (** Apply the boundary-cancellation cyclic-reduction lemma. **)
           claim Hcyc_cancel :
             w :e G /\
             w <> e /\
             apply_fun inv w = w /\
             v =
               apply_fun mult (apply_fun xs0 0,
                 apply_fun mult (w, apply_fun inv (apply_fun xs0 0))).
	           {
	             claim Hp_e0 : apply_fun mult (apply_fun xs0 m, apply_fun xs0 0) = e.
	             { rewrite Hm_sm. exact Hp_e. }
	             apply (free_product_involution_cyclic_reduce_boundary_cancel
	               G mult e inv J Gfam efam t xs0 m k v
	               Hfp Hredt Ht_sm Hm_nat Hm_sm Hk_nat Hp_e0 Hwpv Hv_G Hv_ne_e Hv_invol).
	           }
           apply (and4E
             (w :e G)
             (w <> e)
             (apply_fun inv w = w)
             (v =
               apply_fun mult (apply_fun xs0 0,
                 apply_fun mult (w, apply_fun inv (apply_fun xs0 0))))
             Hcyc_cancel).
           assume HwG Hwne Hwinv Hvconj.

           (** Use IH at k on w, then re-conjugate back to v. **)
           claim Hk_ne0 : k <> 0.
           {
             assume Hk0.
             claim Hw_e : w = e.
             {
               claim Hw_def : w = word_product mult e xs_suf k.
               { reflexivity. }
               rewrite Hw_def.
               rewrite Hk0.
               exact (nat_primrec_0 e (fun i r => apply_fun mult (r, apply_fun xs_suf i))).
             }
             exact (Hwne Hw_e).
           }
           claim HPk : P k.
           { exact (IHt k Hk_in_t). }
           claim Hw_decomp : exists alpha c x:set,
             alpha :e J /\
             c :e G /\
             x :e apply_fun Gfam alpha /\
             x <> e /\
             apply_fun inv x = x /\
             w = apply_fun mult (apply_fun inv c, apply_fun mult (x, c)).
           { exact (HPk w xs_mid HwG Hwne Hwinv Hred_mid Hk_ne0 Hw_eq). }

           apply Hw_decomp.
           let alpha. assume Hc_ex : exists c x:set,
             alpha :e J /\
             c :e G /\
             x :e apply_fun Gfam alpha /\
             x <> e /\
             apply_fun inv x = x /\
             w = apply_fun mult (apply_fun inv c, apply_fun mult (x, c)).
           apply Hc_ex.
           let c. assume Hx_ex : exists x:set,
             alpha :e J /\
             c :e G /\
             x :e apply_fun Gfam alpha /\
             x <> e /\
             apply_fun inv x = x /\
             w = apply_fun mult (apply_fun inv c, apply_fun mult (x, c)).
           apply Hx_ex.
           let x. assume Hw_pack :
             alpha :e J /\
             c :e G /\
             x :e apply_fun Gfam alpha /\
             x <> e /\
             apply_fun inv x = x /\
             w = apply_fun mult (apply_fun inv c, apply_fun mult (x, c)).
           apply (and6E
             (alpha :e J)
             (c :e G)
             (x :e apply_fun Gfam alpha)
             (x <> e)
             (apply_fun inv x = x)
             (w = apply_fun mult (apply_fun inv c, apply_fun mult (x, c)))
             Hw_pack).
           assume HalphaJ Hc_G Hx_in_Ga Hx_ne_e Hx_invol Hw_form.

           (** Conjugate the witness c by inv(xs0 0). **)
           claim Hx0_G : apply_fun xs0 0 :e G.
           {
             exact (reduced_word_in_G
               G mult e inv J Gfam efam t xs0
               Hsubfam Hredt 0 H0_in_t).
           }
           claim Hinv_x0_G : apply_fun inv (apply_fun xs0 0) :e G.
           {
             apply (and6E
               (function_on mult (setprod G G) G)
               (function_on inv G G)
               (e :e G)
               (forall a b c0:set, a :e G -> b :e G -> c0 :e G ->
                 apply_fun mult (apply_fun mult (a, b), c0) = apply_fun mult (a, apply_fun mult (b, c0)))
               (forall a:set, a :e G -> apply_fun mult (e, a) = a /\ apply_fun mult (a, e) = a)
               (forall a:set, a :e G ->
                 apply_fun mult (a, apply_fun inv a) = e /\ apply_fun mult (apply_fun inv a, a) = e)
               Hgrp).
             assume _ HinvFn _ _ _ _. exact (HinvFn (apply_fun xs0 0) Hx0_G).
           }
           claim Hx_G : x :e G.
           {
             exact (subgroup_of_subset
               (apply_fun Gfam alpha) G mult e inv
               (Hsubfam alpha HalphaJ)
               x Hx_in_Ga).
           }
           claim Hc2_G : apply_fun mult (c, apply_fun inv (apply_fun xs0 0)) :e G.
           {
             exact (group_source_mult_closure
               G mult e inv Hgrp
               c (apply_fun inv (apply_fun xs0 0)) Hc_G Hinv_x0_G).
           }

           witness alpha.
           witness (apply_fun mult (c, apply_fun inv (apply_fun xs0 0))).
           witness x.
           apply and6I.
           - exact HalphaJ.
           - exact Hc2_G.
           - exact Hx_in_Ga.
           - exact Hx_ne_e.
           - exact Hx_invol.
           - (** v = inv(c mul inv(x0)) mul x mul (c mul inv(x0)) **)
             apply (and6E
               (function_on mult (setprod G G) G)
               (function_on inv G G)
               (e :e G)
               (forall a b c0:set, a :e G -> b :e G -> c0 :e G ->
                 apply_fun mult (apply_fun mult (a, b), c0) = apply_fun mult (a, apply_fun mult (b, c0)))
               (forall a:set, a :e G -> apply_fun mult (e, a) = a /\ apply_fun mult (a, e) = a)
               (forall a:set, a :e G ->
                 apply_fun mult (a, apply_fun inv a) = e /\ apply_fun mult (apply_fun inv a, a) = e)
               Hgrp).
             assume HmultFn HinvFn He_G Hassoc Hid HinvLaw.
             claim Hinv_c_G : apply_fun inv c :e G.
             { exact (HinvFn c Hc_G). }
             claim Hxc_G : apply_fun mult (x, c) :e G.
             {
               exact (HmultFn (x, c)
                 (tuple_2_setprod_by_pair_Sigma G G x c Hx_G Hc_G)).
             }
             claim Hmid_G : apply_fun mult (apply_fun inv c, apply_fun mult (x, c)) :e G.
             {
               exact (HmultFn (apply_fun inv c, apply_fun mult (x, c))
                 (tuple_2_setprod_by_pair_Sigma
                   G G (apply_fun inv c) (apply_fun mult (x, c)) Hinv_c_G Hxc_G)).
             }
             claim Hinv_inv_x0 : apply_fun inv (apply_fun inv (apply_fun xs0 0)) = apply_fun xs0 0.
             {
               exact (group_inv_inv
                 G mult inv e (apply_fun xs0 0)
                 HmultFn HinvFn He_G Hassoc Hid HinvLaw Hx0_G).
             }
             (** Simplify v and the inverse of c mul inv(x0). **)
             rewrite Hvconj.
             rewrite Hw_form.
             rewrite (group_inv_mult
               G mult e inv c (apply_fun inv (apply_fun xs0 0))
               Hgrp Hc_G Hinv_x0_G).
             rewrite Hinv_inv_x0.
             (** Associate the left side into the target normal form. **)
             rewrite <- (Hassoc (apply_fun xs0 0)
               (apply_fun mult (apply_fun inv c, apply_fun mult (x, c)))
               (apply_fun inv (apply_fun xs0 0))
               Hx0_G Hmid_G Hinv_x0_G).
             rewrite <- (Hassoc (apply_fun xs0 0) (apply_fun inv c) (apply_fun mult (x, c)) Hx0_G Hinv_c_G Hxc_G).
             rewrite (Hassoc (apply_fun mult (apply_fun xs0 0, apply_fun inv c)) (apply_fun mult (x, c)) (apply_fun inv (apply_fun xs0 0))
               (HmultFn (apply_fun xs0 0, apply_fun inv c)
                 (tuple_2_setprod_by_pair_Sigma G G (apply_fun xs0 0) (apply_fun inv c) Hx0_G Hinv_c_G))
               Hxc_G Hinv_x0_G).
             rewrite (Hassoc x c (apply_fun inv (apply_fun xs0 0)) Hx_G Hc_G Hinv_x0_G).
             reflexivity.

	        - assume Hp_ne : p <> e.
	           (** If p is nontrivial, cyclic rotation gives a cyclically reduced involution, contradiction. **)

	           (** From ~(alphaL <> beta0) we obtain alphaL = beta0. **)
		           claim Hab_eq : alphaL = beta0.
		           {
		             apply (xm (alphaL = beta0)).
		             + assume Hab. exact Hab.
		             + assume Hab_ne.
		               exact (FalseE (Hcyc_eq Hab_ne) (alphaL = beta0)).
		           }
	           claim Hx0_in_GaL : apply_fun xs0 0 :e apply_fun Gfam alphaL.
	           {
	             rewrite Hab_eq.
	             exact Hx0_in_Gb0.
	           }

				           (** The boundary product p lies in the same factor subgroup, and cannot equal efam(alphaL). **)
				           (** NOTE: The p = efam(alphaL) branch is only eliminable if efam(alpha) is the ambient identity.
				              See NOTICE 1773102736. **)
					           claim Hp_in_GaL : p :e apply_fun Gfam alphaL.
					           {
					             claim Hxsk_in_GaL : apply_fun xs0 (ordsucc k) :e apply_fun Gfam alphaL.
					             { rewrite <- Hm_sm. exact HxL_in_GaL. }
				             exact (subgroup_of_mult_closed
				               (apply_fun Gfam alphaL) G mult e inv
				               (apply_fun xs0 (ordsucc k)) (apply_fun xs0 0)
				               (Hsubfam alphaL HalphaJ)
				               Hxsk_in_GaL
				               Hx0_in_GaL).
				           }
			           apply (xm (p = apply_fun efam alphaL)).
			           - assume Hp_ef : p = apply_fun efam alphaL.
			             (** If p = efam(alphaL) and p <> e, then efam(alphaL) is a nontrivial element of Gfam(alphaL), impossible. **)
			             claim Hefam_in_GaL : apply_fun efam alphaL :e apply_fun Gfam alphaL.
			             { rewrite <- Hp_ef. exact Hp_in_GaL. }
			             claim Hefam_ne_e : apply_fun efam alphaL <> e.
			             { rewrite <- Hp_ef. exact Hp_ne. }
			             exact (FalseE
			               (efam_not_in_Gfam_nontrivial_pre
			                 G mult e inv J Gfam efam
			                 Hfp
			                 alphaL HalphaJ Hefam_in_GaL Hefam_ne_e)
			               (exists alpha c x:set,
			                 alpha :e J /\
			                 c :e G /\
			                 x :e apply_fun Gfam alpha /\
			                 x <> e /\
			                 apply_fun inv x = x /\
			                 v = apply_fun mult (apply_fun inv c, apply_fun mult (x, c)))).
			           - assume Hp_ne_ef : p <> apply_fun efam alphaL.

		           (** k <> 0 (otherwise t = 2 and reducedness forces alphaL <> beta0). **)
		           claim Hk_ne0 : k <> 0.
		           {
	             assume Hk0.
	             claim Hm1 : m = 1.
	             { rewrite Hm_sm. rewrite Hk0. exact ordsucc_0_eq_1_nat. }
	             claim Ht2 : t = 2.
	             { rewrite Ht_sm. rewrite Hm1. exact ordsucc_1_eq_2_nat. }
	             claim H0_t : 0 :e t.
	             { rewrite Ht2. exact In_0_2. }
	             claim H1_t : ordsucc 0 :e t.
	             { rewrite Ht2. exact In_1_2. }
	             apply (and3E
	               (t :e omega)
	               (forall i:set, i :e t ->
	                 exists alpha:set, alpha :e J /\
	                   apply_fun xs0 i :e apply_fun Gfam alpha /\
	                   apply_fun xs0 i <> apply_fun efam alpha)
	               (forall i:set, i :e t -> ordsucc i :e t ->
	                 forall a b:set, a :e J -> b :e J ->
	                   apply_fun xs0 i :e apply_fun Gfam a ->
	                   apply_fun xs0 (ordsucc i) :e apply_fun Gfam b ->
	                   a <> b)
	               Hredt).
		             assume _ _ Hadj0.
		             claim Hx1_in_GaL : apply_fun xs0 (ordsucc 0) :e apply_fun Gfam alphaL.
		             {
		               rewrite ordsucc_0_eq_1_nat.
		               rewrite <- Hm1.
		               exact HxL_in_GaL.
		             }
		             claim Hbeta0_ne_aL : beta0 <> alphaL.
		             { exact (Hadj0 0 H0_t H1_t beta0 alphaL HbetaJ HalphaJ Hx0_in_Gb0 Hx1_in_GaL). }
		             claim HaL_ne_beta0 : alphaL <> beta0.
		             { assume Heq. exact (Hbeta0_ne_aL (eq_symm alphaL beta0 Heq)). }
	             exact (Hcyc_eq HaL_ne_beta0).
	           }

		           (** Build the rotated or merged reduced word of length m = ordsucc k: x1 ... x_{m-1} (xm x0). **)
	           claim Hk_in_m : k :e m.
	           { rewrite Hm_sm. exact (ordsuccI2 k). }
	           claim Hk_in_t : k :e t.
	           { rewrite Ht_sm. exact (ordsuccI1 m k Hk_in_m). }
	           claim Hm_in_t : m :e t.
	           { rewrite Ht_sm. exact (ordsuccI2 m). }
		           claim Hred_sm : reduced_word J Gfam efam (ordsucc m) xs0.
		           { rewrite <- Ht_sm. exact Hredt. }
		           set xs_suf := graph m (fun i:set => apply_fun xs0 (ordsucc i)).
		           claim Hred_suf : reduced_word J Gfam efam m xs_suf.
		           { exact (reduced_word_suffix J Gfam efam m xs0 Hred_sm). }
		           set xs_pre0 := graph k (fun i:set => apply_fun xs_suf i).
		           claim Hred_pre0 : reduced_word J Gfam efam k xs_pre0.
		           { exact (reduced_word_prefix J Gfam efam m xs_suf k Hred_suf Hk_in_m). }
		           set xs_pre := graph k (fun i:set => apply_fun xs0 (ordsucc i)).
		           claim Hpre_cong : forall i:set, i :e k -> apply_fun xs_pre0 i = apply_fun xs_pre i.
		           {
		             let i. assume Hi.
		             claim Hm_ord : ordinal m.
		             { exact (nat_p_ordinal m Hm_nat). }
		             claim Hk_sub : k c= m.
		             { exact (ordinal_TransSet m Hm_ord k Hk_in_m). }
		             claim Hi_m : i :e m.
		             { exact (Hk_sub i Hi). }
		             rewrite (apply_fun_graph k (fun j:set => apply_fun xs_suf j) i Hi).
		             rewrite (apply_fun_graph m (fun j:set => apply_fun xs0 (ordsucc j)) i Hi_m).
		             rewrite (apply_fun_graph k (fun j:set => apply_fun xs0 (ordsucc j)) i Hi).
		             reflexivity.
		           }
		           claim Hred_pre : reduced_word J Gfam efam k xs_pre.
		           { exact (reduced_word_congr_on J Gfam efam k xs_pre0 xs_pre Hred_pre0 Hpre_cong). }

	           (** Last-letter label differs from alphaL, needed for appending p. **)
	           claim Hlast_diff :
	             (forall k0 alpha beta1:set,
	               k = ordsucc k0 ->
	               alpha :e J ->
	               beta1 :e J ->
	               apply_fun xs_pre k0 :e apply_fun Gfam alpha ->
	               p :e apply_fun Gfam beta1 ->
	               alpha <> beta1).
	           {
	             let k0 alpha beta1.
	             assume Hk_sk HalJ HbeJ HlastG HpG.

	             (** beta1 = alphaL since p is nontrivial and lies in Gfam(alphaL). **)
	             claim Hbe_eq_aL : beta1 = alphaL.
	             {
	               exact (disjoint_subgroups_label_unique
	                 G mult e inv J Gfam beta1 alphaL p
	                 Hdisjoint HbeJ HalphaJ
	                 HpG Hp_in_GaL
	                 Hp_ne).
	             }

		             (** Compute apply_fun xs_pre k0 = apply_fun xs0 k. **)
		             claim Hk0_in_k : k0 :e k.
		             { rewrite Hk_sk. exact (ordsuccI2 k0). }
		             claim Hxsp : apply_fun xs_pre k0 = apply_fun xs0 k.
		             {
		               rewrite (apply_fun_graph k (fun i:set => apply_fun xs0 (ordsucc i)) k0 Hk0_in_k).
		               rewrite Hk_sk.
		               reflexivity.
		             }

	             (** Extract the label alphaK for xs0(k), and show alphaK <> alphaL by adjacency. **)
	             apply (reduced_word_elem J Gfam efam t xs0 k Hredt Hk_in_t).
	             let alphaK.
	             assume HalK_pack : alphaK :e J /\
	               apply_fun xs0 k :e apply_fun Gfam alphaK /\
	               apply_fun xs0 k <> apply_fun efam alphaK.
	             apply (and3E
	               (alphaK :e J)
	               (apply_fun xs0 k :e apply_fun Gfam alphaK)
	               (apply_fun xs0 k <> apply_fun efam alphaK)
	               HalK_pack).
	             assume HalKJ Hxk_in_GaK _.

	             (** xs0(k) is nontrivial since v <> e. **)
	             claim Hxk_ne_e : apply_fun xs0 k <> e.
	             {
	               exact (reduced_word_no_eG_if_product_non_e
	                 G mult e inv J Gfam efam t xs0 v
	                 Hgrp Hsubfam Hredt Ht_ne0 Hwpv Hv_ne_e
	                 k Hk_in_t).
	             }
	             (** alpha = alphaK by disjointness (xs0(k) in both factors). **)
	             claim Hal_eq_aK : alpha = alphaK.
	             {
	               claim Hxk_in_Ga : apply_fun xs0 k :e apply_fun Gfam alpha.
	               { rewrite <- Hxsp. exact HlastG. }
	               symmetry.
	               exact (disjoint_subgroups_label_unique
	                 G mult e inv J Gfam alphaK alpha (apply_fun xs0 k)
	                 Hdisjoint HalKJ HalJ
	                 Hxk_in_GaK Hxk_in_Ga
	                 Hxk_ne_e).
	             }
	             (** alphaK <> alphaL from reduced-word adjacency at i = k (succ k = m). **)
	             apply (and3E
	               (t :e omega)
	               (forall i:set, i :e t ->
	                 exists a:set, a :e J /\
	                   apply_fun xs0 i :e apply_fun Gfam a /\
	                   apply_fun xs0 i <> apply_fun efam a)
	               (forall i:set, i :e t -> ordsucc i :e t ->
	                 forall a b:set, a :e J -> b :e J ->
	                   apply_fun xs0 i :e apply_fun Gfam a ->
	                   apply_fun xs0 (ordsucc i) :e apply_fun Gfam b ->
	                   a <> b)
	               Hredt).
		             assume _ _ Hadj.
		             claim Hsk_t : ordsucc k :e t.
		             { rewrite <- Hm_sm. exact Hm_in_t. }
		             claim Hxsk_in_GaL : apply_fun xs0 (ordsucc k) :e apply_fun Gfam alphaL.
		             {
		               rewrite <- Hm_sm.
		               exact HxL_in_GaL.
		             }
		             claim Hneq_aK_aL : alphaK <> alphaL.
		             { exact (Hadj k Hk_in_t Hsk_t alphaK alphaL HalKJ HalphaJ Hxk_in_GaK Hxsk_in_GaL). }

	             rewrite Hal_eq_aK.
	             rewrite Hbe_eq_aL.
	             exact Hneq_aK_aL.
	           }

							           set xs1 := graph (ordsucc k) (fun i:set => if i :e k then apply_fun xs_pre i else p).
							           claim Hred1 : reduced_word J Gfam efam m xs1.
							           {
							             claim Hred1_s : reduced_word J Gfam efam (ordsucc k) xs1.
							             {
							               exact (reduced_word_append_one_pre
							                 J Gfam efam k xs_pre p alphaL
							                 Hred_pre
							                 Hk_ne0
							                 HalphaJ
							                 Hp_in_GaL
							                 Hp_ne_ef
							                 Hlast_diff).
							             }
							             rewrite Hm_sm.
							             exact Hred1_s.
							           }

	           (** Let u1 := inv(x0) mul (v mul x0). We show u1 is an involution with reduced word xs1. **)
	           claim Hx0_G : apply_fun xs0 0 :e G.
	           {
	             exact (reduced_word_in_G
	               G mult e inv J Gfam efam t xs0
	               Hsubfam Hredt 0 H0_in_t).
	           }
	           set u1 := apply_fun mult (apply_fun inv (apply_fun xs0 0), apply_fun mult (v, apply_fun xs0 0)).
	           claim Hu1_G : u1 :e G.
	           {
	             apply (and6E
	               (function_on mult (setprod G G) G)
	               (function_on inv G G)
	               (e :e G)
	               (forall a b c0:set, a :e G -> b :e G -> c0 :e G ->
	                 apply_fun mult (apply_fun mult (a, b), c0) = apply_fun mult (a, apply_fun mult (b, c0)))
	               (forall a:set, a :e G -> apply_fun mult (e, a) = a /\ apply_fun mult (a, e) = a)
	               (forall a:set, a :e G ->
	                 apply_fun mult (a, apply_fun inv a) = e /\ apply_fun mult (apply_fun inv a, a) = e)
	               Hgrp).
	             assume HmultFn HinvFn _ _ _ _.
	             apply HmultFn.
	             exact (tuple_2_setprod_by_pair_Sigma
	               G G (apply_fun inv (apply_fun xs0 0)) (apply_fun mult (v, apply_fun xs0 0))
	               (HinvFn (apply_fun xs0 0) Hx0_G)
	               (HmultFn (v, apply_fun xs0 0)
	                 (tuple_2_setprod_by_pair_Sigma G G v (apply_fun xs0 0) Hv_G Hx0_G))).
	           }
	           claim Hu1_ne_e : u1 <> e.
	           {
	             exact (group_conjugate_ne_e
	               G mult e inv (apply_fun xs0 0) v
	               Hgrp Hx0_G Hv_G Hv_ne_e).
	           }
	           claim Hu1_invol : apply_fun inv u1 = u1.
	           {
	             exact (group_conjugate_involutive
	               G mult e inv (apply_fun xs0 0) v
	               Hgrp Hx0_G Hv_G Hv_invol).
	           }

	           (** Compute word_product xs1 m = u1. **)
	           claim HmO : m :e omega.
	           {
	             apply (and3E
	               (m :e omega)
	               (forall i:set, i :e m ->
	                 exists a:set, a :e J /\
	                   apply_fun xs1 i :e apply_fun Gfam a /\
	                   apply_fun xs1 i <> apply_fun efam a)
	               (forall i:set, i :e m -> ordsucc i :e m ->
	                 forall a b:set, a :e J -> b :e J ->
	                   apply_fun xs1 i :e apply_fun Gfam a ->
	                   apply_fun xs1 (ordsucc i) :e apply_fun Gfam b ->
	                   a <> b)
	               Hred1).
	             assume HmO0 _ _. exact HmO0.
	           }
	           claim HkO : k :e omega.
	           { exact (nat_p_omega k Hk_nat). }
		           claim Hwp_append :
		             word_product mult e xs1 (ordsucc k) =
		               apply_fun mult (word_product mult e xs_pre k, p).
		           { exact (word_product_append_one mult e xs_pre p k HkO). }
					           claim Hwp_xs1 :
					             word_product mult e xs1 m =
					               apply_fun mult (word_product mult e xs_pre k, p).
					           {
					             rewrite Hm_sm.
					             exact Hwp_append.
					           }
			           claim Hwp_pre_eq :
			             word_product mult e xs_pre k = word_product mult e xs_suf k.
			           {
		             apply (word_product_congr_on mult e xs_pre xs_suf k HkO).
		             let i. assume Hi.
		             claim Hm_ord : ordinal m.
		             { exact (nat_p_ordinal m Hm_nat). }
		             claim Hk_sub : k c= m.
		             { exact (ordinal_TransSet m Hm_ord k Hk_in_m). }
		             claim Hi_m : i :e m.
		             { exact (Hk_sub i Hi). }
		             rewrite (apply_fun_graph k (fun j:set => apply_fun xs0 (ordsucc j)) i Hi).
		             rewrite (apply_fun_graph m (fun j:set => apply_fun xs0 (ordsucc j)) i Hi_m).
		             reflexivity.
		           }
				           claim Hwp_suf_succ :
				             word_product mult e xs_suf m =
				               apply_fun mult (word_product mult e xs_suf k, apply_fun xs_suf k).
				           {
				             claim Hxsuf_def :
				               xs_suf = graph (ordsucc k) (fun i:set => apply_fun xs0 (ordsucc i)).
				             { rewrite Hm_sm. reflexivity. }
				             rewrite Hxsuf_def.
				             rewrite Hm_sm.
				             exact (word_product_succ
				               mult e (graph (ordsucc k) (fun i:set => apply_fun xs0 (ordsucc i))) k Hk_nat).
				           }
	           claim Hxsuf_k : apply_fun xs_suf k = apply_fun xs0 m.
	           {
	             rewrite (apply_fun_graph m (fun i:set => apply_fun xs0 (ordsucc i)) k Hk_in_m).
	             rewrite <- Hm_sm.
	             reflexivity.
	           }
	           (** Suffix product equals inv(x0) mul v. **)
	           claim Hxs0_in_G_sm : forall i:set, i :e ordsucc m -> apply_fun xs0 i :e G.
	           {
	             exact (reduced_word_in_G
	               G mult e inv J Gfam efam (ordsucc m) xs0
	               Hsubfam Hred_sm).
	           }
	           claim Hwp_suf_m :
	             word_product mult e xs_suf m =
	               apply_fun mult (apply_fun inv (apply_fun xs0 0), word_product mult e xs0 (ordsucc m)).
	           { exact (word_product_suffix_by_cancel G mult e inv m xs0 Hgrp Hm_nat Hxs0_in_G_sm). }
	           claim Hwp_full : word_product mult e xs0 (ordsucc m) = v.
	           { rewrite <- Ht_sm. exact Hwpv. }

	           (** Combine these to get word_product xs1 m = u1. **)
		           apply (and6E
		             (function_on mult (setprod G G) G)
		             (function_on inv G G)
		             (e :e G)
		             (forall a b c0:set, a :e G -> b :e G -> c0 :e G ->
		               apply_fun mult (apply_fun mult (a, b), c0) = apply_fun mult (a, apply_fun mult (b, c0)))
		             (forall a:set, a :e G -> apply_fun mult (e, a) = a /\ apply_fun mult (a, e) = a)
		             (forall a:set, a :e G ->
		               apply_fun mult (a, apply_fun inv a) = e /\ apply_fun mult (apply_fun inv a, a) = e)
		             Hgrp).
			           assume _ HinvF _ Hassoc _ _.
			           claim Hwp_xs1_eq_u1 : word_product mult e xs1 m = u1.
			           {
			             claim Hp_defm : p = apply_fun mult (apply_fun xs0 m, apply_fun xs0 0).
			             { rewrite <- Hm_sm. reflexivity. }

			             claim Hxsuf_in_Gk : forall i:set, i :e k -> apply_fun xs_suf i :e G.
			             {
			               let i. assume Hi : i :e k.
			               claim Hm_ord : ordinal m.
			               { exact (nat_p_ordinal m Hm_nat). }
			               claim Hk_sub : k c= m.
			               { exact (ordinal_TransSet m Hm_ord k Hk_in_m). }
			               claim Hi_m : i :e m.
			               { exact (Hk_sub i Hi). }
			               rewrite (apply_fun_graph m (fun j:set => apply_fun xs0 (ordsucc j)) i Hi_m).
			               exact (Hxs0_in_G_sm (ordsucc i) (nat_ordsucc_in_ordsucc m Hm_nat i Hi_m)).
			             }

			             claim Hwp_suf_k_G : word_product mult e xs_suf k :e G.
			             {
			               exact (word_product_in_G_group
			                 G mult e inv k xs_suf
			                 Hgrp Hk_nat Hxsuf_in_Gk).
			             }
			             claim Hxm_G : apply_fun xs0 m :e G.
			             { exact (Hxs0_in_G_sm m (ordsuccI2 m)). }
			             claim Hinvx0_G : apply_fun inv (apply_fun xs0 0) :e G.
			             { exact (HinvF (apply_fun xs0 0) Hx0_G). }

			             claim Hsuf_eq :
			               apply_fun mult (word_product mult e xs_suf k, apply_fun xs0 m) =
			                 apply_fun mult (apply_fun inv (apply_fun xs0 0), v).
			             {
			               rewrite <- Hxsuf_k.
			               rewrite <- Hwp_suf_succ.
			               rewrite Hwp_suf_m.
			               rewrite Hwp_full.
			               reflexivity.
			             }

			             rewrite Hwp_xs1.
			             rewrite Hwp_pre_eq.
			             rewrite Hp_defm.
			             rewrite <- (Hassoc
			               (word_product mult e xs_suf k)
			               (apply_fun xs0 m)
			               (apply_fun xs0 0)
			               Hwp_suf_k_G
			               Hxm_G
			               Hx0_G).
			             rewrite Hsuf_eq.
			             exact (Hassoc
			               (apply_fun inv (apply_fun xs0 0))
			               v
			               (apply_fun xs0 0)
			               Hinvx0_G
			               Hv_G
			               Hx0_G).
			           }
		           (** Now doubling xs1 yields a reduced word for u1^2, contradicting u1^2 = e. **)
	           claim Hu1_sq : apply_fun mult (u1, u1) = e.
	           { exact (group_involutive_square_e G mult e inv u1 Hgrp Hu1_G Hu1_invol). }

			           (** First and last labels differ: first is label of xs0(1), last is alphaL. **)
			           claim H1_in_t : ordsucc 0 :e t.
			           {
			             rewrite Ht_sm.
			             claim H0_in_m : 0 :e m.
			             { rewrite Hm_sm. exact (nat_0_in_ordsucc k Hk_nat). }
			             exact (nat_ordsucc_in_ordsucc m Hm_nat 0 H0_in_m).
			           }
			           apply (reduced_word_elem J Gfam efam t xs0 (ordsucc 0) Hredt H1_in_t).
	           let beta1. assume Hbeta1_pack :
	             beta1 :e J /\
	             apply_fun xs0 (ordsucc 0) :e apply_fun Gfam beta1 /\
	             apply_fun xs0 (ordsucc 0) <> apply_fun efam beta1.
	           apply (and3E
	             (beta1 :e J)
	             (apply_fun xs0 (ordsucc 0) :e apply_fun Gfam beta1)
	             (apply_fun xs0 (ordsucc 0) <> apply_fun efam beta1)
	             Hbeta1_pack).
	           assume Hbeta1J Hx1_in_Gb1 _.
	           claim Hx1_ne_e : apply_fun xs0 (ordsucc 0) <> e.
	           {
	             claim H1_t2 : ordsucc 0 :e t.
	             { exact H1_in_t. }
	             exact (reduced_word_no_eG_if_product_non_e
	               G mult e inv J Gfam efam t xs0 v
	               Hgrp Hsubfam Hredt Ht_ne0 Hwpv Hv_ne_e
	               (ordsucc 0) H1_t2).
	           }
			           claim Hbeta1_ne_aL : beta1 <> alphaL.
			           {
			             apply (and3E
			               (t :e omega)
			               (forall i:set, i :e t ->
			                 exists a:set, a :e J /\
			                   apply_fun xs0 i :e apply_fun Gfam a /\
			                   apply_fun xs0 i <> apply_fun efam a)
			               (forall i:set, i :e t -> ordsucc i :e t ->
			                 forall a b:set, a :e J -> b :e J ->
			                   apply_fun xs0 i :e apply_fun Gfam a ->
			                   apply_fun xs0 (ordsucc i) :e apply_fun Gfam b ->
			                   a <> b)
			               Hredt).
			             assume _ _ Hadj.
			             claim H0_t : 0 :e t.
			             { rewrite Ht_sm. exact (nat_0_in_ordsucc m Hm_nat). }
			             claim Hbeta0_ne_beta1 : beta0 <> beta1.
			             { exact (Hadj 0 H0_t H1_in_t beta0 beta1 HbetaJ Hbeta1J Hx0_in_Gb0 Hx1_in_Gb1). }
				             claim Hbeta1_ne_beta0 : beta1 <> beta0.
				             { assume Heq. exact (Hbeta0_ne_beta1 (eq_symm beta1 beta0 Heq)). }
			             assume Hbe1_aL.
			             claim Hbe1_b0 : beta1 = beta0.
			             { exact (eq_i_tra beta1 alphaL beta0 Hbe1_aL Hab_eq). }
			             exact (Hbeta1_ne_beta0 Hbe1_b0).
			           }

			           claim Hcyc_all1 :
			             forall a b:set, a :e J -> b :e J ->
			               apply_fun xs1 k :e apply_fun Gfam a ->
			               apply_fun xs1 0 :e apply_fun Gfam b ->
			               a <> b.
			           {
			             let a b.
			             assume HaJ HbJ Hlast1 Hfirst1.
			             claim Hk_in_xs1 : k :e ordsucc k.
			             { exact (ordsuccI2 k). }
			             claim H0_in_xs1 : 0 :e ordsucc k.
			             { exact (nat_0_in_ordsucc k Hk_nat). }
			             claim H0_in_k : 0 :e k.
			             {
			               apply (nat_inv k Hk_nat).
			               - assume Hk0 : k = 0. exact (FalseE (Hk_ne0 Hk0) (0 :e k)).
			               - assume Hex_k0 : exists k0:set, nat_p k0 /\ k = ordsucc k0.
			                 apply Hex_k0. let k0. assume Hk0_pack : nat_p k0 /\ k = ordsucc k0.
			                 claim Hk0_nat : nat_p k0.
			                 { exact (andEL (nat_p k0) (k = ordsucc k0) Hk0_pack). }
			                 claim Hk_eq : k = ordsucc k0.
			                 { exact (andER (nat_p k0) (k = ordsucc k0) Hk0_pack). }
			                 rewrite Hk_eq. exact (nat_0_in_ordsucc k0 Hk0_nat).
			             }
			             claim H0_in_m : 0 :e m.
			             { rewrite Hm_sm. exact (nat_0_in_ordsucc k Hk_nat). }
			             claim Hlast_val : apply_fun xs1 k = p.
			             {
			               rewrite (apply_fun_graph (ordsucc k)
			                 (fun i:set => if i :e k then apply_fun xs_pre i else p)
			                 k Hk_in_xs1).
			               rewrite (If_i_0 (k :e k) (apply_fun xs_pre k) p (In_irref k)).
			               reflexivity.
			             }
			             claim Hfirst_val : apply_fun xs1 0 = apply_fun xs0 (ordsucc 0).
			             {
				               rewrite (apply_fun_graph (ordsucc k)
				                 (fun i:set => if i :e k then apply_fun xs_pre i else p)
				                 0 H0_in_xs1).
				               rewrite (If_i_1 (0 :e k) (apply_fun xs_pre 0) p H0_in_k).
				               rewrite (apply_fun_graph k (fun i:set => apply_fun xs0 (ordsucc i)) 0 H0_in_k).
					               reflexivity.
					             }
				             claim Hp_in_Ga : p :e apply_fun Gfam a.
				             { rewrite <- Hlast_val. exact Hlast1. }
				             claim Hx1_in_Gb : apply_fun xs0 (ordsucc 0) :e apply_fun Gfam b.
				             { rewrite <- Hfirst_val. exact Hfirst1. }
				             claim Ha_eq : a = alphaL.
				             {
				               symmetry.
				               exact (disjoint_subgroups_label_unique
				                 G mult e inv J Gfam alphaL a p
				                 Hdisjoint HalphaJ HaJ
				                 Hp_in_GaL Hp_in_Ga
				                 Hp_ne).
				             }
				             claim Hb_eq : b = beta1.
				             {
				               symmetry.
				               exact (disjoint_subgroups_label_unique
				                 G mult e inv J Gfam beta1 b (apply_fun xs0 (ordsucc 0))
				                 Hdisjoint Hbeta1J HbJ
				                 Hx1_in_Gb1 Hx1_in_Gb
				                 Hx1_ne_e).
				             }
			             rewrite Ha_eq.
			             rewrite Hb_eq.
			             assume Hab.
			             exact (Hbeta1_ne_aL (eq_symm alphaL beta1 Hab)).
			           }

	           apply (reduced_word_double_cyclic_word_product
	             G mult e inv J Gfam efam m xs1 k
	             Hgrp Hsubfam Hred1 Hm_sm Hk_nat Hcyc_all1).
	           let ys2.
	           assume Hys2_pack :
	             reduced_word J Gfam efam (add_nat m m) ys2 /\
	             word_product mult e ys2 (add_nat m m) =
	               apply_fun mult (word_product mult e xs1 m, word_product mult e xs1 m).
	           claim Hred2 : reduced_word J Gfam efam (add_nat m m) ys2.
	           {
	             exact (andEL
	               (reduced_word J Gfam efam (add_nat m m) ys2)
	               (word_product mult e ys2 (add_nat m m) =
	                 apply_fun mult (word_product mult e xs1 m, word_product mult e xs1 m))
	               Hys2_pack).
	           }
	           claim Hwp2 :
	             word_product mult e ys2 (add_nat m m) =
	               apply_fun mult (word_product mult e xs1 m, word_product mult e xs1 m).
	           {
	             exact (andER
	               (reduced_word J Gfam efam (add_nat m m) ys2)
	               (word_product mult e ys2 (add_nat m m) =
	                 apply_fun mult (word_product mult e xs1 m, word_product mult e xs1 m))
	               Hys2_pack).
	           }
	           claim Hlen2_ne0 : add_nat m m <> 0.
	           {
	             rewrite Hm_sm.
	             rewrite (add_nat_SR (ordsucc k) k Hk_nat).
	             exact (neq_ordsucc_0 (add_nat (ordsucc k) k)).
	           }
	           claim Hlen2_ne1 : add_nat m m <> 1.
	           {
	             assume Habs2 : add_nat m m = 1.
	             claim Htmp1 : add_nat (ordsucc k) (ordsucc k) =
	               ordsucc (add_nat (ordsucc k) k).
	             { exact (add_nat_SR (ordsucc k) k Hk_nat). }
	             claim Heq : ordsucc (add_nat (ordsucc k) k) = 1.
	             {
	               claim Habs1 : add_nat (ordsucc k) (ordsucc k) = 1.
	               { rewrite <- Hm_sm. exact Habs2. }
	               rewrite <- Htmp1.
	               exact Habs1.
	             }
	             claim Hkk_eq0 : add_nat (ordsucc k) k = 0.
	             {
	               claim Hs : ordsucc (add_nat (ordsucc k) k) = ordsucc 0.
	               { rewrite Heq. symmetry. exact ordsucc_0_eq_1_nat. }
	               exact (ordsucc_inj (add_nat (ordsucc k) k) 0 Hs).
	             }
	             claim Hkk_ne0 : add_nat (ordsucc k) k <> 0.
	             {
	               claim Htmp2 : add_nat (ordsucc k) k = ordsucc (add_nat k k).
	               { exact (add_nat_SL k Hk_nat k Hk_nat). }
	               assume H0.
	               claim Hs0 : ordsucc (add_nat k k) = 0.
	               {
	                 exact (eq_i_tra
	                   (ordsucc (add_nat k k))
	                   (add_nat (ordsucc k) k)
	                   0
	                   (eq_symm (add_nat (ordsucc k) k) (ordsucc (add_nat k k)) Htmp2)
	                   H0).
	               }
	               exact (neq_ordsucc_0 (add_nat k k) Hs0).
	             }
	             exact (Hkk_ne0 Hkk_eq0).
	           }
	           claim Hys2_in_G : forall i:set, i :e add_nat m m -> apply_fun ys2 i :e G.
	           {
	             let i. assume Hi.
	             exact (reduced_word_in_G
	               G mult e inv J Gfam efam (add_nat m m) ys2
	               Hsubfam Hred2 i Hi).
	           }
	           claim Hys2_ne_e : forall i:set, i :e add_nat m m -> apply_fun ys2 i <> e.
	           {
	             let i. assume Hi.
	             exact (reduced_word_no_eG_all
	               G mult e inv J Gfam efam (add_nat m m) ys2
	               Hgrp Hsubfam Hred2 Hlen2_ne0 Hlen2_ne1 i Hi).
	           }
	           claim Hwp2_e : word_product mult e ys2 (add_nat m m) = e.
	           {
	             rewrite Hwp2.
	             rewrite Hwp_xs1_eq_u1.
	             exact Hu1_sq.
	           }
	           claim Hwp2_ne : word_product mult e ys2 (add_nat m m) <> e.
	           {
	             exact (free_product_reduced_word_length_ne0_product_ne_e
	               G mult e inv J Gfam efam (add_nat m m) ys2
	               Hfp Hred2 Hys2_in_G Hys2_ne_e Hlen2_ne0).
	           }
	           exact (FalseE (Hwp2_ne Hwp2_e) (exists alpha c x:set,
	             alpha :e J /\
	             c :e G /\
	             x :e apply_fun Gfam alpha /\
	             x <> e /\
	             apply_fun inv x = x /\
	             v = apply_fun mult (apply_fun inv c, apply_fun mult (x, c)))).
	  - exact Hn_nat.
}

exact (HPn u xs Hu_G Hu_ne_e Hu_invol Hred Hn_ne0 Hwp).
Qed.

(** Infrastructure: boundary-cancellation "order 2" subcase (TODO) **)
(** This isolates the remaining difficult branches in free_product_efam_involutive_contra. **)
(** Collected Alice 55 **)
(** Proven Alice **)
Lemma free_product_boundary_product_ne_e_or_efam :
  forall G multG eG invG J Gfam efam al n xs m alpha0:set,
  free_product_of_subgroups G multG eG invG J Gfam efam ->
  al :e J ->
  apply_fun efam al :e apply_fun Gfam al ->
  apply_fun efam al <> eG ->
  apply_fun invG (apply_fun efam al) = apply_fun efam al ->
  reduced_word J Gfam efam n xs ->
  n = ordsucc m ->
  nat_p m ->
  m <> 0 ->
  alpha0 :e J ->
  apply_fun xs 0 :e apply_fun Gfam alpha0 ->
  apply_fun xs 0 <> eG ->
  apply_fun xs 0 <> apply_fun efam alpha0 ->
  apply_fun xs m :e apply_fun Gfam alpha0 ->
  apply_fun xs m <> eG ->
  apply_fun xs m <> apply_fun efam alpha0 ->
  alpha0 <> al ->
  word_product multG eG xs n = apply_fun efam al ->
  let p := apply_fun multG (apply_fun xs m, apply_fun xs 0) in
    p <> eG /\ p <> apply_fun efam alpha0.
let G multG eG invG J Gfam efam al n xs m alpha0.
assume Hfp Hal Hefam_Gal Hefam_ne Hefam_invol.
assume Hred Hn_sm Hm_nat Hm_ne0.
assume Halpha0J Hx0_in_Ga0 Hx0_ne_eG Hx0_ne_ef0.
assume Hxm_in_Ga0 Hxm_ne_eG Hxm_ne_ef0.
assume Halpha0_ne Hwp.

(** Unpack free product structure (in particular: group structure and subgroup closure). **)
apply (and6E
  (group_structure G multG eG invG)
  (forall alpha:set, alpha :e J -> subgroup_of (apply_fun Gfam alpha) G multG eG invG)
  (forall alpha beta:set, alpha :e J -> beta :e J -> alpha <> beta ->
    forall x:set, x :e apply_fun Gfam alpha -> x :e apply_fun Gfam beta -> x = eG)
  (subgroups_generate G multG eG invG J Gfam)
  (forall x:set, x :e G -> x <> eG ->
    exists n0 xs0:set,
      reduced_word J Gfam efam n0 xs0 /\ n0 <> 0 /\
      word_product multG eG xs0 n0 = x /\
      (forall n' xs':set,
        reduced_word J Gfam efam n' xs' -> n' <> 0 ->
        word_product multG eG xs' n' = x ->
        n0 = n' /\ (forall i:set, i :e n0 -> apply_fun xs0 i = apply_fun xs' i)))
  (forall alpha:set, alpha :e J -> apply_fun efam alpha = eG)
  Hfp).
assume Hgrp Hsubfam Hdisjoint _ _ _.

set p := apply_fun multG (apply_fun xs m, apply_fun xs 0).
prove p <> eG /\ p <> apply_fun efam alpha0.
 
(** Basic disjointness consequences: x0, xm are not in the factor subgroup Gfam(al). **)
claim Hx0_not_in_Gal : ~(apply_fun xs 0 :e apply_fun Gfam al).
{
  assume Hx0_in_Gal : apply_fun xs 0 :e apply_fun Gfam al.
  claim Hx0_eq_eG : apply_fun xs 0 = eG.
  { exact (Hdisjoint alpha0 al Halpha0J Hal Halpha0_ne
      (apply_fun xs 0) Hx0_in_Ga0 Hx0_in_Gal). }
  exact (Hx0_ne_eG Hx0_eq_eG).
}
claim Hxm_not_in_Gal : ~(apply_fun xs m :e apply_fun Gfam al).
{
  assume Hxm_in_Gal : apply_fun xs m :e apply_fun Gfam al.
  claim Hxm_eq_eG : apply_fun xs m = eG.
  { exact (Hdisjoint alpha0 al Halpha0J Hal Halpha0_ne
      (apply_fun xs m) Hxm_in_Ga0 Hxm_in_Gal). }
  exact (Hxm_ne_eG Hxm_eq_eG).
}
(** In particular, m cannot be 1 (otherwise reduced_word adjacency would be violated). **)
claim Hm_ne1 : m <> 1.
{
  assume Hm1 : m = 1.
  claim Hn2 : n = 2.
  { rewrite Hn_sm. rewrite Hm1. exact ordsucc_1_eq_2_nat. }
  claim H0_in_n : 0 :e n. { rewrite Hn2. exact In_0_2. }
  claim H1_in_n : ordsucc 0 :e n. { rewrite Hn2. exact In_1_2. }
  apply (and3E
    (n :e omega)
    (forall i:set, i :e n ->
      exists alpha:set, alpha :e J /\
        apply_fun xs i :e apply_fun Gfam alpha /\
        apply_fun xs i <> apply_fun efam alpha)
    (forall i:set, i :e n -> ordsucc i :e n ->
      forall a b:set, a :e J -> b :e J ->
        apply_fun xs i :e apply_fun Gfam a ->
        apply_fun xs (ordsucc i) :e apply_fun Gfam b ->
        a <> b)
    Hred).
  assume _ _ Hadj.
  claim Hs0 : ordsucc 0 = m.
  { rewrite Hm1. exact ordsucc_0_eq_1_nat. }
  claim Hxs1_in_Ga0 : apply_fun xs (ordsucc 0) :e apply_fun Gfam alpha0.
  { rewrite Hs0. exact Hxm_in_Ga0. }
  exact ((Hadj 0 H0_in_n H1_in_n alpha0 alpha0 Halpha0J Halpha0J Hx0_in_Ga0 Hxs1_in_Ga0) (eq_refl alpha0)).
}

apply andI.

- (** p <> eG **)
  assume Hp_e : p = eG.
  (** Then xs(m) = inv(xs(0)) and xs(0) = inv(xs(m)). **)
  claim Hxm_eq_inv_x0 : apply_fun xs m = apply_fun invG (apply_fun xs 0).
  {
    set xs2 := graph 2 (fun i:set => If_i (i = 0) (apply_fun xs m) (apply_fun xs 0)).
    claim Hxs2_G : forall i:set, i :e 2 -> apply_fun xs2 i :e G.
    {
      let i. assume Hi2.
      apply (cases_2 i Hi2 (fun j:set => apply_fun xs2 j :e G)).
      + prove apply_fun xs2 0 :e G.
        rewrite (apply_fun_graph 2 (fun t:set => If_i (t = 0) (apply_fun xs m) (apply_fun xs 0)) 0 In_0_2).
        rewrite (If_i_1 (0 = 0) (apply_fun xs m) (apply_fun xs 0) (eq_refl 0)).
        exact (subgroup_of_subset (apply_fun Gfam alpha0) G multG eG invG (Hsubfam alpha0 Halpha0J)
          (apply_fun xs m) Hxm_in_Ga0).
      + prove apply_fun xs2 1 :e G.
        rewrite (apply_fun_graph 2 (fun t:set => If_i (t = 0) (apply_fun xs m) (apply_fun xs 0)) 1 In_1_2).
        rewrite (If_i_0 (1 = 0) (apply_fun xs m) (apply_fun xs 0) neq_1_0).
        exact (subgroup_of_subset (apply_fun Gfam alpha0) G multG eG invG (Hsubfam alpha0 Halpha0J)
          (apply_fun xs 0) Hx0_in_Ga0).
    }
    claim Hwp2 : word_product multG eG xs2 2 = apply_fun multG (apply_fun xs m, apply_fun xs 0).
    {
      exact (word_product_two_graph_group
        G multG eG invG (apply_fun xs m) (apply_fun xs 0)
        Hgrp
        (subgroup_of_subset (apply_fun Gfam alpha0) G multG eG invG (Hsubfam alpha0 Halpha0J)
          (apply_fun xs m) Hxm_in_Ga0)
        (subgroup_of_subset (apply_fun Gfam alpha0) G multG eG invG (Hsubfam alpha0 Halpha0J)
          (apply_fun xs 0) Hx0_in_Ga0)).
    }
    claim Hwp2_e : word_product multG eG xs2 2 = eG.
    { rewrite Hwp2. rewrite <- Hp_e. reflexivity. }
    (** Use the length-2 inverse lemma. **)
    claim Htmp : apply_fun xs2 0 = apply_fun invG (apply_fun xs2 1).
    { exact (word_product_two_eq_inv_left G multG eG invG xs2 Hgrp Hxs2_G Hwp2_e). }
    (** Unfold xs2 at 0 and 1. **)
    claim Hxs20 : apply_fun xs2 0 = apply_fun xs m.
    {
      rewrite (apply_fun_graph 2 (fun t:set => If_i (t = 0) (apply_fun xs m) (apply_fun xs 0)) 0 In_0_2).
      rewrite (If_i_1 (0 = 0) (apply_fun xs m) (apply_fun xs 0) (eq_refl 0)).
      reflexivity.
    }
    claim Hxs21 : apply_fun xs2 1 = apply_fun xs 0.
    {
      rewrite (apply_fun_graph 2 (fun t:set => If_i (t = 0) (apply_fun xs m) (apply_fun xs 0)) 1 In_1_2).
      rewrite (If_i_0 (1 = 0) (apply_fun xs m) (apply_fun xs 0) neq_1_0).
      reflexivity.
    }
    (** Conclude xs(m) = inv(xs(0)). **)
    claim Hinv_congr : apply_fun invG (apply_fun xs2 1) = apply_fun invG (apply_fun xs 0).
    { exact (apply_fun_congr_arg invG (apply_fun xs2 1) (apply_fun xs 0) Hxs21). }
    exact (eq_i_tra
      (apply_fun xs m)
      (apply_fun xs2 0)
      (apply_fun invG (apply_fun xs 0))
      (eq_symm (apply_fun xs2 0) (apply_fun xs m) Hxs20)
      (eq_i_tra
        (apply_fun xs2 0)
        (apply_fun invG (apply_fun xs2 1))
        (apply_fun invG (apply_fun xs 0))
        Htmp
        Hinv_congr)).
  }
  claim Hx0_eq_inv_xm : apply_fun xs 0 = apply_fun invG (apply_fun xs m).
  {
    set xs2 := graph 2 (fun i:set => If_i (i = 0) (apply_fun xs m) (apply_fun xs 0)).
    claim Hxs2_G : forall i:set, i :e 2 -> apply_fun xs2 i :e G.
    {
      let i. assume Hi2.
      apply (cases_2 i Hi2 (fun j:set => apply_fun xs2 j :e G)).
      + prove apply_fun xs2 0 :e G.
        rewrite (apply_fun_graph 2 (fun t:set => If_i (t = 0) (apply_fun xs m) (apply_fun xs 0)) 0 In_0_2).
        rewrite (If_i_1 (0 = 0) (apply_fun xs m) (apply_fun xs 0) (eq_refl 0)).
        exact (subgroup_of_subset (apply_fun Gfam alpha0) G multG eG invG (Hsubfam alpha0 Halpha0J)
          (apply_fun xs m) Hxm_in_Ga0).
      + prove apply_fun xs2 1 :e G.
        rewrite (apply_fun_graph 2 (fun t:set => If_i (t = 0) (apply_fun xs m) (apply_fun xs 0)) 1 In_1_2).
        rewrite (If_i_0 (1 = 0) (apply_fun xs m) (apply_fun xs 0) neq_1_0).
        exact (subgroup_of_subset (apply_fun Gfam alpha0) G multG eG invG (Hsubfam alpha0 Halpha0J)
          (apply_fun xs 0) Hx0_in_Ga0).
    }
    claim Hwp2 : word_product multG eG xs2 2 = apply_fun multG (apply_fun xs m, apply_fun xs 0).
    {
      exact (word_product_two_graph_group
        G multG eG invG (apply_fun xs m) (apply_fun xs 0)
        Hgrp
        (subgroup_of_subset (apply_fun Gfam alpha0) G multG eG invG (Hsubfam alpha0 Halpha0J)
          (apply_fun xs m) Hxm_in_Ga0)
        (subgroup_of_subset (apply_fun Gfam alpha0) G multG eG invG (Hsubfam alpha0 Halpha0J)
          (apply_fun xs 0) Hx0_in_Ga0)).
    }
    claim Hwp2_e : word_product multG eG xs2 2 = eG.
    { rewrite Hwp2. rewrite <- Hp_e. reflexivity. }
    claim Htmp : apply_fun xs2 1 = apply_fun invG (apply_fun xs2 0).
    { exact (word_product_two_eq_inv G multG eG invG xs2 Hgrp Hxs2_G Hwp2_e). }
    claim Hxs20 : apply_fun xs2 0 = apply_fun xs m.
    {
      rewrite (apply_fun_graph 2 (fun t:set => If_i (t = 0) (apply_fun xs m) (apply_fun xs 0)) 0 In_0_2).
      rewrite (If_i_1 (0 = 0) (apply_fun xs m) (apply_fun xs 0) (eq_refl 0)).
      reflexivity.
    }
    claim Hxs21 : apply_fun xs2 1 = apply_fun xs 0.
    {
      rewrite (apply_fun_graph 2 (fun t:set => If_i (t = 0) (apply_fun xs m) (apply_fun xs 0)) 1 In_1_2).
      rewrite (If_i_0 (1 = 0) (apply_fun xs m) (apply_fun xs 0) neq_1_0).
      reflexivity.
    }
    claim Hinv_congr : apply_fun invG (apply_fun xs2 0) = apply_fun invG (apply_fun xs m).
    { exact (apply_fun_congr_arg invG (apply_fun xs2 0) (apply_fun xs m) Hxs20). }
    exact (eq_i_tra
      (apply_fun xs 0)
      (apply_fun xs2 1)
      (apply_fun invG (apply_fun xs m))
      (eq_symm (apply_fun xs2 1) (apply_fun xs 0) Hxs21)
      (eq_i_tra
        (apply_fun xs2 1)
        (apply_fun invG (apply_fun xs2 0))
        (apply_fun invG (apply_fun xs m))
        Htmp
        Hinv_congr)).
  }

  (** Reduce the boundary-cancellation branch to a shorter involutive word (the "middle"). **)
  (** Step 1: build the middle reduced word xs_mid representing x1 ... x_{m-1}. **)
  apply (nat_inv m Hm_nat).
  - assume Hm0 : m = 0. exact (FalseE (Hm_ne0 Hm0) False).
  - assume Hex_k : exists k:set, nat_p k /\ m = ordsucc k.
    apply Hex_k. let k. assume Hk_pack : nat_p k /\ m = ordsucc k.
    claim Hk_nat : nat_p k. { exact (andEL (nat_p k) (m = ordsucc k) Hk_pack). }
    claim Hm_eq_sk : m = ordsucc k. { exact (andER (nat_p k) (m = ordsucc k) Hk_pack). }
    claim Hk_ne0 : k <> 0.
    {
      assume Hk0.
      claim Hm1 : m = 1.
      { rewrite Hm_eq_sk. rewrite Hk0. exact ordsucc_0_eq_1_nat. }
      exact (Hm_ne1 Hm1).
    }
    claim Hred_sm : reduced_word J Gfam efam (ordsucc m) xs.
    { rewrite <- Hn_sm. exact Hred. }
    set xs_suf := graph m (fun i:set => apply_fun xs (ordsucc i)).
    claim Hred_suf : reduced_word J Gfam efam m xs_suf.
    { exact (reduced_word_suffix J Gfam efam m xs Hred_sm). }
    set xs_mid := graph k (fun i:set => apply_fun xs_suf i).
    claim Hk_in_m : k :e m.
    { rewrite Hm_eq_sk. exact (ordsuccI2 k). }
    claim Hred_mid : reduced_word J Gfam efam k xs_mid.
    {
      exact (reduced_word_prefix J Gfam efam m xs_suf k Hred_suf Hk_in_m).
    }
    set u := word_product multG eG xs_mid k.
    (** Step 2: express w = mult(x0, mult(u, inv x0)) using x_m = inv x0. **)
    (** TODO: finish the computation and cancellation to conclude u is an involution. **)
    exact (free_product_boundary_product_ne_e_helper
      G multG eG invG J Gfam efam al n xs m alpha0
      Hfp Hal Hefam_Gal Hefam_ne Hefam_invol
      Hred Hn_sm Hm_nat Hm_ne0
      Halpha0J Hx0_in_Ga0 Hx0_ne_eG Hx0_ne_ef0
      Hxm_in_Ga0 Hxm_ne_eG Hxm_ne_ef0
      Halpha0_ne Hwp
      Hp_e).

- (** p <> efam(alpha0) **)
  assume Hp_ef0 : p = apply_fun efam alpha0.
  (** Note: p lies in the factor subgroup Gfam(alpha0) by closure. **)
  claim Hp_in_Ga0 : p :e apply_fun Gfam alpha0.
  {
    exact (subgroup_of_mult_closed
      (apply_fun Gfam alpha0) G multG eG invG
      (apply_fun xs m) (apply_fun xs 0)
      (Hsubfam alpha0 Halpha0J)
      Hxm_in_Ga0
      Hx0_in_Ga0).
  }
  (** TODO: the remaining contradiction is part of the same torsion/malnormality analysis. **)
  exact (free_product_boundary_product_ne_efam_helper
    G multG eG invG J Gfam efam al n xs m alpha0
    Hfp Hal Hefam_Gal Hefam_ne Hefam_invol
    Hred Hn_sm Hm_nat Hm_ne0
    Halpha0J Hx0_in_Ga0 Hx0_ne_eG Hx0_ne_ef0
    Hxm_in_Ga0 Hxm_ne_eG Hxm_ne_ef0
    Halpha0_ne Hwp
    Hp_ef0).
Qed.

(** Infrastructure: involutive efam(al) cannot be nontrivial in its subgroup in a free product **)
(** This isolates the remaining "order 2" subcase in efam_not_in_Gfam_nontrivial. **)
(** Collected Alice 97 **)
(** Proven Alice **)
Lemma free_product_efam_involutive_contra : forall G multG eG invG J Gfam efam al:set,
  free_product_of_subgroups G multG eG invG J Gfam efam ->
  al :e J ->
  apply_fun efam al :e apply_fun Gfam al ->
  apply_fun efam al <> eG ->
  apply_fun invG (apply_fun efam al) = apply_fun efam al ->
  False.
let G multG eG invG J Gfam efam al.
assume Hfp Hal Hefam_Gal Hefam_ne Hinv_eq.

(** Extract core free product structure. **)
apply (and6E
  (group_structure G multG eG invG)
  (forall alpha:set, alpha :e J -> subgroup_of (apply_fun Gfam alpha) G multG eG invG)
  (forall alpha beta:set, alpha :e J -> beta :e J -> alpha <> beta ->
    forall x:set, x :e apply_fun Gfam alpha -> x :e apply_fun Gfam beta -> x = eG)
  (subgroups_generate G multG eG invG J Gfam)
  (forall x:set, x :e G -> x <> eG ->
    exists n xs:set,
      reduced_word J Gfam efam n xs /\ n <> 0 /\
      word_product multG eG xs n = x /\
      (forall n' xs':set,
        reduced_word J Gfam efam n' xs' -> n' <> 0 ->
        word_product multG eG xs' n' = x ->
        n = n' /\ (forall i:set, i :e n -> apply_fun xs i = apply_fun xs' i)))
  (forall alpha:set, alpha :e J -> apply_fun efam alpha = eG)
  Hfp).
assume Hgrp Hsubfam Hdisjoint _ Huniq _.

(** efam(al) is a group element. **)
claim Hefam_G : apply_fun efam al :e G.
{ exact (subgroup_of_subset (apply_fun Gfam al) G multG eG invG (Hsubfam al Hal)
    (apply_fun efam al) Hefam_Gal). }

(** Involutive assumption: efam(al)^2 = eG. **)
claim Hefam_sq : apply_fun multG (apply_fun efam al, apply_fun efam al) = eG.
{
  apply (and6E
    (function_on multG (setprod G G) G)
    (function_on invG G G)
    (eG :e G)
    (forall x y z:set, x :e G -> y :e G -> z :e G ->
      apply_fun multG (apply_fun multG (x, y), z) = apply_fun multG (x, apply_fun multG (y, z)))
    (forall x:set, x :e G -> apply_fun multG (eG, x) = x /\ apply_fun multG (x, eG) = x)
    (forall x:set, x :e G ->
      apply_fun multG (x, apply_fun invG x) = eG /\ apply_fun multG (apply_fun invG x, x) = eG)
    Hgrp).
  assume _ _ _ _ _ HinvLaw.
  claim Hrinv : apply_fun multG (apply_fun efam al, apply_fun invG (apply_fun efam al)) = eG.
  { exact (andEL
      (apply_fun multG (apply_fun efam al, apply_fun invG (apply_fun efam al)) = eG)
      (apply_fun multG (apply_fun invG (apply_fun efam al), apply_fun efam al) = eG)
      (HinvLaw (apply_fun efam al) Hefam_G)). }
  rewrite <- Hinv_eq at 2.
  exact Hrinv.
}

(** Obtain the unique reduced word for efam(al). **)
apply (Huniq (apply_fun efam al) Hefam_G Hefam_ne).
let n. assume Hex : exists xs:set,
  reduced_word J Gfam efam n xs /\ n <> 0 /\
  word_product multG eG xs n = apply_fun efam al /\
  (forall n' xs':set, reduced_word J Gfam efam n' xs' -> n' <> 0 ->
    word_product multG eG xs' n' = apply_fun efam al ->
    n = n' /\ (forall i:set, i :e n -> apply_fun xs i = apply_fun xs' i)).
apply Hex. let xs.
assume Hpack : reduced_word J Gfam efam n xs /\ n <> 0 /\
  word_product multG eG xs n = apply_fun efam al /\
  (forall n' xs':set, reduced_word J Gfam efam n' xs' -> n' <> 0 ->
    word_product multG eG xs' n' = apply_fun efam al ->
    n = n' /\ (forall i:set, i :e n -> apply_fun xs i = apply_fun xs' i)).
apply (and4E
  (reduced_word J Gfam efam n xs)
  (n <> 0)
  (word_product multG eG xs n = apply_fun efam al)
  (forall n' xs':set, reduced_word J Gfam efam n' xs' -> n' <> 0 ->
    word_product multG eG xs' n' = apply_fun efam al ->
    n = n' /\ (forall i:set, i :e n -> apply_fun xs i = apply_fun xs' i))
  Hpack).
assume Hred Hn_ne0 Hwp Huniq_full.

(** Quick contradiction if the unique reduced word has length 1. **)
claim HnO : n :e omega.
{
  apply (and3E
    (n :e omega)
    (forall i:set, i :e n ->
      exists alpha:set, alpha :e J /\
        apply_fun xs i :e apply_fun Gfam alpha /\
        apply_fun xs i <> apply_fun efam alpha)
    (forall i:set, i :e n -> ordsucc i :e n ->
      forall alpha beta:set, alpha :e J -> beta :e J ->
        apply_fun xs i :e apply_fun Gfam alpha ->
        apply_fun xs (ordsucc i) :e apply_fun Gfam beta ->
        alpha <> beta)
    Hred).
  assume HnO0 _ _. exact HnO0.
}
claim Hn_nat : nat_p n. { exact (omega_nat_p n HnO). }
apply (nat_inv n Hn_nat).
- assume Hn0 : n = 0. exact (FalseE (Hn_ne0 Hn0) False).
- assume Hex_m : exists m:set, nat_p m /\ n = ordsucc m.
  apply Hex_m. let m. assume Hm_pack : nat_p m /\ n = ordsucc m.
  claim Hm_nat : nat_p m. { exact (andEL (nat_p m) (n = ordsucc m) Hm_pack). }
  claim Hn_sm : n = ordsucc m. { exact (andER (nat_p m) (n = ordsucc m) Hm_pack). }
  apply (xm (m = 0)).
  * assume Hm0 : m = 0.
    claim Hn1 : n = 1.
    { rewrite Hn_sm. rewrite Hm0. exact ordsucc_0_eq_1_nat. }
    claim H0in : 0 :e n.
    { rewrite Hn1. exact (ordsuccI2 0). }
    (** reduced_word element data at index 0 **)
    apply (reduced_word_elem J Gfam efam n xs 0 Hred H0in). let beta.
    assume Hbeta_pack : beta :e J /\ apply_fun xs 0 :e apply_fun Gfam beta /\ apply_fun xs 0 <> apply_fun efam beta.
    apply (and3E (beta :e J) (apply_fun xs 0 :e apply_fun Gfam beta) (apply_fun xs 0 <> apply_fun efam beta) Hbeta_pack).
    assume HbJ Hxs0_Gb Hxs0_ne_efb.
    (** compute word_product for n=1: equals xs(0) **)
    claim Hwp1 : word_product multG eG xs n = apply_fun xs 0.
    {
      rewrite Hn1.
      claim Hwp_succ : word_product multG eG xs 1 =
        apply_fun multG (word_product multG eG xs 0, apply_fun xs 0).
      { exact (word_product_succ multG eG xs 0 nat_0). }
      claim Hwp0 : word_product multG eG xs 0 = eG.
      { exact (nat_primrec_0 eG (fun i r => apply_fun multG (r, apply_fun xs i))). }
      claim HidL : apply_fun multG (eG, apply_fun xs 0) = apply_fun xs 0.
      {
        apply (and6E
          (function_on multG (setprod G G) G)
          (function_on invG G G)
          (eG :e G)
          (forall x y z:set, x :e G -> y :e G -> z :e G ->
            apply_fun multG (apply_fun multG (x, y), z) = apply_fun multG (x, apply_fun multG (y, z)))
          (forall x:set, x :e G -> apply_fun multG (eG, x) = x /\ apply_fun multG (x, eG) = x)
          (forall x:set, x :e G ->
            apply_fun multG (x, apply_fun invG x) = eG /\ apply_fun multG (apply_fun invG x, x) = eG)
          Hgrp).
        assume _ _ _ _ Hid _.
        exact (andEL
          (apply_fun multG (eG, apply_fun xs 0) = apply_fun xs 0)
          (apply_fun multG (apply_fun xs 0, eG) = apply_fun xs 0)
          (Hid (apply_fun xs 0)
            (subgroup_of_subset (apply_fun Gfam beta) G multG eG invG (Hsubfam beta HbJ)
              (apply_fun xs 0) Hxs0_Gb))).
      }
      rewrite Hwp_succ. rewrite Hwp0. exact HidL.
    }
    (** so xs(0) = efam(al) **)
    claim Hxs0_eq : apply_fun xs 0 = apply_fun efam al.
    { rewrite <- Hwp1. exact (eq_i_tra (word_product multG eG xs n) (apply_fun efam al) (apply_fun efam al)
        Hwp (eq_refl (apply_fun efam al))). }
    (** If beta = al then reduced_word forbids xs(0)=efam(al). If beta != al, disjointness forces efam(al)=eG. **)
    apply (xm (beta = al)).
    + assume Hb_eq : beta = al.
      claim Hxs0_eq2 : apply_fun xs 0 = apply_fun efam beta.
      { rewrite Hb_eq. exact Hxs0_eq. }
      exact (Hxs0_ne_efb Hxs0_eq2).
    + assume Hb_ne : beta <> al.
      claim Hefam_in_Gb : apply_fun efam al :e apply_fun Gfam beta.
      { rewrite <- Hxs0_eq. exact Hxs0_Gb. }
      claim Hefam_eG : apply_fun efam al = eG.
      { exact (Hdisjoint beta al HbJ Hal Hb_ne (apply_fun efam al) Hefam_in_Gb Hefam_Gal). }
      exact (Hefam_ne Hefam_eG).
	  * assume Hm_ne0.
	    (** Remaining case: n >= 2. Start by handling the easy subcase xs(0) = eG. **)
	    claim Hred_sm : reduced_word J Gfam efam (ordsucc m) xs.
	    { rewrite <- Hn_sm. exact Hred. }
	    set xs_suf := graph m (fun i:set => apply_fun xs (ordsucc i)).
	    claim Hred_suf : reduced_word J Gfam efam m xs_suf.
	    { exact (reduced_word_suffix J Gfam efam m xs Hred_sm). }
	    claim Hxs_in_G : forall i:set, i :e ordsucc m -> apply_fun xs i :e G.
	    {
	      exact (reduced_word_in_G G multG eG invG J Gfam efam (ordsucc m) xs
	        Hsubfam Hred_sm).
	    }
	    claim Hwp_suf_G : word_product multG eG xs_suf m :e G.
	    {
	      apply (word_product_in_G_group G multG eG invG m xs_suf Hgrp Hm_nat).
	      let i. assume Hi.
	      rewrite (apply_fun_graph m (fun t:set => apply_fun xs (ordsucc t)) i Hi).
	      exact (Hxs_in_G (ordsucc i)
	        (nat_ordsucc_in_ordsucc m Hm_nat i Hi)).
	    }
	    claim Hwp_shift : word_product multG eG xs (ordsucc m) =
	      apply_fun multG (apply_fun xs 0, word_product multG eG xs_suf m).
	    { exact (word_product_shift_first G multG eG invG m xs Hgrp Hm_nat Hxs_in_G m Hm_nat (ordsuccI2 m)). }
	    apply (xm (apply_fun xs 0 = eG)).
	    + assume Hxs0_eG : apply_fun xs 0 = eG.
	      (** If xs(0)=eG then the suffix word is a reduced word for efam(al), contradicting uniqueness. **)
	      claim Hwp_suf : word_product multG eG xs_suf m = apply_fun efam al.
	      {
	        claim Hwp_full : word_product multG eG xs (ordsucc m) = apply_fun efam al.
	        { rewrite <- Hn_sm. exact Hwp. }
	        apply (and6E
	          (function_on multG (setprod G G) G)
	          (function_on invG G G)
	          (eG :e G)
	          (forall x y z:set, x :e G -> y :e G -> z :e G ->
	            apply_fun multG (apply_fun multG (x, y), z) = apply_fun multG (x, apply_fun multG (y, z)))
	          (forall x:set, x :e G -> apply_fun multG (eG, x) = x /\ apply_fun multG (x, eG) = x)
	          (forall x:set, x :e G ->
	            apply_fun multG (x, apply_fun invG x) = eG /\ apply_fun multG (apply_fun invG x, x) = eG)
	          Hgrp).
	        assume _ _ _ _ HidG _.
	        claim Hxs0_G : apply_fun xs 0 :e G.
	        { exact (Hxs_in_G 0 (nat_0_in_ordsucc m Hm_nat)). }
	        claim HidL_suf : apply_fun multG (apply_fun xs 0, word_product multG eG xs_suf m) =
	          word_product multG eG xs_suf m.
	        {
	          rewrite Hxs0_eG.
	          exact (andEL
	            (apply_fun multG (eG, word_product multG eG xs_suf m) = word_product multG eG xs_suf m)
	            (apply_fun multG (word_product multG eG xs_suf m, eG) = word_product multG eG xs_suf m)
	            (HidG (word_product multG eG xs_suf m) Hwp_suf_G)).
	        }
	        claim Hlhs : word_product multG eG xs (ordsucc m) = word_product multG eG xs_suf m.
	        { rewrite Hwp_shift. exact HidL_suf. }
	        exact (eq_i_tra
	          (word_product multG eG xs_suf m)
	          (word_product multG eG xs (ordsucc m))
	          (apply_fun efam al)
	          (eq_symm (word_product multG eG xs (ordsucc m)) (word_product multG eG xs_suf m) Hlhs)
	          Hwp_full).
	      }
	      claim Hn_eq_m : n = m.
	      { exact (andEL (n = m) (forall i:set, i :e n -> apply_fun xs i = apply_fun xs_suf i)
	          (Huniq_full m xs_suf Hred_suf Hm_ne0 Hwp_suf)). }
	      claim Hsm_m : ordsucc m = m.
	      { exact (eq_i_tra (ordsucc m) n m (eq_symm n (ordsucc m) Hn_sm) Hn_eq_m). }
	      claim Hm_in_sm : m :e ordsucc m. { exact (ordsuccI2 m). }
	      claim Hm_in_m : m :e m. { exact (eq_subst_mem_set m (ordsucc m) m Hm_in_sm Hsm_m). }
	      exact (In_irref m Hm_in_m).
		    + assume Hxs0_ne_eG : apply_fun xs 0 <> eG.
		      (** Hard subcase: xs(0) != eG. Not yet completed. **)
		      (** We at least record the key algebraic consequence of involution. **)
		      set w := apply_fun efam al.
		      claim Hwp_full : word_product multG eG xs (ordsucc m) = w.
		      { rewrite <- Hn_sm. exact Hwp. }
			      claim Hwp_suf_cancel :
			        word_product multG eG xs_suf m =
			          apply_fun multG (apply_fun invG (apply_fun xs 0), w).
			      {
			        claim Htmp :
			          word_product multG eG xs_suf m =
			            apply_fun multG (apply_fun invG (apply_fun xs 0), word_product multG eG xs (ordsucc m)).
			        { exact (word_product_suffix_by_cancel G multG eG invG m xs Hgrp Hm_nat Hxs_in_G). }
			        claim Htmp2 :
			          apply_fun multG (apply_fun invG (apply_fun xs 0), word_product multG eG xs (ordsucc m)) =
			            apply_fun multG (apply_fun invG (apply_fun xs 0), w).
			        { rewrite Hwp_full. reflexivity. }
			        exact (eq_i_tra
			          (word_product multG eG xs_suf m)
			          (apply_fun multG (apply_fun invG (apply_fun xs 0), word_product multG eG xs (ordsucc m)))
			          (apply_fun multG (apply_fun invG (apply_fun xs 0), w))
			          Htmp
			          Htmp2).
			      }
		      claim Hinv_xs0_eq :
		        apply_fun invG (apply_fun xs 0) =
		          apply_fun multG (word_product multG eG xs_suf m, w).
		      {
		        apply (and6E
		          (function_on multG (setprod G G) G)
		          (function_on invG G G)
		          (eG :e G)
		          (forall x y z:set, x :e G -> y :e G -> z :e G ->
		            apply_fun multG (apply_fun multG (x, y), z) = apply_fun multG (x, apply_fun multG (y, z)))
		          (forall x:set, x :e G -> apply_fun multG (eG, x) = x /\ apply_fun multG (x, eG) = x)
		          (forall x:set, x :e G ->
		            apply_fun multG (x, apply_fun invG x) = eG /\ apply_fun multG (apply_fun invG x, x) = eG)
		          Hgrp).
		        assume HmultFn HinvFn HeG HassocG HidG _.
		        claim Hx0_G : apply_fun xs 0 :e G.
		        { exact (Hxs_in_G 0 (nat_0_in_ordsucc m Hm_nat)). }
		        claim Hinv_x0_G : apply_fun invG (apply_fun xs 0) :e G.
		        { exact (HinvFn (apply_fun xs 0) Hx0_G). }
		        claim Hwp_suf_G2 : word_product multG eG xs_suf m :e G.
		        { exact Hwp_suf_G. }
			        claim Hw_G : w :e G. { exact Hefam_G. }
			        claim Hww_e : apply_fun multG (w, w) = eG.
			        { exact Hefam_sq. }
		        (** Multiply Hwp_suf_cancel on the right by w and simplify using multG(w,w)=eG. **)
		        claim Hstep1 :
		          apply_fun multG (word_product multG eG xs_suf m, w) =
		            apply_fun multG (apply_fun multG (apply_fun invG (apply_fun xs 0), w), w).
		        {
		          rewrite Hwp_suf_cancel.
		          reflexivity.
		        }
		        claim Hstep2 :
		          apply_fun multG (apply_fun multG (apply_fun invG (apply_fun xs 0), w), w) =
		            apply_fun multG (apply_fun invG (apply_fun xs 0), apply_fun multG (w, w)).
		        {
		          exact (HassocG
		            (apply_fun invG (apply_fun xs 0))
		            w
		            w
		            Hinv_x0_G
		            Hw_G
		            Hw_G).
		        }
		        claim Hstep3 :
		          apply_fun multG (apply_fun invG (apply_fun xs 0), apply_fun multG (w, w)) =
		            apply_fun multG (apply_fun invG (apply_fun xs 0), eG).
		        { rewrite Hww_e. reflexivity. }
		        claim HidR_invx0 : apply_fun multG (apply_fun invG (apply_fun xs 0), eG) =
		          apply_fun invG (apply_fun xs 0).
		        {
		          exact (andER
		            (apply_fun multG (eG, apply_fun invG (apply_fun xs 0)) = apply_fun invG (apply_fun xs 0))
		            (apply_fun multG (apply_fun invG (apply_fun xs 0), eG) = apply_fun invG (apply_fun xs 0))
		            (HidG (apply_fun invG (apply_fun xs 0)) Hinv_x0_G)).
		        }
		        claim Hlhs :
		          apply_fun multG (word_product multG eG xs_suf m, w) =
		            apply_fun invG (apply_fun xs 0).
		        {
		          exact (eq_i_tra
		            (apply_fun multG (word_product multG eG xs_suf m, w))
		            (apply_fun multG (apply_fun multG (apply_fun invG (apply_fun xs 0), w), w))
		            (apply_fun invG (apply_fun xs 0))
		            Hstep1
		            (eq_i_tra
		              (apply_fun multG (apply_fun multG (apply_fun invG (apply_fun xs 0), w), w))
		              (apply_fun multG (apply_fun invG (apply_fun xs 0), apply_fun multG (w, w)))
		              (apply_fun invG (apply_fun xs 0))
		              Hstep2
		              (eq_i_tra
		                (apply_fun multG (apply_fun invG (apply_fun xs 0), apply_fun multG (w, w)))
		                (apply_fun multG (apply_fun invG (apply_fun xs 0), eG))
		                (apply_fun invG (apply_fun xs 0))
		                Hstep3
		                HidR_invx0))).
		        }
			        symmetry.
			        exact Hlhs.
			      }
			      (** If the first letter xs(0) lies in Gfam(al), then the suffix product has a singleton reduced word,
			         forcing xs(1) to lie in Gfam(al), contradicting adjacency. **)
			      claim H0_in_n : 0 :e ordsucc m.
			      { exact (nat_0_in_ordsucc m Hm_nat). }
			      apply (reduced_word_elem J Gfam efam (ordsucc m) xs 0 Hred_sm H0_in_n). let alpha0.
			      assume Halpha0_pack :
			        alpha0 :e J /\ apply_fun xs 0 :e apply_fun Gfam alpha0 /\ apply_fun xs 0 <> apply_fun efam alpha0.
			      apply (and3E
			        (alpha0 :e J)
			        (apply_fun xs 0 :e apply_fun Gfam alpha0)
			        (apply_fun xs 0 <> apply_fun efam alpha0)
			        Halpha0_pack).
			      assume Halpha0J Hx0_in_Ga0 Hx0_ne_ef0.
			      apply (xm (alpha0 = al)).
			      + assume Halpha0_eq : alpha0 = al.
			        set x0 := apply_fun xs 0.
			        set wp_suf := word_product multG eG xs_suf m.
			        claim Hx0_in_Gal : x0 :e apply_fun Gfam al.
			        { rewrite <- Halpha0_eq. exact Hx0_in_Ga0. }
			        apply (and4E
			          (apply_fun Gfam al c= G)
			          (eG :e apply_fun Gfam al)
			          (forall x y:set, x :e apply_fun Gfam al -> y :e apply_fun Gfam al ->
			            apply_fun multG (x, y) :e apply_fun Gfam al)
			          (forall x:set, x :e apply_fun Gfam al -> apply_fun invG x :e apply_fun Gfam al)
			          (Hsubfam al Hal)).
			        assume _ _ Hmult_al Hinv_al.
			        claim Hinvx0_in_Gal : apply_fun invG x0 :e apply_fun Gfam al.
			        { exact (Hinv_al x0 Hx0_in_Gal). }
			        claim Hwp_suf_in_Gal : wp_suf :e apply_fun Gfam al.
			        {
			          rewrite Hwp_suf_cancel.
			          exact (Hmult_al (apply_fun invG x0) w Hinvx0_in_Gal Hefam_Gal).
			        }
			        claim Hwp_suf_ne_eG : wp_suf <> eG.
			        {
			          assume Habs : wp_suf = eG.
			          claim Hw_eq : w = apply_fun multG (x0, wp_suf).
			          { rewrite <- Hwp_full. rewrite Hwp_shift. reflexivity. }
			          apply (and6E
			            (function_on multG (setprod G G) G)
			            (function_on invG G G)
			            (eG :e G)
			            (forall a b c:set, a :e G -> b :e G -> c :e G ->
			              apply_fun multG (apply_fun multG (a, b), c) = apply_fun multG (a, apply_fun multG (b, c)))
			            (forall a:set, a :e G -> apply_fun multG (eG, a) = a /\ apply_fun multG (a, eG) = a)
			            (forall a:set, a :e G ->
			              apply_fun multG (a, apply_fun invG a) = eG /\ apply_fun multG (apply_fun invG a, a) = eG)
			            Hgrp).
			          assume _ _ _ _ HidG _.
			          claim Hx0_G : x0 :e G. { exact (Hxs_in_G 0 H0_in_n). }
			          claim HidR_x0 : apply_fun multG (x0, eG) = x0.
			          { exact (andER
			              (apply_fun multG (eG, x0) = x0)
			              (apply_fun multG (x0, eG) = x0)
			              (HidG x0 Hx0_G)). }
				          claim Hmul_congr : apply_fun multG (x0, wp_suf) = apply_fun multG (x0, eG).
				          { rewrite Habs. reflexivity. }
				          claim Hw_eq2 : w = apply_fun multG (x0, eG).
				          { exact (eq_i_tra
				              w
				              (apply_fun multG (x0, wp_suf))
				              (apply_fun multG (x0, eG))
				              Hw_eq
				              Hmul_congr). }
			          claim Hx0_eq_w : x0 = w.
			          { symmetry. exact (eq_i_tra w (apply_fun multG (x0, eG)) x0 Hw_eq2 HidR_x0). }
			          claim Hx0_ne_w : x0 <> w.
			          { rewrite <- Halpha0_eq. exact Hx0_ne_ef0. }
			          exact (Hx0_ne_w Hx0_eq_w).
			        }
			        claim Hwp_suf_ne_w : wp_suf <> w.
			        {
			          assume Habs : wp_suf = w.
			          apply (and6E
			            (function_on multG (setprod G G) G)
			            (function_on invG G G)
			            (eG :e G)
			            (forall a b c:set, a :e G -> b :e G -> c :e G ->
			              apply_fun multG (apply_fun multG (a, b), c) = apply_fun multG (a, apply_fun multG (b, c)))
			            (forall a:set, a :e G -> apply_fun multG (eG, a) = a /\ apply_fun multG (a, eG) = a)
			            (forall a:set, a :e G ->
			              apply_fun multG (a, apply_fun invG a) = eG /\ apply_fun multG (apply_fun invG a, a) = eG)
			            Hgrp).
			          assume _ HinvFn HeGG _ HidG HinvLaw.
			          claim Hx0_G : x0 :e G. { exact (Hxs_in_G 0 H0_in_n). }
			          claim Hinvx0_G : apply_fun invG x0 :e G. { exact (HinvFn x0 Hx0_G). }
			          claim He_mul_w : apply_fun multG (eG, w) = w.
			          { exact (andEL
			              (apply_fun multG (eG, w) = w)
			              (apply_fun multG (w, eG) = w)
			              (HidG w Hefam_G)). }
					          claim Hw_eq3 : w = apply_fun multG (apply_fun invG x0, w).
					          { exact (eq_i_tra
					              w
					              wp_suf
					              (apply_fun multG (apply_fun invG x0, w))
					              (eq_symm wp_suf w Habs)
					              Hwp_suf_cancel). }
			          claim Hlhs : apply_fun multG (apply_fun invG x0, w) = w.
			          { exact (eq_symm w (apply_fun multG (apply_fun invG x0, w)) Hw_eq3). }
			          claim Heq : apply_fun multG (apply_fun invG x0, w) = apply_fun multG (eG, w).
			          { exact (eq_i_tra
			              (apply_fun multG (apply_fun invG x0, w))
			              w
			              (apply_fun multG (eG, w))
			              Hlhs
			              (eq_symm (apply_fun multG (eG, w)) w He_mul_w)). }
			          claim Hinvx0_eq_eG : apply_fun invG x0 = eG.
			          { exact (group_right_cancel G multG eG invG w (apply_fun invG x0) eG
			              Hgrp Hefam_G Hinvx0_G HeGG Heq). }
			          (** x0 = eG, contradiction with the hard subcase. **)
			          claim Hx0_invx0 : apply_fun multG (x0, apply_fun invG x0) = eG.
			          { exact (andEL
			              (apply_fun multG (x0, apply_fun invG x0) = eG)
			              (apply_fun multG (apply_fun invG x0, x0) = eG)
			              (HinvLaw x0 Hx0_G)). }
			          claim HidR_x0 : apply_fun multG (x0, eG) = x0.
			          { exact (andER
			              (apply_fun multG (eG, x0) = x0)
			              (apply_fun multG (x0, eG) = x0)
			              (HidG x0 Hx0_G)). }
			          claim Hx0_eq_eG : x0 = eG.
			          {
			            claim Heq2 : apply_fun multG (x0, apply_fun invG x0) = apply_fun multG (x0, eG).
			            { rewrite Hinvx0_eq_eG. reflexivity. }
			            exact (eq_i_tra
			              x0
			              (apply_fun multG (x0, eG))
			              eG
			              (eq_symm (apply_fun multG (x0, eG)) x0 HidR_x0)
			              (eq_i_tra
			                (apply_fun multG (x0, eG))
			                (apply_fun multG (x0, apply_fun invG x0))
			                eG
			                (eq_symm (apply_fun multG (x0, apply_fun invG x0)) (apply_fun multG (x0, eG)) Heq2)
			                Hx0_invx0)).
			          }
				          exact (Hxs0_ne_eG Hx0_eq_eG).
			        }
			        (** Now compare the reduced word xs_suf of length m with the singleton reduced word for wp_suf. **)
			        apply (Huniq wp_suf Hwp_suf_G Hwp_suf_ne_eG).
			        let ns. assume Hexs : exists ys:set,
			          reduced_word J Gfam efam ns ys /\ ns <> 0 /\
			          word_product multG eG ys ns = wp_suf /\
			          (forall n' ys':set, reduced_word J Gfam efam n' ys' -> n' <> 0 ->
			            word_product multG eG ys' n' = wp_suf ->
			            ns = n' /\ (forall i:set, i :e ns -> apply_fun ys i = apply_fun ys' i)).
			        apply Hexs. let ys.
			        assume Hys_pack : reduced_word J Gfam efam ns ys /\ ns <> 0 /\
			          word_product multG eG ys ns = wp_suf /\
			          (forall n' ys':set, reduced_word J Gfam efam n' ys' -> n' <> 0 ->
			            word_product multG eG ys' n' = wp_suf ->
			            ns = n' /\ (forall i:set, i :e ns -> apply_fun ys i = apply_fun ys' i)).
			        apply (and4E
			          (reduced_word J Gfam efam ns ys)
			          (ns <> 0)
			          (word_product multG eG ys ns = wp_suf)
			          (forall n' ys':set, reduced_word J Gfam efam n' ys' -> n' <> 0 ->
			            word_product multG eG ys' n' = wp_suf ->
			            ns = n' /\ (forall i:set, i :e ns -> apply_fun ys i = apply_fun ys' i))
			          Hys_pack).
			        assume Hred_s Hns_ne0 Hwp_s Huniq_s.
			        claim Hns_eq_m : ns = m.
			        { exact (andEL
			            (ns = m)
			            (forall i:set, i :e ns -> apply_fun ys i = apply_fun xs_suf i)
			            (Huniq_s m xs_suf Hred_suf Hm_ne0 (eq_refl wp_suf))). }
			        set wp_word := graph 1 (fun _:set => wp_suf).
			        claim Hwp_word_red : reduced_word J Gfam efam 1 wp_word.
			        { exact (reduced_word_singleton J Gfam efam al wp_suf Hal Hwp_suf_in_Gal Hwp_suf_ne_w). }
			        claim Hwp_word_prod : word_product multG eG wp_word 1 = wp_suf.
			        { exact (word_product_singleton_group G multG eG invG wp_suf Hgrp Hwp_suf_G). }
			        claim Hns_eq_1 : ns = 1.
			        { exact (andEL
			            (ns = 1)
			            (forall i:set, i :e ns -> apply_fun ys i = apply_fun wp_word i)
			            (Huniq_s 1 wp_word Hwp_word_red (neq_ordsucc_0 0) Hwp_word_prod)). }
			        claim Hm_eq_1 : m = 1.
			        { symmetry. exact (eq_i_tra 1 ns m (eq_symm ns 1 Hns_eq_1) Hns_eq_m). }
			        claim H1_in_n : ordsucc 0 :e ordsucc m.
			        { rewrite Hm_eq_1. rewrite ordsucc_1_eq_2_nat. exact In_1_2. }
			        claim Hx1_ne_eG : apply_fun xs (ordsucc 0) <> eG.
			        {
			          claim Hn_ne1 : ordsucc m <> 1.
			          {
			            assume Hn1.
			            claim Hs : ordsucc m = ordsucc 0.
			            { rewrite Hn1. symmetry. exact ordsucc_0_eq_1_nat. }
			            exact (Hm_ne0 (ordsucc_inj m 0 Hs)).
			          }
			          exact (reduced_word_no_eG_all
			            G multG eG invG J Gfam efam (ordsucc m) xs
			            Hgrp Hsubfam Hred_sm (neq_ordsucc_0 m) Hn_ne1 (ordsucc 0) H1_in_n).
			        }
				        (** With ns=1 and ns=m, the unique reduced word for wp_suf forces xs_suf(0) = wp_suf, hence xs(1) = wp_suf. **)
				        claim Hwp_suf_eq_xs1 : wp_suf = apply_fun xs (ordsucc 0).
				        {
				          claim H0_in_ns : 0 :e ns.
				          { rewrite Hns_eq_1. exact (ordsuccI2 0). }
				          claim Huniq_m :
				            ns = m /\ (forall i:set, i :e ns -> apply_fun ys i = apply_fun xs_suf i).
				          { exact (Huniq_s m xs_suf Hred_suf Hm_ne0 (eq_refl wp_suf)). }
				          claim Huniq_1 :
				            ns = 1 /\ (forall i:set, i :e ns -> apply_fun ys i = apply_fun wp_word i).
				          { exact (Huniq_s 1 wp_word Hwp_word_red (neq_ordsucc_0 0) Hwp_word_prod). }
				          claim Hys0_eq_suf0 :
				            apply_fun ys 0 = apply_fun xs_suf 0.
				          { exact (andER
				              (ns = m)
				              (forall i:set, i :e ns -> apply_fun ys i = apply_fun xs_suf i)
				              Huniq_m 0 H0_in_ns). }
				          claim Hys0_eq_wp0 :
				            apply_fun ys 0 = apply_fun wp_word 0.
				          { exact (andER
				              (ns = 1)
				              (forall i:set, i :e ns -> apply_fun ys i = apply_fun wp_word i)
				              Huniq_1 0 H0_in_ns). }
				          claim Hwp0 : apply_fun wp_word 0 = wp_suf.
				          { exact (apply_fun_graph 1 (fun _:set => wp_suf) 0 (ordsuccI2 0)). }
				          claim Hxs_suf0_eq_wp : apply_fun xs_suf 0 = wp_suf.
				          {
				            exact (eq_i_tra
				              (apply_fun xs_suf 0)
				              (apply_fun ys 0)
				              wp_suf
				              (eq_symm (apply_fun ys 0) (apply_fun xs_suf 0) Hys0_eq_suf0)
				              (eq_i_tra
				                (apply_fun ys 0)
				                (apply_fun wp_word 0)
				                wp_suf
				                Hys0_eq_wp0
				                Hwp0)).
				          }
				          claim H0_in_m : 0 :e m.
				          { rewrite Hm_eq_1. exact (ordsuccI2 0). }
				          claim Hxs_suf0_eq_xs1 : apply_fun xs_suf 0 = apply_fun xs (ordsucc 0).
				          {
				            rewrite (apply_fun_graph m (fun t:set => apply_fun xs (ordsucc t)) 0 H0_in_m).
				            reflexivity.
				          }
					          exact (eq_i_tra
					            wp_suf
					            (apply_fun xs_suf 0)
					            (apply_fun xs (ordsucc 0))
					            (eq_symm (apply_fun xs_suf 0) wp_suf Hxs_suf0_eq_wp)
					            Hxs_suf0_eq_xs1).
				        }
			        claim Hx1_in_Gal : apply_fun xs (ordsucc 0) :e apply_fun Gfam al.
			        { rewrite <- Hwp_suf_eq_xs1. exact Hwp_suf_in_Gal. }
			        apply (reduced_word_elem J Gfam efam (ordsucc m) xs (ordsucc 0) Hred_sm H1_in_n). let alpha1.
			        assume Halpha1_pack :
			          alpha1 :e J /\ apply_fun xs (ordsucc 0) :e apply_fun Gfam alpha1 /\ apply_fun xs (ordsucc 0) <> apply_fun efam alpha1.
			        apply (and3E
			          (alpha1 :e J)
			          (apply_fun xs (ordsucc 0) :e apply_fun Gfam alpha1)
			          (apply_fun xs (ordsucc 0) <> apply_fun efam alpha1)
			          Halpha1_pack).
			        assume Halpha1J Hx1_in_Ga1 _.
			        claim Halpha1_eq_al : alpha1 = al.
			        { exact (disjoint_subgroups_label_unique
			            G multG eG invG J Gfam alpha1 al (apply_fun xs (ordsucc 0))
			            Hdisjoint Halpha1J Hal Hx1_in_Ga1 Hx1_in_Gal Hx1_ne_eG). }
				        claim Halpha0_ne_alpha1 : alpha0 <> alpha1.
				        {
				          apply (and3E
			            ((ordsucc m) :e omega)
			            (forall i:set, i :e ordsucc m ->
			              exists alpha:set, alpha :e J /\
			                apply_fun xs i :e apply_fun Gfam alpha /\
			                apply_fun xs i <> apply_fun efam alpha)
			            (forall i:set, i :e ordsucc m -> ordsucc i :e ordsucc m ->
				              forall a b:set, a :e J -> b :e J ->
				                apply_fun xs i :e apply_fun Gfam a ->
				                apply_fun xs (ordsucc i) :e apply_fun Gfam b ->
				                a <> b)
						                        Hred_sm).
			          assume _ _ Hadj.
				          exact (Hadj 0 H0_in_n H1_in_n alpha0 alpha1 Halpha0J Halpha1J Hx0_in_Ga0 Hx1_in_Ga1).
				        }
				        claim Halpha0_eq_alpha1 : alpha0 = alpha1.
				        {
				          exact (eq_i_tra
				            alpha0
				            al
				            alpha1
				            Halpha0_eq
				            (eq_symm alpha1 al Halpha1_eq_al)).
				        }
				        exact (Halpha0_ne_alpha1 Halpha0_eq_alpha1).
			      + assume Halpha0_ne : alpha0 <> al.
			        (** Remaining branch: alpha0 <> al. We split on the label of the last letter xs(m). **)
			        claim Hm_in_n : m :e ordsucc m.
			        { exact (ordsuccI2 m). }
			        apply (reduced_word_elem J Gfam efam (ordsucc m) xs m Hred_sm Hm_in_n). let alpha_m.
			        assume Halpha_m_pack :
			          alpha_m :e J /\ apply_fun xs m :e apply_fun Gfam alpha_m /\ apply_fun xs m <> apply_fun efam alpha_m.
			        apply (and3E
			          (alpha_m :e J)
			          (apply_fun xs m :e apply_fun Gfam alpha_m)
			          (apply_fun xs m <> apply_fun efam alpha_m)
			          Halpha_m_pack).
			        assume Halpha_mJ Hxsm_in_Gam Hxsm_ne_efm.
			        apply (xm (alpha_m = al)).
			        - assume Halpha_m_eq : alpha_m = al.
			          set xsm := apply_fun xs m.
				          claim Hxsm_in_Gal : xsm :e apply_fun Gfam al.
				          { rewrite <- Halpha_m_eq. exact Hxsm_in_Gam. }
				          claim Hxsm_ne_w : xsm <> w.
				          {
				            assume Habs : xsm = w.
				            apply Hxsm_ne_efm.
				            rewrite Habs.
				            rewrite Halpha_m_eq.
				            reflexivity.
				          }
			          (** Compute the prefix product wp_pre = word_product xs m and show it lies in Gfam(al). **)
			          set wp_pre := word_product multG eG xs m.
			          claim Hwp_pre_G : wp_pre :e G.
			          {
			            apply (word_product_in_G_group G multG eG invG m xs Hgrp Hm_nat).
			            let i. assume Hi.
			            exact (Hxs_in_G i (ordsuccI1 m i Hi)).
			          }
			          claim Hwp_pre_eq :
			            wp_pre =
			              apply_fun multG (w, apply_fun invG xsm).
			          {
			            claim Htmp :
			              word_product multG eG xs m =
			                apply_fun multG (word_product multG eG xs (ordsucc m), apply_fun invG (apply_fun xs m)).
			            { exact (word_product_prefix_by_cancel G multG eG invG m xs Hgrp Hm_nat Hxs_in_G). }
			            rewrite Htmp.
			            rewrite Hwp_full.
			            reflexivity.
			          }
			          apply (and4E
			            (apply_fun Gfam al c= G)
			            (eG :e apply_fun Gfam al)
			            (forall x y:set, x :e apply_fun Gfam al -> y :e apply_fun Gfam al ->
			              apply_fun multG (x, y) :e apply_fun Gfam al)
			            (forall x:set, x :e apply_fun Gfam al -> apply_fun invG x :e apply_fun Gfam al)
			            (Hsubfam al Hal)).
			          assume _ HeG_in_Gal Hmult_al Hinv_al.
			          claim Hinv_xsm_in_Gal : apply_fun invG xsm :e apply_fun Gfam al.
			          { exact (Hinv_al xsm Hxsm_in_Gal). }
			          claim Hwp_pre_in_Gal : wp_pre :e apply_fun Gfam al.
			          {
			            rewrite Hwp_pre_eq.
			            exact (Hmult_al w (apply_fun invG xsm) Hefam_Gal Hinv_xsm_in_Gal).
			          }
			          claim Hwp_pre_ne_eG : wp_pre <> eG.
			          {
			            assume Habs : wp_pre = eG.
			            claim Hwp_succ :
			              word_product multG eG xs (ordsucc m) =
			                apply_fun multG (word_product multG eG xs m, apply_fun xs m).
			            { exact (word_product_succ multG eG xs m Hm_nat). }
			            claim HidL_xsm : apply_fun multG (eG, xsm) = xsm.
			            {
			              apply (and6E
			                (function_on multG (setprod G G) G)
			                (function_on invG G G)
			                (eG :e G)
			                (forall a b c:set, a :e G -> b :e G -> c :e G ->
			                  apply_fun multG (apply_fun multG (a, b), c) = apply_fun multG (a, apply_fun multG (b, c)))
			                (forall a:set, a :e G -> apply_fun multG (eG, a) = a /\ apply_fun multG (a, eG) = a)
			                (forall a:set, a :e G ->
			                  apply_fun multG (a, apply_fun invG a) = eG /\ apply_fun multG (apply_fun invG a, a) = eG)
			                Hgrp).
			              assume _ _ _ _ HidG _.
			              claim Hxsm_G : xsm :e G.
			              { exact (Hxs_in_G m Hm_in_n). }
			              exact (andEL
			                (apply_fun multG (eG, xsm) = xsm)
			                (apply_fun multG (xsm, eG) = xsm)
			                (HidG xsm Hxsm_G)).
				            }
				            claim Hw_eq_xsm : w = xsm.
				            {
				              rewrite <- Hwp_full.
				              rewrite Hwp_succ.
				              rewrite Habs.
				              exact HidL_xsm.
				            }
				            exact (Hxsm_ne_w (eq_symm w xsm Hw_eq_xsm)).
				          }
			          claim Hwp_pre_ne_w : wp_pre <> w.
			          {
			            assume Habs : wp_pre = w.
			            claim Hwp_succ :
			              word_product multG eG xs (ordsucc m) =
			                apply_fun multG (word_product multG eG xs m, apply_fun xs m).
			            { exact (word_product_succ multG eG xs m Hm_nat). }
			            claim Hxsm_ne_eG : xsm <> eG.
			            {
			              claim Hn_ne1 : ordsucc m <> 1.
			              {
			                assume Hn1.
			                claim Hs : ordsucc m = ordsucc 0.
			                { rewrite Hn1. symmetry. exact ordsucc_0_eq_1_nat. }
			                exact (Hm_ne0 (ordsucc_inj m 0 Hs)).
			              }
			              exact (reduced_word_no_eG_all
			                G multG eG invG J Gfam efam (ordsucc m) xs
			                Hgrp Hsubfam Hred_sm (neq_ordsucc_0 m) Hn_ne1 m Hm_in_n).
			            }
			            apply (and6E
			              (function_on multG (setprod G G) G)
			              (function_on invG G G)
			              (eG :e G)
			              (forall a b c:set, a :e G -> b :e G -> c :e G ->
			                apply_fun multG (apply_fun multG (a, b), c) = apply_fun multG (a, apply_fun multG (b, c)))
			              (forall a:set, a :e G -> apply_fun multG (eG, a) = a /\ apply_fun multG (a, eG) = a)
			              (forall a:set, a :e G ->
			                apply_fun multG (a, apply_fun invG a) = eG /\ apply_fun multG (apply_fun invG a, a) = eG)
			              Hgrp).
			            assume HmultFn HinvFn HeGG _ HidG _.
				            claim Hxsm_G : xsm :e G.
				            { exact (Hxs_in_G m Hm_in_n). }
				            claim Hw_eq_mul : w = apply_fun multG (w, xsm).
				            {
				              claim Hw_eq_wp : w = apply_fun multG (wp_pre, xsm).
				              {
				                claim Htmp :
				                  apply_fun multG (word_product multG eG xs m, apply_fun xs m) =
				                  apply_fun multG (wp_pre, xsm).
				                { reflexivity. }
				                exact (eq_i_tra
				                  w
				                  (word_product multG eG xs (ordsucc m))
				                  (apply_fun multG (wp_pre, xsm))
				                  (eq_symm (word_product multG eG xs (ordsucc m)) w Hwp_full)
				                  (eq_i_tra
				                    (word_product multG eG xs (ordsucc m))
				                    (apply_fun multG (word_product multG eG xs m, apply_fun xs m))
				                    (apply_fun multG (wp_pre, xsm))
				                    Hwp_succ
				                    Htmp)).
				              }
				              claim Hmul_congr : apply_fun multG (wp_pre, xsm) = apply_fun multG (w, xsm).
				              { rewrite Habs. reflexivity. }
				              exact (eq_i_tra
				                w
				                (apply_fun multG (wp_pre, xsm))
				                (apply_fun multG (w, xsm))
				                Hw_eq_wp
				                Hmul_congr).
				            }
			            claim HidR_w : apply_fun multG (w, eG) = w.
			            { exact (andER
			                (apply_fun multG (eG, w) = w)
			                (apply_fun multG (w, eG) = w)
			                (HidG w Hefam_G)). }
			            claim Heq : apply_fun multG (w, xsm) = apply_fun multG (w, eG).
			            { exact (eq_i_tra
			                (apply_fun multG (w, xsm))
			                w
			                (apply_fun multG (w, eG))
			                (eq_symm w (apply_fun multG (w, xsm)) Hw_eq_mul)
			                (eq_symm (apply_fun multG (w, eG)) w HidR_w)). }
			            claim Hxsm_eq_eG : xsm = eG.
			            {
			              exact (group_left_cancel
			                G multG eG invG w xsm eG
			                Hgrp Hefam_G Hxsm_G HeGG Heq).
			            }
			            exact (Hxsm_ne_eG Hxsm_eq_eG).
			          }
			          (** Apply uniqueness for wp_pre and compare with the singleton reduced word in Gfam(al). **)
			          claim Hwp_pre_in_G : wp_pre :e G.
			          { exact (subgroup_of_subset (apply_fun Gfam al) G multG eG invG (Hsubfam al Hal) wp_pre Hwp_pre_in_Gal). }
			          apply (Huniq wp_pre Hwp_pre_in_G Hwp_pre_ne_eG).
			          let np. assume Hnp_ex : exists ys:set,
			            reduced_word J Gfam efam np ys /\ np <> 0 /\
			            word_product multG eG ys np = wp_pre /\
			            (forall n' ys':set,
			              reduced_word J Gfam efam n' ys' -> n' <> 0 ->
			              word_product multG eG ys' n' = wp_pre ->
			              np = n' /\ (forall i:set, i :e np -> apply_fun ys i = apply_fun ys' i)).
			          apply Hnp_ex. let ys.
			          assume Hys_pack : reduced_word J Gfam efam np ys /\ np <> 0 /\
			            word_product multG eG ys np = wp_pre /\
			            (forall n' ys':set,
			              reduced_word J Gfam efam n' ys' -> n' <> 0 ->
			              word_product multG eG ys' n' = wp_pre ->
			              np = n' /\ (forall i:set, i :e np -> apply_fun ys i = apply_fun ys' i)).
			          apply (and4E
			            (reduced_word J Gfam efam np ys)
			            (np <> 0)
			            (word_product multG eG ys np = wp_pre)
			            (forall n' ys':set,
			              reduced_word J Gfam efam n' ys' -> n' <> 0 ->
			              word_product multG eG ys' n' = wp_pre ->
			              np = n' /\ (forall i:set, i :e np -> apply_fun ys i = apply_fun ys' i))
			            Hys_pack).
			          assume Hredp Hnp_ne0 Hwpp Huniqp.
			          set wp_word := graph 1 (fun _:set => wp_pre).
			          claim Hwp_word_red : reduced_word J Gfam efam 1 wp_word.
			          { exact (reduced_word_singleton J Gfam efam al wp_pre Hal Hwp_pre_in_Gal Hwp_pre_ne_w). }
			          claim Hwp_word_prod : word_product multG eG wp_word 1 = wp_pre.
			          {
			            apply (word_product_singleton_group G multG eG invG wp_pre Hgrp Hwp_pre_in_G).
			          }
			          claim Hm_red : reduced_word J Gfam efam m xs.
			          {
			            apply (and3E
			              ((ordsucc m) :e omega)
			              (forall i:set, i :e ordsucc m ->
			                exists alpha:set, alpha :e J /\
			                  apply_fun xs i :e apply_fun Gfam alpha /\
			                  apply_fun xs i <> apply_fun efam alpha)
			              (forall i:set, i :e ordsucc m -> ordsucc i :e ordsucc m ->
			                forall a b:set, a :e J -> b :e J ->
				                  apply_fun xs i :e apply_fun Gfam a ->
				                  apply_fun xs (ordsucc i) :e apply_fun Gfam b ->
				                  a <> b)
						                        Hred_sm).
			            assume HnO Helem Hadj.
			            prove m :e omega /\
			              (forall i:set, i :e m ->
			                exists a:set, a :e J /\
			                  apply_fun xs i :e apply_fun Gfam a /\
			                  apply_fun xs i <> apply_fun efam a) /\
			              (forall i:set, i :e m -> ordsucc i :e m ->
			                forall a b:set, a :e J -> b :e J ->
			                  apply_fun xs i :e apply_fun Gfam a ->
			                  apply_fun xs (ordsucc i) :e apply_fun Gfam b ->
			                  a <> b).
			            apply and3I.
			            - exact (nat_p_omega m Hm_nat).
			            - let i. assume Hi.
			              exact (Helem i (ordsuccI1 m i Hi)).
			            - let i. assume Hi Hsi.
			              let a b. assume HaJ HbJ Hia Hib.
			              exact (Hadj i (ordsuccI1 m i Hi) (ordsuccI1 m (ordsucc i) Hsi) a b HaJ HbJ Hia Hib).
				          }
				          claim Hwp_pre_refl : word_product multG eG xs m = wp_pre.
				          { reflexivity. }
				          claim Hnp_eq_m : np = m.
				          { exact (andEL
				            (np = m)
				            (forall i:set, i :e np -> apply_fun ys i = apply_fun xs i)
				            (Huniqp m xs Hm_red Hm_ne0 Hwp_pre_refl)). }
			          claim Hnp_eq_1 : np = 1.
			          { exact (andEL
			            (np = 1)
			            (forall i:set, i :e np -> apply_fun ys i = apply_fun wp_word i)
			            (Huniqp 1 wp_word Hwp_word_red (neq_ordsucc_0 0) Hwp_word_prod)). }
			          claim Hm_eq_1 : m = 1.
			          { symmetry. exact (eq_i_tra 1 np m (eq_symm np 1 Hnp_eq_1) Hnp_eq_m). }
			          (** From uniqueness, xs(0) = wp_pre, hence xs(0) lies in Gfam(al), contradicting alpha0 <> al. **)
			          claim H0_in_m : 0 :e m.
			          { rewrite Hm_eq_1. exact (ordsuccI2 0). }
			          claim H0_in_np : 0 :e np.
			          { rewrite Hnp_eq_m. exact H0_in_m. }
			          claim Hxs0_eq_wp0 : apply_fun xs 0 = apply_fun wp_word 0.
			          {
				            claim Huniq_m : np = m /\ (forall i:set, i :e np -> apply_fun ys i = apply_fun xs i).
				            { exact (Huniqp m xs Hm_red Hm_ne0 Hwp_pre_refl). }
			            claim Huniq_1 : np = 1 /\ (forall i:set, i :e np -> apply_fun ys i = apply_fun wp_word i).
			            { exact (Huniqp 1 wp_word Hwp_word_red (neq_ordsucc_0 0) Hwp_word_prod). }
			            claim Hys0_eq_xs0 : apply_fun ys 0 = apply_fun xs 0.
			            { exact (andER
			              (np = m)
			              (forall i:set, i :e np -> apply_fun ys i = apply_fun xs i)
			              Huniq_m 0 H0_in_np). }
			            claim Hys0_eq_wp0 : apply_fun ys 0 = apply_fun wp_word 0.
			            { exact (andER
			              (np = 1)
			              (forall i:set, i :e np -> apply_fun ys i = apply_fun wp_word i)
			              Huniq_1 0 H0_in_np). }
			            exact (eq_i_tra
			              (apply_fun xs 0)
			              (apply_fun ys 0)
			              (apply_fun wp_word 0)
			              (eq_symm (apply_fun ys 0) (apply_fun xs 0) Hys0_eq_xs0)
			              Hys0_eq_wp0).
			          }
			          claim Hwp0 : apply_fun wp_word 0 = wp_pre.
			          { exact (apply_fun_graph 1 (fun _:set => wp_pre) 0 (ordsuccI2 0)). }
			          claim Hxs0_eq_wp_pre : apply_fun xs 0 = wp_pre.
			          { exact (eq_i_tra
			            (apply_fun xs 0)
			            (apply_fun wp_word 0)
			            wp_pre
			            Hxs0_eq_wp0
			            Hwp0). }
			          claim Hx0_in_Gal : apply_fun xs 0 :e apply_fun Gfam al.
			          { rewrite Hxs0_eq_wp_pre. exact Hwp_pre_in_Gal. }
				          claim Halpha0_eq_al : alpha0 = al.
				          { exact (disjoint_subgroups_label_unique
				              G multG eG invG J Gfam alpha0 al (apply_fun xs 0)
				              Hdisjoint Halpha0J Hal Hx0_in_Ga0 Hx0_in_Gal Hxs0_ne_eG). }
				          exact (Halpha0_ne Halpha0_eq_al).
				        - assume Halpha_m_ne : alpha_m <> al.
				          (** Subcase analysis on whether the last label equals the first label. **)
						          apply (xm (alpha_m = alpha0)).
						          - assume Halpha_m_eq0 : alpha_m = alpha0.
						            (** Boundary-cancellation case alpha_m = alpha0.
						               We analyze the "middle product" p := xs(m) times xs(0). **)
						            set x0 := apply_fun xs 0.
						            set xlast := apply_fun xs m.
						            claim Hxlast_in_Ga0 : xlast :e apply_fun Gfam alpha0.
						            { rewrite <- Halpha_m_eq0. exact Hxsm_in_Gam. }
						            claim Hxlast_ne_ef0 : xlast <> apply_fun efam alpha0.
						            { rewrite <- Halpha_m_eq0. exact Hxsm_ne_efm. }
						            claim Hx0_ne_ef0' : x0 <> apply_fun efam alpha0.
						            { exact Hx0_ne_ef0. }
						            set p := apply_fun multG (xlast, x0).
						            claim Hp_in_Ga0 : p :e apply_fun Gfam alpha0.
						            {
						              exact (subgroup_of_mult_closed
						                (apply_fun Gfam alpha0) G multG eG invG xlast x0
						                (Hsubfam alpha0 Halpha0J) Hxlast_in_Ga0 Hx0_in_Ga0).
						            }
							            (** Boundary-cancellation case alpha_m = alpha0.
							               Split on whether p is trivial or equals efam(alpha0). **)
								            apply (xm (p = eG)).
								            - assume Hp_eG : p = eG.
								              (** If m = 1, reducedness at indices 0 and 1 contradicts alpha_m = alpha0. **)
								              apply (xm (m = 1)).
								              + assume Hm1 : m = 1.
								                claim Hn2 : ordsucc m = 2.
								                { rewrite Hm1. exact ordsucc_1_eq_2_nat. }
								                claim H0_in_n : 0 :e ordsucc m.
								                { rewrite Hn2. exact In_0_2. }
								                claim H1_in_n : 1 :e ordsucc m.
								                { rewrite Hn2. exact In_1_2. }
								                apply (and3E
								                  ((ordsucc m) :e omega)
								                  (forall i:set, i :e ordsucc m ->
								                    exists a:set, a :e J /\
								                      apply_fun xs i :e apply_fun Gfam a /\
								                      apply_fun xs i <> apply_fun efam a)
								                  (forall i:set, i :e ordsucc m -> ordsucc i :e ordsucc m ->
								                    forall a b:set, a :e J -> b :e J ->
								                      apply_fun xs i :e apply_fun Gfam a ->
								                      apply_fun xs (ordsucc i) :e apply_fun Gfam b ->
								                      a <> b)
								                  Hred_sm).
								                assume _ _ Hadj.
								                claim Hx1_in_Ga0 : apply_fun xs 1 :e apply_fun Gfam alpha0.
								                {
								                  claim Hxlast_eq : xlast = apply_fun xs 1.
								                  { rewrite Hm1. reflexivity. }
								                  rewrite <- Hxlast_eq.
								                  exact Hxlast_in_Ga0.
								                }
								                claim Hs0_in_n : ordsucc 0 :e ordsucc m.
								                { rewrite <- ordsucc_0_eq_1_nat. exact H1_in_n. }
								                exact ((Hadj 0 H0_in_n Hs0_in_n alpha0 alpha0 Halpha0J Halpha0J Hx0_in_Ga0 Hx1_in_Ga0) (eq_refl alpha0)).
								              + assume Hm_ne1 : m <> 1.
								                (** Reduce mult(xlast,x0) = eG to inverse relations between xlast and x0. **)
								                claim Hxlast_G : xlast :e G.
								                { exact (Hxs_in_G m (ordsuccI2 m)). }
								                claim Hx0_G : x0 :e G.
								                { exact (Hxs_in_G 0 (nat_0_in_ordsucc m Hm_nat)). }
								                set xs2 := graph 2 (fun i:set => If_i (i = 0) xlast x0).
								                claim Hxs2_G : forall i:set, i :e 2 -> apply_fun xs2 i :e G.
								                {
								                  let i. assume Hi2.
								                  apply (cases_2 i Hi2 (fun j:set => apply_fun xs2 j :e G)).
								                  + prove apply_fun xs2 0 :e G.
								                    rewrite (apply_fun_graph 2 (fun t:set => If_i (t = 0) xlast x0) 0 In_0_2).
								                    rewrite (If_i_1 (0 = 0) xlast x0 (eq_refl 0)).
								                    exact Hxlast_G.
								                  + prove apply_fun xs2 1 :e G.
								                    rewrite (apply_fun_graph 2 (fun t:set => If_i (t = 0) xlast x0) 1 In_1_2).
								                    rewrite (If_i_0 (1 = 0) xlast x0 neq_1_0).
								                    exact Hx0_G.
								                }
								                claim Hwp2 :
								                  word_product multG eG xs2 2 = apply_fun multG (xlast, x0).
								                { exact (word_product_two_graph_group G multG eG invG xlast x0 Hgrp Hxlast_G Hx0_G). }
								                claim Hwp2_e : word_product multG eG xs2 2 = eG.
								                { rewrite Hwp2. exact Hp_eG. }
								                claim Hx0_eq_inv_xlast : x0 = apply_fun invG xlast.
								                {
								                  claim Htmp : apply_fun xs2 1 = apply_fun invG (apply_fun xs2 0).
								                  { exact (word_product_two_eq_inv G multG eG invG xs2 Hgrp Hxs2_G Hwp2_e). }
								                  claim Hxs20 : apply_fun xs2 0 = xlast.
								                  {
								                    rewrite (apply_fun_graph 2 (fun t:set => If_i (t = 0) xlast x0) 0 In_0_2).
								                    rewrite (If_i_1 (0 = 0) xlast x0 (eq_refl 0)).
								                    reflexivity.
								                  }
								                  claim Hxs21 : apply_fun xs2 1 = x0.
								                  {
								                    rewrite (apply_fun_graph 2 (fun t:set => If_i (t = 0) xlast x0) 1 In_1_2).
								                    rewrite (If_i_0 (1 = 0) xlast x0 neq_1_0).
								                    reflexivity.
								                  }
								                  claim Hlhs : x0 = apply_fun xs2 1.
								                  { exact (eq_symm (apply_fun xs2 1) x0 Hxs21). }
								                  claim Hinv_congr :
								                    apply_fun invG (apply_fun xs2 0) = apply_fun invG xlast.
								                  { exact (apply_fun_congr_arg invG (apply_fun xs2 0) xlast Hxs20). }
								                  exact (eq_i_tra
								                    x0
								                    (apply_fun xs2 1)
								                    (apply_fun invG xlast)
								                    Hlhs
								                    (eq_i_tra
								                      (apply_fun xs2 1)
								                      (apply_fun invG (apply_fun xs2 0))
								                      (apply_fun invG xlast)
								                      Htmp
								                      Hinv_congr)).
								                }
								                claim Hxlast_eq_inv_x0 : xlast = apply_fun invG x0.
								                {
								                  claim Htmp : apply_fun xs2 0 = apply_fun invG (apply_fun xs2 1).
								                  { exact (word_product_two_eq_inv_left G multG eG invG xs2 Hgrp Hxs2_G Hwp2_e). }
								                  claim Hxs20 : apply_fun xs2 0 = xlast.
								                  {
								                    rewrite (apply_fun_graph 2 (fun t:set => If_i (t = 0) xlast x0) 0 In_0_2).
								                    rewrite (If_i_1 (0 = 0) xlast x0 (eq_refl 0)).
								                    reflexivity.
								                  }
								                  claim Hxs21 : apply_fun xs2 1 = x0.
								                  {
								                    rewrite (apply_fun_graph 2 (fun t:set => If_i (t = 0) xlast x0) 1 In_1_2).
								                    rewrite (If_i_0 (1 = 0) xlast x0 neq_1_0).
								                    reflexivity.
								                  }
								                  claim Hlhs : xlast = apply_fun xs2 0.
								                  { exact (eq_symm (apply_fun xs2 0) xlast Hxs20). }
								                  claim Hinv_congr :
								                    apply_fun invG (apply_fun xs2 1) = apply_fun invG x0.
								                  { exact (apply_fun_congr_arg invG (apply_fun xs2 1) x0 Hxs21). }
								                  exact (eq_i_tra
								                    xlast
								                    (apply_fun xs2 0)
								                    (apply_fun invG x0)
								                    Hlhs
								                    (eq_i_tra
								                      (apply_fun xs2 0)
								                      (apply_fun invG (apply_fun xs2 1))
								                      (apply_fun invG x0)
								                      Htmp
								                      Hinv_congr)).
								                }
								                (** Reduce the involution equation w^2=eG to an involution equation for the middle product. **)
								                claim Hu2_eG :
								                  exists k xs_mid u:set,
								                    nat_p k /\
								                    m = ordsucc k /\
								                    reduced_word J Gfam efam k xs_mid /\
								                    word_product multG eG xs_mid k = u /\
								                    apply_fun multG (u, u) = eG.
								                {
								                  claim Hk_ex : exists k:set, nat_p k /\ m = ordsucc k.
								                  {
								                    apply (nat_inv m Hm_nat).
								                    - assume Hm0 : m = 0.
								                      exact (FalseE (Hm_ne0 Hm0) (exists k:set, nat_p k /\ m = ordsucc k)).
								                    - assume Hk. exact Hk.
								                  }
								                  apply Hk_ex. let k. assume Hk_pack.
								                  claim Hk_nat : nat_p k.
								                  { exact (andEL (nat_p k) (m = ordsucc k) Hk_pack). }
								                  claim Hm_eq_sk : m = ordsucc k.
								                  { exact (andER (nat_p k) (m = ordsucc k) Hk_pack). }
								                  claim Hk_in_m : k :e m.
								                  { rewrite Hm_eq_sk. exact (ordsuccI2 k). }
								                  set xs_suf_e := graph m (fun i:set => apply_fun xs (ordsucc i)).
								                  set xs_mid := graph k (fun i:set => apply_fun xs_suf_e i).
								                  set u := word_product multG eG xs_mid k.
								                  claim Hred_suf_e : reduced_word J Gfam efam m xs_suf_e.
								                  { exact (reduced_word_suffix J Gfam efam m xs Hred_sm). }
								                  claim Hred_mid : reduced_word J Gfam efam k xs_mid.
								                  { exact (reduced_word_prefix J Gfam efam m xs_suf_e k Hred_suf_e Hk_in_m). }
								                  claim Hxs_mid_G : forall i:set, i :e k -> apply_fun xs_mid i :e G.
								                  {
								                    let i. assume Hik.
								                    rewrite (apply_fun_graph k (fun t:set => apply_fun xs_suf_e t) i Hik).
								                    claim Hik_m : i :e m.
								                    {
								                      claim Hk_sub_m : k c= m.
								                      { exact (nat_trans m Hm_nat k Hk_in_m). }
								                      exact (Hk_sub_m i Hik).
								                    }
								                    rewrite (apply_fun_graph m (fun t:set => apply_fun xs (ordsucc t)) i Hik_m).
								                    exact (Hxs_in_G (ordsucc i) (nat_ordsucc_in_ordsucc m Hm_nat i Hik_m)).
								                  }
								                  claim Hu_G : u :e G.
								                  {
								                    exact (word_product_in_G_group
								                      G multG eG invG k xs_mid Hgrp Hk_nat Hxs_mid_G).
								                  }
								                  claim Hx0_G2 : x0 :e G.
								                  { exact Hx0_G. }
								                  claim Hxlast_G2 : xlast :e G.
								                  { exact Hxlast_G. }
								                  claim Hwp_suf_e :
								                    word_product multG eG xs_suf_e m = apply_fun multG (u, xlast).
								                  {
								                    claim Hwp_succ :
								                      word_product multG eG xs_suf_e (ordsucc k) =
								                        apply_fun multG (word_product multG eG xs_suf_e k, apply_fun xs_suf_e k).
								                    { exact (word_product_succ multG eG xs_suf_e k Hk_nat). }
								                    claim Hlhs :
								                      word_product multG eG xs_suf_e m = word_product multG eG xs_suf_e (ordsucc k).
								                    { rewrite Hm_eq_sk. reflexivity. }
								                    claim Hxsk : apply_fun xs_suf_e k = xlast.
								                    {
								                      rewrite (apply_fun_graph m (fun t:set => apply_fun xs (ordsucc t)) k Hk_in_m).
								                      claim Hsk_eq_m : ordsucc k = m.
								                      { symmetry. exact Hm_eq_sk. }
								                      rewrite Hsk_eq_m.
								                      reflexivity.
								                    }
								                    claim Hwp_k : word_product multG eG xs_suf_e k = u.
								                    {
								                      apply (nat_primrec_ext eG
								                        (fun i r => apply_fun multG (r, apply_fun xs_suf_e i))
								                        (fun i r => apply_fun multG (r, apply_fun xs_mid i))
								                        k
								                        (nat_p_omega k Hk_nat)).
								                      let i r. assume Hik.
								                      rewrite (apply_fun_graph k (fun t:set => apply_fun xs_suf_e t) i Hik).
								                      reflexivity.
								                    }
								                    claim Hcongr :
								                      apply_fun multG (word_product multG eG xs_suf_e k, apply_fun xs_suf_e k) =
								                        apply_fun multG (u, xlast).
								                    {
								                      rewrite Hwp_k.
								                      rewrite Hxsk.
								                      reflexivity.
								                    }
								                    exact (eq_i_tra
								                      (word_product multG eG xs_suf_e m)
								                      (word_product multG eG xs_suf_e (ordsucc k))
								                      (apply_fun multG (u, xlast))
								                      Hlhs
								                      (eq_i_tra
								                        (word_product multG eG xs_suf_e (ordsucc k))
								                        (apply_fun multG (word_product multG eG xs_suf_e k, apply_fun xs_suf_e k))
								                        (apply_fun multG (u, xlast))
								                        Hwp_succ
								                        Hcongr)).
								                  }
								                  claim Hw_decomp :
								                    word_product multG eG xs (ordsucc m) =
								                      apply_fun multG (x0, apply_fun multG (u, xlast)).
								                  {
								                    claim Hwp_shift :
								                      word_product multG eG xs (ordsucc m) =
								                        apply_fun multG (apply_fun xs 0, word_product multG eG xs_suf_e m).
								                    { exact (word_product_shift_first G multG eG invG m xs Hgrp Hm_nat Hxs_in_G m Hm_nat (ordsuccI2 m)). }
								                    rewrite Hwp_shift.
								                    rewrite Hwp_suf_e.
								                    reflexivity.
								                  }
								                  claim Huu_e : apply_fun multG (u, u) = eG.
								                  {
								                    (** Expand w squared using the decomposition and cancel the boundary mult(xlast,x0)=eG and xlast=invG(x0). **)
								                    apply (and6E
								                      (function_on multG (setprod G G) G)
								                      (function_on invG G G)
								                      (eG :e G)
								                      (forall a b c:set, a :e G -> b :e G -> c :e G ->
								                        apply_fun multG (apply_fun multG (a, b), c) = apply_fun multG (a, apply_fun multG (b, c)))
								                      (forall a:set, a :e G -> apply_fun multG (eG, a) = a /\ apply_fun multG (a, eG) = a)
								                      (forall a:set, a :e G ->
								                        apply_fun multG (a, apply_fun invG a) = eG /\ apply_fun multG (apply_fun invG a, a) = eG)
								                      Hgrp).
								                    assume HmultF HinvF HeG HassocG HidG HinvLaw.
								                    set w0 := word_product multG eG xs (ordsucc m).
								                    claim Hw0_G : w0 :e G.
								                    {
								                      exact (word_product_in_G_group
								                        G multG eG invG (ordsucc m) xs Hgrp (nat_ordsucc m Hm_nat) Hxs_in_G).
								                    }
								                    claim Hw0_sq : apply_fun multG (w0, w0) = eG.
								                    {
								                      claim Hw0_eq : w0 = word_product multG eG xs (ordsucc m).
								                      { reflexivity. }
								                      rewrite Hw0_eq.
								                      rewrite Hwp_full.
								                      exact Hefam_sq.
								                    }
								                    claim Hw0_decomp : w0 = apply_fun multG (x0, apply_fun multG (u, xlast)).
								                    { exact Hw_decomp. }
								                    claim Hstep :
								                      apply_fun multG (w0, w0) =
								                        apply_fun multG (x0, apply_fun multG (apply_fun multG (u, u), xlast)).
								                    {
								                      (** Rewrite w0 squared and use Hp_eG to remove the xlast then x0 boundary. **)
								                      rewrite Hw0_decomp.
								                      claim Hassoc1 :
								                        apply_fun multG (apply_fun multG (x0, apply_fun multG (u, xlast)),
								                          apply_fun multG (x0, apply_fun multG (u, xlast))) =
								                          apply_fun multG (x0, apply_fun multG (apply_fun multG (u, xlast),
								                            apply_fun multG (x0, apply_fun multG (u, xlast)))).
								                      {
								                        exact (HassocG x0 (apply_fun multG (u, xlast)) (apply_fun multG (x0, apply_fun multG (u, xlast)))
								                          Hx0_G2
								                          (HmultF (u, xlast) (tuple_2_setprod_by_pair_Sigma G G u xlast Hu_G Hxlast_G2))
								                          (HmultF (x0, apply_fun multG (u, xlast))
								                            (tuple_2_setprod_by_pair_Sigma G G x0 (apply_fun multG (u, xlast)) Hx0_G2
								                              (HmultF (u, xlast) (tuple_2_setprod_by_pair_Sigma G G u xlast Hu_G Hxlast_G2))))).
								                      }
								                      rewrite Hassoc1.
								                      claim Hassoc2 :
								                        apply_fun multG (apply_fun multG (u, xlast), apply_fun multG (x0, apply_fun multG (u, xlast))) =
								                          apply_fun multG (u, apply_fun multG (xlast, apply_fun multG (x0, apply_fun multG (u, xlast)))).
								                      {
								                        exact (HassocG u xlast (apply_fun multG (x0, apply_fun multG (u, xlast)))
								                          Hu_G Hxlast_G2
								                          (HmultF (x0, apply_fun multG (u, xlast))
								                            (tuple_2_setprod_by_pair_Sigma G G x0 (apply_fun multG (u, xlast)) Hx0_G2
								                              (HmultF (u, xlast) (tuple_2_setprod_by_pair_Sigma G G u xlast Hu_G Hxlast_G2))))).
								                      }
								                      rewrite Hassoc2.
								                      claim Hassoc3 :
								                        apply_fun multG (xlast, apply_fun multG (x0, apply_fun multG (u, xlast))) =
								                          apply_fun multG (apply_fun multG (xlast, x0), apply_fun multG (u, xlast)).
								                      {
								                        symmetry.
								                        exact (HassocG xlast x0 (apply_fun multG (u, xlast))
								                          Hxlast_G2 Hx0_G2
								                          (HmultF (u, xlast) (tuple_2_setprod_by_pair_Sigma G G u xlast Hu_G Hxlast_G2))).
								                      }
								                      rewrite Hassoc3.
								                      rewrite Hp_eG.
								                      claim HidL :
								                        apply_fun multG (eG, apply_fun multG (u, xlast)) = apply_fun multG (u, xlast).
								                      { exact (andEL
								                        (apply_fun multG (eG, apply_fun multG (u, xlast)) = apply_fun multG (u, xlast))
								                        (apply_fun multG (apply_fun multG (u, xlast), eG) = apply_fun multG (u, xlast))
								                        (HidG (apply_fun multG (u, xlast))
								                          (HmultF (u, xlast) (tuple_2_setprod_by_pair_Sigma G G u xlast Hu_G Hxlast_G2)))). }
								                      rewrite HidL.
								                      (** Regroup to push the u factors together. **)
								                      claim Hassoc4 :
								                        apply_fun multG (x0, apply_fun multG (u, apply_fun multG (u, xlast))) =
								                          apply_fun multG (x0, apply_fun multG (apply_fun multG (u, u), xlast)).
								                      {
								                        claim Hassoc_u :
								                          apply_fun multG (u, apply_fun multG (u, xlast)) =
								                            apply_fun multG (apply_fun multG (u, u), xlast).
								                        {
								                          symmetry.
								                          exact (HassocG u u xlast Hu_G Hu_G Hxlast_G2).
								                        }
								                        rewrite Hassoc_u.
								                        reflexivity.
								                      }
								                      exact Hassoc4.
								                    }
								                    claim Hrhs_e :
								                      apply_fun multG (x0, apply_fun multG (apply_fun multG (u, u), xlast)) = eG.
								                    {
								                      rewrite <- Hstep.
								                      exact Hw0_sq.
								                    }
								                    (** Left cancel x0, then right cancel xlast to get multG(u,u)=eG. **)
								                    claim Hmul_in_G :
								                      apply_fun multG (apply_fun multG (u, u), xlast) :e G.
								                    {
								                      exact (HmultF (apply_fun multG (u, u), xlast)
								                        (tuple_2_setprod_by_pair_Sigma G G (apply_fun multG (u, u)) xlast
								                          (HmultF (u, u) (tuple_2_setprod_by_pair_Sigma G G u u Hu_G Hu_G))
								                          Hxlast_G2)).
								                    }
								                    claim Hinvx0_G : apply_fun invG x0 :e G.
								                    { exact (HinvF x0 Hx0_G2). }
								                    claim Hcancel1 :
								                      apply_fun multG (apply_fun multG (u, u), xlast) = apply_fun invG x0.
								                    {
								                      exact (group_left_cancel
								                        G multG eG invG x0
								                        (apply_fun multG (apply_fun multG (u, u), xlast))
								                        (apply_fun invG x0)
								                        Hgrp
								                        Hx0_G2
								                        Hmul_in_G
								                        Hinvx0_G
								                        (eq_i_tra
								                          (apply_fun multG (x0, apply_fun multG (apply_fun multG (u, u), xlast)))
								                          eG
								                          (apply_fun multG (x0, apply_fun invG x0))
								                          Hrhs_e
								                          (eq_symm
								                            (apply_fun multG (x0, apply_fun invG x0))
								                            eG
								                            (andEL
								                              (apply_fun multG (x0, apply_fun invG x0) = eG)
								                              (apply_fun multG (apply_fun invG x0, x0) = eG)
								                              (HinvLaw x0 Hx0_G2))))).
								                    }
								                    claim Hcancel1x :
								                      apply_fun multG (apply_fun multG (u, u), xlast) = xlast.
								                    {
								                      exact (eq_i_tra
								                        (apply_fun multG (apply_fun multG (u, u), xlast))
								                        (apply_fun invG x0)
								                        xlast
								                        Hcancel1
								                        (eq_symm xlast (apply_fun invG x0) Hxlast_eq_inv_x0)).
								                    }
								                    claim HidLx : apply_fun multG (eG, xlast) = xlast.
								                    {
								                      exact (andEL
								                        (apply_fun multG (eG, xlast) = xlast)
								                        (apply_fun multG (xlast, eG) = xlast)
								                        (HidG xlast Hxlast_G2)).
								                    }
								                    exact (group_right_cancel
								                      G multG eG invG xlast (apply_fun multG (u, u)) eG
								                      Hgrp
								                      Hxlast_G2
								                      (HmultF (u, u) (tuple_2_setprod_by_pair_Sigma G G u u Hu_G Hu_G))
								                      HeG
								                      (eq_i_tra
								                        (apply_fun multG (apply_fun multG (u, u), xlast))
								                        xlast
								                        (apply_fun multG (eG, xlast))
								                        Hcancel1x
								                        (eq_symm (apply_fun multG (eG, xlast)) xlast HidLx))).
								                  }
								                  witness k.
								                  witness xs_mid.
								                  witness u.
								                  apply and5I.
								                  - exact Hk_nat.
								                  - exact Hm_eq_sk.
								                  - exact Hred_mid.
								                  - reflexivity.
								                  - exact Huu_e.
								                }
								                (** Also record a decomposition of w using the middle product u. **)
								                claim Hk_ex : exists k:set, nat_p k /\ m = ordsucc k.
								                {
								                  apply (nat_inv m Hm_nat).
								                  - assume Hm0 : m = 0.
								                    exact (FalseE (Hm_ne0 Hm0) (exists k:set, nat_p k /\ m = ordsucc k)).
								                  - assume Hk. exact Hk.
								                }
								                apply Hk_ex. let k. assume Hk_pack.
								                claim Hk_nat : nat_p k.
								                { exact (andEL (nat_p k) (m = ordsucc k) Hk_pack). }
								                claim Hm_eq_sk : m = ordsucc k.
								                { exact (andER (nat_p k) (m = ordsucc k) Hk_pack). }
								                claim Hk_in_m : k :e m.
								                { rewrite Hm_eq_sk. exact (ordsuccI2 k). }
								                set xs_suf_e2 := graph m (fun i:set => apply_fun xs (ordsucc i)).
								                set xs_mid2 := graph k (fun i:set => apply_fun xs_suf_e2 i).
								                set u2 := word_product multG eG xs_mid2 k.
								                claim Hwp_suf_e2 :
								                  word_product multG eG xs_suf_e2 m = apply_fun multG (u2, xlast).
								                {
								                  claim HkO : k :e omega. { exact (nat_p_omega k Hk_nat). }
								                  claim Hwp_k_eq : word_product multG eG xs_suf_e2 k = u2.
								                  {
								                    claim Hwp_k_eq' : word_product multG eG xs_suf_e2 k = word_product multG eG xs_mid2 k.
								                    {
								                      apply (nat_primrec_ext eG
								                        (fun i r => apply_fun multG (r, apply_fun xs_suf_e2 i))
								                        (fun i r => apply_fun multG (r, apply_fun xs_mid2 i))
								                        k
								                        HkO).
								                      let i r. assume Hik.
								                      rewrite (apply_fun_graph k (fun t:set => apply_fun xs_suf_e2 t) i Hik).
								                      reflexivity.
								                    }
								                    rewrite Hwp_k_eq'.
								                    reflexivity.
								                  }
								                  claim Hxs_suf_k : apply_fun xs_suf_e2 k = xlast.
								                  {
								                    rewrite (apply_fun_graph m (fun t:set => apply_fun xs (ordsucc t)) k Hk_in_m).
								                    claim Hsk_eq_m : ordsucc k = m. { symmetry. exact Hm_eq_sk. }
								                    rewrite Hsk_eq_m.
								                    reflexivity.
								                  }
								                  claim Hwp_succ :
								                    word_product multG eG xs_suf_e2 (ordsucc k) =
								                      apply_fun multG (word_product multG eG xs_suf_e2 k, apply_fun xs_suf_e2 k).
								                  { exact (word_product_succ multG eG xs_suf_e2 k Hk_nat). }
								                  claim Hlhs :
								                    word_product multG eG xs_suf_e2 m = word_product multG eG xs_suf_e2 (ordsucc k).
								                  { rewrite Hm_eq_sk. reflexivity. }
								                  rewrite Hlhs.
								                  rewrite Hwp_succ.
								                  rewrite Hwp_k_eq.
								                  rewrite Hxs_suf_k.
								                  reflexivity.
								                }
								                claim Hw_eq : w = apply_fun multG (x0, apply_fun multG (u2, xlast)).
								                {
								                  claim Hwp_shift :
								                    word_product multG eG xs (ordsucc m) =
								                      apply_fun multG (apply_fun xs 0, word_product multG eG xs_suf_e2 m).
								                  { exact (word_product_shift_first G multG eG invG m xs Hgrp Hm_nat Hxs_in_G m Hm_nat (ordsuccI2 m)). }
								                  rewrite <- Hwp_full.
								                  rewrite Hwp_shift.
								                  rewrite Hwp_suf_e2.
								                  reflexivity.
								                }
								                (** From the split and w squared = eG, deduce u2 squared = eG. **)
								                claim Hu2_sq : apply_fun multG (u2, u2) = eG.
								                {
								                  apply (and6E
								                    (function_on multG (setprod G G) G)
								                    (function_on invG G G)
								                    (eG :e G)
								                    (forall a b c:set, a :e G -> b :e G -> c :e G ->
								                      apply_fun multG (apply_fun multG (a, b), c) = apply_fun multG (a, apply_fun multG (b, c)))
								                    (forall a:set, a :e G -> apply_fun multG (eG, a) = a /\ apply_fun multG (a, eG) = a)
								                    (forall a:set, a :e G ->
								                      apply_fun multG (a, apply_fun invG a) = eG /\ apply_fun multG (apply_fun invG a, a) = eG)
								                    Hgrp).
								                  assume HmultF HinvF HeG HassocG HidG HinvLaw.
								                  claim Hxs_mid2_G : forall i:set, i :e k -> apply_fun xs_mid2 i :e G.
								                  {
								                    let i. assume Hik.
								                    rewrite (apply_fun_graph k (fun t:set => apply_fun xs_suf_e2 t) i Hik).
								                    claim Hik_m : i :e m.
								                    {
								                      claim Hk_sub_m : k c= m.
								                      { exact (nat_trans m Hm_nat k Hk_in_m). }
								                      exact (Hk_sub_m i Hik).
								                    }
								                    rewrite (apply_fun_graph m (fun t:set => apply_fun xs (ordsucc t)) i Hik_m).
								                    exact (Hxs_in_G (ordsucc i) (nat_ordsucc_in_ordsucc m Hm_nat i Hik_m)).
								                  }
								                  claim Hu2_G : u2 :e G.
								                  {
								                    exact (word_product_in_G_group
								                      G multG eG invG k xs_mid2 Hgrp Hk_nat Hxs_mid2_G).
								                  }
								                  claim Ha_G : apply_fun multG (u2, xlast) :e G.
								                  {
								                    exact (HmultF (u2, xlast)
								                      (tuple_2_setprod_by_pair_Sigma G G u2 xlast Hu2_G Hxlast_G)).
								                  }
								                  claim Hxa_G : apply_fun multG (x0, apply_fun multG (u2, xlast)) :e G.
								                  {
								                    exact (HmultF (x0, apply_fun multG (u2, xlast))
								                      (tuple_2_setprod_by_pair_Sigma G G x0 (apply_fun multG (u2, xlast)) Hx0_G Ha_G)).
								                  }
								                  claim Hw_sq0 : apply_fun multG (w, w) = eG.
								                  { exact Hefam_sq. }
								                  claim Hw_sq1 : apply_fun multG
								                    (apply_fun multG (x0, apply_fun multG (u2, xlast)),
				                              apply_fun multG (x0, apply_fun multG (u2, xlast))) = eG.
								                  {
								                    rewrite <- Hw_eq.
								                    exact Hw_sq0.
								                  }
								                  claim Hstep1 :
								                    apply_fun multG
								                      (apply_fun multG (x0, apply_fun multG (u2, xlast)),
								                       apply_fun multG (x0, apply_fun multG (u2, xlast))) =
								                    apply_fun multG
								                      (x0, apply_fun multG (apply_fun multG (u2, xlast),
								                        apply_fun multG (x0, apply_fun multG (u2, xlast)))).
								                  {
								                    exact (HassocG
								                      x0
								                      (apply_fun multG (u2, xlast))
								                      (apply_fun multG (x0, apply_fun multG (u2, xlast)))
								                      Hx0_G
								                      Ha_G
								                      Hxa_G).
								                  }
								                  claim Hstep2 :
								                    apply_fun multG (apply_fun multG (u2, xlast),
								                      apply_fun multG (x0, apply_fun multG (u2, xlast))) =
								                    apply_fun multG (u2, apply_fun multG (xlast,
								                      apply_fun multG (x0, apply_fun multG (u2, xlast)))).
								                  {
								                    exact (HassocG
								                      u2
								                      xlast
								                      (apply_fun multG (x0, apply_fun multG (u2, xlast)))
								                      Hu2_G
								                      Hxlast_G
								                      Hxa_G).
								                  }
								                  claim Hstep3 :
								                    apply_fun multG (xlast, apply_fun multG (x0, apply_fun multG (u2, xlast))) =
								                      apply_fun multG (u2, xlast).
								                  {
								                    claim Hassoc1 :
								                      apply_fun multG (xlast, apply_fun multG (x0, apply_fun multG (u2, xlast))) =
								                        apply_fun multG (apply_fun multG (xlast, x0), apply_fun multG (u2, xlast)).
								                    {
								                      symmetry.
								                      exact (HassocG
								                        xlast
								                        x0
								                        (apply_fun multG (u2, xlast))
								                        Hxlast_G
								                        Hx0_G
								                        Ha_G).
								                    }
								                    rewrite Hassoc1.
								                    rewrite Hp_eG.
								                    exact (andEL
								                      (apply_fun multG (eG, apply_fun multG (u2, xlast)) = apply_fun multG (u2, xlast))
								                      (apply_fun multG (apply_fun multG (u2, xlast), eG) = apply_fun multG (u2, xlast))
								                      (HidG (apply_fun multG (u2, xlast)) Ha_G)).
								                  }
								                  claim Hstep4 :
								                    apply_fun multG
								                      (apply_fun multG (u2, xlast),
								                       apply_fun multG (x0, apply_fun multG (u2, xlast))) =
								                    apply_fun multG (u2, apply_fun multG (u2, xlast)).
								                  {
								                    rewrite Hstep2.
								                    rewrite Hstep3.
								                    reflexivity.
								                  }
								                  claim Hstep5 :
								                    apply_fun multG (u2, apply_fun multG (u2, xlast)) =
								                      apply_fun multG (apply_fun multG (u2, u2), xlast).
								                  {
								                    symmetry.
								                    exact (HassocG u2 u2 xlast Hu2_G Hu2_G Hxlast_G).
								                  }
								                  claim Hw_sq2 :
								                    apply_fun multG (x0, apply_fun multG (apply_fun multG (u2, u2), xlast)) = eG.
								                  {
								                    rewrite <- Hstep5.
								                    rewrite <- Hstep4.
								                    rewrite <- Hstep1.
								                    exact Hw_sq1.
								                  }
								                  claim Hinvx0_G : apply_fun invG x0 :e G.
								                  { exact (HinvF x0 Hx0_G). }
								                  claim Hmul_in_G :
								                    apply_fun multG (apply_fun multG (u2, u2), xlast) :e G.
								                  {
								                    exact (HmultF (apply_fun multG (u2, u2), xlast)
								                      (tuple_2_setprod_by_pair_Sigma G G (apply_fun multG (u2, u2)) xlast
								                        (HmultF (u2, u2) (tuple_2_setprod_by_pair_Sigma G G u2 u2 Hu2_G Hu2_G))
								                        Hxlast_G)).
								                  }
								                  claim Hcancel1 :
								                    apply_fun multG (apply_fun multG (u2, u2), xlast) = apply_fun invG x0.
								                  {
								                    exact (group_left_cancel
								                      G multG eG invG x0
								                      (apply_fun multG (apply_fun multG (u2, u2), xlast))
								                      (apply_fun invG x0)
								                      Hgrp
								                      Hx0_G
								                      Hmul_in_G
								                      Hinvx0_G
								                      (eq_i_tra
								                        (apply_fun multG (x0, apply_fun multG (apply_fun multG (u2, u2), xlast)))
								                        eG
								                        (apply_fun multG (x0, apply_fun invG x0))
								                        Hw_sq2
								                        (eq_symm
								                          (apply_fun multG (x0, apply_fun invG x0))
								                          eG
								                          (andEL
								                            (apply_fun multG (x0, apply_fun invG x0) = eG)
								                            (apply_fun multG (apply_fun invG x0, x0) = eG)
								                            (HinvLaw x0 Hx0_G))))).
								                  }
								                  claim HidLx : apply_fun multG (eG, xlast) = xlast.
								                  {
								                    exact (andEL
								                      (apply_fun multG (eG, xlast) = xlast)
								                      (apply_fun multG (xlast, eG) = xlast)
								                      (HidG xlast Hxlast_G)).
								                  }
								                  claim Hcancel1x :
								                    apply_fun multG (apply_fun multG (u2, u2), xlast) = xlast.
								                  {
								                    exact (eq_i_tra
								                      (apply_fun multG (apply_fun multG (u2, u2), xlast))
								                      (apply_fun invG x0)
								                      xlast
								                      Hcancel1
								                      (eq_symm xlast (apply_fun invG x0) Hxlast_eq_inv_x0)).
								                  }
								                  exact (group_right_cancel
								                    G multG eG invG xlast (apply_fun multG (u2, u2)) eG
								                    Hgrp
								                    Hxlast_G
								                    (HmultF (u2, u2) (tuple_2_setprod_by_pair_Sigma G G u2 u2 Hu2_G Hu2_G))
								                    HeG
								                    (eq_i_tra
								                      (apply_fun multG (apply_fun multG (u2, u2), xlast))
								                      xlast
								                      (apply_fun multG (eG, xlast))
								                      Hcancel1x
								                      (eq_symm (apply_fun multG (eG, xlast)) xlast HidLx))).
								                }
								                (** Remaining work: need torsion-in-free-product lemma: any involution is conjugate into a factor, then malnormality forces w = eG, contradicting Hefam_ne. **)
								                claim Hxsm_ne_eG : apply_fun xs m <> eG.
								                {
								                  claim Hn_ne0 : n <> 0.
								                  { rewrite Hn_sm. exact (neq_ordsucc_0 m). }
								                  claim Hn_ne1 : n <> 1.
								                  {
								                    assume Hn1.
								                    claim Hs : ordsucc m = ordsucc 0.
								                    { rewrite <- Hn_sm. rewrite <- ordsucc_0_eq_1_nat. exact Hn1. }
								                    exact (Hm_ne0 (ordsucc_inj m 0 Hs)).
								                  }
								                  claim Hm_in_n : m :e n.
								                  { rewrite Hn_sm. exact (ordsuccI2 m). }
								                  exact (reduced_word_no_eG_all
								                    G multG eG invG J Gfam efam n xs
								                    Hgrp Hsubfam Hred Hn_ne0 Hn_ne1 m Hm_in_n).
								                }
								                claim Hp_ne_pack : p <> eG /\ p <> apply_fun efam alpha0.
								                {
								                  exact (free_product_boundary_product_ne_e_or_efam
								                    G multG eG invG J Gfam efam al n xs m alpha0
								                    Hfp Hal Hefam_Gal Hefam_ne Hinv_eq
								                    Hred Hn_sm Hm_nat Hm_ne0
									                    Halpha0J Hx0_in_Ga0 Hxs0_ne_eG Hx0_ne_ef0
									                    Hxlast_in_Ga0 Hxsm_ne_eG Hxlast_ne_ef0
									                    Halpha0_ne Hwp).
									                }
								                claim Hp_ne_eG2 : p <> eG.
								                { exact (andEL (p <> eG) (p <> apply_fun efam alpha0) Hp_ne_pack). }
								                exact (Hp_ne_eG2 Hp_eG).
								            - assume Hp_ne_eG : p <> eG.
								              apply (xm (p = apply_fun efam alpha0)).
						              - assume Hp_eq_ef0 : p = apply_fun efam alpha0.
						                (** In this branch, efam(alpha0) is a nontrivial element of Gfam(alpha0). **)
						                claim Hef0_in_Ga0 : apply_fun efam alpha0 :e apply_fun Gfam alpha0.
						                { rewrite <- Hp_eq_ef0. exact Hp_in_Ga0. }
						                claim Hef0_ne_eG : apply_fun efam alpha0 <> eG.
						                { rewrite <- Hp_eq_ef0. exact Hp_ne_eG. }
						                (** Remaining work: need torsion-in-free-product or malnormality lemma to rule out efam alpha0 as boundary product. **)
						                claim Hxsm_ne_eG : apply_fun xs m <> eG.
						                {
						                  claim Hn_ne0 : n <> 0.
						                  { rewrite Hn_sm. exact (neq_ordsucc_0 m). }
						                  claim Hn_ne1 : n <> 1.
						                  {
						                    assume Hn1.
						                    claim Hs : ordsucc m = ordsucc 0.
						                    { rewrite <- Hn_sm. rewrite <- ordsucc_0_eq_1_nat. exact Hn1. }
						                    exact (Hm_ne0 (ordsucc_inj m 0 Hs)).
						                  }
						                  claim Hm_in_n : m :e n.
						                  { rewrite Hn_sm. exact (ordsuccI2 m). }
						                  exact (reduced_word_no_eG_all
						                    G multG eG invG J Gfam efam n xs
						                    Hgrp Hsubfam Hred Hn_ne0 Hn_ne1 m Hm_in_n).
						                }
						                claim Hp_ne_pack : p <> eG /\ p <> apply_fun efam alpha0.
						                {
						                  exact (free_product_boundary_product_ne_e_or_efam
						                    G multG eG invG J Gfam efam al n xs m alpha0
						                    Hfp Hal Hefam_Gal Hefam_ne Hinv_eq
						                    Hred Hn_sm Hm_nat Hm_ne0
						                    Halpha0J Hx0_in_Ga0 Hxs0_ne_eG Hx0_ne_ef0
						                    Hxlast_in_Ga0 Hxsm_ne_eG Hxlast_ne_ef0
						                    Halpha0_ne Hwp).
						                }
						                claim Hp_ne_ef0 : p <> apply_fun efam alpha0.
						                { exact (andER (p <> eG) (p <> apply_fun efam alpha0) Hp_ne_pack). }
						                exact (Hp_ne_ef0 Hp_eq_ef0).
						              - assume Hp_ne_ef0 : p <> apply_fun efam alpha0.
						                (** Build a reduced word for mult(w,w) by merging (xlast,x0) into p and appending the suffix word. **)
						                claim Hn_nat : nat_p n.
						                { rewrite Hn_sm. exact (nat_ordsucc m Hm_nat). }
						                claim Hn_ne0 : n <> 0.
						                { rewrite Hn_sm. exact (neq_ordsucc_0 m). }
						                claim Hn_ne1 : n <> 1.
						                {
						                  assume Hn1.
						                  claim Hs : ordsucc m = ordsucc 0.
						                  { rewrite <- Hn_sm. rewrite <- ordsucc_0_eq_1_nat. exact Hn1. }
						                  exact (Hm_ne0 (ordsucc_inj m 0 Hs)).
						                }
						                claim Hxs_ne_all : forall i:set, i :e n -> apply_fun xs i <> eG.
						                {
						                  let i. assume Hi.
						                  exact (reduced_word_no_eG_all
						                    G multG eG invG J Gfam efam n xs
						                    Hgrp Hsubfam Hred Hn_ne0 Hn_ne1 i Hi).
						                }
						                set ys0 := graph (ordsucc m) (fun i:set => if i :e m then apply_fun xs i else p).
						                claim Hys0_m : apply_fun ys0 m = p.
						                {
						                  rewrite (apply_fun_graph (ordsucc m)
						                    (fun i:set => if i :e m then apply_fun xs i else p)
						                    m
						                    (ordsuccI2 m)).
						                  rewrite (If_i_0 (m :e m) (apply_fun xs m) p (In_irref m)).
						                  reflexivity.
						                }
						                claim Hys0_i : forall i:set, i :e m -> apply_fun ys0 i = apply_fun xs i.
						                {
						                  let i. assume Hi.
						                  rewrite (apply_fun_graph (ordsucc m)
						                    (fun j:set => if j :e m then apply_fun xs j else p)
						                    i
						                    (ordsuccI1 m i Hi)).
						                  rewrite (If_i_1 (i :e m) (apply_fun xs i) p Hi).
						                  reflexivity.
						                }
						                claim Hred_ys0 : reduced_word J Gfam efam (ordsucc m) ys0.
						                {
						                  apply (and3E
						                    (ordsucc m :e omega)
						                    (forall i:set, i :e ordsucc m ->
						                      exists a:set, a :e J /\
						                        apply_fun xs i :e apply_fun Gfam a /\
						                        apply_fun xs i <> apply_fun efam a)
						                    (forall i:set, i :e ordsucc m -> ordsucc i :e ordsucc m ->
						                      forall a b:set, a :e J -> b :e J ->
						                        apply_fun xs i :e apply_fun Gfam a ->
						                        apply_fun xs (ordsucc i) :e apply_fun Gfam b ->
						                        a <> b)
						                    Hred_sm).
						                  assume HmO Helem_xs Hadj_xs.
						                  prove ordsucc m :e omega /\
						                    (forall i:set, i :e ordsucc m ->
						                      exists a:set, a :e J /\
						                        apply_fun ys0 i :e apply_fun Gfam a /\
						                        apply_fun ys0 i <> apply_fun efam a) /\
						                    (forall i:set, i :e ordsucc m -> ordsucc i :e ordsucc m ->
						                      forall a b:set, a :e J -> b :e J ->
						                        apply_fun ys0 i :e apply_fun Gfam a ->
						                        apply_fun ys0 (ordsucc i) :e apply_fun Gfam b ->
						                        a <> b).
						                  apply and3I.
						                  - exact HmO.
						                  - let i. assume Hi_sm.
						                    apply (ordsuccE m i Hi_sm).
						                    - assume Hi_m.
						                      apply (Helem_xs i (ordsuccI1 m i Hi_m)).
						                      let a. assume Ha_pack.
						                      apply (and3E
						                        (a :e J)
						                        (apply_fun xs i :e apply_fun Gfam a)
						                        (apply_fun xs i <> apply_fun efam a)
						                        Ha_pack).
						                      assume HaJ Hxi Hxne.
						                      witness a.
						                      apply and3I.
						                      - exact HaJ.
						                      - rewrite (Hys0_i i Hi_m). exact Hxi.
						                      - rewrite (Hys0_i i Hi_m). exact Hxne.
						                    - assume Hi_eq_m.
						                      witness alpha0.
						                      apply and3I.
						                      - exact Halpha0J.
						                      - rewrite Hi_eq_m. rewrite Hys0_m. exact Hp_in_Ga0.
						                      - rewrite Hi_eq_m. rewrite Hys0_m. exact Hp_ne_ef0.
						                  - let i. assume Hi_sm Hsi_sm.
						                    let a b. assume HaJ HbJ Hia Hib.
						                    apply (ordsuccE m (ordsucc i) Hsi_sm).
						                    - assume Hsi_m.
						                      claim Hi_m : i :e m.
						                      { exact (nat_trans m Hm_nat (ordsucc i) Hsi_m i (ordsuccI2 i)). }
						                      claim Hlhs : apply_fun xs i :e apply_fun Gfam a.
						                      { rewrite <- (Hys0_i i Hi_m). exact Hia. }
						                      claim Hrhs : apply_fun xs (ordsucc i) :e apply_fun Gfam b.
						                      { rewrite <- (Hys0_i (ordsucc i) Hsi_m). exact Hib. }
						                      exact (Hadj_xs i (ordsuccI1 m i Hi_m) (ordsuccI1 m (ordsucc i) Hsi_m) a b
						                        HaJ HbJ Hlhs Hrhs).
						                    - assume Hsi_eq_m.
						                      claim Hi_m : i :e m.
						                      { exact (eq_subst_mem_set i (ordsucc i) m (ordsuccI2 i) Hsi_eq_m). }
						                      claim Hb_eq0 : b = alpha0.
						                      {
						                        claim Hp_in_Gb : p :e apply_fun Gfam b.
						                        {
						                          claim Hidx : apply_fun ys0 (ordsucc i) = apply_fun ys0 m.
						                          { exact (apply_fun_congr_arg ys0 (ordsucc i) m Hsi_eq_m). }
						                          claim Hym : apply_fun ys0 m :e apply_fun Gfam b.
						                          { exact (eq_subst_mem_rev
						                              (apply_fun ys0 (ordsucc i))
						                              (apply_fun ys0 m)
						                              (apply_fun Gfam b)
						                              Hidx
						                              Hib). }
						                          exact (eq_subst_mem
						                            p
						                            (apply_fun ys0 m)
						                            (apply_fun Gfam b)
						                            (eq_symm (apply_fun ys0 m) p Hys0_m)
						                            Hym).
						                        }
						                        symmetry.
						                        exact (disjoint_subgroups_label_unique
						                          G multG eG invG J Gfam alpha0 b p
						                          Hdisjoint Halpha0J HbJ Hp_in_Ga0 Hp_in_Gb Hp_ne_eG).
						                      }
						                      rewrite Hb_eq0.
						                      claim Hlhs : apply_fun xs i :e apply_fun Gfam a.
						                      { rewrite <- (Hys0_i i Hi_m). exact Hia. }
						                      claim Hxsi1_in_Ga0 : apply_fun xs (ordsucc i) :e apply_fun Gfam alpha0.
						                      {
						                        claim Hidx : apply_fun xs (ordsucc i) = apply_fun xs m.
						                        { exact (apply_fun_congr_arg xs (ordsucc i) m Hsi_eq_m). }
						                        exact (eq_subst_mem
						                          (apply_fun xs (ordsucc i))
						                          (apply_fun xs m)
						                          (apply_fun Gfam alpha0)
						                          Hidx
						                          Hxlast_in_Ga0).
						                      }
						                      exact (Hadj_xs i Hi_sm Hsi_sm a alpha0
						                        HaJ Halpha0J Hlhs Hxsi1_in_Ga0).
						                }
						                (** Word product of ys0 is mult(w, x0) by associativity. **)
						                claim Hwp_ys0 : word_product multG eG ys0 (ordsucc m) = apply_fun multG (w, x0).
						                {
						                  claim HmO : m :e omega. { exact (nat_p_omega m Hm_nat). }
						                  claim Hwp0 : word_product multG eG ys0 (ordsucc m) =
						                    apply_fun multG (word_product multG eG xs m, p).
						                  { exact (word_product_append_one multG eG xs p m HmO). }
						                  rewrite Hwp0.
						                  apply (and6E
						                    (function_on multG (setprod G G) G)
						                    (function_on invG G G)
						                    (eG :e G)
						                    (forall a b c:set, a :e G -> b :e G -> c :e G ->
						                      apply_fun multG (apply_fun multG (a, b), c) = apply_fun multG (a, apply_fun multG (b, c)))
						                    (forall a:set, a :e G -> apply_fun multG (eG, a) = a /\ apply_fun multG (a, eG) = a)
						                    (forall a:set, a :e G ->
						                      apply_fun multG (a, apply_fun invG a) = eG /\ apply_fun multG (apply_fun invG a, a) = eG)
						                    Hgrp).
						                  assume _ _ _ HassocG _ _.
						                  claim Hwp_xs_succ :
						                    word_product multG eG xs (ordsucc m) =
						                      apply_fun multG (word_product multG eG xs m, apply_fun xs m).
						                  { exact (word_product_succ multG eG xs m Hm_nat). }
						                  claim Hw_eq :
						                    w = apply_fun multG (word_product multG eG xs m, xlast).
						                  {
						                    rewrite <- Hwp_full.
						                    rewrite Hwp_xs_succ.
						                    rewrite (eq_refl (apply_fun multG (word_product multG eG xs m, apply_fun xs m))).
						                    reflexivity.
						                  }
						                  claim Hp_def : p = apply_fun multG (xlast, x0).
						                  { reflexivity. }
						                  rewrite Hp_def.
						                  rewrite Hw_eq.
						                  (** mult( wp, mult(xlast,x0) ) = mult( mult(wp,xlast), x0 ) **)
						                  exact (eq_symm
							                    (apply_fun multG (apply_fun multG (word_product multG eG xs m, xlast), x0))
							                    (apply_fun multG (word_product multG eG xs m, apply_fun multG (xlast, x0)))
							                    (HassocG (word_product multG eG xs m) xlast x0
							                      (word_product_in_G_group G multG eG invG m xs Hgrp Hm_nat (fun i Hi => Hxs_in_G i (ordsuccI1 m i Hi)))
							                      (Hxs_in_G m (ordsuccI2 m))
							                      (Hxs_in_G 0 (nat_0_in_ordsucc m Hm_nat)))).
							                }
						                (** Append the suffix letters xs(1),...,xs(m) to ys0 by induction. **)
						                set P := (fun k:set =>
						                  k :e ordsucc m ->
						                  exists ys:set,
						                    reduced_word J Gfam efam (add_nat n k) ys /\
						                    word_product multG eG ys (add_nat n k) =
						                      apply_fun multG (w, word_product multG eG xs (ordsucc k)) /\
						                    (forall t:set, nat_p t -> k = ordsucc t ->
						                      apply_fun ys (add_nat n t) = apply_fun xs (ordsucc t))).
						                claim Hbuild : forall k:set, nat_p k -> P k.
						                {
						                  apply (nat_ind P).
						                  - (** k = 0 **)
						                    assume H0_in : 0 :e ordsucc m.
						                    witness ys0.
						                    apply and3I.
						                    + rewrite (add_nat_0R n). rewrite Hn_sm. exact Hred_ys0.
						                    + rewrite (add_nat_0R n).
						                      (** word_product xs 1 = x0 **)
						                      claim Hwp1 : word_product multG eG xs 1 = x0.
						                      {
						                        claim Hwp_succ0 : word_product multG eG xs 1 =
						                          apply_fun multG (word_product multG eG xs 0, apply_fun xs 0).
						                        { exact (word_product_succ multG eG xs 0 nat_0). }
						                        claim Hwp0 : word_product multG eG xs 0 = eG.
						                        { exact (nat_primrec_0 eG (fun i r => apply_fun multG (r, apply_fun xs i))). }
						                        rewrite Hwp_succ0. rewrite Hwp0.
						                        apply (and6E
						                          (function_on multG (setprod G G) G)
						                          (function_on invG G G)
						                          (eG :e G)
						                          (forall a b c:set, a :e G -> b :e G -> c :e G ->
						                            apply_fun multG (apply_fun multG (a, b), c) = apply_fun multG (a, apply_fun multG (b, c)))
						                          (forall a:set, a :e G -> apply_fun multG (eG, a) = a /\ apply_fun multG (a, eG) = a)
						                          (forall a:set, a :e G ->
						                            apply_fun multG (a, apply_fun invG a) = eG /\ apply_fun multG (apply_fun invG a, a) = eG)
						                          Hgrp).
						                        assume _ _ _ _ HidG _.
						                        claim Hx0G : x0 :e G.
						                        { exact (Hxs_in_G 0 (nat_0_in_ordsucc m Hm_nat)). }
						                        exact (andEL
						                          (apply_fun multG (eG, x0) = x0)
						                          (apply_fun multG (x0, eG) = x0)
						                          (HidG x0 Hx0G)).
						                      }
						                      rewrite Hn_sm.
						                      rewrite Hwp_ys0.
						                      rewrite Hwp1.
						                      reflexivity.
						                    + let t. assume Ht_nat Ht_succ.
						                      exact (FalseE (neq_ordsucc_0 t (eq_symm 0 (ordsucc t) Ht_succ))
						                        (apply_fun ys0 (add_nat n t) = apply_fun xs (ordsucc t))).
						                  - (** step **)
						                    let k. assume Hk_nat IH.
						                    prove P (ordsucc k).
						                    assume Hsk_in : ordsucc k :e ordsucc m.
						                    claim Hk_in : k :e ordsucc m.
						                    {
						                      exact (nat_trans (ordsucc m) (nat_ordsucc m Hm_nat) (ordsucc k) Hsk_in k (ordsuccI2 k)).
						                    }
						                    apply (IH Hk_in).
						                    let ys. assume Hys_pack.
						                    apply (and3E
						                      (reduced_word J Gfam efam (add_nat n k) ys)
						                      (word_product multG eG ys (add_nat n k) =
						                        apply_fun multG (w, word_product multG eG xs (ordsucc k)))
						                      (forall t:set, nat_p t -> k = ordsucc t ->
						                        apply_fun ys (add_nat n t) = apply_fun xs (ordsucc t))
						                      Hys_pack).
						                    assume Hred_y Hwp_y Hlast_y.
						                    set ys' := graph (ordsucc (add_nat n k))
						                      (fun i0:set => if i0 :e add_nat n k then apply_fun ys i0 else apply_fun xs (ordsucc k)).
							                    witness ys'.
							                    apply and3I.
							                    + (** reduced_word **)
							                      claim Hnk_nat : nat_p (add_nat n k).
							                      { exact (add_nat_p n Hn_nat k Hk_nat). }
							                      claim HnkO : add_nat n k :e omega.
							                      { exact (nat_p_omega (add_nat n k) Hnk_nat). }
							                      claim Hlen_eq : add_nat n (ordsucc k) = ordsucc (add_nat n k).
							                      { exact (add_nat_SR n k Hk_nat). }
							                      rewrite Hlen_eq.
							                      claim Hk_in_n : k :e n.
							                      { rewrite Hn_sm. exact Hk_in. }
							                      claim Hsk_in_n : ordsucc k :e n.
							                      { rewrite Hn_sm. exact Hsk_in. }
							                      (** Extract the letter data for xs(k+1). **)
							                      apply (reduced_word_elem J Gfam efam n xs (ordsucc k) Hred Hsk_in_n). let beta1.
							                      assume Hbeta1_pack :
							                        beta1 :e J /\ apply_fun xs (ordsucc k) :e apply_fun Gfam beta1 /\ apply_fun xs (ordsucc k) <> apply_fun efam beta1.
							                      apply (and3E
							                        (beta1 :e J)
							                        (apply_fun xs (ordsucc k) :e apply_fun Gfam beta1)
							                        (apply_fun xs (ordsucc k) <> apply_fun efam beta1)
							                        Hbeta1_pack).
							                      assume Hbeta1J Hxsk1_in_Gb1 Hxsk1_ne_efb1.
							                      (** Boundary adjacency lemma: last label of ys differs from beta1. **)
							                      claim Hlast_label_ne :
							                        forall kk alpha beta0:set,
							                          ordsucc kk = add_nat n k ->
							                          alpha :e J -> beta0 :e J ->
							                          apply_fun ys kk :e apply_fun Gfam alpha ->
							                          apply_fun xs (ordsucc k) :e apply_fun Gfam beta0 ->
							                          alpha <> beta0.
							                      {
							                        let kk alpha beta0.
							                        assume Hlen_eqk HaJ HbJ Hlast_in Hbk1_in.
							                        (** First normalize the beta0 label using disjointness. **)
							                        claim Hbeta0_eq : beta0 = beta1.
							                        {
							                          exact (disjoint_subgroups_label_unique
							                            G multG eG invG J Gfam beta0 beta1 (apply_fun xs (ordsucc k))
							                            Hdisjoint HbJ Hbeta1J Hbk1_in Hxsk1_in_Gb1 (Hxs_ne_all (ordsucc k) Hsk_in_n)).
							                        }
							                        (** Split on k=0 vs k=ordsucc t. **)
							                        apply (xm (k = 0)).
							                        - assume Hk0 : k = 0.
							                          claim Hlen_eq_n : ordsucc kk = n.
							                          {
							                            rewrite <- (add_nat_0R n).
							                            rewrite <- Hk0.
							                            exact Hlen_eqk.
							                          }
							                          claim Hkk_eq_m : kk = m.
							                          {
							                            claim Hs : ordsucc kk = ordsucc m.
							                            { exact (eq_i_tra (ordsucc kk) n (ordsucc m) Hlen_eq_n Hn_sm). }
							                            exact (ordsucc_inj kk m Hs).
							                          }
							                          (** Show ys is the unique reduced word for mult(w,x0), hence its last label is alpha0. **)
							                          claim Hx0_G : x0 :e G.
							                          { exact (Hxs_in_G 0 (nat_0_in_ordsucc m Hm_nat)). }
							                          claim Hx_wx0_G : apply_fun multG (w, x0) :e G.
							                          {
							                            apply (and6E
							                              (function_on multG (setprod G G) G)
							                              (function_on invG G G)
							                              (eG :e G)
							                              (forall a b c:set, a :e G -> b :e G -> c :e G ->
							                                apply_fun multG (apply_fun multG (a, b), c) = apply_fun multG (a, apply_fun multG (b, c)))
							                              (forall a:set, a :e G -> apply_fun multG (eG, a) = a /\ apply_fun multG (a, eG) = a)
							                              (forall a:set, a :e G ->
							                                apply_fun multG (a, apply_fun invG a) = eG /\ apply_fun multG (apply_fun invG a, a) = eG)
							                              Hgrp).
							                            assume HmultFn _ _ _ _ _.
							                            exact (HmultFn (w, x0)
							                              (tuple_2_setprod_by_pair_Sigma G G w x0 Hefam_G Hx0_G)).
							                          }
							                          claim Hwx0_ne_eG : apply_fun multG (w, x0) <> eG.
							                          {
							                            assume Habs.
							                            apply (and6E
							                              (function_on multG (setprod G G) G)
							                              (function_on invG G G)
							                              (eG :e G)
							                              (forall a b c:set, a :e G -> b :e G -> c :e G ->
							                                apply_fun multG (apply_fun multG (a, b), c) = apply_fun multG (a, apply_fun multG (b, c)))
							                              (forall a:set, a :e G -> apply_fun multG (eG, a) = a /\ apply_fun multG (a, eG) = a)
							                              (forall a:set, a :e G ->
							                                apply_fun multG (a, apply_fun invG a) = eG /\ apply_fun multG (apply_fun invG a, a) = eG)
							                              Hgrp).
							                            assume _ HinvFn _ HassocG HidG HinvLaw.
							                            claim HwG : w :e G. { exact Hefam_G. }
							                            claim Hinvw_G : apply_fun invG w :e G.
							                            { exact (HinvFn w HwG). }
							                            claim Hmul_eq : x0 = apply_fun multG (apply_fun invG w, apply_fun multG (w, x0)).
							                            {
							                              claim Hassoc1 : apply_fun multG (apply_fun invG w, apply_fun multG (w, x0)) =
							                                apply_fun multG (apply_fun multG (apply_fun invG w, w), x0).
							                              {
							                                symmetry.
							                                exact (HassocG (apply_fun invG w) w x0 Hinvw_G HwG Hx0_G).
							                              }
							                              claim HinvL : apply_fun multG (apply_fun invG w, w) = eG.
							                              { exact (andER
							                                (apply_fun multG (w, apply_fun invG w) = eG)
							                                (apply_fun multG (apply_fun invG w, w) = eG)
							                                (HinvLaw w HwG)). }
							                              claim Hcongr : apply_fun multG (apply_fun multG (apply_fun invG w, w), x0) =
							                                apply_fun multG (eG, x0).
							                              { rewrite HinvL. reflexivity. }
							                              claim HidL : apply_fun multG (eG, x0) = x0.
							                              { exact (andEL
							                                (apply_fun multG (eG, x0) = x0)
							                                (apply_fun multG (x0, eG) = x0)
							                                (HidG x0 Hx0_G)). }
							                              exact (eq_i_tra
							                                x0
							                                (apply_fun multG (eG, x0))
							                                (apply_fun multG (apply_fun invG w, apply_fun multG (w, x0)))
							                                (eq_symm (apply_fun multG (eG, x0)) x0 HidL)
							                                (eq_i_tra
							                                  (apply_fun multG (eG, x0))
							                                  (apply_fun multG (apply_fun multG (apply_fun invG w, w), x0))
							                                  (apply_fun multG (apply_fun invG w, apply_fun multG (w, x0)))
							                                  (eq_symm (apply_fun multG (apply_fun multG (apply_fun invG w, w), x0)) (apply_fun multG (eG, x0)) Hcongr)
							                                  (eq_symm (apply_fun multG (apply_fun invG w, apply_fun multG (w, x0)))
							                                    (apply_fun multG (apply_fun multG (apply_fun invG w, w), x0))
							                                    Hassoc1))).
								                            }
								                            claim Hwx0e : apply_fun multG (w, x0) = eG.
								                            { exact Habs. }
								                            claim Hx0_eq_invw : x0 = apply_fun invG w.
								                            {
								                              claim Hrhs : apply_fun multG (apply_fun invG w, apply_fun multG (w, x0)) =
								                                apply_fun multG (apply_fun invG w, eG).
								                              { rewrite Hwx0e at 1. reflexivity. }
								                              claim Hmul_eq2 : x0 = apply_fun multG (apply_fun invG w, eG).
								                              {
								                                exact (eq_i_tra
								                                  x0
								                                  (apply_fun multG (apply_fun invG w, apply_fun multG (w, x0)))
								                                  (apply_fun multG (apply_fun invG w, eG))
								                                  Hmul_eq
								                                  Hrhs).
								                              }
								                              claim HidR : apply_fun multG (apply_fun invG w, eG) = apply_fun invG w.
								                              { exact (andER
								                                (apply_fun multG (eG, apply_fun invG w) = apply_fun invG w)
								                                (apply_fun multG (apply_fun invG w, eG) = apply_fun invG w)
								                                (HidG (apply_fun invG w) Hinvw_G)). }
								                              exact (eq_i_tra x0 (apply_fun multG (apply_fun invG w, eG)) (apply_fun invG w) Hmul_eq2 HidR).
								                            }
							                            (** inv(w) is in Gfam(al); x0 is in Gfam(alpha0); disjointness forces x0=eG, contradiction. **)
							                            claim Hinvw_in_Gal : apply_fun invG w :e apply_fun Gfam al.
							                            {
							                              apply (and4E
							                                (apply_fun Gfam al c= G)
							                                (eG :e apply_fun Gfam al)
							                                (forall a b:set, a :e apply_fun Gfam al -> b :e apply_fun Gfam al ->
							                                  apply_fun multG (a, b) :e apply_fun Gfam al)
							                                (forall a:set, a :e apply_fun Gfam al -> apply_fun invG a :e apply_fun Gfam al)
							                                (Hsubfam al Hal)).
							                              assume _ _ _ Hinv_al.
							                              exact (Hinv_al w Hefam_Gal).
							                            }
							                            claim Hx0_in_Gal : x0 :e apply_fun Gfam al.
							                            { rewrite Hx0_eq_invw. exact Hinvw_in_Gal. }
							                            claim Hx0_eG : x0 = eG.
							                            { exact (Hdisjoint alpha0 al Halpha0J Hal Halpha0_ne (x0) Hx0_in_Ga0 Hx0_in_Gal). }
							                            exact (Hxs_ne_all 0 (eq_subst_mem_set 0 (ordsucc m) n (nat_0_in_ordsucc m Hm_nat) (eq_symm n (ordsucc m) Hn_sm)) Hx0_eG).
							                          }
							                          (** Apply uniqueness from Huniq to identify ys with ys0. **)
								                          apply (Huniq (apply_fun multG (w, x0)) Hx_wx0_G Hwx0_ne_eG). let np.
								                          assume Hys_can_pack.
								                          apply Hys_can_pack. let xs_can.
								                          assume Hcan_pack.
								                          apply (and4E
								                            (reduced_word J Gfam efam np xs_can)
								                            (np <> 0)
								                            (word_product multG eG xs_can np = apply_fun multG (w, x0))
								                            (forall n' xs':set,
								                              reduced_word J Gfam efam n' xs' -> n' <> 0 ->
								                              word_product multG eG xs' n' = apply_fun multG (w, x0) ->
								                              np = n' /\ (forall i:set, i :e np -> apply_fun xs_can i = apply_fun xs' i))
								                            Hcan_pack).
								                          assume Hred_can Hnp_ne0 Hwp_can Huniq_can.
								                          (** Use ys0 and ys as two reduced words for mult(w,x0). **)
										                          claim Hwp_ys0_wx0 : word_product multG eG ys0 n = apply_fun multG (w, x0).
										                          { rewrite Hn_sm. exact Hwp_ys0. }
											                          claim Hwp_y_wx0 : word_product multG eG ys n = apply_fun multG (w, x0).
											                          {
											                            claim Hadd0 : add_nat n k = n.
											                            { rewrite Hk0. exact (add_nat_0R n). }
											                            claim Hn_add : n = add_nat n k.
											                            { exact (eq_symm (add_nat n k) n Hadd0). }
											                            claim Hwp_y_n : word_product multG eG ys n =
											                              apply_fun multG (w, word_product multG eG xs (ordsucc k)).
											                            { rewrite Hn_add at 1. exact Hwp_y. }
											                            claim Hordk1 : ordsucc k = 1.
											                            { rewrite Hk0. exact ordsucc_0_eq_1_nat. }
											                            claim Hwp_xs1 : word_product multG eG xs 1 = x0.
											                            {
											                              claim Hwp_succ0 : word_product multG eG xs 1 =
											                                apply_fun multG (word_product multG eG xs 0, apply_fun xs 0).
											                              { exact (word_product_succ multG eG xs 0 nat_0). }
											                              claim Hwp0 : word_product multG eG xs 0 = eG.
											                              { exact (nat_primrec_0 eG (fun i r => apply_fun multG (r, apply_fun xs i))). }
											                              rewrite Hwp_succ0. rewrite Hwp0.
											                              apply (and6E
											                                (function_on multG (setprod G G) G)
											                                (function_on invG G G)
											                                (eG :e G)
											                                (forall a b c:set, a :e G -> b :e G -> c :e G ->
											                                  apply_fun multG (apply_fun multG (a, b), c) = apply_fun multG (a, apply_fun multG (b, c)))
											                                (forall a:set, a :e G -> apply_fun multG (eG, a) = a /\ apply_fun multG (a, eG) = a)
											                                (forall a:set, a :e G ->
											                                  apply_fun multG (a, apply_fun invG a) = eG /\ apply_fun multG (apply_fun invG a, a) = eG)
											                                Hgrp).
											                              assume _ _ _ _ HidG _.
											                              exact (andEL
											                                (apply_fun multG (eG, x0) = x0)
											                                (apply_fun multG (x0, eG) = x0)
											                                (HidG x0 Hx0_G)).
											                            }
											                            claim Hwp_xs_ordk : word_product multG eG xs (ordsucc k) = x0.
											                            { rewrite Hordk1. exact Hwp_xs1. }
											                            claim Hr : apply_fun multG (w, word_product multG eG xs (ordsucc k)) =
											                              apply_fun multG (w, x0).
											                            { rewrite Hwp_xs_ordk at 1. reflexivity. }
											                            exact (eq_i_tra
											                              (word_product multG eG ys n)
											                              (apply_fun multG (w, word_product multG eG xs (ordsucc k)))
											                              (apply_fun multG (w, x0))
											                              Hwp_y_n
											                              Hr).
											                          }
								                          claim Hred_ys0_n : reduced_word J Gfam efam n ys0.
								                          { rewrite Hn_sm. exact Hred_ys0. }
								                          claim Hnp_eq_n0 : np = n /\ (forall i:set, i :e np -> apply_fun xs_can i = apply_fun ys0 i).
								                          { exact (Huniq_can n ys0 Hred_ys0_n Hn_ne0 Hwp_ys0_wx0). }
									                          claim Hnp_eq_n1 : np = n /\ (forall i:set, i :e np -> apply_fun xs_can i = apply_fun ys i).
									                          {
									                            claim Hred_y_n : reduced_word J Gfam efam n ys.
									                            { rewrite <- (add_nat_0R n). rewrite <- Hk0. exact Hred_y. }
									                            exact (Huniq_can n ys Hred_y_n Hn_ne0 Hwp_y_wx0).
									                          }
							                          claim Hnp_eq_n : np = n.
							                          { exact (andEL (np = n) (forall i:set, i :e np -> apply_fun xs_can i = apply_fun ys0 i) Hnp_eq_n0). }
								                          claim Hkk_in_np : kk :e np.
								                          { rewrite Hnp_eq_n. rewrite <- Hlen_eq_n. exact (ordsuccI2 kk). }
							                          claim Hys0_eq : apply_fun ys0 kk = apply_fun ys kk.
							                          {
							                            claim Hcan_ys0 : forall i:set, i :e np -> apply_fun xs_can i = apply_fun ys0 i.
							                            { exact (andER (np = n) (forall i:set, i :e np -> apply_fun xs_can i = apply_fun ys0 i) Hnp_eq_n0). }
							                            claim Hcan_ys : forall i:set, i :e np -> apply_fun xs_can i = apply_fun ys i.
							                            { exact (andER (np = n) (forall i:set, i :e np -> apply_fun xs_can i = apply_fun ys i) Hnp_eq_n1). }
							                            claim Hc0 : apply_fun xs_can kk = apply_fun ys0 kk.
							                            { exact (Hcan_ys0 kk Hkk_in_np). }
							                            claim Hc1 : apply_fun xs_can kk = apply_fun ys kk.
							                            { exact (Hcan_ys kk Hkk_in_np). }
							                            exact (eq_i_tra (apply_fun ys0 kk) (apply_fun xs_can kk) (apply_fun ys kk)
							                              (eq_symm (apply_fun xs_can kk) (apply_fun ys0 kk) Hc0) Hc1).
							                          }
							                          claim Hys0_last_in : apply_fun ys0 kk :e apply_fun Gfam alpha0.
							                          { rewrite Hkk_eq_m. rewrite Hys0_m. exact Hp_in_Ga0. }
									                          claim Hys_last_in_Ga0 : apply_fun ys kk :e apply_fun Gfam alpha0.
									                          { rewrite <- Hys0_eq. exact Hys0_last_in. }
									                          claim Halpha_eq_a0 : alpha = alpha0.
									                          {
									                            claim Hys0kk_eq_p : apply_fun ys0 kk = p.
									                            { rewrite Hkk_eq_m. rewrite Hys0_m. reflexivity. }
									                            claim Hyskk_ne_eG : apply_fun ys kk <> eG.
									                            {
									                              assume Hab.
									                              claim Hys0kk_eG : apply_fun ys0 kk = eG.
									                              { exact (eq_i_tra (apply_fun ys0 kk) (apply_fun ys kk) eG Hys0_eq Hab). }
									                              claim Hp_eG : p = eG.
									                              { exact (eq_i_tra p (apply_fun ys0 kk) eG (eq_symm (apply_fun ys0 kk) p Hys0kk_eq_p) Hys0kk_eG). }
									                              exact (Hp_ne_eG Hp_eG).
									                            }
									                            exact (disjoint_subgroups_label_unique
