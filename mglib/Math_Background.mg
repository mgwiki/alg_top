       apply_fun (path_lift E Te B Tb p (apply_fun (path_lift E Te B Tb p e0 g0_54) s) vs) 0
         = apply_fun (path_lift E Te B Tb p e0 g0_54) s)
      (forall t:set, t :e unit_interval ->
