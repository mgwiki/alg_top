      exact (real_SNo
        (apply_fun A (k, j))
        HakjR).
    }
    claim HvjSNo : SNo (apply_fun v j).
    {
      exact (real_SNo
        (apply_fun v j)
        HvjR).
    }
    claim Hakj_le : 0 <= apply_fun A (k, j).
    {
      exact (SNoLe_of_Rle
        0
        (apply_fun A (k, j))
        HakjNonneg).
    }
    claim Hvj_le : 0 <= apply_fun v j.
    {
      exact (SNoLe_of_Rle
        0
        (apply_fun v j)
        HvjNonneg).
    }
    claim Hprod_le : 0 <= mul_SNo (apply_fun A (k, j)) (apply_fun v j).
    {
      exact (mul_SNo_nonneg_nonneg
        (apply_fun A (k, j))
        (apply_fun v j)
        HakjSNo
        HvjSNo
        Hakj_le
        Hvj_le).
    }
    claim HprodR : mul_SNo (apply_fun A (k, j)) (apply_fun v j) :e R.
    {
      exact (real_mul_SNo
        (apply_fun A (k, j))
        HakjR
        (apply_fun v j)
        HvjR).
    }
    exact (Rle_of_SNoLe
      0
      (mul_SNo (apply_fun A (k, j)) (apply_fun v j))
      real_0
      HprodR
      Hprod_le).
}
claim HlamR : lam :e R.
{
