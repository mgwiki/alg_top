	    rewrite <- HUeq.
	    exact (andER (topology_on X Tx) ((X :\: C) :e Tx) HUopen_in).
	  }
	  (** Hausdorff proof (pending): build disjoint open neighborhoods via coherence **)
	  (** Reverse direction infrastructure: for each arc A, collect all intersection points of A with other arcs. **)
	  set IntFam := fun A:set => Repl (Arcs :\: Sing A) (fun B:set => A :/\: B).
	  set IntPts := fun A:set => Union (IntFam A).
		  claim HIntPts_dat :
		    forall A:set, A :e Arcs -> IntPts A c= A /\ finite (IntPts A).
	  {
	    let A.
	    assume HAArcs.
	    claim HArcsNoA_fin : finite (Arcs :\: Sing A).
	    {
	      apply (Subq_finite Arcs HfinArcs (Arcs :\: Sing A)).
	      exact (setminus_Subq Arcs (Sing A)).
	    }
	    claim HFamFin : finite (IntFam A).
	    {
	      exact (Repl_finite
	        (fun B0:set => A :/\: B0)
	        (Arcs :\: Sing A)
	        HArcsNoA_fin).
	    }
	    claim HFamElemFin : forall D:set, D :e IntFam A -> finite D.
	    {
	      let D.
	      assume HDin.
	      apply (ReplE (Arcs :\: Sing A) (fun B0:set => A :/\: B0) D HDin).
	      let B.
	      assume HBpack.
	      claim HBArcsNoA : B :e (Arcs :\: Sing A).
	      { exact (andEL (B :e (Arcs :\: Sing A)) (D = A :/\: B) HBpack). }
	      claim HDeq : D = A :/\: B.
	      { exact (andER (B :e (Arcs :\: Sing A)) (D = A :/\: B) HBpack). }
	      rewrite HDeq.
	      claim HBArcs : B :e Arcs.
	      { exact (setminusE1 Arcs (Sing A) B HBArcsNoA). }
	      claim HBneq : B <> A.
	      {
	        assume Heq.
	        claim HBinSing : B :e Sing A.
	        { rewrite Heq. exact (SingI A). }
	        exact (setminusE2 Arcs (Sing A) B HBArcsNoA HBinSing).
	      }
	      claim HcapCase :
	        exists p:set, (A :/\: B = Empty \/ A :/\: B = Sing p).
	      { exact (HinterDat A B HAArcs HBArcs (neq_i_sym B A HBneq)). }
	      apply HcapCase.
	      let p.
	      assume Hcase.
	      apply Hcase.
	      - assume Hem. rewrite Hem. exact finite_Empty.
	      - assume Hsing. rewrite Hsing. exact (Sing_finite p).
	    }
	    claim HIntPts_fin : finite (IntPts A).
	    {
	      exact (finite_Union_of_finite_family
	        (IntFam A)
	        HFamFin
	        HFamElemFin).
	    }
	    claim HIntPts_sub : IntPts A c= A.
	    {
	      let z.
	      assume Hz.
	      apply (UnionE (IntFam A) z Hz).
	      let D.
	      assume HDpack.
	      claim HzD : z :e D.
	      { exact (andEL (z :e D) (D :e IntFam A) HDpack). }
	      claim HDin : D :e IntFam A.
	      { exact (andER (z :e D) (D :e IntFam A) HDpack). }
	      apply (ReplE (Arcs :\: Sing A) (fun B0:set => A :/\: B0) D HDin).
	      let B.
	      assume HBpack.
	      claim HDeq : D = A :/\: B.
	      { exact (andER (B :e (Arcs :\: Sing A)) (D = A :/\: B) HBpack). }
	      claim HzD2 : z :e A :/\: B.
	      { rewrite <- HDeq. exact HzD. }
	      exact (binintersectE1 A B z HzD2).
	    }
		    exact (andI
		      (IntPts A c= A)
		      (finite (IntPts A))
		      HIntPts_sub
		      HIntPts_fin).
		  }
		  (** Reverse direction infrastructure: for any p∈A, the set A\\(IntPts(A)\\{p}) is open in A. **)
		  claim Hneigh_open_in_arc :
		    forall A p:set,
		      A :e Arcs ->
		      p :e A ->
		      let TA := subspace_topology X Tx A in
		      let N := A :\: ((IntPts A) :\: Sing p) in
		      N :e TA /\ p :e N.
		  {
		    let A p.
		    assume HAArcs HpA.
		    set TA := subspace_topology X Tx A.
		    set N := A :\: ((IntPts A) :\: Sing p).
		    claim HAdat : A c= X /\ arc A TA.
		    { exact (HarcDat A HAArcs). }
		    claim HAsubX : A c= X.
		    { exact (andEL (A c= X) (arc A TA) HAdat). }
		    claim HarcA : arc A TA.
		    { exact (andER (A c= X) (arc A TA) HAdat). }
		    claim HtopA : topology_on A TA.
		    { exact (subspace_topology_is_topology X Tx A HtopX HAsubX). }
		    (** unit_interval is Hausdorff as a subspace of R; hence any arc is Hausdorff. **)
		    claim HUIHaus : Hausdorff_space unit_interval unit_interval_topology.
		    {
		      claim HsubR : unit_interval c= R.
		      {
		        exact (Sep_Subq
		          R
		          (fun x0:set => ~ (Rlt x0 0) /\ ~ (Rlt 1 x0))).
		      }
		      exact (ex17_12_subspace_Hausdorff
		        R
		        R_standard_topology
		        unit_interval
		        R_standard_topology_Hausdorff
		        HsubR).
		    }
		    claim HHausA : Hausdorff_space A TA.
		    {
		      apply HarcA.
		      let f.
		      assume Hhome.
		      claim Hexg : exists g:set, homeomorphism A TA unit_interval unit_interval_topology g.
		      {
		        exact (homeomorphism_inverse_is_homeomorphism_variant
		          unit_interval
		          unit_interval_topology
		          A
		          TA
		          f
		          Hhome).
		      }
		      apply Hexg.
		      let g.
		      assume HgHome.
		      exact (homeomorphism_preserves_Hausdorff
		        A
		        TA
		        unit_interval
		        unit_interval_topology
		        g
		        HgHome
		        HUIHaus).
		    }
		    claim HIntA : IntPts A c= A /\ finite (IntPts A).
		    { exact (HIntPts_dat A HAArcs). }
		    claim HIntAsub : IntPts A c= A.
		    { exact (andEL (IntPts A c= A) (finite (IntPts A)) HIntA). }
		    claim HIntAfin : finite (IntPts A).
		    { exact (andER (IntPts A c= A) (finite (IntPts A)) HIntA). }
		    claim HremSub : (IntPts A :\: Sing p) c= A.
		    {
		      exact (Subq_tra
		        (IntPts A :\: Sing p)
		        (IntPts A)
		        A
		        (setminus_Subq (IntPts A) (Sing p))
		        HIntAsub).
		    }
		    claim HremFin : finite (IntPts A :\: Sing p).
		    {
		      apply (Subq_finite (IntPts A) HIntAfin (IntPts A :\: Sing p)).
		      exact (setminus_Subq (IntPts A) (Sing p)).
		    }
		    claim HremClosed : closed_in A TA (IntPts A :\: Sing p).
		    {
		      exact (finite_sets_closed_in_Hausdorff
		        A
		        TA
		        HHausA
		        (IntPts A :\: Sing p)
		        HremSub
		        HremFin).
		    }
		    claim HNopen : N :e TA.
		    {
		      exact (open_in_elem
		        A
		        TA
		        (A :\: (IntPts A :\: Sing p))
		        (open_of_closed_complement
		          A
		          TA
		          (IntPts A :\: Sing p)
		          HremClosed)).
		    }
		    claim HpN : p :e N.
		    {
		      claim HpNotRem : p /:e (IntPts A :\: Sing p).
		      {
		        assume Hbad.
		        claim HnotSing : p /:e (Sing p).
		        { exact (setminusE2 (IntPts A) (Sing p) p Hbad). }
		        exact (HnotSing (SingI p)).
		      }
		      exact (setminusI A (IntPts A :\: Sing p) p HpA HpNotRem).
		    }
		    exact (andI (N :e TA) (p :e N) HNopen HpN).
		  }
		  (** Hausdorff proof: build disjoint open neighborhoods via coherence. **)
		  claim HHausX2 : Hausdorff_space X Tx.
		  {
		    claim Hsep :
		      forall x1 x2 : set,
		        x1 :e X -> x2 :e X -> x1 <> x2 ->
		        exists U V : set,
		          U :e Tx /\ V :e Tx /\ x1 :e U /\ x2 :e V /\ U :/\: V = Empty.
		    {
		      let x y.
		      assume HxX HyX Hxyneq.
		      (** Split on whether x and y lie in a common arc. **)
			      apply xm (exists A:set, A :e Arcs /\ x :e A /\ y :e A).
			      + assume HexCommon.
			        (** Common-arc case: the unique arc containing both x and y yields separation. **)
			        apply HexCommon.
			        let A0.
			        assume HA0pack.
			        claim HA0x : A0 :e Arcs /\ x :e A0.
			        { exact (andEL (A0 :e Arcs /\ x :e A0) (y :e A0) HA0pack). }
			        claim HA0Arcs : A0 :e Arcs.
			        { exact (andEL (A0 :e Arcs) (x :e A0) HA0x). }
			        claim HxA0 : x :e A0.
			        { exact (andER (A0 :e Arcs) (x :e A0) HA0x). }
			        claim HyA0 : y :e A0.
			        { exact (andER (A0 :e Arcs /\ x :e A0) (y :e A0) HA0pack). }
			        (** Uniqueness: no other arc can contain both x and y, by the intersection hypothesis. **)
			        claim Hunique :
			          forall B:set, B :e Arcs -> x :e B -> y :e B -> B = A0.
			        {
			          let B.
			          assume HBArcs HxB HyB.
			          apply xm (B = A0).
			          - assume Heq. exact Heq.
			          - assume Hneq : ~(B = A0).
			            claim HinterCase :
			              exists p:set, (B :/\: A0 = Empty \/ B :/\: A0 = Sing p).
			            { exact (HinterDat B A0 HBArcs HA0Arcs Hneq). }
			            apply HinterCase.
			            let p.
			            assume Hcase.
			            apply Hcase.
				            { assume Hem.
				              claim HxE : x :e Empty.
				              { rewrite <- Hem. exact (binintersectI B A0 x HxB HxA0). }
				              exact (FalseE (EmptyE x HxE False) (B = A0)). }
				            { assume Hsing.
			              claim HxSingp : x :e Sing p.
			              { rewrite <- Hsing. exact (binintersectI B A0 x HxB HxA0). }
			              claim Hyp : y :e Sing p.
			              { rewrite <- Hsing. exact (binintersectI B A0 y HyB HyA0). }
			              claim Hxp : x = p.
			              { exact (SingE p x HxSingp). }
			              claim Hyp0 : y = p.
			              { exact (SingE p y Hyp). }
			              claim Hxy : x = y.
			              { rewrite Hxp. symmetry. exact Hyp0. }
				              exact (FalseE (Hxyneq Hxy) (B = A0)). }
			        }
			        (** Setup on A0: it is Hausdorff (as an arc) and we can separate x and y inside it. **)
			        set TA0 := subspace_topology X Tx A0.
			        claim HA0dat : A0 c= X /\ arc A0 TA0.
			        { exact (HarcDat A0 HA0Arcs). }
			        claim HA0subX : A0 c= X.
			        { exact (andEL (A0 c= X) (arc A0 TA0) HA0dat). }
			        claim HarcA0 : arc A0 TA0.
			        { exact (andER (A0 c= X) (arc A0 TA0) HA0dat). }
			        (** unit_interval is Hausdorff as a subspace of R. **)
			        claim HUIHaus : Hausdorff_space unit_interval unit_interval_topology.
			        {
			          claim HsubR : unit_interval c= R.
			          { exact (Sep_Subq R (fun x0:set => ~ (Rlt x0 0) /\ ~ (Rlt 1 x0))). }
			          exact (ex17_12_subspace_Hausdorff
			            R
			            R_standard_topology
			            unit_interval
			            R_standard_topology_Hausdorff
			            HsubR).
			        }
			        claim HHausA0 : Hausdorff_space A0 TA0.
			        {
			          apply HarcA0.
			          let f.
			          assume Hhome.
			          claim Hexg : exists g:set, homeomorphism A0 TA0 unit_interval unit_interval_topology g.
			          {
			            exact (homeomorphism_inverse_is_homeomorphism_variant
			              unit_interval
			              unit_interval_topology
			              A0
			              TA0
			              f
			              Hhome).
			          }
			          apply Hexg.
			          let g.
			          assume HgHome.
			          exact (homeomorphism_preserves_Hausdorff
			            A0
			            TA0
			            unit_interval
			            unit_interval_topology
			            g
			            HgHome
			            HUIHaus).
			        }
			        claim HexUV0 :
			          exists U0 V0:set,
			            U0 :e TA0 /\ V0 :e TA0 /\ x :e U0 /\ y :e V0 /\ U0 :/\: V0 = Empty.
			        { exact (Hausdorff_space_separation A0 TA0 x y HHausA0 HxA0 HyA0 Hxyneq). }
			        apply HexUV0.
			        let U0.
			        assume HexV0.
			        apply HexV0.
			        let V0.
			        assume HUV0pack.
			        (** Notation: arc-neighborhoods Nx,Ny remove all intersection points except the basepoint. **)
			        set Nx := fun A:set => A :\: (IntPts A :\: Sing x).
			        set Ny := fun A:set => A :\: (IntPts A :\: Sing y).
				        claim HUVa : ((U0 :e TA0 /\ V0 :e TA0) /\ x :e U0) /\ y :e V0.
				        { exact (andEL (((U0 :e TA0 /\ V0 :e TA0) /\ x :e U0) /\ y :e V0) (U0 :/\: V0 = Empty) HUV0pack). }
				        claim HU0V0Empty : U0 :/\: V0 = Empty.
				        { exact (andER (((U0 :e TA0 /\ V0 :e TA0) /\ x :e U0) /\ y :e V0) (U0 :/\: V0 = Empty) HUV0pack). }
				        claim HUVb : (U0 :e TA0 /\ V0 :e TA0) /\ x :e U0.
				        { exact (andEL ((U0 :e TA0 /\ V0 :e TA0) /\ x :e U0) (y :e V0) HUVa). }
				        claim HyV0 : y :e V0.
				        { exact (andER ((U0 :e TA0 /\ V0 :e TA0) /\ x :e U0) (y :e V0) HUVa). }
				        claim HUVc : U0 :e TA0 /\ V0 :e TA0.
				        { exact (andEL (U0 :e TA0 /\ V0 :e TA0) (x :e U0) HUVb). }
				        claim HxU0 : x :e U0.
				        { exact (andER (U0 :e TA0 /\ V0 :e TA0) (x :e U0) HUVb). }
				        claim HU0in : U0 :e TA0.
				        { exact (andEL (U0 :e TA0) (V0 :e TA0) HUVc). }
				        claim HV0in : V0 :e TA0.
				        { exact (andER (U0 :e TA0) (V0 :e TA0) HUVc). }
			        claim HNxA0pack : Nx A0 :e TA0 /\ x :e Nx A0.
			        { exact (Hneigh_open_in_arc A0 x HA0Arcs HxA0). }
			        claim HNyA0pack : Ny A0 :e TA0 /\ y :e Ny A0.
			        { exact (Hneigh_open_in_arc A0 y HA0Arcs HyA0). }
			        claim HtopA0 : topology_on A0 TA0.
			        { exact (Hausdorff_space_topology A0 TA0 HHausA0). }
			        claim HNxA0 : Nx A0 :e TA0.
			        { exact (andEL (Nx A0 :e TA0) (x :e Nx A0) HNxA0pack). }
			        claim HxNxA0 : x :e Nx A0.
			        { exact (andER (Nx A0 :e TA0) (x :e Nx A0) HNxA0pack). }
			        claim HNyA0 : Ny A0 :e TA0.
			        { exact (andEL (Ny A0 :e TA0) (y :e Ny A0) HNyA0pack). }
			        claim HyNyA0 : y :e Ny A0.
			        { exact (andER (Ny A0 :e TA0) (y :e Ny A0) HNyA0pack). }
			        set Ux := U0 :/\: (Nx A0).
			        set Vy := V0 :/\: (Ny A0).
			        claim HUxIn : Ux :e TA0.
			        {
			          exact (topology_binintersect_closed
			            A0
			            TA0
			            U0
			            (Nx A0)
			            HtopA0
			            HU0in
			            HNxA0).
			        }
			        claim HVyIn : Vy :e TA0.
			        {
			          exact (topology_binintersect_closed
			            A0
			            TA0
			            V0
			            (Ny A0)
			            HtopA0
			            HV0in
			            HNyA0).
			        }
			        claim HxUx : x :e Ux.
			        { exact (binintersectI U0 (Nx A0) x HxU0 HxNxA0). }
			        claim HyVy : y :e Vy.
			        { exact (binintersectI V0 (Ny A0) y HyV0 HyNyA0). }
			        (** Build global neighborhoods by adding Nx/Ny on all other incident arcs, to ensure coherence. **)
			        set ArcsX := {A :e Arcs|x :e A}.
			        set ArcsY := {A :e Arcs|y :e A}.
			        set ArcsXrest := ArcsX :\: Sing A0.
			        set ArcsYrest := ArcsY :\: Sing A0.
			        set FamXrest := Repl ArcsXrest (fun A:set => Nx A).
			        set FamYrest := Repl ArcsYrest (fun A:set => Ny A).
			        set Urest := Union FamXrest.
			        set Vrest := Union FamYrest.
			        set U := Ux :\/: Urest.
			        set V := Vy :\/: Vrest.
			        (** U is open by coherence. **)
			        claim HUsubX : U c= X.
			        {
			          let z.
			          assume HzU.
			          apply (binunionE Ux Urest z HzU).
			          - assume HzUx.
			            claim HzNxA0 : z :e Nx A0.
			            { exact (binintersectE2 U0 (Nx A0) z HzUx). }
			            claim HzA0 : z :e A0.
			            { exact (setminusE1 A0 (IntPts A0 :\: Sing x) z HzNxA0). }
			            exact (HA0subX z HzA0).
			          - assume HzUr.
			            apply (UnionE FamXrest z HzUr).
			            let D.
			            assume HDpack.
			            claim HzD : z :e D.
			            { exact (andEL (z :e D) (D :e FamXrest) HDpack). }
			            claim HDin : D :e FamXrest.
			            { exact (andER (z :e D) (D :e FamXrest) HDpack). }
			            apply (ReplE ArcsXrest (fun A:set => Nx A) D HDin).
			            let B.
			            assume HBpair.
			            claim HBin : B :e ArcsXrest.
			            { exact (andEL (B :e ArcsXrest) (D = Nx B) HBpair). }
			            claim HDeq : D = Nx B.
			            { exact (andER (B :e ArcsXrest) (D = Nx B) HBpair). }
			            claim HzNxB : z :e Nx B.
			            { rewrite <- HDeq. exact HzD. }
			            claim HzB : z :e B.
			            { exact (setminusE1 B (IntPts B :\: Sing x) z HzNxB). }
			            claim HBArcsX : B :e ArcsX.
			            { exact (setminusE1 ArcsX (Sing A0) B HBin). }
			            claim HBArcs : B :e Arcs.
			            { exact (SepE1 Arcs (fun A1:set => x :e A1) B HBArcsX). }
			            claim HBdat : B c= X /\ arc B (subspace_topology X Tx B).
			            { exact (HarcDat B HBArcs). }
			            claim HBsubX : B c= X.
			            { exact (andEL (B c= X) (arc B (subspace_topology X Tx B)) HBdat). }
			            exact (HBsubX z HzB).
			        }
			        claim HUopen : U :e Tx.
			        {
			          claim HUArcsOpen :
			            forall A:set, A :e Arcs -> U :/\: A :e subspace_topology X Tx A.
			          {
			            let A.
			            assume HAArcs.
			            set TA := subspace_topology X Tx A.
			            claim HAdat : A c= X /\ arc A TA.
			            { exact (HarcDat A HAArcs). }
			            claim HAsubX : A c= X.
			            { exact (andEL (A c= X) (arc A TA) HAdat). }
			            claim HtopA : topology_on A TA.
			            { exact (subspace_topology_is_topology X Tx A HtopX HAsubX). }
			            apply xm (A = A0).
			            - assume HAeq.
			              (** U∩A0 = Ux **)
			              claim HUAeq : U :/\: A = Ux.
			              {
			                rewrite HAeq.
			                apply set_ext.
			                + let z.
			                  assume HzUA0.
			                  claim HzU0 : z :e U.
			                  { exact (binintersectE1 U A0 z HzUA0). }
			                  claim HzA00 : z :e A0.
			                  { exact (binintersectE2 U A0 z HzUA0). }
			                  apply (binunionE Ux Urest z HzU0).
			                  - assume HzUx. exact HzUx.
			                  - assume HzUr.
			                    apply (UnionE FamXrest z HzUr).
			                    let D.
			                    assume HDpack.
			                    claim HzD : z :e D.
			                    { exact (andEL (z :e D) (D :e FamXrest) HDpack). }
			                    claim HDin : D :e FamXrest.
			                    { exact (andER (z :e D) (D :e FamXrest) HDpack). }
			                    apply (ReplE ArcsXrest (fun A1:set => Nx A1) D HDin).
			                    let B.
			                    assume HBpair.
			                    claim HBin : B :e ArcsXrest.
			                    { exact (andEL (B :e ArcsXrest) (D = Nx B) HBpair). }
			                    claim HDeq : D = Nx B.
			                    { exact (andER (B :e ArcsXrest) (D = Nx B) HBpair). }
			                    claim HBArcsX : B :e ArcsX.
			                    { exact (setminusE1 ArcsX (Sing A0) B HBin). }
			                    claim HBArcs : B :e Arcs.
			                    { exact (SepE1 Arcs (fun A2:set => x :e A2) B HBArcsX). }
			                    claim HxB : x :e B.
			                    { exact (SepE2 Arcs (fun A2:set => x :e A2) B HBArcsX). }
			                    claim HneqBA0 : ~(B = A0).
			                    {
			                      assume Heq.
			                      claim HBsing : B :e Sing A0.
			                      { rewrite Heq. exact (SingI A0). }
			                      claim HnotIn : B /:e Sing A0.
			                      { exact (setminusE2 ArcsX (Sing A0) B HBin). }
			                      exact (HnotIn HBsing).
			                    }
			                    claim HneqBA0i : B <> A0.
			                    { exact HneqBA0. }
			                    claim HzNxB : z :e Nx B.
			                    { rewrite <- HDeq. exact HzD. }
			                    claim HzB : z :e B.
			                    { exact (setminusE1 B (IntPts B :\: Sing x) z HzNxB). }
			                    claim HzBA0 : z :e B :/\: A0.
			                    { exact (binintersectI B A0 z HzB HzA00). }
			                    (** Use intersection hypothesis to show z=x. **)
			                    claim HinterBA0 :
			                      exists p:set, (B :/\: A0 = Empty \/ B :/\: A0 = Sing p).
			                    { exact (HinterDat B A0 HBArcs HA0Arcs HneqBA0). }
			                    apply HinterBA0.
			                    let p.
			                    assume Hcase.
			                    apply Hcase.
				                    { assume Hem.
				                      claim HzE : z :e Empty.
				                      { rewrite <- Hem. exact HzBA0. }
				                      exact (FalseE (EmptyE z HzE False) (z :e Ux)). }
			                    { assume Hsing.
			                      claim HzSingp : z :e Sing p.
			                      { rewrite <- Hsing. exact HzBA0. }
			                      claim Hxp : x = p.
			                      {
			                        claim HxSingp : x :e Sing p.
			                        { rewrite <- Hsing. exact (binintersectI B A0 x HxB HxA0). }
			                        exact (SingE p x HxSingp).
			                      }
			                      claim Hzp : z = p.
			                      { exact (SingE p z HzSingp). }
				                      claim Hzx : z = x.
				                      { rewrite Hzp. symmetry. exact Hxp. }
				                      rewrite Hzx. exact HxUx. }
				                + let z.
				                  assume HzUx.
				                  claim HzU0 : z :e U.
			                  { exact (binunionI1 Ux Urest z HzUx). }
			                  claim HzA00 : z :e A0.
			                  {
			                    claim HzNxA0 : z :e Nx A0.
			                    { exact (binintersectE2 U0 (Nx A0) z HzUx). }
			                    exact (setminusE1 A0 (IntPts A0 :\: Sing x) z HzNxA0).
			                  }
			                  exact (binintersectI U A0 z HzU0 HzA00).
			              }
			              rewrite HUAeq.
			              (** Ux is open in A0, hence in TA. **)
			              rewrite HAeq.
			              exact HUxIn.
			            - assume HAneq : ~(A = A0).
			              apply xm (x :e A).
			              + assume HxA.
			                (** U∩A = Nx A **)
			                claim HUAeq : U :/\: A = Nx A.
			                {
			                  apply set_ext.
			                  + let z.
			                    assume HzUA.
			                    claim HzU0 : z :e U.
			                    { exact (binintersectE1 U A z HzUA). }
			                    claim HzA0 : z :e A.
			                    { exact (binintersectE2 U A z HzUA). }
			                    apply (binunionE Ux Urest z HzU0).
			                    - assume HzUx.
			                      (** If z comes from Ux (subset A0), then z=x and hence in Nx A. **)
			                      claim HzNxA0 : z :e Nx A0.
			                      { exact (binintersectE2 U0 (Nx A0) z HzUx). }
			                      claim HzA00 : z :e A0.
			                      { exact (setminusE1 A0 (IntPts A0 :\: Sing x) z HzNxA0). }
			                      claim HzAA0 : z :e A :/\: A0.
			                      { exact (binintersectI A A0 z HzA0 HzA00). }
			                      claim HinterAA0 :
			                        exists p:set, (A :/\: A0 = Empty \/ A :/\: A0 = Sing p).
			                      { exact (HinterDat A A0 HAArcs HA0Arcs HAneq). }
			                      apply HinterAA0.
			                      let p.
			                      assume Hcase.
			                      apply Hcase.
				                      { assume Hem.
				                        claim HzE : z :e Empty.
				                        { rewrite <- Hem. exact HzAA0. }
				                        exact (FalseE (EmptyE z HzE False) (z :e Nx A)). }
			                      { assume Hsing.
			                        claim HxSingp : x :e Sing p.
			                        { rewrite <- Hsing. exact (binintersectI A A0 x HxA HxA0). }
			                        claim Hxp : x = p.
			                        { exact (SingE p x HxSingp). }
			                        claim HzSingp : z :e Sing p.
			                        { rewrite <- Hsing. exact HzAA0. }
			                        claim Hzp : z = p.
			                        { exact (SingE p z HzSingp). }
				                        claim Hzx : z = x.
				                        { rewrite Hzp. symmetry. exact Hxp. }
				                        rewrite Hzx.
				                        claim HxNotRem : x /:e (IntPts A :\: Sing x).
				                        {
				                          assume Hbad.
				                          claim HxNotSing : x /:e Sing x.
				                          { exact (setminusE2 (IntPts A) (Sing x) x Hbad). }
				                          exact (HxNotSing (SingI x)).
				                        }
				                        exact (setminusI A (IntPts A :\: Sing x) x HxA HxNotRem).
				                      }
			                    - assume HzUr.
			                      (** z comes from some Nx B with x∈B and B≠A0; either B=A or z=x **)
			                      apply (UnionE FamXrest z HzUr).
			                      let D.
			                      assume HDpack.
			                      claim HzD : z :e D.
			                      { exact (andEL (z :e D) (D :e FamXrest) HDpack). }
			                      claim HDin : D :e FamXrest.
			                      { exact (andER (z :e D) (D :e FamXrest) HDpack). }
			                      apply (ReplE ArcsXrest (fun A1:set => Nx A1) D HDin).
			                      let B.
			                      assume HBpair.
			                      claim HBin : B :e ArcsXrest.
			                      { exact (andEL (B :e ArcsXrest) (D = Nx B) HBpair). }
			                      claim HDeq : D = Nx B.
			                      { exact (andER (B :e ArcsXrest) (D = Nx B) HBpair). }
			                      claim HzNxB : z :e Nx B.
			                      { rewrite <- HDeq. exact HzD. }
			                      claim HzB : z :e B.
			                      { exact (setminusE1 B (IntPts B :\: Sing x) z HzNxB). }
			                      apply xm (B = A).
			                      * assume HBA. rewrite <- HBA. exact HzNxB.
			                      * assume HBAneq : ~(B = A).
			                        claim HneqBA : B <> A.
			                        { exact HBAneq. }
			                        claim HzAB : z :e A :/\: B.
			                        { exact (binintersectI A B z HzA0 HzB). }
				                        claim HinterAB :
				                          exists p:set, (A :/\: B = Empty \/ A :/\: B = Sing p).
				                        { exact (HinterDat A B HAArcs (SepE1 Arcs (fun A2:set => x :e A2) B (setminusE1 ArcsX (Sing A0) B HBin)) (neq_i_sym B A HneqBA)). }
			                        apply HinterAB.
			                        let p.
			                        assume Hcase.
			                        apply Hcase.
				                        { assume Hem.
				                          claim HzE : z :e Empty.
				                          { rewrite <- Hem. exact HzAB. }
				                          exact (FalseE (EmptyE z HzE False) (z :e Nx A)). }
			                        { assume Hsing.
			                          claim HxSingp : x :e Sing p.
			                          {
			                            claim HxB : x :e B.
			                            { exact (SepE2 Arcs (fun A2:set => x :e A2) B (setminusE1 ArcsX (Sing A0) B HBin)). }
			                            rewrite <- Hsing.
			                            exact (binintersectI A B x HxA HxB).
			                          }
			                          claim Hxp : x = p.
			                          { exact (SingE p x HxSingp). }
			                          claim HzSingp : z :e Sing p.
			                          { rewrite <- Hsing. exact HzAB. }
			                          claim Hzp : z = p.
			                          { exact (SingE p z HzSingp). }
				                          claim Hzx : z = x.
				                          { rewrite Hzp. symmetry. exact Hxp. }
				                          rewrite Hzx.
				                          claim HxNotRem : x /:e (IntPts A :\: Sing x).
				                          {
				                            assume Hbad.
				                            claim HxNotSing : x /:e Sing x.
				                            { exact (setminusE2 (IntPts A) (Sing x) x Hbad). }
				                            exact (HxNotSing (SingI x)).
					                          }
					                          exact (setminusI A (IntPts A :\: Sing x) x HxA HxNotRem).
					                        }
				                  + let z.
				                    assume HzNx.
				                    claim HAxIn : A :e ArcsXrest.
				                    {
				                      claim HAx : A :e ArcsX.
				                      { exact (SepI Arcs (fun A1:set => x :e A1) A HAArcs HxA). }
				                      apply (setminusI ArcsX (Sing A0) A HAx).
				                      assume HAinSing.
				                      claim HAeq0 : A = A0.
				                      { exact (SingE A0 A HAinSing). }
				                      exact (HAneq HAeq0).
				                    }
			                    claim HNxIn : Nx A :e FamXrest.
			                    { exact (ReplI ArcsXrest (fun A1:set => Nx A1) A HAxIn). }
			                    claim HzUr : z :e Urest.
			                    { exact (UnionI FamXrest z (Nx A) HzNx HNxIn). }
			                    claim HzU0 : z :e U.
			                    { exact (binunionI2 Ux Urest z HzUr). }
			                    claim HzA0 : z :e A.
			                    { exact (setminusE1 A (IntPts A :\: Sing x) z HzNx). }
			                    exact (binintersectI U A z HzU0 HzA0).
			                }
			                rewrite HUAeq.
			                claim HNdat : Nx A :e TA /\ x :e Nx A.
			                { exact (Hneigh_open_in_arc A x HAArcs HxA). }
			                exact (andEL (Nx A :e TA) (x :e Nx A) HNdat).
			              + assume HxNotA : ~(x :e A).
			                (** U∩A = Empty **)
			                claim HUAEmpty : U :/\: A = Empty.
			                {
			                  apply Empty_Subq_eq.
			                  let z.
			                  assume HzUA.
			                  claim HzU0 : z :e U.
			                  { exact (binintersectE1 U A z HzUA). }
			                  claim HzA0 : z :e A.
			                  { exact (binintersectE2 U A z HzUA). }
			                  apply (binunionE Ux Urest z HzU0).
			                  - assume HzUx.
			                    claim HzNxA0 : z :e Nx A0.
			                    { exact (binintersectE2 U0 (Nx A0) z HzUx). }
			                    claim HzA00 : z :e A0.
			                    { exact (setminusE1 A0 (IntPts A0 :\: Sing x) z HzNxA0). }
			                    claim HinterAA0 :
			                      exists p:set, (A :/\: A0 = Empty \/ A :/\: A0 = Sing p).
			                    { exact (HinterDat A A0 HAArcs HA0Arcs HAneq). }
			                    apply HinterAA0.
			                    let p.
			                    assume Hcase.
			                    apply Hcase.
			                    { assume Hem.
			                      claim HzE : z :e Empty.
			                      { rewrite <- Hem. exact (binintersectI A A0 z HzA0 HzA00). }
			                      exact (EmptyE z HzE (z :e Empty)). }
				                    { assume Hsing.
				                      claim HzSingp : z :e Sing p.
				                      { rewrite <- Hsing. exact (binintersectI A A0 z HzA0 HzA00). }
				                      claim Hzp : z = p.
				                      { exact (SingE p z HzSingp). }
				                      claim HzNxA0 : z :e Nx A0.
				                      { exact (binintersectE2 U0 (Nx A0) z HzUx). }
				                      claim HzNotRem : z /:e (IntPts A0 :\: Sing x).
				                      { exact (setminusE2 A0 (IntPts A0 :\: Sing x) z HzNxA0). }
				                      (** z is an intersection point of A0 with A, hence in IntPts(A0). **)
				                      claim HnotInSing : A /:e Sing A0.
				                      {
				                        assume HAin.
				                        claim HAeq0 : A = A0.
				                        { exact (SingE A0 A HAin). }
				                        exact (HAneq HAeq0).
				                      }
				                      claim HAin0 : A :e (Arcs :\: Sing A0).
				                      { exact (setminusI Arcs (Sing A0) A HAArcs HnotInSing). }
				                      claim HzA0A : z :e A0 :/\: A.
				                      { exact (binintersectI A0 A z HzA00 HzA0). }
				                      claim HcapIn : (A0 :/\: A) :e IntFam A0.
				                      { exact (ReplI (Arcs :\: Sing A0) (fun B0:set => A0 :/\: B0) A HAin0). }
				                      claim HzInt : z :e IntPts A0.
				                      { exact (UnionI (IntFam A0) z (A0 :/\: A) HzA0A HcapIn). }
					                      apply (xm (z = x)).
					                      - assume Hzx.
					                        claim HxA1 : x :e A.
					                        { rewrite <- Hzx. exact HzA0. }
					                        exact (FalseE (HxNotA HxA1) (z :e Empty)).
					                      - assume Hzneq : ~(z = x).
					                        claim HzNotSing : z /:e Sing x.
					                        {
					                          assume HzSing.
					                          claim Hzx : z = x.
				                          { exact (SingE x z HzSing). }
				                          exact (Hzneq Hzx).
				                        }
				                        claim HzRem : z :e IntPts A0 :\: Sing x.
				                        { exact (setminusI (IntPts A0) (Sing x) z HzInt HzNotSing). }
					                        exact (FalseE (HzNotRem HzRem) (z :e Empty)).
					                    }
			                  - assume HzUr.
			                    apply (UnionE FamXrest z HzUr).
			                    let D.
			                    assume HDpack.
			                    claim HzD : z :e D.
			                    { exact (andEL (z :e D) (D :e FamXrest) HDpack). }
			                    claim HDin : D :e FamXrest.
			                    { exact (andER (z :e D) (D :e FamXrest) HDpack). }
			                    apply (ReplE ArcsXrest (fun A1:set => Nx A1) D HDin).
			                    let B.
			                    assume HBpair.
			                    claim HBin : B :e ArcsXrest.
			                    { exact (andEL (B :e ArcsXrest) (D = Nx B) HBpair). }
			                    claim HDeq : D = Nx B.
			                    { exact (andER (B :e ArcsXrest) (D = Nx B) HBpair). }
			                    claim HzNxB : z :e Nx B.
			                    { rewrite <- HDeq. exact HzD. }
			                    claim HzB : z :e B.
			                    { exact (setminusE1 B (IntPts B :\: Sing x) z HzNxB). }
			                    claim HinterAB :
			                      exists p:set, (A :/\: B = Empty \/ A :/\: B = Sing p).
			                    {
				                      claim HBArcsX : B :e ArcsX.
				                      { exact (setminusE1 ArcsX (Sing A0) B HBin). }
				                      claim HBArcs : B :e Arcs.
				                      { exact (SepE1 Arcs (fun A2:set => x :e A2) B HBArcsX). }
				                      claim HxB : x :e B.
				                      { exact (SepE2 Arcs (fun A2:set => x :e A2) B HBArcsX). }
				                      claim HneqAB : A <> B.
				                      {
				                        assume Heq.
				                        claim HxA1 : x :e A.
				                        { rewrite Heq. exact HxB. }
				                        exact (HxNotA HxA1).
				                      }
				                      exact (HinterDat A B HAArcs HBArcs HneqAB).
				                    }
			                    apply HinterAB.
			                    let p.
			                    assume Hcase.
			                    apply Hcase.
					                    { assume Hem.
					                      claim HzE : z :e Empty.
					                      { rewrite <- Hem. exact (binintersectI A B z HzA0 HzB). }
					                      exact (EmptyE z HzE (z :e Empty)). }
					                    { assume Hsing.
					                      (** Since z is in A∩B and A<>B, z is an intersection point of B. **)
					                      claim HBArcsX : B :e ArcsX.
					                      { exact (setminusE1 ArcsX (Sing A0) B HBin). }
					                      claim HBArcs : B :e Arcs.
					                      { exact (SepE1 Arcs (fun A2:set => x :e A2) B HBArcsX). }
					                      claim HxB : x :e B.
					                      { exact (SepE2 Arcs (fun A2:set => x :e A2) B HBArcsX). }
					                      claim HneqAB : A <> B.
					                      {
					                        assume Heq.
					                        claim HxA1 : x :e A.
					                        { rewrite Heq. exact HxB. }
					                        exact (HxNotA HxA1).
					                      }
					                      claim HnotInSing : A /:e Sing B.
					                      {
					                        assume HAin.
					                        claim HAeq : A = B.
					                        { exact (SingE B A HAin). }
					                        exact (HneqAB HAeq).
					                      }
					                      claim HAin0 : A :e (Arcs :\: Sing B).
					                      { exact (setminusI Arcs (Sing B) A HAArcs HnotInSing). }
					                      claim HzBA : z :e B :/\: A.
					                      { exact (binintersectI B A z HzB HzA0). }
					                      claim HcapIn : (B :/\: A) :e IntFam B.
					                      { exact (ReplI (Arcs :\: Sing B) (fun C:set => B :/\: C) A HAin0). }
					                      claim HzInt : z :e IntPts B.
					                      { exact (UnionI (IntFam B) z (B :/\: A) HzBA HcapIn). }
					                      apply (xm (z = x)).
					                      - assume Hzx.
					                        claim HxA1 : x :e A.
					                        { rewrite <- Hzx. exact HzA0. }
					                        exact (FalseE (HxNotA HxA1) (z :e Empty)).
					                      - assume Hzneq : ~(z = x).
					                        claim HzNotSing : z /:e Sing x.
					                        {
					                          assume HzSing.
					                          claim Hzx : z = x.
					                          { exact (SingE x z HzSing). }
					                          exact (Hzneq Hzx).
					                        }
					                        claim HzRem : z :e IntPts B :\: Sing x.
					                        { exact (setminusI (IntPts B) (Sing x) z HzInt HzNotSing). }
					                        claim HzNotRem : z /:e (IntPts B :\: Sing x).
					                        { exact (setminusE2 B (IntPts B :\: Sing x) z HzNxB). }
					                        exact (FalseE (HzNotRem HzRem) (z :e Empty)).
					                    }
				                }
				                rewrite HUAEmpty.
				                exact (topology_has_empty A TA HtopA).
			          }
			          exact (coherence_open_backward U HUsubX HUArcsOpen).
			        }
				        (** V is open by coherence similarly. **)
				        claim HVsubX : V c= X.
				        {
				          let z.
				          assume HzV.
				          apply (binunionE Vy Vrest z HzV).
				          - assume HzVy.
				            claim HzNyA0 : z :e Ny A0.
				            { exact (binintersectE2 V0 (Ny A0) z HzVy). }
				            claim HzA0 : z :e A0.
				            { exact (setminusE1 A0 (IntPts A0 :\: Sing y) z HzNyA0). }
				            exact (HA0subX z HzA0).
				          - assume HzVr.
				            apply (UnionE FamYrest z HzVr).
				            let D.
				            assume HDpack.
				            claim HzD : z :e D.
				            { exact (andEL (z :e D) (D :e FamYrest) HDpack). }
				            claim HDin : D :e FamYrest.
				            { exact (andER (z :e D) (D :e FamYrest) HDpack). }
				            apply (ReplE ArcsYrest (fun A1:set => Ny A1) D HDin).
				            let B.
				            assume HBpair.
				            claim HBin : B :e ArcsYrest.
				            { exact (andEL (B :e ArcsYrest) (D = Ny B) HBpair). }
				            claim HDeq : D = Ny B.
				            { exact (andER (B :e ArcsYrest) (D = Ny B) HBpair). }
				            claim HzNyB : z :e Ny B.
				            { rewrite <- HDeq. exact HzD. }
				            claim HzB : z :e B.
				            { exact (setminusE1 B (IntPts B :\: Sing y) z HzNyB). }
				            claim HBArcsY : B :e ArcsY.
				            { exact (setminusE1 ArcsY (Sing A0) B HBin). }
				            claim HBArcs : B :e Arcs.
				            { exact (SepE1 Arcs (fun A1:set => y :e A1) B HBArcsY). }
				            claim HBdat : B c= X /\ arc B (subspace_topology X Tx B).
				            { exact (HarcDat B HBArcs). }
				            claim HBsubX : B c= X.
				            { exact (andEL (B c= X) (arc B (subspace_topology X Tx B)) HBdat). }
				            exact (HBsubX z HzB).
				        }
					        claim HVopen : V :e Tx.
					        {
					          claim HVArcsOpen :
					            forall A:set, A :e Arcs -> V :/\: A :e subspace_topology X Tx A.
					          {
					            let A.
					            assume HAArcs.
					            set TA := subspace_topology X Tx A.
					            claim HAdat : A c= X /\ arc A TA.
					            { exact (HarcDat A HAArcs). }
					            claim HAsubX : A c= X.
					            { exact (andEL (A c= X) (arc A TA) HAdat). }
					            claim HtopA : topology_on A TA.
					            { exact (subspace_topology_is_topology X Tx A HtopX HAsubX). }
					            apply xm (A = A0).
					            - assume HAeq.
					              (** V∩A0 = Vy **)
					              claim HVAeq : V :/\: A = Vy.
					              {
					                rewrite HAeq.
					                apply set_ext.
					                + let z.
					                  assume HzVA0.
					                  claim HzV0 : z :e V.
					                  { exact (binintersectE1 V A0 z HzVA0). }
					                  claim HzA00 : z :e A0.
					                  { exact (binintersectE2 V A0 z HzVA0). }
					                  apply (binunionE Vy Vrest z HzV0).
					                  - assume HzVy. exact HzVy.
					                  - assume HzVr.
					                    apply (UnionE FamYrest z HzVr).
					                    let D.
					                    assume HDpack.
					                    claim HzD : z :e D.
					                    { exact (andEL (z :e D) (D :e FamYrest) HDpack). }
					                    claim HDin : D :e FamYrest.
					                    { exact (andER (z :e D) (D :e FamYrest) HDpack). }
					                    apply (ReplE ArcsYrest (fun A1:set => Ny A1) D HDin).
					                    let B.
					                    assume HBpair.
					                    claim HBin : B :e ArcsYrest.
					                    { exact (andEL (B :e ArcsYrest) (D = Ny B) HBpair). }
					                    claim HDeq : D = Ny B.
					                    { exact (andER (B :e ArcsYrest) (D = Ny B) HBpair). }
					                    claim HzNyB : z :e Ny B.
					                    { rewrite <- HDeq. exact HzD. }
					                    claim HzB : z :e B.
					                    { exact (setminusE1 B (IntPts B :\: Sing y) z HzNyB). }
					                    claim HBArcsY : B :e ArcsY.
					                    { exact (setminusE1 ArcsY (Sing A0) B HBin). }
					                    claim HBArcs : B :e Arcs.
					                    { exact (SepE1 Arcs (fun A2:set => y :e A2) B HBArcsY). }
					                    claim HyB : y :e B.
					                    { exact (SepE2 Arcs (fun A2:set => y :e A2) B HBArcsY). }
					                    claim HneqBA0 : ~(B = A0).
					                    {
					                      assume Heq.
					                      claim HBsing : B :e Sing A0.
					                      { rewrite Heq. exact (SingI A0). }
					                      claim Hbad : B :e Sing A0.
					                      { exact HBsing. }
					                      exact ((setminusE2 ArcsY (Sing A0) B HBin) Hbad).
					                    }
					                    claim HinterBA0 :
					                      exists p:set, (B :/\: A0 = Empty \/ B :/\: A0 = Sing p).
					                    { exact (HinterDat B A0 HBArcs HA0Arcs HneqBA0). }
					                    apply HinterBA0.
					                    let p.
					                    assume Hcase.
					                    apply Hcase.
					                    { assume Hem.
					                      claim HyE : y :e Empty.
					                      { rewrite <- Hem. exact (binintersectI B A0 y HyB HyA0). }
					                      exact (FalseE (EmptyE y HyE False) (z :e Vy)). }
					                    { assume Hsing.
					                      claim HySingp : y :e Sing p.
					                      { rewrite <- Hsing. exact (binintersectI B A0 y HyB HyA0). }
					                      claim Hyp : y = p.
					                      { exact (SingE p y HySingp). }
					                      claim HzSingp : z :e Sing p.
					                      { rewrite <- Hsing. exact (binintersectI B A0 z HzB HzA00). }
					                      claim Hzp : z = p.
					                      { exact (SingE p z HzSingp). }
					                      claim Hzy : z = y.
					                      { rewrite Hzp. symmetry. exact Hyp. }
					                      rewrite Hzy.
					                      exact HyVy.
					                    }
					                + let z.
					                  assume HzVy.
					                  claim HzV0 : z :e V.
					                  { exact (binunionI1 Vy Vrest z HzVy). }
					                  claim HzA00 : z :e A0.
					                  {
					                    claim HzNyA0 : z :e Ny A0.
					                    { exact (binintersectE2 V0 (Ny A0) z HzVy). }
					                    exact (setminusE1 A0 (IntPts A0 :\: Sing y) z HzNyA0).
					                  }
					                  exact (binintersectI V A0 z HzV0 HzA00).
					              }
					              rewrite HVAeq.
					              (** Vy is open in A0, hence in TA. **)
					              rewrite HAeq.
					              exact HVyIn.
					            - assume HAneq : ~(A = A0).
					              apply xm (y :e A).
					              + assume HyA.
					                (** V∩A = Ny A **)
					                claim HVAeq : V :/\: A = Ny A.
					                {
					                  apply set_ext.
					                  + let z.
					                    assume HzVA.
					                    claim HzV0 : z :e V.
					                    { exact (binintersectE1 V A z HzVA). }
					                    claim HzA0 : z :e A.
					                    { exact (binintersectE2 V A z HzVA). }
					                    apply (binunionE Vy Vrest z HzV0).
					                    - assume HzVy.
					                      (** If z comes from Vy (subset A0), then z=y and hence in Ny A. **)
					                      claim HzNyA0 : z :e Ny A0.
					                      { exact (binintersectE2 V0 (Ny A0) z HzVy). }
					                      claim HzA00 : z :e A0.
					                      { exact (setminusE1 A0 (IntPts A0 :\: Sing y) z HzNyA0). }
					                      claim HzAA0 : z :e A :/\: A0.
					                      { exact (binintersectI A A0 z HzA0 HzA00). }
					                      claim HinterAA0 :
					                        exists p:set, (A :/\: A0 = Empty \/ A :/\: A0 = Sing p).
					                      { exact (HinterDat A A0 HAArcs HA0Arcs HAneq). }
					                      apply HinterAA0.
					                      let p.
					                      assume Hcase.
					                      apply Hcase.
					                      { assume Hem.
					                        claim HzE : z :e Empty.
					                        { rewrite <- Hem. exact HzAA0. }
					                        exact (FalseE (EmptyE z HzE False) (z :e Ny A)). }
					                      { assume Hsing.
					                        claim HySingp : y :e Sing p.
					                        { rewrite <- Hsing. exact (binintersectI A A0 y HyA HyA0). }
					                        claim Hyp : y = p.
					                        { exact (SingE p y HySingp). }
					                        claim HzSingp : z :e Sing p.
					                        { rewrite <- Hsing. exact HzAA0. }
					                        claim Hzp : z = p.
					                        { exact (SingE p z HzSingp). }
					                        claim Hzy : z = y.
					                        { rewrite Hzp. symmetry. exact Hyp. }
					                        rewrite Hzy.
					                        claim HyNotRem : y /:e (IntPts A :\: Sing y).
					                        {
					                          assume Hbad.
					                          claim HyNotSing : y /:e Sing y.
					                          { exact (setminusE2 (IntPts A) (Sing y) y Hbad). }
					                          exact (HyNotSing (SingI y)).
					                        }
					                        exact (setminusI A (IntPts A :\: Sing y) y HyA HyNotRem).
					                      }
					                    - assume HzVr.
					                      (** z comes from some Ny B with y∈B and B≠A0; either B=A or z=y **)
					                      apply (UnionE FamYrest z HzVr).
					                      let D.
					                      assume HDpack.
					                      claim HzD : z :e D.
					                      { exact (andEL (z :e D) (D :e FamYrest) HDpack). }
					                      claim HDin : D :e FamYrest.
					                      { exact (andER (z :e D) (D :e FamYrest) HDpack). }
					                      apply (ReplE ArcsYrest (fun A1:set => Ny A1) D HDin).
					                      let B.
					                      assume HBpair.
					                      claim HBin : B :e ArcsYrest.
					                      { exact (andEL (B :e ArcsYrest) (D = Ny B) HBpair). }
					                      claim HDeq : D = Ny B.
					                      { exact (andER (B :e ArcsYrest) (D = Ny B) HBpair). }
					                      claim HzNyB : z :e Ny B.
					                      { rewrite <- HDeq. exact HzD. }
					                      claim HzB : z :e B.
					                      { exact (setminusE1 B (IntPts B :\: Sing y) z HzNyB). }
					                      apply xm (B = A).
					                      * assume HBA. rewrite <- HBA. exact HzNyB.
					                      * assume HBAneq : ~(B = A).
					                        claim HneqBA : B <> A.
					                        { exact HBAneq. }
					                        claim HBArcsY : B :e ArcsY.
					                        { exact (setminusE1 ArcsY (Sing A0) B HBin). }
					                        claim HBArcs : B :e Arcs.
					                        { exact (SepE1 Arcs (fun A2:set => y :e A2) B HBArcsY). }
					                        claim HyB : y :e B.
					                        { exact (SepE2 Arcs (fun A2:set => y :e A2) B HBArcsY). }
					                        claim HinterAB :
					                          exists p:set, (A :/\: B = Empty \/ A :/\: B = Sing p).
						                        {
						                          claim HneqAB : A <> B.
						                          { exact (neq_i_sym B A HneqBA). }
						                          exact (HinterDat A B HAArcs HBArcs HneqAB).
						                        }
					                        apply HinterAB.
					                        let p.
					                        assume Hcase.
					                        apply Hcase.
					                        { assume Hem.
					                          claim HzE : z :e Empty.
					                          { rewrite <- Hem. exact (binintersectI A B z HzA0 HzB). }
					                          exact (FalseE (EmptyE z HzE False) (z :e Ny A)). }
					                        { assume Hsing.
					                          claim HySingp : y :e Sing p.
					                          { rewrite <- Hsing. exact (binintersectI A B y HyA HyB). }
					                          claim Hyp : y = p.
					                          { exact (SingE p y HySingp). }
					                          claim HzSingp : z :e Sing p.
					                          { rewrite <- Hsing. exact (binintersectI A B z HzA0 HzB). }
					                          claim Hzp : z = p.
					                          { exact (SingE p z HzSingp). }
					                          claim Hzy : z = y.
					                          { rewrite Hzp. symmetry. exact Hyp. }
					                          rewrite Hzy.
					                          claim HyNotRem : y /:e (IntPts A :\: Sing y).
					                          {
					                            assume Hbad.
					                            claim HyNotSing : y /:e Sing y.
					                            { exact (setminusE2 (IntPts A) (Sing y) y Hbad). }
					                            exact (HyNotSing (SingI y)).
					                          }
					                          exact (setminusI A (IntPts A :\: Sing y) y HyA HyNotRem).
					                        }
					                + let z.
					                  assume HzNy.
					                  claim HAyIn : A :e ArcsYrest.
					                  {
					                    claim HAy : A :e ArcsY.
					                    { exact (SepI Arcs (fun A1:set => y :e A1) A HAArcs HyA). }
					                    apply (setminusI ArcsY (Sing A0) A HAy).
					                    assume HAinSing.
					                    claim HAeq0 : A = A0.
					                    { exact (SingE A0 A HAinSing). }
					                    exact (HAneq HAeq0).
					                  }
					                  claim HNyIn : Ny A :e FamYrest.
					                  { exact (ReplI ArcsYrest (fun A1:set => Ny A1) A HAyIn). }
					                  claim HzVr : z :e Vrest.
					                  { exact (UnionI FamYrest z (Ny A) HzNy HNyIn). }
					                  claim HzV0 : z :e V.
					                  { exact (binunionI2 Vy Vrest z HzVr). }
					                  claim HzA0 : z :e A.
					                  { exact (setminusE1 A (IntPts A :\: Sing y) z HzNy). }
					                  exact (binintersectI V A z HzV0 HzA0).
					                }
					                rewrite HVAeq.
					                claim HNdat : Ny A :e TA /\ y :e Ny A.
					                { exact (Hneigh_open_in_arc A y HAArcs HyA). }
					                exact (andEL (Ny A :e TA) (y :e Ny A) HNdat).
					              + assume HyNotA : ~(y :e A).
					                (** V∩A = Empty **)
					                claim HVAEmpty : V :/\: A = Empty.
					                {
					                  apply Empty_Subq_eq.
					                  let z.
					                  assume HzVA.
					                  claim HzV0 : z :e V.
					                  { exact (binintersectE1 V A z HzVA). }
					                  claim HzA0 : z :e A.
					                  { exact (binintersectE2 V A z HzVA). }
					                  apply (binunionE Vy Vrest z HzV0).
					                  - assume HzVy.
					                    claim HzNyA0 : z :e Ny A0.
					                    { exact (binintersectE2 V0 (Ny A0) z HzVy). }
					                    claim HzA00 : z :e A0.
					                    { exact (setminusE1 A0 (IntPts A0 :\: Sing y) z HzNyA0). }
					                    claim HinterAA0 :
					                      exists p:set, (A :/\: A0 = Empty \/ A :/\: A0 = Sing p).
					                    { exact (HinterDat A A0 HAArcs HA0Arcs HAneq). }
					                    apply HinterAA0.
					                    let p.
					                    assume Hcase.
					                    apply Hcase.
					                    { assume Hem.
					                      claim HzE : z :e Empty.
					                      { rewrite <- Hem. exact (binintersectI A A0 z HzA0 HzA00). }
					                      exact (EmptyE z HzE (z :e Empty)). }
					                    { assume Hsing.
					                      claim HzSingp : z :e Sing p.
					                      { rewrite <- Hsing. exact (binintersectI A A0 z HzA0 HzA00). }
					                      claim Hzp : z = p.
					                      { exact (SingE p z HzSingp). }
					                      claim HzNyA0 : z :e Ny A0.
					                      { exact (binintersectE2 V0 (Ny A0) z HzVy). }
					                      claim HzNotRem : z /:e (IntPts A0 :\: Sing y).
					                      { exact (setminusE2 A0 (IntPts A0 :\: Sing y) z HzNyA0). }
					                      (** z is an intersection point of A0 with A, hence in IntPts(A0). **)
					                      claim HnotInSing : A /:e Sing A0.
					                      {
					                        assume HAin.
					                        claim HAeq0 : A = A0.
					                        { exact (SingE A0 A HAin). }
					                        exact (HAneq HAeq0).
					                      }
					                      claim HAin0 : A :e (Arcs :\: Sing A0).
					                      { exact (setminusI Arcs (Sing A0) A HAArcs HnotInSing). }
					                      claim HzA0A : z :e A0 :/\: A.
					                      { exact (binintersectI A0 A z HzA00 HzA0). }
					                      claim HcapIn : (A0 :/\: A) :e IntFam A0.
					                      { exact (ReplI (Arcs :\: Sing A0) (fun B0:set => A0 :/\: B0) A HAin0). }
					                      claim HzInt : z :e IntPts A0.
					                      { exact (UnionI (IntFam A0) z (A0 :/\: A) HzA0A HcapIn). }
					                      apply (xm (z = y)).
					                      - assume Hzy.
					                        claim HyA1 : y :e A.
					                        { rewrite <- Hzy. exact HzA0. }
					                        exact (FalseE (HyNotA HyA1) (z :e Empty)).
					                      - assume Hzneq : ~(z = y).
					                        claim HzNotSing : z /:e Sing y.
					                        {
					                          assume HzSing.
					                          claim Hzy : z = y.
					                          { exact (SingE y z HzSing). }
					                          exact (Hzneq Hzy).
					                        }
					                        claim HzRem : z :e IntPts A0 :\: Sing y.
					                        { exact (setminusI (IntPts A0) (Sing y) z HzInt HzNotSing). }
					                        exact (FalseE (HzNotRem HzRem) (z :e Empty)).
					                    }
					                  - assume HzVr.
					                    apply (UnionE FamYrest z HzVr).
					                    let D.
					                    assume HDpack.
					                    claim HzD : z :e D.
					                    { exact (andEL (z :e D) (D :e FamYrest) HDpack). }
					                    claim HDin : D :e FamYrest.
					                    { exact (andER (z :e D) (D :e FamYrest) HDpack). }
					                    apply (ReplE ArcsYrest (fun A1:set => Ny A1) D HDin).
					                    let B.
					                    assume HBpair.
					                    claim HBin : B :e ArcsYrest.
					                    { exact (andEL (B :e ArcsYrest) (D = Ny B) HBpair). }
					                    claim HDeq : D = Ny B.
					                    { exact (andER (B :e ArcsYrest) (D = Ny B) HBpair). }
					                    claim HzNyB : z :e Ny B.
					                    { rewrite <- HDeq. exact HzD. }
					                    claim HzB : z :e B.
					                    { exact (setminusE1 B (IntPts B :\: Sing y) z HzNyB). }
					                    claim HBArcsY : B :e ArcsY.
					                    { exact (setminusE1 ArcsY (Sing A0) B HBin). }
					                    claim HBArcs : B :e Arcs.
					                    { exact (SepE1 Arcs (fun A2:set => y :e A2) B HBArcsY). }
					                    claim HyB : y :e B.
					                    { exact (SepE2 Arcs (fun A2:set => y :e A2) B HBArcsY). }
					                    claim HneqAB : A <> B.
					                    {
					                      assume Heq.
					                      claim HyA1 : y :e A.
					                      { rewrite Heq. exact HyB. }
					                      exact (HyNotA HyA1).
					                    }
					                    claim HnotInSing : A /:e Sing B.
					                    {
					                      assume HAin.
					                      claim HAeq : A = B.
					                      { exact (SingE B A HAin). }
					                      exact (HneqAB HAeq).
					                    }
					                    claim HAin0 : A :e (Arcs :\: Sing B).
					                    { exact (setminusI Arcs (Sing B) A HAArcs HnotInSing). }
					                    claim HzBA : z :e B :/\: A.
					                    { exact (binintersectI B A z HzB HzA0). }
					                    claim HcapIn : (B :/\: A) :e IntFam B.
					                    { exact (ReplI (Arcs :\: Sing B) (fun C:set => B :/\: C) A HAin0). }
					                    claim HzInt : z :e IntPts B.
					                    { exact (UnionI (IntFam B) z (B :/\: A) HzBA HcapIn). }
					                    apply (xm (z = y)).
					                    - assume Hzy.
					                      claim HyA1 : y :e A.
					                      { rewrite <- Hzy. exact HzA0. }
					                      exact (FalseE (HyNotA HyA1) (z :e Empty)).
					                    - assume Hzneq : ~(z = y).
					                      claim HzNotSing : z /:e Sing y.
					                      {
					                        assume HzSing.
					                        claim Hzy : z = y.
					                        { exact (SingE y z HzSing). }
					                        exact (Hzneq Hzy).
					                      }
					                      claim HzRem : z :e IntPts B :\: Sing y.
					                      { exact (setminusI (IntPts B) (Sing y) z HzInt HzNotSing). }
					                      claim HzNotRem : z /:e (IntPts B :\: Sing y).
					                      { exact (setminusE2 B (IntPts B :\: Sing y) z HzNyB). }
					                      exact (FalseE (HzNotRem HzRem) (z :e Empty)).
					                }
					                rewrite HVAEmpty.
					                exact (topology_has_empty A TA HtopA).
					          }
					          exact (coherence_open_backward V HVsubX HVArcsOpen).
					        }
				        (** Membership and disjointness. **)
				        claim HxU : x :e U.
				        { exact (binunionI1 Ux Urest x HxUx). }
					        claim HyV : y :e V.
					        { exact (binunionI1 Vy Vrest y HyVy). }
					        claim HUVEmpty : U :/\: V = Empty.
				        {
				          apply Empty_Subq_eq.
				          let z.
				          assume HzUV.
				          claim HzU0 : z :e U.
				          { exact (binintersectE1 U V z HzUV). }
				          claim HzV0 : z :e V.
				          { exact (binintersectE2 U V z HzUV). }
				          apply (binunionE Ux Urest z HzU0).
				          - assume HzUx.
				            apply (binunionE Vy Vrest z HzV0).
				            + assume HzVy.
				              (** Ux⊆U0 and Vy⊆V0, but U0∩V0=Empty **)
				              claim HzU00 : z :e U0.
				              { exact (binintersectE1 U0 (Nx A0) z HzUx). }
				              claim HzV00 : z :e V0.
				              { exact (binintersectE1 V0 (Ny A0) z HzVy). }
				              rewrite <- HU0V0Empty.
				              exact (binintersectI U0 V0 z HzU00 HzV00).
				            + assume HzVr.
				              (** z lies in A0 (from Ux) and in some arc By containing y (from Vrest) **)
				              claim HzU00 : z :e U0.
				              { exact (binintersectE1 U0 (Nx A0) z HzUx). }
				              claim HzNxA0 : z :e Nx A0.
				              { exact (binintersectE2 U0 (Nx A0) z HzUx). }
				              claim HzA00 : z :e A0.
				              { exact (setminusE1 A0 (IntPts A0 :\: Sing x) z HzNxA0). }
				              apply (UnionE FamYrest z HzVr).
				              let D.
				              assume HDpack.
				              claim HzD : z :e D.
				              { exact (andEL (z :e D) (D :e FamYrest) HDpack). }
				              claim HDin : D :e FamYrest.
				              { exact (andER (z :e D) (D :e FamYrest) HDpack). }
				              apply (ReplE ArcsYrest (fun A1:set => Ny A1) D HDin).
				              let By.
				              assume HBypair.
				              claim HByin : By :e ArcsYrest.
				              { exact (andEL (By :e ArcsYrest) (D = Ny By) HBypair). }
				              claim HDeq : D = Ny By.
				              { exact (andER (By :e ArcsYrest) (D = Ny By) HBypair). }
				              claim HzNyBy : z :e Ny By.
				              { rewrite <- HDeq. exact HzD. }
				              claim HzBy : z :e By.
				              { exact (setminusE1 By (IntPts By :\: Sing y) z HzNyBy). }
				              claim HByArcsY : By :e ArcsY.
				              { exact (setminusE1 ArcsY (Sing A0) By HByin). }
				              claim HByArcs : By :e Arcs.
				              { exact (SepE1 Arcs (fun A2:set => y :e A2) By HByArcsY). }
				              claim HyBy : y :e By.
				              { exact (SepE2 Arcs (fun A2:set => y :e A2) By HByArcsY). }
				              claim HneqByA0 : ~(By = A0).
				              {
				                assume Heq.
				                claim HBySing : By :e Sing A0.
				                { rewrite Heq. exact (SingI A0). }
				                exact ((setminusE2 ArcsY (Sing A0) By HByin) HBySing).
				              }
				              claim HinterByA0 :
				                exists p:set, (By :/\: A0 = Empty \/ By :/\: A0 = Sing p).
				              { exact (HinterDat By A0 HByArcs HA0Arcs HneqByA0). }
				              apply HinterByA0.
				              let p.
				              assume Hcase.
				              apply Hcase.
				              { assume Hem.
				                claim HzE : z :e Empty.
				                { rewrite <- Hem. exact (binintersectI By A0 z HzBy HzA00). }
				                exact (FalseE (EmptyE z HzE False) (z :e Empty)). }
				              { assume Hsing.
				                claim HySingp : y :e Sing p.
				                { rewrite <- Hsing. exact (binintersectI By A0 y HyBy HyA0). }
				                claim Hyp : y = p.
				                { exact (SingE p y HySingp). }
				                claim HzSingp : z :e Sing p.
				                { rewrite <- Hsing. exact (binintersectI By A0 z HzBy HzA00). }
				                claim Hzp : z = p.
				                { exact (SingE p z HzSingp). }
				                claim Hzy : z = y.
				                { rewrite Hzp. symmetry. exact Hyp. }
				                claim HyNotU0 : y /:e U0.
				                {
				                  assume HyU0.
				                  claim HyUV0 : y :e U0 :/\: V0.
				                  { exact (binintersectI U0 V0 y HyU0 HyV0). }
					                  claim HyE : y :e Empty.
					                  { rewrite <- HU0V0Empty. exact HyUV0. }
					                  exact (EmptyE y HyE False).
					                }
				                claim HzNotU0 : z /:e U0.
				                { rewrite Hzy. exact HyNotU0. }
				                exact (FalseE (HzNotU0 HzU00) (z :e Empty)).
				              }
				          - assume HzUr.
				            apply (binunionE Vy Vrest z HzV0).
				            + assume HzVy.
				              (** z lies in A0 (from Vy) and in some arc Bx containing x (from Urest) **)
				              claim HzV00 : z :e V0.
				              { exact (binintersectE1 V0 (Ny A0) z HzVy). }
				              claim HzNyA0 : z :e Ny A0.
				              { exact (binintersectE2 V0 (Ny A0) z HzVy). }
				              claim HzA00 : z :e A0.
				              { exact (setminusE1 A0 (IntPts A0 :\: Sing y) z HzNyA0). }
				              apply (UnionE FamXrest z HzUr).
				              let D.
				              assume HDpack.
				              claim HzD : z :e D.
				              { exact (andEL (z :e D) (D :e FamXrest) HDpack). }
				              claim HDin : D :e FamXrest.
				              { exact (andER (z :e D) (D :e FamXrest) HDpack). }
				              apply (ReplE ArcsXrest (fun A1:set => Nx A1) D HDin).
				              let Bx.
				              assume HBxpair.
				              claim HBxin : Bx :e ArcsXrest.
				              { exact (andEL (Bx :e ArcsXrest) (D = Nx Bx) HBxpair). }
				              claim HDeq : D = Nx Bx.
				              { exact (andER (Bx :e ArcsXrest) (D = Nx Bx) HBxpair). }
				              claim HzNxBx : z :e Nx Bx.
				              { rewrite <- HDeq. exact HzD. }
				              claim HzBx : z :e Bx.
				              { exact (setminusE1 Bx (IntPts Bx :\: Sing x) z HzNxBx). }
				              claim HBxArcsX : Bx :e ArcsX.
				              { exact (setminusE1 ArcsX (Sing A0) Bx HBxin). }
				              claim HBxArcs : Bx :e Arcs.
				              { exact (SepE1 Arcs (fun A2:set => x :e A2) Bx HBxArcsX). }
				              claim HxBx : x :e Bx.
				              { exact (SepE2 Arcs (fun A2:set => x :e A2) Bx HBxArcsX). }
				              claim HneqBxA0 : ~(Bx = A0).
				              {
				                assume Heq.
				                claim HBxSing : Bx :e Sing A0.
				                { rewrite Heq. exact (SingI A0). }
				                exact ((setminusE2 ArcsX (Sing A0) Bx HBxin) HBxSing).
				              }
				              claim HinterBxA0 :
				                exists p:set, (Bx :/\: A0 = Empty \/ Bx :/\: A0 = Sing p).
				              { exact (HinterDat Bx A0 HBxArcs HA0Arcs HneqBxA0). }
				              apply HinterBxA0.
				              let p.
				              assume Hcase.
				              apply Hcase.
				              { assume Hem.
				                claim HxE : x :e Empty.
				                { rewrite <- Hem. exact (binintersectI Bx A0 x HxBx HxA0). }
				                exact (FalseE (EmptyE x HxE False) (z :e Empty)). }
				              { assume Hsing.
				                claim HxSingp : x :e Sing p.
				                { rewrite <- Hsing. exact (binintersectI Bx A0 x HxBx HxA0). }
				                claim Hxp : x = p.
				                { exact (SingE p x HxSingp). }
				                claim HzSingp : z :e Sing p.
				                { rewrite <- Hsing. exact (binintersectI Bx A0 z HzBx HzA00). }
				                claim Hzp : z = p.
				                { exact (SingE p z HzSingp). }
				                claim Hzx : z = x.
				                { rewrite Hzp. symmetry. exact Hxp. }
				                claim HxNotV0 : x /:e V0.
				                {
				                  assume HxV0.
				                  claim HxUV0 : x :e U0 :/\: V0.
				                  { exact (binintersectI U0 V0 x HxU0 HxV0). }
					                  claim HxE : x :e Empty.
					                  { rewrite <- HU0V0Empty. exact HxUV0. }
					                  exact (EmptyE x HxE False).
					                }
				                claim HzNotV0 : z /:e V0.
				                { rewrite Hzx. exact HxNotV0. }
				                exact (FalseE (HzNotV0 HzV00) (z :e Empty)).
				              }
				            + assume HzVr.
				              (** Both z∈Urest and z∈Vrest. **)
				              apply (UnionE FamXrest z HzUr).
				              let Du.
				              assume HDupack.
				              claim HzDu : z :e Du.
				              { exact (andEL (z :e Du) (Du :e FamXrest) HDupack). }
				              claim HDuin : Du :e FamXrest.
				              { exact (andER (z :e Du) (Du :e FamXrest) HDupack). }
				              apply (ReplE ArcsXrest (fun A1:set => Nx A1) Du HDuin).
				              let Bx.
				              assume HBxpair.
				              claim HBxin : Bx :e ArcsXrest.
				              { exact (andEL (Bx :e ArcsXrest) (Du = Nx Bx) HBxpair). }
				              claim HDueq : Du = Nx Bx.
				              { exact (andER (Bx :e ArcsXrest) (Du = Nx Bx) HBxpair). }
				              claim HzNxBx : z :e Nx Bx.
				              { rewrite <- HDueq. exact HzDu. }
				              claim HzBx : z :e Bx.
				              { exact (setminusE1 Bx (IntPts Bx :\: Sing x) z HzNxBx). }
				              claim HBxArcsX : Bx :e ArcsX.
				              { exact (setminusE1 ArcsX (Sing A0) Bx HBxin). }
				              claim HBxArcs : Bx :e Arcs.
				              { exact (SepE1 Arcs (fun A2:set => x :e A2) Bx HBxArcsX). }
				              claim HxBx : x :e Bx.
				              { exact (SepE2 Arcs (fun A2:set => x :e A2) Bx HBxArcsX). }
				              apply (UnionE FamYrest z HzVr).
				              let Dv.
				              assume HDvpack.
				              claim HzDv : z :e Dv.
				              { exact (andEL (z :e Dv) (Dv :e FamYrest) HDvpack). }
				              claim HDvin : Dv :e FamYrest.
				              { exact (andER (z :e Dv) (Dv :e FamYrest) HDvpack). }
				              apply (ReplE ArcsYrest (fun A1:set => Ny A1) Dv HDvin).
				              let By.
				              assume HBypair.
				              claim HByin : By :e ArcsYrest.
				              { exact (andEL (By :e ArcsYrest) (Dv = Ny By) HBypair). }
				              claim HDveq : Dv = Ny By.
				              { exact (andER (By :e ArcsYrest) (Dv = Ny By) HBypair). }
				              claim HzNyBy : z :e Ny By.
				              { rewrite <- HDveq. exact HzDv. }
				              claim HzBy : z :e By.
				              { exact (setminusE1 By (IntPts By :\: Sing y) z HzNyBy). }
				              claim HByArcsY : By :e ArcsY.
				              { exact (setminusE1 ArcsY (Sing A0) By HByin). }
				              claim HByArcs : By :e Arcs.
				              { exact (SepE1 Arcs (fun A2:set => y :e A2) By HByArcsY). }
				              claim HyBy : y :e By.
				              { exact (SepE2 Arcs (fun A2:set => y :e A2) By HByArcsY). }
				              apply xm (Bx = By).
				              * assume Heq.
				                claim HyBx : y :e Bx.
				                { rewrite Heq. exact HyBy. }
				                claim HBxA0 : Bx = A0.
				                { exact (Hunique Bx HBxArcs HxBx HyBx). }
				                claim HBxNot : Bx /:e Sing A0.
				                {
				                  assume Hbad.
				                  claim HBxEq0 : Bx = A0.
				                  { exact (SingE A0 Bx Hbad). }
				                  exact ((setminusE2 ArcsX (Sing A0) Bx HBxin) (eq_subst_mem Bx A0 (Sing A0) HBxEq0 (SingI A0))).
				                }
				                claim HBxSing : Bx :e Sing A0.
				                { rewrite HBxA0. exact (SingI A0). }
				                exact (FalseE (HBxNot HBxSing) (z :e Empty)).
				              * assume Hneq : ~(Bx = By).
				                (** z is an intersection point of Bx, hence z=x, forcing By=A0 (contradiction). **)
				                claim HnotInSing : By /:e Sing Bx.
				                {
				                  assume HBySing.
				                  claim HByEq : By = Bx.
				                  { exact (SingE Bx By HBySing). }
				                  claim HBxEq : Bx = By.
				                  { symmetry. exact HByEq. }
				                  exact (Hneq HBxEq).
				                }
				                claim HByin0 : By :e (Arcs :\: Sing Bx).
				                { exact (setminusI Arcs (Sing Bx) By HByArcs HnotInSing). }
				                claim HzBxBy : z :e Bx :/\: By.
				                { exact (binintersectI Bx By z HzBx HzBy). }
				                claim HcapIn : (Bx :/\: By) :e IntFam Bx.
				                { exact (ReplI (Arcs :\: Sing Bx) (fun C:set => Bx :/\: C) By HByin0). }
					                claim HzInt : z :e IntPts Bx.
					                { exact (UnionI (IntFam Bx) z (Bx :/\: By) HzBxBy HcapIn). }
					                apply (xm (z = x)).
					                - assume Hzx.
					                   claim HxBy : x :e By.
					                   { rewrite <- Hzx. exact HzBy. }
					                   claim HByA0 : By = A0.
				                   { exact (Hunique By HByArcs HxBy HyBy). }
				                   claim HByNot : By /:e Sing A0.
				                   {
				                     assume Hbad.
				                     claim HByEq0 : By = A0.
				                     { exact (SingE A0 By Hbad). }
				                     exact ((setminusE2 ArcsY (Sing A0) By HByin) (eq_subst_mem By A0 (Sing A0) HByEq0 (SingI A0))).
				                   }
					                   claim HBySing : By :e Sing A0.
					                   { rewrite HByA0. exact (SingI A0). }
					                   exact (FalseE (HByNot HBySing) (z :e Empty)).
					                - assume Hzneq : ~(z = x).
					                   claim HzNotSing : z /:e Sing x.
					                   {
					                     assume HzSing.
				                     claim Hzx : z = x.
				                     { exact (SingE x z HzSing). }
				                     exact (Hzneq Hzx).
				                   }
				                   claim HzRem : z :e IntPts Bx :\: Sing x.
				                   { exact (setminusI (IntPts Bx) (Sing x) z HzInt HzNotSing). }
				                   claim HzNotRem : z /:e (IntPts Bx :\: Sing x).
				                   { exact (setminusE2 Bx (IntPts Bx :\: Sing x) z HzNxBx). }
				                   exact (FalseE (HzNotRem HzRem) (z :e Empty)).
				        }
				        witness U.
				        witness V.
				        claim HUV0 : (U :e Tx /\ V :e Tx).
				        { exact (andI (U :e Tx) (V :e Tx) HUopen HVopen). }
				        claim HUV1 : (U :e Tx /\ V :e Tx) /\ x :e U.
				        { exact (andI (U :e Tx /\ V :e Tx) (x :e U) HUV0 HxU). }
				        claim HUV2 : ((U :e Tx /\ V :e Tx) /\ x :e U) /\ y :e V.
				        { exact (andI ((U :e Tx /\ V :e Tx) /\ x :e U) (y :e V) HUV1 HyV). }
				        exact (andI (((U :e Tx /\ V :e Tx) /\ x :e U) /\ y :e V) (U :/\: V = Empty) HUV2 HUVEmpty).
				      + assume HnoCommon.
				        (** No arc contains both x and y. **)
			        set ArcsX := {A :e Arcs|x :e A}.
			        set ArcsY := {A :e Arcs|y :e A}.
		        set Nx := fun A:set => A :\: (IntPts A :\: Sing x).
		        set Ny := fun A:set => A :\: (IntPts A :\: Sing y).
		        set FamX := Repl ArcsX (fun A:set => Nx A).
		        set FamY := Repl ArcsY (fun A:set => Ny A).
		        set U := Union FamX.
		        set V := Union FamY.
		        (** Helper: if z lies in A∩B for distinct arcs, then z is an intersection point of A. **)
		        claim Hinter_in_IntPts :
		          forall A B z:set,
		            A :e Arcs -> B :e Arcs -> A <> B ->
		            z :e A :/\: B ->
		            z :e IntPts A.
		        {
		          let A B z.
		          assume HAArcs HBArcs Hneq HzAB.
			          claim HnotInSing : B /:e Sing A.
			          {
			            assume HBsing.
			            claim HBA : B = A.
			            { exact (SingE A B HBsing). }
			            claim HAB : A = B.
			            { symmetry. exact HBA. }
			            exact (Hneq HAB).
			          }
		          claim HBin : B :e (Arcs :\: Sing A).
		          { exact (setminusI Arcs (Sing A) B HBArcs HnotInSing). }
		          claim HcapIn : (A :/\: B) :e IntFam A.
		          { exact (ReplI (Arcs :\: Sing A) (fun B0:set => A :/\: B0) B HBin). }
		          exact (UnionI (IntFam A) z (A :/\: B) HzAB HcapIn).
		        }
		        (** U is open by coherence, since on each arc it is either Nx A or Empty. **)
		        claim HUsubX : U c= X.
		        {
		          let z.
		          assume HzU.
		          apply (UnionE FamX z HzU).
		          let D.
		          assume HDpack.
		          claim HzD : z :e D.
		          { exact (andEL (z :e D) (D :e FamX) HDpack). }
		          claim HDin : D :e FamX.
		          { exact (andER (z :e D) (D :e FamX) HDpack). }
		          apply (ReplE ArcsX (fun A0:set => Nx A0) D HDin).
		          let A0.
		          assume HApair.
		          claim HA0in : A0 :e ArcsX.
		          { exact (andEL (A0 :e ArcsX) (D = Nx A0) HApair). }
		          claim HDeq : D = Nx A0.
		          { exact (andER (A0 :e ArcsX) (D = Nx A0) HApair). }
		          claim HA0Arcs : A0 :e Arcs.
		          { exact (SepE1 Arcs (fun A1:set => x :e A1) A0 HA0in). }
		          claim HAdat : A0 c= X /\ arc A0 (subspace_topology X Tx A0).
		          { exact (HarcDat A0 HA0Arcs). }
		          claim HA0subX : A0 c= X.
		          { exact (andEL (A0 c= X) (arc A0 (subspace_topology X Tx A0)) HAdat). }
		          claim HzA0 : z :e A0.
		          {
		            claim HzNx : z :e Nx A0.
		            { rewrite <- HDeq. exact HzD. }
		            exact (setminusE1 A0 (IntPts A0 :\: Sing x) z HzNx).
		          }
		          exact (HA0subX z HzA0).
		        }
		        claim HUopen : U :e Tx.
		        {
		          claim HUArcsOpen :
		            forall A:set, A :e Arcs -> U :/\: A :e subspace_topology X Tx A.
		          {
		            let A.
		            assume HAArcs.
		            set TA := subspace_topology X Tx A.
		            claim HAdat : A c= X /\ arc A TA.
		            { exact (HarcDat A HAArcs). }
		            claim HAsubX : A c= X.
		            { exact (andEL (A c= X) (arc A TA) HAdat). }
		            claim HtopA : topology_on A TA.
		            { exact (subspace_topology_is_topology X Tx A HtopX HAsubX). }
		            apply xm (x :e A).
		            - assume HxA.
		              (** U∩A = Nx A **)
		              claim HUAeq : U :/\: A = Nx A.
		              {
		                apply set_ext.
		                + let z.
		                  assume HzUA.
		                  claim HzU0 : z :e U.
		                  { exact (binintersectE1 U A z HzUA). }
		                  claim HzA0 : z :e A.
		                  { exact (binintersectE2 U A z HzUA). }
		                  apply (UnionE FamX z HzU0).
		                  let D.
		                  assume HDpack.
		                  claim HzD : z :e D.
		                  { exact (andEL (z :e D) (D :e FamX) HDpack). }
		                  claim HDin : D :e FamX.
		                  { exact (andER (z :e D) (D :e FamX) HDpack). }
		                  apply (ReplE ArcsX (fun A0:set => Nx A0) D HDin).
		                  let B.
		                  assume HBpair.
		                  claim HBin : B :e ArcsX.
		                  { exact (andEL (B :e ArcsX) (D = Nx B) HBpair). }
		                  claim HDeq : D = Nx B.
		                  { exact (andER (B :e ArcsX) (D = Nx B) HBpair). }
		                  claim HBArcs : B :e Arcs.
		                  { exact (SepE1 Arcs (fun A1:set => x :e A1) B HBin). }
		                  claim HxB : x :e B.
		                  { exact (SepE2 Arcs (fun A1:set => x :e A1) B HBin). }
		                  claim HzNxB : z :e Nx B.
		                  { rewrite <- HDeq. exact HzD. }
		                  claim HzB : z :e B.
		                  { exact (setminusE1 B (IntPts B :\: Sing x) z HzNxB). }
		                  apply (setminusI A (IntPts A :\: Sing x) z HzA0).
		                  assume HzBad.
		                  (** If B=A we're done; else z=x by intersection property, so z is not removed from A. **)
		                  apply xm (B = A).
		                  - assume HBA.
		                    claim HzBadB : z :e IntPts B :\: Sing x.
		                    { rewrite HBA. exact HzBad. }
		                    claim HzNot : z /:e (IntPts B :\: Sing x).
		                    { exact (setminusE2 B (IntPts B :\: Sing x) z HzNxB). }
		                    exact (HzNot HzBadB).
		                  - assume HBAneq : ~(B = A).
		                    claim HneqBA : B <> A.
		                    { exact HBAneq. }
		                    claim HneqAB : A <> B.
		                    { exact (neq_i_sym B A HneqBA). }
		                    claim HzAB : z :e A :/\: B.
		                    { exact (binintersectI A B z HzA0 HzB). }
		                    claim HinterCase :
		                      exists p:set, (A :/\: B = Empty \/ A :/\: B = Sing p).
		                    { exact (HinterDat A B HAArcs HBArcs HneqAB). }
		                    apply HinterCase.
		                    let p.
		                    assume Hcase.
		                    apply Hcase.
		                    { assume Hem.
		                      claim HzE : z :e Empty.
		                      { rewrite <- Hem. exact HzAB. }
		                      exact (EmptyE z HzE False). }
		                    { assume Hsing.
		                      claim Hzp : z = p.
		                      {
		                        claim HzSingp : z :e Sing p.
		                        { rewrite <- Hsing. exact HzAB. }
		                        exact (SingE p z HzSingp).
		                      }
		                      claim Hxp : x = p.
		                      {
		                        claim HxSingp : x :e Sing p.
		                        { rewrite <- Hsing. exact (binintersectI A B x HxA HxB). }
		                        exact (SingE p x HxSingp).
		                      }
		                      claim Hzx : z = x.
		                      { rewrite Hzp. symmetry. exact Hxp. }
		                      claim HzSing : z :e Sing x.
		                      { rewrite Hzx. exact (SingI x). }
		                      claim HzNotSing : z /:e Sing x.
		                      { exact (setminusE2 (IntPts A) (Sing x) z HzBad). }
		                      exact (HzNotSing HzSing). }
			                + let z.
			                  assume HzNx.
			                  claim HzA0 : z :e A.
			                  { exact (setminusE1 A (IntPts A :\: Sing x) z HzNx). }
		                  claim HAxIn : A :e ArcsX.
		                  { exact (SepI Arcs (fun A1:set => x :e A1) A HAArcs HxA). }
		                  claim HNxIn : Nx A :e FamX.
		                  { exact (ReplI ArcsX (fun A0:set => Nx A0) A HAxIn). }
		                  claim HzU0 : z :e U.
		                  { exact (UnionI FamX z (Nx A) HzNx HNxIn). }
		                  exact (binintersectI U A z HzU0 HzA0).
		              }
		              rewrite HUAeq.
		              claim HNdat : Nx A :e TA /\ x :e Nx A.
		              { exact (Hneigh_open_in_arc A x HAArcs HxA). }
		              exact (andEL (Nx A :e TA) (x :e Nx A) HNdat).
		            - assume HxNotA : ~(x :e A).
		              (** U∩A = Empty **)
		              claim HUAEmpty : U :/\: A = Empty.
		              {
		                apply Empty_Subq_eq.
		                let z.
		                assume HzUA.
		                claim HzU0 : z :e U.
		                { exact (binintersectE1 U A z HzUA). }
		                claim HzA0 : z :e A.
		                { exact (binintersectE2 U A z HzUA). }
		                apply (UnionE FamX z HzU0).
		                let D.
		                assume HDpack.
		                claim HzD : z :e D.
		                { exact (andEL (z :e D) (D :e FamX) HDpack). }
		                claim HDin : D :e FamX.
		                { exact (andER (z :e D) (D :e FamX) HDpack). }
		                apply (ReplE ArcsX (fun A0:set => Nx A0) D HDin).
		                let B.
		                assume HBpair.
		                claim HBin : B :e ArcsX.
		                { exact (andEL (B :e ArcsX) (D = Nx B) HBpair). }
		                claim HDeq : D = Nx B.
		                { exact (andER (B :e ArcsX) (D = Nx B) HBpair). }
		                claim HBArcs : B :e Arcs.
		                { exact (SepE1 Arcs (fun A1:set => x :e A1) B HBin). }
		                claim HxB : x :e B.
		                { exact (SepE2 Arcs (fun A1:set => x :e A1) B HBin). }
			                claim HzNxB : z :e Nx B.
			                { rewrite <- HDeq. exact HzD. }
			                claim HzB : z :e B.
			                { exact (setminusE1 B (IntPts B :\: Sing x) z HzNxB). }
			                apply xm (B = A).
			                - assume HBA.
			                  claim HxA1 : x :e A.
			                  { rewrite <- HBA. exact HxB. }
			                  exact (FalseE (HxNotA HxA1) (z :e Empty)).
			                - assume HBAneq : ~(B = A).
			                  claim HneqBA : B <> A.
			                  { exact HBAneq. }
			                  claim HzAB : z :e B :/\: A.
			                  { exact (binintersectI B A z HzB HzA0). }
			                  claim HzInt : z :e IntPts B.
			                  { exact (Hinter_in_IntPts B A z HBArcs HAArcs HneqBA HzAB). }
			                  claim Hzneqx : z <> x.
			                  {
			                    assume Hzx.
			                    claim HxA1 : x :e A.
			                    { rewrite <- Hzx. exact HzA0. }
			                    exact (HxNotA HxA1).
			                  }
			                  claim HzNotSing : z /:e Sing x.
			                  {
			                    assume HzSing.
			                    claim Hzx : z = x.
			                    { exact (SingE x z HzSing). }
			                    exact (Hzneqx Hzx).
			                  }
			                  claim HzRem : z :e IntPts B :\: Sing x.
			                  { exact (setminusI (IntPts B) (Sing x) z HzInt HzNotSing). }
				                  claim HzNotRem : z /:e (IntPts B :\: Sing x).
				                  { exact (setminusE2 B (IntPts B :\: Sing x) z HzNxB). }
				                  exact (FalseE (HzNotRem HzRem) (z :e Empty)).
			              }
			              rewrite HUAEmpty.
			              exact (topology_has_empty A TA HtopA).
			          }
			          exact (coherence_open_backward U HUsubX HUArcsOpen).
			        }
		        (** V is open by coherence similarly. **)
		        claim HVsubX : V c= X.
		        {
		          let z.
		          assume HzV.
		          apply (UnionE FamY z HzV).
		          let D.
		          assume HDpack.
		          claim HzD : z :e D.
		          { exact (andEL (z :e D) (D :e FamY) HDpack). }
		          claim HDin : D :e FamY.
		          { exact (andER (z :e D) (D :e FamY) HDpack). }
		          apply (ReplE ArcsY (fun A0:set => Ny A0) D HDin).
		          let A0.
		          assume HApair.
		          claim HA0in : A0 :e ArcsY.
		          { exact (andEL (A0 :e ArcsY) (D = Ny A0) HApair). }
		          claim HDeq : D = Ny A0.
		          { exact (andER (A0 :e ArcsY) (D = Ny A0) HApair). }
		          claim HA0Arcs : A0 :e Arcs.
		          { exact (SepE1 Arcs (fun A1:set => y :e A1) A0 HA0in). }
		          claim HAdat : A0 c= X /\ arc A0 (subspace_topology X Tx A0).
		          { exact (HarcDat A0 HA0Arcs). }
		          claim HA0subX : A0 c= X.
		          { exact (andEL (A0 c= X) (arc A0 (subspace_topology X Tx A0)) HAdat). }
			          claim HzA0 : z :e A0.
			          {
			            claim HzNy : z :e Ny A0.
			            { rewrite <- HDeq. exact HzD. }
			            exact (setminusE1 A0 (IntPts A0 :\: Sing y) z HzNy).
			          }
			          exact (HA0subX z HzA0).
			        }
			        claim HVopen : V :e Tx.
			        {
			          claim HVArcsOpen :
			            forall A:set, A :e Arcs -> V :/\: A :e subspace_topology X Tx A.
			          {
			            let A.
			            assume HAArcs.
			          set TA := subspace_topology X Tx A.
			          claim HAdat : A c= X /\ arc A TA.
			          { exact (HarcDat A HAArcs). }
			          claim HAsubX : A c= X.
		          { exact (andEL (A c= X) (arc A TA) HAdat). }
		          claim HtopA : topology_on A TA.
		          { exact (subspace_topology_is_topology X Tx A HtopX HAsubX). }
		          apply xm (y :e A).
		          - assume HyA.
		            claim HVAeq : V :/\: A = Ny A.
		            {
		              apply set_ext.
		              + let z.
		                assume HzVA.
		                claim HzV0 : z :e V.
		                { exact (binintersectE1 V A z HzVA). }
		                claim HzA0 : z :e A.
		                { exact (binintersectE2 V A z HzVA). }
		                apply (UnionE FamY z HzV0).
		                let D.
		                assume HDpack.
		                claim HzD : z :e D.
		                { exact (andEL (z :e D) (D :e FamY) HDpack). }
		                claim HDin : D :e FamY.
		                { exact (andER (z :e D) (D :e FamY) HDpack). }
		                apply (ReplE ArcsY (fun A0:set => Ny A0) D HDin).
		                let B.
		                assume HBpair.
		                claim HBin : B :e ArcsY.
		                { exact (andEL (B :e ArcsY) (D = Ny B) HBpair). }
		                claim HDeq : D = Ny B.
		                { exact (andER (B :e ArcsY) (D = Ny B) HBpair). }
		                claim HBArcs : B :e Arcs.
		                { exact (SepE1 Arcs (fun A1:set => y :e A1) B HBin). }
			                claim HyB : y :e B.
			                { exact (SepE2 Arcs (fun A1:set => y :e A1) B HBin). }
			                claim HzNyB : z :e Ny B.
			                { rewrite <- HDeq. exact HzD. }
			                claim HzB : z :e B.
			                { exact (setminusE1 B (IntPts B :\: Sing y) z HzNyB). }
			                apply (setminusI A (IntPts A :\: Sing y) z HzA0).
			                assume HzBad.
			                apply xm (B = A).
			                * assume HBA.
			                  claim HzBadB : z :e IntPts B :\: Sing y.
			                  { rewrite HBA. exact HzBad. }
			                  claim HzNot : z /:e (IntPts B :\: Sing y).
			                  { exact (setminusE2 B (IntPts B :\: Sing y) z HzNyB). }
			                  exact (HzNot HzBadB).
			                * assume HBAneq : ~(B = A).
			                  claim HneqBA : B <> A.
			                  { exact HBAneq. }
		                  claim HzAB : z :e A :/\: B.
		                  { exact (binintersectI A B z HzA0 HzB). }
			                  claim HinterCase :
			                    exists p:set, (A :/\: B = Empty \/ A :/\: B = Sing p).
			                  { exact (HinterDat A B HAArcs HBArcs (neq_i_sym B A HneqBA)). }
		                  apply HinterCase.
		                  let p.
		                  assume Hcase.
			                  apply Hcase.
				                  { assume Hem.
				                    claim HzE : z :e Empty.
				                    { rewrite <- Hem. exact HzAB. }
				                    exact (EmptyE z HzE False). }
			                  { assume Hsing.
			                    claim Hzp : z = p.
			                    {
			                      claim HzSingp : z :e Sing p.
			                      { rewrite <- Hsing. exact HzAB. }
			                      exact (SingE p z HzSingp).
			                    }
			                    claim Hyp : y = p.
			                    {
			                      claim HySingp : y :e Sing p.
			                      { rewrite <- Hsing. exact (binintersectI A B y HyA HyB). }
			                      exact (SingE p y HySingp).
			                    }
			                    claim Hzy : z = y.
			                    { rewrite Hzp. symmetry. exact Hyp. }
			                    claim HzSing : z :e Sing y.
			                    { rewrite Hzy. exact (SingI y). }
				                    claim HzNotSing : z /:e Sing y.
				                    { exact (setminusE2 (IntPts A) (Sing y) z HzBad). }
				                    exact (HzNotSing HzSing). }
			              + let z.
			                assume HzNy.
			                claim HzA0 : z :e A.
		                { exact (setminusE1 A (IntPts A :\: Sing y) z HzNy). }
		                claim HAyIn : A :e ArcsY.
		                { exact (SepI Arcs (fun A1:set => y :e A1) A HAArcs HyA). }
		                claim HNyIn : Ny A :e FamY.
		                { exact (ReplI ArcsY (fun A0:set => Ny A0) A HAyIn). }
		                claim HzV0 : z :e V.
		                { exact (UnionI FamY z (Ny A) HzNy HNyIn). }
		                exact (binintersectI V A z HzV0 HzA0).
		            }
		            rewrite HVAeq.
		            claim HNdat : Ny A :e TA /\ y :e Ny A.
		            { exact (Hneigh_open_in_arc A y HAArcs HyA). }
		            exact (andEL (Ny A :e TA) (y :e Ny A) HNdat).
		          - assume HyNotA : ~(y :e A).
		            claim HVAEmpty : V :/\: A = Empty.
		            {
		              apply Empty_Subq_eq.
		              let z.
		              assume HzVA.
		              claim HzV0 : z :e V.
		              { exact (binintersectE1 V A z HzVA). }
		              claim HzA0 : z :e A.
		              { exact (binintersectE2 V A z HzVA). }
		              apply (UnionE FamY z HzV0).
		              let D.
		              assume HDpack.
		              claim HzD : z :e D.
		              { exact (andEL (z :e D) (D :e FamY) HDpack). }
		              claim HDin : D :e FamY.
		              { exact (andER (z :e D) (D :e FamY) HDpack). }
		              apply (ReplE ArcsY (fun A0:set => Ny A0) D HDin).
		              let B.
		              assume HBpair.
		              claim HBin : B :e ArcsY.
		              { exact (andEL (B :e ArcsY) (D = Ny B) HBpair). }
		              claim HDeq : D = Ny B.
		              { exact (andER (B :e ArcsY) (D = Ny B) HBpair). }
		              claim HBArcs : B :e Arcs.
		              { exact (SepE1 Arcs (fun A1:set => y :e A1) B HBin). }
			              claim HyB : y :e B.
			              { exact (SepE2 Arcs (fun A1:set => y :e A1) B HBin). }
			              claim HzNyB : z :e Ny B.
			              { rewrite <- HDeq. exact HzD. }
			              claim HzB : z :e B.
			              { exact (setminusE1 B (IntPts B :\: Sing y) z HzNyB). }
		              apply xm (B = A).
			              * assume HBA.
			                claim HyA1 : y :e A.
			                { rewrite <- HBA. exact HyB. }
			                exact (FalseE (HyNotA HyA1) (z :e Empty)).
		              * assume HBAneq : ~(B = A).
		                claim HneqBA : B <> A.
			                { exact HBAneq. }
		                claim HzAB : z :e B :/\: A.
		                { exact (binintersectI B A z HzB HzA0). }
		                claim HzInt : z :e IntPts B.
		                { exact (Hinter_in_IntPts B A z HBArcs HAArcs HneqBA HzAB). }
		                claim Hzneqy : z <> y.
		                {
		                  assume Hzy.
		                  claim HyA1 : y :e A.
		                  { rewrite <- Hzy. exact HzA0. }
		                  exact (HyNotA HyA1).
		                }
		                claim HzNotSing : z /:e Sing y.
		                {
		                  assume HzSing.
		                  claim Hzy : z = y.
		                  { exact (SingE y z HzSing). }
		                  exact (Hzneqy Hzy).
		                }
		                claim HzRem : z :e IntPts B :\: Sing y.
		                { exact (setminusI (IntPts B) (Sing y) z HzInt HzNotSing). }
				                claim HzNotRem : z /:e (IntPts B :\: Sing y).
				                {
				                  exact (setminusE2 B (IntPts B :\: Sing y) z HzNyB).
				                }
				                exact (FalseE (HzNotRem HzRem) (z :e Empty)).
		            }
			            rewrite HVAEmpty.
			            exact (topology_has_empty A TA HtopA).
			        }
			          exact (coherence_open_backward V HVsubX HVArcsOpen).
			        }
			        (** x∈U and y∈V: pick any arc containing the point. **)
			        claim HxU : x :e U.
		        {
		          claim HxUnion : x :e Union Arcs.
		          { rewrite <- HUnion. exact HxX. }
		          apply (UnionE Arcs x HxUnion).
		          let A0.
		          assume HApair.
		          claim HxA0 : x :e A0.
		          { exact (andEL (x :e A0) (A0 :e Arcs) HApair). }
		          claim HA0Arcs : A0 :e Arcs.
		          { exact (andER (x :e A0) (A0 :e Arcs) HApair). }
		          claim HA0in : A0 :e ArcsX.
		          { exact (SepI Arcs (fun A1:set => x :e A1) A0 HA0Arcs HxA0). }
		          claim HNdat : Nx A0 :e (subspace_topology X Tx A0) /\ x :e Nx A0.
		          { exact (Hneigh_open_in_arc A0 x HA0Arcs HxA0). }
		          claim HxNx : x :e Nx A0.
		          { exact (andER (Nx A0 :e (subspace_topology X Tx A0)) (x :e Nx A0) HNdat). }
		          claim HNxIn : Nx A0 :e FamX.
		          { exact (ReplI ArcsX (fun A1:set => Nx A1) A0 HA0in). }
		          exact (UnionI FamX x (Nx A0) HxNx HNxIn).
		        }
		        claim HyV : y :e V.
		        {
		          claim HyUnion : y :e Union Arcs.
		          { rewrite <- HUnion. exact HyX. }
		          apply (UnionE Arcs y HyUnion).
		          let A0.
		          assume HApair.
		          claim HyA0 : y :e A0.
		          { exact (andEL (y :e A0) (A0 :e Arcs) HApair). }
		          claim HA0Arcs : A0 :e Arcs.
		          { exact (andER (y :e A0) (A0 :e Arcs) HApair). }
		          claim HA0in : A0 :e ArcsY.
		          { exact (SepI Arcs (fun A1:set => y :e A1) A0 HA0Arcs HyA0). }
		          claim HNdat : Ny A0 :e (subspace_topology X Tx A0) /\ y :e Ny A0.
		          { exact (Hneigh_open_in_arc A0 y HA0Arcs HyA0). }
		          claim HyNy : y :e Ny A0.
		          { exact (andER (Ny A0 :e (subspace_topology X Tx A0)) (y :e Ny A0) HNdat). }
		          claim HNyIn : Ny A0 :e FamY.
		          { exact (ReplI ArcsY (fun A1:set => Ny A1) A0 HA0in). }
		          exact (UnionI FamY y (Ny A0) HyNy HNyIn).
		        }
		        (** Disjointness: U∩V = Empty. **)
		        claim HUVEmpty : U :/\: V = Empty.
		        {
		          apply Empty_Subq_eq.
		          let z.
		          assume HzUV.
		          claim HzU0 : z :e U.
		          { exact (binintersectE1 U V z HzUV). }
		          claim HzV0 : z :e V.
		          { exact (binintersectE2 U V z HzUV). }
		          apply (UnionE FamX z HzU0).
		          let Du.
		          assume HDupack.
		          claim HzDu : z :e Du.
		          { exact (andEL (z :e Du) (Du :e FamX) HDupack). }
		          claim HDuin : Du :e FamX.
		          { exact (andER (z :e Du) (Du :e FamX) HDupack). }
		          apply (ReplE ArcsX (fun A0:set => Nx A0) Du HDuin).
		          let Au.
		          assume HAupair.
		          claim HAuX : Au :e ArcsX.
		          { exact (andEL (Au :e ArcsX) (Du = Nx Au) HAupair). }
		          claim HDueq : Du = Nx Au.
		          { exact (andER (Au :e ArcsX) (Du = Nx Au) HAupair). }
		          claim HAuArcs : Au :e Arcs.
		          { exact (SepE1 Arcs (fun A1:set => x :e A1) Au HAuX). }
			          claim HxAu : x :e Au.
			          { exact (SepE2 Arcs (fun A1:set => x :e A1) Au HAuX). }
			          claim HzAu : z :e Au.
			          {
			            claim HzNxAu : z :e Nx Au.
			            { rewrite <- HDueq. exact HzDu. }
			            exact (setminusE1 Au (IntPts Au :\: Sing x) z HzNxAu).
			          }
		          apply (UnionE FamY z HzV0).
		          let Dv.
		          assume HDvpack.
		          claim HzDv : z :e Dv.
		          { exact (andEL (z :e Dv) (Dv :e FamY) HDvpack). }
		          claim HDvin : Dv :e FamY.
		          { exact (andER (z :e Dv) (Dv :e FamY) HDvpack). }
		          apply (ReplE ArcsY (fun A0:set => Ny A0) Dv HDvin).
		          let Av.
		          assume HAvpair.
		          claim HAvY : Av :e ArcsY.
		          { exact (andEL (Av :e ArcsY) (Dv = Ny Av) HAvpair). }
		          claim HDveq : Dv = Ny Av.
		          { exact (andER (Av :e ArcsY) (Dv = Ny Av) HAvpair). }
		          claim HAvArcs : Av :e Arcs.
		          { exact (SepE1 Arcs (fun A1:set => y :e A1) Av HAvY). }
			          claim HyAv : y :e Av.
			          { exact (SepE2 Arcs (fun A1:set => y :e A1) Av HAvY). }
			          claim HzAv : z :e Av.
			          {
			            claim HzNyAv : z :e Ny Av.
			            { rewrite <- HDveq. exact HzDv. }
			            exact (setminusE1 Av (IntPts Av :\: Sing y) z HzNyAv).
			          }
		          (** If Au=Av then that arc contains both x and y, contradicting HnoCommon. **)
		          apply xm (Au = Av).
		          - assume Heq.
		            claim HexBad : exists A:set, A :e Arcs /\ x :e A /\ y :e A.
		            {
			              witness Au.
			              claim HyAu : y :e Au.
			              { rewrite Heq. exact HyAv. }
			              claim H01 : Au :e Arcs /\ x :e Au.
		              { exact (andI (Au :e Arcs) (x :e Au) HAuArcs HxAu). }
		              exact (andI (Au :e Arcs /\ x :e Au) (y :e Au) H01 HyAu).
			            }
			            exact (FalseE (HnoCommon HexBad) (z :e Empty)).
			          - assume Hneq : ~(Au = Av).
		            claim HneqAuAv : Au <> Av.
			            { exact Hneq. }
		            claim HzInt : z :e IntPts Au.
		            { exact (Hinter_in_IntPts Au Av z HAuArcs HAvArcs HneqAuAv (binintersectI Au Av z HzAu HzAv)). }
		            claim Hzneqx : z <> x.
		            {
		              assume Hzx.
			              claim HxAv : x :e Av.
			              { rewrite <- Hzx. exact HzAv. }
			              claim HexBad : exists A:set, A :e Arcs /\ x :e A /\ y :e A.
			              {
			                witness Av.
			                claim H01 : Av :e Arcs /\ x :e Av.
			                { exact (andI (Av :e Arcs) (x :e Av) HAvArcs HxAv). }
			                exact (andI (Av :e Arcs /\ x :e Av) (y :e Av) H01 HyAv).
			              }
			              exact (HnoCommon HexBad).
		            }
		            claim HzNotSing : z /:e Sing x.
		            {
		              assume HzSing.
		              claim Hzx : z = x.
		              { exact (SingE x z HzSing). }
		              exact (Hzneqx Hzx).
		            }
		            claim HzRem : z :e IntPts Au :\: Sing x.
		            { exact (setminusI (IntPts Au) (Sing x) z HzInt HzNotSing). }
				            claim HzNotRem : z /:e (IntPts Au :\: Sing x).
				            {
				              claim HzNxAu : z :e Nx Au.
				              { rewrite <- HDueq. exact HzDu. }
				              exact (setminusE2 Au (IntPts Au :\: Sing x) z HzNxAu).
				            }
				            exact (FalseE (HzNotRem HzRem) (z :e Empty)).
			        }
		        witness U.
		        witness V.
		        claim HUV0 : (U :e Tx /\ V :e Tx).
		        { exact (andI (U :e Tx) (V :e Tx) HUopen HVopen). }
		        claim HUV1 : (U :e Tx /\ V :e Tx) /\ x :e U.
		        { exact (andI (U :e Tx /\ V :e Tx) (x :e U) HUV0 HxU). }
			        claim HUV2 : ((U :e Tx /\ V :e Tx) /\ x :e U) /\ y :e V.
			        { exact (andI ((U :e Tx /\ V :e Tx) /\ x :e U) (y :e V) HUV1 HyV). }
				        exact (andI (((U :e Tx /\ V :e Tx) /\ x :e U) /\ y :e V) (U :/\: V = Empty) HUV2 HUVEmpty).
		    }
		    exact (andI
		      (topology_on X Tx)
		      (forall x1 x2 : set , x1 :e X -> x2 :e X -> x1 <> x2 ->
		        exists U V : set , U :e Tx /\ V :e Tx /\ x1 :e U /\ x2 :e V /\ U :/\: V = Empty)
		      HtopX
		      Hsep).
			  }
				  exact HHausX2.
		Qed.

(** from S64 Exercise 1(b) (line 2367 in algtop.tex) **)
(** LATEX VERSION: Give an example to show that X (union of finitely many **)
(** arcs intersecting only at endpoints) need not be Hausdorff. **)
(** EFFORT: 3 lines textbook, difficulty 2/10, USD 20 **)
(** Bounty 22 **)
Theorem ex64_1b_non_hausdorff_arc_union :
  exists X Tx Arcs:set,
    topology_on X Tx /\
    finite Arcs /\
    X = Union Arcs /\
    (forall A:set, A :e Arcs -> A c= X /\ arc A (subspace_topology X Tx A)) /\
    (forall A B:set, A :e Arcs -> B :e Arcs -> A <> B ->
      (A :/\: B = Empty \/ exists p:set, A :/\: B = Sing p)) /\
    ~Hausdorff_space X Tx.
admit.
Admitted.

