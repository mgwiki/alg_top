        claim Happ_red :
          reduced_word (J :\/: K) Hfam efamH (ordsucc m)
            (graph (ordsucc m) (fun i:set => if i :e m then apply_fun xs i else apply_fun ys 0)).
        {
          exact (andEL
            (reduced_word (J :\/: K) Hfam efamH (ordsucc m)
              (graph (ordsucc m) (fun i:set => if i :e m then apply_fun xs i else apply_fun ys 0)))
            (word_product multG eG
              (graph (ordsucc m) (fun i:set => if i :e m then apply_fun xs i else apply_fun ys 0))
              (ordsucc m) =
              apply_fun multG (word_product multG eG xs m, apply_fun ys 0))
            Happend0).
        }
        claim Happ_prod :
          word_product multG eG
            (graph (ordsucc m) (fun i:set => if i :e m then apply_fun xs i else apply_fun ys 0))
            (ordsucc m) =
            apply_fun multG (word_product multG eG xs m, apply_fun ys 0).
        {
          exact (andER
            (reduced_word (J :\/: K) Hfam efamH (ordsucc m)
              (graph (ordsucc m) (fun i:set => if i :e m then apply_fun xs i else apply_fun ys 0)))
            (word_product multG eG
              (graph (ordsucc m) (fun i:set => if i :e m then apply_fun xs i else apply_fun ys 0))
              (ordsucc m) =
              apply_fun multG (word_product multG eG xs m, apply_fun ys 0))
            Happend0).
        }
	        witness (ordsucc m).
	        witness (graph (ordsucc m) (fun i:set => if i :e m then apply_fun xs i else apply_fun ys 0)).
	        apply and4I.
	        + exact Happ_red.
	        + claim Hwp1 :
	            word_product multG eG ys (ordsucc 0) =
	              apply_fun multG (word_product multG eG ys 0, apply_fun ys 0).
          { exact (word_product_succ multG eG ys 0 nat_0). }
          claim Hwp0 : word_product multG eG ys 0 = eG.
          { exact (nat_primrec_0 eG
              (fun i r => apply_fun multG (r, apply_fun ys i))). }
          claim Hwp1_eq : word_product multG eG ys (ordsucc 0) = apply_fun ys 0.
          { rewrite Hwp1. rewrite Hwp0.
            apply (and6E
              (function_on multG (setprod G G) G)
              (function_on invG G G)
              (eG :e G)
              (forall x y z:set, x :e G -> y :e G -> z :e G ->
                apply_fun multG (apply_fun multG (x, y), z) =
                  apply_fun multG (x, apply_fun multG (y, z)))
              (forall y:set, y :e G -> apply_fun multG (eG, y) = y /\ apply_fun multG (y, eG) = y)
              (forall y:set, y :e G ->
                apply_fun multG (y, apply_fun invG y) = eG /\
                apply_fun multG (apply_fun invG y, y) = eG)
              Hgrp).
            assume _ _ _ _ Hid _.
            claim Hy0G : apply_fun ys 0 :e G.
            {
              apply (reduced_word_in_G G multG eG invG (J :\/: K) Hfam efamH p ys Hsubfam_union Hredys 0).
              exact H0in.
            }
            exact (andEL
              (apply_fun multG (eG, apply_fun ys 0) = apply_fun ys 0)
              (apply_fun multG (apply_fun ys 0, eG) = apply_fun ys 0)
              (Hid (apply_fun ys 0) Hy0G)).
          }
	          rewrite Happ_prod.
	          rewrite Hwp1_eq.
	          reflexivity.
	        + let i. assume Hi.
	          apply (ordsuccE m i Hi).
	          * assume Him.
	            rewrite (apply_fun_graph (ordsucc m)
	              (fun t:set => if t :e m then apply_fun xs t else apply_fun ys 0)
	              i Hi).
	            rewrite (If_i_1 (i :e m) (apply_fun xs i) (apply_fun ys 0) Him).
	            exact (Hxs_ne i Him).
	          * assume Hieq.
	            rewrite Hieq.
	            rewrite (apply_fun_graph (ordsucc m)
	              (fun t:set => if t :e m then apply_fun xs t else apply_fun ys 0)
	              m (ordsuccI2 m)).
	            rewrite (If_i_0 (m :e m) (apply_fun xs m) (apply_fun ys 0) (In_irref m)).
	            exact (HallNe 0 H0in).
	        + witness m. apply andI.
	          * reflexivity.
	          * claim Hlast :
	              apply_fun (graph (ordsucc m) (fun i:set => if i :e m then apply_fun xs i else apply_fun ys 0)) m =
	              apply_fun ys 0.
            {
              rewrite (apply_fun_graph (ordsucc m)
                (fun i:set => if i :e m then apply_fun xs i else apply_fun ys 0)
                m (ordsuccI2 m)).
              rewrite (If_i_0 (m :e m) (apply_fun xs m) (apply_fun ys 0) (In_irref m)).
              reflexivity.
            }
            exact Hlast.
      - let k. assume Hk_nat IH.
        assume Hsk_in : ordsucc k :e p.
        claim Hk_in : k :e p.
        {
          claim Hp_ord : ordinal p.
          { exact (nat_p_ordinal p Hp_nat). }
          claim Hsucsucc_sub : ordsucc (ordsucc k) c= p.
          { exact (ordinal_ordsucc_In_Subq p Hp_ord (ordsucc k) Hsk_in). }
          exact (Hsucsucc_sub k (ordsuccI1 (ordsucc k) k (ordsuccI2 k))).
        }
        apply (IH Hk_in).
        let m0. assume Hpack0.
        apply Hpack0.
	        let zs0. assume Hpack1.
	        apply (and4E
	          (reduced_word (J :\/: K) Hfam efamH m0 zs0)
	          (word_product multG eG zs0 m0 =
	            apply_fun multG (word_product multG eG xs m, word_product multG eG ys (ordsucc k)))
	          (forall i:set, i :e m0 -> apply_fun zs0 i <> eG)
	          (exists r:set, m0 = ordsucc r /\ apply_fun zs0 r = apply_fun ys k)
	          Hpack1).
	        assume Hred0 Hprod0 HallNe0 Hlast0.
        apply Hlast0. let r0. assume Hlast0_pack.
        claim Hm0_eq : m0 = ordsucc r0.
        { exact (andEL (m0 = ordsucc r0) (apply_fun zs0 r0 = apply_fun ys k) Hlast0_pack). }
        claim Hlast_eq : apply_fun zs0 r0 = apply_fun ys k.
        { exact (andER (m0 = ordsucc r0) (apply_fun zs0 r0 = apply_fun ys k) Hlast0_pack). }
        claim Hys_succ_pack :
          exists beta0:set, beta0 :e J :\/: K /\
            apply_fun ys (ordsucc k) :e apply_fun Hfam beta0 /\
            apply_fun ys (ordsucc k) <> apply_fun efamH beta0.
        { apply (and3E
            (p :e omega)
            (forall j:set, j :e p ->
              exists alpha0:set, alpha0 :e J :\/: K /\
                apply_fun ys j :e apply_fun Hfam alpha0 /\
                apply_fun ys j <> apply_fun efamH alpha0)
            (forall j:set, j :e p -> ordsucc j :e p ->
              forall alpha0 beta0:set, alpha0 :e J :\/: K -> beta0 :e J :\/: K ->
                apply_fun ys j :e apply_fun Hfam alpha0 ->
                apply_fun ys (ordsucc j) :e apply_fun Hfam beta0 ->
                alpha0 <> beta0)
            Hredys).
          assume _ Helem _. exact (Helem (ordsucc k) Hsk_in). }
        apply Hys_succ_pack. let beta0. assume Hbeta0_pack.
        apply (and3E
          (beta0 :e J :\/: K)
          (apply_fun ys (ordsucc k) :e apply_fun Hfam beta0)
          (apply_fun ys (ordsucc k) <> apply_fun efamH beta0)
          Hbeta0_pack).
        assume Hbeta0 Hy1 Hb1_ne.
        claim Hlast_diff :
          forall kk alpha beta:set, m0 = ordsucc kk -> alpha :e J :\/: K -> beta :e J :\/: K ->
            apply_fun zs0 kk :e apply_fun Hfam alpha ->
            apply_fun ys (ordsucc k) :e apply_fun Hfam beta ->
            alpha <> beta.
        {
          let kk alpha beta. assume Hm0_eq2 Hal Hbe Hzs Hb.
          claim Hrk_eq : r0 = kk.
          {
            claim Hs1 : ordsucc kk = m0.
            { exact (eq_symm m0 (ordsucc kk) Hm0_eq2). }
            claim Hs2 : m0 = ordsucc r0.
            { exact Hm0_eq. }
            claim Hs3 : ordsucc kk = ordsucc r0.
            { exact (eq_i_tra (ordsucc kk) m0 (ordsucc r0) Hs1 Hs2). }
            exact (eq_symm kk r0 (ordsucc_inj kk r0 Hs3)).
          }
          claim Hzk : apply_fun ys k :e apply_fun Hfam alpha.
          { rewrite <- Hlast_eq. rewrite Hrk_eq. exact Hzs. }
          exact (Hadj_any_G2 p ys Hredys HallG2 HallNe k Hk_in Hsk_in alpha beta Hal Hbe Hzk Hb).
        }
        claim Happend1 :
          reduced_word (J :\/: K) Hfam efamH (ordsucc m0)
            (graph (ordsucc m0) (fun i:set => if i :e m0 then apply_fun zs0 i else apply_fun ys (ordsucc k))) /\
          word_product multG eG
            (graph (ordsucc m0) (fun i:set => if i :e m0 then apply_fun zs0 i else apply_fun ys (ordsucc k)))
            (ordsucc m0) =
            apply_fun multG (word_product multG eG zs0 m0, apply_fun ys (ordsucc k)).
        {
          apply (Happend_red_one_prod m0 zs0 (apply_fun ys (ordsucc k)) beta0 Hred0).
          - rewrite Hm0_eq. exact (neq_i_sym 0 (ordsucc r0) (neq_0_ordsucc r0)).
          - exact Hbeta0.
          - exact Hy1.
          - exact Hb1_ne.
          - exact Hlast_diff.
        }
        claim Happ_red :
          reduced_word (J :\/: K) Hfam efamH (ordsucc m0)
            (graph (ordsucc m0) (fun i:set => if i :e m0 then apply_fun zs0 i else apply_fun ys (ordsucc k))).
        {
          exact (andEL
            (reduced_word (J :\/: K) Hfam efamH (ordsucc m0)
              (graph (ordsucc m0) (fun i:set => if i :e m0 then apply_fun zs0 i else apply_fun ys (ordsucc k))))
            (word_product multG eG
              (graph (ordsucc m0) (fun i:set => if i :e m0 then apply_fun zs0 i else apply_fun ys (ordsucc k)))
              (ordsucc m0) =
              apply_fun multG (word_product multG eG zs0 m0, apply_fun ys (ordsucc k)))
            Happend1).
        }
        claim Happ_prod :
          word_product multG eG
            (graph (ordsucc m0) (fun i:set => if i :e m0 then apply_fun zs0 i else apply_fun ys (ordsucc k)))
            (ordsucc m0) =
            apply_fun multG (word_product multG eG zs0 m0, apply_fun ys (ordsucc k)).
        {
          exact (andER
            (reduced_word (J :\/: K) Hfam efamH (ordsucc m0)
              (graph (ordsucc m0) (fun i:set => if i :e m0 then apply_fun zs0 i else apply_fun ys (ordsucc k))))
            (word_product multG eG
              (graph (ordsucc m0) (fun i:set => if i :e m0 then apply_fun zs0 i else apply_fun ys (ordsucc k)))
              (ordsucc m0) =
              apply_fun multG (word_product multG eG zs0 m0, apply_fun ys (ordsucc k)))
            Happend1).
        }
	        witness (ordsucc m0).
	        witness (graph (ordsucc m0) (fun i:set => if i :e m0 then apply_fun zs0 i else apply_fun ys (ordsucc k))).
	        apply and4I.
	        + exact Happ_red.
	        + claim Hwp_succ :
	            word_product multG eG ys (ordsucc (ordsucc k)) =
	              apply_fun multG (word_product multG eG ys (ordsucc k), apply_fun ys (ordsucc k)).
          { exact (word_product_succ multG eG ys (ordsucc k) (nat_ordsucc k Hk_nat)). }
          rewrite Happ_prod.
          rewrite Hprod0.
          rewrite Hwp_succ.
          claim HxsG : word_product multG eG xs m :e G.
          {
            claim HmO : m :e omega.
            { apply (and3E
                (m :e omega)
                (forall i:set, i :e m ->
                  exists alpha0:set, alpha0 :e J :\/: K /\
                    apply_fun xs i :e apply_fun Hfam alpha0 /\
                    apply_fun xs i <> apply_fun efamH alpha0)
                (forall i:set, i :e m -> ordsucc i :e m ->
                  forall alpha0 beta0:set, alpha0 :e J :\/: K -> beta0 :e J :\/: K ->
                    apply_fun xs i :e apply_fun Hfam alpha0 ->
                    apply_fun xs (ordsucc i) :e apply_fun Hfam beta0 ->
                    alpha0 <> beta0)
                Hredxs).
              assume HmO _ _. exact HmO. }
            claim Hm_nat : nat_p m. { exact (omega_nat_p m HmO). }
            apply (word_product_in_G_group G multG eG invG m xs Hgrp Hm_nat).
            let i. assume Hi.
            exact (reduced_word_in_G G multG eG invG (J :\/: K) Hfam efamH m xs Hsubfam_union Hredxs i Hi).
          }
          claim HysG : word_product multG eG ys (ordsucc k) :e G.
          {
            claim Hsk_nat : nat_p (ordsucc k). { exact (nat_ordsucc k Hk_nat). }
            apply (word_product_in_G_group G multG eG invG (ordsucc k) ys Hgrp Hsk_nat).
            let i. assume Hi.
            claim Hip : i :e p.
            {
              claim Hp_ord : ordinal p.
              { exact (nat_p_ordinal p Hp_nat). }
              claim Hsub : ordsucc (ordsucc k) c= p.
              { exact (ordinal_ordsucc_In_Subq p Hp_ord (ordsucc k) Hsk_in). }
              claim Hi_succsucc : i :e ordsucc (ordsucc k).
              { exact (ordsuccI1 (ordsucc k) i Hi). }
              exact (Hsub i Hi_succsucc).
            }
            exact (reduced_word_in_G G multG eG invG (J :\/: K) Hfam efamH p ys Hsubfam_union Hredys i Hip).
          }
          claim Hy1G : apply_fun ys (ordsucc k) :e G.
          {
            apply (reduced_word_in_G G multG eG invG (J :\/: K) Hfam efamH p ys Hsubfam_union Hredys (ordsucc k)).
            exact Hsk_in.
          }
          apply (and6E
            (function_on multG (setprod G G) G)
            (function_on invG G G)
            (eG :e G)
            (forall x y z:set, x :e G -> y :e G -> z :e G ->
              apply_fun multG (apply_fun multG (x, y), z) =
                apply_fun multG (x, apply_fun multG (y, z)))
            (forall y:set, y :e G -> apply_fun multG (eG, y) = y /\ apply_fun multG (y, eG) = y)
            (forall y:set, y :e G ->
              apply_fun multG (y, apply_fun invG y) = eG /\
              apply_fun multG (apply_fun invG y, y) = eG)
            Hgrp).
          assume _ _ _ Hassoc _ _.
	          exact (Hassoc
	            (word_product multG eG xs m)
	            (word_product multG eG ys (ordsucc k))
	            (apply_fun ys (ordsucc k))
	            HxsG HysG Hy1G).
	        + let i. assume Hi.
	          apply (ordsuccE m0 i Hi).
	          * assume Him0.
	            rewrite (apply_fun_graph (ordsucc m0)
	              (fun t:set => if t :e m0 then apply_fun zs0 t else apply_fun ys (ordsucc k))
	              i Hi).
	            rewrite (If_i_1 (i :e m0) (apply_fun zs0 i) (apply_fun ys (ordsucc k)) Him0).
	            exact (HallNe0 i Him0).
	          * assume Hieq.
	            rewrite Hieq.
	            rewrite (apply_fun_graph (ordsucc m0)
	              (fun t:set => if t :e m0 then apply_fun zs0 t else apply_fun ys (ordsucc k))
	              m0 (ordsuccI2 m0)).
	            rewrite (If_i_0 (m0 :e m0) (apply_fun zs0 m0) (apply_fun ys (ordsucc k)) (In_irref m0)).
	            exact (HallNe (ordsucc k) Hsk_in).
	        + witness m0. apply andI.
	          * reflexivity.
	          * claim Hlast :
	              apply_fun (graph (ordsucc m0)
	                (fun i:set => if i :e m0 then apply_fun zs0 i else apply_fun ys (ordsucc k))) m0 =
                apply_fun ys (ordsucc k).
            {
              rewrite (apply_fun_graph (ordsucc m0)
                (fun i:set => if i :e m0 then apply_fun zs0 i else apply_fun ys (ordsucc k))
                m0 (ordsuccI2 m0)).
              rewrite (If_i_0 (m0 :e m0) (apply_fun zs0 m0) (apply_fun ys (ordsucc k)) (In_irref m0)).
              reflexivity.
            }
            exact Hlast.
    }
    rewrite Hpk.
    apply (Happend_prefix kmax Hkmax_nat Hkmax_in).
	    let m'. assume Hm_pack.
	    apply Hm_pack. let zs. assume Hzs_pack.
	    apply (and4E
	      (reduced_word (J :\/: K) Hfam efamH m' zs)
	      (word_product multG eG zs m' =
	        apply_fun multG (word_product multG eG xs m, word_product multG eG ys (ordsucc kmax)))
	      (forall i:set, i :e m' -> apply_fun zs i <> eG)
	      (exists r:set, m' = ordsucc r /\ apply_fun zs r = apply_fun ys kmax)
	      Hzs_pack).
	    assume Hred Hprod HallNe_zs Hlast.
	    witness m'. witness zs. apply and4I.
	    - exact Hred.
	    - exact Hprod.
	    - exact HallNe_zs.
	    - apply Hlast. let r. assume Hr_pack.
	      witness r.
	      apply andI.
	      * exact (andEL (m' = ordsucc r) (apply_fun zs r = apply_fun ys kmax) Hr_pack).
	      * claim Hzr_eq : apply_fun zs r = apply_fun ys kmax.
	        { exact (andER (m' = ordsucc r) (apply_fun zs r = apply_fun ys kmax) Hr_pack). }
	        claim Hyk_G2 : apply_fun ys kmax :e G2.
	        { exact (HallG2 kmax Hkmax_in). }
	        exact (eq_subst_mem_rev
	          (apply_fun ys kmax)
	          (apply_fun zs r)
	          G2
	          (eq_symm (apply_fun zs r) (apply_fun ys kmax) Hzr_eq)
	          Hyk_G2).
	  }
  (** Base case tool: if the G1/G2 reduced word has length 1, we can expand it directly **)
  claim Hexist_n12_1 :
    n12 = 1 ->
    exists n xs:set,
      reduced_word (J :\/: K) Hfam efamH n xs /\ n <> 0 /\
      word_product multG eG xs n = x.
  {
    assume Hn12_1.
    claim H0in : 0 :e n12.
    { rewrite Hn12_1. exact (nat_0_in_ordsucc 0 nat_0). }
    apply (Hexp_red_each 0 H0in).
    let mi. assume Hmi_pack.
    apply Hmi_pack.
    let yi. assume Hyi_pack.
    apply (and4E
      (reduced_word (J :\/: K) Hfam efamH mi yi)
      (mi <> 0)
      (word_product multG eG yi mi = apply_fun xs12 0)
      ((forall j:set, j :e mi -> apply_fun yi j :e G1) \/
       (forall j:set, j :e mi -> apply_fun yi j :e G2))
      Hyi_pack).
    assume Hred Hmi_ne Hwp _.
    witness mi. witness yi.
    apply and3I.
    - exact Hred.
    - exact Hmi_ne.
    - claim Hxs0_eq_x : apply_fun xs12 0 = x.
      {
        claim Hwp1 :
          word_product multG eG xs12 1 =
            apply_fun multG (word_product multG eG xs12 0, apply_fun xs12 0).
        { exact (word_product_succ multG eG xs12 0 nat_0). }
        claim Hwp0 : word_product multG eG xs12 0 = eG.
        { exact (nat_primrec_0 eG
            (fun i r => apply_fun multG (r, apply_fun xs12 i))). }
        claim Hxs0_G : apply_fun xs12 0 :e G.
        {
          apply (reduced_word_in_G G multG eG invG (UPair 0 1) Gfam12
            (graph (UPair 0 1) (fun _:set => eG)) n12 xs12 Hsubfam12 Hred12word 0).
          rewrite Hn12_1.
          exact (nat_0_in_ordsucc 0 nat_0).
        }
        claim HidL :
          apply_fun multG (eG, apply_fun xs12 0) = apply_fun xs12 0.
        {
          apply (and6E
            (function_on multG (setprod G G) G)
            (function_on invG G G)
            (eG :e G)
            (forall y z w:set, y :e G -> z :e G -> w :e G ->
              apply_fun multG (apply_fun multG (y, z), w) =
                apply_fun multG (y, apply_fun multG (z, w)))
            (forall y:set, y :e G -> apply_fun multG (eG, y) = y /\ apply_fun multG (y, eG) = y)
            (forall y:set, y :e G ->
              apply_fun multG (y, apply_fun invG y) = eG /\
              apply_fun multG (apply_fun invG y, y) = eG)
            Hgrp).
          assume _ _ _ _ Hid _.
          exact (andEL
            (apply_fun multG (eG, apply_fun xs12 0) = apply_fun xs12 0)
            (apply_fun multG (apply_fun xs12 0, eG) = apply_fun xs12 0)
            (Hid (apply_fun xs12 0) Hxs0_G)).
        }
        claim Hwp1_eq : word_product multG eG xs12 1 = apply_fun xs12 0.
        { rewrite Hwp1. rewrite Hwp0. exact HidL. }
        claim Hwp1_eq_x : word_product multG eG xs12 1 = x.
        { rewrite <- Hn12_1. exact Hwp12. }
        exact (eq_i_tra (apply_fun xs12 0) (word_product multG eG xs12 1) x
          (eq_symm (word_product multG eG xs12 1) (apply_fun xs12 0) Hwp1_eq)
          Hwp1_eq_x).
      }
      rewrite Hwp.
      exact Hxs0_eq_x.
  }
  (** Base case tool with side info: length 1 reduced word expands entirely in G1 or G2 **)
  claim Hexist_n12_1_side :
    n12 = 1 ->
    exists n xs:set,
      reduced_word (J :\/: K) Hfam efamH n xs /\ n <> 0 /\
      word_product multG eG xs n = x /\
      ((forall j:set, j :e n -> apply_fun xs j :e G1) \/
       (forall j:set, j :e n -> apply_fun xs j :e G2)) /\
      (forall j:set, j :e n -> apply_fun xs j <> eG).
  {
    assume Hn12_1.
    claim H0in : 0 :e n12.
    { rewrite Hn12_1. exact (nat_0_in_ordsucc 0 nat_0). }
    apply (Hexp_red_each 0 H0in).
    let mi. assume Hmi_pack.
    apply Hmi_pack.
    let yi. assume Hyi_pack.
    apply (and4E
      (reduced_word (J :\/: K) Hfam efamH mi yi)
      (mi <> 0)
      (word_product multG eG yi mi = apply_fun xs12 0)
      ((forall j:set, j :e mi -> apply_fun yi j :e G1) \/
       (forall j:set, j :e mi -> apply_fun yi j :e G2))
      Hyi_pack).
    assume Hred Hmi_ne Hwp Hor.
    claim HallNe : forall j:set, j :e mi -> apply_fun yi j <> eG.
    {
      let j. assume Hj.
      claim HmiO : mi :e omega.
      {
        apply (and3E
          (mi :e omega)
          (forall k:set, k :e mi ->
            exists alpha:set, alpha :e J :\/: K /\
              apply_fun yi k :e apply_fun Hfam alpha /\
              apply_fun yi k <> apply_fun efamH alpha)
          (forall k:set, k :e mi -> ordsucc k :e mi ->
            forall alpha beta:set, alpha :e J :\/: K -> beta :e J :\/: K ->
              apply_fun yi k :e apply_fun Hfam alpha ->
              apply_fun yi (ordsucc k) :e apply_fun Hfam beta ->
              alpha <> beta)
          Hred).
        assume HmiO _ _. exact HmiO.
      }
      apply (xm (mi = 1)).
      + assume Hmi1.
        claim Hj1 : j :e 1.
        { exact (eq_subst_mem_set j mi 1 Hj Hmi1). }
        claim Hj1' : j :e ordsucc 0.
        { exact (eq_subst_mem_set j 1 (ordsucc 0) Hj1
            (eq_symm 1 (ordsucc 0) ordsucc_0_eq_1_nat)). }
        apply (ordsuccE 0 j Hj1').
        * assume Hj0 : j :e 0.
          exact (FalseE (EmptyE j Hj0) (apply_fun yi j <> eG)).
        * assume Hj0eq : j = 0.
          claim Hy0_G : apply_fun yi 0 :e G.
          {
            apply (reduced_word_in_G G multG eG invG (J :\/: K) Hfam efamH mi yi Hsubfam_union Hred 0).
            rewrite Hmi1.
            exact (nat_0_in_ordsucc 0 nat_0).
          }
          claim Hwp1 : word_product multG eG yi 1 =
            apply_fun multG (word_product multG eG yi 0, apply_fun yi 0).
          { exact (word_product_succ multG eG yi 0 nat_0). }
          claim Hwp0 : word_product multG eG yi 0 = eG.
          {
            exact (nat_primrec_0 eG
              (fun k r => apply_fun multG (r, apply_fun yi k))).
          }
          claim HidL : apply_fun multG (eG, apply_fun yi 0) = apply_fun yi 0.
          {
            apply (and6E
              (function_on multG (setprod G G) G)
              (function_on invG G G)
              (eG :e G)
              (forall y z w:set, y :e G -> z :e G -> w :e G ->
                apply_fun multG (apply_fun multG (y, z), w) =
                  apply_fun multG (y, apply_fun multG (z, w)))
              (forall y:set, y :e G -> apply_fun multG (eG, y) = y /\ apply_fun multG (y, eG) = y)
              (forall y:set, y :e G ->
                apply_fun multG (y, apply_fun invG y) = eG /\
                apply_fun multG (apply_fun invG y, y) = eG)
              Hgrp).
            assume _ _ _ _ Hid _.
            exact (andEL
              (apply_fun multG (eG, apply_fun yi 0) = apply_fun yi 0)
              (apply_fun multG (apply_fun yi 0, eG) = apply_fun yi 0)
              (Hid (apply_fun yi 0) Hy0_G)).
          }
          claim Hwp1_eq : word_product multG eG yi 1 = apply_fun yi 0.
          { rewrite Hwp1. rewrite Hwp0. exact HidL. }
          claim Hwp1_eq_x : word_product multG eG yi 1 = apply_fun xs12 0.
          { rewrite <- Hmi1. exact Hwp. }
          claim Hy0_eq_x : apply_fun yi 0 = apply_fun xs12 0.
          { exact (eq_i_tra (apply_fun yi 0) (word_product multG eG yi 1) (apply_fun xs12 0)
              (eq_symm (word_product multG eG yi 1) (apply_fun yi 0) Hwp1_eq)
              Hwp1_eq_x). }
          rewrite Hj0eq.
          assume Habs : apply_fun yi 0 = eG.
          apply (Hxs12_ne 0 H0in).
          rewrite <- Hy0_eq_x.
          exact Habs.
      + assume Hmi_ne1.
        exact (reduced_word_no_eG_all
          G multG eG invG (J :\/: K) Hfam efamH
          mi yi Hgrp Hsubfam_union Hred Hmi_ne Hmi_ne1 j Hj).
    }
    claim Hxs0_eq_x : apply_fun xs12 0 = x.
    {
      claim Hwp1 :
        word_product multG eG xs12 1 =
          apply_fun multG (word_product multG eG xs12 0, apply_fun xs12 0).
      { exact (word_product_succ multG eG xs12 0 nat_0). }
      claim Hwp0 : word_product multG eG xs12 0 = eG.
      { exact (nat_primrec_0 eG
          (fun i r => apply_fun multG (r, apply_fun xs12 i))). }
      claim Hxs0_G : apply_fun xs12 0 :e G.
      {
        apply (reduced_word_in_G G multG eG invG (UPair 0 1) Gfam12
          (graph (UPair 0 1) (fun _:set => eG)) n12 xs12 Hsubfam12 Hred12word 0).
        rewrite Hn12_1.
        exact (nat_0_in_ordsucc 0 nat_0).
      }
      claim HidL :
        apply_fun multG (eG, apply_fun xs12 0) = apply_fun xs12 0.
      {
        apply (and6E
          (function_on multG (setprod G G) G)
          (function_on invG G G)
          (eG :e G)
          (forall y z w:set, y :e G -> z :e G -> w :e G ->
            apply_fun multG (apply_fun multG (y, z), w) =
              apply_fun multG (y, apply_fun multG (z, w)))
          (forall y:set, y :e G -> apply_fun multG (eG, y) = y /\ apply_fun multG (y, eG) = y)
          (forall y:set, y :e G ->
            apply_fun multG (y, apply_fun invG y) = eG /\
            apply_fun multG (apply_fun invG y, y) = eG)
          Hgrp).
        assume _ _ _ _ Hid _.
        exact (andEL
          (apply_fun multG (eG, apply_fun xs12 0) = apply_fun xs12 0)
          (apply_fun multG (apply_fun xs12 0, eG) = apply_fun xs12 0)
          (Hid (apply_fun xs12 0) Hxs0_G)).
      }
      claim Hwp1_eq : word_product multG eG xs12 1 = apply_fun xs12 0.
      { rewrite Hwp1. rewrite Hwp0. exact HidL. }
      claim Hwp1_eq_x : word_product multG eG xs12 1 = x.
      { rewrite <- Hn12_1. exact Hwp12. }
      exact (eq_i_tra (apply_fun xs12 0) (word_product multG eG xs12 1) x
        (eq_symm (word_product multG eG xs12 1) (apply_fun xs12 0) Hwp1_eq)
        Hwp1_eq_x).
    }
    claim Hwp_x : word_product multG eG yi mi = x.
    { rewrite Hwp. exact Hxs0_eq_x. }
    witness mi. witness yi.
    apply and5I.
    - exact Hred.
    - exact Hmi_ne.
    - exact Hwp_x.
    - exact Hor.
    - exact HallNe.
  }
  (** Base case tool: if the G1/G2 reduced word has length 2, expand and append **)
  claim Hexist_n12_2 :
    n12 = 2 ->
    exists n xs:set,
      reduced_word (J :\/: K) Hfam efamH n xs /\ n <> 0 /\
      word_product multG eG xs n = x.
  {
    assume Hn12_2.
    claim H0in : 0 :e n12.
    { exact (eq_subst_mem_set 0 2 n12 In_0_2 (eq_symm n12 2 Hn12_2)). }
    claim H1in : 1 :e n12.
    { exact (eq_subst_mem_set 1 2 n12 In_1_2 (eq_symm n12 2 Hn12_2)). }
    claim Hxs12fam0 :
      exists alpha0:set, alpha0 :e (UPair 0 1) /\
        apply_fun xs12 0 :e apply_fun Gfam12 alpha0 /\
        apply_fun xs12 0 <> apply_fun (graph (UPair 0 1) (fun _:set => eG)) alpha0.
    {
      apply (and3E
        (n12 :e omega)
        (forall i:set, i :e n12 ->
          exists alpha:set, alpha :e (UPair 0 1) /\
            apply_fun xs12 i :e apply_fun Gfam12 alpha /\
            apply_fun xs12 i <> apply_fun (graph (UPair 0 1) (fun _:set => eG)) alpha)
        (forall i:set, i :e n12 -> ordsucc i :e n12 ->
          forall alpha beta:set, alpha :e (UPair 0 1) -> beta :e (UPair 0 1) ->
            apply_fun xs12 i :e apply_fun Gfam12 alpha ->
            apply_fun xs12 (ordsucc i) :e apply_fun Gfam12 beta ->
            alpha <> beta)
        Hred12word).
      assume _ Hxs12fam _. exact (Hxs12fam 0 H0in).
    }
    claim Hxs12fam1 :
      exists alpha1:set, alpha1 :e (UPair 0 1) /\
        apply_fun xs12 1 :e apply_fun Gfam12 alpha1 /\
        apply_fun xs12 1 <> apply_fun (graph (UPair 0 1) (fun _:set => eG)) alpha1.
    {
      apply (and3E
        (n12 :e omega)
        (forall i:set, i :e n12 ->
          exists alpha:set, alpha :e (UPair 0 1) /\
            apply_fun xs12 i :e apply_fun Gfam12 alpha /\
            apply_fun xs12 i <> apply_fun (graph (UPair 0 1) (fun _:set => eG)) alpha)
        (forall i:set, i :e n12 -> ordsucc i :e n12 ->
          forall alpha beta:set, alpha :e (UPair 0 1) -> beta :e (UPair 0 1) ->
            apply_fun xs12 i :e apply_fun Gfam12 alpha ->
            apply_fun xs12 (ordsucc i) :e apply_fun Gfam12 beta ->
            alpha <> beta)
        Hred12word).
      assume _ Hxs12fam _. exact (Hxs12fam 1 H1in).
    }
    apply Hxs12fam0. let alpha0. assume Halpha0_pack.
    apply (and3E
      (alpha0 :e UPair 0 1)
      (apply_fun xs12 0 :e apply_fun Gfam12 alpha0)
      (apply_fun xs12 0 <> apply_fun (graph (UPair 0 1) (fun _:set => eG)) alpha0)
      Halpha0_pack).
    assume Hal0 Hx0fam _.
    apply Hxs12fam1. let alpha1. assume Halpha1_pack.
    apply (and3E
      (alpha1 :e UPair 0 1)
      (apply_fun xs12 1 :e apply_fun Gfam12 alpha1)
      (apply_fun xs12 1 <> apply_fun (graph (UPair 0 1) (fun _:set => eG)) alpha1)
      Halpha1_pack).
    assume Hal1 Hx1fam _.
    claim Hadj12 :
      forall i:set, i :e n12 -> ordsucc i :e n12 ->
        forall alpha beta:set, alpha :e (UPair 0 1) -> beta :e (UPair 0 1) ->
          apply_fun xs12 i :e apply_fun Gfam12 alpha ->
          apply_fun xs12 (ordsucc i) :e apply_fun Gfam12 beta ->
          alpha <> beta.
    {
      apply (and3E
        (n12 :e omega)
        (forall i:set, i :e n12 ->
          exists alpha:set, alpha :e (UPair 0 1) /\
            apply_fun xs12 i :e apply_fun Gfam12 alpha /\
            apply_fun xs12 i <> apply_fun (graph (UPair 0 1) (fun _:set => eG)) alpha)
        (forall i:set, i :e n12 -> ordsucc i :e n12 ->
          forall alpha beta:set, alpha :e (UPair 0 1) -> beta :e (UPair 0 1) ->
            apply_fun xs12 i :e apply_fun Gfam12 alpha ->
            apply_fun xs12 (ordsucc i) :e apply_fun Gfam12 beta ->
            alpha <> beta)
        Hred12word).
      assume _ _ Hadj. exact Hadj.
    }
    claim Halpha_ne : alpha0 <> alpha1.
    { exact (Hadj12 0 H0in H1in alpha0 alpha1 Hal0 Hal1 Hx0fam Hx1fam). }
    apply (UPairE alpha0 0 1 Hal0).
    - assume Halpha0_0.
      claim Hx0G1 : apply_fun xs12 0 :e G1.
      {
        claim Hfam0_eq : apply_fun Gfam12 alpha0 = G1.
        {
          rewrite (apply_fun_graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2) alpha0 Hal0).
          exact (If_i_1 (alpha0 = 0) G1 G2 Halpha0_0).
        }
        exact (eq_subst_mem_set (apply_fun xs12 0) (apply_fun Gfam12 alpha0) G1 Hx0fam Hfam0_eq).
      }
      claim Hx1G2 : apply_fun xs12 1 :e G2.
      {
        apply (UPairE alpha1 0 1 Hal1).
        + assume Halpha1_0.
          claim Haeq : alpha0 = alpha1.
          { rewrite Halpha0_0. rewrite Halpha1_0. reflexivity. }
          exact (FalseE (Halpha_ne Haeq) (apply_fun xs12 1 :e G2)).
        + assume Halpha1_1.
          claim Hfam1_eq : apply_fun Gfam12 alpha1 = G2.
          {
            rewrite (apply_fun_graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2) alpha1 Hal1).
            claim Halpha1_ne0 : alpha1 <> 0.
            { rewrite Halpha1_1. exact neq_1_0. }
            exact (If_i_0 (alpha1 = 0) G1 G2 Halpha1_ne0).
          }
          exact (eq_subst_mem_set (apply_fun xs12 1) (apply_fun Gfam12 alpha1) G2 Hx1fam Hfam1_eq).
      }
      apply (Hexp_red_each_G1_non_e 0 H0in Hx0G1).
      let m0. assume Hm0_pack.
      apply Hm0_pack.
      let ys0. assume Hys0_pack.
      apply (and5E
        (reduced_word (J :\/: K) Hfam efamH m0 ys0)
        (m0 <> 0)
        (word_product multG eG ys0 m0 = apply_fun xs12 0)
        (forall j:set, j :e m0 -> apply_fun ys0 j :e G1)
        (forall j:set, j :e m0 -> apply_fun ys0 j <> eG)
        Hys0_pack).
      assume Hred0 Hm0_ne Hwp0 HallG1 HallNe0.
      apply (Hexp_red_each_G2_non_e 1 H1in Hx1G2).
      let m1. assume Hm1_pack.
      apply Hm1_pack.
      let ys1. assume Hys1_pack.
      apply (and5E
        (reduced_word (J :\/: K) Hfam efamH m1 ys1)
        (m1 <> 0)
        (word_product multG eG ys1 m1 = apply_fun xs12 1)
        (forall j:set, j :e m1 -> apply_fun ys1 j :e G2)
        (forall j:set, j :e m1 -> apply_fun ys1 j <> eG)
        Hys1_pack).
      assume Hred1 Hm1_ne Hwp1 HallG2 HallNe1.
      claim Hm1_nat : nat_p m1.
      {
        apply (and3E
          (m1 :e omega)
          (forall j:set, j :e m1 ->
            exists alpha:set, alpha :e J :\/: K /\
              apply_fun ys1 j :e apply_fun Hfam alpha /\
              apply_fun ys1 j <> apply_fun efamH alpha)
          (forall j:set, j :e m1 -> ordsucc j :e m1 ->
            forall alpha beta:set, alpha :e J :\/: K -> beta :e J :\/: K ->
              apply_fun ys1 j :e apply_fun Hfam alpha ->
              apply_fun ys1 (ordsucc j) :e apply_fun Hfam beta ->
              alpha <> beta)
          Hred1).
        assume Hm1O _ _. exact (omega_nat_p m1 Hm1O).
      }
      claim Hm1_succ : exists k1:set, m1 = ordsucc k1.
      { exact (Hnat_nonzero_succ m1 Hm1_nat Hm1_ne). }
      apply Hm1_succ. let k1. assume Hm1_eq.
      claim Hk1_nat : nat_p k1.
      {
        claim Hk1_in : k1 :e m1.
        { rewrite Hm1_eq. exact (ordsuccI2 k1). }
        exact (nat_p_trans m1 Hm1_nat k1 Hk1_in).
      }
      claim Hm1_0in : 0 :e m1.
      { rewrite Hm1_eq. exact (nat_0_in_ordsucc k1 Hk1_nat). }
      claim Hboundary0 :
        forall k alpha beta:set, m0 = ordsucc k -> alpha :e J :\/: K -> beta :e J :\/: K ->
          apply_fun ys0 k :e apply_fun Hfam alpha ->
          apply_fun ys1 0 :e apply_fun Hfam beta ->
          alpha <> beta.
      {
        let k alpha beta. assume Hm0_eq Hal Hbe Hy0 Hy1.
        apply (Halpha_beta_diff (apply_fun ys0 k) (apply_fun ys1 0) alpha beta).
        - exact (HallG1 k (eq_subst_mem_set k (ordsucc k) m0 (ordsuccI2 k) (eq_symm m0 (ordsucc k) Hm0_eq))).
        - exact (HallNe0 k (eq_subst_mem_set k (ordsucc k) m0 (ordsuccI2 k) (eq_symm m0 (ordsucc k) Hm0_eq))).
        - exact (HallG2 0 Hm1_0in).
        - exact (HallNe1 0 Hm1_0in).
        - exact Hal.
        - exact Hbe.
        - exact Hy0.
        - exact Hy1.
      }
      apply (Happend_word_G2 m0 ys0 Hred0 Hm0_ne HallNe0 m1 ys1 Hred1 Hm1_ne HallG2 HallNe1 Hboundary0).
      let m. assume Hm_pack.
      apply Hm_pack.
      let ys. assume Hys_pack.
	      claim Hred :
	        reduced_word (J :\/: K) Hfam efamH m ys.
	      {
	        apply (and4E
	          (reduced_word (J :\/: K) Hfam efamH m ys)
	          (word_product multG eG ys m =
	            apply_fun multG (word_product multG eG ys0 m0, word_product multG eG ys1 m1))
	          (forall i:set, i :e m -> apply_fun ys i <> eG)
	          (exists r:set, m = ordsucc r /\ apply_fun ys r :e G2)
	          Hys_pack).
	        assume Hred0 _ _ _. exact Hred0.
	      }
	      claim Hprod :
	        word_product multG eG ys m =
	          apply_fun multG (word_product multG eG ys0 m0, word_product multG eG ys1 m1).
	      {
	        apply (and4E
	          (reduced_word (J :\/: K) Hfam efamH m ys)
	          (word_product multG eG ys m =
	            apply_fun multG (word_product multG eG ys0 m0, word_product multG eG ys1 m1))
	          (forall i:set, i :e m -> apply_fun ys i <> eG)
	          (exists r:set, m = ordsucc r /\ apply_fun ys r :e G2)
	          Hys_pack).
	        assume _ Hprod0 _ _. exact Hprod0.
	      }
      witness m. witness ys.
      claim Hprod_eq :
        word_product multG eG ys m = x.
      {
        claim Hwp2 :
          word_product multG eG xs12 2 = apply_fun multG (apply_fun xs12 0, apply_fun xs12 1).
        {
          claim Hwp1' : word_product multG eG xs12 1 =
            apply_fun multG (word_product multG eG xs12 0, apply_fun xs12 0).
          { exact (word_product_succ multG eG xs12 0 nat_0). }
          claim Hwp0' : word_product multG eG xs12 0 = eG.
          { exact (nat_primrec_0 eG
              (fun i r => apply_fun multG (r, apply_fun xs12 i))). }
          claim Hxs0_G : apply_fun xs12 0 :e G.
          {
            apply (reduced_word_in_G G multG eG invG (UPair 0 1) Gfam12
              (graph (UPair 0 1) (fun _:set => eG)) n12 xs12 Hsubfam12 Hred12word 0).
            exact H0in.
          }
          claim HidL :
            apply_fun multG (eG, apply_fun xs12 0) = apply_fun xs12 0.
          {
            apply (and6E
              (function_on multG (setprod G G) G)
              (function_on invG G G)
              (eG :e G)
              (forall y z w:set, y :e G -> z :e G -> w :e G ->
                apply_fun multG (apply_fun multG (y, z), w) =
                  apply_fun multG (y, apply_fun multG (z, w)))
              (forall y:set, y :e G -> apply_fun multG (eG, y) = y /\ apply_fun multG (y, eG) = y)
              (forall y:set, y :e G ->
                apply_fun multG (y, apply_fun invG y) = eG /\
                apply_fun multG (apply_fun invG y, y) = eG)
              Hgrp).
            assume _ _ _ _ Hid _.
            exact (andEL
              (apply_fun multG (eG, apply_fun xs12 0) = apply_fun xs12 0)
              (apply_fun multG (apply_fun xs12 0, eG) = apply_fun xs12 0)
              (Hid (apply_fun xs12 0) Hxs0_G)).
          }
          claim Hwp1_eq : word_product multG eG xs12 1 = apply_fun xs12 0.
          { rewrite Hwp1'. rewrite Hwp0'. exact HidL. }
          claim Hwp2' :
            word_product multG eG xs12 2 =
              apply_fun multG (word_product multG eG xs12 1, apply_fun xs12 1).
          { exact (word_product_succ multG eG xs12 1 nat_1). }
          rewrite Hwp2'. rewrite Hwp1_eq. reflexivity.
        }
        rewrite Hprod.
        rewrite Hwp0.
        rewrite Hwp1.
        rewrite <- Hwp2.
        rewrite <- Hn12_2.
        exact Hwp12.
      }
      claim Hm_ne : m <> 0.
      {
        assume Hm_eq0.
        claim Hwp0m : word_product multG eG ys m = eG.
        { rewrite Hm_eq0. exact (nat_primrec_0 eG (fun i r => apply_fun multG (r, apply_fun ys i))). }
        claim Hx_e : x = eG.
        { rewrite <- Hprod_eq. exact Hwp0m. }
        exact (Hxne Hx_e).
      }
      apply and3I.
      + exact Hred.
      + exact Hm_ne.
      + exact Hprod_eq.
    - assume Halpha0_1.
      claim Hx0G2 : apply_fun xs12 0 :e G2.
      {
        claim Hfam0_eq : apply_fun Gfam12 alpha0 = G2.
        {
          rewrite (apply_fun_graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2) alpha0 Hal0).
          claim Halpha0_ne0 : alpha0 <> 0.
          { rewrite Halpha0_1. exact neq_1_0. }
          exact (If_i_0 (alpha0 = 0) G1 G2 Halpha0_ne0).
        }
        exact (eq_subst_mem_set (apply_fun xs12 0) (apply_fun Gfam12 alpha0) G2 Hx0fam Hfam0_eq).
      }
      claim Hx1G1 : apply_fun xs12 1 :e G1.
      {
        apply (UPairE alpha1 0 1 Hal1).
        + assume Halpha1_0.
          claim Hfam1_eq : apply_fun Gfam12 alpha1 = G1.
          {
            rewrite (apply_fun_graph (UPair 0 1) (fun i:set => if i = 0 then G1 else G2) alpha1 Hal1).
            exact (If_i_1 (alpha1 = 0) G1 G2 Halpha1_0).
          }
          exact (eq_subst_mem_set (apply_fun xs12 1) (apply_fun Gfam12 alpha1) G1 Hx1fam Hfam1_eq).
        + assume Halpha1_1.
          claim Haeq : alpha0 = alpha1.
          { rewrite Halpha0_1. rewrite Halpha1_1. reflexivity. }
          exact (FalseE (Halpha_ne Haeq) (apply_fun xs12 1 :e G1)).
      }
      apply (Hexp_red_each_G2_non_e 0 H0in Hx0G2).
      let m0. assume Hm0_pack.
      apply Hm0_pack.
      let ys0. assume Hys0_pack.
      apply (and5E
        (reduced_word (J :\/: K) Hfam efamH m0 ys0)
        (m0 <> 0)
        (word_product multG eG ys0 m0 = apply_fun xs12 0)
        (forall j:set, j :e m0 -> apply_fun ys0 j :e G2)
        (forall j:set, j :e m0 -> apply_fun ys0 j <> eG)
        Hys0_pack).
      assume Hred0 Hm0_ne Hwp0 HallG2 HallNe0.
      apply (Hexp_red_each_G1_non_e 1 H1in Hx1G1).
      let m1. assume Hm1_pack.
      apply Hm1_pack.
      let ys1. assume Hys1_pack.
      apply (and5E
        (reduced_word (J :\/: K) Hfam efamH m1 ys1)
        (m1 <> 0)
        (word_product multG eG ys1 m1 = apply_fun xs12 1)
        (forall j:set, j :e m1 -> apply_fun ys1 j :e G1)
        (forall j:set, j :e m1 -> apply_fun ys1 j <> eG)
        Hys1_pack).
      assume Hred1 Hm1_ne Hwp1 HallG1 HallNe1.
      claim Hm1_nat : nat_p m1.
      {
        apply (and3E
          (m1 :e omega)
          (forall j:set, j :e m1 ->
            exists alpha:set, alpha :e J :\/: K /\
              apply_fun ys1 j :e apply_fun Hfam alpha /\
              apply_fun ys1 j <> apply_fun efamH alpha)
          (forall j:set, j :e m1 -> ordsucc j :e m1 ->
            forall alpha beta:set, alpha :e J :\/: K -> beta :e J :\/: K ->
              apply_fun ys1 j :e apply_fun Hfam alpha ->
              apply_fun ys1 (ordsucc j) :e apply_fun Hfam beta ->
              alpha <> beta)
          Hred1).
        assume Hm1O _ _. exact (omega_nat_p m1 Hm1O).
      }
      claim Hm1_succ : exists k1:set, m1 = ordsucc k1.
      { exact (Hnat_nonzero_succ m1 Hm1_nat Hm1_ne). }
      apply Hm1_succ. let k1. assume Hm1_eq.
      claim Hk1_nat : nat_p k1.
      {
        claim Hk1_in : k1 :e m1.
        { rewrite Hm1_eq. exact (ordsuccI2 k1). }
        exact (nat_p_trans m1 Hm1_nat k1 Hk1_in).
      }
      claim Hm1_0in : 0 :e m1.
      { rewrite Hm1_eq. exact (nat_0_in_ordsucc k1 Hk1_nat). }
      claim Hboundary0 :
        forall k alpha beta:set, m0 = ordsucc k -> alpha :e J :\/: K -> beta :e J :\/: K ->
          apply_fun ys0 k :e apply_fun Hfam alpha ->
          apply_fun ys1 0 :e apply_fun Hfam beta ->
          alpha <> beta.
      {
        let k alpha beta. assume Hm0_eq Hal Hbe Hy0 Hy1.
        exact (neq_i_sym beta alpha (Halpha_beta_diff
          (apply_fun ys1 0)
          (apply_fun ys0 k)
          beta
          alpha
          (HallG1 0 Hm1_0in)
          (HallNe1 0 Hm1_0in)
          (HallG2 k (eq_subst_mem_set k (ordsucc k) m0 (ordsuccI2 k) (eq_symm m0 (ordsucc k) Hm0_eq)))
          (HallNe0 k (eq_subst_mem_set k (ordsucc k) m0 (ordsuccI2 k) (eq_symm m0 (ordsucc k) Hm0_eq)))
          Hbe
          Hal
          Hy1
          Hy0)).
      }
      apply (Happend_word_G1 m0 ys0 Hred0 Hm0_ne HallNe0 m1 ys1 Hred1 Hm1_ne HallG1 HallNe1 Hboundary0).
      let m. assume Hm_pack.
      apply Hm_pack.
      let ys. assume Hys_pack.
	      claim Hred :
	        reduced_word (J :\/: K) Hfam efamH m ys.
	      {
	        apply (and4E
	          (reduced_word (J :\/: K) Hfam efamH m ys)
	          (word_product multG eG ys m =
	            apply_fun multG (word_product multG eG ys0 m0, word_product multG eG ys1 m1))
	          (forall i:set, i :e m -> apply_fun ys i <> eG)
	          (exists r:set, m = ordsucc r /\ apply_fun ys r :e G1)
	          Hys_pack).
	        assume Hred0 _ _ _. exact Hred0.
	      }
	      claim Hprod :
	        word_product multG eG ys m =
	          apply_fun multG (word_product multG eG ys0 m0, word_product multG eG ys1 m1).
	      {
	        apply (and4E
	          (reduced_word (J :\/: K) Hfam efamH m ys)
	          (word_product multG eG ys m =
	            apply_fun multG (word_product multG eG ys0 m0, word_product multG eG ys1 m1))
	          (forall i:set, i :e m -> apply_fun ys i <> eG)
	          (exists r:set, m = ordsucc r /\ apply_fun ys r :e G1)
	          Hys_pack).
	        assume _ Hprod0 _ _. exact Hprod0.
	      }
      witness m. witness ys.
      claim Hprod_eq :
        word_product multG eG ys m = x.
      {
        claim Hwp2 :
          word_product multG eG xs12 2 = apply_fun multG (apply_fun xs12 0, apply_fun xs12 1).
        {
          claim Hwp1' : word_product multG eG xs12 1 =
            apply_fun multG (word_product multG eG xs12 0, apply_fun xs12 0).
          { exact (word_product_succ multG eG xs12 0 nat_0). }
          claim Hwp0' : word_product multG eG xs12 0 = eG.
          { exact (nat_primrec_0 eG
              (fun i r => apply_fun multG (r, apply_fun xs12 i))). }
          claim Hxs0_G : apply_fun xs12 0 :e G.
          {
            apply (reduced_word_in_G G multG eG invG (UPair 0 1) Gfam12
              (graph (UPair 0 1) (fun _:set => eG)) n12 xs12 Hsubfam12 Hred12word 0).
            exact H0in.
          }
          claim HidL :
            apply_fun multG (eG, apply_fun xs12 0) = apply_fun xs12 0.
          {
            apply (and6E
              (function_on multG (setprod G G) G)
              (function_on invG G G)
              (eG :e G)
              (forall y z w:set, y :e G -> z :e G -> w :e G ->
                apply_fun multG (apply_fun multG (y, z), w) =
                  apply_fun multG (y, apply_fun multG (z, w)))
              (forall y:set, y :e G -> apply_fun multG (eG, y) = y /\ apply_fun multG (y, eG) = y)
              (forall y:set, y :e G ->
                apply_fun multG (y, apply_fun invG y) = eG /\
                apply_fun multG (apply_fun invG y, y) = eG)
              Hgrp).
            assume _ _ _ _ Hid _.
            exact (andEL
              (apply_fun multG (eG, apply_fun xs12 0) = apply_fun xs12 0)
              (apply_fun multG (apply_fun xs12 0, eG) = apply_fun xs12 0)
              (Hid (apply_fun xs12 0) Hxs0_G)).
          }
          claim Hwp1_eq : word_product multG eG xs12 1 = apply_fun xs12 0.
          { rewrite Hwp1'. rewrite Hwp0'. exact HidL. }
          claim Hwp2' :
            word_product multG eG xs12 2 =
              apply_fun multG (word_product multG eG xs12 1, apply_fun xs12 1).
          { exact (word_product_succ multG eG xs12 1 nat_1). }
          rewrite Hwp2'. rewrite Hwp1_eq. reflexivity.
        }
        rewrite Hprod.
        rewrite Hwp0.
        rewrite Hwp1.
        rewrite <- Hwp2.
        rewrite <- Hn12_2.
        exact Hwp12.
      }
      claim Hm_ne : m <> 0.
      {
        assume Hm_eq0.
        claim Hwp0m : word_product multG eG ys m = eG.
        { rewrite Hm_eq0. exact (nat_primrec_0 eG (fun i r => apply_fun multG (r, apply_fun ys i))). }
        claim Hx_e : x = eG.
        { rewrite <- Hprod_eq. exact Hwp0m. }
        exact (Hxne Hx_e).
      }
      apply and3I.
      + exact Hred.
      + exact Hm_ne.
      + exact Hprod_eq.
  }
  (** TODO: concatenate the expanded reduced words to get a reduced word in J \/ K, and prove uniqueness **)
  apply (xm (n12 = 1)).
  - assume Hn12_1.
    apply (Hexist_n12_1_side Hn12_1).
    let n. assume Hn_pack.
    apply Hn_pack. let xs. assume Hxs_pack.
    apply (and5E
      (reduced_word (J :\/: K) Hfam efamH n xs)
      (n <> 0)
      (word_product multG eG xs n = x)
      ((forall j:set, j :e n -> apply_fun xs j :e G1) \/
       (forall j:set, j :e n -> apply_fun xs j :e G2))
      (forall j:set, j :e n -> apply_fun xs j <> eG)
      Hxs_pack).
    assume Hred Hn_ne Hwp Hor HallNe.
    witness n. witness xs.
    apply and4I.
    + exact Hred.
    + exact Hn_ne.
    + exact Hwp.
    + (** TODO: uniqueness for n12=1 case **)
      let n'. let xs'.
      assume Hred' Hn'_ne Hwp'.
      claim HallNe' : forall j:set, j :e n' -> apply_fun xs' j <> eG.
      {
        let j. assume Hj.
        apply (xm (n' = 1)).
        - assume Hn1.
          claim Hj1 : j :e 1.
          { exact (eq_subst_mem_set j n' 1 Hj Hn1). }
          claim Hj1' : j :e ordsucc 0.
          { exact (eq_subst_mem_set j 1 (ordsucc 0) Hj1
              (eq_symm 1 (ordsucc 0) ordsucc_0_eq_1_nat)). }
          apply (ordsuccE 0 j Hj1').
          * assume Hj0 : j :e 0.
            exact (FalseE (EmptyE j Hj0) (apply_fun xs' j <> eG)).
          * assume Hj0eq : j = 0.
            claim Hxs0_G : apply_fun xs' 0 :e G.
            {
              apply (reduced_word_in_G G multG eG invG (J :\/: K) Hfam efamH n' xs'
                Hsubfam_union Hred' 0).
              rewrite Hn1.
              exact (nat_0_in_ordsucc 0 nat_0).
            }
            claim Hwp1' : word_product multG eG xs' 1 =
              apply_fun multG (word_product multG eG xs' 0, apply_fun xs' 0).
            { exact (word_product_succ multG eG xs' 0 nat_0). }
            claim Hwp0' : word_product multG eG xs' 0 = eG.
            { exact (nat_primrec_0 eG
                (fun i r => apply_fun multG (r, apply_fun xs' i))). }
            claim HidL :
              apply_fun multG (eG, apply_fun xs' 0) = apply_fun xs' 0.
            {
              apply (and6E
                (function_on multG (setprod G G) G)
                (function_on invG G G)
                (eG :e G)
                (forall y z w:set, y :e G -> z :e G -> w :e G ->
                  apply_fun multG (apply_fun multG (y, z), w) =
                    apply_fun multG (y, apply_fun multG (z, w)))
                (forall y:set, y :e G -> apply_fun multG (eG, y) = y /\ apply_fun multG (y, eG) = y)
                (forall y:set, y :e G ->
                  apply_fun multG (y, apply_fun invG y) = eG /\
                  apply_fun multG (apply_fun invG y, y) = eG)
                Hgrp).
              assume _ _ _ _ Hid _.
              exact (andEL
                (apply_fun multG (eG, apply_fun xs' 0) = apply_fun xs' 0)
                (apply_fun multG (apply_fun xs' 0, eG) = apply_fun xs' 0)
                (Hid (apply_fun xs' 0) Hxs0_G)).
            }
            claim Hwp1_eq : word_product multG eG xs' 1 = apply_fun xs' 0.
            { rewrite Hwp1'. rewrite Hwp0'. exact HidL. }
            claim Hwp1_eq_x : word_product multG eG xs' 1 = x.
            { rewrite <- Hn1. exact Hwp'. }
            claim Hxs0_eq_x : apply_fun xs' 0 = x.
            { exact (eq_i_tra (apply_fun xs' 0) (word_product multG eG xs' 1) x
                (eq_symm (word_product multG eG xs' 1) (apply_fun xs' 0) Hwp1_eq)
                Hwp1_eq_x). }
            rewrite Hj0eq.
            rewrite Hxs0_eq_x.
            exact Hxne.
        - assume Hn_ne1.
          exact (reduced_word_no_eG_all
            G multG eG invG (J :\/: K) Hfam efamH
            n' xs' Hgrp Hsubfam_union Hred' Hn'_ne Hn_ne1 j Hj).
      }
      apply Hor.
      * assume HallG1.
        claim HxG1 : x :e G1.
        { rewrite <- Hwp. exact (Hword_product_in_G1 n xs Hred HallG1). }
        claim HredJ : reduced_word J (graph J (fun a:set => apply_fun Hfam a))
          (graph J (fun a:set => apply_fun efamH a)) n xs.
        { exact (Hred_J_of_union n xs Hred HallG1 HallNe). }
        claim Hwp'_G1 : word_product multG eG xs' n' :e G1.
        { rewrite Hwp'. exact HxG1. }
        claim Hwp'_ne : word_product multG eG xs' n' <> eG.
        { rewrite Hwp'. exact Hxne. }
        claim Hside_xs' : forall j:set, j :e n' -> apply_fun xs' j :e G1.
        { exact (Hside_from_product_G1 n' xs' Hred' HallNe' Hwp'_G1 Hwp'_ne). }
        claim HredJ' : reduced_word J (graph J (fun a:set => apply_fun Hfam a))
          (graph J (fun a:set => apply_fun efamH a)) n' xs'.
        { exact (Hred_J_of_union n' xs' Hred' Hside_xs' HallNe'). }
        apply (and6E
          (group_structure G1 multG eG invG)
          (forall alpha:set, alpha :e J ->
            subgroup_of (apply_fun (graph J (fun a:set => apply_fun Hfam a)) alpha) G1 multG eG invG)
          (forall alpha beta:set, alpha :e J -> beta :e J -> alpha <> beta ->
            forall y:set, y :e apply_fun (graph J (fun a:set => apply_fun Hfam a)) alpha ->
              y :e apply_fun (graph J (fun a:set => apply_fun Hfam a)) beta -> y = eG)
          (subgroups_generate G1 multG eG invG J (graph J (fun a:set => apply_fun Hfam a)))
          (forall y:set, y :e G1 -> y <> eG ->
            exists m ys:set,
              reduced_word J (graph J (fun a:set => apply_fun Hfam a))
                (graph J (fun a:set => apply_fun efamH a)) m ys /\ m <> 0 /\
              word_product multG eG ys m = y /\
              (forall m' ys':set,
                reduced_word J (graph J (fun a:set => apply_fun Hfam a))
                  (graph J (fun a:set => apply_fun efamH a)) m' ys' -> m' <> 0 ->
                word_product multG eG ys' m' = y ->
                m = m' /\ (forall i:set, i :e m -> apply_fun ys i = apply_fun ys' i)))
          (forall alpha:set, alpha :e J -> apply_fun (graph J (fun a:set => apply_fun efamH a)) alpha = eG)
          Hfp1).
        assume _ _ _ _ HuniqJ _.
        apply (HuniqJ x HxG1 Hxne).
        let m0. assume Hm0_pack.
        apply Hm0_pack. let ys0. assume Hys0_pack.
        apply (and4E
          (reduced_word J (graph J (fun a:set => apply_fun Hfam a))
            (graph J (fun a:set => apply_fun efamH a)) m0 ys0)
          (m0 <> 0)
          (word_product multG eG ys0 m0 = x)
          (forall m' ys':set,
            reduced_word J (graph J (fun a:set => apply_fun Hfam a))
              (graph J (fun a:set => apply_fun efamH a)) m' ys' -> m' <> 0 ->
            word_product multG eG ys' m' = x ->
            m0 = m' /\ (forall i:set, i :e m0 -> apply_fun ys0 i = apply_fun ys' i))
          Hys0_pack).
        assume Hred0 Hm0_ne Hwp0 Huniq0.
        claim Huniq_xs : m0 = n /\ (forall i:set, i :e m0 -> apply_fun ys0 i = apply_fun xs i).
        { exact (Huniq0 n xs HredJ Hn_ne Hwp). }
        claim Huniq_xs' : m0 = n' /\ (forall i:set, i :e m0 -> apply_fun ys0 i = apply_fun xs' i).
        { exact (Huniq0 n' xs' HredJ' Hn'_ne Hwp'). }
        claim Hn_eq : n = n'.
        {
          claim Hm0_eq_n : m0 = n.
          { exact (andEL (m0 = n) (forall i:set, i :e m0 -> apply_fun ys0 i = apply_fun xs i) Huniq_xs). }
          claim Hm0_eq_n' : m0 = n'.
          { exact (andEL (m0 = n') (forall i:set, i :e m0 -> apply_fun ys0 i = apply_fun xs' i) Huniq_xs'). }
          exact (eq_i_tra n m0 n'
            (eq_symm m0 n Hm0_eq_n)
            Hm0_eq_n').
        }
        apply andI.
        - exact Hn_eq.
        - let i. assume Hi : i :e n.
          claim Hi0 : i :e m0.
          { exact (eq_subst_mem_set i n m0 Hi (eq_symm m0 n (andEL (m0 = n) (forall i:set, i :e m0 -> apply_fun ys0 i = apply_fun xs i) Huniq_xs))). }
          claim Hys0_xs : apply_fun ys0 i = apply_fun xs i.
          { exact (andER (m0 = n) (forall i:set, i :e m0 -> apply_fun ys0 i = apply_fun xs i) Huniq_xs i Hi0). }
          claim Hys0_xs' : apply_fun ys0 i = apply_fun xs' i.
          { exact (andER (m0 = n') (forall i:set, i :e m0 -> apply_fun ys0 i = apply_fun xs' i) Huniq_xs' i Hi0). }
          exact (eq_i_tra (apply_fun xs i) (apply_fun ys0 i) (apply_fun xs' i)
            (eq_symm (apply_fun ys0 i) (apply_fun xs i) Hys0_xs)
            Hys0_xs').
      * assume HallG2.
        claim HxG2 : x :e G2.
        { rewrite <- Hwp. exact (Hword_product_in_G2 n xs Hred HallG2). }
        claim HredK : reduced_word K (graph K (fun b:set => apply_fun Hfam b))
          (graph K (fun b:set => apply_fun efamH b)) n xs.
        { exact (Hred_K_of_union n xs Hred HallG2 HallNe). }
        claim Hwp'_G2 : word_product multG eG xs' n' :e G2.
        { rewrite Hwp'. exact HxG2. }
        claim Hwp'_ne : word_product multG eG xs' n' <> eG.
        { rewrite Hwp'. exact Hxne. }
        claim Hside_xs' : forall j:set, j :e n' -> apply_fun xs' j :e G2.
        { exact (Hside_from_product_G2 n' xs' Hred' HallNe' Hwp'_G2 Hwp'_ne). }
        claim HredK' : reduced_word K (graph K (fun b:set => apply_fun Hfam b))
          (graph K (fun b:set => apply_fun efamH b)) n' xs'.
        { exact (Hred_K_of_union n' xs' Hred' Hside_xs' HallNe'). }
        apply (and6E
          (group_structure G2 multG eG invG)
          (forall beta:set, beta :e K ->
            subgroup_of (apply_fun (graph K (fun b:set => apply_fun Hfam b)) beta) G2 multG eG invG)
          (forall beta gamma:set, beta :e K -> gamma :e K -> beta <> gamma ->
            forall y:set, y :e apply_fun (graph K (fun b:set => apply_fun Hfam b)) beta ->
              y :e apply_fun (graph K (fun b:set => apply_fun Hfam b)) gamma -> y = eG)
          (subgroups_generate G2 multG eG invG K (graph K (fun b:set => apply_fun Hfam b)))
          (forall y:set, y :e G2 -> y <> eG ->
            exists m ys:set,
              reduced_word K (graph K (fun b:set => apply_fun Hfam b))
                (graph K (fun b:set => apply_fun efamH b)) m ys /\ m <> 0 /\
              word_product multG eG ys m = y /\
              (forall m' ys':set,
                reduced_word K (graph K (fun b:set => apply_fun Hfam b))
                  (graph K (fun b:set => apply_fun efamH b)) m' ys' -> m' <> 0 ->
                word_product multG eG ys' m' = y ->
                m = m' /\ (forall i:set, i :e m -> apply_fun ys i = apply_fun ys' i)))
          (forall alpha:set, alpha :e K -> apply_fun (graph K (fun b:set => apply_fun efamH b)) alpha = eG)
          Hfp2).
        assume _ _ _ _ HuniqK _.
        apply (HuniqK x HxG2 Hxne).
        let m0. assume Hm0_pack.
        apply Hm0_pack. let ys0. assume Hys0_pack.
        apply (and4E
          (reduced_word K (graph K (fun b:set => apply_fun Hfam b))
            (graph K (fun b:set => apply_fun efamH b)) m0 ys0)
          (m0 <> 0)
          (word_product multG eG ys0 m0 = x)
          (forall m' ys':set,
            reduced_word K (graph K (fun b:set => apply_fun Hfam b))
              (graph K (fun b:set => apply_fun efamH b)) m' ys' -> m' <> 0 ->
            word_product multG eG ys' m' = x ->
            m0 = m' /\ (forall i:set, i :e m0 -> apply_fun ys0 i = apply_fun ys' i))
          Hys0_pack).
        assume Hred0 Hm0_ne Hwp0 Huniq0.
        claim Huniq_xs : m0 = n /\ (forall i:set, i :e m0 -> apply_fun ys0 i = apply_fun xs i).
        { exact (Huniq0 n xs HredK Hn_ne Hwp). }
        claim Huniq_xs' : m0 = n' /\ (forall i:set, i :e m0 -> apply_fun ys0 i = apply_fun xs' i).
        { exact (Huniq0 n' xs' HredK' Hn'_ne Hwp'). }
        claim Hn_eq : n = n'.
        {
          claim Hm0_eq_n : m0 = n.
          { exact (andEL (m0 = n) (forall i:set, i :e m0 -> apply_fun ys0 i = apply_fun xs i) Huniq_xs). }
          claim Hm0_eq_n' : m0 = n'.
          { exact (andEL (m0 = n') (forall i:set, i :e m0 -> apply_fun ys0 i = apply_fun xs' i) Huniq_xs'). }
          exact (eq_i_tra n m0 n'
            (eq_symm m0 n Hm0_eq_n)
            Hm0_eq_n').
        }
        apply andI.
        - exact Hn_eq.
        - let i. assume Hi : i :e n.
          claim Hi0 : i :e m0.
