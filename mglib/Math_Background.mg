              Sx
              V
              xV
              HpdSlices
              HSxSlice
              HVslice
              HxVSx
              HxVV).
          }
          claim HzSx : z :e Sx.
          {
            rewrite HSxEqV.
            exact HzV.
          }
          claim HzG : z :e G.
          {
            exact (Hcontrol z HzSx HpzPickV).
          }
          exact (UnionI G0 z G HzG HGG0xV).
        }
        witness U.
        apply andI.
        - apply andI.
          + exact HUtb.
          + exact HUb.
        - exact HpreUSubUnionG0.
      }
      apply Hshrink.
      let U.
      assume HUPack.
      claim HUtb : U :e Tb.
      {
        exact (andEL
          (U :e Tb)
          (b :e U)
          (andEL
            (U :e Tb /\ b :e U)
