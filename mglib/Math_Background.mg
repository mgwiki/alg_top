    claim HliftFxPack :
      continuous_map unit_interval unit_interval_topology E Te lx /\
      apply_fun lx 0 = e0 /\
      (forall t:set, t :e unit_interval ->
        apply_fun p (apply_fun lx t) = apply_fun fx t).
    {
      exact (lemma54_1_path_lifting
        E
