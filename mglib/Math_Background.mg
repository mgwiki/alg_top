          {
            exact (andER
              (n :e int)
              ((n :e omega /\ g = group_power_nat mult e x n) \/
               (exists m0:set, m0 :e omega /\ n = minus_SNo (ordsucc m0) /\
                 g = group_power_nat mult e (apply_fun inv x) (ordsucc m0)))
              HnPack).
