		                      HmemImg
		                      (eq_symm
		                        (apply_fun GfamImg alpha)
		                        ImgAlpha
		                        HimgAlphaEq)).
		                  - assume HtNotO : ~(t :e omega).
		                    claim HtNe0 : t <> 0.
		                    {
		                      assume Ht0.
		                      apply HtNotO.
		                      rewrite Ht0.
		                      exact (nat_p_omega 0 nat_0).
