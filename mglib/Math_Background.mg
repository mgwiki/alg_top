(** S55 helper: explicit fixed-point-free endomap witness on S1 with S1 topology. **)
(** Proven Bob **)
Theorem s55_exists_fixed_point_free_endomap_S1 :
  exists f:set,
    continuous_map S1 S1_topology S1 S1_topology f /\
