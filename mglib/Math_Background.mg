Definition completely_regular_space : set -> set -> prop := fun X Tx => topology_on X Tx /\ (one_point_sets_closed X Tx /\ forall x : set , x :e X -> forall F : set , closed_in X Tx F -> x /:e F -> exists f : set , continuous_map X Tx R R_standard_topology f /\ apply_fun f x = 0 /\ forall y : set , y :e F -> apply_fun f y = 1).
