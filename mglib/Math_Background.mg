(** Proven Bob **)
Lemma subgroups_generate_abelian_generation :
  forall G mult e inv J Gfam x:set,
  subgroups_generate_abelian G mult e inv J Gfam ->
  x :e G ->
  exists n:set, n :e omega /\
  exists alphas:set, function_on alphas n J /\
