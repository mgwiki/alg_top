    claim HdnormNe0 : dnorm <> 0.
    {
      assume Hd0.
      claim Hs0 : s = 0.
      {
        claim Hd20 : mul_SNo dnorm dnorm = 0.
        {
          rewrite Hd0 at 2.
          exact (mul_SNo_zeroR
            dnorm
            HdnormS).
        }
        exact (eq_i_tra
          s
          (mul_SNo dnorm dnorm)
          0
          (eq_symm
            (mul_SNo dnorm dnorm)
            s
            (sqrt_SNo_nonneg_sqr
              s
              HsS
              HsNonneg))
          Hd20).
      }
      exact (HsNe0
        Hs0).
    }
	    claim HnormNegEq :
	      sqrt_SNo_nonneg
	        (add_SNo (mul_SNo ((minus_SNo (p 0), minus_SNo (p 1)) 0) ((minus_SNo (p 0), minus_SNo (p 1)) 0))
	          (mul_SNo ((minus_SNo (p 0), minus_SNo (p 1)) 1) ((minus_SNo (p 0), minus_SNo (p 1)) 1)))
	      = dnorm.
