												                rewrite (If_i_0 (1 = 0) G1 G2 neq_1_0).
												                reflexivity.
												              }
												              claim Hx1G2 : apply_fun xs12 t :e G2.
												              {
												                exact (eq_subst_mem_set
												                  (apply_fun xs12 t)
												                  (apply_fun Gfam12 1)
												                  G2
