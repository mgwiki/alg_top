  set GFam := {Eps_i (fun G:set => G c= Fam /\ finite G /\ preimage_of E p U c= Union G)|U :e U0}.
  claim HGFamFin : finite GFam.
  {
    exact (finite_Repl
      U0
      HU0fin
      (fun U:set => Eps_i (fun G:set => G c= Fam /\ finite G /\ preimage_of E p U c= Union G))).
