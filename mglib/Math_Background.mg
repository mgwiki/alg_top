    - assume H0ltxOrd.
      exact (orIR (x = 0) (order_rel R 0 x) H0ltxOrd).
    - assume H0eqx.
      claim Hxeq0 : x = 0.
      {
        symmetry.
        exact H0eqx.
      }
      exact (orIL (x = 0) (order_rel R 0 x) Hxeq0).
    - assume Hxlt0Ord.
      claim Hxlt0 : Rlt x 0.
      {
        exact (order_rel_R_implies_Rlt x 0 Hxlt0Ord).
      }
      claim Hnx : ~ (Rlt x 0).
      {
        exact (andEL
          (~ (Rlt x 0))
          (~ (Rlt 1 x))
