Axiom closure_of_compact_subspace_compact : forall X Tx A : set , Hausdorff_space X Tx -> A c= X -> compact_space A (subspace_topology X Tx A) -> compact_space (closure_of X Tx A) (subspace_topology X Tx (closure_of X Tx A)).
Axiom compact_closure_monotone : forall X Tx A B : set , topology_on X Tx -> A c= B -> B c= X -> compact_space (closure_of X Tx B) (subspace_topology X Tx (closure_of X Tx B)) -> compact_space (closure_of X Tx A) (subspace_topology X Tx (closure_of X Tx A)).
Axiom chart_neighborhood_has_compact_closure : forall X Tx m U V f x : set , m :e omega -> topology_on X Tx -> Hausdorff_space X Tx -> open_in X Tx U -> x :e U -> V c= (euclidean_space m) -> open_in (euclidean_space m) (euclidean_topology m) V -> homeomorphism U (subspace_topology X Tx U) V (subspace_topology (euclidean_space m) (euclidean_topology m) V) f -> exists U1 : set , U1 :e Tx /\ x :e U1 /\ compact_space (closure_of X Tx U1) (subspace_topology X Tx (closure_of X Tx U1)).
Axiom chart_neighborhood_has_compact_neighborhood : forall X Tx m U V f x : set , m :e omega -> topology_on X Tx -> open_in X Tx U -> x :e U -> V c= (euclidean_space m) -> open_in (euclidean_space m) (euclidean_topology m) V -> homeomorphism U (subspace_topology X Tx U) V (subspace_topology (euclidean_space m) (euclidean_topology m) V) f -> exists C : set , (C c= X /\ compact_space C (subspace_topology X Tx C)) /\ exists U1 : set , U1 :e Tx /\ x :e U1 /\ U1 c= C.
Axiom chart_neighborhood_has_compact_neighborhood_in_chart : forall X Tx m U V f x : set , m :e omega -> topology_on X Tx -> open_in X Tx U -> x :e U -> V c= (euclidean_space m) -> open_in (euclidean_space m) (euclidean_topology m) V -> homeomorphism U (subspace_topology X Tx U) V (subspace_topology (euclidean_space m) (euclidean_topology m) V) f -> exists C : set , (C c= U /\ compact_space C (subspace_topology X Tx C)) /\ exists U1 : set , U1 :e Tx /\ x :e U1 /\ U1 c= C.
Axiom euclidean_space_metrizable : forall n : set , n :e omega -> metrizable (euclidean_space n) (euclidean_topology n).
Axiom m_manifold_implies_locally_m_euclidean : forall X Tx m : set , m_manifold X Tx m -> locally_m_euclidean X Tx m.
Axiom euclidean_space_T1 : forall m : set , T1_space (euclidean_space m) (euclidean_topology m).
Axiom locally_m_euclidean_implies_T1 : forall X Tx m : set , locally_m_euclidean X Tx m -> T1_space X Tx.
Axiom ex50_1_discrete_dimension_0 : forall X Tx : set , Tx = discrete_topology X -> topology_on X Tx -> covering_dimension X Tx Empty.
Axiom ex50_2_connected_T1_dimension_ge_1 : forall X Tx : set , connected_space X Tx -> T1_space X Tx -> (exists x y : set , x :e X /\ y :e X /\ x <> y) -> covering_dimension X Tx Empty -> False.
Definition topologists_sine_curve : set := Eps_i (fun S : set => S c= EuclidPlane).
Axiom topologists_sine_curve_subset_EuclidPlane : topologists_sine_curve c= EuclidPlane.
Definition topologists_sine_curve_topology : set := subspace_topology EuclidPlane R2_standard_topology topologists_sine_curve.
Axiom EuclidPlane_R2_standard_topology_on : topology_on EuclidPlane R2_standard_topology.
Axiom topologists_sine_curve_topology_on : topology_on topologists_sine_curve topologists_sine_curve_topology.
Axiom ex50_3_sine_curve_dimension_1 : covering_dimension topologists_sine_curve topologists_sine_curve_topology (Sing Empty).
Axiom In_2_3 : 2 :e 3.
Axiom real_in_space_family_union_R3 : forall y : set , y :e R -> y :e space_family_union 3 (const_space_family 3 R R_standard_topology).
Axiom space_family_set_const_R3 : forall i : set , i :e 3 -> space_family_set (const_space_family 3 R R_standard_topology) i = R.
Axiom graph3_in_euclidean_space3 : forall g : set -> set , (forall i : set , g i :e R) -> graph 3 g :e euclidean_space 3.
Definition ex50_R3_zero : set := graph 3 (fun _ : set => 0).
Definition ex50_R3_ones : set := graph 3 (fun _ : set => 1).
Definition ex50_R3_e1 : set := graph 3 (fun i : set => if i = 0 then 1 else 0).
Definition ex50_R3_e2 : set := graph 3 (fun i : set => if i = 1 then 1 else 0).
Definition ex50_R3_e3 : set := graph 3 (fun i : set => if i = 2 then 1 else 0).
Axiom ex50_R3_zero_in : ex50_R3_zero :e euclidean_space 3.
Axiom ex50_R3_ones_in : ex50_R3_ones :e euclidean_space 3.
Axiom ex50_R3_e1_in : ex50_R3_e1 :e euclidean_space 3.
Axiom ex50_R3_e2_in : ex50_R3_e2 :e euclidean_space 3.
Axiom ex50_R3_e3_in : ex50_R3_e3 :e euclidean_space 3.
Axiom ex50_4_points_general_position_R3 : general_position_RN 3 {ex50_R3_zero,ex50_R3_e1,ex50_R3_e2,ex50_R3_e3,ex50_R3_ones}.
Axiom ex50_5_embedding_m1_linear_graph : forall X Tx : set , covering_dimension X Tx (Sing Empty) -> compact_space X Tx -> metrizable X Tx -> exists g : set , (forall x : set , x :e X -> apply_fun g x :e (euclidean_space 3)) /\ linear_graph (image_of g X) R_standard_topology.
Axiom ex50_6_locally_compact_embeds : forall X Tx m : set , m :e omega -> locally_compact X Tx -> Hausdorff_space X Tx -> second_countable_space X Tx -> (forall C : set , C c= X -> compact_space C (subspace_topology X Tx C) -> covering_dimension C (subspace_topology X Tx C) m) -> exists N : set , exists e : set , N = add_nat (mul_nat two m) (Sing Empty) /\ embedding_of X Tx (euclidean_space N) (euclidean_topology N) e /\ closed_in (euclidean_space N) (euclidean_topology N) (image_of e X).
Axiom ex50_7_manifold_closed_embedding : forall X Tx m : set , m :e omega -> m_manifold X Tx m -> exists N : set , exists e : set , N = add_nat (mul_nat two m) (Sing Empty) /\ embedding_of X Tx (euclidean_space N) (euclidean_topology N) e /\ closed_in (euclidean_space N) (euclidean_topology N) (image_of e X).
Definition sigma_compact : set -> set -> prop := fun X Tx => topology_on X Tx /\ exists Fam : set , countable Fam /\ (forall C : set , C :e Fam -> C c= X /\ compact_space C (subspace_topology X Tx C)) /\ X c= Union {interior_of X Tx C|C :e Fam}.
Axiom sigma_compact_has_countable_compact_cover : forall X Tx : set , sigma_compact X Tx -> exists Fam : set , countable Fam /\ (forall C : set , C :e Fam -> C c= X /\ compact_space C (subspace_topology X Tx C)) /\ X c= Union Fam.
Axiom compact_subspace_finite_interior_thickening : forall X Tx Fam K : set , topology_on X Tx -> Fam c= Power X -> K c= X -> compact_space K (subspace_topology X Tx K) -> K c= Union {interior_of X Tx C|C :e Fam} -> exists Fam0 : set , Fam0 c= Fam /\ finite Fam0 /\ K c= interior_of X Tx (Union Fam0).
Axiom sigma_compact_compact_thickening : forall X Tx K : set , sigma_compact X Tx -> K c= X -> compact_space K (subspace_topology X Tx K) -> exists Kp : set , Kp c= X /\ compact_space Kp (subspace_topology X Tx Kp) /\ K c= interior_of X Tx Kp.
Axiom sigma_compact_has_compact_sequence_cover : forall X Tx : set , sigma_compact X Tx -> exists K : set -> set , (forall n : set , n :e omega -> K n c= X /\ compact_space (K n) (subspace_topology X Tx (K n))) /\ X c= Union {K n|n :e omega}.
Axiom exhaustion_step_sub : forall X Tx : set , forall Xn : set -> set , topology_on X Tx -> (forall n : set , n :e omega -> Xn n c= interior_of X Tx (Xn (ordsucc n))) -> forall n : set , n :e omega -> Xn n c= Xn (ordsucc n).
Axiom exhaustion_step_sub_2 : forall X Tx : set , forall Xn : set -> set , topology_on X Tx -> (forall n : set , n :e omega -> Xn n c= interior_of X Tx (Xn (ordsucc n))) -> forall n : set , n :e omega -> Xn n c= Xn (ordsucc (ordsucc n)).
Axiom omega_chain_mono_by_succ : forall Xn : set -> set , (forall n : set , n :e omega -> Xn n c= Xn (ordsucc n)) -> forall n : set , n :e omega -> forall m : set , m :e ordsucc n -> Xn m c= Xn n.
Axiom nat_ordsucc_mono_in_ordsucc : forall n k : set , nat_p n -> k :e ordsucc n -> ordsucc k :e ordsucc (ordsucc n).
Axiom sigma_compact_has_compact_exhaustion : forall X Tx : set , sigma_compact X Tx -> exists Xn : set -> set , (forall n : set , n :e omega -> Xn n c= X /\ compact_space (Xn n) (subspace_topology X Tx (Xn n))) /\ X c= Union {Xn n|n :e omega} /\ (forall n : set , n :e omega -> Xn n c= interior_of X Tx (Xn (ordsucc n))).
Axiom sigma_compact_has_compact_exhaustion_empty0 : forall X Tx : set , sigma_compact X Tx -> exists Xn : set -> set , Xn 0 = Empty /\ ((forall n : set , n :e omega -> Xn n c= X /\ compact_space (Xn n) (subspace_topology X Tx (Xn n))) /\ X c= Union {Xn n|n :e omega} /\ (forall n : set , n :e omega -> Xn n c= interior_of X Tx (Xn (ordsucc n)))).
Axiom ex50_8_stabilized_refinement_from_B0 : forall X Tx m A : set , forall Xn : set -> set , forall B0 : set , m :e omega -> Hausdorff_space X Tx -> topology_on X Tx -> open_cover_of X Tx A -> Xn 0 = Empty -> (forall n : set , n :e omega -> Xn n c= X /\ compact_space (Xn n) (subspace_topology X Tx (Xn n))) -> X c= Union {Xn n|n :e omega} -> (forall n : set , n :e omega -> Xn n c= interior_of X Tx (Xn (ordsucc n))) -> (forall C : set , C c= X -> compact_space C (subspace_topology X Tx C) -> covering_dimension C (subspace_topology X Tx C) m) -> open_cover_of X Tx B0 -> refines_cover B0 A -> (forall n : set , n :e omega -> forall U : set , U :e B0 -> ~ (U :/\: (Xn n) = Empty) -> U c= (Xn (ordsucc n))) -> exists B : set , open_cover_of X Tx B /\ refines_cover B A /\ collection_has_order_at_most_m_plus_one X B m.
Axiom ex50_8_sigma_compact_dimension : forall X Tx m : set , m :e omega -> sigma_compact X Tx -> Hausdorff_space X Tx -> (forall C : set , C c= X -> compact_space C (subspace_topology X Tx C) -> covering_dimension C (subspace_topology X Tx C) m) -> covering_dimension X Tx m.
Axiom compact_in_chart_domain_dimension_le_m : forall X Tx m U V f K : set , m :e omega -> topology_on X Tx -> U :e Tx -> V :e (euclidean_topology m) -> homeomorphism U (subspace_topology X Tx U) V (subspace_topology (euclidean_space m) (euclidean_topology m) V) f -> K c= U -> compact_space K (subspace_topology X Tx K) -> covering_dimension K (subspace_topology X Tx K) m.
Axiom compact_subspace_of_m_manifold_dimension_le_m : forall X Tx m C : set , m :e omega -> m_manifold X Tx m -> C c= X -> compact_space C (subspace_topology X Tx C) -> covering_dimension C (subspace_topology X Tx C) m.
Axiom ex50_9_manifold_dimension_le_m : forall X Tx m : set , m :e omega -> m_manifold X Tx m -> covering_dimension X Tx m.
Axiom ex50_10_closed_subspace_RN_dimension : forall X N : set , N :e omega -> X c= (euclidean_space N) -> closed_in (euclidean_space N) (euclidean_topology N) X -> covering_dimension X (subspace_topology (euclidean_space N) (euclidean_topology N) X) N.
Axiom ex50_11_embedding_characterization : forall X Tx : set , (exists N : set , exists e : set , N :e omega /\ embedding_of X Tx (euclidean_space N) (euclidean_topology N) e /\ closed_in (euclidean_space N) (euclidean_topology N) (image_of e X)) <-> (locally_compact X Tx /\ Hausdorff_space X Tx /\ second_countable_space X Tx /\ finite_dimensional_space X Tx).
Axiom homeomorphism_preserves_metrizable : forall X Tx Y Ty f : set , homeomorphism X Tx Y Ty f -> metrizable Y Ty -> metrizable X Tx.
Axiom homeomorphism_preserves_second_countable_late : forall X Tx Y Ty f : set , homeomorphism X Tx Y Ty f -> second_countable_space Y Ty -> second_countable_space X Tx.
Definition locally_metrizable_space : set -> set -> prop := fun X Tx => topology_on X Tx /\ forall x : set , x :e X -> exists N : set , N :e Tx /\ x :e N /\ exists d : set , metric_on N d /\ subspace_topology X Tx N = metric_topology N d.
Axiom locally_m_euclidean_implies_locally_compact : forall X Tx m : set , locally_m_euclidean X Tx m -> locally_compact X Tx.
Axiom locally_compact_Hausdorff_regular_early : forall X Tx : set , locally_compact X Tx -> Hausdorff_space X Tx -> regular_space X Tx.
Axiom compact_locally_m_euclidean_second_countable_early : forall X Tx m : set , locally_m_euclidean X Tx m -> compact_space X Tx -> second_countable_space X Tx.
Axiom supp_ex_locally_euclidean_1 : forall X Tx m : set , locally_m_euclidean X Tx m -> locally_compact X Tx /\ locally_metrizable_space X Tx.
Axiom supp_ex_locally_euclidean_2_i_implies_ii : forall X Tx m : set , locally_m_euclidean X Tx m -> compact_space X Tx -> Hausdorff_space X Tx -> m_manifold X Tx m.
Axiom supp_ex_locally_euclidean_2_ii_implies_iii : forall X Tx m : set , locally_m_euclidean X Tx m -> m_manifold X Tx m -> metrizable X Tx.
Axiom supp_ex_locally_euclidean_2_iii_implies_iv : forall X Tx : set , metrizable X Tx -> normal_space X Tx.
Axiom normal_T1_implies_Hausdorff : forall X Tx : set , normal_space X Tx -> T1_space X Tx -> Hausdorff_space X Tx.
Axiom supp_ex_locally_euclidean_2_iv_implies_v : forall X Tx m : set , locally_m_euclidean X Tx m -> normal_space X Tx -> Hausdorff_space X Tx.
Axiom supp_ex_locally_euclidean_3 : locally_m_euclidean R R_standard_topology (Sing Empty) /\ m_manifold R R_standard_topology (Sing Empty) /\ ~ (compact_space R R_standard_topology /\ Hausdorff_space R R_standard_topology).
Axiom EuclidPlane_order_topology_not_second_countable : ~ second_countable_space EuclidPlane (order_topology EuclidPlane).
Axiom EuclidPlane_order_topology_not_m_manifold_1 : ~ m_manifold EuclidPlane (order_topology EuclidPlane) (Sing Empty).
Axiom supp_ex_locally_euclidean_4 : locally_m_euclidean EuclidPlane (order_topology EuclidPlane) (Sing Empty) /\ metrizable EuclidPlane (order_topology EuclidPlane) /\ ~ m_manifold EuclidPlane (order_topology EuclidPlane) (Sing Empty).
Axiom infinite_omega : infinite omega.
Definition long_line_I0 : set := halfopen_interval_left 0 1.
Definition long_line_raw : set := setprod S_Omega long_line_I0.
Definition S_Omega_least : set := Eps_i (fun a0 : set => a0 :e S_Omega /\ forall s : set , s :e S_Omega -> a0 c= s).
Axiom S_Omega_least_spec : S_Omega_least :e S_Omega /\ forall s : set , s :e S_Omega -> S_Omega_least c= s.
Definition long_line_min : set := (S_Omega_least,0).
Definition long_line : set := long_line_raw :\: {long_line_min}.
Axiom long_line_infinite : infinite long_line.
Definition long_line_dict_rel : set -> set -> prop := fun p q => exists a1 t1 a2 t2 : set , p = (a1,t1) /\ q = (a2,t2) /\ (a1 :e a2 \/ (a1 = a2 /\ Rlt t1 t2)).
Axiom long_line_elem_in_raw : forall p : set , p :e long_line -> p :e long_line_raw.
Axiom long_line_coord0_in_S_Omega : forall p : set , p :e long_line -> p 0 :e S_Omega.
Axiom long_line_coord1_in_I0 : forall p : set , p :e long_line -> p 1 :e long_line_I0.
Axiom long_line_coord1_in_R : forall p : set , p :e long_line -> p 1 :e R.
Axiom long_line_eta : forall p : set , p :e long_line -> p = (p 0,p 1).
Axiom long_line_dict_rel_trans : forall p q r : set , p :e long_line -> q :e long_line -> r :e long_line -> long_line_dict_rel p q -> long_line_dict_rel q r -> long_line_dict_rel p r.
Axiom long_line_dict_rel_trichotomy : forall p q : set , p :e long_line -> q :e long_line -> long_line_dict_rel p q \/ p = q \/ long_line_dict_rel q p.
Definition long_line_open_interval : set -> set -> set := fun a b => {x :e long_line|long_line_dict_rel a x /\ long_line_dict_rel x b}.
Definition long_line_open_ray_upper : set -> set := fun a => {x :e long_line|long_line_dict_rel a x}.
Definition long_line_open_ray_lower : set -> set := fun b => {x :e long_line|long_line_dict_rel x b}.
Axiom long_line_open_interval_sub : forall a b : set , long_line_open_interval a b c= long_line.
Axiom long_line_open_ray_upper_sub : forall a : set , long_line_open_ray_upper a c= long_line.
Axiom long_line_open_ray_lower_sub : forall b : set , long_line_open_ray_lower b c= long_line.
Axiom long_line_open_interval_in_Power : forall a b : set , long_line_open_interval a b :e Power long_line.
Axiom long_line_open_ray_upper_in_Power : forall a : set , long_line_open_ray_upper a :e Power long_line.
Axiom long_line_open_ray_lower_in_Power : forall b : set , long_line_open_ray_lower b :e Power long_line.
Definition long_line_order_topology_basis : set := (({I :e Power long_line|exists a :e long_line , exists b :e long_line , I = long_line_open_interval a b} :\/: {I :e Power long_line|exists b :e long_line , I = long_line_open_ray_lower b} :\/: {I :e Power long_line|exists a :e long_line , I = long_line_open_ray_upper a}) :\/: {long_line}).
Axiom long_line_open_interval_in_basis : forall a b : set , a :e long_line -> b :e long_line -> long_line_open_interval a b :e long_line_order_topology_basis.
Axiom long_line_open_ray_lower_in_basis : forall b : set , b :e long_line -> long_line_open_ray_lower b :e long_line_order_topology_basis.
Axiom long_line_open_ray_upper_in_basis : forall a : set , a :e long_line -> long_line_open_ray_upper a :e long_line_order_topology_basis.
Axiom long_line_order_topology_basis_sub_Power : long_line_order_topology_basis c= Power long_line.
Axiom long_line_order_topology_basis_cases : forall I : set , I :e long_line_order_topology_basis -> (exists a :e long_line , exists b :e long_line , I = long_line_open_interval a b) \/ (exists b :e long_line , I = long_line_open_ray_lower b) \/ (exists a :e long_line , I = long_line_open_ray_upper a) \/ I = long_line.
Axiom long_line_refine_interval_interval : forall b1 b2 x : set , (exists a :e long_line , exists b :e long_line , b1 = long_line_open_interval a b) -> (exists a :e long_line , exists b :e long_line , b2 = long_line_open_interval a b) -> x :e b1 -> x :e b2 -> exists b3 :e long_line_order_topology_basis , x :e b3 /\ b3 c= b1 :/\: b2.
Axiom long_line_refine_interval_lower : forall b1 b2 x : set , (exists a :e long_line , exists b :e long_line , b1 = long_line_open_interval a b) -> (exists b :e long_line , b2 = long_line_open_ray_lower b) -> x :e b1 -> x :e b2 -> exists b3 :e long_line_order_topology_basis , x :e b3 /\ b3 c= b1 :/\: b2.
Axiom long_line_refine_interval_upper : forall b1 b2 x : set , (exists a :e long_line , exists b :e long_line , b1 = long_line_open_interval a b) -> (exists a :e long_line , b2 = long_line_open_ray_upper a) -> x :e b1 -> x :e b2 -> exists b3 :e long_line_order_topology_basis , x :e b3 /\ b3 c= b1 :/\: b2.
Axiom long_line_refine_lower_interval : forall b1 b2 x : set , (exists b :e long_line , b1 = long_line_open_ray_lower b) -> (exists a :e long_line , exists b :e long_line , b2 = long_line_open_interval a b) -> x :e b1 -> x :e b2 -> exists b3 :e long_line_order_topology_basis , x :e b3 /\ b3 c= b1 :/\: b2.
Axiom long_line_refine_lower_lower : forall b1 b2 x : set , (exists b :e long_line , b1 = long_line_open_ray_lower b) -> (exists b :e long_line , b2 = long_line_open_ray_lower b) -> x :e b1 -> x :e b2 -> exists b3 :e long_line_order_topology_basis , x :e b3 /\ b3 c= b1 :/\: b2.
Axiom long_line_refine_lower_upper : forall b1 b2 x : set , (exists b :e long_line , b1 = long_line_open_ray_lower b) -> (exists a :e long_line , b2 = long_line_open_ray_upper a) -> x :e b1 -> x :e b2 -> exists b3 :e long_line_order_topology_basis , x :e b3 /\ b3 c= b1 :/\: b2.
Axiom long_line_refine_upper_interval : forall b1 b2 x : set , (exists a :e long_line , b1 = long_line_open_ray_upper a) -> (exists a :e long_line , exists b :e long_line , b2 = long_line_open_interval a b) -> x :e b1 -> x :e b2 -> exists b3 :e long_line_order_topology_basis , x :e b3 /\ b3 c= b1 :/\: b2.
Axiom long_line_refine_upper_lower : forall b1 b2 x : set , (exists a :e long_line , b1 = long_line_open_ray_upper a) -> (exists b :e long_line , b2 = long_line_open_ray_lower b) -> x :e b1 -> x :e b2 -> exists b3 :e long_line_order_topology_basis , x :e b3 /\ b3 c= b1 :/\: b2.
Axiom long_line_refine_upper_upper : forall b1 b2 x : set , (exists a :e long_line , b1 = long_line_open_ray_upper a) -> (exists a :e long_line , b2 = long_line_open_ray_upper a) -> x :e b1 -> x :e b2 -> exists b3 :e long_line_order_topology_basis , x :e b3 /\ b3 c= b1 :/\: b2.
Axiom long_line_order_topology_basis_refine_nontrivial : forall b1 b2 x : set , b1 :e long_line_order_topology_basis -> b2 :e long_line_order_topology_basis -> x :e b1 -> x :e b2 -> ~ (b1 = long_line) -> ~ (b2 = long_line) -> exists b3 :e long_line_order_topology_basis , x :e b3 /\ b3 c= b1 :/\: b2.
Definition long_line_order_topology : set := generated_topology long_line long_line_order_topology_basis.
Axiom long_line_order_topology_basis_is_basis : basis_on long_line long_line_order_topology_basis.
Axiom long_line_order_topology_on : topology_on long_line long_line_order_topology.
Definition long_line_topology : set := long_line_order_topology.
Axiom long_line_topology_on : topology_on long_line long_line_topology.
Axiom supp_ex_locally_euclidean_5 : locally_m_euclidean long_line long_line_topology (Sing Empty) /\ normal_space long_line long_line_topology /\ ~ metrizable long_line long_line_topology.
Axiom supp_ex_locally_euclidean_7 : forall X Tx m : set , locally_m_euclidean X Tx m -> (Hausdorff_space X Tx <-> completely_regular_space X Tx).
Axiom paracompact_Hausdorff_locally_metrizable_sigma_basis : forall X Tx : set , paracompact_space X Tx -> Hausdorff_space X Tx -> locally_metrizable_space X Tx -> sigma_locally_finite_basis X Tx.
Axiom supp_ex_locally_euclidean_8 : forall X Tx m : set , locally_m_euclidean X Tx m -> (metrizable X Tx <-> (paracompact_space X Tx /\ Hausdorff_space X Tx)).
Axiom supp_ex_locally_euclidean_9 : forall X Tx m : set , locally_m_euclidean X Tx m -> metrizable X Tx -> forall x : set , x :e X -> m_manifold (component_of X Tx x) (subspace_topology X Tx (component_of X Tx x)) m.
Definition Gdelta_in : set -> set -> set -> prop := fun X Tx A => exists Fam : set , countable_set Fam /\ (forall U :e Fam , open_in X Tx U) /\ intersection_over_family X Fam = A.
Axiom continuous_preimage_Gdelta : forall X Tx Y Ty f A : set , continuous_map X Tx Y Ty f -> Gdelta_in Y Ty A -> Gdelta_in X Tx (preimage_of X f A).
Definition open_map : set -> set -> set -> set -> set -> prop := fun X Tx Y Ty f => topology_on X Tx /\ topology_on Y Ty /\ function_on f X Y /\ forall U : set , U :e Tx -> image_of f U :e Ty.
Definition topological_group : set -> set -> prop := fun G Tg => T1_space G Tg /\ exists mult inv e : set , function_on mult (setprod G G) G /\ function_on inv G G /\ e :e G /\ (forall x y z : set , x :e G -> y :e G -> z :e G -> apply_fun mult (apply_fun mult (x,y),z) = apply_fun mult (x,apply_fun mult (y,z))) /\ (forall x : set , x :e G -> apply_fun mult (e,x) = x /\ apply_fun mult (x,e) = x) /\ (forall x : set , x :e G -> apply_fun mult (x,apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x,x) = e) /\ continuous_map (setprod G G) (product_topology G Tg G Tg) G Tg mult /\ continuous_map G Tg G Tg inv.
Definition dyadic01 : set := {r :e R|exists n :e omega , exists k :e omega , r = mul_SNo k (eps_ n)}.
Axiom dyadic01_Subq_R : dyadic01 c= R.
Axiom dyadic01_countable : countable_set dyadic01.
Definition dyadic01_unit : set := dyadic01 :/\: unit_interval.
Axiom dyadic01_unit_countable : countable_set dyadic01_unit.
Axiom real_drat_intvl : forall x :e R , forall k :e omega , exists q :e SNoS_ omega , q < x /\ x < add_SNo q (eps_ k).
Axiom real_drat_intvl_Rlt : forall x : set , x :e R -> forall k : set , k :e omega -> exists q : set , q :e R /\ Rlt q x /\ Rlt x (add_SNo q (eps_ k)).
Definition setmul_by : set -> set -> set -> set := fun mult U V => image_of mult (setprod U V).
Definition dyadic_value : set -> set -> set := fun n k => mul_SNo k (eps_ n).
Axiom setmul_by_def : forall mult U V : set , setmul_by mult U V = image_of mult (setprod U V).
Axiom setmul_byI : forall U V mult u v : set , u :e U -> v :e V -> apply_fun mult (u,v) :e setmul_by mult U V.
Axiom mul_SNo_2_eq_add : forall x : set , SNo x -> mul_SNo 2 x = add_SNo x x.
Axiom eps_ordsucc_half_mul2 : forall n : set , nat_p n -> mul_SNo 2 (eps_ (ordsucc n)) = eps_ n.
Axiom setmul_byE : forall U V mult y : set , y :e setmul_by mult U V -> exists u : set , u :e U /\ exists v : set , v :e V /\ y = apply_fun mult (u,v).
Axiom setmul_by_sub_of_pointwise : forall mult U V W : set , (forall u v : set , u :e U -> v :e V -> apply_fun mult (u,v) :e W) -> setmul_by mult U V c= W.
Axiom setmul_by_Empty_right : forall mult U : set , setmul_by mult U Empty = Empty.
Axiom setmul_by_Empty_left : forall mult V : set , setmul_by mult Empty V = Empty.
Axiom setmul_by_mono_L : forall mult U1 U2 V : set , U1 c= U2 -> setmul_by mult U1 V c= setmul_by mult U2 V.
Axiom setmul_by_mono_R : forall mult U V1 V2 : set , V1 c= V2 -> setmul_by mult U V1 c= setmul_by mult U V2.
Axiom setmul_by_assoc_sub : forall G mult U V W : set , function_on mult (setprod G G) G -> (forall x y z : set , x :e G -> y :e G -> z :e G -> apply_fun mult (apply_fun mult (x,y),z) = apply_fun mult (x,apply_fun mult (y,z))) -> U c= G -> V c= G -> W c= G -> setmul_by mult (setmul_by mult U V) W c= setmul_by mult U (setmul_by mult V W).
Axiom setmul_by_assoc_sub_rev : forall G mult U V W : set , function_on mult (setprod G G) G -> (forall x y z : set , x :e G -> y :e G -> z :e G -> apply_fun mult (apply_fun mult (x,y),z) = apply_fun mult (x,apply_fun mult (y,z))) -> U c= G -> V c= G -> W c= G -> setmul_by mult U (setmul_by mult V W) c= setmul_by mult (setmul_by mult U V) W.
Axiom setmul_by_assoc_eq : forall G mult U V W : set , function_on mult (setprod G G) G -> (forall x y z : set , x :e G -> y :e G -> z :e G -> apply_fun mult (apply_fun mult (x,y),z) = apply_fun mult (x,apply_fun mult (y,z))) -> U c= G -> V c= G -> W c= G -> setmul_by mult (setmul_by mult U V) W = setmul_by mult U (setmul_by mult V W).
Axiom eps_in_R_omega : forall n : set , n :e omega -> eps_ n :e R.
Axiom dyadic_value_in_R : forall n k : set , n :e omega -> k :e omega -> dyadic_value n k :e R.
Axiom dyadic_value_in_dyadic01 : forall n k : set , n :e omega -> k :e omega -> dyadic_value n k :e dyadic01.
Axiom dyadic01E : forall p : set , p :e dyadic01 -> exists n :e omega , exists k :e omega , p = dyadic_value n k.
Axiom dyadic01_unitE : forall p : set , p :e dyadic01_unit -> (exists n :e omega , exists k :e omega , p = dyadic_value n k) /\ p :e unit_interval.
Definition dyadic_index_set : set -> set := fun p : set => {n :e omega|exists k :e omega , p = dyadic_value n k}.
Axiom dyadic_index_set_Subq_omega : forall p : set , dyadic_index_set p c= omega.
Axiom dyadic_index_set_nonempty : forall p : set , p :e dyadic01 -> dyadic_index_set p <> Empty.
Axiom omega_nonempty_subset_has_least : forall A : set , A c= omega -> A <> Empty -> exists m : set , m :e A /\ forall n : set , n :e A -> (m :e n \/ m = n).
Axiom dyadic_index_set_has_least : forall p : set , p :e dyadic01 -> exists m : set , m :e dyadic_index_set p /\ forall n : set , n :e dyadic_index_set p -> (m :e n \/ m = n).
Definition dyadic_least_exp : set -> set := fun p : set => Eps_i (fun m : set => m :e dyadic_index_set p /\ forall n : set , n :e dyadic_index_set p -> (m :e n \/ m = n)).
Axiom dyadic_least_exp_spec : forall p : set , p :e dyadic01 -> dyadic_least_exp p :e dyadic_index_set p /\ forall n : set , n :e dyadic_index_set p -> (dyadic_least_exp p :e n \/ dyadic_least_exp p = n).
Definition dyadic_least_k : set -> set := fun p : set => Eps_i (fun k : set => k :e omega /\ (p = dyadic_value (dyadic_least_exp p) k)).
Axiom dyadic_least_k_spec : forall p : set , p :e dyadic01 -> dyadic_least_k p :e omega /\ p = dyadic_value (dyadic_least_exp p) (dyadic_least_k p).
Axiom dyadic_least_exp_in_omega : forall p : set , p :e dyadic01 -> dyadic_least_exp p :e omega.
Axiom dyadic_least_rep_eq : forall p : set , p :e dyadic01 -> p = dyadic_value (dyadic_least_exp p) (dyadic_least_k p).
Axiom dyadic_least_k_in_omega : forall p : set , p :e dyadic01 -> dyadic_least_k p :e omega.
Section dyadic_nat_decomp.
Infix + 360 right  := add_nat.
Infix * 355 right  := mul_nat.
Axiom ordsucc_1_eq_2_nat : ordsucc 1 = 2.
Axiom ordsucc_0_eq_1_nat : ordsucc 0 = 1.
Axiom two_mem_cases : forall r : set , r :e 2 -> r = 0 \/ r = 1.
Axiom quotient_remainder_nat_2 : forall m : set , nat_p m -> exists q :e omega , exists r :e 2 , m = q * 2 + r.
Definition even_by2 : set -> prop := fun k : set => exists q :e omega , k = q * 2 + 0.
Definition odd_by2 : set -> prop := fun k : set => exists q :e omega , k = q * 2 + 1.
Axiom nat_even_or_odd_by2 : forall k : set , nat_p k -> even_by2 k \/ odd_by2 k.
Definition half_of_odd_by2 : set -> set := fun k : set => Eps_i (fun q : set => q :e omega /\ k = q * 2 + 1).
Axiom half_of_odd_by2_spec : forall k : set , odd_by2 k -> half_of_odd_by2 k :e omega /\ k = (half_of_odd_by2 k) * 2 + 1.
Definition div2_nat : set -> set := fun k : set => Eps_i (fun q : set => q :e omega /\ exists r :e 2 , k = q * 2 + r).
Definition mod2_nat : set -> set := fun k : set => Eps_i (fun r : set => r :e 2 /\ k = (div2_nat k) * 2 + r).
Axiom div2_mod2_spec : forall k : set , nat_p k -> div2_nat k :e omega /\ mod2_nat k :e 2 /\ k = (div2_nat k) * 2 + (mod2_nat k).
End dyadic_nat_decomp.
Section dyadic_nat_props.
Infix + 360 right  := add_nat.
Infix * 355 right  := mul_nat.
Axiom div2_nat_in_omega : forall k : set , nat_p k -> div2_nat k :e omega.
Axiom mod2_nat_in_2 : forall k : set , nat_p k -> mod2_nat k :e 2.
Axiom div2_mod2_eq : forall k : set , nat_p k -> k = (div2_nat k) * 2 + (mod2_nat k).
Axiom mod2_nat_cases : forall k : set , nat_p k -> mod2_nat k = 0 \/ mod2_nat k = 1.
Axiom div2_nat_2_eq_1 : div2_nat 2 = 1.
Axiom mod2_nat_2_eq_0 : mod2_nat 2 = 0.
Axiom mul_nat_2_inj_global : forall m n : set , nat_p m -> nat_p n -> m * 2 = n * 2 -> m = n.
Axiom mod2_nat_eq_1_imp_not_divides2 : forall m : set , nat_p m -> mod2_nat m = 1 -> ~ divides_nat 2 m.
Axiom mod2_nat_mul2_eq_0 : forall k : set , nat_p k -> mod2_nat (k * 2) = 0.
Axiom div2_nat_mul2_eq_self : forall k : set , nat_p k -> div2_nat (k * 2) = k.
Axiom mod2_nat_succ_even_ne0 : forall k : set , nat_p k -> mod2_nat k = 0 -> ~ (mod2_nat (ordsucc k) = 0).
Axiom div2_nat_succ_even_eq_div2 : forall k : set , nat_p k -> mod2_nat k = 0 -> div2_nat (ordsucc k) = div2_nat k.
Axiom mod2_nat_succ_odd_eq_0 : forall k : set , nat_p k -> ~ (mod2_nat k = 0) -> mod2_nat (ordsucc k) = 0.
Axiom div2_nat_succ_odd_eq_ordsucc_div2 : forall k : set , nat_p k -> ~ (mod2_nat k = 0) -> div2_nat (ordsucc k) = ordsucc (div2_nat k).
Axiom dyadic_value_shift_even : forall n k : set , nat_p n -> nat_p k -> mod2_nat k = 0 -> dyadic_value (ordsucc n) k = dyadic_value n (div2_nat k).
Axiom dyadic01_unit_shift_even : forall n k : set , nat_p n -> nat_p k -> mod2_nat k = 0 -> dyadic_value (ordsucc n) k :e dyadic01_unit -> dyadic_value n (div2_nat k) :e dyadic01_unit.
Axiom dyadic_value_shift_up : forall n k : set , n :e omega -> k :e omega -> dyadic_value n k = dyadic_value (ordsucc n) (mul_nat k 2).
End dyadic_nat_props.
Axiom dyadic_value_raise_exp : forall n k t : set , n :e omega -> k :e omega -> t :e omega -> exists k0 : set , k0 :e omega /\ dyadic_value n k = dyadic_value (add_nat n t) k0.
Axiom dyadic_value_num_inj : forall n k1 k2 : set , n :e omega -> k1 :e omega -> k2 :e omega -> dyadic_value n k1 = dyadic_value n k2 -> k1 = k2.
Axiom group_inv_inv : forall G mult inv e x : set , function_on mult (setprod G G) G -> function_on inv G G -> e :e G -> (forall a b c : set , a :e G -> b :e G -> c :e G -> apply_fun mult (apply_fun mult (a,b),c) = apply_fun mult (a,apply_fun mult (b,c))) -> (forall a : set , a :e G -> apply_fun mult (e,a) = a /\ apply_fun mult (a,e) = a) -> (forall a : set , a :e G -> apply_fun mult (a,apply_fun inv a) = e /\ apply_fun mult (apply_fun inv a,a) = e) -> x :e G -> apply_fun inv (apply_fun inv x) = x.
Axiom group_left_inv_solve : forall G mult inv e x y : set , function_on mult (setprod G G) G -> function_on inv G G -> e :e G -> (forall a b c : set , a :e G -> b :e G -> c :e G -> apply_fun mult (apply_fun mult (a,b),c) = apply_fun mult (a,apply_fun mult (b,c))) -> (forall a : set , a :e G -> apply_fun mult (e,a) = a /\ apply_fun mult (a,e) = a) -> (forall a : set , a :e G -> apply_fun mult (a,apply_fun inv a) = e /\ apply_fun mult (apply_fun inv a,a) = e) -> x :e G -> y :e G -> apply_fun mult (apply_fun inv x,y) = e -> y = x.
Axiom left_translation_continuous : forall G Tg mult a : set , topology_on G Tg -> continuous_map (setprod G G) (product_topology G Tg G Tg) G Tg mult -> a :e G -> let id := {(x,x)|x :e G} in continuous_map G Tg G Tg (compose_fun G (pair_map G (const_fun G a) id) mult).
Axiom left_translation_homeomorphism : forall G Tg mult inv e a : set , topology_on G Tg -> continuous_map (setprod G G) (product_topology G Tg G Tg) G Tg mult -> function_on inv G G -> e :e G -> (forall x y z : set , x :e G -> y :e G -> z :e G -> apply_fun mult (apply_fun mult (x,y),z) = apply_fun mult (x,apply_fun mult (y,z))) -> (forall x : set , x :e G -> apply_fun mult (e,x) = x /\ apply_fun mult (x,e) = x) -> (forall x : set , x :e G -> apply_fun mult (x,apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x,x) = e) -> a :e G -> let id := {(x,x)|x :e G} in let La := (compose_fun G (pair_map G (const_fun G a) id) mult) in homeomorphism G Tg G Tg La.
Axiom left_translation_image_open : forall G Tg mult inv e a U : set , topology_on G Tg -> continuous_map (setprod G G) (product_topology G Tg G Tg) G Tg mult -> function_on inv G G -> e :e G -> (forall x y z : set , x :e G -> y :e G -> z :e G -> apply_fun mult (apply_fun mult (x,y),z) = apply_fun mult (x,apply_fun mult (y,z))) -> (forall x : set , x :e G -> apply_fun mult (e,x) = x /\ apply_fun mult (x,e) = x) -> (forall x : set , x :e G -> apply_fun mult (x,apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x,x) = e) -> a :e G -> U :e Tg -> image_of (compose_fun G (pair_map G (const_fun G a) {(x,x)|x :e G}) mult) U :e Tg.
Axiom right_translation_continuous : forall G Tg mult a : set , topology_on G Tg -> continuous_map (setprod G G) (product_topology G Tg G Tg) G Tg mult -> a :e G -> let id := {(x,x)|x :e G} in let Ra := (compose_fun G (pair_map G id (const_fun G a)) mult) in continuous_map G Tg G Tg Ra.
Axiom right_translation_homeomorphism : forall G Tg mult inv e a : set , topology_on G Tg -> continuous_map (setprod G G) (product_topology G Tg G Tg) G Tg mult -> function_on inv G G -> e :e G -> (forall x y z : set , x :e G -> y :e G -> z :e G -> apply_fun mult (apply_fun mult (x,y),z) = apply_fun mult (x,apply_fun mult (y,z))) -> (forall x : set , x :e G -> apply_fun mult (e,x) = x /\ apply_fun mult (x,e) = x) -> (forall x : set , x :e G -> apply_fun mult (x,apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x,x) = e) -> a :e G -> let id := {(x,x)|x :e G} in let Ra := (compose_fun G (pair_map G id (const_fun G a)) mult) in homeomorphism G Tg G Tg Ra.
Axiom right_translation_image_open : forall G Tg mult inv e a U : set , topology_on G Tg -> continuous_map (setprod G G) (product_topology G Tg G Tg) G Tg mult -> function_on inv G G -> e :e G -> (forall x y z : set , x :e G -> y :e G -> z :e G -> apply_fun mult (apply_fun mult (x,y),z) = apply_fun mult (x,apply_fun mult (y,z))) -> (forall x : set , x :e G -> apply_fun mult (e,x) = x /\ apply_fun mult (x,e) = x) -> (forall x : set , x :e G -> apply_fun mult (x,apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x,x) = e) -> a :e G -> U :e Tg -> image_of (compose_fun G (pair_map G {(x,x)|x :e G} (const_fun G a)) mult) U :e Tg.
Axiom topological_group_mult_image_open : forall G Tg mult inv e U V : set , topology_on G Tg -> continuous_map (setprod G G) (product_topology G Tg G Tg) G Tg mult -> function_on inv G G -> e :e G -> (forall x y z : set , x :e G -> y :e G -> z :e G -> apply_fun mult (apply_fun mult (x,y),z) = apply_fun mult (x,apply_fun mult (y,z))) -> (forall x : set , x :e G -> apply_fun mult (e,x) = x /\ apply_fun mult (x,e) = x) -> (forall x : set , x :e G -> apply_fun mult (x,apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x,x) = e) -> U :e Tg -> V :e Tg -> image_of mult (setprod U V) :e Tg.
Axiom topological_group_setmul_by_open : forall G Tg mult inv e U V : set , topology_on G Tg -> continuous_map (setprod G G) (product_topology G Tg G Tg) G Tg mult -> function_on inv G G -> e :e G -> (forall x y z : set , x :e G -> y :e G -> z :e G -> apply_fun mult (apply_fun mult (x,y),z) = apply_fun mult (x,apply_fun mult (y,z))) -> (forall x : set , x :e G -> apply_fun mult (e,x) = x /\ apply_fun mult (x,e) = x) -> (forall x : set , x :e G -> apply_fun mult (x,apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x,x) = e) -> U :e Tg -> V :e Tg -> setmul_by mult U V :e Tg.
Axiom topological_group_closure_sub_of_square : forall G Tg mult inv e V U : set , topology_on G Tg -> continuous_map (setprod G G) (product_topology G Tg G Tg) G Tg mult -> function_on inv G G -> e :e G -> (forall x y z : set , x :e G -> y :e G -> z :e G -> apply_fun mult (apply_fun mult (x,y),z) = apply_fun mult (x,apply_fun mult (y,z))) -> (forall x : set , x :e G -> apply_fun mult (e,x) = x /\ apply_fun mult (x,e) = x) -> (forall x : set , x :e G -> apply_fun mult (x,apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x,x) = e) -> V :e Tg -> e :e V -> (forall x : set , x :e V -> apply_fun inv x :e V) -> (forall x y : set , x :e V -> y :e V -> apply_fun mult (x,y) :e U) -> closure_of G Tg V c= U.
Axiom topological_group_mult_neighborhood_square : forall G Tg mult e U : set , topology_on G Tg -> function_on mult (setprod G G) G -> e :e G -> (forall x : set , x :e G -> apply_fun mult (e,x) = x /\ apply_fun mult (x,e) = x) -> continuous_map (setprod G G) (product_topology G Tg G Tg) G Tg mult -> U :e Tg -> e :e U -> exists V : set , V :e Tg /\ e :e V /\ forall x y : set , x :e V -> y :e V -> apply_fun mult (x,y) :e U.
Axiom topological_group_closure_sub_setmul_by : forall G Tg mult inv e V A : set , topology_on G Tg -> function_on mult (setprod G G) G -> continuous_map (setprod G G) (product_topology G Tg G Tg) G Tg mult -> function_on inv G G -> e :e G -> (forall x y z : set , x :e G -> y :e G -> z :e G -> apply_fun mult (apply_fun mult (x,y),z) = apply_fun mult (x,apply_fun mult (y,z))) -> (forall x : set , x :e G -> apply_fun mult (e,x) = x /\ apply_fun mult (x,e) = x) -> (forall x : set , x :e G -> apply_fun mult (x,apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x,x) = e) -> V :e Tg -> e :e V -> (forall x : set , x :e V -> apply_fun inv x :e V) -> A c= G -> closure_of G Tg A c= setmul_by mult V A.
Axiom topological_group_symmetric_neighborhood_square : forall G Tg mult inv e U : set , topology_on G Tg -> function_on mult (setprod G G) G -> function_on inv G G -> e :e G -> (forall x y z : set , x :e G -> y :e G -> z :e G -> apply_fun mult (apply_fun mult (x,y),z) = apply_fun mult (x,apply_fun mult (y,z))) -> (forall x : set , x :e G -> apply_fun mult (e,x) = x /\ apply_fun mult (x,e) = x) -> (forall x : set , x :e G -> apply_fun mult (x,apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x,x) = e) -> continuous_map (setprod G G) (product_topology G Tg G Tg) G Tg mult -> continuous_map G Tg G Tg inv -> U :e Tg -> e :e U -> exists V : set , V :e Tg /\ e :e V /\ (forall x : set , x :e V -> apply_fun inv x :e V) /\ forall x y : set , x :e V -> y :e V -> apply_fun mult (x,y) :e U.
Axiom topological_group_neighborhood_square_avoids_closed : forall G Tg mult inv e F : set , topology_on G Tg -> function_on mult (setprod G G) G -> function_on inv G G -> e :e G -> (forall x y z : set , x :e G -> y :e G -> z :e G -> apply_fun mult (apply_fun mult (x,y),z) = apply_fun mult (x,apply_fun mult (y,z))) -> (forall x : set , x :e G -> apply_fun mult (e,x) = x /\ apply_fun mult (x,e) = x) -> (forall x : set , x :e G -> apply_fun mult (x,apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x,x) = e) -> continuous_map (setprod G G) (product_topology G Tg G Tg) G Tg mult -> continuous_map G Tg G Tg inv -> closed_in G Tg F -> e /:e F -> exists V : set , V :e Tg /\ e :e V /\ (forall x : set , x :e V -> apply_fun inv x :e V) /\ forall x y : set , x :e V -> y :e V -> apply_fun mult (x,y) /:e F.
Axiom topological_group_identity_closed_separator : forall G Tg mult inv e F : set , topology_on G Tg -> function_on mult (setprod G G) G -> function_on inv G G -> e :e G -> (forall x y z : set , x :e G -> y :e G -> z :e G -> apply_fun mult (apply_fun mult (x,y),z) = apply_fun mult (x,apply_fun mult (y,z))) -> (forall x : set , x :e G -> apply_fun mult (e,x) = x /\ apply_fun mult (x,e) = x) -> (forall x : set , x :e G -> apply_fun mult (x,apply_fun inv x) = e /\ apply_fun mult (apply_fun inv x,x) = e) -> continuous_map (setprod G G) (product_topology G Tg G Tg) G Tg mult -> continuous_map G Tg G Tg inv -> closed_in G Tg F -> e /:e F -> exists h : set , continuous_map G Tg R R_standard_topology h /\ apply_fun h e = 0 /\ forall z : set , z :e F -> apply_fun h z = 1.
Axiom topological_group_T1 : forall G Tg : set , topological_group G Tg -> T1_space G Tg.
Axiom topological_group_is_topology : forall G Tg : set , topological_group G Tg -> topology_on G Tg.
Definition separated_subsets : set -> set -> set -> set -> prop := fun X Tx A B => A c= X /\ B c= X /\ closure_of X Tx A :/\: B = Empty /\ A :/\: closure_of X Tx B = Empty.
Definition completely_normal_space : set -> set -> prop := fun X Tx => topology_on X Tx /\ (forall Y : set , Y c= X -> normal_space Y (subspace_topology X Tx Y)).
Definition linear_continuum : set -> set -> prop := fun X Tx => simply_ordered_set X /\ Tx = order_topology X /\ (exists x y : set , x :e X /\ y :e X /\ x <> y) /\ (forall x y : set , x :e X -> y :e X -> order_rel X x y -> exists z : set , z :e X /\ order_rel X x z /\ order_rel X z y) /\ (forall A : set , A c= X -> A <> Empty -> (exists upper : set , upper :e X /\ forall a : set , a :e A -> order_rel X a upper \/ a = upper) -> exists lub : set , lub :e X /\ (forall a : set , a :e A -> order_rel X a lub \/ a = lub) /\ (forall bound : set , bound :e X -> (forall a : set , a :e A -> order_rel X a bound \/ a = bound) -> order_rel X lub bound \/ lub = bound)).
Axiom linear_continuum_simply_ordered : forall X Tx : set , linear_continuum X Tx -> simply_ordered_set X.
Axiom linear_continuum_order_topology_eq : forall X Tx : set , linear_continuum X Tx -> Tx = order_topology X.
Axiom linear_continuum_topology_on : forall X Tx : set , linear_continuum X Tx -> topology_on X Tx.
Axiom linear_continuum_lub_property : forall X Tx : set , linear_continuum X Tx -> forall A : set , A c= X -> A <> Empty -> (exists upper : set , upper :e X /\ forall a : set , a :e A -> order_rel X a upper \/ a = upper) -> exists lub : set , lub :e X /\ (forall a : set , a :e A -> order_rel X a lub \/ a = lub) /\ (forall bound : set , bound :e X -> (forall a : set , a :e A -> order_rel X a bound \/ a = bound) -> order_rel X lub bound \/ lub = bound).
Axiom linear_continuum_glb_property : forall X Tx A : set , linear_continuum X Tx -> A c= X -> A <> Empty -> (exists lower : set , lower :e X /\ forall a : set , a :e A -> order_rel X lower a \/ lower = a) -> exists glb : set , glb :e X /\ (forall a : set , a :e A -> order_rel X glb a \/ glb = a) /\ (forall bound : set , bound :e X -> (forall a : set , a :e A -> order_rel X bound a \/ bound = a) -> order_rel X bound glb \/ bound = glb).
Axiom linear_continuum_closed_contains_glb : forall X Tx C : set , linear_continuum X Tx -> closed_in X Tx C -> C <> Empty -> (exists lower : set , lower :e X /\ forall c : set , c :e C -> order_rel X lower c \/ lower = c) -> exists c0 : set , c0 :e C /\ (forall c : set , c :e C -> order_rel X c0 c \/ c0 = c) /\ (forall bound : set , bound :e X -> (forall c : set , c :e C -> order_rel X bound c \/ bound = c) -> order_rel X bound c0 \/ bound = c0).
Axiom linear_continuum_closed_contains_lub : forall X Tx C : set , linear_continuum X Tx -> closed_in X Tx C -> C <> Empty -> (exists upper : set , upper :e X /\ forall c : set , c :e C -> order_rel X c upper \/ c = upper) -> exists c0 : set , c0 :e C /\ (forall c : set , c :e C -> order_rel X c c0 \/ c = c0) /\ (forall bound : set , bound :e X -> (forall c : set , c :e C -> order_rel X c bound \/ c = bound) -> order_rel X c0 bound \/ c0 = bound).
Axiom thm24_1_linear_continuum_connected : forall X Tx : set , linear_continuum X Tx -> connected_space X Tx.
Axiom thm24_1_linear_continuum_intervals_connected : forall X Tx a b : set , linear_continuum X Tx -> a :e X -> b :e X -> order_rel X a b -> connected_space (order_interval X a b) (subspace_topology X Tx (order_interval X a b)).
Axiom thm24_1_linear_continuum_rays_connected : forall X Tx a b : set , linear_continuum X Tx -> a :e X -> b :e X -> connected_space {x :e X|order_rel X a x} (subspace_topology X Tx {x :e X|order_rel X a x}) /\ connected_space {x :e X|order_rel X x b} (subspace_topology X Tx {x :e X|order_rel X x b}).
Axiom ex30_1a_onepoint_Gdelta_firstcountable_T1 : forall X Tx x : set , first_countable_space X Tx -> T1_space X Tx -> x :e X -> Gdelta_in X Tx (Sing x).
Definition ex30_1b_AF_X : set := setprod omega omega.
Definition ex30_1b_AF_p : set := (0,0).
Definition ex30_1b_AF_nbh_p : set -> prop := fun U => ex30_1b_AF_p :e U /\ forall m :e omega , exists N :e omega , forall n : set , n :e omega -> N c= n -> (m,n) :e U.
Definition ex30_1b_AF_Tx : set := {U :e Power ex30_1b_AF_X|(ex30_1b_AF_p /:e U) \/ ex30_1b_AF_nbh_p U}.
Axiom ordsucc_not_Subq_self : forall n : set , ~ (ordsucc n c= n).
Axiom ex30_1b_AF_open_contains_p_implies_nbh : forall U : set , U :e ex30_1b_AF_Tx -> ex30_1b_AF_p :e U -> ex30_1b_AF_nbh_p U.
Axiom ex30_1b_AF_topology_on : topology_on ex30_1b_AF_X ex30_1b_AF_Tx.
Axiom ex30_1b_AF_openI_avoids_p : forall U : set , U :e Power ex30_1b_AF_X -> ex30_1b_AF_p /:e U -> U :e ex30_1b_AF_Tx.
Axiom ex30_1b_AF_Un_open : forall n : set , n :e omega -> open_in ex30_1b_AF_X ex30_1b_AF_Tx ({ex30_1b_AF_p} :\/: {w :e ex30_1b_AF_X|n c= w 1}).
Axiom ex30_1b_AF_singleton_open : forall x : set , x :e ex30_1b_AF_X -> ~ (x = ex30_1b_AF_p) -> open_in ex30_1b_AF_X ex30_1b_AF_Tx (Sing x).
Axiom ex30_1b_AF_singleton_Gdelta_not_p : forall x : set , x :e ex30_1b_AF_X -> ~ (x = ex30_1b_AF_p) -> Gdelta_in ex30_1b_AF_X ex30_1b_AF_Tx (Sing x).
Axiom ex30_1b_AF_singleton_Gdelta_p : Gdelta_in ex30_1b_AF_X ex30_1b_AF_Tx (Sing ex30_1b_AF_p).
Axiom ex30_1b_AF_all_singletons_Gdelta : forall x : set , x :e ex30_1b_AF_X -> Gdelta_in ex30_1b_AF_X ex30_1b_AF_Tx (Sing x).
Axiom ex30_1b_AF_not_first_countable : ~ first_countable_space ex30_1b_AF_X ex30_1b_AF_Tx.
Axiom ex30_1b_Gdelta_not_firstcountable_exists : exists X : set , exists Tx : set , topology_on X Tx /\ (forall x : set , x :e X -> Gdelta_in X Tx (Sing x)) /\ ~ first_countable_space X Tx.
Axiom ex30_2_basis_contains_countable : forall X Tx : set , forall Basis : set , second_countable_space X Tx -> basis_generates X Basis Tx -> exists CountableSub : set , CountableSub c= Basis /\ countable CountableSub /\ basis_generates X CountableSub Tx.
Axiom ex30_3_uncountably_many_limit_points : forall X Tx A : set , second_countable_space X Tx -> A c= X -> ~ countable A -> ~ countable {x :e A|limit_point_of X Tx A x}.
Axiom ex30_4_compact_metrizable_second_countable : forall X Tx d : set , compact_space X Tx -> metrizable X Tx -> metric_on X d -> Tx = metric_topology X d -> second_countable_space X Tx.
Axiom ex30_5a_metrizable_countable_dense_second_countable : forall X Tx : set , metrizable X Tx -> (exists D : set , D c= X /\ countable D /\ dense_in D X Tx) -> second_countable_space X Tx.
Axiom ex30_5b_metrizable_Lindelof_second_countable : forall X Tx : set , metrizable X Tx -> Lindelof_space X Tx -> second_countable_space X Tx.
Axiom ex30_6a_Rl_not_metrizable : ~ metrizable R R_lower_limit_topology.
Axiom ex30_6b_ordered_square_not_metrizable : ~ metrizable ordered_square ordered_square_topology.
Axiom ex30_7_SOmega_Sbar_Omega_countability : (first_countable_space S_Omega SOmega_topology /\ ~ second_countable_space S_Omega SOmega_topology /\ ~ Lindelof_space S_Omega SOmega_topology /\ ~ (exists D : set , D c= S_Omega /\ countable D /\ dense_in D S_Omega SOmega_topology)) /\ (~ first_countable_space Sbar_Omega SbarOmega_topology /\ ~ second_countable_space Sbar_Omega SbarOmega_topology /\ Lindelof_space Sbar_Omega SbarOmega_topology /\ ~ (exists D : set , D c= Sbar_Omega /\ countable D /\ dense_in D Sbar_Omega SbarOmega_topology)).
Axiom ex30_8_Romega_uniform_countability : first_countable_space real_sequences uniform_topology /\ ~ second_countable_space real_sequences uniform_topology /\ ~ Lindelof_space real_sequences uniform_topology /\ ~ (exists D : set , D c= real_sequences /\ countable D /\ dense_in D real_sequences uniform_topology).
Axiom ex30_9a_closed_Lindelof : forall X Tx A : set , Lindelof_space X Tx -> closed_in X Tx A -> Lindelof_space A (subspace_topology X Tx A).
Axiom ex30_9b_dense_not_countable_dense : exists X : set , exists Tx : set , exists A : set , (exists D : set , D c= X /\ countable D /\ dense_in D X Tx) /\ closed_in X Tx A /\ ~ (exists DA : set , DA c= A /\ countable DA /\ dense_in DA A (subspace_topology X Tx A)).
Axiom ex30_10_product_countable_dense : forall Idx : set , forall Fam : set , countable Idx -> (forall i : set , i :e Idx -> exists Xi : set , exists Txi : set , exists Di : set , apply_fun Fam i = (Xi,Txi) /\ topology_on Xi Txi /\ Di c= Xi /\ countable Di /\ dense_in Di Xi Txi) -> exists D : set , D c= product_space Idx Fam /\ countable D /\ dense_in D (product_space Idx Fam) (product_topology_full Idx Fam).
Axiom ex30_11a_image_Lindelof : forall X Tx Y Ty f : set , Lindelof_space X Tx -> continuous_map X Tx Y Ty f -> Lindelof_space (image_of f X) (subspace_topology Y Ty (image_of f X)).
Axiom ex30_11b_image_countable_dense : forall X Tx Y Ty f : set , (exists D : set , D c= X /\ countable D /\ dense_in D X Tx) -> continuous_map X Tx Y Ty f -> exists Df : set , Df c= (image_of f X) /\ countable Df /\ dense_in Df (image_of f X) (subspace_topology Y Ty (image_of f X)).
Axiom continuous_image_countable_dense_subset : forall X Tx Y Ty f : set , countable_dense_subset X Tx -> continuous_map X Tx Y Ty f -> countable_dense_subset (image_of f X) (subspace_topology Y Ty (image_of f X)).
Axiom continuous_image_separable_space : forall X Tx Y Ty f : set , separable_space X Tx -> continuous_map X Tx Y Ty f -> separable_space (image_of f X) (subspace_topology Y Ty (image_of f X)).
Axiom ex30_12a_open_map_first_countable : forall X Tx Y Ty f : set , first_countable_space X Tx -> continuous_map X Tx Y Ty f -> open_map X Tx Y Ty f -> first_countable_space (image_of f X) (subspace_topology Y Ty (image_of f X)).
Axiom ex30_12b_open_map_second_countable : forall X Tx Y Ty f : set , second_countable_space X Tx -> continuous_map X Tx Y Ty f -> open_map X Tx Y Ty f -> second_countable_space (image_of f X) (subspace_topology Y Ty (image_of f X)).
Axiom ex30_13_disjoint_open_sets_countable : forall X Tx : set , (exists D : set , D c= X /\ countable D /\ dense_in D X Tx) -> forall Fam : set , (forall U : set , U :e Fam -> open_in X Tx U) -> (forall U V : set , U :e Fam -> V :e Fam -> U <> V -> U :/\: V = Empty) -> countable Fam.
Axiom ex30_14_product_Lindelof_compact : forall X Tx Y Ty : set , Lindelof_space X Tx -> compact_space Y Ty -> Lindelof_space (setprod X Y) (product_topology X Tx Y Ty).
Definition graphify_on : set -> set -> set := fun X f => graph X (fun x : set => apply_fun f x).
Axiom graphify_on_apply : forall X f x : set , x :e X -> apply_fun (graphify_on X f) x = apply_fun f x.
(** Proven Charlie **)
Theorem compose_fun_graphify_on_apply : forall X f g x:set,
  x :e X ->
  apply_fun (compose_fun X (graphify_on X f) g) x =
  apply_fun (compose_fun X f g) x.
let X f g x.
assume Hx.
rewrite (compose_fun_apply X (graphify_on X f) g x Hx).
rewrite (graphify_on_apply X f x Hx).
rewrite (compose_fun_apply X f g x Hx).
reflexivity.
Qed.
Axiom graphify_on_idem : forall X f : set , graphify_on X (graphify_on X f) = graphify_on X f.
Axiom graphify_on_unit_interval_in_power_real : forall f : set , function_on f unit_interval R -> graphify_on unit_interval f :e power_real unit_interval.
Axiom graphify_on_unit_interval_in_function_space : forall f : set , function_on f unit_interval R -> graphify_on unit_interval f :e function_space unit_interval R.
Axiom graphify_on_unit_interval_in_C_I_R : forall f : set , f :e C_I_R -> graphify_on unit_interval f :e C_I_R.
Definition uniform_metric_C_I_R : set := graph (setprod C_I_R C_I_R) (fun p : set => power_real_uniform_metric_value unit_interval (graphify_on unit_interval (p 0)) (graphify_on unit_interval (p 1))).
Definition uniform_topology_C_I_R : set := metric_topology C_I_R uniform_metric_C_I_R.
Axiom uniform_metric_C_I_R_function_on : function_on uniform_metric_C_I_R (setprod C_I_R C_I_R) R.
Axiom uniform_metric_C_I_R_apply : forall f g : set , f :e C_I_R -> g :e C_I_R -> apply_fun uniform_metric_C_I_R (f,g) = power_real_uniform_metric_value unit_interval (graphify_on unit_interval f) (graphify_on unit_interval g).
Axiom uniform_metric_C_I_R_sym : forall f g : set , f :e C_I_R -> g :e C_I_R -> apply_fun uniform_metric_C_I_R (f,g) = apply_fun uniform_metric_C_I_R (g,f).
Axiom uniform_metric_C_I_R_triangle : forall f g h : set , f :e C_I_R -> g :e C_I_R -> h :e C_I_R -> ~ (Rlt (add_SNo (apply_fun uniform_metric_C_I_R (f,g)) (apply_fun uniform_metric_C_I_R (g,h))) (apply_fun uniform_metric_C_I_R (f,h))).
Axiom uniform_metric_C_I_R_self_zero : forall f : set , f :e C_I_R -> apply_fun uniform_metric_C_I_R (f,f) = 0.
Axiom uniform_metric_C_I_R_nonneg : forall f g : set , f :e C_I_R -> g :e C_I_R -> ~ (Rlt (apply_fun uniform_metric_C_I_R (f,g)) 0).
Axiom power_real_uniform_metric_value_le_1 : forall J f g : set , J <> Empty -> f :e power_real J -> g :e power_real J -> Rle (power_real_uniform_metric_value J f g) 1.
Axiom uniform_metric_C_I_R_le_1 : forall f g : set , f :e C_I_R -> g :e C_I_R -> Rle (apply_fun uniform_metric_C_I_R (f,g)) 1.
Axiom open_ball_C_I_R_of_pointwise_bd_le : forall f g eps eps0 : set , f :e C_I_R -> g :e C_I_R -> eps :e R -> eps0 :e R -> Rlt eps0 eps -> (forall x : set , x :e unit_interval -> Rle (R_bounded_distance (apply_fun f x) (apply_fun g x)) eps0) -> g :e open_ball C_I_R uniform_metric_C_I_R f eps.
Axiom open_ball_C_I_R_of_pointwise_abs_le_lt1 : forall f g eps eps0 : set , f :e C_I_R -> g :e C_I_R -> eps :e R -> eps0 :e R -> Rlt eps0 1 -> Rlt eps0 eps -> (forall x : set , x :e unit_interval -> Rle (abs_SNo (add_SNo (apply_fun f x) (minus_SNo (apply_fun g x)))) eps0) -> g :e open_ball C_I_R uniform_metric_C_I_R f eps.
Axiom open_ball_C_I_R_radius_gt1_whole : forall f eps : set , f :e C_I_R -> eps :e R -> Rlt 1 eps -> open_ball C_I_R uniform_metric_C_I_R f eps = C_I_R.
Axiom uniform_metric_C_I_R_is_pseudometric_on : pseudometric_on C_I_R uniform_metric_C_I_R.
Axiom uniform_metric_C_I_R_eq0_pointwise : forall f g x : set , f :e C_I_R -> g :e C_I_R -> x :e unit_interval -> apply_fun uniform_metric_C_I_R (f,g) = 0 -> apply_fun f x = apply_fun g x.
Axiom uniform_metric_C_I_R_eq0_pointwise_all : forall f g : set , f :e C_I_R -> g :e C_I_R -> apply_fun uniform_metric_C_I_R (f,g) = 0 -> forall x : set , x :e unit_interval -> apply_fun f x = apply_fun g x.
Definition C_I_R_graph : set := {graphify_on unit_interval f|f :e C_I_R}.
Definition U_n_graph : set -> set := fun n => {g :e C_I_R_graph|n :e omega /\ 2 c= n /\ exists h : set , h :e R /\ Rlt 0 h /\ Rle h (div_SNo 1 n) /\ exists r : set , r :e R /\ Rlt n r /\ forall x : set , x :e unit_interval -> Delta_gt g x h r}.
Axiom C_I_R_graph_Subq_power_real : C_I_R_graph c= power_real unit_interval.
Axiom C_I_R_graph_Subq_C_I_R : C_I_R_graph c= C_I_R.
Axiom C_I_R_graph_graphify_fixed : forall g : set , g :e C_I_R_graph -> graphify_on unit_interval g = g.
Axiom uniform_metric_C_I_R_graphify_right : forall c f : set , c :e C_I_R -> f :e C_I_R -> apply_fun uniform_metric_C_I_R (c,graphify_on unit_interval f) = apply_fun uniform_metric_C_I_R (c,f).
Axiom uniform_metric_C_I_R_graphify_left : forall f c : set , f :e C_I_R -> c :e C_I_R -> apply_fun uniform_metric_C_I_R (graphify_on unit_interval f,c) = apply_fun uniform_metric_C_I_R (f,c).
Axiom open_ball_C_I_R_graphify_center_eq : forall f eps : set , f :e C_I_R -> eps :e R -> open_ball C_I_R uniform_metric_C_I_R (graphify_on unit_interval f) eps = open_ball C_I_R uniform_metric_C_I_R f eps.
Axiom C_I_R_graph_dense_in_C_I_R_uniform : dense_in C_I_R_graph C_I_R uniform_topology_C_I_R.
Definition uniform_metric_C_I_R_graph : set := graph (setprod C_I_R_graph C_I_R_graph) (fun p : set => apply_fun (uniform_metric_power_real unit_interval) p).
Axiom uniform_metric_C_I_R_graph_is_metric_on : metric_on C_I_R_graph uniform_metric_C_I_R_graph.
Axiom uniform_metric_C_I_R_on_graph_eq_uniform_metric_C_I_R_graph : forall g h : set , g :e C_I_R_graph -> h :e C_I_R_graph -> apply_fun uniform_metric_C_I_R (g,h) = apply_fun uniform_metric_C_I_R_graph (g,h).
Axiom open_ball_C_I_R_graph_eq_inter : forall g r : set , g :e C_I_R_graph -> open_ball C_I_R_graph uniform_metric_C_I_R_graph g r = (open_ball C_I_R uniform_metric_C_I_R g r) :/\: C_I_R_graph.
Definition uniform_topology_C_I_R_graph : set := metric_topology C_I_R_graph uniform_metric_C_I_R_graph.
Axiom diffquot_forward_abs_graphify_on : forall f x h : set , x :e unit_interval -> add_SNo x h :e unit_interval -> diffquot_forward_abs (graphify_on unit_interval f) x h = diffquot_forward_abs f x h.
Axiom diffquot_backward_abs_graphify_on : forall f x h : set , x :e unit_interval -> add_SNo x (minus_SNo h) :e unit_interval -> diffquot_backward_abs (graphify_on unit_interval f) x h = diffquot_backward_abs f x h.
Axiom Delta_gt_graphify_on : forall f x h r : set , x :e unit_interval -> Delta_gt f x h r -> Delta_gt (graphify_on unit_interval f) x h r.
Axiom Delta_gt_graphify_on_rev : forall f x h r : set , x :e unit_interval -> Delta_gt (graphify_on unit_interval f) x h r -> Delta_gt f x h r.
Definition lin_fun_I : set -> set := fun c => graphify_on unit_interval (mul_const_funR c).
Axiom lin_fun_I_apply : forall c x : set , c :e R -> x :e unit_interval -> apply_fun (lin_fun_I c) x = mul_SNo x c.
Axiom lin_fun_I_in_function_space_pos : forall c : set , c :e R -> 0 < c -> lin_fun_I c :e function_space unit_interval R.
Axiom lin_fun_I_continuous_real_on_I_pos : forall c : set , c :e R -> 0 < c -> continuous_real_on_I (lin_fun_I c).
Axiom lin_fun_I_in_C_I_R_pos : forall c : set , c :e R -> 0 < c -> lin_fun_I c :e C_I_R.
Axiom const_fun_I_in_C_I_R : forall b : set , b :e R -> const_fun unit_interval b :e C_I_R.
