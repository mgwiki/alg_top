  { exact (loop_at_implies_fundamental_group_member B Tb b0 rev_alpha_s HtopB Hb0B Hrev_as_la). }
  (** Key: invG(alpha_s_class) = rev_as_class **)
  claim Hinv_eq_rev_s : apply_fun invG alpha_s_class = rev_as_class.
