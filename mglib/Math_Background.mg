    {
      exact (andEL
        (continuous_map unit_interval unit_interval_topology E Te lc0 /\
          apply_fun lc0 0 = e0)
        (forall t:set, t :e unit_interval ->
          apply_fun p (apply_fun lc0 t) = apply_fun fc t)
        HliftFcPack).
    }
    claim HliftFxCont :
      continuous_map unit_interval unit_interval_topology E Te lx.
    {
