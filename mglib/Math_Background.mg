              (U :e Tb /\ b :e U)
              (exists G:set, G c= Fam /\ finite G /\ preimage_of E p U c= Union G)
              HUPack)).
        }
        claim HUG :
          exists G:set, G c= Fam /\ finite G /\ preimage_of E p U c= Union G.
