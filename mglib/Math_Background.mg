											          apply (xm (i :e n1A)).
											          + assume Hi1.
											            claim Hpref_eq : apply_fun xsA1 i = apply_fun xsB1 i.
											            { exact (andER (n1A = n1B) (forall i0:set, i0 :e n1A -> apply_fun xsA1 i0 = apply_fun xsB1 i0) Hprefix_pack i Hi1). }
											            claim Hi1B : i :e n1B.
