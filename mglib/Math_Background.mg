        claim Hz1I2 : z 1 :e I2_54.
        { exact (ap1_Sigma I1_54 (fun _ : set => I2_54) z HzN). }
        claim Hz0I : z 0 :e unit_interval.
        { exact (HI1subI (z 0) Hz0I1). }
        claim Hz1I : z 1 :e unit_interval.
