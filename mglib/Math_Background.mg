    r1
    (eps_ 1)
    1
    Hr1LtEps
    eps_1_lt1_R).
}
claim HprodSubB : setprod
  (open_ball unit_interval R_bounded_metric (q 0) r0)
  (open_ball unit_interval R_bounded_metric (q 1) r1) c= b.
{
  rewrite HbEq.
