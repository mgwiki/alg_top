        HaS).
      rewrite (mul_SNo_oneR
        (x 0)
        Hx0SNo).
      reflexivity.
    }
    claim Hf1Scaled :
      add_SNo (mul_SNo a (x 1)) (x 1) = mul_SNo c (x 1).
    {
      rewrite (mul_SNo_com
        c
        (x 1)
        HcS
        Hx1SNo).
      rewrite (mul_SNo_distrL
        (x 1)
        a
        1
        Hx1SNo
        HaS
        SNo_1).
      rewrite (mul_SNo_com
        (x 1)
        a
        Hx1SNo
        HaS).
      rewrite (mul_SNo_oneR
        (x 1)
        Hx1SNo).
      reflexivity.
    }
    claim HfxNormEq :
      add_SNo
        (mul_SNo (apply_fun f x 0) (apply_fun f x 0))
        (mul_SNo (apply_fun f x 1) (apply_fun f x 1))
      =
      mul_SNo
        (mul_SNo c c)
        (add_SNo
          (mul_SNo (x 0) (x 0))
          (mul_SNo (x 1) (x 1))).
    {
      rewrite Hf0Linear at 1.
      rewrite Hf0Linear at 1.
      rewrite Hf1Linear at 1.
      rewrite Hf1Linear at 1.
      rewrite Hf0Scaled at 1.
      rewrite Hf0Scaled at 1.
      rewrite Hf1Scaled at 1.
      rewrite Hf1Scaled at 1.
      rewrite (mul_SNo_com_4_inner_mid
        c
        (x 0)
        c
        (x 0)
        HcS
        Hx0SNo
        HcS
        Hx0SNo).
      rewrite (mul_SNo_com_4_inner_mid
        c
        (x 1)
        c
        (x 1)
        HcS
        Hx1SNo
        HcS
        Hx1SNo).
      rewrite <- (mul_SNo_distrL
        (mul_SNo c c)
        (mul_SNo (x 0) (x 0))
        (mul_SNo (x 1) (x 1))
        (SNo_mul_SNo
          c
          c
          HcS
          HcS)
        (SNo_mul_SNo
          (x 0)
          (x 0)
          Hx0SNo
          Hx0SNo)
        (SNo_mul_SNo
          (x 1)
          (x 1)
          Hx1SNo
          Hx1SNo)).
      reflexivity.
    }
    claim HfxNormEqC2 :
      add_SNo
        (mul_SNo (apply_fun f x 0) (apply_fun f x 0))
        (mul_SNo (apply_fun f x 1) (apply_fun f x 1))
      = mul_SNo c c.
    {
      rewrite HfxNormEq.
      rewrite HxEq1.
      rewrite (mul_SNo_oneR
        (mul_SNo c c)
        (SNo_mul_SNo
          c
          c
          HcS
          HcS)).
      reflexivity.
    }
    claim HfxNormGt1 :
      Rlt 1
        (add_SNo
          (mul_SNo (apply_fun f x 0) (apply_fun f x 0))
          (mul_SNo (apply_fun f x 1) (apply_fun f x 1))).
    {
      rewrite HfxNormEqC2.
      exact HcSqGt1R.
    }
    claim HfxBound :
      ~(Rlt 1
        (add_SNo
          (mul_SNo (apply_fun f x 0) (apply_fun f x 0))
          (mul_SNo (apply_fun f x 1) (apply_fun f x 1)))).
    {
      exact (SepE2
        (setprod R R)
        (fun p:set =>
          ~(Rlt 1
            (add_SNo (mul_SNo (p 0) (p 0))
              (mul_SNo (p 1) (p 1)))))
        (apply_fun f x)
        HfxB2).
    }
    apply HfxBound.
    exact HfxNormGt1.
  }
  exact (FalseE
    Hcontra
    (exists x:set, x :e B2 /\ apply_fun f x = x)).
Qed.

(** Infrastructure for starred Cor 55.7: finite sum of real-valued terms **)
(** finite_real_sum f n = f(0) + f(1) + ... + f(n-1) **)
Definition finite_real_sum : (set -> set) -> set -> set := fun f n =>
  nat_primrec 0 (fun j r => add_SNo r (f j)) n.

(** Infrastructure: finite_real_sum base/step rules **)
(** Proven Bob **)
Lemma finite_real_sum_0 : forall f:set->set,
  finite_real_sum f 0 = 0.
let f.
exact (nat_primrec_0 0 (fun j r => add_SNo r (f j))).
Qed.

(** Proven Bob **)
Lemma finite_real_sum_S : forall f:set->set, forall n:set, nat_p n ->
  finite_real_sum f (ordsucc n) = add_SNo (finite_real_sum f n) (f n).
let f n.
assume Hn.
exact (nat_primrec_S 0 (fun j r => add_SNo r (f j)) n Hn).
Qed.

(** Proven Bob **)
Lemma finite_real_sum_in_R : forall f:set->set, forall n:set, nat_p n ->
  (forall k:set, k :e n -> f k :e R) ->
  finite_real_sum f n :e R.
let f n.
assume Hn Hf.
claim Hnat :
  forall m:set, nat_p m ->
    (forall k:set, k :e m -> f k :e R) ->
    finite_real_sum f m :e R.
{
  apply nat_ind.
  - assume H0f.
    rewrite (finite_real_sum_0 f).
    exact real_0.
  - let m.
    assume Hm_nat IH.
    assume Hmf.
    rewrite (finite_real_sum_S f m Hm_nat).
    claim HsumR : finite_real_sum f m :e R.
    {
      exact (IH (fun k Hk => Hmf k (ordsuccI1 m k Hk))).
    }
    claim HfR : f m :e R.
    { exact (Hmf m (ordsuccI2 m)). }
    exact (real_add_SNo (finite_real_sum f m) HsumR (f m) HfR).
}
exact (Hnat n Hn Hf).
Qed.

(** Proven Bob **)
Lemma finite_real_sum_zero_of_all_zero : forall f:set->set, forall n:set, nat_p n ->
  (forall k:set, k :e n -> f k :e R) ->
  (forall k:set, k :e n -> f k = 0) ->
  finite_real_sum f n = 0.
let f n.
assume Hn HfR Hf0.
claim Hnat :
  forall m:set, nat_p m ->
    (forall k:set, k :e m -> f k :e R) ->
    (forall k:set, k :e m -> f k = 0) ->
    finite_real_sum f m = 0.
{
  apply nat_ind.
  - assume H0R H0.
    rewrite (finite_real_sum_0 f).
    reflexivity.
  - let m.
    assume Hm_nat IH.
    assume HmR Hm0.
    rewrite (finite_real_sum_S f m Hm_nat).
    claim Hsum0 : finite_real_sum f m = 0.
    {
      exact (IH
        (fun k Hk => HmR k (ordsuccI1 m k Hk))
        (fun k Hk => Hm0 k (ordsuccI1 m k Hk))).
    }
    rewrite Hsum0.
    claim Hfm0 : f m = 0.
    { exact (Hm0 m (ordsuccI2 m)). }
    rewrite Hfm0.
    exact (add_SNo_0L 0 (real_SNo 0 real_0)).
}
exact (Hnat n Hn HfR Hf0).
Qed.

(** Proven Bob **)
Lemma finite_real_sum_nonneg : forall f:set->set, forall n:set, nat_p n ->
  (forall k:set, k :e n -> f k :e R) ->
  (forall k:set, k :e n -> Rle 0 (f k)) ->
  Rle 0 (finite_real_sum f n).
let f n.
assume Hn HfR HfNonneg.
claim Hnat :
  forall m:set, nat_p m ->
    (forall k:set, k :e m -> f k :e R) ->
    (forall k:set, k :e m -> Rle 0 (f k)) ->
    Rle 0 (finite_real_sum f m).
{
  apply nat_ind.
  - assume H0R H0nonneg.
    rewrite (finite_real_sum_0 f).
    exact (Rle_refl 0 real_0).
  - let m.
    assume Hm_nat IH.
    assume HmR Hmnonneg.
    rewrite (finite_real_sum_S f m Hm_nat).
    claim HsumR : finite_real_sum f m :e R.
    {
      exact (finite_real_sum_in_R f m Hm_nat
        (fun k Hk => HmR k (ordsuccI1 m k Hk))).
    }
    claim HsumNonneg : Rle 0 (finite_real_sum f m).
    {
      exact (IH
        (fun k Hk => HmR k (ordsuccI1 m k Hk))
        (fun k Hk => Hmnonneg k (ordsuccI1 m k Hk))).
    }
    claim HfmR : f m :e R.
    { exact (HmR m (ordsuccI2 m)). }
    claim HfmNonneg : Rle 0 (f m).
    { exact (Hmnonneg m (ordsuccI2 m)). }
    claim Hfm_le_sum : Rle (f m) (add_SNo (finite_real_sum f m) (f m)).
    {
      exact (Rle_increase_by_nonneg_left
        (finite_real_sum f m)
        (f m)
        HsumR
        HfmR
        HsumNonneg).
    }
    exact (Rle_tra
      0
      (f m)
      (add_SNo (finite_real_sum f m) (f m))
      HfmNonneg
      Hfm_le_sum).
}
exact (Hnat n Hn HfR HfNonneg).
Qed.

(** Proven Charlie **)
Lemma finite_real_sum_congr : forall f g:set->set, forall n:set, nat_p n ->
  (forall k:set, k :e n -> f k = g k) ->
  finite_real_sum f n = finite_real_sum g n.
let f g n.
assume Hn Hfg.
claim Hnat :
  forall m:set, nat_p m ->
    (forall k:set, k :e m -> f k = g k) ->
    finite_real_sum f m = finite_real_sum g m.
{
  apply nat_ind.
  - assume H0fg.
    rewrite (finite_real_sum_0 f).
    rewrite (finite_real_sum_0 g).
    reflexivity.
  - let m.
    assume Hm_nat IH.
    assume Hmf.
    rewrite (finite_real_sum_S f m Hm_nat).
    rewrite (finite_real_sum_S g m Hm_nat).
    rewrite (IH
      (fun k Hk => Hmf k (ordsuccI1 m k Hk))).
    rewrite (Hmf
      m
      (ordsuccI2 m)).
    reflexivity.
}
exact (Hnat n Hn Hfg).
Qed.

(** Proven Charlie **)
Lemma finite_real_sum_mul_const_right : forall f:set->set, forall n r:set,
  nat_p n ->
  r :e R ->
  (forall k:set, k :e n -> f k :e R) ->
  finite_real_sum (fun k:set => mul_SNo (f k) r) n =
  mul_SNo (finite_real_sum f n) r.
let f n r.
assume Hn Hr HfR.
claim HrS : SNo r.
{
  exact (real_SNo
    r
    Hr).
}
claim Hnat :
  forall m:set, nat_p m ->
    (forall k:set, k :e m -> f k :e R) ->
    finite_real_sum (fun k:set => mul_SNo (f k) r) m =
    mul_SNo (finite_real_sum f m) r.
{
  apply nat_ind.
  - assume H0R.
    rewrite (finite_real_sum_0 (fun k:set => mul_SNo (f k) r)).
    rewrite (finite_real_sum_0 f).
    rewrite (mul_SNo_zeroL
      r
      HrS).
    reflexivity.
  - let m.
    assume Hm_nat IH.
    assume HmR.
    rewrite (finite_real_sum_S (fun k:set => mul_SNo (f k) r) m Hm_nat).
    rewrite (finite_real_sum_S f m Hm_nat).
    rewrite (IH
      (fun k Hk => HmR k (ordsuccI1 m k Hk))).
    claim HsumR : finite_real_sum f m :e R.
    {
      exact (finite_real_sum_in_R
        f
        m
        Hm_nat
        (fun k Hk => HmR k (ordsuccI1 m k Hk))).
    }
    claim HsumS : SNo (finite_real_sum f m).
    {
      exact (real_SNo
        (finite_real_sum f m)
        HsumR).
    }
    claim HfmR : f m :e R.
    {
      exact (HmR
        m
        (ordsuccI2 m)).
    }
    claim HfmS : SNo (f m).
    {
      exact (real_SNo
        (f m)
        HfmR).
    }
    rewrite <- (mul_SNo_distrR
      (finite_real_sum f m)
      (f m)
      r
      HsumS
      HfmS
      HrS).
    reflexivity.
}
exact (Hnat n Hn HfR).
Qed.

(** Infrastructure: n-by-n matrix applied to n-vector **)
(** (Av)_i = sum_{j<n} A(i,j) v(j) **)
Definition matrix_vector_mult : set -> set -> set -> set := fun n A v =>
  graph n (fun i:set =>
    finite_real_sum (fun j:set => mul_SNo (apply_fun A (i, j)) (apply_fun v j)) n).

(** Infrastructure: eigenvalue of an n-by-n real matrix **)
Definition eigenvalue_of_matrix : set -> set -> set -> prop := fun n A lam =>
  lam :e R /\
  exists v:set,
    function_on v n R /\
    ~(forall i:set, i :e n -> apply_fun v i = 0) /\
    (forall i:set, i :e n ->
      finite_real_sum (fun j:set => mul_SNo (apply_fun A (i, j)) (apply_fun v j)) n =
      mul_SNo lam (apply_fun v i)).

(** Infrastructure: 2-simplex as subset of function_space 3 R **)
Definition simplex3_fs : set :=
  {v :e function_space 3 R |
    (forall i:set, i :e 3 -> ~(Rlt (apply_fun v i) 0)) /\
    finite_real_sum (fun i:set => apply_fun v i) 3 = 1}.

(** Early triangle model for simplex3_fs, placed before the fixed-point theorem. **)
Definition simplex3_triangle_region : set :=
  {p :e setprod R R |
    ~(Rlt (p 0) 0) /\ ~(Rlt (p 1) 0) /\
    ~(Rlt 1 (add_SNo (p 0) (p 1)))}.

Definition simplex3_triangle_topology : set :=
  subspace_topology (setprod R R) R2_topology simplex3_triangle_region.

Definition simplex3_fs_to_triangle_region : set :=
  graph simplex3_fs (fun v:set =>
    (apply_fun v 0, apply_fun v 1)).

Definition simplex3_triangle_region_to_fs : set :=
  graph simplex3_triangle_region (fun p:set =>
    graph 3 (fun i:set =>
      if i = 0 then p 0 else
      if i = 1 then p 1 else
      add_SNo 1 (minus_SNo (add_SNo (p 0) (p 1))))).

(** Infrastructure: simplex3_fs points map into the early triangle model. **)
(** Proven Charlie **)
Lemma simplex3_fs_to_triangle_region_in_region :
  forall v:set, v :e simplex3_fs ->
    apply_fun simplex3_fs_to_triangle_region v :e simplex3_triangle_region.
let v.
assume HvS.
set p := apply_fun simplex3_fs_to_triangle_region v.
claim HpEq : p = (apply_fun v 0, apply_fun v 1).
{
  exact (apply_fun_graph
    simplex3_fs
    (fun v0:set => (apply_fun v0 0, apply_fun v0 1))
    v
    HvS).
}
claim Hvfun : function_on v 3 R.
{
  exact (function_on_of_function_space
    v
    3
    R
    (SepE1
      (function_space 3 R)
      (fun w:set =>
        (forall i:set, i :e 3 -> ~(Rlt (apply_fun w i) 0)) /\
        finite_real_sum (fun i:set => apply_fun w i) 3 = 1)
      v
      HvS)).
}
claim HvProp :
  (forall i:set, i :e 3 -> ~(Rlt (apply_fun v i) 0)) /\
  finite_real_sum (fun i:set => apply_fun v i) 3 = 1.
{
  exact (SepE2
    (function_space 3 R)
    (fun w:set =>
      (forall i:set, i :e 3 -> ~(Rlt (apply_fun w i) 0)) /\
      finite_real_sum (fun i:set => apply_fun w i) 3 = 1)
    v
    HvS).
}
claim H0in3 : 0 :e 3.
{ exact (ordsuccI1 2 0 In_0_2). }
claim H1in3 : 1 :e 3.
{ exact (ordsuccI1 2 1 In_1_2). }
claim H2in3 : 2 :e 3.
{ exact (ordsuccI2 2). }
claim Hv0R : apply_fun v 0 :e R.
{ exact (Hvfun 0 H0in3). }
claim Hv1R : apply_fun v 1 :e R.
{ exact (Hvfun 1 H1in3). }
claim Hv2R : apply_fun v 2 :e R.
{ exact (Hvfun 2 H2in3). }
claim Hv0S : SNo (apply_fun v 0).
{ exact (real_SNo (apply_fun v 0) Hv0R). }
claim Hv1S : SNo (apply_fun v 1).
{ exact (real_SNo (apply_fun v 1) Hv1R). }
claim Hv2S : SNo (apply_fun v 2) .
{ exact (real_SNo (apply_fun v 2) Hv2R). }
claim Hsum1 : finite_real_sum (fun i:set => apply_fun v i) 3 = 1.
{
  exact (andER
    (forall i:set, i :e 3 -> ~(Rlt (apply_fun v i) 0))
    (finite_real_sum (fun i:set => apply_fun v i) 3 = 1)
    HvProp).
}
claim H2nat : nat_p 2.
{ exact (nat_ordsucc 1 (nat_ordsucc 0 nat_0)). }
claim H1nat : nat_p 1.
{ exact (nat_ordsucc 0 nat_0). }
claim HsumExp :
  finite_real_sum (fun i:set => apply_fun v i) 3 =
  add_SNo (add_SNo (apply_fun v 0) (apply_fun v 1)) (apply_fun v 2).
{
  rewrite (finite_real_sum_S (fun i:set => apply_fun v i) 2 H2nat).
  rewrite (finite_real_sum_S (fun i:set => apply_fun v i) 1 H1nat).
  rewrite (finite_real_sum_S (fun i:set => apply_fun v i) 0 nat_0).
  rewrite (finite_real_sum_0 (fun i:set => apply_fun v i)).
  rewrite (add_SNo_0L (apply_fun v 0) Hv0S).
  reflexivity.
}
claim HsumEq :
  add_SNo (add_SNo (apply_fun v 0) (apply_fun v 1)) (apply_fun v 2) = 1.
{
  rewrite <- HsumExp.
  exact Hsum1.
}
claim Hv0Nonneg : ~(Rlt (apply_fun v 0) 0).
{
  exact (andEL
    (forall i:set, i :e 3 -> ~(Rlt (apply_fun v i) 0))
    (finite_real_sum (fun i:set => apply_fun v i) 3 = 1)
    HvProp
    0
    H0in3).
}
claim Hv1Nonneg : ~(Rlt (apply_fun v 1) 0).
{
  exact (andEL
    (forall i:set, i :e 3 -> ~(Rlt (apply_fun v i) 0))
    (finite_real_sum (fun i:set => apply_fun v i) 3 = 1)
    HvProp
    1
    H1in3).
}
claim Hv2Nonneg : ~(Rlt (apply_fun v 2) 0).
{
  exact (andEL
    (forall i:set, i :e 3 -> ~(Rlt (apply_fun v i) 0))
    (finite_real_sum (fun i:set => apply_fun v i) 3 = 1)
    HvProp
    2
    H2in3).
}
claim Hleft : ~(Rlt 1 (add_SNo (apply_fun v 0) (apply_fun v 1))).
{
  assume Hlt.
  claim Hle2 : Rle 0 (apply_fun v 2).
  {
    exact (RleI
      0
      (apply_fun v 2)
      real_0
      Hv2R
      Hv2Nonneg).
  }
  claim HsumLe :
    Rle
      (add_SNo (apply_fun v 0) (apply_fun v 1))
      (add_SNo (apply_fun v 0) (add_SNo (apply_fun v 1) (apply_fun v 2))).
  {
    claim Htmp :
      Rle
        (add_SNo (apply_fun v 0) (apply_fun v 1))
        (add_SNo (apply_fun v 2) (add_SNo (apply_fun v 0) (apply_fun v 1))).
    {
      exact (Rle_increase_by_nonneg_left
        (apply_fun v 2)
        (add_SNo (apply_fun v 0) (apply_fun v 1))
        Hv2R
        (real_add_SNo (apply_fun v 0) Hv0R (apply_fun v 1) Hv1R)
        Hle2).
    }
    claim HrhsEq :
      add_SNo (apply_fun v 2) (add_SNo (apply_fun v 0) (apply_fun v 1)) =
      add_SNo (apply_fun v 0) (add_SNo (apply_fun v 1) (apply_fun v 2)).
    {
      rewrite (add_SNo_com
        (apply_fun v 2)
        (add_SNo (apply_fun v 0) (apply_fun v 1))
        Hv2S
        (real_SNo (add_SNo (apply_fun v 0) (apply_fun v 1))
          (real_add_SNo (apply_fun v 0) Hv0R (apply_fun v 1) Hv1R))).
      rewrite <- (add_SNo_assoc
        (apply_fun v 0)
        (apply_fun v 1)
        (apply_fun v 2)
        Hv0S
        Hv1S
        Hv2S).
      reflexivity.
    }
    rewrite <- HrhsEq.
    exact Htmp.
  }
  claim HsumEqAssoc :
    add_SNo (apply_fun v 0) (add_SNo (apply_fun v 1) (apply_fun v 2)) = 1.
  {
    exact (eq_i_tra
      (add_SNo (apply_fun v 0) (add_SNo (apply_fun v 1) (apply_fun v 2)))
      (add_SNo (add_SNo (apply_fun v 0) (apply_fun v 1)) (apply_fun v 2))
      1
      (add_SNo_assoc
        (apply_fun v 0)
        (apply_fun v 1)
        (apply_fun v 2)
        Hv0S
        Hv1S
        Hv2S)
      HsumEq).
  }
  claim H1ltSum3 :
    Rlt 1 (add_SNo (apply_fun v 0) (add_SNo (apply_fun v 1) (apply_fun v 2))).
  {
    exact (Rlt_Rle_tra
      1
      (add_SNo (apply_fun v 0) (apply_fun v 1))
      (add_SNo (apply_fun v 0) (add_SNo (apply_fun v 1) (apply_fun v 2)))
      Hlt
      HsumLe).
  }
  claim H1lt1 : Rlt 1 1.
  {
    exact (HsumEqAssoc
      (fun u v:set => Rlt 1 u)
      H1ltSum3).
  }
  exact (not_Rlt_refl
    1
    real_1
    H1lt1).
}
rewrite HpEq.
apply (SepI
  (setprod R R)
  (fun q:set =>
    ~(Rlt (q 0) 0) /\ ~(Rlt (q 1) 0) /\
    ~(Rlt 1 (add_SNo (q 0) (q 1))))
  (apply_fun v 0, apply_fun v 1)).
- exact (tuple_2_setprod_by_pair_Sigma
    R
    R
    (apply_fun v 0)
    (apply_fun v 1)
    Hv0R
    Hv1R).
- apply andI.
  * apply andI.
    { rewrite tuple_2_0_eq. exact Hv0Nonneg. }
    { rewrite tuple_2_1_eq. exact Hv1Nonneg. }
  * rewrite tuple_2_0_eq.
    rewrite tuple_2_1_eq.
    exact Hleft.
Qed.

(** Infrastructure: points of the early triangle model map into simplex3_fs. **)
(** Proven Charlie **)
Lemma simplex3_triangle_region_to_fs_in_simplex3_fs :
  forall p:set, p :e simplex3_triangle_region ->
    apply_fun simplex3_triangle_region_to_fs p :e simplex3_fs.
let p.
assume HpT.
set v := apply_fun simplex3_triangle_region_to_fs p.
claim HvEq :
  v
  =
  graph 3 (fun i:set =>
    if i = 0 then p 0 else
    if i = 1 then p 1 else
    add_SNo 1 (minus_SNo (add_SNo (p 0) (p 1)))).
{
  exact (apply_fun_graph
    simplex3_triangle_region
    (fun p0:set =>
      graph 3 (fun i:set =>
        if i = 0 then p0 0 else
        if i = 1 then p0 1 else
        add_SNo 1 (minus_SNo (add_SNo (p0 0) (p0 1)))))
    p
    HpT).
}
claim HpR2 : p :e setprod R R.
{
  exact (SepE1
    (setprod R R)
    (fun q:set =>
      ~(Rlt (q 0) 0) /\ ~(Rlt (q 1) 0) /\
      ~(Rlt 1 (add_SNo (q 0) (q 1))))
    p
    HpT).
