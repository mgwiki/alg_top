claim Hy1 : apply_fun k x0 :e Y.
{
  exact (HkFunMap x0 Hx0).
}
claim Halpha0 : apply_fun alpha 0 = apply_fun h x0.
{
  exact (path_between_at_zero
    Y
    (apply_fun h x0)
    (apply_fun k x0)
    alpha
    HalphaPath).
