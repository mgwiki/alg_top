(** Helper: transfer implications from existence of a homeomorphism. **)
(** Proven Bob **)
Theorem exists_homeomorphism_path_connected_space_transfer :
  forall X Tx Y Ty:set,
  (exists h:set, homeomorphism X Tx Y Ty h) ->
