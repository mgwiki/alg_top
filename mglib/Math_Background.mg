		    claim HconnIni0 :
		      connected_space (E0 :\: (Sing ini0))
		        (subspace_topology E0 (subspace_topology X Tx E0) (E0 :\: (Sing ini0))).
		    {
		      apply (and6E
		        (arc E0 (subspace_topology X Tx E0))
		        (ini0 :e E0)
		        (fin0 :e E0)
		        (ini0 <> fin0)
		        (connected_space (E0 :\: (Sing ini0))
