                  apply_fun xs' i =
                    apply_fun (apply_fun ifam (apply_fun aof' i)) u)
                (homomorphism_image_mem
                  (apply_fun Gfam (apply_fun aof' i))
                  (apply_fun ifam (apply_fun aof' i))
                  (apply_fun xs' i))
                HxImgHom).
            }
            claim HexUi :
              exists u:set,
                apply_fun aof' i :e J /\
                u :e apply_fun Gfam (apply_fun aof' i) /\
                apply_fun xs' i =
                  apply_fun (apply_fun ifam (apply_fun aof' i)) u.
