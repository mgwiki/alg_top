      reflexivity.
    }
    exact (eq_i_tra
      (apply_fun (apply_fun wS (p 0)) i)
      (add_SNo
        (mul_SNo
          (apply_fun flip_unit_interval (p 1))
          (apply_fun (apply_fun wS (p 0)) i))
        (mul_SNo
          (p 1)
          (apply_fun (p 0) i)))
      0
      (eq_symm
        (add_SNo
          (mul_SNo
            (apply_fun flip_unit_interval (p 1))
            (apply_fun (apply_fun wS (p 0)) i))
          (mul_SNo
            (p 1)
            (apply_fun (p 0) i)))
        (apply_fun (apply_fun wS (p 0)) i)
        Hexp)
      H0).
  }
  claim Hcontra : False.
  {
    apply (SepE2
      (euclidean_space (ordsucc n))
      (fun v:set => ~(forall i:set, i :e ordsucc n -> apply_fun v i = 0))
      (apply_fun wS (p 0))
