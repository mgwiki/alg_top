          (p 1)
          Hp1R)).
    - assume Hneg00.
      claim Hm0 : minus_SNo (p 0) = 0.
      {
        exact (eq_i_tra
          (minus_SNo (p 0))
          ((minus_SNo (p 0), minus_SNo (p 1)) 0)
          0
          (eq_symm
            ((minus_SNo (p 0), minus_SNo (p 1)) 0)
            (minus_SNo (p 0))
            (tuple_2_0_eq
              (minus_SNo (p 0))
              (minus_SNo (p 1))))
          (andEL
            ((minus_SNo (p 0), minus_SNo (p 1)) 0 = 0)
            ((minus_SNo (p 0), minus_SNo (p 1)) 1 = 0)
            Hneg00)).
      }
      claim Hm1 : minus_SNo (p 1) = 0.
      {
        exact (eq_i_tra
          (minus_SNo (p 1))
          ((minus_SNo (p 0), minus_SNo (p 1)) 1)
          0
          (eq_symm
            ((minus_SNo (p 0), minus_SNo (p 1)) 1)
            (minus_SNo (p 1))
            (tuple_2_1_eq
