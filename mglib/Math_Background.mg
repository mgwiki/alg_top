                apply_fun ws1 i = apply_fun xs1 i)) /\
              ((forall j:set, j :e n2 ->
                apply_fun aof2 j :e J /\
                apply_fun uof2 j :e apply_fun Gfam (apply_fun aof2 j)) /\
               (forall j:set, j :e n2 ->
                apply_fun ws2 j =
                  apply_fun (apply_fun ifam (apply_fun aof2 j)) (apply_fun uof2 j)) /\
               (forall j:set, j :e n2 ->
                apply_fun ws2 j = apply_fun xs2 j)).
          apply Haof1Pack.
          let uof1.
          assume Huof1Pack :
