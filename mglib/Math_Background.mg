                 apply_fun (path_lift E Te B Tb p e0 pk) 0 = e0)
                (forall t:set, t :e unit_interval ->
                  apply_fun p (apply_fun (path_lift E Te B Tb p e0 pk) t) = apply_fun pk t)
                HpkLiftPack))
            HpkLift0
            HpkLifting
            Hk0).
        }
        set kf := path_concat k f.
        claim HkfCont :
          continuous_map unit_interval unit_interval_topology E Te kf.
        {
          exact (path_concat_continuous
            E
            Te
            e0
            e0
            y
            k
            f
            HkCont
            HfCont
            Hk0
            Hk1
            Hf0
            Hf1).
        }
        claim HkComm :
          forall t:set, t :e unit_interval ->
            apply_fun p (apply_fun k t) = apply_fun pk t.
        {
          let t.
          assume Ht.
          rewrite (compose_fun_apply unit_interval k p t Ht).
          reflexivity.
        }
        claim HkfComm :
          forall t:set, t :e unit_interval ->
            apply_fun p (apply_fun kf t) = apply_fun (path_concat pk g) t.
        {
          let t.
          assume Ht.
          claim HtUnion :
            t :e unit_interval_left_half :\/: unit_interval_right_half.
          {
            rewrite unit_interval_halves_cover.
            exact Ht.
          }
          apply (binunionE
            unit_interval_left_half
            unit_interval_right_half
            t
            HtUnion).
          - assume HtL.
            claim Ht2 : mul_SNo 2 t :e unit_interval.
            {
              claim HdoubleOn :
                function_on double_map_left_half unit_interval_left_half unit_interval.
              { exact double_map_function_on. }
              claim Ht2' : apply_fun double_map_left_half t :e unit_interval.
              { exact (HdoubleOn t HtL). }
              rewrite <- (double_map_apply t HtL).
              exact Ht2'.
            }
            rewrite (path_concat_apply_left
              k
              f
              t
              (eq_i_tra
                (apply_fun k 1)
                e0
                (apply_fun f 0)
                Hk1
                (eq_symm (apply_fun f 0) e0 Hf0))
              HtL).
            rewrite (path_concat_apply_left
              pk
              g
              t
              (eq_i_tra
                (apply_fun pk 1)
                b0
                (apply_fun g 0)
                Hpk1
                (eq_symm (apply_fun g 0) b0 Hg0))
              HtL).
            rewrite (HkComm (mul_SNo 2 t) Ht2).
            reflexivity.
          - assume HtR.
            claim Ht2 :
              add_SNo (mul_SNo 2 t) (minus_SNo 1) :e unit_interval.
            {
              claim HdoubleOn :
                function_on double_minus_one_map_right_half
                  unit_interval_right_half unit_interval.
              { exact double_minus_one_map_function_on. }
              claim Ht2' :
                apply_fun double_minus_one_map_right_half t :e unit_interval.
              { exact (HdoubleOn t HtR). }
              rewrite <- (double_minus_one_map_apply t HtR).
              exact Ht2'.
            }
            rewrite (path_concat_apply_right
              k
              f
              t
              (eq_i_tra
                (apply_fun k 1)
                e0
                (apply_fun f 0)
                Hk1
                (eq_symm (apply_fun f 0) e0 Hf0))
              HtR).
            rewrite (path_concat_apply_right
              pk
              g
              t
              (eq_i_tra
                (apply_fun pk 1)
                b0
                (apply_fun g 0)
                Hpk1
                (eq_symm (apply_fun g 0) b0 Hg0))
              HtR).
            rewrite (HfComm
              (add_SNo (mul_SNo 2 t) (minus_SNo 1))
              Ht2).
            reflexivity.
        }
        claim HkfLifting :
          lifting_of unit_interval unit_interval_topology E Te B Tb p
            (path_concat pk g)
            kf.
        {
          exact (andI
            (continuous_map unit_interval unit_interval_topology E Te kf)
            (forall t:set, t :e unit_interval ->
              apply_fun p (apply_fun kf t) = apply_fun (path_concat pk g) t)
            HkfCont
            HkfComm).
        }
        claim HstartConcat : apply_fun p e0 = apply_fun (path_concat pk g) 0.
        {
          rewrite (path_concat_at_zero pk g).
          exact (eq_i_tra
            (apply_fun p e0)
            b0
            (apply_fun pk 0)
            Hb0def
            (eq_symm (apply_fun pk 0) b0 Hpk0)).
        }
        claim HconcatCont :
          continuous_map unit_interval unit_interval_topology B Tb (path_concat pk g).
        {
          exact (path_concat_continuous
            B
            Tb
            b0
            b0
            b0
            pk
            g
            HpkCont
            HgCont
            Hpk0
            Hpk1
            Hg0
            Hg1).
        }
        claim HconcatPack :
          (continuous_map unit_interval unit_interval_topology E Te
            (path_lift E Te B Tb p e0 (path_concat pk g)) /\
           apply_fun (path_lift E Te B Tb p e0 (path_concat pk g)) 0 = e0) /\
          (forall t:set, t :e unit_interval ->
            apply_fun p (apply_fun (path_lift E Te B Tb p e0 (path_concat pk g)) t) =
            apply_fun (path_concat pk g) t).
        {
          exact (lemma54_1_path_lifting
            E Te B Tb p e0 (path_concat pk g)
            Hcov
            He0
            HstartConcat
            HconcatCont).
        }
        claim HconcatLeft :
          continuous_map unit_interval unit_interval_topology E Te
            (path_lift E Te B Tb p e0 (path_concat pk g)) /\
          apply_fun (path_lift E Te B Tb p e0 (path_concat pk g)) 0 = e0.
        {
          exact (andEL
            (continuous_map unit_interval unit_interval_topology E Te
              (path_lift E Te B Tb p e0 (path_concat pk g)) /\
             apply_fun (path_lift E Te B Tb p e0 (path_concat pk g)) 0 = e0)
            (forall t:set, t :e unit_interval ->
              apply_fun p (apply_fun (path_lift E Te B Tb p e0 (path_concat pk g)) t) =
              apply_fun (path_concat pk g) t)
            HconcatPack).
        }
        claim HconcatLiftCont :
          continuous_map unit_interval unit_interval_topology E Te
            (path_lift E Te B Tb p e0 (path_concat pk g)).
        {
          exact (andEL
            (continuous_map unit_interval unit_interval_topology E Te
              (path_lift E Te B Tb p e0 (path_concat pk g)))
            (apply_fun (path_lift E Te B Tb p e0 (path_concat pk g)) 0 = e0)
            HconcatLeft).
        }
        claim Hconcat0 :
          apply_fun (path_lift E Te B Tb p e0 (path_concat pk g)) 0 = e0.
        {
          exact (andER
            (continuous_map unit_interval unit_interval_topology E Te
              (path_lift E Te B Tb p e0 (path_concat pk g)))
            (apply_fun (path_lift E Te B Tb p e0 (path_concat pk g)) 0 = e0)
            HconcatLeft).
        }
        claim HconcatLiftEq :
          forall t:set, t :e unit_interval ->
            apply_fun (path_lift E Te B Tb p e0 (path_concat pk g)) t =
            apply_fun kf t.
        {
          exact (lemma54_1_path_lifting_unique
            E
            Te
            B
            Tb
            p
            e0
            (path_concat pk g)
            (path_lift E Te B Tb p e0 (path_concat pk g))
            kf
            Hcov
            He0
            HconcatCont
            (andI
              (continuous_map unit_interval unit_interval_topology E Te
                (path_lift E Te B Tb p e0 (path_concat pk g)))
              (forall t:set, t :e unit_interval ->
                apply_fun p (apply_fun (path_lift E Te B Tb p e0 (path_concat pk g)) t) =
                apply_fun (path_concat pk g) t)
              HconcatLiftCont
              (andER
                (continuous_map unit_interval unit_interval_topology E Te
                  (path_lift E Te B Tb p e0 (path_concat pk g)) /\
                 apply_fun (path_lift E Te B Tb p e0 (path_concat pk g)) 0 = e0)
                (forall t:set, t :e unit_interval ->
                  apply_fun p (apply_fun (path_lift E Te B Tb p e0 (path_concat pk g)) t) =
                  apply_fun (path_concat pk g) t)
                HconcatPack))
            Hconcat0
            HkfLifting
            (eq_i_tra
              (apply_fun (path_concat k f) 0)
              (apply_fun k 0)
              e0
              (path_concat_at_zero k f)
              Hk0)).
        }
        claim HconcatEnd :
          apply_fun (path_lift E Te B Tb p e0 (path_concat pk g)) 1 = y.
        {
          rewrite (HconcatLiftEq 1 one_in_unit_interval).
          rewrite (path_concat_at_one k f).
          exact Hf1.
        }
        (** Step 4: relate lc on h_mult_cls to path_concat hrep rep **)
        set cls_mult := apply_fun mult (h, cls).
        set rep_mult := Eps_i (fun f0:set => f0 :e cls_mult).
        claim HlcMultApply :
          apply_fun lc cls_mult =
          apply_fun (path_lift E Te B Tb p e0 rep_mult) 1.
        {
          exact (apply_fun_graph
            G
            (fun cls0:set =>
              apply_fun (path_lift E Te B Tb p e0
                (Eps_i (fun f0:set => f0 :e cls0))) 1)
            cls_mult
            HmultG).
        }
        claim HhclsPair : (h, cls) :e setprod G G.
        {
          exact (tuple_2_setprod_by_pair_Sigma G G h cls HhG HclsG).
        }
        claim HmultClassEq :
          cls_mult =
          path_homotopy_class_loop B Tb b0 (path_concat hrep rep).
        {
          rewrite (fundamental_group_mult_apply
            B
            Tb
            b0
            (h, cls)
            HhclsPair).
          rewrite tuple_2_0_eq.
          rewrite tuple_2_1_eq.
          reflexivity.
        }
        claim HconcatLoop :
          path_concat hrep rep :e loop_space B Tb b0.
        {
          exact (path_concat_preserves_loop_space
            B
            Tb
            b0
            hrep
            rep
            HhrepLoop
            HrepLoop).
        }
        claim HconcatInClass : path_concat hrep rep :e cls_mult.
        {
          rewrite HmultClassEq.
          exact (loop_in_own_path_homotopy_class
            B
            Tb
            b0
            (path_concat hrep rep)
            HconcatLoop).
        }
        claim HrepMultIn : rep_mult :e cls_mult.
        {
          exact (Eps_i_ax
            (fun f0:set => f0 :e cls_mult)
            (path_concat hrep rep)
            HconcatInClass).
        }
        claim HrepMultInClass :
          rep_mult :e path_homotopy_class_loop B Tb b0 (path_concat hrep rep).
        {
          rewrite <- HmultClassEq.
          exact HrepMultIn.
        }
        claim HrepMultHom :
          path_homotopic B Tb b0 b0 (path_concat hrep rep) rep_mult.
        {
          exact (path_homotopy_class_loop_has_homotopy
            B
            Tb
            b0
            (path_concat hrep rep)
            rep_mult
            HrepMultInClass).
        }
        claim HrepMultLiftPack :
          apply_fun (path_lift E Te B Tb p e0 (path_concat hrep rep)) 1 =
          apply_fun (path_lift E Te B Tb p e0 rep_mult) 1 /\
          path_homotopic E Te e0
            (apply_fun (path_lift E Te B Tb p e0 (path_concat hrep rep)) 1)
            (path_lift E Te B Tb p e0 (path_concat hrep rep))
            (path_lift E Te B Tb p e0 rep_mult).
        {
          exact (thm54_3_homotopic_lifts
            E
            Te
            B
            Tb
            p
            e0
            b0
            b0
            (path_concat hrep rep)
            rep_mult
            Hcov
            He0
            (fun P H => H)
            HrepMultHom).
        }
        claim HrepMultEndEq :
          apply_fun (path_lift E Te B Tb p e0 (path_concat hrep rep)) 1 =
          apply_fun (path_lift E Te B Tb p e0 rep_mult) 1.
        {
          exact (andEL
            (apply_fun (path_lift E Te B Tb p e0 (path_concat hrep rep)) 1 =
              apply_fun (path_lift E Te B Tb p e0 rep_mult) 1)
            (path_homotopic E Te e0
              (apply_fun (path_lift E Te B Tb p e0 (path_concat hrep rep)) 1)
              (path_lift E Te B Tb p e0 (path_concat hrep rep))
              (path_lift E Te B Tb p e0 rep_mult))
            HrepMultLiftPack).
        }
        claim HlcMultToConcat :
          apply_fun lc cls_mult =
          apply_fun (path_lift E Te B Tb p e0 (path_concat hrep rep)) 1.
        {
          exact (eq_i_tra
            (apply_fun lc cls_mult)
            (apply_fun (path_lift E Te B Tb p e0 rep_mult) 1)
            (apply_fun (path_lift E Te B Tb p e0 (path_concat hrep rep)) 1)
            HlcMultApply
            (eq_symm
              (apply_fun (path_lift E Te B Tb p e0 (path_concat hrep rep)) 1)
              (apply_fun (path_lift E Te B Tb p e0 rep_mult) 1)
              HrepMultEndEq)).
        }
        claim HlcMultToY : apply_fun lc cls_mult = y.
        {
          exact (eq_i_tra
            (apply_fun lc cls_mult)
            (apply_fun (path_lift E Te B Tb p e0 (path_concat hrep rep)) 1)
            y
            HlcMultToConcat
            (eq_i_tra
              (apply_fun (path_lift E Te B Tb p e0 (path_concat hrep rep)) 1)
              (apply_fun (path_lift E Te B Tb p e0 (path_concat pk g)) 1)
              y
              HconcatEndEq
              HconcatEnd)).
        }
        (** Step 5: conclude lc mult = lc cls **)
        exact (eq_i_tra
          (apply_fun lc cls_mult)
          y
          (apply_fun lc cls)
          HlcMultToY
          (eq_symm (apply_fun lc cls) y HlcCls)).
      }
      rewrite Hcls0Eq.
      exact HlcMult.
    }
    rewrite HlcConst.
    exact HlcCls.
}
witness Phi.
exact (andI
  (function_on Phi cosets Fib)
  (forall y:set, y :e Fib -> exists c:set, c :e cosets /\ apply_fun Phi c = y)
  HPhiFun
  HPhiSurj).
Qed.

(** Infrastructure: loop characterization (forward direction) **)
(** Proven Alice **)
Lemma thm54_6c_loop_characterization_forward : forall E Te B Tb p e0 f:set,
  covering_map E Te B Tb p -> e0 :e E ->
  loop_at B Tb (apply_fun p e0) f ->
  path_homotopy_class_loop B Tb (apply_fun p e0) f :e
    homomorphism_image
      (fundamental_group E Te e0)
      (induced_homomorphism E Te e0 B Tb (apply_fun p e0) p) ->
  apply_fun (path_lift E Te B Tb p e0 f) 1 = e0.
let E Te B Tb p e0 f.
assume Hcov He0 Hloop Himg.
set b0 := apply_fun p e0.
claim Hcontp : continuous_map E Te B Tb p.
{
  exact (andEL
    (continuous_map E Te B Tb p)
    (surjective_map E B p)
    (andEL
      (continuous_map E Te B Tb p /\ surjective_map E B p)
      (forall b:set, b :e B ->
        exists U:set, U :e Tb /\ b :e U /\ evenly_covered E Te B Tb p U)
      Hcov)).
}
claim HimgEx :
  exists cls:set, cls :e fundamental_group E Te e0 /\
    path_homotopy_class_loop B Tb b0 f =
    apply_fun (induced_homomorphism E Te e0 B Tb b0 p) cls.
{
  exact (iffEL
    (path_homotopy_class_loop B Tb b0 f :e
      homomorphism_image
        (fundamental_group E Te e0)
        (induced_homomorphism E Te e0 B Tb b0 p))
    (exists cls:set, cls :e fundamental_group E Te e0 /\
      path_homotopy_class_loop B Tb b0 f =
      apply_fun (induced_homomorphism E Te e0 B Tb b0 p) cls)
    (homomorphism_image_mem
      (fundamental_group E Te e0)
      (induced_homomorphism E Te e0 B Tb b0 p)
      (path_homotopy_class_loop B Tb b0 f))
    Himg).
}
apply HimgEx.
let cls.
assume HclsPack.
claim Hcls : cls :e fundamental_group E Te e0.
{
  exact (andEL
    (cls :e fundamental_group E Te e0)
    (path_homotopy_class_loop B Tb b0 f =
      apply_fun (induced_homomorphism E Te e0 B Tb b0 p) cls)
    HclsPack).
}
claim HimgEq :
  path_homotopy_class_loop B Tb b0 f =
  apply_fun (induced_homomorphism E Te e0 B Tb b0 p) cls.
{
  exact (andER
    (cls :e fundamental_group E Te e0)
    (path_homotopy_class_loop B Tb b0 f =
      apply_fun (induced_homomorphism E Te e0 B Tb b0 p) cls)
    HclsPack).
}
set g := Eps_i (fun h:set => h :e cls).
claim HgLoop : g :e loop_space E Te e0.
{
  exact (eps_of_fundamental_group_member_in_loop_space
    E Te e0 cls Hcls).
}
claim HgLoopAt : loop_at E Te e0 g.
{
  exact (loop_space_has_loop_at E Te e0 g HgLoop).
}
claim HgCont : continuous_map unit_interval unit_interval_topology E Te g.
{
  exact (loop_at_continuous E Te e0 g HgLoopAt).
}
claim Hg0 : apply_fun g 0 = e0.
{
  exact (loop_at_at_zero E Te e0 g HgLoopAt).
}
claim Hg1 : apply_fun g 1 = e0.
{
  exact (loop_at_at_one E Te e0 g HgLoopAt).
}
set pg := compose_fun unit_interval g p.
claim Hb0 : apply_fun p e0 = b0.
{ reflexivity. }
claim HpgLoop : pg :e loop_space B Tb b0.
{
  exact (loop_space_postcompose
    E Te e0 B Tb b0 g p
    HgLoop Hcontp Hb0).
}
claim Hind :
  apply_fun (induced_homomorphism E Te e0 B Tb b0 p) cls =
  path_homotopy_class_loop B Tb b0 pg.
{
  rewrite (induced_homomorphism_apply
    E Te e0 B Tb b0 p cls Hcls).
  reflexivity.
}
claim HclassEq :
  path_homotopy_class_loop B Tb b0 f =
  path_homotopy_class_loop B Tb b0 pg.
{
  rewrite HimgEq.
  exact Hind.
}
claim HpgInOwn :
  pg :e path_homotopy_class_loop B Tb b0 pg.
{
  exact (loop_in_own_path_homotopy_class B Tb b0 pg HpgLoop).
}
claim HpgInClassF :
  pg :e path_homotopy_class_loop B Tb b0 f.
{
  exact (mem_eqR
    pg
    (path_homotopy_class_loop B Tb b0 pg)
    (path_homotopy_class_loop B Tb b0 f)
    (eq_symm
      (path_homotopy_class_loop B Tb b0 f)
      (path_homotopy_class_loop B Tb b0 pg)
      HclassEq)
    HpgInOwn).
}
claim Hhom : path_homotopic B Tb b0 b0 f pg.
{
  exact (path_homotopy_class_loop_has_homotopy
    B Tb b0 f pg HpgInClassF).
}
claim HliftPack :
  apply_fun (path_lift E Te B Tb p e0 f) 1 =
  apply_fun (path_lift E Te B Tb p e0 pg) 1 /\
  path_homotopic E Te e0
    (apply_fun (path_lift E Te B Tb p e0 f) 1)
    (path_lift E Te B Tb p e0 f) (path_lift E Te B Tb p e0 pg).
{
  exact (thm54_3_homotopic_lifts
    E Te B Tb p e0 b0 b0 f pg
    Hcov
    He0
    Hb0
    Hhom).
}
claim HpgCont : continuous_map unit_interval unit_interval_topology B Tb pg.
{
  exact (composition_continuous
    unit_interval
    unit_interval_topology
    E
    Te
    B
    Tb
    g
    p
    HgCont
    Hcontp).
}
claim Hpg0 : apply_fun pg 0 = b0.
{
  rewrite (compose_fun_apply unit_interval g p 0 zero_in_unit_interval).
  rewrite Hg0.
  exact Hb0.
}
claim HstartPg : apply_fun p e0 = apply_fun pg 0.
{
  rewrite Hpg0.
  reflexivity.
}
claim HpgLifting : lifting_of unit_interval unit_interval_topology E Te B Tb p pg g.
{
  prove continuous_map unit_interval unit_interval_topology E Te g /\
    (forall t:set, t :e unit_interval ->
      apply_fun p (apply_fun g t) = apply_fun pg t).
  apply andI.
  - exact HgCont.
  - let t.
    assume Ht.
    rewrite (compose_fun_apply unit_interval g p t Ht).
    reflexivity.
}
claim HpgLiftPack :
  (continuous_map unit_interval unit_interval_topology E Te
    (path_lift E Te B Tb p e0 pg) /\
   apply_fun (path_lift E Te B Tb p e0 pg) 0 = e0) /\
  (forall t:set, t :e unit_interval ->
    apply_fun p (apply_fun (path_lift E Te B Tb p e0 pg) t) = apply_fun pg t).
{
  exact (lemma54_1_path_lifting
    E Te B Tb p e0 pg
    Hcov
    He0
    HstartPg
    HpgCont).
}
claim HpgLiftLeft :
  continuous_map unit_interval unit_interval_topology E Te
    (path_lift E Te B Tb p e0 pg) /\
  apply_fun (path_lift E Te B Tb p e0 pg) 0 = e0.
{
  exact (andEL
    (continuous_map unit_interval unit_interval_topology E Te
      (path_lift E Te B Tb p e0 pg) /\
     apply_fun (path_lift E Te B Tb p e0 pg) 0 = e0)
    (forall t:set, t :e unit_interval ->
      apply_fun p (apply_fun (path_lift E Te B Tb p e0 pg) t) = apply_fun pg t)
    HpgLiftPack).
}
claim HpgLift0 : apply_fun (path_lift E Te B Tb p e0 pg) 0 = e0.
{
  exact (andER
    (continuous_map unit_interval unit_interval_topology E Te
      (path_lift E Te B Tb p e0 pg))
    (apply_fun (path_lift E Te B Tb p e0 pg) 0 = e0)
    HpgLiftLeft).
}
claim HpgLiftEq :
  forall t:set, t :e unit_interval ->
    apply_fun (path_lift E Te B Tb p e0 pg) t = apply_fun g t.
{
  exact (lemma54_1_path_lifting_unique
    E
    Te
    B
    Tb
    p
    e0
    pg
    (path_lift E Te B Tb p e0 pg)
    g
    Hcov
    He0
    HpgCont
    (andI
      (continuous_map unit_interval unit_interval_topology E Te
        (path_lift E Te B Tb p e0 pg))
      (forall t:set, t :e unit_interval ->
        apply_fun p (apply_fun (path_lift E Te B Tb p e0 pg) t) = apply_fun pg t)
      (andEL
        (continuous_map unit_interval unit_interval_topology E Te
          (path_lift E Te B Tb p e0 pg))
        (apply_fun (path_lift E Te B Tb p e0 pg) 0 = e0)
        HpgLiftLeft)
      (andER
        (continuous_map unit_interval unit_interval_topology E Te
          (path_lift E Te B Tb p e0 pg) /\
         apply_fun (path_lift E Te B Tb p e0 pg) 0 = e0)
        (forall t:set, t :e unit_interval ->
          apply_fun p (apply_fun (path_lift E Te B Tb p e0 pg) t) = apply_fun pg t)
        HpgLiftPack))
    HpgLift0
    HpgLifting
    Hg0).
}
claim HpgEnd : apply_fun (path_lift E Te B Tb p e0 pg) 1 = e0.
{
  rewrite (HpgLiftEq 1 one_in_unit_interval).
  exact Hg1.
}
claim HendEq :
  apply_fun (path_lift E Te B Tb p e0 f) 1 =
  apply_fun (path_lift E Te B Tb p e0 pg) 1.
{
  exact (andEL
    (apply_fun (path_lift E Te B Tb p e0 f) 1 =
      apply_fun (path_lift E Te B Tb p e0 pg) 1)
    (path_homotopic E Te e0
      (apply_fun (path_lift E Te B Tb p e0 f) 1)
      (path_lift E Te B Tb p e0 f) (path_lift E Te B Tb p e0 pg))
    HliftPack).
}
rewrite HendEq.
exact HpgEnd.
Qed.


