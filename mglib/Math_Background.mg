    exact (compact_space_subcover_property B Tb HcompB Ufam HopenUfam).
  }
  apply HfinCoverB.
  let U0.
  assume HU0pack.
  claim HU0subUfam : U0 c= Ufam.
  {
    exact (andEL
      (U0 c= Ufam)
      (finite U0)
